def repo_git_has(ctx, token):
    """git_has for one repository: ctx is the factory's ctx of a project of one, or a RepoCtx."""
    ref = "refs/heads/%s" % ctx.c("base_branch", "main")
    if git(["rev-parse", "--verify", "--quiet", ref], ctx.git(), check=False).returncode != 0:
        return True
    if "/" in token or re.search(r"\.(md|py|js|mjs|ts|tsx|jsx|vue|svelte|php|rb|go|rs|java|kt|cs|json|ya?ml|toml|"
                                  r"sql|html|css|scss|sh|xml|env|ini|cfg|lock|txt)$", token):
        t = token.lstrip("./")
        if git(["cat-file", "-e", "%s:%s" % (ref, t)], ctx.git(), check=False).returncode == 0:
            return True
        names = git(["ls-tree", "-r", "--name-only", ref], ctx.git(), check=False).stdout.splitlines()
        if any(n.endswith(t) or fnmatch.fnmatch(n, "*" + t) for n in names):
            return True
    code = ctx.code()
    if not code:
        return True
    word = re.sub(r"\(.*$", "", token)
    return git(["grep", "-q", "-F", "-e", word], code, check=False).returncode == 0


def repo_knowledge_dir(ctx, name=None):
    """A repository's knowledge: knowledge/<repo>/, or knowledge/ itself when it is flat (knowledge_flat)."""
    if knowledge_flat(ctx):
        return knowledge_dir(ctx)
    return os.path.join(knowledge_dir(ctx), ctx.repo_name(name))


def repo_learn_state(job, name):
    """The learning cursors of a repository's pull request, in its entry of repos{}: the comments already read
    (comments), how far its branch's human edits were read (edits_seen), the ranges still to read (pending_edits), and
    final once its pull request is merged or closed and read. The job's own (factory findings, rework notes, logic) are
    its learn block (learn_state)."""
    st = job["repos"][name].setdefault("learn", {})
    for k in ("comments", "pending_edits"):
        st.setdefault(k, [])
    return st



def repo_merged(ctx, job, name):
    """merged / closed / open for one repository's pull request of the job, from gh/glab when they can tell, else from
    its target branch's history."""
    rctx, v = repo_ctx(ctx, name), repo_view(ctx, job, name)
    info, _ = pr_feedback(rctx, v)
    if info and info["state"] in ("merged", "closed"):
        return info["state"]
    head = v.get("pushed_head")
    base = "refs/heads/%s" % (v.get("target_branch") or v.get("base_branch") or rctx.c("base_branch", "main"))
    if head and git(["cat-file", "-e", "%s^{commit}" % head], rctx.git(), check=False).returncode == 0 \
            and is_ancestor(head, base, rctx.git()):
        return "merged"
    return "open"


def repo_section(md, name):
    """The text of a spec's `## Repo: <name>` part (that name exactly), or ''."""
    m = re.search(r"(?ms)^##\s+Repo:\s*%s\s*\n(.*?)(?=^##\s|\Z)" % re.escape(name), md or "")
    return m.group(1).strip() if m else ""


def repo_security_gaps(ctx):
    """security_gaps of one repository (a RepoCtx), or of the factory's only one."""
    on, gaps = scanners_on(ctx), []
    off = [n for n in SCANNERS if not on[n]]
    if off:
        gaps.append("turned off in security.scanners: %s" % ", ".join(off))
    loose = [n for n in REQUIRED_SCANNERS if on[n] and n not in required_scanners(ctx)]
    if loose:
        gaps.append("%s not in security.required: when they cannot run, the job only goes to a human" % ", ".join(loose))
    try:
        accepted = accepted_entries(ctx)
    except FxError:
        accepted = []  # fx doctor has its own row for that
    if accepted:
        gaps.append("%d rule(s) accepted in security.accepted_rules" % len(accepted))
    if not ctx.c("app.up"):
        gaps.append("no app.up: nothing looks at the running app (headers, ZAP)")
        return gaps
    if any(on[n] and baseline_state(ctx, n)[0] == "none" for n in ("headers", "zap")):
        gaps.append("no baseline yet: until fx selftest runs, header and ZAP findings do not block")
    if on["zap"]:
        if not (shutil.which("docker") and docker_running()):
            gaps.append("Docker is not running: no ZAP")
        if zap_mode(ctx) != "full":
            gaps.append("security.zap_mode is baseline: ZAP does not try attacks such as SQL injection or XSS")
        if not (ctx.c("security.zap_auth") or {}).get("command"):
            gaps.append("no security.zap_auth: ZAP only sees pages that need no login")
        if not ctx.c("security.zap_openapi"):
            gaps.append("no security.zap_openapi: ZAP only finds API routes that a page links to")
    return gaps


def repo_view(ctx, job, name):
    """One repository of a job seen as a job of one repository: its fields at the top, its port and its name (repo), with
    the job's apps in start order (apps) and their URLs (urls). What the gate, the apps and the scanners read; never
    saved. For the first changed repository, fields that code changed at the top of the job count."""
    e = job["repos"][name]
    v = {k: val for k, val in job.items() if k not in JOB_REPO_FIELDS}
    v.update({k: e[k] for k in JOB_REPO_FIELDS if k in e})
    if name == job_primary(job):
        v.update({k: job[k] for k in JOB_REPO_FIELDS if k in job})
    apps = job_apps(ctx, job) if ctx.repos else []
    v.update(repo=name, role=e.get("role", "change"), port=job_port(ctx, job, name), apps=apps,
             urls={n: "http://127.0.0.1:%d" % job_port(ctx, job, n) for n in apps if n in job["repos"]})
    v.setdefault("worktree", None)
    return v


def repos_drop(ctx, job, name):
    """fx repos <job> --drop <repo>: a repository the job changes turns out to need nothing. It becomes run-only (a
    checkout of its base) when another changed repository's app needs it, else it leaves the job, with the run-only
    repositories only its app needed. Refused while its clone holds work that is not on the remote."""
    ctx.repo_entry(name)
    change = job_names(job, "change")
    if name not in change:
        raise FxError("%s does not change %s (it changes %s)" % (job["id"], name, ", ".join(change) or "nothing"),
                      code=3)
    if len(change) == 1:
        raise FxError("%s is the only repository %s changes; a job changes at least one (reject the job instead)" % (
            name, job["id"]), code=3)
    e = job["repos"][name]
    if e.get("pushed_head") or e.get("pr_url"):
        raise FxError("%s of %s was pushed already (%s): it cannot leave the job" % (
            name, job["id"], e.get("pr_url") or e.get("branch")), code=3)
    if any(p_.get("repo") == name and p_.get("status") not in TERMINAL_WP
           for p_ in ((job.get("split") or {}).get("packages") or {}).values()):
        raise FxError("a package of the split build still works in %s: finish or block it first" % name, code=3)
    wt = e.get("worktree")
    k, dirty = unsaved_work(ctx, job, wt, name)
    if k or dirty:
        raise FxError("the clone of %s (%s) has work that is not on the remote: %s. Keep the repository in the job, or "
                      "discard that work first" % (name, wt, "%d commit(s)" % k if k else dirty.splitlines()[0]),
                      code=3)
    app_stop(ctx, job)
    rest = [n for n in change if n != name]
    needed = needed_repos(ctx, rest)
    notes = []
    if name in needed:
        if wt and os.path.isdir(wt):
            git(["checkout", "-q", "--detach", e["base_ref"]], wt)
            git(["branch", "-q", "-D", e["branch"]], wt, check=False)
        job["repos"][name] = {"role": "run", "worktree": wt, "base_branch": e.get("base_branch"),
                              "base_ref": e.get("base_ref"), "setup_done": e.get("setup_done", False)}
        became = "run"
        notes.append("%s is run-only now: the app of %s needs it" % (
            name, ", ".join(n for n in rest if name in needed_repos(ctx, [n]))))
    else:
        shutil.rmtree(wt or "", ignore_errors=True)
        del job["repos"][name]
        became = "removed"
    for n in job_names(job, "run"):  # what only the dropped repository's app needed
        if n == name or n in needed:
            continue
        rwt = job["repos"][n].get("worktree")
        k, dirty = unsaved_work(ctx, job, rwt, n)
        if k or dirty:
            notes.append("%s is no longer needed but its clone %s has work: kept" % (n, rwt))
            continue
        shutil.rmtree(rwt or "", ignore_errors=True)
        del job["repos"][n]
        notes.append("%s left the job too: only the app of %s needed it" % (n, name))
    job["repo_order"] = [n for n in job_order(job) if n in job["repos"]]
    if job.get("ui_repo") == name:
        job.pop("ui_repo", None)
    if job.get("risk"):
        route(ctx, job)  # one changed repository left: no fit checker
    ctx.save(job, "repository dropped: %s (%s)" % (name, became))
    out({"ok": True, "job": job["id"], "dropped": name, "became": became, "repos": job_repo_rows(ctx, job),
         "notes": notes, "next": job["stage"]})


def rework_clone(ctx, job, name, notes, heads):
    """A rework needs every clone of the job back: a changed repository's from its branch on the remote (or, never pushed,
    from its base again), a run-only one at its base."""
    e = job["repos"][name]
    wt = e.get("worktree") or job_clone_dir(ctx, job["id"], name)
    e["worktree"] = wt
    if os.path.isdir(wt):
        return
    if e.get("role") == "run":
        run_clone(ctx, wt, e.get("base_branch") or ctx.rc(name, "base_branch", "main"), name)
    elif e["branch"] in heads:
        job_clone(ctx, wt, e["branch"], repo=name)  # fresh clone of the branch as it is on the remote
    elif e.get("pushed_head"):
        raise FxError("the branch %s%s is not on the remote any more (merged and deleted?); start a new job instead" % (
            e["branch"], " of %s" % name if len(job["repos"]) > 1 else ""), code=3)
    else:
        job_clone(ctx, wt, e["branch"], start=e["base_ref"], repo=name)  # never pushed: start again from the base
    e["setup_done"] = False
    e.pop("clone_removed_at", None)
    if len(job["repos"]) == 1:
        notes.append("fresh clone of %s; run fx setup again" % e["branch"])
    else:
        notes.append("fresh clone of %s (%s); run fx setup again" % (
            name, e.get("branch") or "at %s" % e.get("base_branch")))


def rework_merged(ctx, job, name, rest, notes):
    """A repository whose pull request is merged takes no part in a rework: its work is in its base now. It runs from a
    checkout of its base when the app of another changed repository (rest) needs it, else it has no clone. Its pull
    request, branch and learning cursors stay in its entry, marked merged, so learning still reads them."""
    e = job["repos"][name]
    wt = e.get("worktree")
    if wt and os.path.isdir(wt):
        k, dirty = unsaved_work(ctx, job, wt, name)
        if k or dirty:
            raise FxError("the pull request of %s is merged, but its clone %s has work that is not on the remote (%s): "
                          "push it or discard it, then run the rework again" % (
                              name, wt, "%d commit(s)" % k if k else dirty.splitlines()[0]), code=3)
        shutil.rmtree(wt, ignore_errors=True)
    base = e.get("base_branch") or ctx.rc(name, "base_branch", "main")
    e.update(role="run", merged=now(), base_branch=base, base_ref="%s/%s" % (REMOTE, base), setup_done=False)
    e.pop("clone_removed_at", None)
    if name in needed_repos(ctx, rest):
        e["worktree"] = wt or job_clone_dir(ctx, job["id"], name)
        run_clone(ctx, e["worktree"], base, name)
        notes.append("%s: its pull request is merged, so this rework does not change it; it runs from its base %s for "
                     "the apps that need it" % (name, base))
    else:
        e["worktree"] = None
        notes.append("%s: its pull request is merged, so this rework does not change it" % name)


def run_clone(ctx, dest, base, repo):
    """A repository the job only runs: its base branch, checked out detached. Never pushed."""
    clone_project(ctx, dest, repo=repo)
    ref = "%s/%s" % (REMOTE, base)
    if git(["rev-parse", "--verify", "-q", ref], dest, check=False).returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        raise FxError("the repository %s has no branch %s to run the app from" % (repo, base), code=3)
    git(["checkout", "-q", "--detach", ref], dest)
    copy_local_files(ctx, dest, repo)
    return dest


def scan_repos(ctx, a):
    """The repositories fx selftest and fx audit-scan look at: --repo, else every one."""
    if getattr(a, "repo_name", None):
        return [ctx.repo_name(a.repo_name)]
    if not ctx.repos:
        ctx.repo_entry()  # says how to set the factory up
    return ctx.repo_names()


def scanned_repo(ctx, a):
    """The repository fx scan or style-sample read (None for a reference folder)."""
    return None if getattr(a, "source", None) else code_repo(ctx, getattr(a, "repo_name", None))


def schema_paths(ctx, names=None):
    """The schemas there are, of these repositories (default: all of them)."""
    names = [n for n in (names or ctx.repo_names()) if n in ctx.repo_names()] or [None]
    found = []
    for n in names:
        p_ = schema_path(ctx, n)
        if os.path.exists(p_) and p_ not in found:
            found.append(p_)
    return found


def security_markdown_repos(secs, several):
    """security.md: one repository's scan as always; several, a ## Repo: section each."""
    if not several:
        return security_markdown(next(iter(secs.values())))
    failed = any(sec["blocking"] or sec.get("required_failed") for sec in secs.values())
    md = ["SECURITY SCAN: %s" % ("FAIL" if failed else "PASS"), ""]
    for n, sec in secs.items():
        body = security_markdown(sec).splitlines()
        md += ["## Repo: %s" % n, "", body[0], ""] + md_demote(body[2:]) + [""]
    return "\n".join(md).rstrip("\n") + "\n"


def security_merge(secs, several):
    """The scans of several repositories as one result: what each says, named after its repository."""
    lab = (lambda n: "%s: " % n) if several else (lambda n: "")
    m = {"findings": [], "blocking": [], "skipped": [], "notes": [], "missed": [], "required_failed": [], "flags": []}
    for n, sec in secs.items():
        m["findings"] += sec["findings"]
        m["blocking"] += sec["blocking"]
        for k in ("skipped", "notes", "required_failed", "missed"):
            m[k] += [lab(n) + x for x in sec.get(k) or []]
        m["flags"] += ["%s:%s" % (n, x) if several else x for x in sec.get("flags") or []]
    return m


def selftest_repo(ctx, a, n, port, logdir, clone_of, bl_cfg, bl_pre, first):
    """One repository's selftest: setup, its checks script, its app (after the apps it needs), app.schema, e2e and the
    base branch's header and ZAP findings. Returns what baseline.json keeps for it."""
    rctx = repo_ctx(ctx, n)
    os.makedirs(logdir, exist_ok=True)
    wt, base_ref = clone_of(n)
    job = tool_job(ctx, "_selftest", n, wt, base_ref, port)
    res = {"at": now(), "base": base_ref, "steps": {}}
    extra_env = {}

    def step(name, cmd, timeout):
        log = os.path.join(logdir, "%s.log" % name)
        env = project_env(rctx, FACTORY_JOB="_selftest", FACTORY_PORT=str(job_port(ctx, job, n)),
                          **dict(baselines_env(rctx, wt), **extra_env))
        try:
            p, secs = timed(lambda: run(["bash", "-lc", cmd], cwd=wt, check=False, env=env, timeout=timeout, group=True))
            write_atomic(log, p.stdout or "")
            tail = "\n".join((p.stdout or "").splitlines()[-25:])
            res["steps"][name] = {"ok": p.returncode == 0, "exit": p.returncode, "seconds": secs, "log": log,
                                  "tail": tail}
        except subprocess.TimeoutExpired:
            res["steps"][name] = {"ok": False, "exit": None, "seconds": timeout, "log": log,
                                  "tail": "timed out after %ss" % timeout}
        return res["steps"][name]["ok"]

    ok = True
    if bl_cfg and ((bl_cfg["repo"] == "factory" and first) or (bl_cfg["repo"] == "project" and bl_cfg["repo_name"] == n)):
        rep = baselines_before_checks(ctx, bl_cfg, ctx.factory if bl_cfg["repo"] == "factory" else wt,
                                      os.path.join(logdir, "baselines-unrecorded"))
        ok = not rep["problems"]
        res["steps"]["baselines"] = {"ok": ok, "fetched": rep["fetched"], "error": "\n".join(rep["problems"]),
                                     "warnings": bl_pre["warnings"] + rep["warnings"], "pulled": bl_pre["pulled"]}
    tries = scanner_probes(rctx, wt)
    res["steps"]["scanners"] = {"ok": all(t[1] for t in tries), "checks": [{"check": t[0], "ok": t[1], "detail": t[2]}
                                                                             for t in tries],
                                "error": "; ".join(t[2] for t in tries if not t[1])}
    if ok and rctx.c("setup"):
        ok = step("setup", rctx.c("setup"), int(rctx.c("setup_timeout_sec", 1800)))
    if ok:
        script = checks_script(ctx, None, n)
        step("checks", "bash %s" % shlex.quote(script), int(rctx.c("gate_timeout_sec", 1800)))
        dirty = worktree_dirt(ctx, wt, n)
        res["leftover_files"] = (dirty[0].splitlines() + dirty[1])[:30]
    if ok and rctx.c("app.up") and not a.no_app:
        made = []
        try:
            for m in job_apps(ctx, job):
                if m != n:  # the apps it needs, each from its own clone of its base, set up
                    w, b = clone_of(m, setup=True)
                    job["repos"][m] = {"role": "run", "worktree": w, "base_ref": b}
            job["repo_order"] = [x for x in ctx.repo_names() if x in job["repos"]]
            info, secs = timed(lambda: app_start(ctx, job))
            started = info.get("apps") or {n: info}
            info = started[n]
            res["steps"]["app"] = {"ok": True, "seconds": secs, "url": info["url"]}
            if len(started) > 1:
                res["steps"]["app"]["needs"] = {m: i["url"] for m, i in started.items() if m != n}
            view = repo_view(ctx, job, n)
            if rctx.c("app.schema"):
                env, db = app_env(rctx, view)
                try:
                    p = run(["bash", "-lc", app_fill(rctx.c("app.schema"), view, db)], cwd=wt, check=False,
                            env=env, timeout=300)
                    if p.returncode == 0 and (p.stdout or "").strip():
                        write_atomic(schema_path(ctx, n), p.stdout)
                        res["schema"] = schema_path(ctx, n)
                    else:
                        res["schema_error"] = "app.schema exited %s: %s" % (
                            p.returncode, "\n".join((p.stdout or "").splitlines()[-10:]))
                except subprocess.TimeoutExpired:
                    res["schema_error"] = "app.schema timed out"
            if rctx.c("e2e"):
                env, db = app_env(rctx, view)
                extra_env.update({k: v for k, v in env.items() if k.startswith("FACTORY_URL_")},
                                 BASE_URL=info["url"].rstrip("/"))
                step("e2e", app_fill(rctx.c("e2e"), view, db), int(rctx.c("e2e_timeout_sec", 1800)))
            sc = scanners_on(rctx)
            res["security"] = {}
            if sc["headers"]:
                f, err = scan_headers(rctx, view, info["url"])
                if not err:
                    res["security"]["headers"] = f
            if sc["zap"] and shutil.which("docker") and not a.no_zap:
                f, err = scan_zap(rctx, view, info["url"], os.path.join(logdir, "zap"))
                if not err:
                    res["security"]["zap"] = f
                else:
                    res["security_skipped"] = [err]
            # After the scans: the first ZAP run on a machine is what pulls the image and gives it its id.
            res["security_scan"] = {t: scan_signature(rctx, t) for t in ("headers", "zap")}
        except FxError as e:
            res["steps"]["app"] = {"ok": False, "error": str(e)}
        finally:
            app_stop(ctx, job)
    res["ok"] = all(v.get("ok") for v in res["steps"].values())
    return res


def semgrep_gaps(ctx):
    rules = semgrep_rules(ctx)
    left = [r for r in SEMGREP_RULES if r not in rules]
    if left and all(r.startswith("p/") for r in rules):
        return ["security.semgrep_config leaves out %s" % ", ".join(left)]
    return []


def several_repos(job):
    """A repository's view of a job of several repositories: its app, database and logs carry its name."""
    return bool(job.get("repo")) and len(job_order(job)) > 1


def staged_knowledge(ctx, stage, repo):
    """The knowledge files a librarian staged, relative to the staging folder: shared ones at its top (not
    changes.md), the repository's own under <repo>/ (flat: at the top too)."""
    names = [f for f in md_files(stage) if f != "changes.md"]
    if repo and not knowledge_flat(ctx):
        names += ["%s/%s" % (repo, f) for f in md_files(os.path.join(stage, repo))]
    return names


def staged_target(ctx, stage, repo, name):
    """(staged file, where it goes) for a name fx knowledge apply was given; refuses anything else."""
    rel = posixpath.normpath(name.replace("\\", "/"))
    if rel.startswith(("/", "../")) or rel == ".." or not rel.endswith(".md"):
        raise FxError("%s is not a staged file" % name)
    if rel.startswith("logic/"):
        return os.path.join(stage, rel), os.path.join(ctx.factory, rel)
    parts = rel.split("/")
    flat = knowledge_flat(ctx)
    if len(parts) == 2 and not flat and repo and parts[0] == repo:
        if parts[1] not in REPO_KNOWLEDGE and parts[1] in KNOWLEDGE_ROLES:
            raise FxError("%s is a shared knowledge file: it goes at the top of knowledge/, not under %s/" % (
                parts[1], repo))
    elif len(parts) == 1:
        if not flat and repo and parts[0] in REPO_KNOWLEDGE and parts[0] != "README.md":
            raise FxError("%s is a file of the repository %s: stage it as %s/%s" % (parts[0], repo, repo, parts[0]))
    else:
        raise FxError("%s is not a staged file of this refresh (shared files at the top, %s at %s/)" % (
            name, "the repository's" if repo else "", repo or "<repo>"))
    return os.path.join(stage, rel), os.path.join(knowledge_dir(ctx), rel)


def tool_job(ctx, job_id, name, wt, base_ref, port, app_dir=None):
    """A job of fx's own (selftest, audit-scan) that changes one repository at its base: what the apps and scanners need.
    The repositories its app needs come in as run-only with needed_clones."""
    job = {"id": job_id, "port": port, "repo_order": [name], "repos": {name: {"role": "change", "worktree": wt,
                                                                              "base_ref": base_ref, "branch": None}}}
    if app_dir:
        job["app_dir"] = app_dir
    return job


def ui_repo(ctx, job):
    """The repository whose app the UI checks open (BASE_URL), and where ui/seed.sh and ui/check.js run: the one whose
    ui_paths the job changed (the gate keeps it as ui_repo), else the first it changes that has ui_paths, else the
    first it changes that has an app, else its first."""
    change = job_names(job, "change")
    if job.get("ui_repo") in change:
        return job["ui_repo"]
    known = [n for n in change if n in ctx.repo_names()]
    for test in (lambda n: ctx.rc(n, "ui_paths"), lambda n: ctx.rc(n, "app.up")):
        hit = next((n for n in known if test(n)), None)
        if hit:
            return hit
    return change[0] if change else None


def url_env_name(name):
    """FACTORY_URL_<NAME>: a repository's app URL for the apps started after it."""
    return "FACTORY_URL_" + re.sub(r"[^A-Z0-9]", "_", name.upper())


def url_repo_name(url):
    """A repository name from its URL: the last part, without .git, made to fit the name rule."""
    return repo_slug(re.sub(r"\.git$", "", os.path.basename((url or "").rstrip("/").replace(":", "/"))))


def build_parser():
    p = argparse.ArgumentParser(prog="fx", description="software factory helper")
    p.add_argument("--version", action="version", version=VERSION)
