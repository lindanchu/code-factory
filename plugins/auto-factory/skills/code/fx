# UI checks with Playwright

def ui_run(ctx, job, script, out_dir):
    """Run a Playwright check script against the job's running apps: BASE_URL is the app of ui_repo, and the script runs
    in that repository's clone with every app's URL (FACTORY_URL_<NAME>). Returns the parsed report. A repository that
    is a mobile app runs the same script on its virtual phones instead (ui_run_mobile): only the way of running differs."""
    name = ui_repo(ctx, job) if is_whole_job(job) else job.get("repo")
    rctx, v = one_app(ctx, job, name)
    if mobile_conf(rctx):
        return ui_run_mobile(rctx, v, script, out_dir, mobile_conf(rctx))
    mobile_missing(rctx, v.get("worktree"))
    ok, why = playwright_ok()
    if not ok:
        return {"skipped": "Playwright is not available (%s): run /auto-factory:code install" % why}
    info = app_start(ctx, job)
    apps = info.get("apps") or {}
    base = (apps.get(v.get("repo")) or info)["url"]
    urls = {url_env_name(n): a_["url"].rstrip("/") for n, a_ in apps.items()}
    os.makedirs(out_dir, exist_ok=True)
    report_path = os.path.join(out_dir, "ui-report.json")
    if os.path.exists(report_path):
        os.remove(report_path)
    try:
        denv, dtmp, dinfo = design_setup(rctx, v)
    except (OSError, ValueError, FxError) as e:  # measuring is an addition: without it the check still runs
        dtmp = tempfile.mkdtemp(prefix="fx-design-")
        dinfo = {"why": "the design setup failed: %s" % str(e).splitlines()[0][:200], "packages": [], "viewport": None}
        denv = {"FACTORY_UI_DESIGN": os.path.join(dtmp, "setup.json")}
        write_atomic(denv["FACTORY_UI_DESIGN"], json.dumps({"packages": [], "why": dinfo["why"]}) + "\n")
    env = project_env(rctx, NODE_PATH=node_path(), BASE_URL=base.rstrip("/"),
                      **dict(urls, **dict(baselines_env(rctx, v["worktree"]), **lane_env(rctx, v))),
                      FACTORY_UI=os.path.join(SKILL_DIR, "factory-ui.js"), FACTORY_UI_REPORT=report_path,
                      FACTORY_UI_SHOTS=os.path.join(out_dir, "shots"),
                      FACTORY_UI_VIEWPORTS=json.dumps(rctx.c("ui_checks.viewports", [[1280, 800], [390, 844]])),
                      FACTORY_UI_BLOCK_STATUS=str(rctx.c("ui_checks.block_on_status", 500)),
                      FACTORY_UI_DESIGN=denv["FACTORY_UI_DESIGN"])
    try:
        p = run(["node", script], cwd=v["worktree"], check=False, env=env,
                timeout=int(rctx.c("e2e_timeout_sec", 1800)), group=True)
        log = p.stdout or ""
    except subprocess.TimeoutExpired:
        log, p = "ui check timed out", None
    finally:
        shutil.rmtree(dtmp, ignore_errors=True)
    write_atomic(os.path.join(out_dir, "ui.log"), log)
    try:
        rep_ = json.loads(read(report_path, "") or "")
    except ValueError:
        rep_ = {"error": "the check script wrote no report; see ui.log:\n" + "\n".join(log.splitlines()[-20:])}
    rep_["design_info"] = {"why": dinfo.get("why"), "viewport": dinfo.get("viewport"), "thresholds": dinfo.get("thresholds"),
                           "packages": ["%s (%d states)" % (p_["version"], len(p_["codes"])) for p_ in dinfo.get("packages") or []]}
    if not rep_.get("error"):
        write_atomic(report_path, json.dumps(rep_, indent=1, ensure_ascii=False) + "\n")
    return ui_judge(rctx, rep_)


