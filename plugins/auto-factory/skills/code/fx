def cmd_status(ctx, a):
    rows = []
    for jid in ctx.list_ids():
        try:
            j = ctx.load_exact(jid)
        except (FxError, ValueError):
            continue
        rows.append({"job": jid, "stage": j["stage"], "round": "%d/%d" % (rounds_used(j), j["max_rounds"]),
                     "risk": j.get("risk"), "reviews": j.get("reviews"), "needs_human": j.get("needs_human"),
                     "pr": j.get("pr_url") or j.get("pr_hint"), "jira_pending": len(pending(j)),
                     "summary": j.get("summary"),
                     "repos": [{k: r[k] for k in ("name", "role", "branch", "base", "target", "pr")}
                               for r in job_repo_rows(None, j)]})
        if waits_of(j):  # how long its steps waited for room on this machine, and the longest of those waits with why
            rows[-1]["waited_for_room"] = waits_of(j)
        if j.get("rounds_returned"):
            rows[-1]["rounds_given_back"] = j["rounds_returned"]
    res = {"jobs": rows}
    reviews = review_rows(ctx)
    if reviews:
        res["reviews"] = reviews
    try:
        cfg = jobs_store_config(ctx)
    except FxError as e:
        cfg, res["jobs_store_error"] = None, str(e)  # fx doctor says what is wrong; the jobs can still be shown
    if cfg:
        for row in rows:
            st = jobs_local_state(ctx, cfg, row["job"])
            row["saved"] = st["state"] == "saved"
            if st["held_back"]:
                row["held_back"] = st["held_back"]
        res["unsaved"] = [r["job"] for r in rows if not r["saved"]]
    out(res)


def cmd_stage(ctx, a):
    job = ctx.load(a.job)
    woke = stack_wake(job) if job.get("rested") and a.stage != "needs-info" and a.stage not in TERMINAL else []
    ctx.move(job, a.stage, note=a.note or "manual", force=a.force)
    out(dict({"ok": True, "job": job["id"], "stage": job["stage"]}, **({"stack_started": woke} if woke else {})))


def parse_intake_meta(text):
    risk, surfaces = None, []
    for line in (text or "").splitlines()[:15]:
        m = re.match(r"^RISK:\s*(low|high)\s*$", line.strip(), re.I)
        if m:
            risk = m.group(1).lower()
        m = re.match(r"^SURFACES:\s*(.*)$", line.strip(), re.I)
        if m:
            surfaces = [s.strip().lower() for s in re.split(r"[,\s]+", m.group(1)) if s.strip() and s.strip() != "-"]
    return risk, surfaces


def set_needs_info(ctx, job, from_stage):
    q = os.path.join(ctx.job_dir(job["id"]), "questions.md")
    if not read(q, "").strip():
        raise FxError("%s asked for info but questions.md is missing or empty" % from_stage)
    job["resume_stage"] = from_stage
    ctx.move(job, "needs-info", "questions from %s" % from_stage)
    try:
        rested = stack_rest(ctx, job)
    except Exception:  # noqa: BLE001 - resting a stack is a saving, never a reason for the step to fail
        rested = None
    if rested:
        job["rested"] = rested
        ctx.save(job, "its stack stopped while it waits for answers (%d container%s)" % (
            len(rested["containers"]), "" if len(rested["containers"]) == 1 else "s"))
        hint("%s waits for a person: its %d container%s stopped meanwhile (about %d MB back), data kept; they start "
             "again with the answers" % (job["id"], len(rested["containers"]),
                                        "" if len(rested["containers"]) == 1 else "s", rested["memory_mb"]))


def job_clone_folders(ctx, job):
    """Every folder a job's containers can belong to: its clone, its packages' and candidates' clones, its job folder."""
    folders = [job.get("worktree"), ctx.job_dir(job["id"])]
    folders += [p.get("clone") for p in ((job.get("split") or {}).get("packages") or {}).values() if isinstance(p, dict)]
    folders += [c.get("worktree") for c in job.get("candidates") or [] if isinstance(c, dict)]
    return sorted({os.path.realpath(f) for f in folders if f and os.path.isdir(f)})


def container_loses_data(names):
    """The containers that keep data in memory (tmpfs: a test database, often): stopping them would lose it."""
    if not names:
        return set()
    text = try_out(["docker", "inspect", "--format", '{{.Name}}\t{{json .HostConfig.Tmpfs}}\t{{range .Mounts}}{{.Type}} {{end}}']
                   + list(names), timeout=60)
    if text is None:
        return set(names)  # not known: kept running
    lose = set()
    for line in text.splitlines():
        p = (line.split("\t") + ["", ""])[:3]
        if p[1].strip() not in ("", "null", "{}") or "tmpfs" in p[2].split():
            lose.add(p[0].lstrip("/"))
    return lose


def stack_rest(ctx, job):
    """A job that waits for a person to answer stops its containers meanwhile: a stack holds half a GB or more for as
    long as nobody answers, often hours. `docker stop`, so the containers and their volumes stay; they start again with
    the answers (stack_wake), and compose starts them anyway when the stack is brought up. Only when nothing of the job
    runs: no step of it holds a place on this machine, no package of it is being built. Never a container that also
    belongs to another clone (a stack several jobs share), one a step started (ZAP), or one that keeps data in memory
    (tmpfs), which a stop would lose. Returns {containers, memory_mb, at}, or None when nothing was stopped."""
    if os.environ.get("FACTORY_FAKE_MACHINE") or job.get("stage") != "needs-info":
        return None
    if any(isinstance(p, dict) and p.get("status") == "building"
           for p in ((job.get("split") or {}).get("packages") or {}).values()):
        return None
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
    if any(l.get("job") == job["id"] and l.get("kind") != "lane" and needs_room(l) for l in st["leases"].values()):
        return None
    folders = job_clone_folders(ctx, job)
    if not folders:
        return None
    docker = meter_docker(pick=lambda rows: [c for c in rows if container_of_folders(c, folders)])
    if not docker:
        return None
    work = os.path.realpath(ctx.work)

    def shared(c):
        return any(path_under(p, work) and p != work and not any(path_under(p, f) for f in folders)
                   for p in [c["workdir"]] + c["mounts"])

    own = [c for c in docker["containers"] if container_of_folders(c, folders) and not c["place"] and not shared(c)]
    lose = container_loses_data([c["name"] for c in own])
    stopped = [c for c in own if c["name"] not in lose
               and try_out(["docker", "stop", "-t", "10", c["name"]], timeout=120) is not None]
    if not stopped:
        return None
    return {"containers": sorted(c["name"] for c in stopped), "memory_mb": round(sum(c["mem_mb"] for c in stopped)),
            "kept_running": sorted(lose) or None, "at": now()}


def stack_wake(job):
    """Start again what stack_rest stopped, once the job goes on. A container removed since is left alone: whoever
    brings the stack up makes it anew. Returns the names started."""
    rested = job.pop("rested", None) or {}
    if os.environ.get("FACTORY_FAKE_MACHINE") or not rested.get("containers"):
        return []
    return [n for n in rested["containers"] if try_out(["docker", "start", n], timeout=120) is not None]


def cmd_result(ctx, a):
    job = ctx.load(a.job)
    step = a.step
    fname, rx = FIRST_LINE[step]
    path = os.path.join(ctx.job_dir(job["id"]), fname)
    role = {"intake": "intake", "spec": "spec", "build": "builder", "decision": "approver"}[step]
    line = first_line(path)
    if line is None:
        raise FxError("%s does not exist; the %s agent did not write it (or has not finished)" % (fname, role),
                      code=6, extra={"retry_agent": role})
    m = rx.match(line)
    if not m:
        raise FxError("first line of %s is %r, which is not a valid %s result" % (fname, line, step),
                      code=6, extra={"retry_agent": role})
    verdict = m.group(1)
    res = {"job": job["id"], "step": step, "result": verdict}

    if step == "intake":
        if job["stage"] != "intake":
            raise FxError("job is in stage %s, not intake" % job["stage"])
        text = read(path)
        wanted = intake_repos(ctx, job, text, verdict)
        risk, surfaces = parse_intake_meta(text)
        job["risk"] = risk or "high"
        job["surfaces"] = surfaces
        route(ctx, job)
        res.update(risk=job["risk"], surfaces=surfaces, models=job["models"], reviewers=job["reviewers"])
        if verdict == "ACCEPT":
            todo = [n for n in wanted if n not in job_names(job, "change")]
            if todo:
                proposed = job.get("repos_bases") or {}
                job["repos_pending"] = todo
                ctx.move(job, "spec", "intake ACCEPT, risk %s; repositories to clone: %s" % (job["risk"], ", ".join(todo)))
                res["repos"] = [{"name": n, "proposed_base": proposed.get(n) or proposed.get("*") or
                                 ctx.rc(n, "base_branch", "main")} for n in todo]
                res["next"] = "branches"
                res["then"] = ("%s branches --job %s gives each repository's branches; ask the user each one's base "
                               "branch (one AskUserQuestion, a question per repository), then %s repos %s %s" % (
                                   FX_CMD, job["id"], FX_CMD, job["id"],
                                   " ".join("--base %s=<branch>" % n for n in todo)))
            else:
                ctx.move(job, "spec", "intake ACCEPT, risk %s" % job["risk"])
                res["next"] = "spec"
        elif verdict == "NEEDS-INFO":
            set_needs_info(ctx, job, "intake")
            res["next"] = "ask"
        else:
            ctx.move(job, "rejected", "intake %s" % verdict)
            reason = section(text, "Reason") or "See the factory job files."
            body = ("**Software factory did not take %s.**\n\n%s\n\nThe run stopped; nothing was "
                    "changed in the code." % (job["issue_key"], reason))
            res["jira"] = jira_comment(ctx, job, body)
            res["clone"] = drop_clone(ctx, job)
            res["next"] = "reject"
    elif step == "spec":
        if job["stage"] != "spec":
            raise FxError("job is in stage %s, not spec" % job["stage"])
        conflicts = (read(os.path.join(ctx.job_dir(job["id"]), "logic-conflicts.md"), "") or "").strip()
        if conflicts and job.get("logic_conflicts_posted") != conflicts[:200]:
            res["logic_conflicts"] = jira_comment(ctx, job, (
                "**Software factory: this issue differs from the documented logic** (factory repository, "
                "`logic/`). The team is asked before any code is written.\n\n%s" % conflicts))
            job["logic_conflicts_posted"] = conflicts[:200]
        if verdict == "READY":
            job["build_reason"] = "first"
            ctx.move(job, "build", "spec READY")
            spec = read(path)
            r1 = jira_move(ctx, job, "start")
            body = "**Software factory started %s** (branch `%s`).\n\n## Goal\n\n%s\n\n" \
                   "## Acceptance criteria\n\n%s" % (job["issue_key"], job["branch"],
                                                     section(spec, "Goal") or "-",
                                                     section(spec, "Acceptance criteria") or "-")
            res["jira"] = {"transition": r1, "comment": jira_comment(ctx, job, body)}
            job["jira_started"] = "error" not in r1
            res["next"] = "build"
        else:
            set_needs_info(ctx, job, "spec")
            res["next"] = "ask"
    elif step == "build":
        if job["stage"] != "build":
            raise FxError("job is in stage %s, not build" % job["stage"])
        if verdict == "READY":
            listed = section(read(path), "Read before changing")
            if not re.search(r"[\w-]+/[\w./-]+|[\w-]+\.[A-Za-z]{1,6}\b", listed or ""):
                raise FxError("build.md has no '## Read before changing' list (the files read before editing: each "
                              "changed file, files of the same role, its tests and its callers)", code=6,
                              extra={"retry_agent": "builder"})
            res["next"] = "gate"
        elif verdict == "NEEDS-INFO":
            set_needs_info(ctx, job, "build")
            res["next"] = "ask"
        else:
            job["needs_human"] = True
            job["incomplete"] = True
            job["handoff_reason"] = "builder BLOCKED (see build.md)"
            ctx.move(job, "pr", "builder BLOCKED")
            res["next"] = "pr"
    elif step == "decision":
        if job["stage"] != "approve":
            raise FxError("job is in stage %s, not approve" % job["stage"])
        job["decision"] = verdict
        if verdict == "ESCALATE":
            job["needs_human"] = True
            job["handoff_reason"] = "approver ESCALATE (see decision.md)"
        elif job.get("flags"):
            # Deterministic backstop: sensitive paths always need a human, whatever the approver said.
            job["needs_human"] = True
            job["handoff_reason"] = "sensitive paths changed: %s" % ", ".join(job["flags"][:8])
            res["note"] = "APPROVE overridden to needs-human because sensitive paths changed"
        elif job.get("security_missed"):
            # A scanner that should have run did not: nobody may read that as a clean result.
            job["needs_human"] = True
            job["handoff_reason"] = "security scanners skipped: %s" % ", ".join(job["security_missed"])
            res["note"] = ("APPROVE overridden to needs-human because security scanners did not run: %s"
                           % ", ".join(job["security_missed"]))
        ctx.move(job, "pr", "approver %s" % verdict)
        res["next"] = "pr"
    finish(ctx, res, job)


