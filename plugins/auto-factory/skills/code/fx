    and that repository's."""
    if repo.get("legacy") or len(ctx.repos) <= 1:
        return knowledge_files(ctx, role, folder=review_knowledge_dir(ctx, repo))
    return knowledge_files(ctx, role, repos=[repo.get("repo") or repo["name"]])


