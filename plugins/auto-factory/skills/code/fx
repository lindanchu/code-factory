RUN_DEFAULT_SEC = {"intake": 40, "spec": 240, "planner": 60, "builder": 900, "integrator": 320, "security": 300,
                   "code": 60, "ux": 60, "ui": 60, "verifier": 180, "approver": 60, "judge": 120,
                   "setup": 90, "gate": 120, "checks": 300, "push": 60, "candidates": 180, "checklist": 60, "requirement": 120,
                   "scan": 120, "fit-checker": 300, "sandbox": 180, "runner": 600}
PHASES = ["intake", "spec", "planner", "build", "gate", "review", "approver", "push"]


def state_dir():
    return os.path.expanduser(os.environ.get("FACTORY_STATE_DIR") or "~/.cache/code-factory")


def board_file():
    return os.path.join(state_dir(), "board.html")


def iso_ts(s):
    try:
        return _dt.datetime.fromisoformat(s).timestamp() if s else None
    except (TypeError, ValueError):
        return None


def iso_of(ts):
    return _dt.datetime.fromtimestamp(ts, _dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def register_factory(path):
    reg = os.path.join(state_dir(), "factories.json")
    with ledger_lock():  # two sessions of two projects at once: neither drops the other's from the list
        try:
            known = json.loads(read(reg, "[]") or "[]")
        except ValueError:
            known = []
        before = list(known) if isinstance(known, list) else None
        known = [k for k in (known if isinstance(known, list) else []) if os.path.isfile(os.path.join(k, CONFIG_NAME))]
        if path not in known:
            known.append(path)
        if known != before:
            os.makedirs(state_dir(), exist_ok=True)
            write_atomic(reg, json.dumps(known, indent=1) + "\n")
    return known


def run_result_files(ctx, job, agent, wp=None, cand=None):
    """The file an agent writes when it is done (its mtime ends the run on the board)."""
    jd = ctx.job_dir(job["id"])
    rd = os.path.join(jd, "round-%d" % job["round"])
    if agent == "builder":
        name = ("build-%s.md" % wp) if wp else ("build-c%d.md" % cand) if cand else "build.md"
        return [os.path.join(jd, name)]
    files = {"intake": ["intake.md", "questions.md"], "spec": ["spec.md", "questions.md"], "planner": ["plan.md"],
             "approver": ["decision.md"], "judge": ["pick.md"]}
    if agent in files:
        return [os.path.join(jd, f) for f in files[agent]]
    if agent == "verifier":
        return [os.path.join(rd, "verify-security.md")]
    if agent in REVIEW_ROLES:
        return [os.path.join(rd, "review-%s.md" % agent)]
    return []


def record_run(ctx, job, agent, model, wp=None, cand=None, name=None, result=None):
    """fx ctx is called right before an agent is spawned: that is when its run starts."""
    runs = job.setdefault("runs", [])
    key = [agent, wp, cand, job["round"]]
    t = time.time()
    for r in runs:
        if r.get("ended") or [r.get("agent"), r.get("wp"), r.get("cand"), r.get("round")] != key:
            continue
        if t - (iso_ts(r.get("started")) or t) < 600:
            r.update(started=now(), model=model)  # the same spawn, prepared again
            ctx.save(job)
            return
        r.update(ended=now(), status="no result")  # an earlier try that wrote nothing
    runs.append({"agent": agent, "name": name or agent, "wp": wp, "cand": cand, "round": job["round"],
                 "model": model, "started": now(), "ended": None, "status": "running",
                 "result": result or run_result_files(ctx, job, agent, wp, cand)})
    ctx.save(job)


def close_runs(job):
    """A run ends when its result file is written after it started."""
    for r in job.get("runs") or []:
        if r.get("ended"):
            continue
        st = iso_ts(r.get("started")) or 0
        done = [os.path.getmtime(f) for f in r.get("result") or [] if os.path.exists(f)
                and os.path.getmtime(f) >= st - 1]
        if done:
            r.update(ended=iso_of(max(done)), status="done")


def mark_step(ctx, ref, name, start, result=None, only_one=False, lease=None):
    """fx's own long steps (setup, checks, gate, push) on the board. only_one: the caller holds the job (job_busy), so a
    step of this name still open is one whose fx was killed and never came back to say it ended. lease: the place the
    step was given, for how long it waited for it and why (a step that did not wait carries nothing)."""
    try:
        job = ctx.load(ref)
    except (FxError, ValueError, OSError):
        return
    steps = job.setdefault("steps", [])
    if start:
        for s_ in steps if only_one else []:
            if isinstance(s_, dict) and s_.get("step") == name and not s_.get("ended"):
                s_.update(ended=now(), result="stopped")
        row = {"step": name, "round": job.get("round"), "started": now(), "ended": None}
        waited = float((lease or {}).get("waited_all") or (lease or {}).get("waited") or 0)
        if waited >= WAIT_NOTED_SEC:
            row.update(waited_sec=round(waited), wait_why=str(lease.get("waited_because") or "")[:300])
        steps.append(row)
    else:
        open_ = [s for s in steps if s.get("step") == name and not s.get("ended")]
        if not open_:
            return
        open_[-1]["ended"] = now()
        if name == "gate":
            open_[-1]["result"] = result or job.get("gate")
        elif result:
            open_[-1]["result"] = result
    ctx.save(job)


def cmd_usage(ctx, a):
    job = ctx.load(a.job)
    runs = [r for r in job.get("runs") or [] if r.get("agent") == a.agent and r.get("wp") == a.wp
            and r.get("cand") == a.candidate]
    if not runs:
        raise FxError("no %s run recorded for %s (fx ctx records it)" % (a.agent, job["id"]))
    r = runs[-1]
    r["tokens"] = a.tokens
    if a.ms is not None:
        r["ms"] = a.ms
    if not r.get("ended"):
        r.update(ended=now(), status="done")
    ctx.save(job)
    out({"ok": True, "job": job["id"], "agent": a.agent, "tokens": a.tokens})


def median(xs):
    xs = sorted(xs)
    return xs[len(xs) // 2] if xs else None


def typical_durations(jobs):
    acc = {}
    for j in jobs:
        for r in j.get("runs") or []:
            a, b = iso_ts(r.get("started")), iso_ts(r.get("ended"))
            if a and b and r.get("status") == "done" and b >= a:
                acc.setdefault(r.get("name") or r.get("agent"), []).append(b - a)
        for s in j.get("steps") or []:
            a, b = iso_ts(s.get("started")), iso_ts(s.get("ended"))
            if a and b and b >= a:
                acc.setdefault(s.get("step"), []).append(b - a)
    return {k: median(v) for k, v in acc.items()}


def job_phase(job, running):
    names = {r["name"] for r in running}
    st = job.get("stage")
    if "push" in names or st == "pr":
        return "push"
    if "gate" in names:
        return "gate"
    if st == "intake":
        return "intake"
    if st == "needs-info":
        return "intake" if job.get("resume_stage") == "intake" else "spec" if job.get("resume_stage") == "spec" \
            else "build"
    if st == "spec":
        return "spec"
    if st == "build":
        return "planner" if "planner" in names else "build"
    return {"review": "review", "approve": "approver"}.get(st, "done")


def job_remaining(job, phase, running, typ):
    """Seconds left, from the typical time of each step still to come (no more rounds assumed)."""
    reviewers = job.get("reviewers") or ["security", "code"]
    split = (job.get("split") or {}).get("mode") == "split"
    planned = not job.get("split") and not job.get("best_of") and phase in ("intake", "spec", "planner")
    cost = {"intake": typ("intake"), "spec": typ("spec"), "planner": typ("planner") if planned else 0,
            "build": typ("builder") + (typ("integrator") if split else 0), "gate": typ("gate"),
            "review": max(typ(r) for r in reviewers), "approver": typ("approver"), "push": typ("push")}
    if phase not in PHASES:
        return 0
    i = PHASES.index(phase)
    now_ = time.time()
    here = [max(0.0, typ(r["name"]) - (now_ - r["t0"])) for r in running]
    current = max(here) if here else cost[phase]
    return current + sum(cost[p] for p in PHASES[i + 1:])


def board_running(runs, steps, typ):
    running = []
    for r in runs:
        if not r.get("ended") and iso_ts(r.get("started")):
            running.append({"kind": "agent", "name": r.get("name") or r["agent"], "agent": r["agent"],
                            "wp": r.get("wp"), "cand": r.get("cand"), "model": r.get("model"),
                            "start": r["started"], "t0": iso_ts(r["started"]), "typical": typ(r.get("name") or r["agent"])})
    for s in steps:
        if not s.get("ended") and iso_ts(s.get("started")):
            running.append({"kind": "step", "name": s["step"], "wp": s.get("wp"), "start": s["started"],
                            "t0": iso_ts(s["started"]), "typical": typ(s["step"])})
    return running


def board_segments(runs, steps, waits=()):
    """What a job's timeline is drawn from. waits: the times a step of the job waited for room on the machine or for a
    lane, each from when it asked until it started (job.json → waits; none in a job from before 1.9)."""
    segs = []
    for w in waits or ():
        if isinstance(w, dict) and iso_ts(w.get("asked")) and iso_ts(w.get("started")):
            what = ("%s %s" % (w.get("step") or "", w.get("name") or "")).strip()
            segs.append({"kind": "queue", "label": "queue", "start": w["asked"], "end": w["started"],
                         "status": "%s: %s" % (what, w.get("why") or "") if w.get("why") else what})
    for r in runs:
        if iso_ts(r.get("started")):
            segs.append({"kind": "agent", "label": "%s%s" % (r.get("name") or r["agent"],
                                                             " " + r["wp"] if r.get("wp") else ""),
                         "model": r.get("model"), "start": r["started"], "end": r.get("ended"),
                         "status": r.get("status"), "tokens": r.get("tokens")})
    for s in steps:
        if iso_ts(s.get("started")):
            segs.append({"kind": "step", "label": s["step"], "start": s["started"], "end": s.get("ended"),
                         "status": s.get("result") or ("running" if not s.get("ended") else "done")})
    return segs


def board_cost(runs, rates):
    tokens = sum(r.get("tokens") or 0 for r in runs)
    cost = None
    if tokens and rates:
        priced = [(r.get("tokens") or 0, rates.get(r.get("model"))) for r in runs if r.get("tokens")]
        if all(rate is not None for _, rate in priced):
            cost = round(sum(t * float(rate) / 1e6 for t, rate in priced), 2)
    return tokens, cost


def board_queue():
    """Who waits for room on this machine right now: {(factory, job): the ticket}. Read without the lock: a view."""
    try:
        st = json.loads(read(os.path.join(ledger_dir(), "state.json"), "") or "{}")
    except ValueError:
        return {}
    t = time.time()
    return {(q.get("factory"), q.get("job")): q for q in (st.get("queue") or []) if isinstance(q, dict) and q.get("job")
            and not q.get("kept_until") and t - float(q.get("seen") or 0) < 60}


def job_view(factory, project, job, med, rates, queued=None):
    jd = os.path.join(factory, "jobs", job["id"])
    typ = lambda n: med.get(n) or RUN_DEFAULT_SEC.get(n, 120)
    st = job.get("stage")
    active = st not in ("handed-off", "rejected")
    runs, steps = job.get("runs") or [], job.get("steps") or []
    running = board_running(runs, steps, typ)
    q = (queued or {}).get((factory, job["id"]))
    if q and active:  # in the line for room on this machine: it starts by itself, nobody has to do anything
        running.append({"kind": "step", "name": "queue", "wp": q.get("name") if q.get("kind") == "package" else None,
                        "start": iso_of(q["enqueued"]), "t0": q["enqueued"], "typical": typ("queue")})
    waiting = "questions" if st == "needs-info" else "target" if st == "pr" and not running else None
    phase = job_phase(job, running) if active else "done"
    eta = None
    if active and not waiting:
        eta = iso_of(time.time() + job_remaining(job, phase, running, typ))
    segs = board_segments(runs, steps, job.get("waits"))
    hist, wait_start = job.get("history") or [], None
    for h in hist:
        if h.get("stage") == "needs-info" and wait_start is None:
            wait_start = h.get("at")
        elif h.get("stage") != "needs-info" and wait_start:
            segs.append({"kind": "wait", "label": "questions", "start": wait_start, "end": h.get("at")})
            wait_start = None
    if wait_start:
        segs.append({"kind": "wait", "label": "questions", "start": wait_start, "end": None})
    tokens, cost = board_cost(runs, rates)
    files = []
    rounds = sorted(int(m.group(1)) for m in (re.match(r"^round-(\d+)$", n) for n in
                                                (os.listdir(jd) if os.path.isdir(jd) else [])) if m)
    last = os.path.join(jd, "round-%d" % rounds[-1]) if rounds else None
    for label, path in [("issue", os.path.join(jd, "issue.md")), ("spec", os.path.join(jd, "spec.md")),
                        ("plan", os.path.join(jd, "plan.md")), ("questions", os.path.join(jd, "qa-log.md"))] + \
            ([("checks", os.path.join(last, "checks.md")), ("ui", os.path.join(last, "ui.md")),
              ("security", os.path.join(last, "security.md"))] +
             [("review " + f[7:-3], os.path.join(last, f)) for f in sorted(os.listdir(last))
              if f.startswith("review-") and f.endswith(".md")] if last else []) + \
            [("decision", os.path.join(jd, "decision.md")), ("pr-body", os.path.join(jd, "pr-body.md")),
             ("screenshots", os.path.join(jd, "ui"))]:
        if path and os.path.exists(path):
            files.append({"label": label, "path": path})
    return {"factory": factory, "project": project, "id": job["id"], "key": job.get("issue_key"),
            "summary": job.get("summary"), "url": job.get("issue_url"), "stage": st, "phase": phase,
            "active": active, "waiting": waiting,
            "round": job.get("round", 0) - job.get("round_start", 0) - int(job.get("rounds_returned") or 0),
            "max_rounds": job.get("max_rounds"), "base": job.get("base_branch"),
            "target": job.get("target_branch"), "branch": job.get("branch"),
            "created": job.get("created_at"), "updated": job.get("updated_at"), "running": running, "eta": eta,
            "segments": segs, "tokens": tokens, "cost": cost, "files": files,
            "decision": job.get("decision"), "needs_human": job.get("needs_human"),
            "reason": job.get("handoff_reason"), "pr": job.get("pr_url") or job.get("pr_hint"),
            "split": len(((job.get("split") or {}).get("packages") or {})) or None,
            "packages": board_packages(job), "best_of": job.get("best_of") if not job.get("best_of_done") else None,
            "repos": [{k: r[k] for k in ("name", "role", "branch", "base", "target", "pr")}
                      for r in job_repo_rows(None, job)] if isinstance(job.get("repos"), dict) else []}


def board_packages(job):
    """The packages of a split build, in plan order, for the board: what each builds, its status, what it waits for."""
    sp = job.get("split") or {}
    pkgs = sp.get("packages") or {}
    if sp.get("mode") != "split" or not pkgs:
        return None
    return [{"id": k, "title": pkgs[k].get("title") or k, "status": pkgs[k].get("status"), "after": pkgs[k].get("after") or []}
            for k in (sp.get("order") or list(pkgs)) if k in pkgs]


REVIEW_ORDER = ["fetch", "checklist", "run", "review", "verify", "decide"]
REVIEW_WAITING = {"conflict": "rconflict", "decide": "rchoose", "drafted": "rconfirm"}


def review_stage_of(members, run):
    """One word for a review, of one merge request or several: where the one furthest behind is."""
    if not run:
        return members[0].get("stage")
    if run.get("stage") in ("conflict", "fit", "decide", "drafted", "done"):
        return run["stage"]
    stages = [m.get("stage") for m in members]
    behind = min(stages, key=lambda s: REVIEW_ORDER.index(s) if s in REVIEW_ORDER else len(REVIEW_ORDER))
    return "fit" if behind == "decide" else behind


def review_view(factory, project, members, run, med, rates):
    """A card on the board: one merge request, or every merge request of a ticket reviewed together."""
    typ = lambda n: med.get(n) or RUN_DEFAULT_SEC.get(n, 120)
    several = len(members) > 1
    tell = {m["id"]: m.get("repo") or project for m in members}
    if several and len(set(tell.values())) < len(tell):
        tell = {m["id"]: "%s !%s" % (tell[m["id"]], (m.get("mr") or {}).get("iid")) for m in members}
    runs, steps, mrs, files, waits = [], [], [], [], []
    for m in members:
        close_runs(m)
        mine = {"wp": tell[m["id"]]} if several else {}
        runs += [dict(r, **({} if r.get("agent") == "fit-checker" else mine)) for r in m.get("runs") or []]  # the whole ticket's
        steps += [dict(s, **mine) for s in m.get("steps") or []]
        waits += [w for w in m.get("waits") or [] if isinstance(w, dict)]
        mr = m.get("mr") or {}
        jd = os.path.join(factory, "jobs", m["id"])
        rd = os.path.join(jd, "round-%d" % m.get("round", 1))
        open_runs = {r.get("agent") for r in m.get("runs") or [] if not r.get("ended")}
        mrs.append({"name": tell[m["id"]], "iid": mr.get("iid"), "url": mr.get("url"), "title": mr.get("title"),
                    "author": mr.get("author"), "target": mr.get("target"), "stage": m.get("stage"),
                    "ci": (m.get("ci") or {}).get("status"), "merge_state": m.get("merge_state"),
                    "reviewers": [{"name": r, "state": "done" if os.path.exists(os.path.join(rd, "review-%s.md" % r))
                                   else "running" if r in open_runs else "todo"} for r in m.get("reviewers") or []]})
        prefix = tell[m["id"]] + ": " if several else ""
        for label, p in [("mr", os.path.join(jd, "mr.md")), ("scanners", os.path.join(rd, "security.md")),
                         ("run", os.path.join(rd, "run.md")), ("calls", os.path.join(rd, "run", "calls.jsonl")),
                         ("report", os.path.join(rd, "review.md"))] + \
                [("review " + f[7:-3], os.path.join(rd, f)) for f in sorted(os.listdir(rd) if os.path.isdir(rd) else [])
                 if f.startswith("review-") and f.endswith(".md")]:
            if os.path.exists(p):
                files.append({"label": prefix + label, "path": p})
    first = members[0]
    lead_dir = os.path.join(factory, "jobs", (run or {}).get("lead") or first["id"])
    lead = next((m for m in members if run and m["id"] == run.get("lead")), first)
    lead_round = os.path.join(lead_dir, "round-%d" % lead.get("round", 1))
    files[:0] = [{"label": label, "path": p} for label, p in (("issue", os.path.join(lead_dir, "issue.md")),
                                                              ("checklist", os.path.join(lead_round, "checklist.md")))
                 if os.path.exists(p)]
    if run:
        tdir = os.path.join(factory, "jobs", REVIEW_DIR, "_ticket-%s" % run["key"], "round-%d" % run["round"])
        files += [{"label": label, "path": os.path.join(tdir, name)} for label, name in (("fit", "fit.md"), ("comment", "comment.md"))
                  if os.path.exists(os.path.join(tdir, name))]
    else:
        p = os.path.join(lead_round, "comment.md")
        if os.path.exists(p):
            files.append({"label": "comment", "path": p})
    st = review_stage_of(members, run)
    active = st != "done"
    running = board_running(runs, steps, typ)
    names = {r["name"] for r in running}
    phase = {"fetch": "checklist", "checklist": "scan" if "scan" in names else "checklist", "run": "run", "review": "review",
             "verify": "verify", "fit": "fit", "conflict": "decide", "decide": "decide", "drafted": "post"}.get(st, "done")
    waiting = REVIEW_WAITING.get(st) if active else None
    eta = None
    if active and not waiting:
        here = max([max(0.0, typ(r["name"]) - (time.time() - r["t0"])) for r in running] or [0.0])
        left = typ("checklist") if phase == "checklist" and not running else 0.0
        if phase in ("checklist", "scan"):
            left += typ("scan") * len(members)
        if phase in ("checklist", "scan"):
            left += typ("sandbox") + typ("runner")
        if phase in ("checklist", "scan", "run", "review"):  # one merge request at a time, its reviewers side by side
            left += sum(max(typ(r) for r in m.get("reviewers") or ["security", "code", "requirement"]) for m in members
                        if m.get("stage") in ("fetch", "checklist", "run", "review")
                        and not any(not r.get("ended") for r in m.get("runs") or []))
        if several and (phase != "fit" or not running):
            left += typ("fit-checker")
        eta = iso_of(time.time() + here + left)
    tokens, cost = board_cost(runs, rates)
    times = [t for t in [m.get("updated_at") for m in members] + [(run or {}).get("updated_at")] if t]
    return {"kind": "review", "factory": factory, "project": project, "id": "_ticket-%s" % run["key"] if run else first["id"],
            "key": first.get("issue_key"), "summary": first.get("summary"), "url": first.get("issue_url"), "stage": st,
            "phase": phase, "phases": ["checklist", "scan", "run", "review", "verify"] + (["fit"] if several else []) + ["decide", "post"],
            "active": active, "waiting": waiting, "round": (run or first).get("round", 1), "mrs": mrs,
            "created": min(m.get("created_at") or "" for m in members), "updated": max(times) if times else None,
            "running": running, "eta": eta, "segments": board_segments(runs, steps, waits), "tokens": tokens, "cost": cost,
            "files": files, "decision": first.get("outcome"), "needs_human": False}


def board_reviews(factory, project, rates):
    top = os.path.join(factory, "jobs", REVIEW_DIR)
    jobs, tickets = {}, {}
    for name in sorted(os.listdir(top)) if os.path.isdir(top) else []:
        for store, fname in ((jobs, "job.json"), (tickets, "ticket.json")):
            p = os.path.join(top, name, fname)
            if os.path.isfile(p):
                try:
                    d = json.loads(read(p, "{}") or "{}")
                except ValueError:
                    continue
                if isinstance(d, dict) and (d.get("id") or d.get("key")):
                    store[d.get("id") or d["key"]] = d
    med = typical_durations(list(jobs.values()))
    views, taken = [], set()
    for key, run in tickets.items():
        members = [jobs[i] for i in run.get("members") or [] if i in jobs and (jobs[i].get("ticket") or {}).get("key") == key]
        if members:
            taken.update(m["id"] for m in members)
            views.append(review_view(factory, project, members, run, med, rates))
    views += [review_view(factory, project, [j], None, med, rates) for i, j in jobs.items() if i not in taken]
    return views


def board_data(factories):
    data = {"generated": now(), "factories": [], "active": [], "done": [], "lang": "en"}
    queued = board_queue()
    for f in factories:
        try:
            cfg = json.loads(read(os.path.join(f, CONFIG_NAME), "{}") or "{}")
        except ValueError:
            continue
        proj = cfg.get("project") or {}
        name = proj.get("name") or re.sub(r"\.git$", "", os.path.basename(str(proj.get("url") or f).rstrip("/"))) \
            or os.path.basename(f)
        if str(cfg.get("language") or "").lower().startswith("vi"):
            data["lang"] = "vi"
        jobs = []
        jdir = os.path.join(f, "jobs")
        for jid in sorted(os.listdir(jdir)) if os.path.isdir(jdir) else []:
            p = os.path.join(jdir, jid, "job.json")
            if jid.startswith((".", "_")) or not os.path.isfile(p):
                continue
            try:
                raw = json.loads(read(p, "{}") or "{}")
            except ValueError:
                continue
            if isinstance(raw, dict):
                own = config_repos(cfg)[0]
                jobs.append(job_flat_copy(raw, own[0]["name"] if own else None))
        med = typical_durations(jobs)
        rates = ((cfg.get("dashboard") or {}).get("usd_per_mtok") or {})
        saved_state = jobs_board_state(f, cfg)
        data["factories"].append({"path": f, "name": name, "jobs": len(jobs)})
        for j in jobs:
            if j.get("id"):
                v = job_view(f, name, j, med, rates, queued)
                if saved_state:
                    st = saved_state(j["id"])
                    v["unsaved"] = st["state"] != "saved"
                    if st["held_back"]:
                        v["held_back"] = len(st["held_back"])
                (data["active"] if v["active"] else data["done"]).append(v)
        for v in board_reviews(f, name, rates):
            (data["active"] if v["active"] else data["done"]).append(v)
    data["active"].sort(key=lambda v: v.get("updated") or "", reverse=True)
    data["done"].sort(key=lambda v: v.get("updated") or "", reverse=True)
    del data["done"][25:]
    return data


def write_board(factories):
    data = board_data(factories)
    blob = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    os.makedirs(state_dir(), exist_ok=True)
    write_atomic(board_file(), BOARD_HTML.replace("__DATA__", blob))
    return data


def board_refresh(ctx):
    """Every fx command in a factory repository rewrites the board. It never breaks the command."""
    if not ctx or not getattr(ctx, "cfg", None):
        return
    try:
        write_board(register_factory(ctx.factory))
    except Exception:  # noqa: BLE001 - the board is a view, never a reason to fail
        pass


def cmd_board(ctx, a):
    factories = register_factory(ctx.factory) if ctx and ctx.cfg else [
        f for f in json.loads(read(os.path.join(state_dir(), "factories.json"), "[]") or "[]")
        if os.path.isfile(os.path.join(f, CONFIG_NAME))]
    data = write_board(factories)
    url = "file://" + urllib.parse.quote(board_file())
    opened = None
    if a.open:
        for opener in ("open", "xdg-open", "wslview"):
            if shutil.which(opener):
                opened = run([opener, board_file()], check=False, timeout=30).returncode == 0
                break
    out({"ok": True, "path": board_file(), "url": url, "opened": opened, "factories": len(data["factories"]),
         "active": len(data["active"]), "next": "tell the user to open the board in a browser (it reloads itself "
                                                 "every few seconds; every fx command updates it)"})


