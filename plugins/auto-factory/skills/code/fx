    knowledge/<repo>/ (the shared files at the top of knowledge/ come with it: review_knowledge_files)."""
    if repo.get("legacy"):
        return os.path.join(knowledge_dir(ctx), "repos", repo["name"])
    if len(ctx.repos) <= 1:
        return knowledge_dir(ctx)
    return repo_knowledge_dir(ctx, repo.get("repo") or repo["name"])


def review_knowledge_files(ctx, role, repo):
