    s.add_argument("--job", help="the job this is for; needed when the list is in the project (baselines.repo)")
    s.add_argument("--clone", help="a package's or candidate's clone, when the list is in the project")
    s.add_argument("--commit", action="store_true", help="push, migrate: commit the list once S3 has every image")
    s.add_argument("--allow-removed", action="store_true", help="record: images gone from the folder leave the list")
    s.add_argument("--from", dest="from_ref", help="diff: the commit to compare from")
    s.add_argument("--to", dest="to_ref", help="diff: the commit to compare to (default: the working list)")
    s.add_argument("--out", help="diff: the folder for the before and after images")
    s.set_defaults(fn=cmd_baselines)
    s = sub.add_parser("jobs", help="the jobs' folders on S3, to get them back on another machine")
    s.add_argument("action", choices=["push", "status", "list", "pull"])
    s.add_argument("names", nargs="*", help="push, pull: the jobs (push without any: all of them)")
    s.add_argument("--all", action="store_true", help="push, pull: every job")
    s.add_argument("--dry-run", action="store_true", help="push: scan and say what would go, upload nothing")
    s.add_argument("--at", help="pull: the newest snapshot at or before this UTC time (as fx jobs list prints it)")
    s.add_argument("--force", action="store_true", help="pull: move a job that is already here to jobs/_replaced/")
    s.set_defaults(fn=cmd_jobs)
    s = sub.add_parser("selftest", help="fresh clone of each repository: setup, checks, app, e2e; writes baseline.json")
    s.add_argument("--repo", dest="repo_name", metavar="NAME", help="only this repository")
    s.add_argument("--no-app", action="store_true")
    s.add_argument("--keep", action="store_true", help="keep the _selftest clone for inspection")
    s.add_argument("--no-zap", action="store_true", help="skip the ZAP baseline on the base branch")
    s.set_defaults(fn=cmd_selftest)

    s = sub.add_parser("init", help="set this factory repository up for one project and its repositories; run again "
                       "to add a repository or to bring an older factory.json to the form with repos")
    s.add_argument("--project-name", help="the project's name (a new factory: default the first repository's)")
    s.add_argument("--repo", dest="repo_specs", action="append", metavar="NAME=URL",
                   help="a repository of the project: its name (lower case letters, digits and -) and its git URL, or a "
                   "local folder whose remote is used; repeatable, in merge order; a new name adds it")
    s.add_argument("--project", help="shorthand for a project of one repository: its git URL (or a local folder), "
                   "named after --project-name or the URL")
    s.add_argument("--initial-commit", action="store_true",
                   help="an empty repository: push an empty first commit to it (ask the user first)")
    s.add_argument("--import", dest="import_from", help="copy factory/ from an older in-project setup at this folder "
                   "(a project of one repository)")
    s.set_defaults(fn=cmd_init)
    s = sub.add_parser("init-local", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_init, initial_commit=False, project=None, import_from=None, repo_specs=None,
                   project_name=None)

    s = sub.add_parser("code", help="open or close a read-only clone of a repository (init, intake, audit)")
    s.add_argument("action", choices=["open", "close"])
    s.add_argument("--repo", dest="repo_name", metavar="NAME", help="the repository (may be left out with one)")
    s.set_defaults(fn=cmd_code)
    s = sub.add_parser("where", help="paths: factory repository, work folder, jobs, knowledge, repositories, this "
                       "machine's keys folder")
    s.set_defaults(fn=cmd_where)

    s = sub.add_parser("doctor")
    s.add_argument("--issue", help="a Jira link to test read access")
    s.set_defaults(fn=cmd_doctor)
    return p


def main(argv=None):
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _exit_on_signal)
    argv = list(sys.argv[1:] if argv is None else argv)
    gone = removed_command(argv)
    if gone:
        out({"ok": False, "error": gone, "exit_code": 3, "unknown_command": True})
        sys.exit(3)
    a = build_parser().parse_args(argv)
    _MAX_WAIT[0] = a.max_wait
    _LANE_NAMED.clear()  # what a command found out about the factory repository's files holds for that command
    os.environ.setdefault("SEMGREP_ENABLE_VERSION_CHECK", "0")  # its update check hangs behind proxies
    # git and the scanners read what the commits hold, whatever refs/replace or a grafts file says
    os.environ.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE=os.path.join(os.devnull, "none"))
    if tools_bin() not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = tools_bin() + os.pathsep + os.environ.get("PATH", "")  # tools fx installed itself
    try:
        if a.repo:
            target = os.path.expanduser(a.repo)
            if not os.path.isdir(target):
                raise FxError("factory repository %s not found" % a.repo, code=3)
            os.chdir(target)
        if a.fn in (cmd_install, cmd_tools, cmd_board, cmd_capacity, cmd_run, cmd_mobile):
            try:
                ctx = Ctx(require_config=False)  # a factory repository is optional here
            except FxError:
                ctx = None
        else:
            ctx = Ctx(require_config=a.fn not in (cmd_init, cmd_doctor, cmd_reference, cmd_tools))
        # setup, gate and candidates go on the board themselves, once they have their place on the machine
        step = {cmd_pr: "push"}.get(a.fn)
        ref = getattr(a, "job", None) if step and ctx and ctx.cfg else None
        if a.fn in (cmd_ctx, cmd_result, cmd_setup, cmd_gate, cmd_verdicts, cmd_answers, cmd_ask_jira, cmd_pr, cmd_rework,
                    cmd_split, cmd_wp, cmd_candidates, cmd_judge_prep, cmd_pick, cmd_stage, cmd_cleanup, cmd_agent_id,
                    cmd_repos) \
                and ctx and ctx.cfg and getattr(a, "job", None):
            job_owner_check(ctx, a.job)
        if ref:
            mark_step(ctx, ref, step, True)
        try:
            a.fn(ctx, a)
        except PlaceWait as e:
            raise place_refusal(e, "this step")
        finally:
            baselines_release()
            ports_done()
            if ref:
                mark_step(ctx, ref, step, False)
            if a.fn is not cmd_board:
                board_refresh(ctx)
    except FxError as e:
        res = {"ok": False, "error": str(e), "exit_code": e.code}
        res.update(e.extra)
        out(res)
        sys.exit(e.code)


if __name__ == "__main__":
    main()
