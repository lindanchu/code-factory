def mr_fetch_head(wt, iid):
    """Works for a branch of a fork too, which the clone's own branches never hold."""
    if git(["fetch", "-q", REMOTE, "refs/merge-requests/%d/head" % iid], wt, check=False).returncode != 0:
        return None
    return git(["rev-parse", "FETCH_HEAD"], wt).stdout.strip()


def mr_try_merge(ctx, iid, target, url=None):
    """Merge in a throw-away clone, which runs nothing of the project. Returns (conflict or clean or None, files)."""
    wt = os.path.join(ctx.work, "_review-merge-%d" % os.getpid())
    try:
        clone_project(ctx, wt, url=url)
        head = mr_fetch_head(wt, iid)
        if not head:
            return None, []
        p = git(["-c", "core.quotepath=off", "merge-tree", "--write-tree", "--name-only",
                 "%s/%s" % (REMOTE, target), head], wt, check=False)
        if p.returncode == 0:
            return "clean", []
        if p.returncode != 1:
            return None, []
        lines = (p.stdout or "").splitlines()[1:]  # the tree, then the files up to an empty line, then messages
        return "conflict", lines[:lines.index("")] if "" in lines else lines
    except FxError:
        return None, []
    finally:
        shutil.rmtree(wt, ignore_errors=True)


def mr_merge_state(ctx, d, url=None):
    """conflict, clean or unknown, with the files in conflict when a merge could name them. While GitLab is still
    working the answer out, has_conflicts may be an old one, so the merge is tried here."""
    if d.get("state") == "merged":
        return "merged", []
    status = d.get("detailed_merge_status") or d.get("merge_status") or ""
    if status in MR_UNSETTLED:
        state, files = mr_try_merge(ctx, d["iid"], d["target_branch"], url)
        return state or "unknown", files
    if status == "conflict" or d.get("has_conflicts"):
        _, files = mr_try_merge(ctx, d["iid"], d["target_branch"], url)
        return "conflict", files
    return "clean", []


