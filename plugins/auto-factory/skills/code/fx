# --------------------------------------------------------------------------
# The design, measured: the auto test's comparer on a job's or a review's screens (t.design in a UI check script)

DESIGN_INDEX = "autotest-states.json"
DESIGN_DECISIONS = ("ok", "code", "design", "different data")
DESIGN_REPO_FRESH_SEC = 600  # the copy of the auto test repository is fetched again after this long
DESIGN_REPO_LOCK_SEC = 300
DESIGN_PROFILE_RE = re.compile(r"^ui-profile(\.[A-Za-z0-9_-]+)*\.(js|json)$")


def test_skill_dir():
    """Where the comparer, the app runtime and the reading of a design package are: the copy shipped inside this skill
    (shared/, in a plugin without the auto test), else the auto test's skill next to this one."""
    for d in [os.path.join(SKILL_DIR, "shared")] + [os.path.join(os.path.dirname(SKILL_DIR), n)
                                                    for n in ("test", "auto-factory-test")]:
        if os.path.isfile(os.path.join(d, "runtime", "uicheck", "index.js")):
            return d
    return None


def tx_design():
    """The auto test's own reading of a design package, so that both make the same state table."""
    d = test_skill_dir()
    if not d:
        return None
    if d not in sys.path:
        sys.path.insert(0, d)
    try:
        from txlib import design as m
    except ImportError:
        return None
    return m


def design_packages(top):
    """The design packages under a folder: each folder holding a page (.html) and a Spec (.md), nearest first."""
    found = []
    if not top or not os.path.isdir(top):
        return found
    depth = os.path.abspath(top).rstrip(os.sep).count(os.sep)
    for dirpath, dirnames, files in os.walk(top):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith((".", "__MACOSX")))
        if any(f.endswith(".html") for f in files) and any(f.endswith(".md") and "spec" in f.lower() for f in files):
            found.append(dirpath)
            dirnames[:] = []
        elif os.path.abspath(dirpath).count(os.sep) - depth >= 4:
            dirnames[:] = []
    return found


def design_index(folder, write=True):
    """A package's state table: the one it has, or the one the auto test makes for it, written next to it when `write`
    (as tx does). Returns (index or None, problems)."""
    path = os.path.join(folder, DESIGN_INDEX)
    if os.path.isfile(path):
        try:
            return json.loads(read(path, "") or ""), []
        except ValueError:
            pass
    m = tx_design()
    if not m:
        return None, ["the auto test skill is not installed next to this one, so the package has no state table"]
    idx, problems = m.build_index(folder, os.path.basename(folder.rstrip(os.sep)))
    if write:
        write_atomic(path, json.dumps(idx, indent=1, ensure_ascii=False) + "\n")
    return idx, problems


def design_repo(ctx):
    """The project's auto test repository, read from a copy in this machine's cache that fx keeps up to date and only
    reads: (folder, None), or (None, why)."""
    url = str(ctx.c("ui_checks.design.test_repo") or "").strip()
    if not url:
        return None, ("this factory has no auto test repository (ui_checks.design.test_repo): its thresholds and its way "
                      "of reading each screen's data are what measuring needs")
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", re.sub(r"\.git$", "", url.rstrip("/")).split("/")[-1]) or "repo"
    dest = os.path.join(state_dir(), "design-repos", "%s-%s" % (name, hashlib.sha256(url.encode()).hexdigest()[:10]))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    have = os.path.isdir(os.path.join(dest, ".git"))
    with open(dest + ".lock", "w") as lk:
        if not flock_wait(lk, "exclusive", DESIGN_REPO_LOCK_SEC):
            return (dest, None) if have else (None, "another fx kept the copy of the auto test repository busy")
        if have:
            head = os.path.join(dest, ".git", "FETCH_HEAD")
            if time.time() - os.path.getmtime(head if os.path.exists(head) else os.path.join(dest, ".git", "HEAD")) \
                    > DESIGN_REPO_FRESH_SEC:
                r = run(["git", "fetch", "-q", "--depth", "1", "origin", "HEAD"], cwd=dest, check=False, timeout=300)
                if r.returncode == 0:  # one that fails keeps the copy as it was; the next run tries again
                    run(["git", "reset", "-q", "--hard", "FETCH_HEAD"], cwd=dest, check=False, timeout=120)
            return dest, None
        shutil.rmtree(dest, ignore_errors=True)
        r = run(["git", "clone", "-q", "--depth", "1", url, dest], check=False, timeout=900)
        if r.returncode != 0:
            shutil.rmtree(dest, ignore_errors=True)
            return None, "could not clone the auto test repository %s: %s" % (url, (r.stdout or "").strip()[-300:])
    return dest, None


def design_conf(repo):
    try:
        with open(os.path.join(repo, "autotest.json"), encoding="utf-8") as f:
            conf = json.load(f)
        return conf if isinstance(conf, dict) else None
    except (OSError, ValueError):
        return None


def design_info(ctx, job):
    """What measuring a job's (or a review's) screens against the design uses, or why it cannot: the design packages
    (the ticket's, else the auto test repository's current one), the auto test repository with its thresholds, screen
    size and profile."""
    info = {"packages": [], "repo": None, "profile": [], "viewport": [1440, 900], "thresholds": None, "why": None}
    repo, why = design_repo(ctx)
    conf = design_conf(repo) if repo else None
    if repo and conf is None:
        why = "the auto test repository has no autotest.json yet: /auto-factory:test init sets it up"
    info["repo"] = repo
    if conf:
        lib = os.path.join(repo, str((conf.get("web") or {}).get("dir") or "web"), "lib")
        info["profile"] = sorted(os.path.join(lib, f) for f in (os.listdir(lib) if os.path.isdir(lib) else [])
                                 if DESIGN_PROFILE_RE.match(f) and os.path.isfile(os.path.join(lib, f)))
        m = re.match(r"^\s*(\d+)\s*x\s*(\d+)\s*$", str((conf.get("run") or {}).get("viewport") or "1440x900"))
        if m:
            info["viewport"] = [int(m.group(1)), int(m.group(2))]
        conv = conf.get("conventions") or {}
        val = {k: (conv.get(k) or {}).get("value") if isinstance(conv.get(k), dict) else None
               for k in ("ui_threshold", "ui_percent_from")}
        if all(v is not None for v in val.values()):
            info["thresholds"] = val
    tops = design_packages((job.get("design") or {}).get("dir"))
    if not tops and conf:
        d = conf.get("design") or {}
        current = str(d.get("current") or "")
        pkg = os.path.join(repo, str(d.get("dir") or "design-src"), current) if current else None
        if pkg and os.path.isfile(os.path.join(pkg, DESIGN_INDEX)):
            tops = [pkg]
    for top in tops:
        idx, problems = design_index(top, write=not (repo and top.startswith(repo + os.sep)))
        info["packages"].append({"dir": top, "index": os.path.join(top, DESIGN_INDEX),
                                 "version": str((idx or {}).get("version") or os.path.basename(top)),
                                 "codes": sorted((idx or {}).get("states") or {}), "problems": problems[:10]})
    if not info["packages"]:
        why = why or ("no design package with a state table: the ticket attaches none, and the auto test repository "
                      "has no current one")
    info["why"] = why
    return info


def design_setup(ctx, job):
    """What t.design needs, in a throw-away folder laid out like a test repository, one per design package, so that the
    auto test's comparer runs unchanged; nothing of the auto test repository goes into the job folder. Returns (the
    environment of the check script, the folder to delete afterwards, design_info)."""
    info = design_info(ctx, job)
    tmp = tempfile.mkdtemp(prefix="fx-design-")
    setup = {"packages": [], "viewport": info["viewport"], "why": info["why"]}
    tdir = test_skill_dir()
    if not setup["why"] and not tdir:
        setup["why"] = "the auto test skill is not installed next to this one"
    if not setup["why"]:
        conv = dict((design_conf(info["repo"]) or {}).get("conventions") or {})
        conv["ui_bad"] = {"value": "column"}  # the comparer judges; whether a heavy difference blocks is the reviewer's
        for k, pkg in enumerate(info["packages"], 1):
            root = os.path.join(tmp, str(k))
            shutil.copytree(os.path.join(tdir, "runtime", "uicheck"), os.path.join(root, "web", "autotest", "uicheck"),
                            ignore=shutil.ignore_patterns(".*", "node_modules"))
            os.makedirs(os.path.join(root, "web", "lib"))
            for f in info["profile"]:
                shutil.copyfile(f, os.path.join(root, "web", "lib", os.path.basename(f)))
            write_atomic(os.path.join(root, "autotest.json"), json.dumps(
                {"conventions": conv, "design": {"dir": os.path.dirname(pkg["dir"]), "current": os.path.basename(pkg["dir"])}},
                indent=1, ensure_ascii=False) + "\n")
            setup["packages"].append({"root": root, "version": pkg["version"], "codes": pkg["codes"]})
    path = os.path.join(tmp, "setup.json")
    write_atomic(path, json.dumps(setup, indent=1, ensure_ascii=False) + "\n")
    return {"FACTORY_UI_DESIGN": path}, tmp, info


def design_line(ctx, job):
    """The prompt line of an agent that writes or reads a UI check: what t.design measures with, or why not."""
    info = design_info(ctx, job)
    if info["why"]:
        return "Design measurement: not available (%s). Compare the screens with the design by eye" % info["why"]
    th = info["thresholds"]
    return ("Design measurement: `await t.design('<state code>', { ... })` in a UI check script measures the screen as "
            "it is against that state of the design package with the auto test's comparer, at %dx%d, with the auto "
            "test's thresholds (%s); package(s): %s; the project's profile, which reads each screen's data and takes the "
            "second argument: %s. A heavy difference (BAD) does not fail the gate: the UI reviewer decides each one" % (
                info["viewport"][0], info["viewport"][1],
                ("%s, share from %spx" % (th["ui_threshold"], th["ui_percent_from"])) if th else
                "not chosen yet in the auto test repository, so nothing is judged",
                "; ".join("%s (%d states, state table %s)" % (p["version"], len(p["codes"]), p["index"])
                          for p in info["packages"]),
                ", ".join(info["profile"]) or "none, so only screens that show no data can be compared"))


def design_measured(reports):
    """The screens these UI reports (ui-report.json) measured against the design: code -> worst level."""
    rank = {"OK": 0, "MINOR": 1, "BAD": 2}
    out = {}
    for p in reports:
        try:
            with open(p, encoding="utf-8") as f:
                rep_ = json.load(f)
        except (OSError, ValueError):
            continue
        for d in rep_.get("design") or []:
            lv, code = d.get("level"), str(d.get("code") or "")
            if lv in rank and code and (code not in out or rank[lv] > rank[out[code]]):
                out[code] = lv
    return out


def design_table_problems(md, measured):
    """What a reviewer's `## Design` table leaves unanswered: a measured screen it leaves out, a decision that is not
    one of DESIGN_DECISIONS, ok for a heavy difference. Returns (problems, whether it says the code is wrong)."""
    if not measured:
        return [], False
    rows = review_table_rows(section(md, "Design"))
    if not rows:
        return ["has no `## Design` table with one row per screen measured against the design (%s)"
                % ", ".join(sorted(measured))], False
    problems, code = [], False
    for screen, level in sorted(measured.items()):
        mine = [r for r in rows if r and re.search(r"(?<![\w-])%s(?![\w-])" % re.escape(screen), r[0])]
        if not mine:
            problems.append("leaves %s (measured %s) out of its `## Design` table" % (screen, level))
            continue
        said = mine[-1][-1].strip("* `").lower()
        decided = next((v for v in DESIGN_DECISIONS if said.startswith(v)), None)
        if decided is None:
            problems.append("`## Design`: the decision on %s is one of %s" % (screen, ", ".join(DESIGN_DECISIONS)))
        elif decided == "ok" and level == "BAD":
            problems.append("`## Design` calls %s ok, but it is measured BAD: the code is wrong (code), the package "
                            "draws it so (design), or the two images show different data (different data)" % screen)
        elif decided == "code":
            code = True
    return problems, code


def job_design_unpack(ctx, job):
    """The design packages a job's ticket attaches (.zip, downloaded with the issue), unpacked as data into design/ of
    its folder, each with the state table the auto test makes. An archive already unpacked is not unpacked again."""
    jd = ctx.job_dir(job["id"])
    adir = os.path.join(jd, "attachments")
    zips = sorted(f for f in (os.listdir(adir) if os.path.isdir(adir) else []) if f.lower().endswith(".zip"))
    if not zips:
        return job
    top = os.path.join(jd, "design")
    before = json.dumps(job.get("design"), sort_keys=True)
    seen = dict((job.get("design") or {}).get("sha") or {})
    earlier = (job.get("design") or {}).get("problems") or []
    files, problems = [], []
    for z in zips:
        src, dest = os.path.join(adir, z), os.path.join(top, re.sub(r"[^\w.-]+", "_", os.path.splitext(z)[0]))
        digest = file_sha256(src)
        if seen.get(z) == digest and os.path.isdir(dest):
            problems += [p for p in earlier if p.startswith(z + ": ")]
        else:
            shutil.rmtree(dest, ignore_errors=True)
            try:
                safe_unzip(src, dest)
            except FxError as e:
                shutil.rmtree(dest, ignore_errors=True)
                seen.pop(z, None)
                problems.append("%s: %s" % (z, e))
                continue
            for pkg in design_packages(dest):
                problems += ["%s: %s" % (z, p) for p in design_index(pkg)[1][:5]]
            seen[z] = digest
        files.append(z)
    job["design"] = {"dir": top, "files": files, "sha": {z: seen[z] for z in files}, "problems": problems}
    if json.dumps(job["design"], sort_keys=True) != before:
        ctx.save(job, "design package: %s" % (", ".join(files) or "none could be unpacked"))
    return job


