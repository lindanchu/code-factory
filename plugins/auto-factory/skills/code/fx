def group_gone(pgid):
    """No process of this group is left running. One that died and only waits for its parent to notice it (a zombie)
    does not count: in a container without an init nobody ever does, and waiting for it is waiting for nothing."""
    try:
        os.killpg(pgid, 0)
    except OSError:
        return True
    if not os.path.isdir("/proc/self"):
        return False  # macOS, BSD: the system takes such processes away at once
    try:
        names = [n for n in os.listdir("/proc") if n.isdigit()]
    except OSError:
        return False
    for name in names:
        try:
            with open("/proc/%s/stat" % name) as f:
                fields = f.read().rsplit(")", 1)[1].split()  # state, parent, process group, ...
        except (OSError, IndexError):
            continue
        if len(fields) > 2 and fields[2] == str(pgid) and fields[0] not in ("Z", "X"):
            return False
    return True


def kill_group(proc, grace=10):
    """Stop a command and everything it started: asked first, so that a `docker compose run` can stop its container."""
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 3)):
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            break
        end = time.time() + wait
        while time.time() < end and not (proc.poll() is not None and group_gone(proc.pid)):
            time.sleep(0.1)
        if proc.poll() is not None and group_gone(proc.pid):
            break


_BUSY_NOW = []  # the busy files this fx holds, innermost last: where it notes the process groups it starts for a job
_BUSY_NOTE = threading.Lock()


def busy_groups(change):
    """Note in the busy file of the job this fx works on which process groups it started for it, so that whoever takes
    the job next can stop what a killed fx left running there (groups_stop). change: gets the list, and edits it."""
    if not _BUSY_NOW:
        return
    with _BUSY_NOTE:
        f = _BUSY_NOW[-1]
        try:
            f.seek(0)
            who = json.loads(f.read() or "{}")
            who = who if isinstance(who, dict) else {}
            change(who.setdefault("groups", []))
            f.seek(0)
            f.truncate()
            f.write(json.dumps(who))
            f.flush()
        except (OSError, ValueError):
            pass


def groups_stop(groups, grace=5):
    """Stop the process groups a step left running when its fx was killed outright (no memory left, kill -9): the checks
    of that gate would go on in the clone beside the next gate's. A group is taken for the one noted only while its
    first process is still the same one, or is gone with others of the group still there; a number another program got
    since is left alone. Returns the groups it stopped."""
    if not hasattr(os, "killpg"):
        return []
    left = []
    for g in groups if isinstance(groups, list) else []:
        pgid = g.get("pgid") if isinstance(g, dict) else None
        if not isinstance(pgid, int) or isinstance(pgid, bool) or pgid <= 1 or pgid == os.getpgrp() or group_gone(pgid):
            continue
        first = proc_starts([pgid]).get(pgid)
        if first is not None and first != g.get("start"):
            continue
        left.append(pgid)
    stopped = list(left)
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 2)):
        left = [p for p in left if not group_gone(p)]
        if not left:
            break
        for p in left:
            try:
                os.killpg(p, sig)
            except OSError:
                pass
        end = time.time() + wait
        while time.time() < end and any(not group_gone(p) for p in left):
            time.sleep(0.1)
    return stopped


def run_in_group(cmd, cwd=None, env=None, timeout=None, on_start=None):
    """A project command with everything it starts in one process group. When it is stopped (its time is up, or fx
    itself is told to stop: a closed session, a tool's time limit), nothing of it keeps running beside the next job.
    on_start: told the process once it runs (its pid is the group's), for whoever watches it (StopsWatch)."""
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            errors="surrogateescape", start_new_session=True)
    if on_start:
        on_start(proc)
    if _BUSY_NOW:
        mark = {"pgid": proc.pid, "start": proc_starts([proc.pid]).get(proc.pid)}
        busy_groups(lambda groups: groups.append(mark))
    try:
        text, _ = proc.communicate(timeout=timeout)
    except BaseException as e:
        kill_group(proc)
        if isinstance(e, subprocess.TimeoutExpired):
            try:
                text, _ = proc.communicate(timeout=5)
            except (subprocess.TimeoutExpired, OSError, ValueError):
                text = e.output if isinstance(e.output, str) else ""
            raise subprocess.TimeoutExpired(cmd, timeout, output=text)
        raise
    finally:
        # Ended, or stopped by this fx: either way not left by a killed one. What a command leaves running on purpose
        # (a helper its set-up started in the background) is the project's own business, as it was before.
        if _BUSY_NOW:
            busy_groups(lambda groups: groups.__setitem__(slice(None), [g for g in groups if g.get("pgid") != proc.pid]))
    return subprocess.CompletedProcess(cmd, proc.returncode, text, None)


def run(cmd, cwd=None, check=True, capture=True, env=None, timeout=None, input_text=None, group=False, on_start=None):
    """group: a project's own command (setup, checks.sh, e2e): see run_in_group."""
    if group and capture and input_text is None and hasattr(os, "killpg"):
        p = run_in_group(cmd, cwd=cwd, env=env, timeout=timeout, on_start=on_start)
        if check and p.returncode != 0:
            raise FxError("command failed (%d): %s\n%s" % (p.returncode, " ".join(cmd), (p.stdout or "").strip()[-2000:]))
        return p
    p = subprocess.run(
        cmd, cwd=cwd, env=env, timeout=timeout, input=input_text,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
        text=True, errors="surrogateescape",  # git prints names and diffs in whatever bytes they have
    )
    if check and p.returncode != 0:
        raise FxError("command failed (%d): %s\n%s" % (
            p.returncode, " ".join(cmd), (p.stdout or "").strip()[-2000:]))
    return p


