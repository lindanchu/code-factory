# a project of several repositories (code-factory 2.0's model, on this fx)

def agent_port(ctx, job, off):
    """An agent's own dev server port (builder 0, ux 1, ui 2), after the apps' ports: never one an app runs on."""
    return job_block(ctx, job) + app_ports(ctx) + off


def app_file(job, name):
    """app.json, app.log: in a job of several repositories, app-<repo>.json and app-<repo>.log."""
    if several_repos(job):
        base, ext = os.path.splitext(name)
        return "%s-%s%s" % (base, job["repo"], ext)
    return name


def app_needs(ctx, name):
    return [d for d in (ctx.rc(name, "app.needs", []) or []) if d in ctx.repo_names() and d != name]


def app_of(job):
    """How messages name an app: "the app", or "the app of <repo>" in a job of several repositories."""
    return "the app of %s" % job["repo"] if several_repos(job) else "the app"


def app_ports(ctx):
    """How many ports of a job's block are kept for its apps: one per repository of the project."""
    return max(1, len(ctx.repos))


def app_start_one(ctx, job):
    """Start one repository's app on its port, in its clone, or reuse it when fx started it and it answers."""
    up = ctx.c("app.up")
    if not up:
        raise FxError("no app.up command in factory.json%s; set it with /auto-factory:code init" % (
            " for %s" % job["repo"] if several_repos(job) else ""), code=3)
    if not os.path.isdir(job.get("worktree") or ""):
        raise FxError("the worktree %s is missing" % (job.get("worktree") or "of the job (none yet)"), code=3)
    url = app_url(ctx, job)
    try:
        st = json.loads(read(app_state_path(ctx, job), "{}") or "{}")
    except ValueError:
        st = {}
    if (st.get("detached") or (st.get("pid") and pid_alive(st["pid"]))) and http_up(url):
        return {"url": app_url(ctx, job, "/"), "health": url, "reused": True, "log": st.get("log")}
    with socket.socket() as probe:  # else that is what answers below, and every check of the running app reads it
        probe.settimeout(2)
        if probe.connect_ex(("127.0.0.1", int(job["port"]))) == 0:
            raise FxError("port %s already answers, and fx did not start that, so the checks would look at it instead of "
                          "this job's app. Stop it (lsof -nP -iTCP:%s -sTCP:LISTEN) and run this again"
                          % (job["port"], job["port"]), code=3, extra={"port_taken": True})
    env, db = app_env(ctx, job)
    os.makedirs(app_home(ctx, job), exist_ok=True)
    log = os.path.join(app_home(ctx, job), app_file(job, "app.log"))
    fh = open(log, "ab")
    fh.write(("\n==== %s starting: %s\n" % (now(), app_fill(up, job, db))).encode())
    fh.flush()
    p = subprocess.Popen(["bash", "-lc", app_fill(up, job, db)], cwd=job["worktree"], env=env,
                         stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    write_atomic(app_state_path(ctx, job), json.dumps({"pid": p.pid, "started": now(), "log": log, "db": db}))
    limit = int(ctx.c("app.start_timeout_sec", 180))
    t0 = time.time()
    while time.time() - t0 < limit:
        if http_up(url):
            if p.poll() == 0:  # app.up may exit after starting containers: the app is still the one fx started
                write_atomic(app_state_path(ctx, job), json.dumps({"pid": p.pid, "detached": True, "started": now(), "log": log, "db": db}))
            return {"url": app_url(ctx, job, "/"), "health": url, "reused": False, "log": log, "db": db}
        rc = p.poll()
        if rc not in (None, 0):
            break
        time.sleep(1)
    tail = "\n".join((read(log, "") or "").splitlines()[-30:])
    app_stop_one(ctx, job)
    raise FxError("%s did not come up at %s within %ss; last lines of %s:\n%s" % (app_of(job), url, limit, log, tail),
                  code=3, extra={"log": log})


def app_status(ctx, job):
    """Each app of the job: running (fx started it), its URL and whether it answers."""
    names = [n for n in job_apps(ctx, job) if n in job["repos"]] if is_whole_job(job) else [None]
    rows = {}
    for n in names or [None]:
        rctx, v = one_app(ctx, job, n)
        try:
            st = json.loads(read(app_state_path(rctx, v), "{}") or "{}")
        except ValueError:
            st = {}
        rows[v.get("repo")] = {"running": bool(st.get("pid") and pid_alive(st["pid"])), "url": app_url(rctx, v, "/"),
                               "healthy": http_up(app_url(rctx, v))}
    return rows


def app_stop_one(ctx, job):
    """Stop one repository's app: the configured down command, then the process group we started."""
    st = {}
    try:
        st = json.loads(read(app_state_path(ctx, job), "{}") or "{}")
    except ValueError:
        pass
    env, db = app_env(ctx, job, make=False)  # stopping needs no lane's copy: none is made only to be deleted
    down = ctx.c("app.down")
    if down and os.path.isdir(job.get("worktree") or ""):
        try:
            run(["bash", "-lc", app_fill(down, job, db)], cwd=job["worktree"], check=False, env=env, timeout=180)
        except subprocess.TimeoutExpired:
            pass
    pid = st.get("pid")
    if pid and pid_alive(pid):
        for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
            try:
                os.killpg(int(pid), sig)
            except OSError:
                break
            t0 = time.time()
            while time.time() - t0 < wait and pid_alive(pid):
                time.sleep(0.2)
            if not pid_alive(pid):
                break
    if os.path.exists(app_state_path(ctx, job)):
        os.remove(app_state_path(ctx, job))
    return {"stopped": True}


def apps_before(job):
    """The apps of the job started before this repository's: {name: URL}."""
    apps, name = job.get("apps") or [], job.get("repo")
    before = apps[:apps.index(name)] if name in apps else [n for n in apps if n != name]
    return {n: job["urls"][n] for n in before if n in (job.get("urls") or {})}


def apps_up(ctx, job):
    """Start the job's apps (job_apps) in order, each in its clone or run-only checkout, on its port with its database and
    the URLs of those started before it; {name: what app_start_one says}. When one cannot start, the ones started are
    stopped and the error names it."""
    if not is_whole_job(job):
        rctx, v = one_app(ctx, job)
        return {v.get("repo"): app_start_one(rctx, v)}
    apps = job_apps(ctx, job)
    if not apps:
        rctx, v = one_app(ctx, job)
        return {v.get("repo"): app_start_one(rctx, v)}  # says what is missing
    started = {}
    for n in apps:
        try:
            if n not in job["repos"]:
                raise FxError("the job has no clone of %s, whose app the others need: `%s repos %s --add %s`" % (
                    n, FX_CMD, job["id"], n), code=3)
            started[n] = app_start_one(repo_ctx(ctx, n), repo_view(ctx, job, n))
        except FxError:
            for m in reversed(list(started)):
                app_stop_one(repo_ctx(ctx, m), repo_view(ctx, job, m))
            raise
    return started


def base_checkout(ctx, dest, name, branch, full=False):
    """A clone of a repository checked out (detached) at its branch: what selftest and audit-scan look at."""
    clone_project(ctx, dest, full=full, repo=name)
    base_ref = "%s/%s" % (REMOTE, branch)
    if git(["rev-parse", "--verify", "-q", base_ref], dest, check=False).returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        raise FxError("the project%s has no %s%s" % (" " + name if len(ctx.repos) > 1 else "", base_ref,
                                                      "" if full else " yet"), code=3)
    git(["checkout", "-q", "--detach", base_ref], dest)
    return base_ref


def base_for(ctx, bases, name):
    return bases.get(name) or bases.get("*") or ctx.rc(name, "base_branch", "main")


def baseline_json(ctx):
    """baseline.json as fx selftest wrote it, or {}."""
    try:
        b = json.loads(read(os.path.join(ctx.factory, "baseline.json"), "{}") or "{}")
    except ValueError:
        return {}
    return b if isinstance(b, dict) else {}


def baseline_of(ctx, b=None):
    """The part of baseline.json for ctx's repository (a RepoCtx's, else the first): {"repos": {"<name>": {...}}}. An
    older one, without repos, is the base branch's of the factory's one repository (its first)."""
    b = baseline_json(ctx) if b is None else b
    first = ctx.repo_names()[0] if ctx.repos else None
    name = ctx.scope or first
    if isinstance(b.get("repos"), dict):
        got = b["repos"].get(name)
        return got if isinstance(got, dict) else {}
    return b if name == first else {}


def baselines_job(ctx, cfg, job):
    """The job as the repository that holds the list sees it (repo_view): its first changed one when the list is in the
    factory repository. None when the job does not change that repository."""
    if job is None or not is_whole_job(job):
        return job
    name = cfg.get("repo_name") if cfg["repo"] == "project" else job_primary(job)
    if name not in job_names(job, "change") and len(ctx.repos) <= 1:
        name = job_primary(job)  # the only repository, whatever a job read without the factory's names calls it
    if not name or name not in job_names(job, "change"):
        return None
    return repo_view(ctx, job, name)


def candidate_block(ctx, job, k):
    """Best-of-N candidate k's own block for its apps (one port per repository), after the agents' three ports."""
    return job_block(ctx, job) + app_ports(ctx) + 3 + (int(k) - 1) * app_ports(ctx)


def candidates_room(ctx):
    """How many best-of-N candidates a job's block of ports has room for, after its apps and the agents' three."""
    return max(0, (ports_step(ctx) - app_ports(ctx) - 3) // app_ports(ctx))


def cited_in(token, repo, several):
    """The path of repo a logic citation names: repo:path, or a plain path in a project of one repository."""
    name, sep, rest = token.partition(":")
    if sep and REPO_RE.match(name):
        return rest if name == repo else None
    return None if several else token


def cited_root(ctx, code, token):
    """(the code root, the path in it, a problem or None) a cited token names. code is {repo: folder} (code_roots): a
    repo:path token is that repository's path (one of the project's repositories the code does not hold is read from
    its base branch); a plain path is the only repository's, and wrong in a project of several, which must say which
    one. root None: not a citation of the code after all."""
    names = ctx.repo_names()
    name, sep, rest = token.partition(":")
    if sep and rest and REPO_RE.match(name):
        if name in code or name in names:
            root = code.get(name) or (ctx.code(name) if name in names else None)
            if not root:
                return None, rest, "%s has no code to check against" % name
            return root, rest, None
        if len(names) > 1 and PATH_EXT_RE.search(rest):
            return None, rest, "%s is not one of the repositories (%s)" % (name, ", ".join(names))
    if len(names) > 1:
        found = [n for n in names if code.get(n) and os.path.exists(os.path.join(code[n], token.lstrip("./")))]
        if not PATH_EXT_RE.search(token) and not any(
                os.path.exists(os.path.join(code[n], token.lstrip("./").split("/")[0])) for n in code if code.get(n)):
            return None, token, None  # `a.b/c`-style text that is not a folder of any repository
        return None, token, "write it as <repo>:%s: this project has several repositories (%s)%s" % (
            token, ", ".join(names), "; found in %s" % ", ".join(found) if found else "")
    return next((v for v in code.values() if v), ""), token, None


def cmd_repos(ctx, a):
    """Clone the repositories intake named (REPOS:), or more, on the bases the user picked: each changed one on the job's
    branch, each one only needed to run the apps detached at its base. Then the spec."""
    job = ctx.load(a.job)
    if job["stage"] in TERMINAL:
        raise FxError("job %s is %s" % (job["id"], job["stage"]), code=3)
    if ctx.repo_problems:
        raise FxError("factory.json lists its repositories wrongly: %s" % "; ".join(ctx.repo_problems), code=3)
    if getattr(a, "drop", None):
        if a.base or getattr(a, "add", None):
            raise FxError("--drop goes alone: drop a repository, then add others in a second fx repos", code=3)
        repos_drop(ctx, job, a.drop)
        return
    pending = job.get("repos_pending") if isinstance(job.get("repos_pending"), list) else []
    bases = parse_bases(ctx, a.base)
    named = [n for n in bases if n != "*"]
    for n in getattr(a, "add", None) or []:
        ctx.repo_entry(n)
        named.append(n)
    have = job_names(job, "change")
    todo = [n for n in ctx.repo_names() if (n in pending or n in named) and n not in have]
    if not todo:
        if job.get("repos_pending") is True:
            raise FxError("intake has not named this job's repositories yet: fx result %s intake first" % job["id"],
                          code=3)
        raise FxError("nothing to clone: %s already has %s" % (job["id"], ", ".join(have) or "no repository"), code=3)
    proposed = job.get("repos_bases") or {}
    use = {n: bases.get(n) or bases.get("*") or proposed.get(n) for n in todo}
    explicit = {n: b for n, b in use.items() if b}
    before = set(job_names(job))
    job_add_repos(ctx, job, todo, explicit)
    added = [n for n in job_names(job) if n not in before]
    if baselines_config(ctx):
        job_baselines_start(ctx, job, [n for n in added if job["repos"][n]["role"] == "change"])
    job.pop("repos_pending", None)
    job.pop("repos_bases", None)
    if job.get("risk"):  # intake has routed the job: two or more changed repositories bring the fit checker
        route(ctx, job)
    ctx.save(job, "repositories cloned: %s" % ", ".join(added))
    nxt = "spec" if job["stage"] == "spec" else job["stage"]
    out({"ok": True, "job": job["id"], "cloned": added, "repos": job_repo_rows(ctx, job),
         "branch": job_branch_name(job), "next": nxt})


def code_lines(ctx, codes):
    """Prompt lines naming each repository's code (read only), and how to cite it."""
    if len(codes) == 1:
        return ["Code (read only): %s" % next(iter(codes.values()))]
    return ["Code (read only), one folder per repository: %s" % "; ".join("%s: %s" % kv for kv in codes.items()),
            "Cite code as <repo>:<path> or <repo>:<path>:<from>-<to> (this project has several repositories; a plain "
            "path fails the check)"]


def code_repo(ctx, repo):
    """The repository a command without --repo means: the only one; with several, it must be named."""
    if repo is None and len(ctx.repos) > 1:
        raise FxError("this project has several repositories: name one with --repo (%s)" % ", ".join(ctx.repo_names()),
                      code=3)
    return ctx.repo_name(repo)


def code_roots(ctx, code):
    """{repo: folder} for check_docs: code as given ({repo: folder}), or one folder ("" when the project has no
    repository's name to give it)."""
    if isinstance(code, dict):
        return dict(code)
    return {(ctx.repo_names()[0] if len(ctx.repos) == 1 else ""): code}


CTX_APP_AGENTS = ("builder", "ux", "ui", "code", "security", "verifier", "approver")


def ctx_repo_lines(ctx, job, agent, cand, wp):
    """The repos block of a prompt for a job of several repositories: each one's role, clone, branch, base, checks script
    and app URL. A best-of-N candidate sees its own clones, a package builder its package's."""
    apps = job_apps(ctx, job) if ctx.repos else []
    per = job_candidates(job).get(cand["k"]) if cand else None
    names = job_names(job, "change")
    look = agent not in ("builder",)
    lines = ["Repositories of this job, in merge order (%s; every changed one is on the same branch and gets its own "
             "pull request):" % ("read them, never change them" if look else
                                 "change only the ones whose role is change")]
    for n in job_order(job):
        e = job["repos"][n]
        wt, br = e.get("worktree"), e.get("branch")
        if per and n in per:
            wt, br = per[n]["worktree"], per[n]["branch"]
        mine = bool(wp and wp.get("repo") == n)
        if mine:
            wt, br = wp["clone"], wp["branch"]
        if e.get("role", "change") == "change":
            parts = ["%s: change%s" % (n, " (your package's repository and its own clone)" if mine else
                                       " (another package's: do not change it)" if wp else ""),
                     "worktree %s" % (wt or "-"), "branch %s" % (br or "-"), "base %s" % (e.get("base_ref") or "-"),
                     "checks script %s" % checks_script(ctx, job, n)]
        elif e.get("merged") and not wt:
            lines.append("- %s: merged (its pull request %s is merged into %s; this job no longer changes it, and has "
                         "no clone of it)" % (n, e.get("pr_url") or e.get("branch") or "-",
                                             e.get("target_branch") or e.get("base_branch") or "-"))
            continue
        else:
            parts = ["%s: run (a checkout of its base only to run its app; never change it)%s" % (
                         n, "; its pull request %s is merged" % (e.get("pr_url") or e.get("branch") or "")
                         if e.get("merged") else ""),
                     "worktree %s" % (wt or "-"), "base %s" % (e.get("base_branch") or "-")]
        if n in apps:
            port = (per[n].get("port") if per and n in per else None) or (
                candidate_block(ctx, job, cand["k"]) + job_order(job).index(n) if cand else job_port(ctx, job, n))
            parts.append("app http://127.0.0.1:%d" % port)
        elif n in names and ctx.rc(n, "dev_server") and agent in ("builder", "ux", "ui"):
            parts.append("dev server `%s` (run it in its worktree on your port)" % ctx.rc(n, "dev_server"))
        lines.append("- " + "; ".join(parts))
    return lines


def doctor_repos(ctx, add):
    """fx doctor's rows for each repository: the list itself, reachable, its base branch, its checks script, its pull
    request provider and that provider's login. Returns the first repository's (heads, base branch, provider) and the
    names of those whose base branch was found."""
    several = len(ctx.repos) > 1
    for why in ctx.repo_problems:
        add("repositories listed right in factory.json", False, why)
    if not ctx.repos:
        add("project reachable", False, "no repository: run /auto-factory:code init --repo <name>=<git URL>")
        return {}, ctx.c("base_branch", "main"), "unknown", []
    first, logins, found = None, {}, []
    for r in ctx.repos:
        n, url = r["name"], r.get("url") or ""
        what = "repository %s" % n if several else "project"
        base = ctx.rc(n, "base_branch", "main")
        try:
            heads, _ = remote_heads(url) if url else ({}, None)
            add("%s reachable" % what, bool(url), url or "no url: give it one in factory.json (repos)")
            add("%s base branch %s" % (what, base), base in heads, "" if base in heads else
                "missing: empty repository? /auto-factory:code init can make the first commit")
            if base in heads:
                found.append(n)
        except FxError as e:
            add("%s reachable" % what, False, str(e))
            heads = {}
        script = checks_script(ctx, repo=n)
        rel = os.path.relpath(script, ctx.factory)
        body = read(script)
        add("%s filled in" % rel, body and "FACTORY_TODO" not in body,
            "replace the FACTORY_TODO placeholder with your real checks" if "FACTORY_TODO" in (body or "") else
            "missing: write %s, the checks run in %s's clone" % (rel, n) if body is None and not ctx.old_form else "")
        prov = ctx.rc(n, "pr.provider") or guess_provider(url)
        cli = {"github": "gh", "gitlab": "glab"}.get(prov)
        login = None
        if cli:
            host = gitlab_project(url)[0] if prov == "gitlab" else None
            if (cli, host) not in logins:
                logins[(cli, host)] = bool(shutil.which(cli)) and run(
                    [cli, "auth", "status"] + (["--hostname", host] if host else []), check=False,
                    timeout=30).returncode == 0
            login = logins[(cli, host)]
        of = " (%s)" % n if several else ""
        if ctx.c("pr.create", True) is False:
            add("pull requests%s" % of, True, "off (pr.create): branches are pushed, a human opens the pull request")
            if cli:
                add("%s installed and logged in%s (advice: learning reads review comments with it)" % (cli, of), True,
                    "yes" if login else "no: run /auto-factory:code install for the command, or learning skips review "
                    "comments")
        elif cli:
            add("%s installed and logged in%s" % (cli, of), login,
                "" if login else "run /auto-factory:code install for the command")
        else:
            add("PR provider%s" % of, True, "%s: PRs are opened by hand from a link" % prov)
        if first is None:
            first = (heads, base, prov)
    if ctx.repos:
        add("ports.step holds every app and the agents", ports_step(ctx) >= app_ports(ctx) + 3,
            "%d ports a job" % ports_step(ctx) if ports_step(ctx) >= app_ports(ctx) + 3 else
            "ports.step %d is too small: a job's apps (%d) and the agents' 3 need at least %d (best-of-N needs %d): "
            "raise ports.step in %s" % (ports_step(ctx), app_ports(ctx), app_ports(ctx) + 3, ports_needed(ctx),
                                       CONFIG_NAME))
    if several:
        room = candidates_room(ctx)
        add("ports.step leaves room for best-of-N (advice)", True,
            "%d ports a job: %d apps, the agents' 3, best-of-N candidates for %d" % (ports_step(ctx), app_ports(ctx), room)
            if room >= 2 else "ports.step %s is too small for best-of-N: at least %d" % (
                ctx.c("ports.step"), app_ports(ctx) + 3 + 2 * app_ports(ctx)))
    return first + (found,)


def factory_move(ctx, src_rel, dst_rel):
    """Move a file of the factory repository: git mv when git tracks it (the rename is staged), else a plain move."""
    src, dst = os.path.join(ctx.factory, src_rel), os.path.join(ctx.factory, dst_rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if factory_tracked(ctx, src_rel) and git(["mv", "--", src_rel, dst_rel], ctx.factory, check=False).returncode == 0:
        return "git mv %s %s" % (src_rel, dst_rel)
    os.rename(src, dst)
    return "moved %s to %s" % (src_rel, dst_rel)


def factory_tracked(ctx, rel):
    return git(["ls-files", "--error-unmatch", "--", rel], ctx.factory, check=False).returncode == 0


def finding_places(line, repos, roots=None):
    """The files a finding names, as (repository, path): repo:path names its repository, and so does a line that starts
    with one ("[gate] be: ..."). A plain path in a job of one repository is that one's (None: any package). In a job of
    several, it is the repository whose clone (roots: {repo: folder}) has that file, when exactly one has it; else ""
    (no package's: the integrator's)."""
    lead = re.match(r"^\s*(?:\[[\w-]+\]\s*)?(?:-\s*)?(?:\d+\.\s*)?(?:\[blocking\]\s*)?\**([a-z][a-z0-9-]{0,30}):\s", line)
    default = lead.group(1) if lead and lead.group(1) in repos else None
    found = []
    for m in FINDING_PLACE_RE.finditer(line):
        repo, path = m.group(1), m.group(2)
        if path.startswith("round-"):
            continue
        if repo in repos:
            found.append((repo, path))
        elif default or len(repos) <= 1:
            found.append((default, path))
        else:
            have = [n for n in repos if os.path.isfile(os.path.join((roots or {}).get(n) or "", path.lstrip("./")))
                    and (roots or {}).get(n)]
            found.append((have[0] if len(have) == 1 else "", path))
    return found


def git_job(args, cwd, check=True):
    """git in a job's clone without its hooks: an agent writes that clone, .git/hooks and its config included, and fx's
    own merges, commits and pushes run nothing of theirs."""
    return git(NO_HOOKS + list(args), cwd, check)


def git_url(ctx, repo):
    """A repository's URL from factory.json as git takes it (a local folder expanded): what fx fetches from and pushes
    to, never a clone's own origin, which the agents could point anywhere."""
    u = ctx.url(repo)
    return os.path.expanduser(u) if os.path.isdir(os.path.expanduser(u)) else u


def guess_provider(url):
    return "github" if "github.com" in url else "gitlab" if "gitlab" in url else "bitbucket" if "bitbucket.org" in url \
        else "unknown"


def host_repo_flag(provider, url):
    """gh --repo [HOST/]OWNER/NAME or glab -R GROUP/NAME (a full URL on another host than gitlab.com), from a
    repository's URL in factory.json: gh and glab never guess the repository from the clone's own remote, which the
    agents could point elsewhere. [] when the URL names no host (a local folder)."""
    u = (url or "").strip()
    if not u or os.path.isdir(os.path.expanduser(u)) or u.startswith("file:"):
        return []
    host, path = gitlab_project(u)
    if not host or not path or "/" not in path:
        return []
    if provider == "github":
        return ["--repo", path if host == "github.com" else "%s/%s" % (host, path)]
    if provider == "gitlab":
        return ["-R", path if host == "gitlab.com" else "https://%s/%s" % (host, path)]
    return []


def init_convert(ctx, cfg, entry, notes, moved):
    """An old factory.json (or an import) into the repository's entry: its per-repository settings (CONVERT_KEYS), its
    checks.sh and its flat knowledge files (FLAT_REPO_KNOWLEDGE) become that repository's."""
    name = entry["name"]
    found, base = dotted_pop(cfg, "base_branch")  # an import's
    if found and base:
        entry["base_branch"] = base
    for key in CONVERT_KEYS:  # over the blanks init gives a new entry
        found, v = dotted_pop(cfg, key)
        have = dotted_get(entry, key, _MISSING)
        if found and (have is _MISSING or have in ("", [], None)):
            dotted_set(entry, key, v)
        elif found and isinstance(have, dict) and isinstance(v, dict):
            dotted_set(entry, key, merge_settings(have, v))
    acc = dotted_get(entry, "app.accounts_file")
    if isinstance(acc, str) and re.sub(r"^factory/", "", acc) == "knowledge/environment.md":
        entry["app"]["accounts_file"] = "knowledge/%s/environment.md" % name
    dst = os.path.join("checks", "%s.sh" % name)
    if os.path.isfile(os.path.join(ctx.factory, "checks.sh")):
        if os.path.exists(os.path.join(ctx.factory, dst)):
            notes.append("checks.sh was left where it is: %s exists already; merge them by hand and delete checks.sh"
                         % dst)
        else:
            moved.append(factory_move(ctx, "checks.sh", dst))
    kd = knowledge_dir(ctx)
    for fname in FLAT_REPO_KNOWLEDGE:
        src_rel = os.path.join("knowledge", fname)
        if not os.path.isfile(os.path.join(ctx.factory, src_rel)):
            continue
        dst_rel = os.path.join("knowledge", name, fname)
        if os.path.exists(os.path.join(ctx.factory, dst_rel)):
            notes.append("%s was left where it is: %s exists already" % (src_rel, dst_rel))
            continue
        moved.append(factory_move(ctx, src_rel, dst_rel))
    if any(m.split()[-1].startswith("knowledge/") for m in moved) and os.path.isfile(os.path.join(kd, "README.md")):
        notes.append("the knowledge files of %s moved into knowledge/%s/: update the index knowledge/README.md where "
                     "it names them" % (name, name))


def init_initial_commit(ctx, name, base):
    """An empty first commit on base in a repository with no commits yet (asked of the user first)."""
    tmp = os.path.join(ctx.work, "_init-%s" % name)
    clone_project(ctx, tmp, repo=name)
    try:
        git(["checkout", "-q", "-b", base], tmp, check=False)
        git(["commit", "-q", "--allow-empty", "-m", "Initial commit"], tmp)
        git(["push", "-q", REMOTE, "HEAD:refs/heads/%s" % base], tmp)
        return {"branch": base, "commit": git(["rev-parse", "--short", "HEAD"], tmp).stdout.strip(),
                "note": "an empty commit: no files were added to the project"}
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def init_wanted(ctx, a):
    """[(name, url as given, from --project)] from --repo name=url (repeatable) and --project url (the project's one
    repository, named after --project-name or the URL)."""
    wanted = []
    for spec in getattr(a, "repo_specs", None) or []:
        name, sep, url = (spec or "").partition("=")
        name, url = name.strip(), url.strip()
        if not sep or not url:
            raise FxError("--repo %s: write it as --repo <name>=<git URL or local folder>" % spec, code=3)
        why = repo_name_problem(name)
        if why:
            raise FxError("--repo %s: %s" % (spec, why), code=3)
        wanted.append((name, url, False))
    if getattr(a, "project", None) and a.project.strip():
        url = a.project.strip()
        name = repo_slug(a.project_name) if getattr(a, "project_name", None) else url_repo_name(url)
        wanted.append((name, url, True))
    seen = set()
    for name, url, _ in wanted:
        if url.startswith("-"):
            raise FxError("%s: %r is not a git URL or a folder" % (name, url), code=3)
        if name in seen:
            raise FxError("two repositories are named %s: each needs its own name" % name, code=3)
        seen.add(name)
    return wanted


def intake_repos(ctx, job, text, verdict):
    """The repositories intake says the issue needs, checked against factory.json. A job whose repositories wait for
    intake cannot go on without them; one cloned at fx new may name more (they are cloned next)."""
    names = parse_intake_repos(text)
    known = ctx.repo_names()
    if names is None:
        if job.get("repos_pending") is True and verdict == "ACCEPT":
            raise FxError("intake.md has no REPOS: line, and this project has several repositories (%s): intake must "
                          "name the ones the issue needs" % ", ".join(known), code=6, extra={"retry_agent": "intake"})
        return []
    unknown = [n for n in names if n not in known]
    if unknown:
        raise FxError("intake.md names %s on its REPOS: line, which %s not one of this project's repositories (%s)" % (
            ", ".join(unknown), "is" if len(unknown) == 1 else "are", ", ".join(known)), code=6,
            extra={"retry_agent": "intake"})
    if not names and job.get("repos_pending") is True and verdict == "ACCEPT":
        raise FxError("intake.md's REPOS: line names no repository (%s)" % ", ".join(known), code=6,
                      extra={"retry_agent": "intake"})
    return [n for n in known if n in names]


def is_checks_script(name):
    """checks.sh or a file of checks/: compared byte for byte (a carriage return changes what a script does)."""
    return name == "checks.sh" or name.startswith(CHECKS_DIR + "/")


def is_whole_job(job):
    """A job as job.json holds it (repos{}), not one repository's view of it (repo_view) or a job of fx's own."""
    return isinstance(job.get("repos"), dict) and not job.get("repo")


def job_add_repos(ctx, job, change, bases):
    """Clone every repository in change on the job's branch, from its base, then every repository their apps need that
    the job does not change, at its base (role run). Returns what it cloned; on failure removes it and raises."""
    made, kept = [], {}
    branch = job_branch_name(job)
    repos = job.setdefault("repos", {})
    try:
        for name in [n for n in ctx.repo_names() if n in change]:
            base = base_for(ctx, bases, name)
            if name in bases or "*" in bases:
                check_branch(ctx, base, "source", repo=name)
            old = repos.get(name) or {}
            if old.get("role") == "change":
                continue
            wt = job_clone_dir(ctx, job["id"], name)
            if old.get("role") == "run" and os.path.isdir(old.get("worktree") or ""):
                # Now changed too: on the job's branch instead. Work done in the run-only clone is kept: the job's
                # branch starts there, with its commits and its uncommitted changes.
                owt = old["worktree"]
                k, dirty = unsaved_work(ctx, job, owt, name)
                if k or dirty:
                    obase = old.get("base_branch") or ctx.rc(name, "base_branch", "main")
                    if name in bases and bases[name] != obase:
                        raise FxError("%s has work in its run-only clone %s, made on %s: it can only become a changed "
                                      "repository from there, not from %s" % (name, owt, obase, bases[name]), code=3)
                    git(["checkout", "-q", "-b", branch], owt)
                    kept[name] = old
                    repos[name] = {"role": "change", "branch": branch, "worktree": owt, "base_branch": obase,
                                   "base_ref": old.get("base_ref") or "%s/%s" % (REMOTE, obase),
                                   "setup_done": old.get("setup_done", False), "pr_url": None, "pr_hint": None}
                    continue
                shutil.rmtree(owt, ignore_errors=True)
            job_clone(ctx, wt, branch, start="%s/%s" % (REMOTE, base), repo=name)
            made.append(wt)
            repos[name] = {"role": "change", "branch": branch, "worktree": wt, "base_branch": base,
                           "base_ref": "%s/%s" % (REMOTE, base), "setup_done": False, "pr_url": None, "pr_hint": None}
        for name in needed_repos(ctx, job_names(job, "change") + [n for n in change if n not in repos]):
            if name in repos:
                continue
            base = bases.get(name) or ctx.rc(name, "base_branch", "main")  # a plain --base is for what the job changes
            if name in bases:
                check_branch(ctx, base, "source", repo=name)
            wt = job_clone_dir(ctx, job["id"], name)
            run_clone(ctx, wt, base, name)
            made.append(wt)
            repos[name] = {"role": "run", "worktree": wt, "base_branch": base, "base_ref": "%s/%s" % (REMOTE, base),
                           "setup_done": False}
    except (FxError, OSError):
        for d in made:
            shutil.rmtree(d, ignore_errors=True)
        for name in list(repos):
            if repos[name].get("worktree") in made:
                del repos[name]
        for name, old in kept.items():  # back to the run-only clone it was, its work untouched
            git(["checkout", "-q", "--detach"], old["worktree"], check=False)
            git(["branch", "-q", "-D", branch], old["worktree"], check=False)
            repos[name] = old
        raise
    job["repo_order"] = [n for n in ctx.repo_names() if n in repos] + [n for n in job_order(job)
                                                                        if n not in ctx.repo_names()]
    return made


def job_apps(ctx, job):
    """The apps a job runs, in start order: every repository it changes that has an app.up, and every repository they need
    (app.needs, followed through), each after what it needs; ties in repo order."""
    known = ctx.repo_names()
    want, todo = set(), [n for n in job_names(job, "change") if n in known and ctx.rc(n, "app.up")]
    while todo:
        n = todo.pop()
        if n not in want:
            want.add(n)
            todo += app_needs(ctx, n)
    order = []

    def visit(n, path):
        if n in order or n in path:
            return
        for d in app_needs(ctx, n):
            if d in want:
                visit(d, path + (n,))
        order.append(n)
    for n in [x for x in known if x in want]:
        visit(n, ())
    return [n for n in order if ctx.rc(n, "app.up")]


def job_baselines_start(ctx, job, names=None):
    """Where the factory repository stood when the job (or its repository) started: the baselines ledger counts from there."""
    head = git(["rev-parse", "-q", "--verify", "HEAD"], ctx.factory, check=False).stdout.strip()
    for n in names if names is not None else job_names(job, "change"):
        job["repos"][n]["baselines_start"] = head


def job_block(ctx, job):
    """Where the job's block of ports starts: job.port (ports.base + slot * ports.step, given by free_slot)."""
    if job.get("port") is not None:
        return int(job["port"])
    return ports_base(ctx) + ports_step(ctx) * int(job.get("slot") or 0)


def job_branch_name(job):
    """The job's branch, the same in every repository it changes."""
    for n in job_names(job, "change"):
        if job["repos"][n].get("branch"):
            return job["repos"][n]["branch"]
    return "factory/%s-%s" % (job["id"], slugify(job.get("summary") or "", 30))


def job_candidates(job):
    """The best-of-N candidates by number: {k: {repo: its candidate entry}}. Candidate k has a clone of every repository
    the job changes."""
    found = {}
    for n in job_names(job, "change"):
        for c in job["repos"][n].get("candidates") or []:
            found.setdefault(c["k"], {})[n] = c
    return dict(sorted(found.items()))


def job_clone_dir(ctx, job_id, name):
    """Where a new job's clone of a repository goes: work/<job>/<repo>; in a project of one repository work/<job>, as
    it always was."""
    if len(ctx.repos) <= 1:
        return os.path.join(ctx.work, job_id)
    if os.path.isdir(os.path.join(ctx.work, job_id, ".git")):
        raise FxError("the job %s has a clone of the project at %s from when the project had one repository; finish "
                      "that job before it changes a second repository" % (job_id, os.path.join(ctx.work, job_id)),
                      code=3)
    return os.path.join(ctx.work, job_id, name)


def job_code_roots(job):
    """What the job's staged logic is checked against: {repo: clone} for every repository of the job (citations name
    the repository, repo:path, in a project of several; a repository the job has no clone of is read from its base)."""
    if is_whole_job(job):
        return {n: job["repos"][n].get("worktree") or "" for n in job_order(job)}
    return job.get("worktree") or ""


def job_merged_repos(ctx, job):
    """{repository: merged / closed / open} for each repository whose change left this machine (else the first), a
    repository a rework found merged included."""
    names = job_pr_names(job)
    sent = [n for n in names if job["repos"][n].get("pushed_head") or job["repos"][n].get("pr_url")]
    return {n: repo_merged(ctx, job, n) for n in (sent or names[:1])}


def job_port(ctx, job, name):
    """A repository's port in the job's block of ports: the block's start + its place in repo_order. The first
    app_ports(ctx) ports of a block are the apps'; the agents' own come after them (agent_port, candidate_block)."""
    order = job_order(job)
    i = order.index(name) if name in order else 0
    return job_block(ctx, job) + i


def job_repo_rows(ctx, job):
    """Each repository of a job, for the output: role, clone, branch, base, target, pull request and port."""
    rows = []
    for n in job_names(job):
        e = job["repos"][n]
        row = {"name": n, "role": e.get("role", "change"), "worktree": e.get("worktree"), "branch": e.get("branch"),
               "base": e.get("base_branch"), "target": e.get("target_branch"),
               "pr": e.get("pr_url") or e.get("pr_hint")}
        if ctx is not None and job.get("slot") is not None:
            row["port"] = job_port(ctx, job, n)
        rows.append(row)
    return rows


def keys_id(ctx):
    """The name of this project's keys folder: keys_id in factory.json, written once by init and never changed. Without
    it, as before: the project's name and its URL (an old factory.json's project.url, else the first repository's), so a
    factory moved to the new form keeps its folder."""
    kid = ctx.cfg.get("keys_id") if isinstance(ctx.cfg, dict) else None
    if isinstance(kid, str) and kid.strip():
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", kid.strip()).strip("-.")
        if safe:
            return safe
    proj = ctx.cfg.get("project") if isinstance(ctx.cfg.get("project"), dict) else {}
    url = proj.get("url") or (ctx.repos[0].get("url") if ctx.repos else None) or ctx.factory
    return keys_id_for(proj.get("name") or os.path.basename(ctx.factory), url)


def keys_id_for(name, url):
    """<project name>-<the first 8 of sha256(url)>: the name of a project's keys folder."""
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name or "").strip("-") or "project"
    return "%s-%s" % (name, hashlib.sha256((url or "").encode()).hexdigest()[:8])


def keys_id_valid(kid):
    return isinstance(kid, str) and bool(re.sub(r"[^A-Za-z0-9._-]+", "-", kid.strip()).strip("-."))


def knowledge_check_all(ctx, codes, kd=None, only=None, arch_texts=None):
    """Every knowledge file: the shared ones and each repository's folder, against codes ({repo: folder}). A
    repository's module map is its folder's architecture.md (flat: knowledge/architecture.md). kd: a staging folder laid
    out like knowledge/ instead. only: the files to check (relative to kd). arch_texts: {repo: text} for a module map
    instead of the file (a staged one)."""
    kd = kd or knowledge_dir(ctx)
    arch_texts = arch_texts or {}
    several = len(ctx.repos) > 1

    def pick(prefix):
        return None if only is None else [o[len(prefix):] for o in only
                                          if o.startswith(prefix) and "/" not in o[len(prefix):]]
    if knowledge_flat(ctx):
        one = next(iter(codes), None)
        parts = [(one, knowledge_check(ctx, kd, codes, only=pick(""), arch_text=arch_texts.get(one),
                                       modules_code=codes.get(one)))]
    else:
        parts = [(None, knowledge_check(ctx, kd, codes, only=pick("")))]
        for n in [n for n in ctx.repo_names() if n in codes]:
            if os.path.isdir(os.path.join(kd, n)) or n in arch_texts:
                parts.append((n, knowledge_check(ctx, os.path.join(kd, n), codes, only=pick(n + "/"),
                                                 arch_text=arch_texts.get(n), modules_code=codes.get(n),
                                                 prefix="%s/" % n)))
    res = {"problems": [], "missing_modules": [], "citations_checked": 0, "excerpts_checked": 0}
    if several:
        res["repos"] = {}
    if only is None and kd == knowledge_dir(ctx) and not knowledge_flat(ctx):
        res["problems"] += ["%s/: missing: the knowledge of the repository %s (/auto-factory:code init writes it)"
                            % (n, n) for n in ctx.repo_names() if n in codes and not os.path.isdir(os.path.join(kd, n))]
    for n, got in parts:
        for k in ("problems", "citations_checked", "excerpts_checked"):
            res[k] += got[k]
        res["missing_modules"] += ["%s:%s" % (n, m) if several else m for m in got["missing_modules"]]
        if several and n:
            res["repos"][n] = {"modules": len(got["modules"]), "missing_modules": got["missing_modules"],
                               "module_map": "knowledge/%s/architecture.md" % n}
    return res


def knowledge_codes(ctx):
    """{repo: its code} for every repository of the project (knowledge_code)."""
    return {n: knowledge_code(ctx, n) for n in ctx.repo_names()}


def knowledge_flat(ctx):
    """An older factory's one flat knowledge/: a project of one repository with no knowledge/<repo>/ yet, whose
    repository files (architecture.md, style.md…) sit with the shared ones and count as that repository's."""
    return len(ctx.repos) <= 1 and not any(os.path.isdir(os.path.join(knowledge_dir(ctx), n))
                                           for n in ctx.repo_names())


def knowledge_link_roots(ctx):
    """Folders a knowledge or logic file may link to by a relative name: knowledge/ and each knowledge/<repo>/."""
    kd = knowledge_dir(ctx)
    return (kd,) + tuple(os.path.join(kd, n) for n in ctx.repo_names() if os.path.isdir(os.path.join(kd, n)))


def knowledge_rel(ctx, fname, repo=None):
    """Where a knowledge file of this name is, relative to knowledge/: a repository's own (REPO_KNOWLEDGE) in its
    folder, any other shared at the top."""
    if fname in REPO_KNOWLEDGE and fname != "README.md" and not knowledge_flat(ctx) and ctx.repos:
        return "%s/%s" % (ctx.repo_name(repo), fname)
    return fname


def knowledge_role_files(d, agent):
    """A knowledge folder's files for a role: its index first, then the files meant for this role, then any extra file
    the team added."""
    files = []
    if not os.path.isdir(d):
        return files
    idx = os.path.join(d, "README.md")
    if os.path.exists(idx):
        files.append(idx)
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        if name == "README.md" or not name.endswith(".md") or not os.path.isfile(path):
            continue
        roles = KNOWLEDGE_ROLES.get(name, "*")
        if roles == "*" or agent in roles.split():
            files.append(path)
    return files


def knowledge_snapshot(ctx, meta):
    """The snapshot folder a staged knowledge refresh names (meta.json), or None: only work/_knowledge-<repo>-<stamp>-<pid>
    (or work/_knowledge-<stamp>-<pid>, or an older one's plain name) counts. meta.json is in a folder the librarian writes,
    and fx deletes that folder."""
    snap = meta.get("snapshot") if isinstance(meta, dict) else None
    if not isinstance(snap, str) or not snap:
        return None
    repos = "|".join(re.escape(n) for n in ctx.repo_names()) or "(?!)"
    mine = re.compile(r"^_knowledge(-(%s))?(-\d{8}-\d{6}-\d+)?$" % repos)
    path = os.path.abspath(snap)
    if not mine.match(os.path.basename(path)) or os.path.realpath(os.path.dirname(path)) != os.path.realpath(ctx.work) \
            or os.path.islink(path):
        return None
    return path


def knowledge_stale_all(ctx):
    """knowledge_stale of every repository: the one's result itself in a project of one, else {stale, repos}."""
    if len(ctx.repos) <= 1:
        return knowledge_stale(ctx)
    per = {n: knowledge_stale(ctx, n) for n in ctx.repo_names()}
    return {"stale": any(v["stale"] for v in per.values()), "repos": per,
            "stale_repos": [n for n, v in per.items() if v["stale"]]}


def local_file_source(ctx, rel, repo=None):
    """Where a copy_into_worktree file of a repository comes from, or None: local/<repo>/<file> in the factory
    repository first (each repository's own .env), then copy_from, else local/<file>."""
    name = ctx.repo_name(repo) if ctx.repos else None
    for root in ([os.path.join(ctx.factory, "local", name)] if name else []) + [copy_source(ctx, repo)]:
        if os.path.isfile(os.path.join(root, rel)):
            return os.path.join(root, rel)
    return None


def machine_dir():
    """This machine's own folder of the factory (its keys), outside git: ~/.config/code-factory, or
    FACTORY_CONFIG_DIR. FACTORY_WORKSPACE, an older way to move it, names a file in it."""
    if os.environ.get("FACTORY_CONFIG_DIR"):
        return os.path.expanduser(os.environ["FACTORY_CONFIG_DIR"])
    if os.environ.get("FACTORY_WORKSPACE"):
        return os.path.dirname(os.path.expanduser(os.environ["FACTORY_WORKSPACE"]))
    return os.path.expanduser("~/.config/code-factory")


def md_demote(lines):
    """Headings one level down, for a report put under a ## Repo: section."""
    return [("#" + l) if re.match(r"^#{2,5} ", l) else l for l in lines]


def needed_clones(ctx, job, prefix, made, notes=None):
    """Clone, at its base, every repository the job's apps need and set it up; they join the job as run-only."""
    for m in job_apps(ctx, job):
        if m in job["repos"]:
            continue
        base = ctx.rc(m, "base_branch", "main")
        wt = os.path.join(ctx.work, "%s-%s" % (prefix, m))
        made.append(wt)
        run_clone(ctx, wt, base, m)
        job["repos"][m] = {"role": "run", "worktree": wt, "base_ref": "%s/%s" % (REMOTE, base)}
        job["repo_order"] = [n for n in ctx.repo_names() if n in job["repos"]]
        cmd = ctx.rc(m, "setup", "")
        if cmd:
            env, _db = app_env(repo_ctx(ctx, m), repo_view(ctx, job, m))
            p = run(["bash", "-lc", cmd], cwd=wt, check=False, env=env,
                    timeout=int(ctx.rc(m, "setup_timeout_sec", 1800) or 1800))
            if p.returncode != 0:
                raise FxError("setup of %s (its app is needed) exited %s" % (m, p.returncode))
    return job


def needed_repos(ctx, change):
    """What the job's apps need: every changed repository with app.up and, followed through app.needs, what they need."""
    todo = [n for n in change if ctx.rc(n, "app.up")]
    seen = set()
    while todo:
        n = todo.pop()
        if n in seen:
            continue
        seen.add(n)
        todo += [d for d in ctx.rc(n, "app.needs", []) or [] if d in ctx.repo_names()]
    return [n for n in ctx.repo_names() if n in seen and n not in change]


def new_job_repos(ctx, a):
    """The repositories fx new clones at once: the only one, or the --repos list. None: they wait for intake."""
    if ctx.repo_problems:
        raise FxError("factory.json lists its repositories wrongly: %s" % "; ".join(ctx.repo_problems), code=3)
    if not ctx.repos:
        ctx.url()
    wanted = [x.strip() for x in re.split(r"[,\s]+", getattr(a, "repos", None) or "") if x.strip()]
    for n in wanted:
        ctx.repo_entry(n)
    if wanted:
        return [n for n in ctx.repo_names() if n in wanted]
    if len(ctx.repos) == 1:
        return ctx.repo_names()
    return None


def one_app(ctx, job, name=None):
    """(ctx, job) for one repository: a whole job's repository (name, else the first it changes) as repo_view with that
    repository's settings (RepoCtx); a view, or a job of fx's own, as it is."""
    if is_whole_job(job):
        name = name or job_primary(job) or next(iter(job_order(job)), None)
        if name and name in job["repos"] and name in ctx.repo_names():
            return repo_ctx(ctx, name), repo_view(ctx, job, name)
        return ctx, job
    return repo_ctx(ctx, job.get("repo")), job


def package_repo(p_, repos):
    """The repository a package belongs to: its "repo", or the job's only changed one."""
    return p_.get("repo") if isinstance(p_, dict) and p_.get("repo") else (repos[0] if repos else None)


def parse_bases(ctx, values, names=None, flag="--base"):
    """--base name=branch (repeatable), or a plain --base branch for every repository: {name or "*": branch}. flag:
    the option named in errors (fx pr's --target reads the same way)."""
    bases = {}
    for v in values or []:
        v = (v or "").strip()
        if not v:
            continue
        name, sep, branch = v.partition("=")
        if sep and REPO_RE.match(name.strip()):
            name, branch = name.strip(), branch.strip()
            ctx.repo_entry(name)
            if names is not None and name not in names:
                raise FxError("%s %s: %s is not one of this job's repositories (%s)" % (
                    flag, v, name, ", ".join(names) or "none yet"), code=3)
        else:
            name, branch = "*", v
        if not branch:
            raise FxError("%s %s names no branch" % (flag, v), code=3)
        bases[name] = branch
    return bases


def parse_intake_repos(text):
    """The names on intake.md's REPOS: line (among its first lines), or None when it has none."""
    for line in (text or "").splitlines()[:15]:
        m = re.match(r"^REPOS:\s*(.*)$", line.strip(), re.I)
        if m:
            return [x.strip().strip("`").lower() for x in re.split(r"[,\s]+", m.group(1))
                    if x.strip().strip("`") and x.strip() != "-"]
    return None


def ports_base(ctx):
    return int(ctx.cfg.get("ports", {}).get("base", 5100) if isinstance(ctx.cfg.get("ports"), dict) else 5100)


def ports_needed(ctx):
    """The ports one job's block must hold: its apps, the agents' three, and every best-of-N candidate's apps."""
    n = app_ports(ctx)
    return n + 3 + n * max(1, int(ctx.cfg.get("best_of_max", 4) or 4))


def ports_step(ctx):
    """A job's block of ports: at least 10, and room for every repository's app, the agents' three and the
    candidates' apps (ports_needed)."""
    got = ctx.cfg.get("ports", {}).get("step") if isinstance(ctx.cfg.get("ports"), dict) else None
    return int(got) if got else max(10, ports_needed(ctx))


def pr_baselines_repo(ctx, job):
    """The repository of the job whose pull request tells of the baselines it changed: the one holding the list."""
    cfg = baselines_config(ctx)
    v = baselines_job(ctx, cfg, job) if cfg else None
    return (v or {}).get("repo")


def pr_open(ctx, job, n, title, body, body_path, labels, draft, retarget, notes, where):
    """Open the pull request of one repository of the job, or update the one it has, with that repository's provider.
    Returns (pr_url, pr_hint)."""
    e = job["repos"][n]
    wt, branch, target = e["worktree"], e["branch"], e["target_branch"]
    nh_label = ctx.c("pr.needs_human_label")
    provider, url = remote_provider(ctx, job, n)
    rf = host_repo_flag(provider, url)
    pr_url, pr_hint = e.get("pr_url"), None
    if ctx.c("pr.create", True) is False:
        pr_hint = ("Branch %s%s pushed. Pull requests are opened by hand (pr.create is off): open one into %s when "
                   "you want." % (branch, " of %s" % n if where else "", target))
        notes.append(where + "pull request not opened: pr.create is off in %s" % CONFIG_NAME)
    elif provider == "github" and shutil.which("gh"):
        for l in labels:
            run(["gh", "label", "create", l, "--force"] + rf, cwd=wt, check=False)
        pr_url = pr_url or gh_existing_pr(branch, wt, rf)
        if pr_url:
            run(["gh", "pr", "edit", pr_url, "--title", title, "--body-file", body_path] +
                (["--base", target] if retarget else []) + rf, cwd=wt, check=False)
            run(["gh", "pr", "ready", pr_url] + (["--undo"] if draft else []) + rf, cwd=wt, check=False)
            if nh_label:
                flag = "--add-label" if job.get("needs_human") else "--remove-label"
                run(["gh", "pr", "edit", pr_url, flag, nh_label] + rf, cwd=wt, check=False)
            notes.append(where + "existing PR updated")
        else:
            base_cmd = ["gh", "pr", "create", "--base", target, "--head", branch,
                        "--title", title, "--body-file", body_path] + (["--draft"] if draft else []) + rf
            lab = sum([["--label", l] for l in labels], [])
            p = run(base_cmd + lab, cwd=wt, check=False)
            if p.returncode != 0 and lab:
                notes.append(where + "could not add labels; PR created without them")
                p = run(base_cmd, cwd=wt, check=False)
            if p.returncode != 0:
                pr_url = gh_existing_pr(branch, wt, rf)
                if not pr_url:
                    raise FxError("gh pr create failed%s:\n" % (" for %s" % n if where else "") + (p.stdout or ""))
            else:
                urls = re.findall(r"https://\S+", p.stdout or "")
                pr_url = urls[-1] if urls else gh_existing_pr(branch, wt, rf)
    elif provider == "gitlab" and shutil.which("glab"):
        iid = re.search(r"/merge_requests/(\d+)", pr_url or "")
        if iid:
            cmd = ["glab", "mr", "update", iid.group(1), "--title", title, "--description", body,
                   "--draft" if draft else "--ready"] + (["--target-branch", target] if retarget else []) + rf
            if nh_label:
                cmd += ["--label" if job.get("needs_human") else "--unlabel", nh_label]
            u = run(cmd, cwd=wt, check=False, timeout=120)
            notes.append(where + ("existing MR updated" if u.returncode == 0 else
                                  "MR got the new commits, but glab could not update its description: "
                                  + (u.stdout or "")[-200:].strip()))
        elif pr_url:
            notes.append(where + "MR updated by the push")
        else:
            cmd = ["glab", "mr", "create", "--source-branch", branch, "--target-branch",
                   target, "--title", ("Draft: " if draft else "") + title,
                   "--description", body, "--yes"] + rf
            if labels:
                cmd += ["--label", ",".join(labels)]
            p = run(cmd, cwd=wt, check=False)
            urls = re.findall(r"https://\S+", p.stdout or "")
            if p.returncode != 0 and not urls:
                v = run(["glab", "mr", "view", branch] + rf, cwd=wt, check=False)
                urls = re.findall(r"https://\S+/merge_requests/\d+", v.stdout or "")
                if not urls:
                    raise FxError("glab mr create failed%s:\n" % (" for %s" % n if where else "") + (p.stdout or ""))
            pr_url = urls[-1] if urls else None
    else:
        m = re.search(r"bitbucket\.org[:/]([^/]+)/([^/.]+)", url or "")
        if m:
            pr_hint = "https://bitbucket.org/%s/%s/pull-requests/new?source=%s&dest=%s" % (
                m.group(1), m.group(2), urllib.parse.quote(branch, safe=""), target)
        else:
            pr_hint = "Open a pull request from %s into %s%s (no gh/glab for %s)." % (
                branch, target, " in %s" % n if where else "", provider)
        notes.append(where + "PR not created automatically (%s); open it from the hint" % provider)
    return pr_url, pr_hint


def pr_targets(ctx, job, values):
    """--target per repository (name=branch, repeatable) or a plain --target branch for every changed one: {name:
    branch}. A repository not named keeps its earlier target, else the branch it started from."""
    names = job_names(job, "change")
    given = parse_bases(ctx, values, names, flag="--target")
    targets = {}
    for n in names:
        e = job["repos"][n]
        t = given.get(n) or given.get("*")
        if t:
            check_branch(ctx, t, "target", n)
        targets[n] = t or e.get("target_branch") or e["base_branch"]
    return targets


def pr_text(ctx, job, n, work, hits):
    """A repository's pull request description, listing the repositories of work, scrubbed of secrets (their names go
    to hits)."""
    body, hit_b = scrub_text(ctx, pr_description(ctx, job, n, {m: None for m in work}))
    hits += hit_b
    return body


def pr_where(e):
    """Where a repository's change of the job is, for the other pull requests and the Jira comment."""
    if e.get("pr_url"):
        return e["pr_url"]
    return "branch `%s` into `%s`%s" % (e.get("branch"), e.get("target_branch") or e.get("base_branch"),
                                        "" if e.get("pushed_head") else " (not pushed yet)")


def pr_write_links(ctx, job, n, body, body_path):
    """Give a repository's pull request its final description (fx pr's last phase, once every pull request of the job
    is known). Returns a note when the host refused."""
    e = job["repos"][n]
    provider, url = remote_provider(ctx, job, n)
    rf = host_repo_flag(provider, url)
    if provider == "github" and shutil.which("gh"):
        p = run(["gh", "pr", "edit", e["pr_url"], "--body-file", body_path] + rf, cwd=e["worktree"], check=False)
    elif provider == "gitlab" and shutil.which("glab") and re.search(r"/merge_requests/(\d+)", e["pr_url"]):
        iid = re.search(r"/merge_requests/(\d+)", e["pr_url"]).group(1)
        p = run(["glab", "mr", "update", iid, "--description", body] + rf, cwd=e["worktree"], check=False, timeout=120)
    else:
        return None
    if p.returncode != 0:
        return "%s: could not write the links to the other pull requests into %s: %s" % (
            n, e["pr_url"], (p.stdout or "")[-200:].strip())
    return None


def project_remote_url(ctx, url, notes):
    """The URL init records for a repository: a local folder means its remote (a bare repository is one)."""
    url = (url or "").strip()
    local = os.path.expanduser(url)
    if not url or not os.path.isdir(local):
        return url
    local = os.path.abspath(local)
    if run_sep(["git", "rev-parse", "--is-bare-repository"], cwd=local).stdout.strip() == "true":
        return local  # a bare repository is a remote: nobody works in it
    if not git_toplevel(local):
        raise FxError("%s is not a git repository" % local, code=3)
    names = run_sep(["git", "remote"], cwd=local).stdout.split()
    name = REMOTE if REMOTE in names else (names[0] if names else None)
    if not name:
        raise FxError("%s has no remote. The factory never pushes into your own checkout: give the URL of the "
                      "repository it pushes to (or of a bare repository)" % local, code=3)
    origin = run_sep(["git", "remote", "get-url", name], cwd=local).stdout.strip()
    if origin and not os.path.isabs(origin) and os.path.exists(os.path.join(local, origin)):
        origin = os.path.normpath(os.path.join(local, origin))  # a relative path is relative to that folder
    notes.append("using the project's remote %s instead of your folder %s, so the folder is never touched"
                 % (origin, local))
    return origin

