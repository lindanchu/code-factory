def review_project(ctx):
    provider, url = remote_provider(ctx, None)
    if provider in ("github", "bitbucket"):
        raise FxError("fx review reads merge requests from GitLab, and this project is on %s" % provider, code=3)
    host, proj = gitlab_project(url)
    if not host:
        raise FxError("cannot read a GitLab project from project.url (%s) in factory.json" % url, code=3)
    return host, proj


def review_repos(ctx):
    """Every repository of the project whose merge requests this factory reviews (those on GitLab), in the order of
    repos. The first is the primary one: its reviews keep the plain folder name. In a project of one repository its
    settings and knowledge are the factory's own, as they always were; with several, each repository's own (ctx.rc,
    knowledge/<repo>/)."""
    host, proj = review_project(ctx)
    several = len(ctx.repos) > 1
    rows = []
    for i, name in enumerate(ctx.repo_names()):
        url = ctx.url(name)
        rhost, rproj = (host, proj) if i == 0 else gitlab_project(url)
        if not rhost or "github.com" in url or "bitbucket.org" in url:
            continue  # merge requests are read from GitLab only
        rc = (lambda k, d=None, n=name: ctx.rc(n, k, d)) if several else (lambda k, d=None: ctx.c(k, d))
        rows.append({"name": name if several else proj.rsplit("/", 1)[-1], "repo": name, "url": url, "host": rhost,
                     "project": rproj, "primary": i == 0, "ui_paths": rc("ui_paths", []) or [], "app": rc("app"),
                     "setup": rc("setup"), "checks": rc("review.checks"), "mobile": rc("mobile")})
    # An older factory.json's review.repos, until /auto-factory:code init folds it into repos: read as it always was,
    # each with its own settings and its knowledge apart in knowledge/repos/<name>/.
    for r in ctx.c("review.repos", []) or []:
        name, url = (r.get("name"), r.get("url")) if isinstance(r, dict) else (None, None)
        if not url or not name or not REPO_NAME_RE.match(name) or name == "fit":
            raise FxError("review.repos in factory.json needs a short name (like fe, and not fit) and a url for each "
                          "repository; it has %r" % (r,), code=3)
        if "github.com" in url or "bitbucket.org" in url:
            raise FxError("fx review reads merge requests from GitLab, and review.repos names %s" % url, code=3)
        rhost, rproj = gitlab_project(url)
        if not rhost:
            raise FxError("cannot read a GitLab project from %s in review.repos in factory.json" % url, code=3)
        if any(x["name"] == name or (x["host"], x["project"]) == (rhost, rproj) for x in rows):
            raise FxError("review.repos names %s (%s) twice, or it is a repository of the project" % (name, rproj), code=3)
        rows.append({"name": name, "url": url, "host": rhost, "project": rproj, "primary": False, "legacy": True,
                     "ui_paths": r.get("ui_paths") or ctx.c("ui_paths", []) or [],
                     "app": r.get("app"), "setup": r.get("setup"), "checks": r.get("checks"),
                     "mobile": r.get("mobile")})
    return rows


def review_repo_of(repos, host, proj):
    for r in repos:
        if (r["host"], r["project"]) == (host, proj):
            return r
    where = ("fx init --repo <name>=<git URL>, in factory.json (or in its older review.repos list)"
             if any(r.get("legacy") for r in repos) else "fx init --repo <name>=<git URL>, in factory.json")
    raise FxError("that merge request is in %s/%s, and this factory reviews %s: add that repository to the project with "
                  "%s, or run it in its own factory repository" % (
                      host, proj, ", ".join(r["project"] for r in repos), where), code=3)


def review_repo(ctx, job):
    return review_repo_of(review_repos(ctx), job["host"], job["project"])


def review_knowledge_dir(ctx, repo):
