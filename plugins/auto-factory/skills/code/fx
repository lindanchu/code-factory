def same_path(a, b):
    return os.path.realpath(a) == os.path.realpath(b)


def repo_sections(text, fname, retry, names=None):
    """The '## Repo: <name>' sections of an agent's file."""
    names = names or REPO_NAME_RE
    parts, cur = {}, None
    for row in text.splitlines():
        head = re.match(r"^##\s+Repo:\s*(.*?)\s*$", row)
        if head:
            cur = head.group(1)
            if not names.match(cur):
                raise FxError("%s names a repository %r: use its short name, like be" % (fname, cur), code=6, extra=retry)
            if cur in parts:
                raise FxError("%s has two sections for %s" % (fname, cur), code=6, extra=retry)
            parts[cur] = []
        elif re.match(r"^##\s", row):
            cur = None
        elif cur:
            parts[cur].append(row)
    return {name: "\n".join(rows).strip() for name, rows in parts.items()}


def ledger_settings_path():
    """This machine's own wishes, in its own folder (machine_dir): never in git, since they are about one machine."""
    return os.environ.get("FACTORY_MACHINE") or os.path.join(machine_dir(), "machine.json")


def machine_setting_problem(key, value):
    """Why this setting cannot be taken, or None."""
    if key not in MACHINE_DEFAULTS:
        return "fx knows no setting %r (it knows %s)" % (key, ", ".join(sorted(MACHINE_DEFAULTS)))
    if key == "pressure":
        return None if value in PRESSURE_MODES else "pressure is one of %s" % ", ".join(PRESSURE_MODES)
    if key == "first_guess":
        ok = isinstance(value, dict) and all(k in POOLS and isinstance(v, (int, float)) and not isinstance(v, bool)
                                             and 0 < v <= 1 for k, v in value.items())
        return None if ok else "first_guess holds shares between 0 and 1 for %s" % ", ".join(POOLS)
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:
        return "%s is a number, 0 or more" % key
    if key in MACHINE_SHARES and not value < 1:
        return "%s is a share of the machine: less than 1" % key
    if key in ("cpu_factor", "safety") and value <= 0:
        return "%s must be more than 0" % key
    return None


def ledger_settings():
    cfg = json.loads(json.dumps(MACHINE_DEFAULTS))
    try:
        own = json.loads(read(ledger_settings_path(), "") or "{}")
    except ValueError:
        own = {}
    for k, v in (own.items() if isinstance(own, dict) else []):
        if not machine_setting_problem(k, v):
            cfg[k] = dict(cfg[k], **v) if isinstance(cfg[k], dict) else v
    return cfg


_LEDGER = {"depth": 0}
_LEDGER_THREADS = threading.RLock()


@contextlib.contextmanager
def ledger_lock():
    """One fx at a time reads and changes the ledger. Held for moments: nothing slow happens under it."""
    with _LEDGER_THREADS:
        if _LEDGER["depth"]:
            _LEDGER["depth"] += 1
            try:
                yield
            finally:
                _LEDGER["depth"] -= 1
            return
        os.makedirs(ledger_dir(), exist_ok=True)
        f = open(os.path.join(ledger_dir(), "lock"), "a+")
        try:
            if fcntl is not None:
                fcntl.flock(f, fcntl.LOCK_EX)
            _LEDGER["depth"] = 1
            yield
        finally:
            _LEDGER["depth"] = 0
            f.close()


def ledger_load():
    try:
        st = json.loads(read(os.path.join(ledger_dir(), "state.json"), "") or "{}")
    except ValueError:
        st = {}
    if not isinstance(st, dict):
        st = {}
    st.setdefault("version", 1)
    st.setdefault("seq", 0)
    for key, empty in (("leases", {}), ("queue", []), ("ports", {})):
        if not isinstance(st.get(key), type(empty)):
            st[key] = empty
    st.setdefault("reading", None)
    if not isinstance(st.get("id"), str) or not re.fullmatch(r"[0-9a-f]{8}", st["id"]):
        st["id"] = secrets.token_hex(4)  # kept from the first save on: see place_ours
    _LEDGER_ID[0] = st["id"]
    return st


_LEDGER_ID = [None]  # this ledger's id, as last read


def place_ours(place):
    """A place this ledger gave: its name starts with the ledger's own id. Another ledger on the same Docker (another
    user of the machine, a test with its own state folder) gives places too, and a container that carries one of those
    is not ours to count as left behind, let alone to stop."""
    mine = _LEDGER_ID[0]
    return bool(mine) and isinstance(place, str) and place.startswith(mine + "-")


def ledger_save(st):
    write_atomic(os.path.join(ledger_dir(), "state.json"), json.dumps(st, indent=1))


def lock_file_for(kind, path):
    """Lock files live with the machine's own state, never in a job's folder: that folder goes to S3 and to agents."""
    name = hashlib.sha256(os.path.realpath(path).encode("utf-8", "surrogateescape")).hexdigest()[:24]
    folder = os.path.join(ledger_dir(), "locks")
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "%s.%s.lock" % (name, kind))


@contextlib.contextmanager
def path_lock(kind, path, wait=60):
    """One fx at a time does this to that path; the others wait their turn."""
    with open(lock_file_for(kind, path), "a+") as f:
        if not flock_wait(f, "exclusive", wait):
            raise FxError("another fx kept %s busy for %ds (%s); try again" % (path, wait, kind), code=3)
        yield


# --- who is alive, and which session this is

def proc_starts(pids):
    """When each of these processes started; one that is gone is left out. With its pid that names one process for good:
    a pid alone is given out again. One that died and only waits for its parent to notice (a zombie) is gone too, since
    it will never give anything back by itself."""
    found, rest = {}, []
    for pid in {int(p) for p in pids if str(p).isdigit()}:
        try:
            with open("/proc/%d/stat" % pid) as f:  # Linux
                fields = f.read().rsplit(")", 1)[1].split()
            if fields[0] not in ("Z", "X"):
                found[pid] = "t" + fields[19]
        except (IndexError, ValueError):
            pass
        except OSError:
            if not os.path.isdir("/proc/self"):
                rest.append(pid)
    if rest:  # macOS, BSD. The same clock and words for every session, or one would not know another's processes.
        text = try_out(["ps", "-o", "pid=,stat=,lstart=", "-p", ",".join(str(p) for p in rest)], timeout=15,
                       env=dict(os.environ, LC_ALL="C", TZ="UTC")) or ""
        for line in text.splitlines():
            parts = line.split(None, 2)
            if len(parts) == 3 and parts[0].isdigit() and not parts[1].startswith("Z"):
                found[int(parts[0])] = parts[2].strip()
    return found


def proc_alive(owner, starts=None):
    """Is the process that took this still the one running? starts: what proc_starts found, when many are asked at once."""
    pid = owner.get("pid") if isinstance(owner, dict) else None
    if not isinstance(pid, int) or not owner.get("pid_start"):
        return False
    start = (starts if starts is not None else proc_starts([pid])).get(pid)
    return start is not None and start == owner["pid_start"]


_PROC_ME = {}


def proc_me():
    pid = os.getpid()
    if _PROC_ME.get("pid") != pid:
        _PROC_ME.clear()
        _PROC_ME.update(pid=pid, pid_start=proc_starts([pid]).get(pid))
    return dict(_PROC_ME)


_SESSION_ME = {}


def session_me():
    """The chat session this fx runs in, when Claude Code says so: its id, and the process that is the session. None
    anywhere else (a terminal, CI), where nothing is known and nothing is refused."""
    sid, pid = os.environ.get("CLAUDE_CODE_SESSION_ID"), os.environ.get("CLAUDE_PID")
    if not sid:
        return None
    if _SESSION_ME.get("key") != (sid, pid):
        me = {"session": sid}
        if pid and pid.isdigit():
            start = proc_starts([pid]).get(int(pid))
            if start:
                me.update(pid=int(pid), pid_start=start)
        _SESSION_ME.clear()
        _SESSION_ME.update(key=(sid, pid), me=me)
    return dict(_SESSION_ME["me"])


def session_word(who):
    sid = (who or {}).get("session")
    mine = (session_me() or {}).get("session")
    return "" if not sid else "this session" if sid == mine else "session %s" % sid[:8]


_BUSY = {}  # the jobs this fx already holds: one process never locks itself out
LONG_STEPS = ("setup", "gate", "push", "candidates", "checks of the candidates", "checks")


@contextlib.contextmanager
def job_busy(ctx, job, step, wait=0):
    """One step at a time works in a job's clone and round folder. A second gate, setup or push of the same job is told
    who is at it, instead of both writing the same round. wait: a quick step waits this long for another quick one.
    Released when this fx ends, however it ends."""
    path = lock_file_for("busy", ctx.job_dir(job["id"]))
    if _BUSY.get(path):
        _BUSY[path] += 1
        try:
            yield
        finally:
            _BUSY[path] -= 1
        return
    with open(path, "a+") as f:
        end = time.time() + wait
        while not flock_wait(f, "exclusive", 0):
            f.seek(0)
            try:
                who = json.loads(f.read() or "{}")
            except ValueError:
                who = {}
            if time.time() >= end or who.get("step") in LONG_STEPS:
                where = session_word(who)
                raise FxError("%s is already running %s (since %s%s). Wait for it to finish: the same job cannot run two "
                              "steps at once" % (job["id"], who.get("step") or "another step", who.get("since") or "?",
                                                 ", in %s" % where if where else ""),
                              code=EXIT_WAIT, extra={"next": "wait", "busy": {k: who.get(k) for k in ("step", "since")}})
            time.sleep(0.2)
        f.seek(0)
        try:
            was = json.loads(f.read() or "{}")
        except ValueError:
            was = {}
        if isinstance(was, dict) and was.get("groups"):  # the fx that had the job was killed with its commands running
            stopped = groups_stop(was["groups"])
            if stopped:
                hint("stopped what an earlier %s of %s had left running (%d process group%s): its fx was killed"
                     % (was.get("step") or "step", job["id"], len(stopped), "" if len(stopped) == 1 else "s"))
        f.seek(0)
        f.truncate()
        f.write(json.dumps({"step": step, "since": now(), "pid": os.getpid(),
                            "session": (session_me() or {}).get("session")}))
        f.flush()
        _BUSY[path] = 1
        _BUSY_NOW.append(f)
        try:
            yield
        finally:
            _BUSY_NOW.remove(f)
            _BUSY.pop(path, None)


def held_elsewhere(job, me):
    """Another chat session that is still open has this job. Not when that session is over: its window was closed, or
    this one replaced it in the same window."""
    held = job.get("held_by") or {}
    if not me or not held.get("session") or held["session"] == me["session"]:
        return False
    if (held.get("pid"), held.get("pid_start")) == (me.get("pid"), me.get("pid_start")):
        return False
    return proc_alive(held)


def job_owner_check(ctx, ref):
    """A job two open sessions work on at once loses work: each spawns its own builder in the one clone. So the session
    that last drove the job keeps it while that session is still open, and another has to take it over on purpose."""
    me = session_me()
    if not me:
        return
    try:
        job = ctx.load(ref)
    except (FxError, ValueError):
        return
    held = job.get("held_by") or {}
    if job.get("stage") in TERMINAL or not held_elsewhere(job, me):
        return
    raise FxError("%s is being worked on in another chat session that is still open (it has had the job since %s). Two "
                  "sessions on one job write over each other. Go on with it there, or take it over here"
                  % (job["id"], held.get("since") or "?"), code=2,
                  extra={"next": "ask-take", "held_by": {"session": held["session"][:8], "since": held.get("since")},
                         "then": "%s take %s" % (FX_CMD, shlex.quote(job["id"]))})


def cmd_take(ctx, a):
    job = ctx.load(a.job)
    was = job.get("held_by") or {}
    me = session_me()
    if not me:
        raise FxError("fx take is for a chat session taking a job over from another one; outside a session nothing "
                      "holds a job", code=3)
    job["held_by"] = dict(me, since=now())
    ctx.save(job, "taken over from %s" % (session_word(was) or "nobody"))
    out({"ok": True, "job": job["id"], "stage": job["stage"], "taken_from": (was.get("session") or "")[:8] or None,
         "next": "resume"})


# --- what the machine has, and what is in use

def mem_mb(text):
    m = re.match(r"\s*([\d.]+)\s*([KMGT]i?B|B)", text or "")
    if not m:
        return 0.0
    return float(m.group(1)) * {"B": 1 / 1048576, "K": 1 / 1024, "M": 1, "G": 1024, "T": 1048576}[m.group(2)[0]]


def cgroup_number(*names):
    """A number from this process's control group, or None: no such file, or no limit set."""
    for name in names:
        try:
            with open(os.path.join("/sys/fs/cgroup", name)) as f:
                word = f.read().split()[0]
            if word != "max" and float(word) < 2 ** 60:  # version 1 writes a huge number for "no limit"
                return float(word)
        except (OSError, ValueError, IndexError):
            continue
    return None


def cpus_here():
    """The CPUs this process may use: the machine's, or fewer when a control group or an affinity mask says so."""
    n = os.cpu_count() or 1
    try:
        n = min(n, len(os.sched_getaffinity(0)))  # Linux
    except (AttributeError, OSError):
        pass
    try:
        with open("/sys/fs/cgroup/cpu.max") as f:
            quota, period = f.read().split()[:2]
        if quota != "max":
            n = min(n, max(1, round(float(quota) / float(period))))
    except (OSError, ValueError):
        pass
    return n


def sysctl(name):
    """What macOS says under this name, as text; "" when it cannot be asked. /usr/sbin is not on every PATH."""
    return (try_out([shutil.which("sysctl") or "/usr/sbin/sysctl", "-n", name]) or "").strip()


def mem_total_mb():
    """The machine's memory as the C library tells it, for a machine whose own tools did not answer; 0 when unknown."""
    try:
        return max(0.0, os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE") / 1048576)
    except (ValueError, OSError, AttributeError):
        return 0.0


def meter_host():
    """The machine's own memory. pressure: 0 fine, 1 the system says it is short, 2 it says it is critical. What cannot
    be read holds no step back: total_mb 0 means the size is unknown, and with nothing said about what is still to be had,
    all of it counts as there (the factory's own steps are still counted against the size)."""
    if sys.platform == "darwin":
        size, level = sysctl("hw.memsize"), sysctl("kern.memorystatus_level")
        total = (float(size) / 1048576 if size.isdigit() else 0.0) or mem_total_mb()
        avail = None
        if level.isdigit() and int(level) <= 100:  # the system's own count of what is still to be had, in percent
            avail = total * int(level) / 100
        else:
            page = sysctl("hw.pagesize")
            pages = {}
            for line in (try_out([shutil.which("vm_stat") or "/usr/bin/vm_stat"]) or "").splitlines():
                m = re.match(r'"?([^":]+)"?:\s+(\d+)', line)
                if m:
                    pages[m.group(1).strip()] = int(m.group(2))
            if pages:
                avail = sum(pages.get(k, 0) for k in ("Pages free", "Pages speculative", "Pages purgeable",
                                                      "File-backed pages")) * (int(page) if page.isdigit() else 4096) / 1048576
        said = sysctl("kern.memorystatus_vm_pressure_level")
        return {"total_mb": total, "avail_mb": total if avail is None else min(avail, total),
                "pressure": {"1": 0, "2": 1, "4": 2}.get(said, 0),
                "pressure_source": "kern.memorystatus_vm_pressure_level=%s" % said if said else "no pressure counter here"}
    info = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                info[k] = int(v.split()[0]) / 1024
    except (OSError, ValueError, IndexError):
        pass
    some = None
    try:
        with open("/proc/pressure/memory") as f:  # the kernel's own account of time lost waiting for memory
            m = re.search(r"some avg10=([\d.]+)", f.read())
            some = float(m.group(1)) if m else None
    except OSError:
        pass
    total = info.get("MemTotal", 0.0) or mem_total_mb()
    avail = info.get("MemAvailable", info.get("MemFree", total))
    limit = cgroup_number("memory.max", "memory/memory.limit_in_bytes")  # in a container or on a CI runner
    if limit is not None and 0 < limit / 1048576 < total:
        used = (cgroup_number("memory.current", "memory/memory.usage_in_bytes") or 0) / 1048576
        total, avail = limit / 1048576, min(avail, max(0.0, limit / 1048576 - used))
    return {"total_mb": total, "avail_mb": avail, "pressure": 0 if some is None or some < 5 else 1 if some < 20 else 2,
            "pressure_source": "memory pressure (some avg10) %s" % some if some is not None else "no pressure counter here"}


def norm_mount(path):
    return path[len("/host_mnt"):] if path.startswith("/host_mnt/") else path  # Docker Desktop's name for the Mac's folders


def meter_docker(pick=None):
    """What Docker was given and what its containers use, each with the folders that say whose it is. None: no Docker
    here, or it is not running. pick: given every container, the ones to measure, when not all of them (measuring
    takes seconds)."""
    if not shutil.which("docker"):
        return None
    info = (try_out(["docker", "info", "--format", "{{.MemTotal}}\t{{.NCPU}}\t{{.OperatingSystem}}"], timeout=15)
            or "").strip().split("\t")
    if len(info) < 2 or not info[0].strip().isdigit():
        return None
    rows = {}
    for line in (try_out(["docker", "ps", "--no-trunc", "--format", DOCKER_PS_FORMAT], timeout=30) or "").splitlines():
        p = (line.split("\t") + [""] * 6)[:6]
        if p[0]:
            rows[p[0]] = {"name": p[0], "project": p[1], "workdir": p[2], "place": p[3], "oneoff": p[4] == "True",
                          "mounts": [norm_mount(m) for m in p[5].split(",") if m.startswith("/")], "mem_mb": 0.0, "cpu": 0.0}
    names = list(rows) if pick is None else [c["name"] for c in pick(list(rows.values()))]
    if names:
        stats = try_out(["docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}"]
                        + (names if pick is not None else []), timeout=90) or ""
        for line in stats.splitlines():
            p = line.split("\t")
            if len(p) >= 3 and p[0] in rows:
                rows[p[0]]["mem_mb"] = mem_mb(p[1].split("/")[0])
                try:
                    rows[p[0]]["cpu"] = float(p[2].rstrip("%")) / 100
                except ValueError:
                    pass
    return {"total_mb": int(info[0]) / 1048576, "cpus": int(info[1]) if info[1].strip().isdigit() else 0,
            "system": info[2].strip() if len(info) > 2 else "", "used_mb": sum(r["mem_mb"] for r in rows.values()),
            "containers": list(rows.values())}


def path_under(path, folder):
    folder = (folder or "").rstrip("/")
    return bool(folder) and bool(path) and (path == folder or path.startswith(folder + "/"))


def container_of_folders(c, folders):
    return any(path_under(c["workdir"], f) for f in folders) or any(path_under(m, f) for m in c["mounts"] for f in folders)


def containers_of(docker, folders, projects=(), place=None):
    """The containers that belong to these folders (a job's clone, its job folder): started by compose from one of them,
    or mounting one, or in the same compose project as one that does, or started by fx for this place. Nothing here is
    the project's own naming."""
    if not docker:
        return [], set()
    mine, projs = [], set(projects)
    for c in docker["containers"]:
        if (place and c["place"] == place) or container_of_folders(c, folders):
            mine.append(c)
            if c["project"]:
                projs.add(c["project"])
    names = {c["name"] for c in mine}
    for c in docker["containers"]:
        if c["project"] and c["project"] in projs and c["name"] not in names:
            mine.append(c)
    return mine, projs


def proc_table():
    """Every process: its parent, its memory in MB, the CPUs it uses."""
    table = {}
    for line in (try_out(["ps", "-axo", "pid=,ppid=,rss=,pcpu="], timeout=20) or "").splitlines():
        p = line.split()
        if len(p) >= 4:
            try:
                table[int(p[0])] = (int(p[1]), float(p[2]) / 1024, float(p[3].replace(",", ".")) / 100)
            except ValueError:
                continue
    return table


def tree_usage(table, root):
    """Memory (MB) and CPUs in use by a process and everything it started."""
    kids = {}
    for pid, (ppid, _, _) in table.items():
        kids.setdefault(ppid, []).append(pid)
    todo, seen = [int(root)], set()
    while todo:
        pid = todo.pop()
        if pid not in seen:
            seen.add(pid)
            todo += kids.get(pid, [])
    return sum(table[p][1] for p in seen if p in table), sum(table[p][2] for p in seen if p in table)


def meter_fake(path, leases):
    """For tests of the line itself: the machine is a JSON file, and each step says in a file what it uses now."""
    try:
        m = json.loads(read(path, "") or "{}")
    except ValueError:
        m = {}
    usage_dir = os.path.join(ledger_dir(), "fake-usage")

    def usage(name):
        try:
            u = json.loads(read(os.path.join(usage_dir, name + ".json"), "") or "{}")
        except ValueError:
            u = {}
        return {p: float(u.get(p, 0)) for p in POOLS}

    by = {lid: dict(usage(lid), projects=[]) for lid in leases}
    left = {p: 0.0 for p in POOLS}
    names = []
    for name in sorted(os.listdir(usage_dir)) if os.path.isdir(usage_dir) else []:
        if name.endswith(".json") and name[:-5] not in leases:  # still running, though the fx that held its place died
            names.append(name[:-5])
            for p, v in usage(name[:-5]).items():
                left[p] += v
    d, h = m.get("docker"), m.get("host") or {}
    total = float(h.get("total_mb", 16000))
    used_d = sum(u["docker_mb"] for u in by.values()) + float((d or {}).get("other_mb", 0)) + left["docker_mb"]
    used_h = sum(u["host_mb"] + u["docker_mb"] for u in by.values()) + float(h.get("other_mb", 0)) + left["host_mb"] \
        + left["docker_mb"] + float((d or {}).get("other_mb", 0))
    return {"at": time.time(), "cpus": int(m.get("cpus", 8)), "load1": float(m.get("load1", 0.0)),
            "host": {"total_mb": total, "avail_mb": total - used_h, "pressure": int(m.get("pressure", 0)),
                     "pressure_source": "a test's machine"},
            "docker": None if not d else {"total_mb": float(d["total_mb"]), "cpus": int(d.get("cpus", m.get("cpus", 8))),
                                          "system": "a test's machine", "used_mb": used_d, "containers": 0},
            "by_lease": by, "left": dict(left, names=names, containers=[])}


def meter_read(leases, full=True, detail=False):
    """The machine now, and what each step holding a place uses of it. full=False: only those steps, for a step that
    measures itself while it runs. detail: also every container, for fx capacity (too much to keep in the ledger)."""
    fake = os.environ.get("FACTORY_FAKE_MACHINE")
    if fake:
        return meter_fake(fake, leases)

    def of_the_steps(rows):
        found = {}
        for lid, l in leases.items():
            for c in containers_of({"containers": rows}, l.get("folders") or [], l.get("projects") or [], place=lid)[0]:
                found[c["name"]] = c
        return list(found.values())

    docker = meter_docker(None if full else of_the_steps)
    table = proc_table()
    by, counted = {}, set()
    # A container counts once: for the step that came first. A step that runs comes before a place that is only held
    # for a package being built, though: while a builder's heavy command runs in the package's clone, the clone's
    # containers are that command's, and the package's own place sees what its stack uses at rest, which is what the
    # next package is then counted at for the hours it is built.
    for lid, l in sorted(leases.items(), key=lambda kv: (bool(kv[1].get("tie")), kv[1].get("started") or 0)):
        mine, projs = containers_of(docker, l.get("folders") or [], l.get("projects") or [], place=lid)
        mine = [c for c in mine if c["name"] not in counted]
        counted.update(c["name"] for c in mine)
        rss, cpu = tree_usage(table, l["pid"]) if l.get("pid") and not l.get("tie") else (0.0, 0.0)
        by[lid] = {"docker_mb": sum(c["mem_mb"] for c in mine), "host_mb": rss, "cpu": cpu + sum(c["cpu"] for c in mine),
                   "projects": sorted(projs), "containers": [c["name"] for c in mine]}
    left = [c for c in (docker or {}).get("containers", []) if place_ours(c["place"]) and c["place"] not in leases]
    try:
        load1 = os.getloadavg()[0]
    except (OSError, AttributeError):
        load1 = 0.0
    host = meter_host() if full else {"total_mb": 0.0, "avail_mb": 0.0, "pressure": 0, "pressure_source": "not read"}
    return {"at": time.time(), "cpus": cpus_here(), "load1": load1, "host": host,
            "docker": None if not docker else dict({k: docker[k] for k in ("total_mb", "cpus", "system", "used_mb")},
                                                   containers=len(docker["containers"]),
                                                   **({"rows": docker["containers"]} if detail else {})),
            "by_lease": by,
            "left": {"docker_mb": sum(c["mem_mb"] for c in left), "host_mb": 0.0, "cpu": sum(c["cpu"] for c in left),
                     "names": [c["place"] for c in left], "containers": [c["name"] for c in left]}}


# --- places: who runs now, who waits

def place_alive(l, starts=None):
    """Does anything still hold this place? A step's place lives as long as the fx that runs it. A place held for a
    package being built outlives the fx that took it: it lives while job.json says the package is being built, the
    session driving the job is open, and tie_max_sec has not passed."""
    tie = l.get("tie")
    if not tie:
        return proc_alive(l, starts)
    try:
        job = json.loads(read(tie.get("job_file") or "", "") or "null")
    except ValueError:
        return True  # being written right now
    if tie.get("lane"):
        # A lane is held from a job's first build until the job is handed off, however long that takes and whether or
        # not its session is open: its half-done changes to the shared folders are there all that time. After the
        # hand-off it stays held until those changes are committed, or the next job would build on them unseen.
        if not isinstance(job, dict):
            return False
        if job.get("stage") not in TERMINAL:
            return (job.get("lanes") or {}).get(tie["lane"]) == l.get("id")
        return lane_paths_dirty(tie.get("factory"), tie.get("paths"))
    if time.time() - (l.get("started") or l.get("enqueued") or 0) > ledger_settings()["tie_max_sec"]:
        return False
    if not isinstance(job, dict) or job.get("stage") in TERMINAL:
        return False
    held = job.get("held_by") or {}
    if held.get("pid") and not proc_alive(held):
        return False
    p = ((job.get("split") or {}).get("packages") or {}).get(tie.get("wp") or "") or {}
    return p.get("status") == "building" and p.get("place") == l.get("id")


def ledger_reap(st):
    """Take back what nothing holds any more: the places of processes that are gone, waiters that left, ports an fx that
    died was handing out. Under the lock, by whoever looks next."""
    owners = [l for l in st["leases"].values() if not l.get("tie")] + st["queue"] + list(st["ports"].values())
    starts = proc_starts([x.get("pid") for x in owners if x.get("pid") is not None])
    gone = [lid for lid, l in st["leases"].items() if not place_alive(l, starts)]
    killed = [lid for lid in gone if not st["leases"][lid].get("tie")]  # its fx died holding it, without giving it back
    for lid in gone:
        st["leases"].pop(lid)
    t = time.time()
    if gone:
        st["reading"] = None  # what was measured with them running says nothing about now
    if killed:
        st["left_until"] = t + ledger_settings()["left_grace_sec"]  # and what they started may still be running
    st["queue"] = [q for q in st["queue"] if (q.get("kept_until") or 0) > t
                   or (not q.get("kept_until") and proc_alive(q, starts))]
    for b in [b for b, p in st["ports"].items() if not proc_alive(p, starts)]:
        st["ports"].pop(b)
    return gone


def costs_load():
    try:
        c = json.loads(read(os.path.join(ledger_dir(), "costs.json"), "") or "{}")
    except ValueError:
        c = {}
    return c if isinstance(c, dict) else {}


def cost_expected(cfg, factory, kind):
    """What a step is counted at before it has used anything: the highest of the last measurements of this kind of step
    in this factory, plus a margin, or a share of the machine until there is one. Memory by its peak, since running out
    kills a job; CPUs by what the step used on average, since being short of them only makes it slower."""
    seen = [s for s in (costs_load().get("%s|%s" % (factory or "-", kind)) or []) if isinstance(s, dict) and "seconds" in s]
    if kind == "package":
        # Up to 1.8 a builder's heavy commands ran inside its package's place, so a package was measured at the peak of
        # a whole test suite and every later package was counted at that for as long as it was built. Those
        # measurements say nothing about a package now (see cmd_run): only what was measured since counts.
        seen = [s for s in seen if s.get("at_rest")]
    seen = seen[-int(cfg["remember"]):]
    if seen:
        return {p: max(float(s.get(p, 0) or 0) for s in seen) * cfg["safety"] for p in POOLS}, "measured (%d)" % len(seen)
    guess = dict(cfg["first_guess"])
    if kind == "package":
        # A builder's own work is processes on the machine. Its stack, where the project gives each clone one, counts at
        # what it is measured to use as soon as it is up. Holding a quarter of Docker's memory for every package as well
        # made a split build open one package at a time on a machine other programs already fill.
        guess["docker_mb"] = 0
    return {"share": guess}, "a first guess: not measured on this machine yet"


def cost_learn(factory, kind, peak, seconds):
    with ledger_lock():
        c = costs_load()
        rows = c.setdefault("%s|%s" % (factory or "-", kind), [])
        rows.append(dict({p: round(float(peak.get(p, 0) or 0), 1) for p in POOLS}, seconds=round(seconds), at=int(time.time()),
                         **({"at_rest": True} if kind == "package" else {})))
        del rows[:-10]
        write_atomic(os.path.join(ledger_dir(), "costs.json"), json.dumps(c, indent=1))


def pool_capacity(cfg, r):
    d = r["docker"]
    cap = {}
    if r["host"]["total_mb"] > 0:  # a machine that does not tell its memory holds no step back for it
        cap["host_mb"] = r["host"]["total_mb"] * (1 - cfg["reserve_host"])
    cap["cpu"] = (min(r["cpus"], d["cpus"] or r["cpus"]) if d else r["cpus"]) * cfg["cpu_factor"]
    if d:
        cap["docker_mb"] = d["total_mb"] * (1 - cfg["reserve_docker"])
    return cap


def need_abs(need, cap):
    """A step's need as numbers: what was measured, or its share of each pool until it has been."""
    if isinstance((need or {}).get("share"), dict):
        return {p: cap.get(p, 0.0) * float(need["share"].get(p, 0) or 0) for p in POOLS}
    return {p: float((need or {}).get(p, 0) or 0) for p in POOLS}


def need_in(pool, n):
    """A container's memory is the machine's memory too, with or without a virtual machine in between."""
    return n.get(pool, 0.0) + (n.get("docker_mb", 0.0) if pool == "host_mb" else 0.0)


def pool_account(cfg, st, r):
    """For each pool: what it holds, and what is spoken for. A running step counts at what it is expected to reach or
    what it uses now, whichever is more; everything in use that is no step of ours counts as it is."""
    cap = pool_capacity(cfg, r)
    used = {"host_mb": r["host"]["total_mb"] - r["host"]["avail_mb"], "cpu": 0.0,
            "docker_mb": r["docker"]["used_mb"] if r["docker"] else 0.0}
    acc = {}
    # A package's place (tie) while a command of it runs: that command's place measures the package's stack as well
    # (its folders take the containers first), so the package's own place counts at what is seen of it, not again at
    # what its stack is expected to use at rest.
    commanded = {l.get("over") for l in st["leases"].values() if l.get("over")}
    for pool in cap:
        measured = promised = 0.0
        for lid, l in st["leases"].items():
            got = need_in(pool, {p: float((r["by_lease"].get(lid) or {}).get(p, 0) or 0) for p in POOLS})
            measured += got
            promised += got if l.get("tie") and lid in commanded else max(got, need_in(pool, need_abs(l.get("need"), cap)))
        others = max(0.0, used[pool] - measured) if pool != "cpu" else 0.0
        acc[pool] = {"capacity": cap[pool], "others": others, "promised": promised, "spoken_for": others + promised}
    return acc, cap


def is_big(cfg, n, cap):
    return any(cap.get(p) and need_in(p, n) > cfg["big_share"] * cap[p] for p in ("docker_mb", "host_mb"))


BUILDERS = "packages being built"  # in the names taken: how many there are, for max_builders


def builders_full(cfg, t, taken):
    """This machine was told how many packages it builds at once, and that many are being built."""
    limit = int(cfg.get("max_builders") or 0)
    return t.get("kind") == "package" and limit > 0 and int(taken.get(BUILDERS) or 0) >= limit


def place_fits(cfg, t, acc, cap, r, running, taken, left_until):
    for key in t.get("exclusive") or []:
        if key in taken:
            return False, "%s: one at a time, and %s has it" % (key.split("|")[-1], taken[key])
    if builders_full(cfg, t, taken):
        return False, "this machine builds at most %d packages at once (max_builders), and %d are being built" % (
            int(cfg["max_builders"]), taken[BUILDERS])
    n = need_abs(t.get("need"), cap)
    if not any(n.values()):
        return True, "it needs no room"
    why = ""
    pressure = r["host"]["pressure"]
    if pressure >= 2:
        why = "the system says memory is critically short (%s)" % r["host"]["pressure_source"]
    elif pressure == 1 and cfg["pressure"] == "strict":
        why = "the system says memory is short (%s)" % r["host"]["pressure_source"]
    elif pressure == 1 and cfg["pressure"] == "small" and is_big(cfg, n, cap) and \
            any(is_big(cfg, need_abs(l.get("need"), cap), cap) for l in running):
        why = "the system says memory is short (%s): one big step at a time" % r["host"]["pressure_source"]
    elif r["load1"] > r["cpus"] * cfg["load_factor"]:
        why = "load %.1f on %d CPUs" % (r["load1"], r["cpus"])
    else:
        for pool, a in acc.items():
            want = need_in(pool, n)
            if want and a["spoken_for"] + want > a["capacity"]:
                unit = "" if pool == "cpu" else " MB"
                why = "%s: it needs %.0f%s, and %.0f of %.0f%s are spoken for" % (
                    POOL_WORDS[pool], want, unit, a["spoken_for"], a["capacity"], unit)
                break
    if not why:
        return True, "it fits"
    if running:
        return False, why
    # No step of ours is running, so none will ever make room: what is in the way is someone else's, and the step
    # would have started at once before there was a line. That is also how a step larger than the machine gets its
    # turn: alone. The one thing worth waiting for is what a killed fx left running, which ends by itself.
    left = r.get("left") or {}
    wait = left_until - time.time()
    if wait > 0 and (left.get("docker_mb") or left.get("host_mb") or left.get("cpu")):
        return False, "%s; what a killed step left running is still there, so it starts anyway in %d s" % (why, wait)
    return True, "nothing else of the factory is running"


def needs_room(t):
    """Whether a ticket or a place takes any of the machine's room. One that only holds a name (a lane) takes none."""
    need = t.get("need") or {}
    need = need["share"] if isinstance(need.get("share"), dict) else need
    return any(float(v or 0) for v in need.values() if isinstance(v, (int, float)) and not isinstance(v, bool))


def place_decide(cfg, st, ticket_id, r):
    """First come, first served: each ticket ahead that fits takes its room first. One that does not fit may be overtaken
    by a smaller one behind it, until it has waited starve_sec: then nothing that takes room overtakes it. That is about
    room only. A ticket held up by a name another step has (a lane, for hours) holds nobody up, or the step that has the
    name could never finish and give it back; and a ticket that takes no room is in nobody's way. Returns (start now,
    why, how many are ahead).
    A heavy command of a package being built (over) takes its own place, so that the package's place can be counted at
    what its stack uses at rest. Such a command waits for steps that are running, like any other. It does not wait for
    places that are only held for packages being built (its own, or another's whose builder may be in this same line),
    and a step that has waited long does not hold it up: a package's place is given back when its builder is done, and
    the builder is done only once this command has run. Either wait would never end."""
    acc, cap = pool_account(cfg, st, r)
    running = [l for l in st["leases"].values() if any(need_abs(l.get("need"), cap).values())]
    taken = {k: l.get("job") or l.get("name") or l["kind"] for l in st["leases"].values() for k in l.get("exclusive") or []}
    taken[BUILDERS] = len([l for l in st["leases"].values() if l["kind"] == "package"])
    t_now, pos, starved = time.time(), 0, None
    for t in sorted(st["queue"], key=lambda q: q["seq"]):
        for_a_name = any(k in taken for k in t.get("exclusive") or []) or builders_full(cfg, t, taken)
        n = need_abs(t.get("need"), cap)
        # what will make room by itself: for a command of a place (over), neither places held for packages nor the
        # place it is a command of, which ends only after it
        ends = [l for l in running if not l.get("tie") and l.get("id") != t["over"]] if t.get("over") else running
        ok, why = place_fits(cfg, t, acc, cap, r, ends, taken, st.get("left_until") or 0)
        if ok and starved and any(n.values()) and not t.get("over"):
            ok, why = False, starved
        if t["id"] == ticket_id:
            return ok, why, pos
        if t.get("kept_until"):
            continue  # a place kept for someone who left: theirs when they come back, and it holds nothing till then
        if t_now - (t.get("seen") or t_now) > max(30, 5 * PLACE_POLL_SEC):
            continue  # its fx has not looked for a while: it does not hold the line up
        pos += 1
        if ok:
            for pool in acc:
                acc[pool]["spoken_for"] += need_in(pool, n)
            for key in t.get("exclusive") or []:
                taken[key] = t.get("job") or t.get("name") or t["kind"]
            if t["kind"] == "package":
                taken[BUILDERS] += 1
            if any(n.values()):
                running = running + [t]
        elif not starved and not for_a_name and t_now - t["enqueued"] > cfg["starve_sec"]:
            starved = "%s %s has waited %d min: nothing overtakes it" % (
                t["kind"], t.get("job") or t.get("name") or "", (t_now - t["enqueued"]) / 60)
    return False, "not in the line", pos


class PlaceWait(Exception):
    """The time this caller may wait is up and the step has not started. Its place in the line is kept."""
    def __init__(self, ahead, waited, why, kept_sec):
        super().__init__("still waiting")
        self.ahead, self.waited, self.why, self.kept_sec = ahead, waited, why, kept_sec


def place_alone(st, t):
    """Nothing else on this machine runs or waits for room: the step starts at once, and nothing needs to be measured for
    it. A ticket that only waits for a name this step does not want (another job's lane) is not in its way."""
    if time.time() < (st.get("left_until") or 0):
        return False
    if t.get("kind") == "package" and any(l["kind"] == "package" for l in st["leases"].values()):
        return False  # max_builders may have something to say: the line decides
    mine = set(t.get("exclusive") or [])
    if any(not q.get("kept_until") and (needs_room(q) or mine & set(q.get("exclusive") or [])) for q in st["queue"]):
        return False
    if mine & {k for l in st["leases"].values() for k in l.get("exclusive") or []}:
        return False
    # A package's own command is alone when only places held for packages are taken: the line would let it start
    # anyway (place_decide), so there is nothing to measure for it first either.
    return not any(needs_room(l) for l in st["leases"].values()
                   if not (t.get("over") and (l.get("tie") or l.get("id") == t["over"])))


def place_admit(st, t, t0, why):
    """waited: by this call. waited_all: since the step first asked, also when it had to leave the line and came back
    (the same command run again after `next: wait`); with waited_because and waited_behind, what it was last told while
    it waited, that is what a job's own files keep of the wait (wait_note)."""
    st["queue"] = [q for q in st["queue"] if q["id"] != t["id"]]
    now_ = time.time()
    lease = dict(t, started=now_, waited=round(now_ - t0, 1), waited_all=round(max(now_ - t0, now_ - t["enqueued"]), 1),
                 waited_because=t.get("why"), waited_behind=t.get("behind"), admitted_because=why, samples=0, cpu_sum=0.0,
                 peak={p: 0.0 for p in POOLS})
    for key in ("seen", "why", "behind"):
        lease.pop(key, None)
    st["leases"][t["id"]] = lease
    return lease


def place_holders(st, but=None, limit=4):
    """The steps that hold room on this machine now, in a few words each: what a step that waits is waiting behind."""
    rows = []
    for l in sorted(st["leases"].values(), key=lambda l: l.get("started") or 0):
        if l.get("id") == but or not needs_room(l):
            continue
        what = "package %s of %s" % (l.get("name"), l.get("job")) if l["kind"] == "package" else \
            ("%s %s" % (l["kind"], l.get("job") or l.get("name") or "")).strip()
        rows.append(what + (" (%s)" % os.path.basename(l["factory"]) if l.get("factory") else ""))
    return rows[:limit] + (["and %d more" % (len(rows) - limit)] if len(rows) > limit else [])


def place_note(st, r):
    """Every reading leaves its mark on the places it measured: the only measurements a package's place ever gets, since
    no fx runs while its builder works."""
    for lid, l in st["leases"].items():
        m = (r.get("by_lease") or {}).get(lid)
        if not m:
            continue
        peak = l.setdefault("peak", {p: 0.0 for p in POOLS})
        for p in ("docker_mb", "host_mb"):
            peak[p] = max(float(peak.get(p, 0) or 0), float(m.get(p, 0) or 0))
        l["cpu_sum"] = float(l.get("cpu_sum") or 0) + float(m.get("cpu", 0) or 0)
        l["samples"] = int(l.get("samples") or 0) + 1
        if m.get("projects") and set(m["projects"]) - set(l.get("projects") or []):
            l["projects"] = sorted(set(l.get("projects") or []) | set(m["projects"]))


def place_leave(ticket_id, cfg, keep):
    """Out of the line. keep: the place stays this caller's for a while, for when the same step asks again."""
    with ledger_lock():
        st = ledger_load()
        pos = 0
        for q in sorted(st["queue"], key=lambda q: q["seq"]):
            if q["id"] == ticket_id:
                break
            pos += 0 if q.get("kept_until") else 1
        if keep:
            for q in st["queue"]:
                if q["id"] == ticket_id:
                    q["kept_until"] = time.time() + cfg["place_kept_sec"]
        else:
            st["queue"] = [q for q in st["queue"] if q["id"] != ticket_id]
        if st["leases"].pop(ticket_id, None):
            st["reading"] = None
        ledger_save(st)
    return pos


def stop_left_behind(r):
    """Containers started for a step with its place on them (ZAP, by fx itself) whose fx was killed: nobody else will
    stop them. Only what is surely this ledger's and surely no step's: the place carries this ledger's id, and the
    ledger is asked again now, since a step may have started while the machine was being measured."""
    left = r.get("left") or {}
    pairs = [(n, p) for n, p in zip(left.get("containers") or [], left.get("names") or []) if n and place_ours(p)]
    if not pairs or os.environ.get("FACTORY_FAKE_MACHINE"):
        return
    with ledger_lock():
        st = ledger_load()
        live = set(st["leases"]) | {q["id"] for q in st["queue"]}
    names = [n for n, p in pairs if p not in live]
    if names:
        try_out(["docker", "stop", "-t", "5"] + names, timeout=60)


def place_take(kind, job=None, factory=None, name=None, need=None, exclusive=(), folders=(), tie=None, max_wait=None,
               on_wait=None, over=None, seq=None):
    """Wait for a place on this machine and take it. need: what the step uses, when the caller knows; else what this
    kind of step used here before. exclusive: names only one running step may hold. max_wait: give up after this many
    seconds with PlaceWait, the place in the line kept for place_kept_sec, so that the same step (same factory, job,
    kind and name) asking again goes back to where it was; 0 asks once. tie: see place_alive. over: this is a heavy
    command of a package being built, and that is the package's own place (see place_decide). seq: where in the line
    it stands, when it goes on from a place it had (the next phase of a gate): ahead of every step that asked after."""
    cfg = ledger_settings()
    t = dict(proc_me(), id=secrets.token_hex(6), kind=kind, job=job, factory=factory, name=name,
             exclusive=sorted(set(exclusive)), folders=sorted({os.path.realpath(f) for f in folders if f}),
             enqueued=time.time(), seen=time.time(), session=(session_me() or {}).get("session"), tie=tie)
    if over:
        t["over"] = over
    t0 = time.time()
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
        t["id"] = "%s-%s" % (st["id"], t["id"])
        if need:
            t["need"], t["need_source"] = {p: float(need.get(p, 0) or 0) for p in POOLS}, "given"
        else:
            t["need"], t["need_source"] = cost_expected(cfg, factory, kind)
        same = [q for q in st["queue"] if q.get("kept_until") and (job or name) and
                (q.get("factory"), q.get("job"), q["kind"], q.get("name")) == (factory, job, kind, name)]
        if same:  # the same step, back after it had to leave: its place and the time it has waited are still its own
            st["queue"] = [q for q in st["queue"] if q["id"] != same[0]["id"]]
            t["seq"], t["enqueued"] = same[0]["seq"], same[0]["enqueued"]
            t.update({k: same[0][k] for k in ("why", "behind") if same[0].get(k)})  # and what it was told while it waited
        elif isinstance(seq, int) and not isinstance(seq, bool):
            t["seq"] = seq
        else:
            st["seq"] += 1
            t["seq"] = st["seq"]
        if place_alone(st, t):
            lease = place_admit(st, t, t0, "nothing else of the factory is running")
            lease["cpus"] = place_cpus(cfg, st, lease["id"], None)
            ledger_save(st)
            return lease
        st["queue"].append(t)
        ledger_save(st)
    said, roomy = 0.0, needs_room(t)
    try:
        while True:
            # A step that gives its place back wipes the reading, so room that was made is seen at once. Between such
            # moments a long wait measures less often: measuring every container costs the machine something too.
            age = cfg["reading_max_age"] * (1 if time.time() - t0 < 60 else 3)
            with ledger_lock():
                st = ledger_load()
                old = st.get("reading")
                stale = not old or time.time() - old["at"] > age \
                    or not set(st["leases"]) <= set(old.get("by_lease") or {})
                if old and not roomy:
                    stale = False  # it waits for a name (a lane, for hours), not for room: no need to measure for it
                leases = dict(st["leases"])
            r = meter_read(leases) if stale else None  # the slow part, outside the lock
            with ledger_lock():
                st = ledger_load()
                ledger_reap(st)
                if r and (not st.get("reading") or st["reading"]["at"] < r["at"]):
                    st["reading"] = r
                    place_note(st, r)
                cur = st.get("reading") or r
                mine = [q for q in st["queue"] if q["id"] == t["id"]]
                if not mine:  # this fx was thought gone (a machine asleep): back in, where it was
                    st["queue"].append(t)
                    mine = [t]
                mine[0]["seen"] = time.time()
                mine[0].pop("kept_until", None)
                ok, why, pos = place_decide(cfg, st, t["id"], cur) if cur else (False, "the machine is being measured", 0)
                if ok:
                    lease = place_admit(st, mine[0], t0, why)
                    lease["cpus"] = place_cpus(cfg, st, lease["id"], cur)
                    ledger_save(st)
                    return lease
                if cur:  # kept on the ticket: the job's own files get it once the step starts (wait_note)
                    mine[0].update(why=why, behind=place_holders(st) if roomy else [])
                ledger_save(st)
            if cur and (cur.get("left") or {}).get("containers"):
                stop_left_behind(cur)
            waited = time.time() - t0
            if max_wait is not None and waited >= max_wait:
                place_leave(t["id"], cfg, True)
                raise PlaceWait(pos, time.time() - t["enqueued"], why, cfg["place_kept_sec"])
            if on_wait and time.time() - said >= 30:
                said = time.time()
                on_wait(pos, why, time.time() - t["enqueued"])
            time.sleep(PLACE_POLL_SEC if waited < 60 else max(PLACE_POLL_SEC, min(5.0, PLACE_POLL_SEC * 2.5)))
    except PlaceWait:
        raise
    except BaseException as e:
        # Stopped while waiting (a tool's time limit sends SIGTERM): the place is kept, for the same command run again.
        place_leave(t["id"], cfg, isinstance(e, (SystemExit, KeyboardInterrupt)))
        raise


def place_cpus(cfg, st, lease_id, r):
    """How many CPUs a step that starts now may use: the CPUs the machine (and Docker, when it has fewer) gives, less what
    the other running steps of the factory are counted at. Alone it gets them all; two gates side by side get about
    half each. Never less than one. Set once, when the step starts. The project's commands get it as FACTORY_CPUS (for
    Playwright's --workers, a test runner's -j), and ZAP runs with it as --cpus: without that, one scan took every CPU
    it saw (9.5 of 10 measured) and whatever ran beside it crawled."""
    total = max(1, int(cpus_here()))
    if not r:
        return total
    d = r.get("docker") or {}
    total = max(1, min(total, int(r.get("cpus") or total), int(d.get("cpus") or total)))
    others = dict(st, leases={k: v for k, v in st["leases"].items() if k != lease_id})
    try:
        acc, _cap = pool_account(cfg, others, r)
    except (KeyError, TypeError, ValueError):
        return total
    if "cpu" not in acc:
        return total
    return max(1, min(total, int(acc["cpu"]["capacity"] - acc["cpu"]["promised"])))


def place_cpus_now():
    """FACTORY_CPUS for what this fx starts now: what its innermost place was given, or None outside a place."""
    if not _PLACES:
        return None
    n = _PLACES[-1].lease.get("cpus")
    return int(n) if isinstance(n, (int, float)) and not isinstance(n, bool) and n >= 1 else max(1, int(cpus_here()))


def place_release(lease_id):
    """Give a place back. Returns it as the ledger had it (with what was measured of it), or None."""
    with ledger_lock():
        st = ledger_load()
        lease = st["leases"].pop(lease_id, None)
        if lease:
            st["reading"] = None  # room was made: the next one to look measures again
        st["queue"] = [q for q in st["queue"] if q["id"] != lease_id]
        ledger_save(st)
    return lease


def place_learn(lease, peak=None, cpu=None, samples=None):
    """Remember what this kind of step used, for the next one. Nothing is learned from a step nobody measured."""
    peak = peak if peak is not None else lease.get("peak") or {}
    samples = samples if samples is not None else int(lease.get("samples") or 0)
    if not samples:
        return
    cpu = cpu if cpu is not None else float(lease.get("cpu_sum") or 0) / samples
    if not (float(peak.get("docker_mb", 0) or 0) or float(peak.get("host_mb", 0) or 0) or cpu):
        return  # nothing of it was seen (no container, no process of fx's): that is not the same as using nothing
    cost_learn(lease.get("factory"), lease["kind"], {"docker_mb": peak.get("docker_mb", 0), "host_mb": peak.get("host_mb", 0),
                                                    "cpu": cpu}, time.time() - (lease.get("started") or time.time()))


class Place:
    """A step's place while it runs. count: False when the step stopped before its real work, so that what it used says
    nothing about the next one."""
    def __init__(self, lease):
        self.lease, self.count, self.samples, self.cpu_sum = lease, True, 0, 0.0
        self.peak = {p: 0.0 for p in POOLS}
        self.waited = lease.get("waited") or 0
        self.also = None  # a process whose use counts for this place too
        self.names = set()  # the containers seen with this step so far, by name: see StopsWatch

    def sample(self):
        lid = self.lease["id"]
        m = meter_read({lid: self.lease}, full=False)["by_lease"][lid]
        self.names.update(m.get("containers") or [])
        rss, cpu = tree_usage(proc_table(), self.also) if self.also and not os.environ.get("FACTORY_FAKE_MACHINE") else (0.0, 0.0)
        self.peak["docker_mb"] = max(self.peak["docker_mb"], float(m.get("docker_mb", 0) or 0))
        self.peak["host_mb"] = max(self.peak["host_mb"], float(m.get("host_mb", 0) or 0) + rss)
        self.cpu_sum += float(m.get("cpu", 0) or 0) + cpu
        self.samples += 1
        if set(m.get("projects") or []) - set(self.lease.get("projects") or []):
            # Compose projects once seen with this step stay its own, also while none of their containers mounts its folder.
            self.lease["projects"] = sorted(set(self.lease.get("projects") or []) | set(m["projects"]))
            with ledger_lock():
                st = ledger_load()
                if lid in st["leases"]:
                    st["leases"][lid]["projects"] = self.lease["projects"]
                    ledger_save(st)


_PLACES = []  # the places this fx holds now, innermost last
_AWAKE = []


def keep_awake():
    """macOS: no idle sleep while this fx runs a long step, or the step's time limits run out while nothing runs. The
    helper ends by itself when this fx does."""
    if _AWAKE or sys.platform != "darwin" or os.environ.get("FACTORY_FAKE_MACHINE") or not shutil.which("caffeinate"):
        return
    try:
        _AWAKE.append(subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())], stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    except OSError:
        pass


def sample_sec():
    try:
        return float(os.environ.get("FACTORY_SAMPLE_SEC") or 10)
    except ValueError:
        return 10.0


_MAX_WAIT = [None]


def max_wait_asked():
    """--max-wait, or FACTORY_MAX_WAIT: how long this command may wait for a place before it answers `next: wait`."""
    if _MAX_WAIT[0] is not None:
        return max(0.0, float(_MAX_WAIT[0]))
    raw = os.environ.get("FACTORY_MAX_WAIT")
    try:
        return max(0.0, float(raw)) if raw not in (None, "") else None
    except ValueError:
        return None


WAIT_NOTED_SEC = 1.0  # a step that started within this did not wait: there is nothing to keep


def job_real_id(job):
    """The job a clone belongs to: a package's or a candidate's stand-in for a job (wp_pseudo_job, candidate_job) carries
    an id of its own for ports and database names, and has no folder under jobs/."""
    return job.get("of") or job["id"]


def wait_note(ctx, job, kind, name, lease):
    """A step of this job waited for room on this machine, or for a lane another job holds: how long, since when and why
    go into its job.json (waits), where the board and fx status read where the job's hours went. Before this the wait
    was nowhere: a step is put on the board only once it has its place. Never a reason to fail the step. Returns the
    row, or None when the step did not wait."""
    waited = float(lease.get("waited_all") or lease.get("waited") or 0)
    if waited < WAIT_NOTED_SEC or not (job or {}).get("id"):
        return None
    started = float(lease.get("started") or time.time())
    row = {"step": kind, "asked": iso_of(started - waited), "started": iso_of(started), "waited_sec": round(waited),
           "why": str(lease.get("waited_because") or lease.get("admitted_because") or "")[:300]}
    if name:
        row["name"] = name
    if lease.get("waited_behind"):
        row["behind"] = list(lease["waited_behind"])[:5]
    try:
        job_note(ctx, job_real_id(job), lambda j: j.setdefault("waits", []).append(row))
    except Exception:  # noqa: BLE001 - what is kept of a wait never stops the step that waited
        pass
    return row


def waits_of(job, limit=3):
    """How long this job's steps waited for room in all, in minutes, and its longest waits: for fx status."""
    rows = [w for w in job.get("waits") or [] if isinstance(w, dict) and isinstance(w.get("waited_sec"), (int, float))]
    if not rows:
        return None
    longest = sorted(rows, key=lambda w: -w["waited_sec"])[:limit]
    return {"minutes": round(sum(w["waited_sec"] for w in rows) / 60, 1), "times": len(rows),
            "longest": [{"step": ("%s %s" % (w.get("step"), w.get("name") or "")).strip(),
                         "minutes": round(w["waited_sec"] / 60, 1), "seconds": round(w["waited_sec"]),
                         "why": w.get("why") or "", "behind": w.get("behind") or [], "at": w.get("asked")}
                        for w in longest]}


@contextlib.contextmanager
def step_place(ctx, kind, job=None, folders=None, exclusive=(), name=None, max_wait=None, need=None, over=None, seq=None,
               wait_all=False, noted_as=None):
    """Wait for room on this machine, hold it while the step runs, and remember what the step used. The only step on the
    machine starts at once and nothing is measured before it does: with one job, nothing changes. over: the place of
    the package this is a command of; seq: its place in the line (see place_take). wait_all: wait as long as it takes,
    whatever --max-wait says (a step that has begun and cannot be left half done). noted_as: (step, name) a wait is
    kept under in the job, when not the kind and name of the place (a gate's phases are the gate's waits)."""
    factory = ctx.factory if ctx else None
    if folders is None:
        folders = [job.get("worktree"), ctx.job_dir(job["id"])] if job and ctx else []
    who = "%s %s" % (kind, (job or {}).get("id") or name or "")

    def waiting(pos, why, secs):
        hint("%s waits for room on this machine (%d min so far, %d ahead): %s" % (who.strip(), secs / 60, pos, why))

    lease = place_take(kind, job=(job or {}).get("id"), factory=factory, name=name, need=need, exclusive=exclusive,
                       folders=folders, on_wait=waiting, over=over, seq=seq,
                       max_wait=None if wait_all else max_wait if max_wait is not None else max_wait_asked())
    if job and ctx:
        wait_note(ctx, job, *(noted_as or (kind, name)), lease=lease)
    place = Place(lease)
    _PLACES.append(place)
    keep_awake()
    stop = threading.Event()
    every = sample_sec()

    def sampler():
        while not stop.wait(every):
            try:
                place.sample()
            except Exception:  # noqa: BLE001 - measuring never stops the step
                pass

    th = threading.Thread(target=sampler, daemon=True) if every > 0 else None
    if th:
        th.start()
    try:
        yield place
    finally:
        stop.set()
        if th:
            th.join(timeout=120)
        if place in _PLACES:
            _PLACES.remove(place)
        place_release(lease["id"])
        if place.count and place.samples:
            try:
                place_learn(lease, place.peak, place.cpu_sum / place.samples, place.samples)
            except (OSError, FxError):
                pass


def place_refusal(e, what):
    """PlaceWait as fx's answer: not a failure, and the same command run again goes back to its place in the line."""
    return FxError("%s is waiting for room on this machine, %d ahead of it: %s. Nothing failed: run the same command "
                   "again (its place in the line is kept for %d minutes)" % (what, e.ahead, e.why, e.kept_sec / 60),
                   code=EXIT_WAIT, extra={"next": "wait", "ahead": e.ahead, "waited_sec": round(e.waited), "why": e.why})


@contextlib.contextmanager
def job_step(ctx, job, kind, board=None, busy=None, **kw):
    """One long step of a job: no other long step of the same job beside it, a place on the machine, and on the board
    from the moment it really starts."""
    with job_busy(ctx, job, busy or board or kind):
        try:
            with step_place(ctx, kind, job, **kw) as place:
                if board:
                    mark_step(ctx, job["id"], board, True, only_one=True, lease=place.lease)
                try:
                    yield place
                finally:
                    if board:
                        mark_step(ctx, job["id"], board, False, getattr(place, "result", None))
        except PlaceWait as e:
            raise place_refusal(e, "%s of %s" % (busy or board or kind, job["id"]))


# --- what a person, or the orchestrator, can see and set

def work_dir_of(factory):
    root = (factory_settings(factory).get("work_dir") or "../{factory}-work").replace("{factory}", os.path.basename(factory))
    return os.path.normpath(os.path.join(factory, os.path.expanduser(root)))


def clone_owner(factory, name):
    """Whose clone a folder of the work folder is, and why its containers have no reason to run any more (or None)."""
    m = re.match(r"^(.*?)(?:--(wp\d+)|-c(\d+))?$", name)
    job_id, wp = m.group(1), m.group(2)
    try:
        job = json.loads(read(os.path.join(factory, "jobs", job_id, "job.json"), "") or "null")
    except ValueError:
        return job_id, None
    if not isinstance(job, dict):
        return name, None  # not a job's (a sandbox, a reading clone): fx stops those itself
    if job.get("stage") in TERMINAL:
        return job_id, "the job is over (%s)" % job["stage"]
    if wp:
        p_ = ((job.get("split") or {}).get("packages") or {}).get(wp) or {}
        if p_.get("status") == "integrated":
            return job_id, "package %s is merged" % wp
    return job_id, None


def left_containers(rows):
    """Containers of the factories' clones that nothing needs any more: the clone is gone, the job is over, the package
    is merged. Nobody stops them by themselves, and each holds memory and ports."""
    found = []
    for f in known_factories():
        work = work_dir_of(f)
        for c in rows or []:
            spots = [p for p in [c["workdir"]] + c["mounts"] if path_under(p, work) and p != work]
            if not spots:
                continue
            name = os.path.relpath(spots[0], work).split(os.sep)[0]
            if not os.path.isdir(os.path.join(work, name)):
                why, job_id = "its clone %s is gone" % name, name
            else:
                job_id, why = clone_owner(f, name)
            if why:
                found.append({"container": c["name"], "compose_project": c["project"] or None, "clone": name, "job": job_id,
                              "factory": os.path.basename(f), "memory_mb": round(c["mem_mb"]), "why": why})
    return found


def job_stacks(rows):
    """What each clone's containers hold right now, by job: a job that waits for a person still holds its stack."""
    found = []
    for f in known_factories():
        work, by = work_dir_of(f), {}
        for c in rows or []:
            spots = [p for p in [c["workdir"]] + c["mounts"] if path_under(p, work) and p != work]
            if spots:
                by.setdefault(os.path.relpath(spots[0], work).split(os.sep)[0], []).append(c)
        for name, cs in sorted(by.items()):
            job_id = clone_owner(f, name)[0]
            try:
                job = json.loads(read(os.path.join(f, "jobs", job_id, "job.json"), "") or "null") or {}
            except ValueError:
                job = {}
            found.append({"clone": name, "factory": os.path.basename(f), "containers": len(cs),
                          "memory_mb": round(sum(c["mem_mb"] for c in cs)), "job_stage": job.get("stage"),
                          "waits_for_a_person": job.get("stage") == "needs-info" or None})
    return found


def biggest_programs(limit=6):
    """What else uses this machine's memory, by program: the room the factory gets is what they leave."""
    apps = {}
    for line in (try_out(["ps", "-axo", "rss=,comm="], timeout=20) or "").splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            m = re.search(r"/([^/]+)\.app/", parts[1])
            name = m.group(1) if m else os.path.basename(parts[1].strip())
            apps[name] = apps.get(name, 0) + int(parts[0]) / 1024
    top = sorted(apps.items(), key=lambda kv: -kv[1])[:limit]
    return [{"program": n, "memory_mb": round(v)} for n, v in top if v >= 100]


def capacity_data(ctx=None):
    cfg = ledger_settings()
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
        ledger_save(st)
    r = meter_read(st["leases"], detail=True)
    rows = ((r.get("docker") or {}).pop("rows", None)) or []
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
        st["reading"] = r
        place_note(st, r)
        ledger_save(st)
    acc, cap = pool_account(cfg, st, r)
    t = time.time()

    def nums(d):
        return {p: round(float(d.get(p, 0) or 0), 1) for p in POOLS if p in cap}

    def who(x):
        return {"step": x["kind"], "job": x.get("job"), "name": x.get("name"),
                "factory": os.path.basename(x["factory"]) if x.get("factory") else None,
                "session": session_word(x) or None}

    def waited(l):
        """How long a step that runs now had waited for its place, and what for; nothing when it started at once."""
        secs = float(l.get("waited_all") or l.get("waited") or 0)
        if secs < WAIT_NOTED_SEC:
            return {}
        return {"waited_sec": round(secs), "waited_because": l.get("waited_because") or None}

    running = [dict(who(l), for_min=round((t - (l.get("started") or t)) / 60, 1), counted_at=nums(need_abs(l.get("need"), cap)),
                    counted_from=l.get("need_source"), uses_now=nums(r["by_lease"].get(lid) or {}),
                    held_for_a_package=bool(l.get("tie")) or None, **waited(l))
               for lid, l in sorted(st["leases"].items(), key=lambda kv: kv[1].get("started") or 0)]
    waiting = []
    for q in sorted(st["queue"], key=lambda q: q["seq"]):
        ok, why, pos = place_decide(cfg, st, q["id"], r)
        waiting.append(dict(who(q), for_min=round((t - q["enqueued"]) / 60, 1), ahead=pos, needs=nums(need_abs(q.get("need"), cap)),
                            why="its turn is next" if ok else why, left_the_line_for_now=bool(q.get("kept_until")) or None))
    mine = "%s|" % ctx.factory if ctx and ctx.cfg else None
    measured = {}
    for key, seen in sorted(costs_load().items()):
        factory, _, kind = key.rpartition("|")
        seen = [x for x in seen or [] if isinstance(x, dict) and "seconds" in x and (kind != "package" or x.get("at_rest"))]
        if seen and (not mine or key.startswith(mine)):
            need, source = cost_expected(cfg, factory, kind)
            measured.setdefault(os.path.basename(factory) or "-", {})[kind] = dict(
                nums(need), runs=len(seen), minutes=round(max(float(x.get("seconds", 0) or 0) for x in seen) / 60, 1))
    own = {k: v for k, v in cfg.items() if v != MACHINE_DEFAULTS[k]}
    host, docker = r["host"], r["docker"]
    res = {"ok": True,
           "machine": {"cpus": r["cpus"], "load": round(r["load1"], 1), "memory_mb": round(host["total_mb"]),
                       "memory_to_be_had_mb": round(host["avail_mb"]), "memory": PRESSURE_WORDS[host["pressure"]],
                       "memory_said_by": host["pressure_source"],
                       "docker": None if not docker else {"given_mb": round(docker["total_mb"]), "cpus": docker["cpus"],
                                                          "in_use_mb": round(docker["used_mb"]),
                                                          "containers": docker["containers"], "system": docker["system"]}},
           "room": {p: {"holds": round(a["capacity"], 1), "others_use": round(a["others"], 1),
                        "factory_steps": round(a["promised"], 1), "free": round(a["capacity"] - a["spoken_for"], 1)}
                    for p, a in acc.items()},
           "running": running, "waiting": waiting,
           "a_step_not_measured_yet_counts_as": nums(need_abs({"share": cfg["first_guess"]}, cap)),
           "measured_here": measured,
           "ports": sorted({"%d-%d" % (b, b + w - 1): who_ for b, w, who_ in ports_held(ctx)}.items()),
           "biggest_programs": biggest_programs(),
           "stacks": job_stacks(rows),
           "left_running": left_containers(rows),
           "settings": own, "settings_file": ledger_settings_path()}
    notes = []
    if host["pressure"]:
        notes.append("the system says memory is %s: %s" % (PRESSURE_WORDS[host["pressure"]], {
            "small": "big steps wait for each other, smaller ones still start when there is room",
            "strict": "no second step starts", "critical": "this is only acted on when it says critical"}[cfg["pressure"]]
            if host["pressure"] == 1 else "no second step starts"))
    if res["left_running"]:
        notes.append("%d container(s) of clones that are gone or of jobs that are over still run and hold %d MB: `%s "
                     "cleanup --stale` lists them, and stops them with --yes" % (
                         len(res["left_running"]), sum(c["memory_mb"] for c in res["left_running"]), FX_CMD))
    if not measured:
        notes.append("no step was measured on this machine yet: until one was, each counts as a share of the machine")
    if host["total_mb"] <= 0:
        notes.append("this machine does not tell how much memory it has, so no step is held back for memory here; steps "
                     "still wait for CPUs%s" % (" and for Docker's memory" if docker else ""))
    res["notes"] = notes
    return res


def cmd_capacity(ctx, a):
    """What this machine has, who uses it, who waits and why; and this machine's own settings."""
    if a.set or a.reset:
        path = ledger_settings_path()
        try:
            own = json.loads(read(path, "") or "{}")
        except ValueError:
            own = {}
        own = own if isinstance(own, dict) else {}
        for key in a.reset or []:
            own.pop(key, None)
        for item in a.set or []:
            key, sep, raw = item.partition("=")
            key = key.strip()
            try:
                value = json.loads(raw)
            except ValueError:
                value = raw.strip()
            if "." in key:  # first_guess.cpu=0.2
                key, part = key.split(".", 1)
                value = dict(own.get(key) or {}, **{part: value}) if isinstance(MACHINE_DEFAULTS.get(key), dict) else value
            why = "write it as name=value" if not sep else machine_setting_problem(key, value)
            if why:
                raise FxError("%s: %s" % (item, why), code=3)
            own[key] = value
        write_atomic(path, json.dumps(own, indent=1) + "\n")
    out(capacity_data(ctx))


def cmd_run(ctx, a):
    """Run a heavy command of an agent through the machine's line: a whole test suite, a build, a browser run. With a
    job it runs in the job's clone (or a package's, a candidate's) with that clone's own port, database name and id, and
    without fx's credentials. What it prints is the command's own output; fx adds one line at the end.
    A package's command takes a place of its own too, learned under its own kind (package-run). Up to 1.8 it ran inside
    the package's place, and the package was then counted at the peak of whatever its builder ran, for all the hours it
    was built: other jobs' steps waited for room nothing was using."""
    cmd = list(a.command or [])
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    if not cmd:
        raise FxError("give the command after --, like: fx run <job> -- npm test", code=3)
    job, cwd, env, folders, held = None, None, None, [], None
    if a.job:
        if not ctx or not ctx.cfg:
            raise FxError("a job needs its factory repository: run this from there, or leave the job out", code=3)
        job = ctx.load(a.job)
        who = job
        if a.wp:
            if a.wp not in ((job.get("split") or {}).get("packages") or {}):
                raise FxError("no package %s in %s" % (a.wp, job["id"]))
            who = wp_pseudo_job(ctx, job, a.wp)
            held = job["split"]["packages"][a.wp].get("place")
        elif a.candidate:
            who = candidate_job(ctx, job, a.candidate)
        cwd = who["worktree"]
        if not os.path.isdir(cwd):
            raise FxError("the clone %s is missing" % cwd, code=3)
        if runs_checks_script(ctx, job, cmd, cwd):
            raise checks_script_refusal(job, a.wp, a.candidate)
        env = checks_env(ctx, who)
        folders = [cwd, ctx.job_dir(job["id"])]
    name = None if job else (a.name or os.path.basename(cmd[0]))
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
        over = held if held and held in st["leases"] else None  # the place of the package this is a command of
    try:
        with step_place(ctx, a.kind or ("package-run" if a.wp else "run"), job, folders=folders,
                        name=name if not job else (a.wp or None),
                        exclusive=["run|%s" % a.only_one] if a.only_one else (),
                        max_wait=a.wait if a.wait is not None else (max_wait_asked() if max_wait_asked() is not None
                                                                    else ledger_settings()["agent_wait_sec"]),
                        need=parse_need(a.need), over=over) as place:
            waited = place.waited
            env = dict(os.environ if env is None else env)
            env["FACTORY_PLACE"] = place.lease["id"]
            env["FACTORY_CPUS"] = str(place_cpus_now())
            t1 = time.time()
            proc = subprocess.Popen(cmd, cwd=cwd, env=env, start_new_session=hasattr(os, "killpg"))
            try:
                code = proc.wait()
            except BaseException:
                kill_group(proc) if hasattr(os, "killpg") else proc.kill()
                raise
            if place.samples == 0 and sample_sec() > 0 and code == 0:
                try:
                    place.sample()  # too short to have been measured: once, now, so that the next one is not a guess
                except Exception:  # noqa: BLE001
                    pass
    except PlaceWait as e:
        raise place_refusal(e, "this command")
    if over:
        package_at_rest(over)
    sys.stdout.flush()
    if a.report:
        lease = place.lease
        write_atomic(a.report, json.dumps({
            "exit": code, "waited_sec": round(waited, 2), "ran_sec": round(time.time() - t1, 2), "of_a_package": bool(over),
            "kind": lease.get("kind"), "need": lease.get("need"), "need_source": lease.get("need_source"),
            "why": lease.get("admitted_because"), "peak": place.peak, "samples": place.samples}) + "\n")
    hint("fx run: exit %d after %d s%s" % (code, time.time() - t1, ", waited %d s for room" % waited if waited >= 1 else ""))
    if code:
        sys.exit(code if 0 < code < 256 else 1)


def package_at_rest(lease_id):
    """Right after a builder's heavy command ended: what the package's stack uses now that it rests, noted on the
    package's own place. No fx runs at any other time of a build, so this, and what other steps see of it while they
    wait in the line (place_note), is all a package's place is ever measured by. Measuring never fails the command."""
    if sample_sec() <= 0:
        return
    try:
        with ledger_lock():
            lease = ledger_load()["leases"].get(lease_id)
        if not lease:
            return
        m = meter_read({lease_id: lease}, full=False)["by_lease"][lease_id]
        with ledger_lock():
            st = ledger_load()
            l = st["leases"].get(lease_id)
            if l:
                peak = l.setdefault("peak", {p: 0.0 for p in POOLS})
                for p in ("docker_mb", "host_mb"):
                    peak[p] = max(float(peak.get(p, 0) or 0), float(m.get(p, 0) or 0))
                l["cpu_sum"] = float(l.get("cpu_sum") or 0) + float(m.get("cpu", 0) or 0)
                l["samples"] = int(l.get("samples") or 0) + 1
                ledger_save(st)
    except Exception:  # noqa: BLE001
        pass


def parse_need(text):
    need = {}
    for part in (text or "").split(","):
        k, sep, v = part.partition("=")
        if sep:
            if k.strip() not in POOLS:
                raise FxError("--need takes %s, like docker_mb=2000,cpu=2" % ", ".join(POOLS), code=3)
            try:
                need[k.strip()] = float(v)
            except ValueError:
                raise FxError("--need %s: not a number" % part, code=3)
    return need or None


# --- lanes: work that must not overlap between jobs, because of what they share in the factory repository

LANE_NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,30}$")


def lanes_of(ctx):
    """factory.json → lanes: [{"name": "ui", "surfaces": ["ui"], "paths": ["qa"], "why": "..."}]. A job with one of the
    surfaces takes the lane when its build starts and keeps it until it is handed off; another such job does its intake
    and spec and then waits. paths: the folders of the factory repository those jobs change (a test suite, reference
    images), which the lane is there to protect."""
    raw = ctx.c("lanes") or []
    ok = isinstance(raw, list) and all(
        isinstance(l, dict) and isinstance(l.get("name"), str) and LANE_NAME_RE.match(l["name"])
        and isinstance(l.get("surfaces"), list) and l["surfaces"] and all(isinstance(x, str) for x in l["surfaces"])
        and isinstance(l.get("paths", []), list) and all(isinstance(x, str) and x and not os.path.isabs(x)
                                                         and ".." not in x.split("/") for x in l.get("paths", []))
        for l in raw)
    if not ok or len({l["name"] for l in raw}) != len(raw):
        raise FxError('lanes in factory.json must be a list of {"name": "ui", "surfaces": ["ui"], "paths": ["<a folder of '
                      'the factory repository>"], "why": "..."} with different names, not %s' % json.dumps(raw)[:200], code=3)
    return raw


def lane_key(factory, name):
    return "%s|lane:%s" % (factory, name)


def lane_paths_dirty(factory, paths):
    if not factory or not paths or not os.path.isdir(factory):
        return False
    r = git(["status", "--porcelain", "--"] + list(paths), factory, check=False)
    return r.returncode == 0 and bool(r.stdout.strip())


def lane_holders(ctx):
    """{lane name: the place that holds it} in this factory, as the ledger has it now."""
    with ledger_lock():
        st = ledger_load()
        if ledger_reap(st):
            ledger_save(st)
    held = {}
    for l in st["leases"].values():
        for key in l.get("exclusive") or []:
            if key.startswith(lane_key(ctx.factory, "")):
                held[key.rsplit(":", 1)[1]] = l
    return held


def lane_take(ctx, job, wait=False):
    """The lanes this job needs and does not hold yet. Returns the names taken now. Raises (exit 75, next: wait-lane) when
    another job has one: the job waits where it is, and nothing of it is lost."""
    need = [l for l in lanes_of(ctx) if set(l["surfaces"]) & set(job.get("surfaces") or [])]
    if not need or job.get("stage") in TERMINAL:
        return []
    held, taken = lane_holders(ctx), []
    for lane in need:
        name = lane["name"]
        mine = (job.get("lanes") or {}).get(name)
        if mine and (held.get(name) or {}).get("id") == mine:
            continue
        try:
            lease = place_take("lane", job=job["id"], factory=ctx.factory, name=name, need={"cpu": 0},
                               exclusive=[lane_key(ctx.factory, name)], max_wait=max_wait_asked() if wait else 0,
                               on_wait=lambda pos, why, secs: hint("%s waits for the %s lane (%d min so far): %s"
                                                                   % (job["id"], name, secs / 60, why)))
        except PlaceWait as e:
            holder = (lane_holders(ctx).get(name) or {}).get("job") or "another job"
            raise FxError("%s works on %s, and so does %s, which started first: %s. %s goes on when %s is handed off and "
                          "what it changed there is committed. Nothing failed, and its intake and spec stay as they are"
                          % (job["id"], "/".join(lane["surfaces"]), holder,
                             lane.get("why") or "they share files in the factory repository", job["id"], holder),
                          code=EXIT_WAIT, extra={"next": "wait-lane", "lane": name, "held_by": holder, "why": e.why,
                                                 "then": "%s lane take %s --wait" % (FX_CMD, shlex.quote(job["id"]))})
        wait_note(ctx, job, "lane", name, lease)
        job.setdefault("lanes", {})[name] = lease["id"]
        ctx.save(job, "lane %s taken" % name)
        with ledger_lock():  # from now on it lives as long as job.json says so, not as long as this fx
            st = ledger_load()
            if lease["id"] in st["leases"]:
                st["leases"][lease["id"]]["tie"] = {"job_file": os.path.join(ctx.job_dir(job["id"]), "job.json"), "lane": name,
                                                    "factory": ctx.factory, "paths": lane.get("paths") or []}
                ledger_save(st)
        taken.append(name)
    return taken


def lane_of_others(ctx, job, rel):
    """The job that holds a lane protecting this folder of the factory repository, when it is not this job; else None."""
    try:
        lanes = lanes_of(ctx)
    except FxError:
        return None
    covering = [l["name"] for l in lanes if any(path_under(rel.rstrip("/"), p.rstrip("/")) for p in l.get("paths") or [])]
    if not covering:
        return None
    held = lane_holders(ctx)
    for name in covering:
        holder = (held.get(name) or {}).get("job")
        if holder and holder != (job or {}).get("id"):
            return holder
    return None


# --- a lane's folders, as each job reads them
#
# The job that holds a lane changes the lane's folders of the factory repository where they are, for hours, and what
# is there meanwhile is half done. Every other job used to run its checks against those same folders: one job's gate
# judged its code with another job's unfinished tests. Now a job that does not hold the lane gets its own copy of each
# such folder as it is committed, under its job folder, and its commands are told where: FACTORY_LANE_<PATH> (the
# folder's path in capitals, anything that is not a letter or a digit as _: qa → FACTORY_LANE_QA, qa/e2e →
# FACTORY_LANE_QA_E2E). The holder gets the same variable, set to the folder itself. The project's own script has to
# read the variable, since fx cannot change where a script looks: until a script or setting on the checks' side of the
# factory repository names it, fx makes no copy and everything is as it was.

LANE_COPIES = "lanes"  # jobs/<job>/lanes/<path>
LANE_MARK = ".fx-lanes.json"  # what fx wrote there, to take away again what a later commit no longer has
LANE_DOC_EXTS = (".md", ".markdown", ".txt", ".rst", ".adoc", ".html", ".htm", ".pdf")  # a text about it reads nothing
_LANE_NAMED = {}  # what lane_named found in each factory repository, for this fx


def lane_var(path):
    """The environment variable that tells a job's commands where to read this folder of the factory repository."""
    return "FACTORY_LANE_" + re.sub(r"[^A-Za-z0-9]+", "_", path).strip("_").upper()


def lane_folders(ctx):
    """[(lane, folder)] for every folder a lane protects. A folder inside another one listed goes with that one, and
    two folders whose variables would have the same name keep the first: the other is read where it is, as before."""
    try:
        lanes = lanes_of(ctx)
    except FxError:
        return []
    rows = []
    for l in lanes:
        for p in l.get("paths") or []:
            p = posixpath.normpath(p.strip().strip("/") or ".")
            if p == "." or p.startswith("..") or any(path_under(p, q) or lane_var(p) == lane_var(q) for _, q in rows):
                continue
            rows = [(n, q) for n, q in rows if not path_under(q, p)] + [(l["name"], p)]
    return rows


def lane_root(ctx, job):
    return os.path.join(ctx.job_dir(job_real_id(job)), LANE_COPIES)


def lane_named(ctx, fresh=False, scan=None):
    """{variable: the files on the checks' side of the factory repository that name it}, for the variables of
    lane_folders: checks.sh, the scripts and settings beside it, and the commands in factory.json. A document that
    explains the variable reads nothing, and neither does a `_doc` of factory.json. Looked up once for each fx."""
    words = [lane_var(p) for _, p in lane_folders(ctx)]
    if not words:
        return {}
    if fresh or scan is not None or ctx.factory not in _LANE_NAMED:
        named = (scan or factory_scan(ctx, words))[1]

        def no_docs(x):
            if isinstance(x, dict):
                return {k: no_docs(v) for k, v in x.items() if not str(k).startswith("_doc")}
            return [no_docs(v) for v in x] if isinstance(x, list) else x

        try:
            text = json.dumps(no_docs(json.loads(read(os.path.join(ctx.factory, CONFIG_NAME)) or "{}")))
        except ValueError:
            text = ""
        for w in words:
            if re.search(re.escape(w) + r"(?![A-Za-z0-9_])", text):
                named.setdefault(w, []).append(CONFIG_NAME)
        _LANE_NAMED[ctx.factory] = {w: sorted(set(named.get(w) or [])) for w in words}
    return _LANE_NAMED[ctx.factory]


def lane_reads(ctx, job, named=None):
    """Where a job reads each folder that a lane protects: {folder: {lane, var, dir, copy, holds, why}}. copy: its own
    copy of the folder as committed, under its job folder; otherwise the folder itself. Nothing for what is no job with
    a folder of its own (a selftest, an audit, a review's sandbox): those read the folder itself, as they did.
    holds: by the job's own record (job.json → lanes), which is what keeps a lane held (place_alive). A job that took
    the lane has its unfinished changes in the folder, and must go on reading them there whatever becomes of the
    machine's list of places; it reads a copy again only once the lane was given back for it (fx lane release)."""
    rows = lane_folders(ctx)
    if not rows or not isinstance(job, dict) or not job.get("id"):
        return {}
    real = str(job_real_id(job))
    if real.startswith("_") or not os.path.isfile(os.path.join(ctx.job_dir(real), "job.json")):
        return {}
    named = lane_named(ctx) if named is None else named
    reads = {}
    for lane, path in rows:
        var = lane_var(path)
        row = {"lane": lane, "var": var, "dir": os.path.join(ctx.factory, path), "copy": False,
               "holds": bool((job.get("lanes") or {}).get(lane))}
        if row["holds"]:
            row["why"] = "it holds the %s lane, so it works in the folder itself" % lane
        elif not named.get(var):
            row["why"] = "nothing on the checks' side of the factory repository names %s, so nothing would read a copy" % var
        elif git(["rev-parse", "-q", "--verify", "HEAD:%s" % path], ctx.factory, check=False).returncode != 0:
            row["why"] = "nothing under %s is committed yet" % path
        else:
            row.update(copy=True, dir=os.path.join(lane_root(ctx, job), path),
                       why="it does not hold the %s lane, so it reads its own copy of the folder as committed" % lane)
        reads[path] = row
    return reads


def lane_write(root, name, mode, data):
    """One file of a copy, put in place whole: a command that reads the folder meanwhile sees the old file or the new
    one. Nothing on the way to it may lead out of the copy (a symlink an earlier commit had there)."""
    cur = root
    for part in name.split("/")[:-1]:
        cur = os.path.join(cur, part)
        if os.path.islink(cur) or (os.path.lexists(cur) and not os.path.isdir(cur)):
            os.remove(cur)
    dst = os.path.join(root, name)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.isdir(dst) and not os.path.islink(dst):
        shutil.rmtree(dst)
    fd, tmp = tempfile.mkstemp(prefix=".fx-tmp-", dir=os.path.dirname(dst))
    try:
        if mode == "120000":
            os.close(fd)
            os.remove(tmp)
            os.symlink(os.fsdecode(data), tmp)
        else:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.chmod(tmp, 0o755 if mode == "100755" else 0o644)
        os.replace(tmp, dst)
    except BaseException:
        if os.path.lexists(tmp):
            os.remove(tmp)
        raise


def lane_copy_one(ctx, root, path, commit, had=()):
    """Make <root>/<path> hold what the commit has under <path>, byte for byte as committed. Only what differs is
    written, so asking again changes nothing under a command that is reading the copy; a file an earlier commit had and
    this one has not goes; what the commands themselves put there and git does not know (installed packages, reports)
    stays, as it does in the folder itself. Returns ({file: (mode, blob)}, files written, files taken away)."""
    listing = run(["git", "ls-tree", "-r", "-z", commit, "--", path], cwd=ctx.factory, check=False)
    if listing.returncode != 0:
        raise FxError("could not read %s at %s in the factory repository: %s" % (path, commit[:12], (listing.stdout or "")[-300:]),
                      code=3)
    entries = {}
    for item in (listing.stdout or "").split("\0"):
        meta, _, name = item.partition("\t")
        if name and len(meta.split()) == 3:
            mode, kind, oid = meta.split()
            if kind == "blob" and not os.path.isabs(name) and ".." not in name.split("/"):
                entries[name] = (mode, oid)
    todo = []
    for name, (mode, oid) in entries.items():
        dst = os.path.join(root, name)
        try:
            same = os.path.lexists(dst) and (os.path.islink(dst) or not os.path.isdir(dst)) and \
                same_as_blob(dst, mode, oid, crlf=False) and \
                (mode == "120000" or bool(os.stat(dst).st_mode & 0o100) == (mode == "100755"))
        except OSError:
            same = False
        if not same:
            todo.append(name)
    if todo:
        cat = subprocess.Popen(["git", "cat-file", "--batch"], cwd=ctx.factory, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL)
        try:
            for name in todo:
                mode, oid = entries[name]
                cat.stdin.write(oid.encode() + b"\n")
                cat.stdin.flush()
                head = cat.stdout.readline().split()
                if len(head) != 3 or head[1] != b"blob":
                    raise FxError("git could not give %s as it is at %s" % (name, commit[:12]), code=3)
                data = cat.stdout.read(int(head[2]))
                cat.stdout.read(1)  # the line end after each object
                lane_write(root, name, mode, data)
        finally:
            cat.stdin.close()
            cat.stdout.close()
            cat.wait()
    gone = [n for n in had if n not in entries]
    for name in gone:
        dst = os.path.join(root, name)
        if os.path.lexists(dst) and (os.path.islink(dst) or not os.path.isdir(dst)):
            os.remove(dst)
            folder = os.path.dirname(dst)
            while path_under(folder, os.path.join(root, path)) and not os.listdir(folder):
                os.rmdir(folder)
                folder = os.path.dirname(folder)
    return entries, len(todo), len(gone)


def lane_copies(ctx, job, reads=None):
    """Before a job's checks run: bring its copies of the lanes' folders in line with what is committed in the factory
    repository now. The reference images are not in git: when their folder is under such a path they are filled into the
    copy from its own committed list, by what fills every other baselines folder. Returns {copies: {folder: {dir,
    commit, files, written, sum}}, problems: what keeps the checks from running}."""
    reads = lane_reads(ctx, job) if reads is None else reads
    rep = {"copies": {}, "problems": []}
    todo = {p: r for p, r in reads.items() if r["copy"]}
    if not todo:
        return rep
    root = lane_root(ctx, job)
    commit = git(["rev-parse", "HEAD"], ctx.factory).stdout.strip()
    os.makedirs(root, exist_ok=True)
    with path_lock("lanes", root, wait=300):
        try:
            mark = json.loads(read(os.path.join(root, LANE_MARK), "") or "{}")
        except ValueError:
            mark = {}
        mark = mark if isinstance(mark, dict) else {}
        for path, r in sorted(todo.items()):
            try:
                entries, written, gone = lane_copy_one(ctx, root, path, commit, (mark.get(path) or {}).get("files") or [])
            except (OSError, FxError) as e:
                rep["problems"].append("this job's own copy of %s could not be made as committed: %s" % (path, e))
                continue
            total = hashlib.sha256(json.dumps(sorted((n, m, o) for n, (m, o) in entries.items())).encode(
                "utf-8", "surrogateescape")).hexdigest()
            mark[path] = {"commit": commit, "files": sorted(entries), "sum": total, "at": now()}
            rep["copies"][path] = {"dir": r["dir"], "commit": commit, "files": len(entries), "written": written + gone,
                                   "sum": total, "lane": r["lane"], "var": r["var"]}
        write_atomic(os.path.join(root, LANE_MARK), json.dumps(mark, indent=1) + "\n")
        try:
            cfg = baselines_config(ctx)
        except FxError:
            cfg = None  # the gate and fx doctor say what is wrong with the settings
        if cfg and cfg["repo"] == "factory" and not rep["problems"] and any(path_under(cfg["dir"], p) for p in todo):
            listed = os.path.join(root, cfg["manifest"])
            if not any(path_under(cfg["manifest"], p) for p in todo):  # the list is kept outside the folder that was copied
                shown = git(["show", "%s:./%s" % (commit, cfg["manifest"])], ctx.factory, check=False)
                if shown.returncode == 0:
                    write_atomic(listed, shown.stdout)
                elif os.path.exists(listed):
                    os.remove(listed)
            if os.path.exists(listed):
                try:
                    sync = baselines_sync_folder(ctx, cfg, root, os.path.join(root, ".unrecorded"), restore=True)
                    if sync["failed"]:
                        rep["problems"].append(baselines_failure_text(sync))
                except (FxError, StoreError, OSError) as e:
                    rep["problems"].append("the reference images of this job's own copy of %s could not be made ready: %s"
                                           % (cfg["dir"], e))
    return rep


def lane_env(ctx, job, make=True):
    """What a job's commands are told about the lanes' folders: FACTORY_LANE_<PATH> for each, the job's own copy or the
    folder itself (lane_reads), and FACTORY_BASELINES once more when the reference images are in a copy. A copy that a
    command needs before the job's first checks (its setup, a builder's own run) is made here; make=False for a command
    that only stops what runs (app_stop), which must not build a copy only for it to be deleted."""
    try:
        reads = lane_reads(ctx, job)
    except (FxError, OSError):
        return {}
    env = {}
    if make and any(r["copy"] and not os.path.isdir(r["dir"]) for r in reads.values()):
        lane_copies(ctx, job, reads)
    for path, r in reads.items():
        env[r["var"]] = r["dir"]
    try:
        cfg = baselines_config(ctx)
    except FxError:
        cfg = None
    if cfg and cfg["repo"] == "factory" and any(r["copy"] and path_under(cfg["dir"], p) for p, r in reads.items()):
        env["FACTORY_BASELINES"] = os.path.join(lane_root(ctx, job), cfg["dir"])
    return env


def cmd_lane(ctx, a):
    if a.action == "status":
        held = lane_holders(ctx)
        with ledger_lock():
            st = ledger_load()
        waiting = [q for q in st["queue"] if q["kind"] == "lane" and q.get("factory") == ctx.factory]
        named = lane_named(ctx, fresh=True)
        folders = {}
        for lane, path in lane_folders(ctx):
            var = lane_var(path)
            folders.setdefault(lane, []).append({
                "path": path, "variable": var, "named_in": named.get(var) or [],
                "other_jobs_read": "their own copy of it as committed" if named.get(var) else
                "the folder itself, as before: nothing on the checks' side of the factory repository names %s yet" % var})
        out({"ok": True, "lanes": [dict({k: l.get(k) for k in ("name", "surfaces", "paths", "why")},
                                        held_by=(held.get(l["name"]) or {}).get("job"),
                                        waiting=sorted(q.get("job") for q in waiting if q.get("name") == l["name"]),
                                        folders=folders.get(l["name"]) or [])
                                   for l in lanes_of(ctx)],
             "declared": "lanes" in ctx.cfg})
        return
    if a.action == "setup":
        path = os.path.join(ctx.factory, CONFIG_NAME)
        raw = read(path) or "{}"
        cfg = json.loads(raw)
        lanes = [l for l in (cfg.get("lanes") or []) if isinstance(l, dict) and l.get("name") != a.name]
        if not a.none:
            if not a.name or not a.surfaces:
                raise FxError("give --name and --surfaces (and --paths, --why), or --none when no jobs of this project "
                              "share files in the factory repository", code=3)
            lanes.append({"name": a.name, "surfaces": csv_list(a.surfaces), "paths": csv_list(a.paths or ""),
                          "why": (a.why or "").strip()})
        cfg["lanes"] = lanes  # an empty list too: the question was asked, and the answer was no
        m = re.search(r"\n([ \t]+)\S", raw)
        write_atomic(path, json.dumps(cfg, ensure_ascii=False, indent=len(m.group(1)) if m else 2) + "\n")
        ctx.load_config(True)
        lanes_of(ctx)  # says so now when it is not a valid lane
        out({"ok": True, "lanes": cfg["lanes"], "next": "commit factory.json in the factory repository and push it: a gate "
                                                          "only runs on settings that are committed and pushed"})
        return
    if not a.job:
        raise FxError("which job?")
    job = ctx.load(a.job)
    if a.action == "take":
        taken = lane_take(ctx, job, wait=a.wait)
        out({"ok": True, "job": job["id"], "lanes": sorted((job.get("lanes") or {})), "taken_now": taken, "next": "build"})
        return
    released = []
    for name, lid in list((job.get("lanes") or {}).items()):  # release: only when the person said so
        place_release(lid)
        released.append(name)
    job["lanes"] = {}
    ctx.save(job, "lanes given back: %s" % (", ".join(released) or "none"))
    out({"ok": True, "job": job["id"], "released": released})


def clone_containers_stop(folders, work=None):
    """Stop the containers of these clones: nothing else stops them once the clone is deleted, and each keeps its
    memory, its ports and a Docker network. A container is a clone's when compose started it from there or it mounts a
    folder of it. A compose project is a clone's, and goes down whole with its network, only when none of its containers
    belongs to another clone under `work`: a stack that several jobs share is never taken down for one of them. Volumes
    are never deleted. Returns the names stopped."""
    folders = [os.path.realpath(f) for f in folders if f]
    if not folders or os.environ.get("FACTORY_FAKE_MACHINE"):
        return []
    docker = meter_docker(pick=lambda rows: [])  # who is there; nothing is measured
    if not docker:
        return []
    own = [c for c in docker["containers"] if container_of_folders(c, folders)]
    names = {c["name"] for c in own}
    work = os.path.realpath(work) if work else None

    def of_another_clone(c):
        return c["name"] not in names and work and any(path_under(p, work) and p != work for p in [c["workdir"]] + c["mounts"])

    stopped = []
    for proj in sorted({c["project"] for c in own if c["project"]}):
        of_proj = [c for c in docker["containers"] if c["project"] == proj]
        if not any(of_another_clone(c) for c in of_proj) and \
                try_out(["docker", "compose", "-p", proj, "down", "--remove-orphans"], timeout=300) is not None:
            stopped += [c["name"] for c in of_proj]
    for n in sorted(names - set(stopped)):
        if try_out(["docker", "stop", "-t", "10", n], timeout=120) is not None:
            stopped.append(n)
    return sorted(stopped)


def wp_stack_stop(ctx, job, pid):
    """A package that is merged (or given up) needs its stack no more: the project's own app.down in the package's clone,
    with the package's port and name, then whatever is still attached to that clone."""
    p_ = job["split"]["packages"][pid]
    clone = p_.get("clone") or ""
    if not os.path.isdir(clone):
        return
    if ctx.c("app.down"):
        try:
            app_stop(ctx, wp_pseudo_job(ctx, job, pid))
        except (FxError, OSError):
            pass
    clone_containers_stop([clone], ctx.work)


def wp_place_take(ctx, job, pid, wait):
    """Room on this machine for one more package being built, counted over every job and session: (place, None), or
    (None, why not now). The place is this fx's until wp_place_keep hands it to the package."""
    p_ = job["split"]["packages"][pid]
    try:
        return place_take("package", job=job["id"], factory=ctx.factory, name=pid, folders=[p_["clone"]],
                          max_wait=max_wait_asked() if wait else 0,
                          on_wait=lambda pos, why, secs: hint("package %s of %s waits for room on this machine (%d min so "
                                                              "far, %d ahead): %s" % (pid, job["id"], secs / 60, pos, why))), None
    except PlaceWait as e:
        return None, e.why


def wp_place_keep(ctx, job, pid, lease):
    """From now on the place lives as long as job.json says the package is being built: no fx runs while its builder
    works. Called once job.json says so."""
    with ledger_lock():
        st = ledger_load()
        if lease["id"] in st["leases"]:
            st["leases"][lease["id"]]["tie"] = {"job_file": os.path.join(ctx.job_dir(job["id"]), "job.json"), "wp": pid}
            ledger_save(st)


def wp_place_end(ctx, job, pid):
    """The package is no longer being built: its place goes back, and what its stack used is what the next package is
    counted at."""
    lid = job["split"]["packages"][pid].pop("place", None)
    lease = place_release(lid) if lid else None
    if not lease:
        return
    peak, samples, cpu_sum = dict(lease.get("peak") or {}), int(lease.get("samples") or 0), float(lease.get("cpu_sum") or 0)
    if sample_sec() > 0:
        try:
            m = meter_read({lid: lease}, full=False)["by_lease"][lid]  # once more, before its stack is stopped
            for p in ("docker_mb", "host_mb"):
                peak[p] = max(float(peak.get(p, 0) or 0), float(m.get(p, 0) or 0))
            cpu_sum, samples = cpu_sum + float(m.get("cpu", 0) or 0), samples + 1
        except Exception:  # noqa: BLE001 - measuring never stops the step
            pass
    if samples:
        place_learn(lease, peak, cpu_sum / samples, samples)


# --- ports: one list for the machine

def port_listening(port):
    """Something on this machine answers on the port. A test's machine may list what listens on it ("listening"), so that
    the ports a job is given there do not depend on what else runs on the machine the test happens to run on."""
    fake = os.environ.get("FACTORY_FAKE_MACHINE")
    if fake:
        try:
            said = json.loads(read(fake, "") or "{}")
        except ValueError:
            said = None
        if isinstance(said, dict) and isinstance(said.get("listening"), list):
            return int(port) in said["listening"]
    with socket.socket() as s:
        s.settimeout(0.3)
        try:
            return s.connect_ex(("127.0.0.1", int(port))) == 0
        except OSError:
            return False


def ports_of_job(job, step, base=None):
    """Every block of ports a job.json holds: the job's own, its packages', its candidates', a review's sandbox.
    base: the factory's ports.base, for a job.json that names only its slot."""
    blocks = []

    def number(v):
        return isinstance(v, int) and not isinstance(v, bool) and v > 0

    def add(port, who):
        if number(port):
            blocks.append((port, step, who))

    box = job.get("sandbox")
    if isinstance(box, dict):
        add(box.get("port"), "the sandbox of review %s" % job.get("id"))
    if job.get("stage") in TERMINAL or job.get("mr"):
        return blocks
    port = job.get("port")
    if not number(port) and number(job.get("slot")) and number(base):
        port = base + step * job["slot"]  # a job that is not over holds its slot, whatever else its job.json says
    add(port, "job %s" % job.get("id"))
    for pid, p_ in (((job.get("split") or {}).get("packages") or {}) if isinstance(job.get("split"), dict) else {}).items():
        if isinstance(p_, dict):  # a merged one too: a round's findings can send it back to its builder, on the same ports
            add(p_.get("port"), "package %s of %s" % (pid, job.get("id")))
    for c in job.get("candidates") or []:
        if isinstance(c, dict):
            add(c.get("port"), "candidate %s of %s" % (c.get("k"), job.get("id")))
    return blocks


def ports_held(ctx=None):
    """Every block a job on this machine holds, whichever project it is of: (first port, how many, who). job.json is what
    says so, so a block is free again the moment its job is over, and jobs made by an older fx count too."""
    held = []
    factories = known_factories()
    if ctx and ctx.cfg and os.path.realpath(ctx.factory) not in factories:
        factories.append(os.path.realpath(ctx.factory))
    for f in factories:
        ports = factory_settings(f).get("ports")
        ports = ports if isinstance(ports, dict) else {}
        try:
            step = max(1, int(ports.get("step") or 10))
        except (TypeError, ValueError):
            step = 10
        try:
            base = int(ports.get("base") or 5100)
        except (TypeError, ValueError):
            base = 5100
        jobs = os.path.join(f, "jobs")
        folders = [os.path.join(jobs, d) for d in (os.listdir(jobs) if os.path.isdir(jobs) else []) if not d.startswith(".")]
        rdir = os.path.join(jobs, REVIEW_DIR)
        folders += [os.path.join(rdir, d) for d in (os.listdir(rdir) if os.path.isdir(rdir) else [])]
        for folder in folders:
            try:
                job = json.loads(read(os.path.join(folder, "job.json"), "") or "null")
            except ValueError:
                continue
            if isinstance(job, dict):
                held += [(p, w, "%s (%s)" % (who, os.path.basename(f))) for p, w, who in ports_of_job(job, step, base)]
    return held


def ports_take(ctx, owner, count=1, prefer=None):
    """Blocks of ports.step ports, one for each clone that runs a stack: no job on this machine holds them, nothing
    listens on them, and no other fx is handing them out right now. Taken under the machine's lock and kept in the ledger
    until this fx ends; by then job.json holds them. prefer: a block to take again when it is still free."""
    base, step = ports_base(ctx), max(1, ports_step(ctx))  # a block: every repository's app, the agents' own
    with ledger_lock():
        st = ledger_load()
        ledger_reap(st)
        held = ports_held(ctx) + [(int(b), int(p.get("width") or step), p.get("owner")) for b, p in st["ports"].items()
                                  if str(b).isdigit() and p.get("owner") != owner]

        def free(b):
            return not any(o < b + step and b < o + w for o, w, _ in held) and \
                not any(port_listening(b + i) for i in range(step))

        got, k = [], 1
        if isinstance(prefer, int) and prefer > 0 and free(prefer):
            got.append(prefer)
            held.append((prefer, step, owner))
        while len(got) < count:
            b = base + step * k
            k += 1
            if b + step > 65535:
                raise FxError("no free ports left from %d up: jobs that are over still hold them? fx capacity lists who "
                              "holds what" % base, code=3)
            if free(b):
                got.append(b)
                held.append((b, step, owner))
        for b in got:
            st["ports"][str(b)] = dict(proc_me(), owner=owner, width=step, since=time.time())
        ledger_save(st)
    _PORTS_TAKEN.append(owner)
    return got


_PORTS_TAKEN = []


def free_slot(ctx, owner, prefer=None):
    """(slot, first port) of a block of ports for one clone: see ports_take. The slot is the block's number from
    ports.base, kept for what older versions wrote."""
    port = ports_take(ctx, "%s|%s" % (ctx.factory, owner), prefer=prefer)[0]
    return (port - ports_base(ctx)) // max(1, ports_step(ctx)), port


def ports_done():
    """This fx is ending: what it handed out is in a job.json by now, or was never used."""
    if not _PORTS_TAKEN:
        return
    del _PORTS_TAKEN[:]
    try:
        me = proc_me()
        with ledger_lock():
            st = ledger_load()
            mine = [b for b, p in st["ports"].items() if (p.get("pid"), p.get("pid_start")) == (me["pid"], me["pid_start"])]
            for b in mine:
                st["ports"].pop(b)
            if mine:
                ledger_save(st)
    except OSError:
        pass


