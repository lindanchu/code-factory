def cleanup_stale(ctx, a):
    """Containers nobody stops by themselves. Listed first; stopped only with --yes, which the orchestrator passes when
    the user said so. Volumes are never deleted: they may hold data someone wants."""
    docker = meter_docker()
    if not docker:
        out({"ok": True, "left_running": [], "note": "Docker is not running here"})
        return
    found = left_containers(docker["containers"])
    if not found or not a.yes:
        out({"ok": True, "left_running": found, "memory_mb": sum(c["memory_mb"] for c in found),
             "next": "nothing to stop" if not found else "show the list and ask the user; when they say yes: %s cleanup "
                                                         "--stale --yes" % FX_CMD})
        return
    by_project = {}
    for c in docker["containers"]:
        if c["project"]:
            by_project.setdefault(c["project"], []).append(c["name"])
    names = {c["container"] for c in found}
    stopped, failed = [], []
    for proj in sorted({c["compose_project"] for c in found if c["compose_project"]}):
        if set(by_project.get(proj) or []) <= names:  # the whole stack is left over: its network goes with it
            ok = try_out(["docker", "compose", "-p", proj, "down", "--remove-orphans"], timeout=300) is not None
            (stopped if ok else failed).extend(by_project[proj])
            names -= set(by_project[proj]) if ok else set()
    for n in sorted(names - set(failed)):
        ok = try_out(["docker", "stop", "-t", "10", n], timeout=120) is not None
        (stopped if ok else failed).append(n)
    out({"ok": not failed, "stopped": sorted(stopped), "failed": sorted(set(failed)),
         "note": "volumes were kept (docker volume ls); remove them by hand if nobody needs their data"})


def cmd_cleanup(ctx, a):
    if a.stale:
        cleanup_stale(ctx, a)
        return
    if not a.job:
        raise FxError("give the job whose clone to delete, or --stale")
    job = ctx.load(a.job)
    if job["stage"] not in TERMINAL and not a.force:
        raise FxError("job %s is still active (%s); pass --force to delete its clone" % (job["id"], job["stage"]))
    cands = [c for per in job_candidates(job).values() for c in per.values()]
    clone_containers_stop([c["worktree"] for c in cands if os.path.isdir(c["worktree"])], ctx.work)
    for c in cands:
        shutil.rmtree(c["worktree"], ignore_errors=True)
    r = drop_clone(ctx, job, force=a.force)
    if r.startswith("kept"):
        raise FxError("the clone of %s has work that is not on the remote (%s); push it, or pass --force to "
                      "delete it anyway" % (job["id"], r[6:]), code=3)
    ctx.save(job, "clone %s" % r)
    out({"ok": True, "job": job["id"], "clone": r})


