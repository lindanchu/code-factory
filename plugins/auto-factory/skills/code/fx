def cmd_setup(ctx, a):
    """Install dependencies in each clone of the job, in repo_order: its repository's setup command, once."""
    job = ctx.load(a.job)
    names = job_clones(job)
    if getattr(a, "repo_name", None):
        if a.repo_name not in names:
            raise FxError("%s has no clone of %s (its repositories: %s)" % (job["id"], a.repo_name, ", ".join(names)),
                          code=3)
        names = [a.repo_name]
    if not names:
        raise FxError("%s has no clones yet: intake names its repositories, then fx repos clones them" % job["id"], code=3)
    todo = [n for n in names if a.force or not job["repos"][n].get("setup_done")]
    if not todo:
        out({"ok": True, "job": job["id"], "skipped": "already done"})
        return
    lane_take(ctx, job)  # a job that shares files with another one waits here, before it builds anything
    several = len(job["repos"]) > 1
    logs, waited = {}, 0
    for n in todo:
        e = job["repos"][n]
        cmd = ctx.rc(n, "setup", "")
        log = os.path.join(ctx.job_dir(job["id"]), "setup-%s.log" % n if several else "setup.log")
        if cmd:
            if not os.path.isdir(e.get("worktree") or ""):
                raise FxError("the clone of %s is missing (%s): fx rework or a new attempt" % (n, e.get("worktree")),
                              code=3)
            timeout = int(ctx.rc(n, "setup_timeout_sec", 1800) or 1800)
            with job_step(ctx, job, "setup", board="setup") as place:
                waited += place.waited
                try:
                    # The repository's own port, id and database name, as its checks script gets them: a setup that
                    # starts the project's stack must not start it on the ports of another job.
                    p = run(["bash", "-lc", cmd], cwd=e["worktree"], check=False, env=checks_env(*one_app(ctx, job, n)),
                            timeout=timeout, group=True)
                except subprocess.TimeoutExpired as ex:
                    write_atomic(log, (ex.output or "") if isinstance(ex.output, str) else "")
                    raise FxError("setup%s timed out after %ss; see %s" % (" of %s" % n if several else "", timeout, log),
                                  code=3)
                write_atomic(log, p.stdout or "")
                if p.returncode != 0:
                    raise FxError("setup%s failed (exit %d); see %s" % (" of %s" % n if several else "", p.returncode,
                                                                        log), code=3)
            logs[n] = log
            job = ctx.load(job["id"])  # as it is now: the step may have waited, and its start and end went on the board
        job["repos"][n]["setup_done"] = True
        ctx.save(job, "worktree setup done" if not several else "setup done in %s" % n)
    res = {"ok": True, "job": job["id"], "log": logs.get(todo[0]) if not several else None}
    if several:
        res["logs"] = logs
    if waited >= 1:
        res["waited_sec"] = round(waited)
    out(res)


DEFAULT_ARTIFACTS = [
    "*__pycache__*", "*.pyc", "coverage/*", "*.log", ".DS_Store", "dist/*", "build/*", "out/*", "target/*",
    "test-results/*", "playwright-report/*", "blob-report/*", "shots/*",
]


# Local env files are never committed by fx, whatever copy_into_worktree says.
LOCAL_FILE_GLOBS = [".env*", "*/.env*"]
SHARED_ENV_SUFFIXES = (".example", ".sample", ".dist", ".template")  # .env.example and the like belong in git


def local_only_paths(ctx, repo=None):
    """The files fx copies into every clone (copy_into_worktree, for example .env): never part of a commit."""
    got = ctx.rc(repo, "copy_into_worktree", []) if repo else ctx.c("copy_into_worktree", [])
    return [p.strip().strip("/") for p in (got or []) if p and p.strip().strip("/")]


def is_local_file(ctx, path, repo=None):
    return path in local_only_paths(ctx, repo) or (match_any(path, LOCAL_FILE_GLOBS) and not path.endswith(SHARED_ENV_SUFFIXES))


def stage_work(ctx, wt, untracked, repo=None):
    """Stage the tracked changes and these untracked files, never the local files (copy_into_worktree, .env*): they
    hold this machine's secrets. A pathspec cannot exclude .env* and keep .env.example, so the local files are taken
    back out of the index, also one a builder staged itself. Returns the files left out."""
    changed = [p for p in git(["diff", "--no-renames", "--name-only", "-z", "HEAD"], wt).stdout.split("\0") if p]
    left = [p for p in changed + untracked if is_local_file(ctx, p, repo)]
    git(["add", "-u", "--", "."], wt)
    work = [p for p in untracked if not is_local_file(ctx, p, repo)]
    if work:
        git(["--literal-pathspecs", "add", "--"] + work, wt)
    if left:
        git(["--literal-pathspecs", "reset", "-q", "--"] + left, wt)  # a failure here stops before any commit
    return left


def worktree_dirt(ctx, wt, repo=None):
    """Return (tracked changes, untracked non-artifact files) in a worktree. The copy_into_worktree files are
    fx's, not the job's: they are never listed as untracked work."""
    local = set(local_only_paths(ctx, repo))
    tracked = git(["status", "--porcelain", "--untracked-files=no", "--", "."] +
                  [":(exclude,literal)%s" % p for p in sorted(local)], wt).stdout.strip()
    patterns = (ctx.rc(repo, "artifact_paths", DEFAULT_ARTIFACTS) if repo else
                ctx.c("artifact_paths", DEFAULT_ARTIFACTS)) or []
    untracked = []
    for entry in git(["status", "--porcelain", "-z", "--untracked-files=all"], wt).stdout.split("\0"):
        if entry.startswith("?? "):
            path = entry[3:]
            if not match_any(path, patterns) and path not in local:
                untracked.append(path)
    return tracked, untracked


def changed_files(job):
    wt = job["worktree"]
    mb = git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
    diff = git(["diff", "--name-status", "-M", "%s..HEAD" % mb], wt).stdout
    files = []
    for line in diff.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            files.append((parts[0][0], parts[1:]))
    return files


def gate_void(ctx, job_id, rn, rdir, place, why, also=None):
    """A round that says nothing about the job's code: the gate's settings changed under it (a commit to the factory
    repository for another job), another program sat on the job's port, or part of its checks was stopped from outside
    (outside_stop). It does not count against the job's rounds and no builder is sent to fix what is not broken: the
    round's folder is put aside, the builder's report goes back, and a human hears why (exit 3). also: what else to
    write into the job as it was saved."""
    jd = ctx.job_dir(job_id)
    if os.path.exists(os.path.join(rdir, "build.md")) and not os.path.exists(os.path.join(jd, "build.md")):
        os.replace(os.path.join(rdir, "build.md"), os.path.join(jd, "build.md"))
    k = 1
    while os.path.exists("%s-void-%d" % (rdir, k)):
        k += 1
    aside = "%s-void-%d" % (rdir, k)
    try:
        os.replace(rdir, aside)
    except OSError:
        aside = rdir
    job = ctx.load(job_id)  # as it was saved: nothing this round changed in memory is kept
    before = job.get("void") or {}
    n = before.get("count", 0) + 1 if before.get("round") == rn else 1
    first = why.splitlines()[0][:300]
    job["void"] = {"round": rn, "count": n, "why": first, "at": now()}
    if also:
        also(job)
    ctx.save(job, "round %d did not count: %s" % (rn, first))
    place.count, place.result = False, "void"
    raise FxError("%s\nThis says nothing about the job's code, so the round does not count and no builder is needed. %s"
                  % (why, "Run the gate again." if n < 3 else "It is the third time in a row for this round: find out "
                     "what keeps changing before the gate runs again."),
                  code=3, extra={"void": True, "round": rn, "kept": aside, "next": "gate" if n < 3 else "stop"})


def cmd_gate(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "build":
        raise FxError("gate runs after a build; job is in stage %s" % job["stage"])
    if rounds_left(job) <= 0:
        raise FxError("no rounds left for %s" % job["id"])
    # A gate takes its place on the machine one phase at a time (GatePhases). One whose checks already passed on this
    # commit has only the second phase.
    with job_busy(ctx, job, "gate"):
        try:
            with GatePhases(ctx, job, GATE_AFTER_CHECKS if checks_may_reuse(ctx, job) else GATE_CHECKS) as place:
                mark_step(ctx, job["id"], "gate", True, only_one=True, lease=place.lease)
                try:
                    gate_round(ctx, a, place)
                finally:
                    mark_step(ctx, job["id"], "gate", False, place.result)
        except PlaceWait as e:
            raise place_refusal(e, "gate of %s" % job["id"])


def gate_round_repos(ctx, job, a, place):
    """A round of a job of several repositories: per changed repository in repo_order, the dirt check, protected and
    frozen paths, its checks script (once for its commit, as in gate_round_one) and (after the last) the staged logic;
    the first that fails stops the gate. Then the apps (in dependency order), seed.sh, each repository's e2e, the UI check
    and each repository's security scan."""
    change = job_names(job, "change")
    label = lambda n: "%s: " % n  # noqa: E731
    views = {n: repo_view(ctx, job, n) for n in change}
    rctxs = {n: repo_ctx(ctx, n) for n in change}
    for n in change:
        wt = views[n]["worktree"]
        if not wt or not os.path.isdir(wt):
            raise FxError("the job's clone %s (%s) is missing. If its branch was pushed: `%s stage %s handed-off --force`, "
                          "then `/auto-factory:code rework %s`; otherwise start a new attempt of %s" % (
                              wt, n, FX_CMD, job["id"], job["id"], job["issue_key"]), code=3)
    if not ctx.old_form:
        missing = [os.path.relpath(checks_script(ctx, job, n), ctx.factory) for n in change
                   if not os.path.isfile(checks_script(ctx, job, n))]
        if missing:
            raise FxError("no checks script %s in the factory repository: write it (it runs in that repository's clone) "
                          "and commit it" % ", ".join(missing), code=3)
    bl_cfg = baselines_config(ctx)
    bl_pre = baselines_refresh(ctx, bl_cfg, hold=True) if bl_cfg else None  # before anything reads a checks script
    bl_cfg = baselines_config(ctx)
    # From here on a commit to the settings is seen at the end; one made before is checked right below.
    settings_at = git(["rev-parse", "--verify", "-q", "HEAD"], ctx.factory, check=False).stdout.strip()
    # Exit 3, not a failed gate for the builder to work on: nobody makes these by accident, so a human hears of it.
    refusal = factory_settings_refusal(ctx, job) or history_rewrites_text(ctx, job)
    if refusal:
        raise FxError(refusal, code=3)
    allowed = job_override(ctx, job, keep=True, at=settings_at or None)  # as committed, like the settings
    for n in change:
        job_base_from_remote(ctx, job, n)
    views = {n: repo_view(ctx, job, n) for n in change}
    heads = {n: git(["rev-parse", "HEAD"], views[n]["worktree"]).stdout.strip() for n in change}
    head = ",".join("%s:%s" % (n, heads[n]) for n in change)  # the commits this round judges, one per repository
    work = gate_work(ctx, job)  # and what else the builder left for it
    job["round"] += 1
    rn = job["round"]
    for v in views.values():
        v["round"] = rn
    rdir = os.path.join(ctx.job_dir(job["id"]), "round-%d" % rn)
    os.makedirs(rdir, exist_ok=True)
    job["skipped_checks"], job["security_skipped"], job["security_missed"] = [], [], []  # describe this round only
    build_md = os.path.join(ctx.job_dir(job["id"]), "build.md")
    if os.path.exists(build_md):
        # Move, not copy: the next round must not see this round's STATUS line.
        os.replace(build_md, os.path.join(rdir, "build.md"))

    per = {}
    for n in change:
        files = changed_files(views[n])
        all_paths = [p for _, ps in files for p in ps]
        scanner = sorted({p for p in all_paths if match_any(p, SCANNER_SETTINGS)})
        per[n] = {"files": files, "scanner": scanner, "state": "not checked", "checks_out": "", "e2e_out": "",
                  "cr": None,
                  "flags": sorted({p for p in all_paths if match_any(p, rctxs[n].c("sensitive_paths", []) or [])}
                                  | set(scanner)),
                  "ui_hit": [p for p in all_paths if match_any(p, rctxs[n].c("ui_paths", []) or [])]}
    named = lambda n, paths: ["%s:%s" % (n, p) for p in paths]  # noqa: E731
    flags = sorted({x for n in change for x in named(n, per[n]["flags"])})
    scanner_files = sorted({x for n in change for x in named(n, per[n]["scanner"])})
    # A repository intake named that turned out to need nothing: while another has commits, it is not changed (no
    # checks, no scans, no pull request). With no commits anywhere, the gate fails as always.
    idle = [n for n in change if not per[n]["files"]] if any(per[n]["files"] for n in change) else []
    clean = True

    problems, bl, stopped_at, unprotected = [], None, None, []
    # A run-only clone is the base, never pushed: work in it would be lost, and it is not what gets reviewed.
    for n in job_names(job, "run"):
        wt = job["repos"][n].get("worktree")
        if not wt or not os.path.isdir(wt):
            continue
        k, dirty = unsaved_work(ctx, job, wt, n)
        if k or dirty:
            problems.append("%s is run-only: run `fx repos %s --add %s` to change it (%s)" % (
                n, job["id"], n, "%d commit(s)" % k if k else dirty.splitlines()[0] if dirty else ""))
            stopped_at = stopped_at or n
    bl_name = None
    if bl_cfg:
        bl_name = bl_cfg["repo_name"] if bl_cfg["repo"] == "project" else change[0]
    lanes_read = lane_reads(ctx, job)  # where this job reads the folders a lane protects: its own copy, or the folder
    copies = {}
    for n in change if not problems else ():
        v, rc_, info = views[n], rctxs[n], per[n]
        mine = [job_off_its_branch(v)] if job_off_its_branch(v) else []
        tracked, untracked = worktree_dirt(ctx, v["worktree"], n)
        if bl_cfg and bl_cfg["repo"] == "project" and n == bl_name:
            # recorded, not committed yet: the list waits for its images on S3
            tracked = "\n".join(l for l in tracked.splitlines() if l.split(None, 1)[-1].strip('"') != bl_cfg["manifest"])
        if tracked:
            mine.append("Uncommitted changes to tracked files (commit them):\n" + tracked)
        if untracked:
            mine.append("Untracked files that are not in any commit (commit them, delete them, or add "
                        "build artifacts to .gitignore):\n" + "\n".join(untracked[:50]))
        clean = clean and not tracked and not untracked
        if not info["files"] and n not in idle:
            mine.append("The branch has no commits beyond %s." % v["base_ref"])
        prot = rc_.c("protected_paths", []) or []
        frozen = rc_.c("frozen_paths", [".claude/*"]) or []
        for status, paths in info["files"]:
            old = paths[0]
            if any(match_any(p, frozen) for p in paths):
                mine.append("Frozen path changed: %s (frozen_paths in factory.json may not be touched by a job)"
                            % " -> ".join(paths))
            elif status in ("M", "D", "R") and match_any(old, prot) and match_any(old, allowed.get("unprotect") or []):
                unprotected.append("%s:%s" % (n, old))  # a human allowed this job to change this existing test
            elif status in ("M", "D", "R") and match_any(old, prot):
                mine.append("Protected file %s: %s (existing tests may not be modified or deleted; "
                            "add new test files instead)" % ({"M": "modified", "D": "deleted",
                                                              "R": "renamed"}[status], old))
        if bl_cfg and n == bl_name:
            bl = baselines_gate(ctx, bl_cfg, v, rdir, bl_pre, lanes_read)
            mine += bl["problems"]
        if not mine and n not in idle and not copies:
            made = lane_copies(ctx, job, lanes_read)
            copies = made["copies"]
            mine += made["problems"]
        if not mine and n not in idle:
            # The checks script, once for this commit (see gate_round_one).
            info["log"] = "checks-%s.log" % n
            info["script"] = os.path.relpath(checks_script(ctx, job, n), ctx.factory)
            cr = checks_once(rc_, v, os.path.join(rdir, info["log"]), "gate", rn=rn, place=place)
            info["cr"], info["checks_out"] = cr, cr["output"]
            if cr["problem"]:
                mine.append(cr["problem"])
            if cr["outside"]:
                first = outside_stop_first(job, heads[n])
                write_atomic(os.path.join(rdir, "outside-stop.json"), json.dumps(
                    dict(cr["outside"], repo=n, commit=heads[n], round=rn, run=cr["id"], the_round_counts=not first),
                    indent=1, ensure_ascii=False) + "\n")
                if first:
                    seen = {"commit": heads[n], "round": rn, "at": now(), "why": cr["outside"]["why"][:300]}
                    gate_void(ctx, job["id"], rn, rdir, place,
                              "the checks of %s failed, but not by anything the code did: %s. What was seen is kept in "
                              "outside-stop.json in the round's folder" % (n, cr["outside"]["why"]),
                              also=lambda j: j.setdefault("outside_stops", []).append(seen))
                mine.append("part of the checks was stopped from outside again (%s). A round on this commit was already "
                            "put aside for that, so this one counts: if the code is not at fault, find out what stops "
                            "this job's containers (round-%d/outside-stop.json)" % (cr["outside"]["why"], rn))
        info["state"] = "fail" if mine else "not changed" if n in idle else "pass"
        problems += [label(n) + m for m in mine]
        if mine:
            stopped_at = n
            break
    crs = {n: per[n]["cr"] for n in change if per[n]["cr"] is not None}
    place.count = bool(crs) and all(c["reused"] == (place.lease.get("kind") == GATE_AFTER_CHECKS) for c in crs.values())

    if not problems and logic_ready(ctx):
        sdir, snames = staged_logic(ctx, job)
        if logic_changes_planned(ctx, job) and not snames:
            problems.append("the spec lists logic changes but no updated logic file was staged in the job folder's "
                            "logic/ (see the 'Logic updates' line of the builder prompt)")
        if snames:
            lres = logic_check(ctx, sdir, job_code_roots(job), only=snames, check_index=False)
            if lres["problems"]:
                problems.append("staged logic files do not pass the check:\n" + "\n".join(lres["problems"][:20]))
            base = job.setdefault("logic_base", {})
            for x in snames:
                if x not in base:  # what logic/ held when this job started changing the file
                    base[x] = file_hash(os.path.join(logic_dir(ctx), x))
    hit = next((n for n in change if per[n]["ui_hit"]), None)
    if hit:
        job["ui_repo"] = hit
    if hit and "ui" not in job.get("surfaces", []):
        job["surfaces"] = list(job.get("surfaces", [])) + ["ui"]
        ui_added = True
    else:
        ui_added = False
    jd = ctx.job_dir(job["id"])
    ui_script = os.path.join(jd, "ui", "check.js")
    ui_name = ui_repo(ctx, job)
    ui_wanted = ("ui" in job.get("surfaces", [])) and repo_ctx(ctx, ui_name).c("ui_checks.enabled", True)
    ui_rep = None
    started, secs = {}, {}
    apps = job_apps(ctx, job)
    if not problems:
        place.next(GATE_APP)  # the checks are over: their place goes back, and the apps and the scans wait for theirs
    if not problems and apps:
        try:
            app_stop(ctx, job)
            info_ = app_start(ctx, job)
            started = info_.get("apps") or {apps[0]: info_}
        except FxError as e:
            if e.extra.get("port_taken"):
                gate_void(ctx, job["id"], rn, rdir, place, str(e))
            problems.append("the app%s could not start: %s" % ("s" if len(apps) > 1 else "", e))
    urls = {n: x["url"] for n, x in started.items()}

    def sec_dir(n):
        """Where a repository's scanners write their reports: round-N/security-<repo>/."""
        d = os.path.join(rdir, "security-%s" % n)
        os.makedirs(d, exist_ok=True)
        return d
    if not problems and started and os.path.exists(os.path.join(jd, "ui", "seed.sh")):
        if not run_seed(ctx, job, os.path.join(jd, "ui", "seed.sh"), rdir):
            problems.append("ui/seed.sh failed (round-%d/seed.log)" % rn)
    for n in change:
        rc_ = rctxs[n]
        if problems or n not in urls or not rc_.c("e2e") or n in idle:
            continue
        env, db = app_env(rc_, views[n])
        env["BASE_URL"] = urls[n].rstrip("/")
        log = "e2e-%s.log" % n
        timeout = int(rc_.c("e2e_timeout_sec", 1800) or 1800)
        try:
            p = run(["bash", "-lc", app_fill(rc_.c("e2e"), views[n], db)], cwd=views[n]["worktree"], check=False,
                    env=env, timeout=timeout, group=True)
            per[n]["e2e_out"] = p.stdout or ""
            if p.returncode != 0:
                problems.append("%se2e tests exited with %d (see round-%d/%s)" % (label(n), p.returncode, rn, log))
        except subprocess.TimeoutExpired:
            problems.append("%se2e tests timed out after %ss" % (label(n), timeout))
        per[n]["e2e_log"] = log
        write_atomic(os.path.join(rdir, log), per[n]["e2e_out"])
    if not problems and ui_wanted:
        if ui_name not in urls and not mobile_conf(repo_ctx(ctx, ui_name)):
            job["skipped_checks"].append("UI checks skipped: no app.up command to run the app of %s "
                                         "(set it with /auto-factory:code init)" % ui_name)
        elif not os.path.exists(ui_script):
            problems.append("this change is user-visible but the builder wrote no ui/check.js "
                            "(a Playwright check of the UI acceptance criteria) in the job folder")
        else:
            ui_rep = ui_run(ctx, job, ui_script, os.path.join(rdir, "ui"))
            write_atomic(os.path.join(rdir, "ui.md"), ui_markdown(ui_rep, ui_name))
            if ui_rep.get("skipped"):
                job["skipped_checks"].append(ui_rep["skipped"])
            elif ui_rep["blocking"]:
                problems.append("UI check failed: %d blocking issue(s), see round-%d/ui.md"
                                % (len(ui_rep["blocking"]), rn))
    sec = None
    if not problems:
        # Always: a factory.json without security.scanners means the template's defaults (all on).
        for n in change:
            if n in idle:
                continue
            secs[n] = run_security(rctxs[n], views[n], sec_dir(n), urls.get(n))
            for f_ in secs[n]["findings"]:
                f_["repo"] = n
        sec = security_merge(secs, True)
        write_atomic(os.path.join(rdir, "security.md"), security_markdown_repos(secs, True))
        job["security_skipped"] = sec["skipped"]
        job["security_missed"] = sec["missed"]
        flags = sorted(set(flags) | set(sec["flags"]))
        if sec["required_failed"]:
            problems.append("required security scanner(s) did not run (security.required in factory.json): %s"
                            % "; ".join(sec["required_failed"]))
        if sec["blocking"]:
            problems.append("security scan: %d blocking finding(s) introduced by this job, see round-%d/security.md"
                            % (len(sec["blocking"]), rn))
    else:
        # Secrets are checked every round, even when the rest of the gate stopped early.
        for n in change:
            v = views[n]
            if not per[n]["files"] or not scanners_on(rctxs[n])["gitleaks"]:
                continue
            mb = git(["merge-base", v["base_ref"], "HEAD"], v["worktree"]).stdout.strip()
            leaks, err, _ = scan_secrets(rctxs[n], v, mb, sec_dir(n))
            if leaks:
                secs[n] = {"findings": leaks, "blocking": leaks,
                           "skipped": ["other scanners: not run, the gate stopped earlier"]}
        if secs:
            sec = security_merge(secs, True)
            write_atomic(os.path.join(rdir, "security.md"), security_markdown_repos(secs, True))
            for n, s_ in secs.items():
                problems.append("%ssecrets committed on the branch: %d (see round-%d/security.md); remove them from the "
                                "unpushed history, not just the latest commit: `git reset --soft %s`, take them out, "
                                "commit again" % (label(n), len(s_["blocking"]), rn, unpushed_base(views[n])[:12]))

    # The checks scripts run the project's code, which could reach them too, and the scanners came after it.
    changed = factory_dirty(ctx, job) or factory_changed_since(ctx, settings_at, job)
    if changed:
        gate_void(ctx, job["id"], rn, rdir, place, "the gate's settings changed while it ran, so what this round found "
                                                   "is not what the settings now ask for:\n" + changed)
    job.pop("void", None)
    passed = not problems
    md = ["GATE: %s" % ("PASS" if passed else "FAIL"), "",
          "Round %d. Branch %s in %s." % (rn, job_branch_name(job), ", ".join(change)), ""]
    if problems:
        md += ["## Problems", ""] + ["- " + p.replace("\n", "\n  ") for p in problems] + [""]
    skipped_all = job["skipped_checks"] + job["security_skipped"]
    if skipped_all:
        md += ["## Skipped checks", ""] + ["- " + x for x in skipped_all] + [""]
    if bl:
        md += bl["markdown"]
    if allowed:
        md += ["## Allowed for this job by a human (%s; approver must look)" % override_rel(job), "",
               "- Approved: %s" % allowed["approved"].strip()]
        md += ["- Existing test changed with that permission: %s" % x for x in sorted(set(unprotected))]
        md += ["- Finding accepted for this job: %s in %s (%s)" % (e["rule"], e.get("path") or "every file", e["reason"])
               for e in allowed.get("accepted_rules") or []] + [""]
    if flags:
        md += ["## Sensitive paths touched (approver must look)", ""] + ["- " + x for x in flags] + [""]
    if scanner_files:
        md += ["## Scanner settings changed (they can hide findings; fx's scans ignore them, a human must look)",
               ""] + ["- " + x for x in scanner_files] + [""]
    if sec is not None and sec.get("notes"):
        md += ["## Security notes", ""] + ["- " + x for x in sec["notes"]] + [""]
    if copies:
        md += ["## Folders shared with other jobs", ""] + [
            "- `%s`: this job read it as committed (%s), from its own copy in %s. Only the job that holds the %s lane "
            "works in the folder itself." % (p_, c["commit"][:12], c["dir"], c["lane"]) for p_, c in sorted(copies.items())] + [""]
    for n in change:
        info = per[n]
        part = []
        if info["state"] == "not checked" and stopped_at:
            part += ["Not checked: the gate stopped at %s." % stopped_at, ""]
        if info["state"] == "not changed":
            part += ["Not changed: no commits beyond %s, so its checks and scans are skipped and it gets no pull "
                     "request (`fx repos %s --drop %s` takes it out of the job)." % (views[n]["base_ref"], job["id"], n),
                     ""]
        if info["checks_out"]:
            part += ["## %s output (last 150 lines, full log in %s)" % (info["script"], info["log"]), "", "```",
                     "\n".join(info["checks_out"].splitlines()[-150:]), "```", ""]
        elif info["cr"] is not None and info["cr"]["reused"]:
            part += ["## %s" % info["script"], "", info["cr"]["note"], ""]
        if info["e2e_out"]:
            part += ["## e2e output (last 100 lines, full log in %s)" % info["e2e_log"], "", "```",
                     "\n".join(info["e2e_out"].splitlines()[-100:]), "```", ""]
        if ui_rep is not None and n == ui_name:
            part += ["## UI check", "", "See ui.md and the screenshots under ui/shots/ in this round's folder.", ""]
            part += ["- " + b for b in ui_rep.get("blocking", [])[:30]] + [""]
        if n in secs:
            part += ["## Security scan", "", "See security.md in this round's folder.", ""]
            part += ["- %s %s %s: %s" % (f_["severity"], f_["tool"], f_.get("location"), f_.get("message"))
                     for f_ in secs[n]["blocking"][:30]] + [""]
        md += ["## Repo: %s" % n, ""] + md_demote(part)
    write_atomic(os.path.join(rdir, "checks.md"), "\n".join(md) + "\n")

    notes = []
    job["gate"] = "PASS" if passed else "FAIL"
    job["flags"] = flags
    if flags and job.get("risk") == "low":
        job["risk"] = "high"
        notes.append("risk raised to high: sensitive paths changed")
    if ui_added:
        notes.append("UI reviewers added: UI files changed")
        try:
            lane_take(ctx, job)
        except FxError as e:
            if e.code != EXIT_WAIT:
                raise
            notes.append("this job turned out to change the UI, and %s holds the %s lane: its next build waits for that job"
                         % (e.extra.get("held_by"), e.extra.get("lane")))
    if notes or (len(change) > 1) != ("fit" in (job.get("reviewers") or [])):
        route(ctx, job)
    if scanner_files:
        notes.append("scanner settings changed by the job (a human must look): %s" % ", ".join(scanner_files))
    if unprotected:
        notes.append("existing tests changed with a human's permission (%s): %s" % (override_rel(job),
                                                                                    ", ".join(sorted(set(unprotected)))))
    if sec is not None:
        notes += sec.get("notes") or []
    notes += ["%s: %s" % (n, c["note"]) for n, c in crs.items() if c["reused"]]
    # What this round ran on, kept for the next ones: a pass on the same commits gives failed rounds back
    # (rounds_give_back).
    entry = {"round": rn, "commit": head, "work": work, "clean": clean, "gate": job["gate"], "at": now()}
    if crs:
        entry["inputs"] = ",".join("%s:%s" % (n, c.get("fingerprint")) for n, c in sorted(crs.items()))
    if not passed:
        entry["failed_at"] = "security" if len(problems) == 1 and sec is not None and sec.get("blocking") \
            and not sec.get("required_failed") else "checks" if any(not c["ok"] for c in crs.values()) else "other"
    job.setdefault("gate_rounds", []).append(entry)
    given = rounds_give_back(job, entry) if passed else []
    if given:
        notes.append("round%s %s failed on these same commits, which now pass with nothing of the builder's changed: no "
                     "builder was needed, so %s not count against the job's rounds"
                     % ("s" if len(given) > 1 else "", ", ".join(str(x) for x in given), "they do" if len(given) > 1 else "it does"))

    res = {"job": job["id"], "round": rn, "gate": job["gate"], "report": os.path.join(rdir, "checks.md"),
           "flags": flags, "notes": notes, "skipped": skipped_all, "rounds_left": rounds_left(job),
           "repos": {n: per[n]["state"] for n in change}}
    if crs:
        res["checks"] = {n: checks_answer(c) for n, c in crs.items()}
    if given:
        res["rounds_given_back"] = given
    if copies:
        res["lanes"] = {p_: {"read_from": c["dir"], "as_committed_at": c["commit"][:12], "variable": c["var"]}
                        for p_, c in sorted(copies.items())}
    if bl:
        notes += ["baselines: " + w for w in bl["summary"]["warnings"]]
        res["baselines"] = {k: bl["summary"][k] for k in ("counts", "fetched", "unrecorded", "pulled")}
        res["baselines"]["pending_push"] = len(bl["summary"]["pending_push"])
        if sum(bl["summary"]["counts"].values()):
            notes.append("baselines changed (%(changed)d changed, %(added)d added, %(removed)d removed): see "
                         "baselines.md in this round's folder" % bl["summary"]["counts"])
    if passed:
        job["reviews"] = {r: "pending" for r in job["reviewers"]}
        for n in change:
            job["repos"][n]["checks_passed_at"] = git(["rev-parse", "HEAD"], views[n]["worktree"]).stdout.strip()
        job.pop("checks_passed_at", None)
        if isinstance(job, Job) and job.shown:
            job.shown[1].pop("checks_passed_at", None)
        ctx.move(job, "review", "gate PASS round %d" % rn)
        res.update(next="review", reviewers=job["reviewers"],
                   models={r: job["models"][r] for r in job["reviewers"]})
        if "fit" in job["reviewers"]:  # its agent is not named factory-reviewer-<role> like the others
            res["agents"] = {r: REVIEWER_AGENTS.get(r, "factory-reviewer-%s" % r) for r in job["reviewers"]}
    elif rounds_left(job) > 0:
        job["build_reason"] = "feedback"
        ctx.save(job, "gate FAIL round %d" % rn)
        res["next"] = "build"
    else:
        job["needs_human"] = True
        job["incomplete"] = True
        job["handoff_reason"] = "gate still failing after %d rounds" % job["max_rounds"]
        ctx.move(job, "pr", "rounds exhausted at gate")
        res["next"] = "pr"
    out(res)


GATE_CHECKS = "gate: checks"  # a gate's first phase on the machine, when it runs the checks script
GATE_APP = "gate: app and scans"  # its second: the app, e2e, the UI check and the security scanners
GATE_AFTER_CHECKS = GATE_APP  # a gate whose checks already passed on its commit has the second phase only
# A wait for a gate's first place is kept in the job (waits) as the gate's, as before; one for its second phase by name.
GATE_PHASE_NAMES = {GATE_APP: "app and scans"}


class GatePhases:
    """A gate's place on the machine, one phase at a time. The checks script, then the app with e2e, the browser and
    the scanners (ZAP above all): they use the machine differently and one after the other. A gate counted as one step
    held the peak of both for the whole hour, so on a machine that fits one gate, gates ran strictly one after another
    and so did everything behind them. Each phase now takes its own place, is measured as its own kind of step, and
    gives its place back when it ends: another job's checks can run while this gate scans. The second phase keeps the
    gate's place in the line (seq) and waits as long as it takes, whatever --max-wait says: the round has begun and is
    not left half done. Reads (lease, waited, names...) are those of the phase that holds the place now."""

    def __init__(self, ctx, job, kind):
        self.__dict__.update(ctx=ctx, job=job, result=None, place=None, stack=contextlib.ExitStack())
        self.__dict__["place"] = self.stack.enter_context(step_place(ctx, kind, job, noted_as=("gate", None)))

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return self.stack.__exit__(*exc)

    def __getattr__(self, name):
        place = self.__dict__.get("place")
        if place is None:
            raise AttributeError(name)
        return getattr(place, name)

    def __setattr__(self, name, value):
        if name == "result":
            self.__dict__["result"] = value
        else:  # count, and anything else a step sets on its place: the current phase's
            setattr(self.__dict__["place"], name, value)

    def next(self, kind):
        """Give this phase's place back (what it used is learned for its kind) and wait for the next phase's."""
        if self.place.lease.get("kind") == kind:
            return
        seq = self.place.lease.get("seq")
        self.stack.close()
        self.__dict__["stack"] = contextlib.ExitStack()
        self.__dict__["place"] = self.stack.enter_context(step_place(self.ctx, kind, self.job, seq=seq, wait_all=True,
                                                                     noted_as=("gate", GATE_PHASE_NAMES.get(kind))))


def gate_round(ctx, a, place):
    """A gate round. A job with one repository runs it as it always did (gate_round_one); a job of several repositories
    runs it per repository (gate_round_repos)."""
    ctx.load_config(True)  # as they are now: the gate may have waited for its turn, and the settings may have moved
    job = ctx.load(a.job)
    if job["stage"] != "build":
        raise FxError("gate runs after a build; job is in stage %s" % job["stage"])
    if rounds_left(job) <= 0:
        raise FxError("no rounds left for %s" % job["id"])
    if not job_names(job, "change"):
        raise FxError("%s has no clones yet: intake names its repositories, then fx repos clones them" % job["id"], code=3)
    if len(job_order(job)) <= 1:
        return gate_round_one(ctx, job, a, place)
    return gate_round_repos(ctx, job, a, place)


def gate_round_one(ctx, job, a, place):
    """A round of a job with one repository: as it always was."""
    if not ctx.old_form and job_primary(job) and not os.path.isfile(checks_script(ctx, job)):
        raise FxError("no checks script %s in the factory repository: write it (it runs in the repository's clone) and "
                      "commit it" % os.path.relpath(checks_script(ctx, job), ctx.factory), code=3)
    wt = job["worktree"]
    if not wt:
        raise FxError("%s has no clones yet: intake names its repositories, then fx repos clones them" % job["id"], code=3)
    if not os.path.isdir(wt):
        raise FxError("the job's clone %s is missing. If its branch was pushed: `%s stage %s handed-off --force`, "
                      "then `/auto-factory:code rework %s`; otherwise start a new attempt of %s" % (
                          wt, FX_CMD, job["id"], job["issue_key"], job["issue_key"]), code=3)
    bl_cfg = baselines_config(ctx)
    bl_pre = baselines_refresh(ctx, bl_cfg, hold=True) if bl_cfg else None  # before anything reads checks.sh
    bl_cfg = baselines_config(ctx)
    # From here on a commit to the settings is seen at the end; one made before is checked right below.
    settings_at = git(["rev-parse", "--verify", "-q", "HEAD"], ctx.factory, check=False).stdout.strip()
    # Exit 3, not a failed gate for the builder to work on: nobody makes these by accident, so a human hears of it.
    refusal = factory_settings_refusal(ctx, job) or history_rewrites_text(ctx, job)
    if refusal:
        raise FxError(refusal, code=3)
    allowed = job_override(ctx, job, keep=True, at=settings_at or None)  # as committed: checked just above, like the settings
    job_base_from_remote(ctx, job)
    head = git(["rev-parse", "HEAD"], wt).stdout.strip()  # the commit this round judges
    work = gate_work(ctx, job)  # and what else the builder left for it
    job["round"] += 1
    rn = job["round"]
    rdir = os.path.join(ctx.job_dir(job["id"]), "round-%d" % rn)
    os.makedirs(rdir, exist_ok=True)
    job["skipped_checks"], job["security_skipped"], job["security_missed"] = [], [], []  # describe this round only
    build_md = os.path.join(ctx.job_dir(job["id"]), "build.md")
    if os.path.exists(build_md):
        # Move, not copy: the next round must not see this round's STATUS line.
        os.replace(build_md, os.path.join(rdir, "build.md"))
    problems = [job_off_its_branch(job)] if job_off_its_branch(job) else []

    tracked, untracked = worktree_dirt(ctx, wt)
    if bl_cfg and bl_cfg["repo"] == "project":  # recorded, not committed yet: the list waits for its images on S3
        tracked = "\n".join(l for l in tracked.splitlines() if l.split(None, 1)[-1].strip('"') != bl_cfg["manifest"])
    if tracked:
        problems.append("Uncommitted changes to tracked files (commit them):\n" + tracked)
    if untracked:
        problems.append("Untracked files that are not in any commit (commit them, delete them, or add "
                        "build artifacts to .gitignore):\n" + "\n".join(untracked[:50]))
    clean = not tracked and not untracked
    files = changed_files(job)
    if not files:
        problems.append("The branch has no commits beyond %s." % job["base_ref"])
    prot = ctx.c("protected_paths", []) or []
    frozen = ctx.c("frozen_paths", [".claude/*"]) or []
    unprotected = []
    for status, paths in files:
        old = paths[0]
        if any(match_any(p, frozen) for p in paths):
            problems.append("Frozen path changed: %s (frozen_paths in factory.json may not be touched by a job)"
                            % " -> ".join(paths))
        elif status in ("M", "D", "R") and match_any(old, prot) and match_any(old, allowed.get("unprotect") or []):
            unprotected.append(old)  # a human allowed this job to change this existing test
        elif status in ("M", "D", "R") and match_any(old, prot):
            problems.append("Protected file %s: %s (existing tests may not be modified or deleted; "
                            "add new test files instead)" % ({"M": "modified", "D": "deleted",
                                                              "R": "renamed"}[status], old))
    all_paths = [p for _, ps in files for p in ps]
    scanner_files = sorted({p for p in all_paths if match_any(p, SCANNER_SETTINGS)})
    flags = sorted({p for p in all_paths if match_any(p, ctx.c("sensitive_paths", []) or [])} | set(scanner_files))
    ui_hit = [p for p in all_paths if match_any(p, ctx.c("ui_paths", []) or [])]

    lanes_read = lane_reads(ctx, job)  # where this job reads the folders a lane protects: its own copy, or the folder
    bl = baselines_gate(ctx, bl_cfg, job, rdir, bl_pre, lanes_read) if bl_cfg else None
    if bl:
        problems += bl["problems"]
    checks_out, checks_ok, cr, copies = "", True, None, {}
    place.count = not problems  # a round that stops before its checks says nothing about what a gate uses
    if not problems:
        made = lane_copies(ctx, job, lanes_read)
        copies = made["copies"]
        problems += made["problems"]
    if not problems:
        # The checks script, once for this commit. When it already passed on this very commit with the very same script,
        # settings and files (the builder's `fx checks`, or an earlier round's run), that pass is the result: running
        # it again would be the same step on the same bytes. Nothing else of the round is left out for it, and a
        # failure is never taken over: see the checks section.
        cr = checks_once(ctx, job, os.path.join(rdir, "checks.log"), "gate", rn=rn, place=place)
        checks_out, checks_ok = cr["output"], cr["ok"]
        if cr["reused"] != (place.lease.get("kind") == GATE_AFTER_CHECKS):
            place.count = False  # counted as one kind of gate and it turned out the other: nothing to learn from it
        if cr["problem"]:
            problems.append(cr["problem"])
        if cr["outside"]:
            first = outside_stop_first(job, head)
            write_atomic(os.path.join(rdir, "outside-stop.json"), json.dumps(
                dict(cr["outside"], commit=head, round=rn, run=cr["id"], the_round_counts=not first), indent=1,
                ensure_ascii=False) + "\n")
            if first:
                seen = {"commit": head, "round": rn, "at": now(), "why": cr["outside"]["why"][:300]}
                gate_void(ctx, job["id"], rn, rdir, place,
                          "the checks failed, but not by anything the code did: %s. What was seen is kept in "
                          "outside-stop.json in the round's folder" % cr["outside"]["why"],
                          also=lambda j: j.setdefault("outside_stops", []).append(seen))
            problems.append("part of the checks was stopped from outside again (%s). A round on this commit was already put "
                            "aside for that, so this one counts: if the code is not at fault, find out what stops this "
                            "job's containers (round-%d/outside-stop.json)" % (cr["outside"]["why"], rn))

    if not problems and logic_ready(ctx):
        sdir, snames = staged_logic(ctx, job)
        if logic_changes_planned(ctx, job) and not snames:
            problems.append("the spec lists logic changes but no updated logic file was staged in the job folder's "
                            "logic/ (see the 'Logic updates' line of the builder prompt)")
        if snames:
            lres = logic_check(ctx, sdir, wt, only=snames, check_index=False)
            if lres["problems"]:
                problems.append("staged logic files do not pass the check:\n" + "\n".join(lres["problems"][:20]))
            base = job.setdefault("logic_base", {})
            for n in snames:
                if n not in base:  # what logic/ held when this job started changing the file
                    base[n] = file_hash(os.path.join(logic_dir(ctx), n))
    if ui_hit and "ui" not in job.get("surfaces", []):
        job["surfaces"] = list(job.get("surfaces", [])) + ["ui"]
        ui_added = True
    else:
        ui_added = False
    jd = ctx.job_dir(job["id"])
    ui_script = os.path.join(jd, "ui", "check.js")
    ui_wanted = ("ui" in job.get("surfaces", [])) and ctx.c("ui_checks.enabled", True)
    e2e_out, ui_rep, sec = "", None, None
    app_url_ = None
    if not problems:
        place.next(GATE_APP)  # the checks are over: their place goes back, and the app and the scans wait for theirs
    if not problems and ctx.c("app.up"):
        try:
            app_stop(ctx, job)
            app_url_ = app_start(ctx, job)["url"]
        except FxError as e:
            if e.extra.get("port_taken"):
                gate_void(ctx, job["id"], rn, rdir, place, str(e))
            problems.append("the app could not start: %s" % e)
    if not problems and app_url_ and os.path.exists(os.path.join(jd, "ui", "seed.sh")):
        if not run_seed(ctx, job, os.path.join(jd, "ui", "seed.sh"), rdir):
            problems.append("ui/seed.sh failed (round-%d/seed.log)" % rn)
    if not problems and app_url_ and ctx.c("e2e"):
        env, db = app_env(ctx, job)
        env["BASE_URL"] = app_url_.rstrip("/")
        try:
            p = run(["bash", "-lc", app_fill(ctx.c("e2e"), job, db)], cwd=wt, check=False, env=env,
                    timeout=int(ctx.c("e2e_timeout_sec", 1800)), group=True)
            e2e_out = p.stdout or ""
            if p.returncode != 0:
                problems.append("e2e tests exited with %d (see round-%d/e2e.log)" % (p.returncode, rn))
        except subprocess.TimeoutExpired:
            problems.append("e2e tests timed out after %ss" % ctx.c("e2e_timeout_sec", 1800))
        write_atomic(os.path.join(rdir, "e2e.log"), e2e_out)
    if not problems and ui_wanted:
        if not ctx.c("app.up"):
            job["skipped_checks"].append("UI checks skipped: no app.up command to run the app "
                                         "(set it with /auto-factory:code init)")
        elif not os.path.exists(ui_script):
            problems.append("this change is user-visible but the builder wrote no ui/check.js "
                            "(a Playwright check of the UI acceptance criteria) in the job folder")
        else:
            ui_rep = ui_run(ctx, job, ui_script, os.path.join(rdir, "ui"))
            write_atomic(os.path.join(rdir, "ui.md"), ui_markdown(ui_rep))
            if ui_rep.get("skipped"):
                job["skipped_checks"].append(ui_rep["skipped"])
            elif ui_rep["blocking"]:
                problems.append("UI check failed: %d blocking issue(s), see round-%d/ui.md"
                                % (len(ui_rep["blocking"]), rn))
    if not problems:
        # Always: a factory.json without security.scanners means the template's defaults (all on). Every scanner runs.
        # Only ZAP may judge again what it found last round instead of scanning again, and only where zap_stored says so.
        sec = run_security(ctx, job, rdir, app_url_, zap_from=zap_stored(ctx, job, rn, head))
        write_atomic(os.path.join(rdir, "security.md"), security_markdown(sec))
        job["security_skipped"] = sec["skipped"]
        job["security_missed"] = sec["missed"]
        flags = sorted(set(flags) | set(sec["flags"]))
        if sec["required_failed"]:
            problems.append("required security scanner(s) did not run (security.required in factory.json): %s"
                            % "; ".join(sec["required_failed"]))
        if sec["blocking"]:
            problems.append("security scan: %d blocking finding(s) introduced by this job, see round-%d/security.md"
                            % (len(sec["blocking"]), rn))
    elif problems and files and scanners_on(ctx)["gitleaks"]:
        # Secrets are checked every round, even when the rest of the gate stopped early.
        mb = git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
        leaks, err, _ = scan_secrets(ctx, job, mb, rdir)
        if leaks:
            sec = {"findings": leaks, "blocking": leaks,
                   "skipped": ["other scanners: not run, the gate stopped earlier"]}
            write_atomic(os.path.join(rdir, "security.md"), security_markdown(sec))
            problems.append("secrets committed on the branch: %d (see round-%d/security.md); remove them from the "
                            "unpushed history, not just the latest commit: `git reset --soft %s`, take them out, "
                            "commit again" % (len(leaks), rn, unpushed_base(job)[:12]))

    # checks.sh runs the project's code, which could reach them too, and the scanners came after it.
    changed = factory_dirty(ctx, job) or factory_changed_since(ctx, settings_at, job)
    if changed:
        gate_void(ctx, job["id"], rn, rdir, place, "the gate's settings changed while it ran, so what this round found "
                                                   "is not what the settings now ask for:\n" + changed)
    job.pop("void", None)
    passed = not problems
    tail = "\n".join(checks_out.splitlines()[-150:])
    md = ["GATE: %s" % ("PASS" if passed else "FAIL"), "", "Round %d. Branch %s." % (rn, job["branch"]), ""]
    if problems:
        md += ["## Problems", ""] + ["- " + p.replace("\n", "\n  ") for p in problems] + [""]
    skipped_all = job["skipped_checks"] + job["security_skipped"]
    if skipped_all:
        md += ["## Skipped checks", ""] + ["- " + x for x in skipped_all] + [""]
    if bl:
        md += bl["markdown"]
    if allowed:
        md += ["## Allowed for this job by a human (%s; approver must look)" % override_rel(job), "",
               "- Approved: %s" % allowed["approved"].strip()]
        md += ["- Existing test changed with that permission: %s" % f for f in sorted(set(unprotected))]
        md += ["- Existing tests it may change, not changed so far: %s" % g for g in allowed.get("unprotect") or []
               if not any(match_any(f, [g]) for f in unprotected)]
        md += ["- Finding accepted for this job: %s in %s (%s)" % (e["rule"], e.get("path") or "every file", e["reason"])
               for e in allowed.get("accepted_rules") or []] + [""]
    if flags:
        md += ["## Sensitive paths touched (approver must look)", ""] + ["- " + f for f in flags] + [""]
    if scanner_files:
        md += ["## Scanner settings changed (they can hide findings; fx's scans ignore them, a human must look)",
               ""] + ["- " + f for f in scanner_files] + [""]
    if sec is not None and sec.get("notes"):
        md += ["## Security notes", ""] + ["- " + n for n in sec["notes"]] + [""]
    if checks_out:
        md += ["## checks.sh output (last 150 lines, full log in checks.log)", "", "```", tail, "```", ""]
    elif cr is not None and cr["reused"]:
        md += ["## checks.sh", "", cr["note"], ""]
    if copies:
        md += ["## Folders shared with other jobs", ""] + [
            "- `%s`: this job read it as committed (%s), from its own copy in %s. Only the job that holds the %s lane "
            "works in the folder itself." % (p_, c["commit"][:12], c["dir"], c["lane"]) for p_, c in sorted(copies.items())] + [""]
    if e2e_out:
        md += ["## e2e output (last 100 lines, full log in e2e.log)", "", "```",
               "\n".join(e2e_out.splitlines()[-100:]), "```", ""]
    if ui_rep is not None:
        md += ["## UI check", "", "See ui.md and the screenshots under ui/shots/ in this round's folder.", ""]
        md += ["- " + b for b in ui_rep.get("blocking", [])[:30]] + [""]
    if sec is not None:
        md += ["## Security scan", "", "See security.md in this round's folder.", ""]
        md += ["- %s %s %s: %s" % (f["severity"], f["tool"], f.get("location"), f.get("message"))
               for f in sec["blocking"][:30]] + [""]
    write_atomic(os.path.join(rdir, "checks.md"), "\n".join(md) + "\n")

    notes = []
    job["gate"] = "PASS" if passed else "FAIL"
    job["flags"] = flags
    if flags and job.get("risk") == "low":
        job["risk"] = "high"
        notes.append("risk raised to high: sensitive paths changed")
    if ui_added:
        notes.append("UI reviewers added: UI files changed")
        try:
            lane_take(ctx, job)
        except FxError as e:
            if e.code != EXIT_WAIT:
                raise
            notes.append("this job turned out to change the UI, and %s holds the %s lane: its next build waits for that job"
                         % (e.extra.get("held_by"), e.extra.get("lane")))
    if notes:
        route(ctx, job)
    if scanner_files:
        notes.append("scanner settings changed by the job (a human must look): %s" % ", ".join(scanner_files))
    if unprotected:
        notes.append("existing tests changed with a human's permission (%s): %s" % (override_rel(job), ", ".join(sorted(set(unprotected)))))
    if sec is not None:
        notes += sec.get("notes") or []
    if cr is not None and cr["reused"]:
        notes.append(cr["note"])
    # What this round ran on, kept for the next ones: a pass on the same commit gives failed rounds back
    # (rounds_give_back), and a round that failed at the security scan alone may have its ZAP reports judged again
    # once a human accepted findings (zap_stored).
    entry = {"round": rn, "commit": head, "work": work, "clean": clean, "gate": job["gate"], "at": now()}
    if cr is not None:
        entry["inputs"] = cr.get("fingerprint")  # what the checks read besides the commit (see rounds_give_back)
    if not passed:
        entry["failed_at"] = "security" if len(problems) == 1 and sec is not None and sec.get("blocking") \
            and not sec.get("required_failed") and "ran" in sec else "checks" if cr is not None and not cr["ok"] else "other"
    if sec is not None and "ran" in sec:
        entry["accepted"] = accepted_mark(ctx, job)
        if sec.get("zap_scan"):
            entry["zap"] = sec["zap_scan"]
    job.setdefault("gate_rounds", []).append(entry)
    given = rounds_give_back(job, entry) if passed else []
    if given:
        notes.append("round%s %s failed on this same commit, which now passes with nothing of the builder's changed: no "
                     "builder was needed, so %s not count against the job's rounds"
                     % ("s" if len(given) > 1 else "", ", ".join(str(n) for n in given), "they do" if len(given) > 1 else "it does"))

    res = {"job": job["id"], "round": rn, "gate": job["gate"], "report": os.path.join(rdir, "checks.md"),
           "flags": flags, "notes": notes, "skipped": skipped_all, "rounds_left": rounds_left(job)}
    if cr is not None:
        res["checks"] = checks_answer(cr)
    if sec is not None and (sec.get("zap_scan") or {}).get("from_round"):
        res["zap"] = {"scanned_again": False, "judged_again_from_round": sec["zap_scan"]["from_round"],
                      "scanned": sec["zap_scan"].get("scanned")}
    if given:
        res["rounds_given_back"] = given
    if copies:
        res["lanes"] = {p_: {"read_from": c["dir"], "as_committed_at": c["commit"][:12], "variable": c["var"]}
                        for p_, c in sorted(copies.items())}
    if bl:
        notes += ["baselines: " + w for w in bl["summary"]["warnings"]]
        res["baselines"] = {k: bl["summary"][k] for k in ("counts", "fetched", "unrecorded", "pulled")}
        res["baselines"]["pending_push"] = len(bl["summary"]["pending_push"])
        if sum(bl["summary"]["counts"].values()):
            notes.append("baselines changed (%(changed)d changed, %(added)d added, %(removed)d removed): see "
                         "baselines.md in this round's folder" % bl["summary"]["counts"])
    if passed:
        job["reviews"] = {r: "pending" for r in job["reviewers"]}
        job["checks_passed_at"] = git(["rev-parse", "HEAD"], wt).stdout.strip()
        ctx.move(job, "review", "gate PASS round %d" % rn)
        res.update(next="review", reviewers=job["reviewers"],
                   models={r: job["models"][r] for r in job["reviewers"]})
    elif rounds_left(job) > 0:
        job["build_reason"] = "feedback"
        ctx.save(job, "gate FAIL round %d" % rn)
        res["next"] = "build"
    else:
        job["needs_human"] = True
        job["incomplete"] = True
        job["handoff_reason"] = "gate still failing after %d rounds" % job["max_rounds"]
        ctx.move(job, "pr", "rounds exhausted at gate")
        res["next"] = "pr"
    out(res)


VERIFY_LINE_RE = re.compile(r"^\s*\d+\.\s*\**\s*(confirmed|rejected|unsure)\b", re.I)


def verify_verdict(job, rdir, verdict):
    """The verifier's verdict only counts when verify-security.md answers every [blocking] finding of
    review-security.md (one confirmed|rejected|unsure line each) and agrees with its own lines: a bare
    `VERDICT: PASS` cannot clear the findings."""
    review = read(os.path.join(rdir, "review-security.md"), "") or ""
    verify = read(os.path.join(rdir, "verify-security.md"), "") or ""
    n_block = sum(1 for l in review.splitlines() if FINDING_RE.match(l))
    answers = [m.group(1).lower() for m in (VERIFY_LINE_RE.match(l) for l in verify.splitlines()) if m]
    if len(answers) != n_block:
        raise FxError("round-%d/verify-security.md answers %d finding(s) but review-security.md has %d [blocking] "
                      "finding(s); it needs one numbered `confirmed | rejected | unsure: …` line per finding"
                      % (job["round"], len(answers), n_block), code=6, extra={"retry_agent": "verifier"})
    if verdict == "PASS" and any(x != "rejected" for x in answers):
        raise FxError("round-%d/verify-security.md says VERDICT: PASS but keeps %d finding(s) confirmed or unsure; "
                      "the verdict must be CHANGES then" % (job["round"], sum(x != "rejected" for x in answers)),
                      code=6, extra={"retry_agent": "verifier"})
    return verdict


def cmd_verdicts(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "review":
        raise FxError("job is in stage %s, not review" % job["stage"])
    rdir = os.path.join(ctx.job_dir(job["id"]), "round-%d" % job["round"])
    missing, changes, need_verify = [], [], []
    for r in job["reviewers"]:
        line = first_line(os.path.join(rdir, "review-%s.md" % r))
        if line is None:
            missing.append(r)
            job["reviews"][r] = "pending"
            continue
        m = VERDICT_RE.match(line)
        if not m:
            raise FxError("round-%d/review-%s.md starts with %r, not VERDICT: PASS|CHANGES"
                          % (job["round"], r, line), code=6, extra={"retry_agent": r})
        verdict = m.group(1)
        if r == "security" and verdict == "CHANGES" and not any(
                FINDING_RE.match(l) for l in (read(os.path.join(rdir, "review-security.md"), "") or "").splitlines()):
            # Findings the script cannot count: the verifier could never answer them, and a bare PASS would clear them.
            raise FxError("round-%d/review-security.md says CHANGES but lists no numbered `N. [blocking]` finding"
                          % job["round"], code=6, extra={"retry_agent": "security"})
        if r == "ui":
            # every screen the round's UI check measured against the design is answered, a heavy one never as fine
            problems, code_said = design_table_problems(read(os.path.join(rdir, "review-ui.md"), "") or "",
                                                        design_measured([os.path.join(rdir, "ui", "ui-report.json")]))
            if code_said and verdict != "CHANGES":
                problems.append("says under `## Design` that the code is wrong on a screen, so its verdict is CHANGES, "
                                "with a [blocking] finding for it")
            if problems:
                raise FxError("round-%d/review-ui.md %s" % (job["round"], "; ".join(problems)), code=6,
                              extra={"retry_agent": "ui"})
        if r == "security" and verdict == "CHANGES" and ctx.c("security.verify_findings", True):
            vline = first_line(os.path.join(rdir, "verify-security.md"))
            if vline is None:
                need_verify.append(r)
                job["reviews"][r] = "verifying"
                continue
            vm = VERDICT_RE.match(vline)
            if not vm:
                raise FxError("round-%d/verify-security.md starts with %r, not VERDICT: PASS|CHANGES"
                              % (job["round"], vline), code=6, extra={"retry_agent": "verifier"})
            verdict = verify_verdict(job, rdir, vm.group(1))
        job["reviews"][r] = verdict
        if verdict == "CHANGES":
            changes.append(r)
    res = {"job": job["id"], "round": job["round"], "reviews": job["reviews"]}
    if missing:
        ctx.save(job)
        res.update(next="wait", missing=missing)
    elif need_verify:
        ctx.save(job, "security findings sent for independent verification")
        res.update(next="verify", verify=need_verify)
    elif not changes:
        ctx.move(job, "approve", "all reviews PASS round %d" % job["round"])
        res["next"] = "approve"
    elif rounds_left(job) > 0:
        job["build_reason"] = "feedback"
        ctx.move(job, "build", "CHANGES from %s" % ", ".join(changes))
        res.update(next="build", changes=changes, rounds_left=rounds_left(job))
    else:
        job["needs_human"] = True
        job["incomplete"] = True
        job["handoff_reason"] = "review rounds exhausted; outstanding CHANGES from %s" % ", ".join(changes)
        ctx.move(job, "pr", "rounds exhausted at review")
        res.update(next="pr", changes=changes)
    out(res)


def parse_questions(text):
    qs = []
    for block in re.split(r"(?m)^##\s+", text or ""):
        block = block.strip()
        if not block:
            continue
        head = block.splitlines()[0].strip()
        if re.match(r"^Q\d+", head, re.I):
            qs.append(head)
    return qs


def parse_answers(text):
    pairs = []
    for block in re.split(r"(?m)^##\s+", text or ""):
        block = block.strip()
        if not block or not re.match(r"^Q\d+", block, re.I):
            continue
        lines = block.splitlines()
        ans = ""
        for l in lines[1:]:
            m = re.match(r"^Answer:\s*(.*)$", l.strip(), re.I)
            if m:
                ans = m.group(1).strip()
        pairs.append((lines[0].strip(), ans or "-"))
    return pairs


def cmd_answers(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "needs-info":
        raise FxError("job is in stage %s, not needs-info" % job["stage"])
    jd = ctx.job_dir(job["id"])
    qpath = os.path.join(jd, "questions.md")
    qtext = read(qpath, "")
    if not qtext.strip():
        raise FxError("questions.md is missing or empty; nothing to answer")
    questions = parse_questions(qtext)
    if a.from_jira:
        answers = "Answered on Jira; the replies are in the comments of issue.md (refreshed).\n"
        if not job.get("jira_base"):
            raise FxError("%s is a local task with no Jira issue" % job["id"])
        if jira_mode(ctx) == "api":
            jira_fetch_into(ctx, jd, job["jira_base"], job["issue_key"], designs=bool(ctx.c("ui_checks.enabled", True)))
            job = job_design_unpack(ctx, job)
    else:
        answers = read(os.path.join(jd, "answers.md"), "")
        if not answers.strip():
            raise FxError("answers.md is missing or empty")
        answered = parse_questions(answers)
        if questions and len(answered) < len(questions):
            raise FxError("answers.md covers %d of %d questions" % (len(answered), len(questions)))
    back = job["resume_stage"]
    k = 1
    while os.path.exists(os.path.join(jd, "questions-%d.md" % k)):
        k += 1
    os.replace(qpath, os.path.join(jd, "questions-%d.md" % k))
    if os.path.exists(os.path.join(jd, "answers.md")):
        os.replace(os.path.join(jd, "answers.md"), os.path.join(jd, "answers-%d.md" % k))
    # The asking agent's result file is stale now; the re-run must write a fresh one.
    stale = {"intake": "intake.md", "spec": "spec.md", "build": "build.md"}.get(back)
    if stale and os.path.exists(os.path.join(jd, stale)):
        os.replace(os.path.join(jd, stale), os.path.join(jd, "%s-asked-%d.md" % (stale[:-3], k)))
    log = read(os.path.join(jd, "qa-log.md"), "# Questions and answers\n")
    log += "\n## Round %d (asked by %s, %s)\n\n### Questions\n\n%s\n\n### Answers\n\n%s\n" % (
        k, back, now()[:16], qtext.strip(), answers.strip())
    write_atomic(os.path.join(jd, "qa-log.md"), log)
    job["resume_stage"] = None
    if back == "build":
        job["build_reason"] = "answers"
    woke = stack_wake(job)  # what was stopped while the job waited for these answers
    ctx.move(job, back, "answers recorded (set %d)" % k)
    posted = None
    if not a.from_jira and not a.no_jira:
        pairs = parse_answers(answers)
        if pairs:
            listing = "\n".join("- %s → **%s**" % (q, ans) for q, ans in pairs)
        else:
            listing = answers.strip()
        body = "**Software factory: clarifications for %s**\n\n%s" % (job["issue_key"], listing)
        posted = jira_comment(ctx, job, body)
    finish(ctx, dict({"ok": True, "job": job["id"], "next": back, "qa_log": os.path.join(jd, "qa-log.md"),
                      "posted_to_jira": posted}, **({"stack_started": woke} if woke else {})), job)


def cmd_ask_jira(ctx, a):
    job = ctx.load(a.job)
    if not job.get("jira_base"):
        raise FxError("%s is a local task with no Jira issue; ask the user in the session" % job["id"])
    if job["stage"] != "needs-info":
        raise FxError("job is in stage %s, not needs-info" % job["stage"])
    qtext = read(os.path.join(ctx.job_dir(job["id"]), "questions.md"), "")
    body = ("**Software factory needs information before continuing %s.**\n\n%s\n\n"
            "Reply in a comment, then run `/auto-factory:code resume %s`." % (job["issue_key"], qtext.strip(), job["issue_key"]))
    r = jira_comment(ctx, job, body, force=True)
    if "error" in r:
        raise FxError("could not post the questions to Jira: %s" % r["error"], code=4)
    ctx.save(job, "questions posted to Jira")
    finish(ctx, {"ok": True, "job": job["id"], "jira": r, "next": "stop"}, job)


def jira_safe(ctx, fn):
    """Jira updates must never stop the pipeline: report the error and carry on."""
    try:
        r = fn()
        return r if isinstance(r, dict) and ("moved" in r or "skipped" in r) else {"ok": True}
    except Exception as e:  # noqa: BLE001 - a Jira problem must never break a job
        hint("fx: Jira update failed: %s" % e)
        return {"error": str(e)}


def jira_transition(ctx, job, which):
    target = ctx.c("jira.transitions.%s" % which, which)
    if not target:
        return {"skipped": "no %s transition configured" % which}
    j = Jira(job["jira_base"])
    data = j.issue(job["issue_key"])
    current = value_to_md((data.get("fields") or {}).get("status"))
    if current.lower() == target.lower():
        return {"skipped": "already %s" % current}
    for t in j.transitions(job["issue_key"]):
        to = ((t.get("to") or {}).get("name") or "")
        if to.lower() == target.lower() or (t.get("name") or "").lower() == target.lower():
            j.transition(job["issue_key"], t["id"])
            return {"moved": "%s -> %s" % (current, to)}
    hint("fx: no Jira transition to %r from %r; leaving status unchanged" % (target, current))
    return {"skipped": "no transition to %s from %s" % (target, current)}


def jira_mode(ctx):
    """api: fx calls Jira with JIRA_EMAIL/JIRA_API_TOKEN. agent: no token, so fx queues the
    Jira work (jira_todo) and the orchestrator does it with its own Jira connection."""
    m = (ctx.c("jira.mode", "auto") or "auto").lower()
    if m in ("api", "agent"):
        return m
    return "api" if os.environ.get("JIRA_EMAIL") and os.environ.get("JIRA_API_TOKEN") else "agent"


def site_of(base):
    return urllib.parse.urlparse(base).netloc or base


def pending(job):
    return [i for i in job.get("jira_todo", []) if not i.get("done")]


def queue(job, action, **kw):
    n = int(job.get("jira_seq", 0)) + 1
    job["jira_seq"] = n
    item = {"id": "j%d" % n, "action": action, "issue": job["issue_key"], "site": site_of(job["jira_base"])}
    item.update(kw)
    job.setdefault("jira_todo", []).append(item)
    return {"queued": item["id"]}


def jira_comment(ctx, job, markdown, force=False):
    if not job.get("jira_base"):
        return {"skipped": "local task, no Jira issue"}
    if not force and not ctx.c("jira.comment", True):
        return {"skipped": "jira.comment is off"}
    # Comments quote the agents' files (spec, questions, reasons): never post a secret they contain.
    markdown, hits = scrub_text(ctx, markdown)
    if jira_mode(ctx) == "agent":
        r = queue(job, "comment", markdown=markdown)
    else:
        r = jira_safe(ctx, lambda: Jira(job["jira_base"]).comment(job["issue_key"], md_to_adf(markdown)))
    if hits:
        r["redacted"] = hits
    return r


def jira_move(ctx, job, which):
    if not job.get("jira_base"):
        return {"skipped": "local task, no Jira issue"}
    target = ctx.c("jira.transitions.%s" % which, which)
    if not target:
        return {"skipped": "no %s transition configured" % which}
    if jira_mode(ctx) == "agent":
        return queue(job, "transition", to=target)
    return jira_safe(ctx, lambda: jira_transition(ctx, job, which))


def jira_assign(ctx, job, account_id):
    if jira_mode(ctx) == "agent":
        return queue(job, "assign", account_id=account_id)
    return jira_safe(ctx, lambda: Jira(job["jira_base"]).assign(job["issue_key"], account_id))


def finish(ctx, res, job, push=False, names=None):
    """Save the job and print the result, listing any Jira work still to do. push: the job has reached its end, so it
    goes to the jobs store, as what it is after this last save."""
    p = pending(job)
    if p:
        res["jira_todo"] = p
    ctx.save(job)
    if push:
        mark_step(ctx, job["id"], "push", False)  # the last write to the job, which main would make after this push
        jobs_after_step(ctx, res, names or [job["id"]])
    out(res)


def cmd_jira(ctx, a):
    job = ctx.load(a.job)
    if not job.get("jira_base"):
        raise FxError("%s is a local task with no Jira issue" % job["id"])
    if a.action == "fetch":
        path = os.path.join(ctx.job_dir(job["id"]), "issue.md")
        if jira_mode(ctx) == "agent":
            out({"ok": True, "job": job["id"], "next": "fetch", "issue_key": job["issue_key"],
                 "site": site_of(job["jira_base"]), "write_to": path})
            return
        jira_fetch_into(ctx, ctx.job_dir(job["id"]), job["jira_base"], job["issue_key"],
                        designs=bool(ctx.c("ui_checks.enabled", True)))
        job = job_design_unpack(ctx, job)
        out({"ok": True, "job": job["id"], "issue": path, "design": (job.get("design") or {}).get("files") or []})
    elif a.action == "comment":
        text = sys.stdin.read() if a.arg in (None, "-") else read(a.arg)
        if not text or not text.strip():
            raise FxError("nothing to post")
        finish(ctx, {"ok": True, "job": job["id"], "jira": jira_comment(ctx, job, text, force=True)}, job)
    elif a.action == "transition":
        r = jira_move(ctx, job, a.arg or "start")
        if a.arg in (None, "start") and "error" not in r:
            job["jira_started"] = True
        finish(ctx, {"ok": True, "job": job["id"], "jira": r}, job)


def cmd_jira_done(ctx, a):
    job = ctx.load(a.job)
    todo = job.get("jira_todo", [])
    known = {i["id"] for i in todo}
    unknown = [i for i in (a.ids or []) if i not in known]
    if unknown:
        raise FxError("unknown jira_todo ids: %s" % ", ".join(unknown))
    marked = []
    for it in todo:
        if not it.get("done") and (a.all or it["id"] in (a.ids or [])):
            it["done"] = ("failed: %s" % a.failed) if a.failed else "done"
            marked.append(it["id"])
    ctx.save(job, "jira todo %s %s" % (",".join(marked) or "-", "failed" if a.failed else "done"))
    res = {"ok": True, "job": job["id"], "marked": marked, "jira_todo": pending(job)}
    if job["stage"] in TERMINAL and not pending(job):
        jobs_after_step(ctx, res, [job["id"]])  # fx pr pushed it with this work still to do
    elif job.get("kind") == "review" and job["stage"] == "done" and not pending(job) and review_kept(ctx):
        jobs_after_step(ctx, res, [job["id"]])
    out(res)


def remote_provider(ctx, job, repo=None):
    """(provider, URL) of a repository of the job (its pr.provider, else read from its URL): repo, else a view's, else
    the job's first changed one."""
    job = job or {}
    name = repo or job.get("repo") or (job_primary(job) if isinstance(job.get("repos"), dict) else None) or (
        ctx.repo_names()[0] if ctx.repos else None)
    if name and name in ctx.repo_names():
        forced, url = ctx.rc(name, "pr.provider"), ctx.url(name)
    else:
        forced, url = ctx.c("pr.provider"), ctx.c("project.url") or ""
    if forced:
        return forced, url
    if "github.com" in url:
        return "github", url
    if "gitlab" in url:
        return "gitlab", url
    if "bitbucket.org" in url:
        return "bitbucket", url
    return "unknown", url


def section(md, title):
    m = re.search(r"(?ms)^##\s+%s[^\n]*\n(.*?)(?=^##\s|\Z)" % re.escape(title), md or "")
    return m.group(1).strip() if m else ""


def pr_body(ctx, job, repo=None, links=None):
    """A pull request's description. In a job of several repositories, repo's: it lists the other repositories' pull
    requests (links: {name: where}, else what the job knows), and carries that repository's part of the spec."""
    jd = ctx.job_dir(job["id"])
    spec = read(os.path.join(jd, "spec.md"), "")
    decision = read(os.path.join(jd, "decision.md"), "")
    names = (list(links) if links else job_names(job, "change")) if is_whole_job(job) else []
    several = repo is not None and len(names) > 1
    e = job["repos"][repo] if repo is not None and is_whole_job(job) else job
    if job.get("issue_url"):
        parts = ["Jira: [%s](%s) %s" % (job["issue_key"], job["issue_url"], job.get("summary", "")), ""]
    else:
        parts = ["Local task %s: %s" % (job["issue_key"], job.get("summary", "")), ""]
    tb = e.get("target_branch") or e.get("base_branch")
    parts += ["Into `%s`, built from `%s`." % (tb, e.get("base_branch")), ""]
    if job.get("needs_human"):
        parts += ["> **Needs a human:** %s" % job.get("handoff_reason"), ""]
    if several:
        links = links or {}
        parts += ["## Pull requests of this issue", "",
                  "This issue changes %d repositories. Merge them in this order:" % len(names), ""]
        for i, n in enumerate(names, 1):
            where = "this pull request" if n == repo else links.get(n) or pr_where(job["repos"][n])
            parts.append("%d. %s: %s" % (i, n, where))
        parts.append("")
        mine = repo_section(spec, repo)
        if mine:
            parts += ["## This repository's part", "", mine, ""]
        contract = section(spec, "Shared contract")
        if contract:
            parts += ["## Shared contract", "", contract, ""]
    goal = section(spec, "Goal")
    if goal:
        parts += ["## Goal", "", goal, ""]
    ac = section(spec, "Acceptance criteria")
    if ac:
        parts += ["## Acceptance criteria", "", ac, ""]
    if decision and job.get("decision"):
        parts += ["## Approver: %s" % job["decision"], "", "\n".join(decision.splitlines()[1:]).strip(), ""]
    if job.get("reviews"):
        parts += ["## Reviews (round %d)" % job["round"], "", "| Reviewer | Verdict | Model |", "|---|---|---|"]
        for r, v in job["reviews"].items():
            parts.append("| %s | %s | %s |" % (r, v, job["models"].get(r, "-")))
        parts.append("")
    rdir = os.path.join(jd, "round-%d" % job["round"])
    ui_line = first_line(os.path.join(rdir, "ui.md"))
    sec_line = first_line(os.path.join(rdir, "security.md"))
    checks = []
    if ui_line:
        shots = len(os.listdir(os.path.join(rdir, "ui", "shots"))) if os.path.isdir(os.path.join(rdir, "ui", "shots")) else 0
        checks.append("- %s (%d screenshots in `jobs/%s/round-%d/ui/shots/` of the factory repository)" % (ui_line, shots, job["id"],
                                                                                        job["round"]))
    if sec_line:
        checks.append("- %s (`round-%d/security.md`)" % (sec_line, job["round"]))
    for sk in (job.get("security_skipped") or []) + (job.get("skipped_checks") or []):
        checks.append("- skipped: %s" % sk)
    if checks:
        parts += ["## Automated checks", ""] + checks + [""]
    bl = (job.get("baselines") or {}) if not several or repo == pr_baselines_repo(ctx, job) else {}
    if bl.get("changes_md"):
        parts += ["## Baselines changed", ""] + bl["changes_md"] + [""]
    if bl.get("unrecorded"):
        parts += ["Baseline files that differed from the list without being recorded were restored by the gate: %s."
                  % ", ".join("`%s`" % p for p in bl["unrecorded"][:10]), ""]
    lc = read(os.path.join(jd, "logic-changes.md"), "") or ""
    if lc.strip():
        parts += ["## Logic changes", "", lc.strip()[:4000], "",
                  "_The factory updates its logic/ folder once %s merged._" % (
                      "every pull request of this issue is" if several else "this pull request is"), ""]
    parts += ["Gate: %s. Rounds used: %d of %d. Risk: %s." % (
        job.get("gate"), rounds_used(job), job["max_rounds"], job.get("risk")), ""]
    if job.get("flags"):
        parts += ["Sensitive paths touched: " + ", ".join("`%s`" % f for f in job["flags"]), ""]
    parts += ["Job files: `jobs/%s/` in the factory repository on the machine that ran it." % job["id"], "",
              "_Generated by the software factory (Claude Code). A human reviews and merges._"]
    return "\n".join(parts) + "\n"


def checks_env(ctx, job):
    """A checks script gets the job's id, its repository's port and its own database name, so parallel runs never share
    test data, and where this job reads the folders a lane protects (lane_env)."""
    ctx, job = one_app(ctx, job)
    return project_env(ctx, FACTORY_JOB=job["id"], FACTORY_PORT=str(job["port"]), FACTORY_DB=app_db(ctx, job),
                       **dict(baselines_env(ctx, job["worktree"]), **lane_env(ctx, job)))


# --------------------------------------------------------------------------
# the checks script: run once on a commit, and remembered
#
# The checks script takes longer than anything else a job does, and it used to run twice on the same commit: by the
# builder, to see that its work passes, and again by the gate. Now fx runs it itself wherever it is asked for (`fx
# checks` for the builder, the gate, fx pr, the candidates' check) and writes down what it ran on: the commit, and a
# fingerprint of everything else the script could read. A pass stands for a later run only on that same commit with that
# same fingerprint, taken anew from what is there now, and only for so long (reuse.max_age_hours).
#
# No step of a job is skipped by this. What is not repeated is one script on the very bytes it already passed on; the
# gate's other steps all still run, in their order. What gets pushed is still checked as it is pushed: fx pr merges the
# target branch first, that is another commit, and the checks run on it as before. A failure is never used again, and
# neither is a run on a clone with uncommitted changes, nor one during which the commit or what the script reads moved.

CHECKS_RECIPE = 1  # raise it when fx changes how it runs the checks script: older passes then stop counting
REUSE_DEFAULTS = {"enabled": True, "max_age_hours": 24}
# In a factory repository, what fx itself owns and the checks never read. Everything else there is theirs to read, and
# goes into the fingerprint by its content, committed or not: the folders that do the checking are among it.
FINGERPRINT_NOT_READ = ("jobs", "knowledge", "logic", OVERRIDES_DIR, ".claude", ".git")
FINGERPRINT_NOT_READ_FILES = ("lessons.md", "knowledge.md", "baseline.json", CONFIG_NAME)
# factory.json: what only says how findings are judged once the checks have run, and how a run is used again. All the
# rest of it counts, known to matter or not: a fingerprint that is too wide only costs a run.
FINGERPRINT_JUDGING = (("security", "accepted_rules"), ("security", "block_severity"), ("reuse",))
FINGERPRINT_READ_MAX = 64 * 1024 * 1024  # a file larger than this is hashed without being looked into
FINGERPRINT_WORDS = {"recipe": "how fx runs the checks script", "script": "the checks script", "settings": "factory.json",
                     "allowed": "the existing tests a human let this job change",
                     "files": "files of the factory repository that the checks read",
                     "lanes": "what is committed in a lane's folder (this job reads its own copy of it)",
                     "images": "the reference images", "local": "the clone's own local files (copy_into_worktree)",
                     "env": "the environment the script runs in"}
# In the environment the checks script gets (checks_env), what only says which process, terminal or window ran it, and
# so says nothing about what the script checks. Everything else counts: SKIP_SLOW=1, another PATH (nvm use, a venv),
# DOCKER_HOST, COMPOSE_PROFILES, APP_ENV... A pass is then used again only by a run that would get the same environment.
ENV_NOT_READ = {"FACTORY_PLACE", "FACTORY_CPUS", "PWD", "OLDPWD", "SHLVL", "_", "TERM", "TERM_PROGRAM", "TERM_PROGRAM_VERSION", "COLORTERM",
                "COLUMNS", "LINES", "PS1", "PS2", "PS4", "PROMPT_COMMAND", "SECURITYSESSIONID", "SSH_AUTH_SOCK", "SSH_AGENT_PID",
                "SSH_CLIENT", "SSH_CONNECTION", "SSH_TTY", "TMUX", "TMUX_PANE", "STY", "WINDOWID", "DISPLAY", "XAUTHORITY",
                "LaunchInstanceID", "__CFBundleIdentifier", "XPC_SERVICE_NAME", "XPC_FLAGS", "Apple_PubSub_Socket_Render",
                "MallocNanoZone", "OSLogRateLimit", "GIT_ASKPASS",
                "FACTORY_MAX_WAIT", "FACTORY_SAMPLE_SEC", "FACTORY_POLL_SEC"}  # how long fx waits and measures, per call
ENV_NOT_READ_GLOBS = ("CLAUDE*", "ANTHROPIC_*", "VSCODE_*", "*_SESSION_ID", "ITERM_*", "KITTY_*", "WEZTERM_*", "WT_*",
                      "ELECTRON_*")
# a variable whose name says it holds a secret is never named in what fx writes, and its value is only in the one hash
ENV_SECRET_LOOKING = re.compile(r"KEY|TOKEN|SECRET|PASS|CRED|AUTH|COOKIE|PRIVATE|SESSION", re.I)
ENV_SECRET_MARK = "(secret-looking)"


def env_read(name):
    """Whether a variable of the checks script's environment counts in its fingerprint (ENV_NOT_READ)."""
    return name not in ENV_NOT_READ and not any(fnmatch.fnmatchcase(name, g) for g in ENV_NOT_READ_GLOBS)


def reuse_config(ctx):
    """The `reuse` block of factory.json, checked: {enabled, max_age_sec, hours}. Without one, a pass is used again for
    24 hours."""
    raw = ctx.c("reuse")
    raw = REUSE_DEFAULTS if raw is None else raw
    if not isinstance(raw, dict):
        raise FxError("reuse in factory.json must be an object like %s" % json.dumps(REUSE_DEFAULTS), code=3)
    enabled, hours = raw.get("enabled", True), raw.get("max_age_hours", REUSE_DEFAULTS["max_age_hours"])
    if not isinstance(enabled, bool):  # a string "false" must not read as yes
        raise FxError("reuse.enabled in factory.json must be true or false, not %r" % (enabled,), code=3)
    if isinstance(hours, bool) or not isinstance(hours, (int, float)) or hours <= 0:
        raise FxError("reuse.max_age_hours in factory.json must be a number above 0, not %r" % (hours,), code=3)
    return {"enabled": enabled, "max_age_sec": float(hours) * 3600, "hours": hours}


def cmd_reuse(ctx, a):
    """How this factory uses a pass of the checks script again, shown, and changed for the person who asked: fx writes
    factory.json itself. With a job: the runs fx keeps for it."""
    path = os.path.join(ctx.factory, CONFIG_NAME)
    changed = a.on or a.off or a.max_age_hours is not None
    if a.on and a.off:
        raise FxError("--on or --off, not both", code=3)
    if changed:
        raw = read(path) or "{}"
        cfg = json.loads(raw)
        block = dict(cfg["reuse"]) if isinstance(cfg.get("reuse"), dict) else {}
        if a.on or a.off:
            block["enabled"] = bool(a.on)
        if a.max_age_hours is not None:
            block["max_age_hours"] = a.max_age_hours
        cfg["reuse"] = dict(REUSE_DEFAULTS, **block)
        m = re.search(r"\n([ \t]+)\S", raw)
        write_atomic(path, json.dumps(cfg, ensure_ascii=False, indent=len(m.group(1)) if m else 2) + "\n")
        ctx.load_config(True)
    conf = reuse_config(ctx)  # says so now when what was asked for is no valid setting
    res = {"ok": True, "reuse": {"enabled": conf["enabled"], "max_age_hours": conf["hours"]},
           "means": ("a pass of the checks script is used again for the same commit, the same checks script, settings and "
                     "files, for %g hours; the ZAP reports of a round are judged again, not scanned again, when a human "
                     "accepted findings on an unchanged commit" % conf["hours"]) if conf["enabled"] else
           "every gate and every fx pr runs the checks script and every scan itself"}
    if changed:
        res["next"] = ("commit factory.json in the factory repository and push it: a gate only runs on settings that are "
                       "committed and pushed")
    if getattr(a, "job", None):
        job = ctx.load(a.job)
        res["job"] = job["id"]
        res["runs"] = [{k: r.get(k) for k in ("id", "result", "commit", "at", "seconds", "by", "round", "cand", "reusable",
                                              "not_reusable", "log") if r.get(k) is not None}
                       for r in job.get("checks_runs") or [] if isinstance(r, dict)]
    out(res)


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode("utf-8", "surrogateescape")).hexdigest()


def file_mark(path):
    """What a file holds, as a hash: a symlink by where it points, a folder (another repository inside this one) by its
    commit and what is changed in it, and "gone" for what cannot be read."""
    try:
        if os.path.islink(path):
            return "link:" + os.readlink(path)
        if os.path.isdir(path):
            head = git(["rev-parse", "HEAD"], path, check=False).stdout.strip()
            return "repo:%s:%s" % (head, digest(git(["status", "--porcelain"], path, check=False).stdout))
        return file_sha256(path)
    except OSError:
        return "gone"


def factory_files(ctx):
    """The files of the factory repository that the checks could read, as paths inside it: every file git tracks there
    and every new one it does not ignore, but for what fx itself owns (FINGERPRINT_NOT_READ). The folders that do the
    checking (a test suite, the scripts of a stack) are among them, committed or not."""
    r = run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=ctx.factory, check=False)
    if r.returncode == 0:
        names = {n.rstrip("/") for n in (r.stdout or "").split("\0") if n}
    else:  # not a git repository: all that is in the folder
        names = set()
        for dirpath, dirnames, files in os.walk(ctx.factory):
            rel = os.path.relpath(dirpath, ctx.factory)
            dirnames[:] = [d for d in dirnames if d != ".git" and not (rel == "." and d in FINGERPRINT_NOT_READ)]
            names.update(os.path.normpath(os.path.join(rel, n)).replace(os.sep, "/") for n in files)
    return sorted(n for n in names if n.split("/", 1)[0] not in FINGERPRINT_NOT_READ and n not in FINGERPRINT_NOT_READ_FILES)


def factory_scan(ctx, words=()):
    """One pass over factory_files: ({path: what it holds}, {word: the files it is written in}). The words are the
    lanes' variables (lane_named); a document that explains one reads nothing, so those are not searched."""
    marks, named = {}, {w: [] for w in words}
    needles = [(w, re.compile(re.escape(w).encode() + rb"(?![A-Za-z0-9_])")) for w in words]
    for rel in factory_files(ctx):
        path = os.path.join(ctx.factory, rel)
        try:
            if os.path.islink(path) or os.path.isdir(path) or os.path.getsize(path) > FINGERPRINT_READ_MAX:
                marks[rel] = file_mark(path)
                continue
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            marks[rel] = "gone"
            continue
        marks[rel] = hashlib.sha256(data).hexdigest()
        if needles and not rel.lower().endswith(LANE_DOC_EXTS):
            for w, rx in needles:
                if rx.search(data):
                    named[w].append(rel)
    return marks, named


def checks_fingerprint(ctx, job, who=None):
    """Everything the checks script could read besides the commit, as {sum, parts}: one hash over all of it, and a short
    one for each part, so that a difference can be named. Taken from what is there now, never from what git remembers:
    the checks script; factory.json without what only judges findings afterwards; the existing tests a human let this
    job change; every other file of the factory repository the checks could read (factory_files), where a folder this
    job reads from its own copy counts by that copy; the reference images, as the baselines step left them; and the
    local files fx copied into the clone. who: a candidate of the job, when not the job itself."""
    who = who or job
    scan = factory_scan(ctx, [lane_var(p) for _, p in lane_folders(ctx)])
    reads = lane_reads(ctx, job, named=lane_named(ctx, scan=scan))
    copied = sorted(p for p, r in reads.items() if r["copy"])
    marks = scan[0]
    full = {"recipe": str(CHECKS_RECIPE), "script": marks.pop("checks.sh", None) or file_mark(checks_script(ctx, job))}
    try:
        cfg = json.loads(read(os.path.join(ctx.factory, CONFIG_NAME)) or "{}")
        for keys in FINGERPRINT_JUDGING:
            cur = cfg
            for k in keys[:-1]:
                cur = cur.get(k) if isinstance(cur, dict) else None
            if isinstance(cur, dict):
                cur.pop(keys[-1], None)
    except ValueError:
        cfg = "not valid JSON"
    full["settings"] = digest(cfg)
    try:
        allowed = json.loads(read(os.path.join(ctx.factory, override_rel(job))) or "{}")
        allowed = sorted(str(g) for g in allowed.get("unprotect") or []) if isinstance(allowed, dict) else "?"
    except ValueError:
        allowed = "not valid JSON"
    full["allowed"] = digest(allowed)
    full["files"] = digest(sorted((n, m) for n, m in marks.items() if not any(path_under(n, p) for p in copied)))
    if copied:
        try:
            mark = json.loads(read(os.path.join(lane_root(ctx, job), LANE_MARK), "") or "{}")
        except ValueError:
            mark = {}
        full["lanes"] = digest([(p, (mark.get(p) or {}).get("sum") if isinstance(mark, dict) else None) for p in copied])
    folder = dict(baselines_env(ctx, who["worktree"]), **lane_env(ctx, job)).get("FACTORY_BASELINES")
    images = []
    if folder and os.path.isdir(folder):
        names, links = baselines_scan(folder)
        images = [(n, file_mark(os.path.join(folder, n))) for n in names] + [(n, "link") for n in links]
    bl = baselines_config(ctx)
    if bl and bl["repo"] == "project":  # its list may wait uncommitted in the clone: then it counts by what it says
        images.append(("the list", file_mark(os.path.join(who["worktree"], bl["manifest"]))))
    full["images"] = digest(images)
    full["local"] = digest([(rel, file_mark(os.path.join(who["worktree"], rel))) for rel in sorted(local_only_paths(ctx))
                            if os.path.lexists(os.path.join(who["worktree"], rel))])
    # The environment the script would get now, from whoever asks: a builder's `SKIP_SLOW=1 fx checks` is no run of the
    # gate's checks. Only the names are kept to say what differs; the values only as part of the hash.
    env = {k: v for k, v in checks_env(ctx, who).items() if env_read(k)}
    full["env"] = digest(sorted(env.items()))
    marks = {k: hashlib.sha256(v.encode("utf-8", "surrogateescape")).hexdigest()[:8] for k, v in env.items()
             if not ENV_SECRET_LOOKING.search(k)}
    secret = sorted((k, v) for k, v in env.items() if ENV_SECRET_LOOKING.search(k))
    if secret:
        marks[ENV_SECRET_MARK] = digest(secret)[:8]  # all of them together: enough to say that one changed, not which
    return {"sum": digest(sorted(full.items())), "parts": {k: v[:16] for k, v in full.items()}, "env_marks": marks}


def fingerprint_changes(a, b, marks_a=None, marks_b=None):
    """Which parts differ between two fingerprints' parts, in words. marks_a, marks_b: the environment's variables as
    {name: a short hash of the value} (secret-looking names left out), to say which were set, removed or changed."""
    a, b = a or {}, b or {}
    out = []
    for k in sorted(set(a) | set(b)):
        if a.get(k) == b.get(k):
            continue
        words = FINGERPRINT_WORDS.get(k, k)
        if k == "env" and marks_a is not None and marks_b is not None:
            ma = {n: v for n, v in marks_a.items() if n != ENV_SECRET_MARK}
            mb = {n: v for n, v in marks_b.items() if n != ENV_SECRET_MARK}
            added, gone = sorted(set(mb) - set(ma)), sorted(set(ma) - set(mb))
            changed = sorted(n for n in set(ma) & set(mb) if ma[n] != mb[n])
            said = (["set now: " + ", ".join(added[:8])] if added else []) + \
                (["not set now: " + ", ".join(gone[:8])] if gone else []) + (["changed: " + ", ".join(changed[:8])] if changed else [])
            if marks_a.get(ENV_SECRET_MARK) != marks_b.get(ENV_SECRET_MARK):
                said.append("a variable whose name looks secret")
            words += " (%s)" % ("; ".join(said) if said else "a value changed")
        out.append(words)
    return out


def env_marks_of(rec):
    """A kept run's or a fingerprint's environment, as fingerprint_changes takes it; None from before fx kept it."""
    m = rec.get("env_marks") if isinstance(rec, dict) else None
    return m if isinstance(m, dict) else None


def checks_words(rec):
    """A kept run of the checks script, for a person: which, who asked, when it ended, how long it took."""
    took = rec.get("seconds") or 0
    return "run %s, asked by %s, ended %s, took %s" % (
        rec.get("id"), {"gate": "the gate", "pr": "fx pr", "judge": "the candidates' check"}.get(rec.get("by"), "the %s" % (
            rec.get("by") or "builder")), rec.get("at"), "%d min" % round(took / 60) if took >= 90 else "%d s" % took)


def checks_find(ctx, job, head, fp, cand=None):
    """(the kept pass that stands for a run of the checks script now, or None; why none does, in words, when this commit
    has a pass that cannot be used). Only a pass on this very commit with this very fingerprint, not older than
    reuse.max_age_hours, and only one fx itself saw from start to end on a clean clone (reusable)."""
    conf = reuse_config(ctx)
    same = [r for r in job.get("checks_runs") or [] if isinstance(r, dict) and r.get("cand") == cand
            and r.get("commit") == head and not r.get("dirty")]  # the runs of this commit as committed, oldest first
    if not any(r.get("result") == "PASS" and r.get("reusable") for r in same):
        return None, None
    if not conf["enabled"]:
        return None, "using a pass again is turned off (reuse.enabled in factory.json)"
    why = None
    for r in reversed(same):
        if r.get("result") == "PASS" and r.get("reusable"):
            age = time.time() - (iso_ts(r.get("at")) or 0)
            if age > conf["max_age_sec"] or age < -300:
                why = why or "%s is older than the %g hours a pass is used for" % (checks_words(r), conf["hours"])
            elif r.get("fingerprint") != fp["sum"]:
                why = why or "since %s something the checks read has changed: %s" % (
                    checks_words(r), ", ".join(fingerprint_changes(r.get("parts"), fp["parts"], env_marks_of(r),
                                                                   env_marks_of(fp))) or "it does not say what")
            else:
                return r, None
        elif r.get("result") != "PASS" and r.get("fingerprint") == fp["sum"]:
            # The latest word on this very commit and these very inputs is a failure: an older pass does not outvote it.
            return None, why or "%s did not pass on this same commit and the same inputs, after an earlier run had" % checks_words(r)
    return None, why


def checks_may_reuse(ctx, job):
    """Before a gate takes its place on the machine: does this commit have a pass that is likely to stand for the gate's
    own run of the checks script? Only the commit and the age are looked at: the fingerprint needs the baselines step
    first. A gate whose checks already ran uses far less than one that runs them, and is counted as another kind of
    step for it (GATE_AFTER_CHECKS), so neither kind's measurements mislead the line about the other."""
    try:
        conf = reuse_config(ctx)
        head = git(["rev-parse", "HEAD"], job["worktree"], check=False).stdout.strip()
    except (FxError, OSError):
        return False
    same = [r for r in job.get("checks_runs") or [] if isinstance(r, dict) and r.get("cand") is None
            and r.get("commit") == head and not r.get("dirty")]
    return conf["enabled"] and bool(head) and bool(same) and same[-1].get("result") == "PASS" and bool(same[-1].get("reusable")) \
        and 0 <= time.time() - (iso_ts(same[-1].get("at")) or 0) <= conf["max_age_sec"]


def checks_keep(ctx, job, row):
    """Keep a run of the checks script in job.json: at once on disk, whatever becomes of the step it was run for (a gate
    killed during its scan, a round that turned out void), and in this fx's own copy of the job. Gives the row its id."""
    def add(j):
        j["checks_seq"] = int(j.get("checks_seq") or 0) + 1
        row["id"] = "c%d" % j["checks_seq"]
        j.setdefault("checks_runs", []).append(dict(row))

    if job_note(ctx, job_real_id(job), add):
        job["checks_seq"] = int(row["id"][1:])
        job.setdefault("checks_runs", []).append(dict(row))
    else:
        add(job)
    return row


def checks_look(ctx, job, who=None, cand=None, again=False):
    """What a run of the checks script would run on now, and the pass that already stands for it, if any: {head, dirty,
    fp, hit, why}. Call it after the reference images and the lanes' copies are ready: they are part of the
    fingerprint. again: the caller wants a run whatever was kept."""
    who = who or job
    head = git(["rev-parse", "HEAD"], who["worktree"]).stdout.strip()
    look = {"head": head, "dirty": checks_dirt(ctx, who["worktree"]), "fp": checks_fingerprint(ctx, job, who), "hit": None,
            "why": None}
    if again:
        look["why"] = "a run was asked for whatever passed before (--again)"
    elif look["dirty"]:
        if any(isinstance(r, dict) and r.get("commit") == head and r.get("cand") == cand for r in job.get("checks_runs") or []):
            look["why"] = "the clone has uncommitted changes, so no earlier run was of what is there now"
    else:
        look["hit"], look["why"] = checks_find(ctx, job, head, look["fp"], cand)
    return look


def checks_reused(ctx, job, look, log_path=None):
    """The answer when a kept pass stands for the run: what it was, in a line for the step's own files."""
    rec = look["hit"]
    jd = ctx.job_dir(job_real_id(job))
    text = ("%s was not run again: it already passed on this commit %s with the same checks script, settings and "
            "files (%s). Its log: %s" % (os.path.relpath(checks_script(ctx, job), ctx.factory), look["head"][:12],
                                         checks_words(rec), os.path.join(jd, rec.get("log") or "?")))
    if log_path:
        write_atomic(log_path, text + "\n")
    return dict(rec, ok=True, reused=True, output="", timed_out=False, outside=None, note=text, problem=None)


def checks_execute(ctx, job, look, log_path, by, who=None, cand=None, rn=None, place=None):
    """Run the checks script now, the way the gate always has (the job's clone, the job's own port, database name and
    lanes, no credentials of fx, the gate's time limit, everything it starts in one process group), and keep what
    happened in job.json. Returns the kept row with ok, output, timed_out, problem (the gate's words for a failure)
    and outside (see outside_stop)."""
    who = who or job
    wt, limit = who["worktree"], int(ctx.c("gate_timeout_sec", 1800))
    watch = StopsWatch(place, [wt, ctx.job_dir(job_real_id(job))])
    t0, started, rc, timed_out = time.time(), now(), None, False
    watch.start(limit)
    try:
        p = run(["bash", checks_script(ctx, job)], cwd=wt, check=False, env=checks_env(ctx, who), timeout=limit, group=True,
                on_start=watch.attach)
        output, rc = p.stdout or "", p.returncode
    except subprocess.TimeoutExpired as e:
        timed_out = True
        output = ((e.output if isinstance(e.output, str) else "") + "\n%s timed out after %ss\n" % (
            os.path.relpath(checks_script(ctx, job), ctx.factory), limit)).lstrip("\n")
    finally:
        watch.stop()
    seconds = time.time() - t0
    write_atomic(log_path, output)
    ok = rc == 0 and not timed_out
    why_not = None
    if ok:  # a pass counts later only when fx saw one commit and one set of inputs from its start to its end
        after = checks_fingerprint(ctx, job, who)
        if look["dirty"] or checks_dirt(ctx, wt):
            why_not = "the clone had uncommitted changes, so this pass is of no commit: commit, then run the checks again"
        elif git(["rev-parse", "HEAD"], wt).stdout.strip() != look["head"]:
            why_not = "the commit changed while the checks ran"
        elif after["sum"] != look["fp"]["sum"]:
            why_not = "what the checks read changed while they ran: %s" % ", ".join(
                fingerprint_changes(look["fp"]["parts"], after["parts"], env_marks_of(look["fp"]), env_marks_of(after)))
    jd = ctx.job_dir(job_real_id(job))
    row = {"id": None, "commit": look["head"], "fingerprint": look["fp"]["sum"], "parts": look["fp"]["parts"],
           "env_marks": look["fp"].get("env_marks") or {},
           "result": "PASS" if ok else "TIMEOUT" if timed_out else "FAIL", "exit": rc, "started": started, "at": now(),
           "seconds": round(seconds), "by": by, "cand": cand, "reusable": bool(ok and not why_not),
           "log": os.path.relpath(log_path, jd) if path_under(os.path.realpath(log_path), os.path.realpath(jd)) else log_path}
    if rn:
        row["round"] = rn
    if look["dirty"]:
        row["dirty"] = True  # a run on uncommitted changes says nothing about the commit, whichever way it went
    if why_not:
        row["not_reusable"] = why_not
    if place is not None and place.waited >= WAIT_NOTED_SEC:
        row["waited_sec"] = round(place.waited)
    outside = None if ok else outside_stop(watch, rc, timed_out)
    if outside:
        row["outside_stop"] = outside["why"][:400]
    checks_keep(ctx, job, row)
    script = os.path.relpath(checks_script(ctx, job), ctx.factory)
    problem = None if ok else "%s timed out after %ss" % (script, limit) if timed_out else "%s exited with %d" % (script, rc)
    return dict(row, ok=ok, reused=False, output=output, timed_out=timed_out, outside=outside, problem=problem,
                why_run=look.get("why"))


def checks_once(ctx, job, log_path, by, who=None, cand=None, rn=None, place=None):
    """The checks script for a step that needs its result: the pass this commit already has, or a run now. A gate that
    took its place on the machine as one whose checks had passed (GATE_AFTER_CHECKS: counted at what an app and a scan
    use) and must run them after all, since something they read changed, first takes a place for the run itself, of
    the kind `fx checks` takes: the line then counts what the script uses, and the gate waits for that room. That place
    is a command of the gate's (over): it does not wait for the gate's own place to end, which would never come."""
    look = checks_look(ctx, job, who, cand)
    if look["hit"]:
        return checks_reused(ctx, job, look, log_path)
    if place is not None and place.lease.get("kind") == GATE_AFTER_CHECKS:
        w = who or job
        with step_place(ctx, "checks", job, folders=[w["worktree"], ctx.job_dir(job_real_id(job))],
                        over=place.lease["id"]) as inner:
            return dict(checks_execute(ctx, job, look, log_path, by, who=who, cand=cand, rn=rn, place=inner),
                        own_place=True)
    return checks_execute(ctx, job, look, log_path, by, who=who, cand=cand, rn=rn, place=place)


def checks_answer(res):
    """What a step says about its run of the checks script in its JSON answer."""
    row = {"reused": bool(res.get("reused")), "run": res.get("id"), "result": res.get("result"), "commit": res.get("commit"),
           "at": res.get("at"), "by": res.get("by"), "seconds": res.get("seconds"), "log": res.get("log")}
    if res.get("reused"):
        row["note"] = res.get("note")
    elif res.get("why_run"):
        row["not_reused_because"] = res["why_run"]
    if res.get("not_reusable"):
        row["not_kept_for_reuse_because"] = res["not_reusable"]
    return row


def runs_checks_script(ctx, job, cmd, cwd):
    """Whether an agent's command is the whole checks script: the script itself, or an interpreter given it, however the
    path is written. A line for a shell (`bash -c "…"`) is looked into as well."""
    script = os.path.realpath(checks_script(ctx, job))
    words = list(cmd)
    for arg in cmd:
        if " " in arg or "\t" in arg:
            try:
                words += shlex.split(arg)
            except ValueError:
                words += arg.split()
    for w in words:
        if os.path.basename(w) == os.path.basename(script) and os.path.realpath(os.path.join(cwd, os.path.expanduser(w))) == script:
            return True
    return False


def checks_script_refusal(job, wp=None, cand=None):
    """One sentence for an agent that ran the checks script through fx run."""
    if wp:
        return FxError("a package tests the files it owns: the whole checks script runs once for the job, when every package "
                       "is merged (the integrator runs `%s checks %s`), so it is not run for package %s"
                       % (FX_CMD, shlex.quote(job["id"]), wp), extra={"next": "test your own files"})
    then = "%s checks %s%s" % (FX_CMD, shlex.quote(job["id"]), " --candidate %d" % cand if cand else "")
    return FxError("the checks script runs through `%s`: fx then keeps the result for the commit, and the gate does not run "
                   "the script again on a commit that passed" % then, extra={"next": "checks", "then": then})


def checks_prepare(ctx, job, who=None, notes=None, hold=True):
    """What the gate does before the checks script, for a run outside a gate: the lanes' copies and the reference
    images. Returns what keeps the script from running, as lines; none when it can. notes: gets what was done to the
    reference images on the way (a version nobody recorded was restored from the list and kept aside). hold: see
    baselines_for_checks."""
    problems = list(lane_copies(ctx, job)["problems"])
    cfg = baselines_config(ctx)
    if cfg and not problems:
        root = who["worktree"] if who and cfg["repo"] == "project" else None
        ready, why = baselines_for_checks(ctx, cfg, job, root, notes=notes, hold=hold)
        if not ready:
            problems.append(why)
    return problems


def checks_dirt(ctx, wt):
    """Whether a clone holds uncommitted work, as the gate sees it. A project that keeps its baselines list in its own
    repository leaves the list uncommitted until its images are uploaded: that is no dirt here either, and the list
    counts by its content instead (checks_fingerprint)."""
    tracked, untracked = worktree_dirt(ctx, wt)
    cfg = baselines_config(ctx)
    if cfg and cfg["repo"] == "project":
        tracked = "\n".join(l for l in tracked.splitlines() if l.split(None, 1)[-1].strip('"') != cfg["manifest"])
    return bool(tracked or untracked)


def cmd_checks(ctx, a):
    """Run the job's checks script in its clone, as the gate does, and keep the result for the commit it ran on. This
    is how a builder checks its work: the gate then finds the pass and does not run the script a second time on the
    same commit. Asked again on a commit that already passed, it answers at once."""
    job = ctx.load(a.job)
    if a.wp:
        raise checks_script_refusal(job, wp=a.wp)
    who = candidate_job(ctx, job, a.candidate) if a.candidate else job
    name = getattr(a, "repo_name", None)
    if len(job_order(job)) > 1 or name:
        # A job of several repositories: one repository's checks script, in its clone, kept for its commit.
        changed = job_names(job, "change")
        if not name and len(changed) == 1:
            name = changed[0]
        if name not in changed:
            raise FxError("give the repository whose checks to run: --repo %s" % " or --repo ".join(changed) if not name
                          else "%s is not a repository this job changes (%s)" % (name, ", ".join(changed)), code=3)
        who = repo_view(ctx, who, name)
        job = repo_view(ctx, job, name)
        ctx = repo_ctx(ctx, name)
    if not os.path.isdir(who["worktree"] or ""):
        raise FxError("the clone %s is missing" % who["worktree"], code=3)
    jd = ctx.job_dir(job["id"])
    by = {"build": "builder", "review": "reviewer"}.get(job.get("stage"), "builder")
    res = {"job": job["id"]}
    if a.candidate:
        res["candidate"] = a.candidate
    # One long step at a time in a clone: the job's own, or one candidate's (their builders check at the same time).
    notes = []
    with job_busy(ctx, who, "checks"):
        # The builder's own run does not hold the factory repository against a pull: for 25 to 60 minutes every other
        # job's gate would judge on an older checkout. A pull meanwhile makes this pass one the gate does not use (the
        # fingerprint after the run differs).
        problems = checks_prepare(ctx, job, who if a.candidate else None, notes, hold=False)
        if problems:
            raise FxError("the checks script cannot run yet: %s" % "\n".join(problems), code=3)
        if notes:
            res["notes"] = ["baselines: " + n for n in notes]
        look = checks_look(ctx, job, who, a.candidate, again=a.again)
        if look["hit"]:
            done = checks_reused(ctx, job, look)
            out(dict(res, ok=True, checks="PASS", commit=look["head"], **{"reused": True, "run": done["id"], "note": done["note"],
                                                                         "next": "nothing to run: go on"}))
            return
        n = int(job.get("checks_seq") or 0) + 1
        log = os.path.join(jd, "checks", "%s%d.log" % ("c%d-" % a.candidate if a.candidate else "run-", n))
        wait = a.wait if a.wait is not None else (max_wait_asked() if max_wait_asked() is not None
                                                  else ledger_settings()["agent_wait_sec"])
        try:
            with step_place(ctx, "checks", job, folders=[who["worktree"], jd], max_wait=wait,
                            name="c%d" % a.candidate if a.candidate else None) as place:
                mark_step(ctx, job["id"], "checks", True, only_one=not a.candidate, lease=place.lease)
                done = None
                try:
                    done = checks_execute(ctx, job, look, log, by, who=who, cand=a.candidate, place=place)
                finally:
                    mark_step(ctx, job["id"], "checks", False, (done or {}).get("result") or "stopped")
        except PlaceWait as e:
            raise place_refusal(e, "the checks of %s" % job["id"])
    res.update(ok=done["ok"], checks=done["result"], run=done["id"], commit=done["commit"], seconds=done["seconds"],
               log=log, reused=False)
    if place.waited >= WAIT_NOTED_SEC:
        res["waited_sec"] = round(place.waited)
    if done["ok"]:
        res["kept_for_the_gate"] = done["reusable"]
        res["note"] = ("the gate will not run the checks script again on this commit, as long as the script, the settings "
                       "and the files it reads stay the same" if done["reusable"] else done.get("not_reusable"))
        res["next"] = "go on" if done["reusable"] else "commit, then run this again"
        out(res)
        return
    res["exit"] = done["exit"]
    res["tail"] = (done["output"] or "").splitlines()[-60:]
    before = [r for r in job.get("checks_runs") or [] if isinstance(r, dict) and r.get("commit") == done["commit"]
              and r.get("cand") == a.candidate and r.get("outside_stop") and r.get("id") != done["id"]]
    if done["outside"] and not before:
        res["outside_stop"] = done["outside"]["why"]
        res["next"] = ("run this again: part of the run was stopped from outside, which says nothing about your code. Change "
                       "code only for what fails again")
    elif done["outside"]:
        res["outside_stop"] = done["outside"]["why"]
        res["next"] = ("read the log, fix what fails, commit, and run this again: this commit was stopped from outside "
                       "before as well (%s), so it is taken for a failure now, as the gate does" % before[-1].get("id"))
    else:
        res["next"] = "read the log, fix what fails, commit, and run this again"
    out(res)
    sys.exit(1)


# --- a run that was stopped from outside
#
# A job's containers have the same names and images as other jobs' and other tools' on the machine, and one of them was
# stopped by something else twenty minutes into the checks, on a commit that had passed them. fx wrote an ordinary
# failure, the job lost a round, and a builder was sent to fix code that was not broken. A failed run now comes with
# what Docker and the system say happened to it, and when they say something outside it stopped part of it, the round
# says nothing about the code (gate_void). Once for a commit: what fails again counts.

STOP_SIGNALS = {1: "SIGHUP", 2: "SIGINT", 9: "SIGKILL", 15: "SIGTERM"}
# A command of the script itself that stops containers: what Docker is asked meanwhile is then the script's own doing.
OWN_STOP_RE = re.compile(r"(?:^|[\s/])(?:docker|docker-compose|podman|nerdctl)(?:\s.*)?\s(?:stop|kill|rm|down|restart|up|pause|prune)(?:\s|$)")


class StopsWatch:
    """While the checks script runs: which containers of this step Docker was asked to kill, and whether the script was
    doing that itself. On a real machine it listens to `docker events` (kill is what docker stop, docker kill, docker
    rm -f and compose down all start with; a container whose own process ends is never killed) and takes those of this
    step: started for its place, by compose from its clone or job folder, in a compose project seen with it, or seen with
    it by name. For each, at that moment, it looks whether a process of the script's own group is a docker command that
    stops containers (own). Docker does not say who asked, so this is the nearest there is: what it cannot tell is left
    undecided (own None) and never makes a round void. A test's machine has no Docker: there the events are read from
    a file the test writes, <state>/run/fake-stops/<place>.jsonl."""

    def __init__(self, place, folders):
        self.place, self.folders = place, [os.path.realpath(f) for f in folders if f]
        self.events, self.proc, self.thread, self.group, self.ended = [], None, None, None, None

    def attach(self, proc):
        self.group = proc.pid

    def start(self, limit):
        """limit: the seconds the script may run. The listener is told to end soon after that by itself, so that none
        is left behind when this fx is killed outright."""
        if os.environ.get("FACTORY_FAKE_MACHINE") or not shutil.which("docker"):
            return
        try:
            self.proc = subprocess.Popen(
                ["docker", "events", "--until", str(int(time.time() + limit + 600)), "--filter", "type=container",
                 "--filter", "event=kill", "--format", "{{json .}}"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, text=True, errors="replace")
        except OSError:
            self.proc = None
            return
        self.thread = threading.Thread(target=self.read, daemon=True)
        self.thread.start()

    def read(self):
        try:
            for line in self.proc.stdout:
                try:
                    e = json.loads(line)
                    attrs = (e.get("Actor") or {}).get("Attributes") or {}
                except (ValueError, AttributeError):
                    continue
                try:
                    row = {"at": iso_of(float(e.get("time") or time.time())), "ts": float(e.get("time") or time.time()),
                           "container": str(attrs.get("name") or "?"),
                           "signal": str(attrs.get("signal") or ""), "project": str(attrs.get("com.docker.compose.project") or ""),
                           "workdir": norm_mount(str(attrs.get("com.docker.compose.project.working_dir") or "")),
                           "place": str(attrs.get("fx.place") or "")}
                    if self.mine(row):
                        row["own"] = self.own()
                        self.events.append(row)
                except Exception:  # noqa: BLE001 - watching never breaks the run it watches; an event not read is not evidence
                    continue
        except (OSError, ValueError):
            pass

    def mine(self, row):
        lease = self.place.lease if self.place is not None else {}
        return bool((row["place"] and row["place"] == lease.get("id"))
                    or any(path_under(row["workdir"], f) for f in self.folders)
                    or (row["project"] and row["project"] in (lease.get("projects") or []))
                    or (self.place is not None and row["container"] in self.place.names))

    def own(self):
        """The docker commands of the script's own process group that stop containers right now; None when the
        processes cannot be read."""
        if not self.group:
            return None
        text = try_out(["ps", "-axwwo", "pgid=,command="], timeout=10)
        if text is None:
            return None
        found = []
        for line in text.splitlines():
            pgid, _, cmd = line.strip().partition(" ")
            if pgid.isdigit() and int(pgid) == self.group and OWN_STOP_RE.search(cmd):
                found.append(cmd.strip()[:200])
        return found

    def stop(self):
        self.ended = self.ended or time.time()  # when the script was over: see outside_stop
        if os.environ.get("FACTORY_FAKE_MACHINE"):
            lid = self.place.lease.get("id") if self.place is not None else None
            for line in (read(os.path.join(ledger_dir(), "fake-stops", "%s.jsonl" % lid), "") or "").splitlines() if lid else []:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    self.events.append(dict({"at": now(), "container": "?", "signal": "15", "own": []}, **row))
            return
        if self.proc is not None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    self.proc.kill()
                except OSError:
                    pass
        if self.thread is not None:
            self.thread.join(timeout=5)


OUTSIDE_END_GRACE_SEC = 15  # kills this close to the script's end are taken for its own clean-up (an EXIT trap)


def outside_stop(watch, rc, timed_out):
    """Why a failed run of the checks script says nothing about the code, with what was seen, to keep; None when nothing
    says so. Two things do: Docker was asked to kill a container of this step while no command of the script was
    stopping containers, before the script's last seconds (its own clean-up, a `docker compose down` in an EXIT trap,
    may be over before fx looks at its processes); or bash itself, running the script, was ended by a signal fx did not
    send. An exit of 128 + a signal alone says nothing: a test container killed for memory, or the script's own
    `timeout -s KILL`, ends that way too. A run fx stopped itself because its time was up is neither. A test suite that
    kills its own containers through Docker's API (Testcontainers' Ryuk) cannot be told from a stop from outside; that
    is why a round is put aside for it only once for a commit."""
    if timed_out:
        return None
    ended = getattr(watch, "ended", None)
    asked = [e for e in watch.events if e.get("own") == []
             and not (ended and e.get("ts") and float(e["ts"]) > ended - OUTSIDE_END_GRACE_SEC)]
    sig = -rc if isinstance(rc, int) and rc < 0 else None
    if not asked and sig is None:
        return None
    said = []
    if asked:
        passed_on = rc - 128 if isinstance(rc, int) and rc in (129, 130, 137, 143) else None
        said.append("Docker was asked to stop %s while the checks ran (signal %s), and no command of the checks was "
                    "stopping containers then%s" % (", ".join(sorted({str(e.get("container")) for e in asked})[:5]),
                                                    "/".join(sorted({str(e.get("signal") or "?") for e in asked})),
                                                    "; the script then ended with %d (%s passed on)" % (
                                                        rc, STOP_SIGNALS.get(passed_on, "a signal")) if passed_on else ""))
    if sig is not None:
        said.append("the checks script ended on signal %d (%s), which fx did not send" % (sig, STOP_SIGNALS.get(sig, "?")))
    return {"why": "; ".join(said), "stopped": asked, "signal": sig, "exit": rc,
            "by_the_checks_themselves": [e for e in watch.events if e.get("own")],
            "could_not_tell": [e for e in watch.events if e.get("own") is None]}


def outside_stop_first(job, head):
    """No round of this commit was put aside for a stop from outside yet. It is done once for a commit: what keeps
    failing then counts, so nothing can go round in circles here."""
    return not any(isinstance(x, dict) and x.get("commit") == head for x in job.get("outside_stops") or [])


# --- rounds that needed no builder

def gate_work(ctx, job):
    """What a builder leaves for the gate besides the commit: the UI check and its seed in the job folder, the staged
    logic files, and the clone's local files. With the commit, that is all of a job's own work a round judges."""
    jd = ctx.job_dir(job["id"])
    rows = [(rel, file_mark(os.path.join(jd, rel))) for rel in ("ui/check.js", "ui/seed.sh")
            if os.path.lexists(os.path.join(jd, rel))]
    for dirpath, _, names in os.walk(os.path.join(jd, "logic")):
        rows += [(os.path.relpath(os.path.join(dirpath, n), jd), file_mark(os.path.join(dirpath, n))) for n in names]
    rows += [("clone:" + rel, file_mark(os.path.join(job["worktree"], rel))) for rel in sorted(local_only_paths(ctx))
             if os.path.lexists(os.path.join(job["worktree"], rel))]
    return digest(sorted(rows))[:16]


def rounds_give_back(job, entry):
    """A gate passed on a commit on which earlier rounds of this attempt failed, and nothing of the builder's changed in
    between (the same commit, a clean clone, the same UI check, logic files and local files) and nothing the checks read
    either (the same fingerprint: a lane holder mends a test or records an image in the factory repository, not in the
    commit). Whatever failed those rounds, no builder mended it: a finding a human then accepted, a scan or a test that
    failed by itself. They are given back, so the job keeps those rounds for work that needs one. A round whose checks
    did not run, or ran on other inputs, is not: what changed may be what mended it. Only a pass does this: failing
    again on the same commit still uses a round, or a job nothing ever changes could go on for ever. Returns the rounds
    given back."""
    start = job.get("round_start", 0)
    back = [r for r in job.get("gate_rounds") or [] if isinstance(r, dict) and r.get("gate") == "FAIL" and not r.get("given_back")
            and r.get("round", 0) > start and r.get("clean") and r.get("commit") == entry["commit"]
            and r.get("work") == entry["work"] and entry.get("inputs") and r.get("inputs") == entry["inputs"]]
    for r in back:
        r["given_back"] = entry["round"]
    if back:
        job["rounds_returned"] = int(job.get("rounds_returned") or 0) + len(back)
    return [r["round"] for r in back]


def mark_incomplete(job, reason):
    job["needs_human"] = True
    job["incomplete"] = True
    job["handoff_reason"] = job.get("handoff_reason") or reason


def gh_existing_pr(branch, cwd, repo_flag=()):
    p = run(["gh", "pr", "view", branch, "--json", "url", "-q", ".url"] + list(repo_flag), cwd=cwd, check=False)
    url = (p.stdout or "").strip()
    return url if p.returncode == 0 and url.startswith("http") else None


def cmd_pr(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "pr":
        raise FxError("job is in stage %s, not pr" % job["stage"])
    with job_busy(ctx, job, "push"):
        pr_push(ctx, a)


def pr_push(ctx, a):
    """Push the job and open its pull requests: in a job of several repositories, every changed one gets its own,
    linked to the others. Phase 1 makes every repository ready (left-over work, sync with its target, its checks, the
    secret scan) before anything is pushed anywhere; phase 2 pushes each one and opens or updates its pull request;
    phase 3 writes every description with the links to the others. Then one Jira comment and one transition. Safe to
    run again after a partial failure: a repository pushed and unchanged is not pushed again."""
    job = ctx.load(a.job)
    names = job_names(job, "change")
    if not names:
        raise FxError("job %s changes no repository yet" % job["id"], code=3)
    several = len(names) > 1
    tag = (lambda n: "%s: " % n) if several else (lambda n: "")
    for n in names:
        wt = job["repos"][n].get("worktree")
        if not wt or not os.path.isdir(wt):
            raise FxError("the worktree %s%s is missing" % (wt, " of %s" % n if several else ""), code=3)
    remote = REMOTE
    jd = ctx.job_dir(job["id"])
    notes = []
    targets = pr_targets(ctx, job, getattr(a, "target", None))
    retarget, moved = {}, []
    for n in names:
        e = job["repos"][n]
        retarget[n] = bool(e.get("pr_url") and e.get("target_branch") and e["target_branch"] != targets[n])
        if e.get("target_branch") != targets[n]:
            e["target_branch"] = targets[n]
            moved.append("%s%s" % ("%s=" % n if several else "", targets[n]))
    if moved:
        ctx.save(job, "target branch %s" % ", ".join(moved))

    refusal = history_rewrites_text(ctx, job)
    for n in names:
        off = refusal or job_off_its_branch(repo_view(ctx, job, n))
        refusal = refusal or (off and tag(n) + off)
    if refusal:
        raise FxError(refusal, code=3)
    for n in names:
        job_base_from_remote(ctx, job, n)
    bl_cfg = baselines_config(ctx)
    if bl_cfg:
        notes += baselines_before_push(ctx, bl_cfg, job)
    # Phase 1, before anything is pushed. 1. Left-over work: never lose it, never block on it.
    dirt = {n: worktree_dirt(ctx, job["repos"][n]["worktree"], n) for n in names}
    for n in names:
        tracked, untracked = dirt[n]
        if tracked and not job.get("incomplete"):
            mark_incomplete(job, "uncommitted changes appeared after the gate")
    for n in names:
        wt = job["repos"][n]["worktree"]
        tracked, untracked = dirt[n]
        if tracked or (untracked and job.get("incomplete")):
            left = stage_work(ctx, wt, untracked, n)
            if left:
                notes.append(tag(n) + "local files not committed (copy_into_worktree, .env*): %s"
                             % ", ".join(sorted(set(left))[:10]))
            if git(["diff", "--cached", "--quiet"], wt, check=False).returncode != 0:
                git_job(["commit", "--no-verify", "-m", "%s: WIP (factory, incomplete)" % job["issue_key"]], wt)
                notes.append(tag(n) + "left-over changes committed as a WIP commit")
                ctx.save(job, "WIP committed" + (" in %s" % n if several else ""))
        elif untracked:
            notes.append(tag(n) + "untracked files in the job's clone (not part of the PR; the clone is kept so they "
                         "are not lost): %s" % ", ".join(untracked[:10]))

    # 2. Nothing on any branch: no PR, tell Jira, hand back. A repository with nothing of its own gets no PR.
    ahead = {n: git(["rev-list", "--count", "%s..HEAD" % job["repos"][n]["base_ref"]],
                    job["repos"][n]["worktree"]).stdout.strip() for n in names}
    work = [n for n in names if ahead[n] != "0"]
    if not work:
        mark_incomplete(job, "no commits on the branch")
        body = ("**Software factory stopped on %s without code changes.**\n\n- Reason: %s\n"
                "- Details: factory job files on the machine that ran it" % (job["issue_key"], job["handoff_reason"]))
        jira = {"comment": jira_comment(ctx, job, body)}
        app_stop(ctx, job)
        clone = drop_clone(ctx, job)
        ctx.move(job, "handed-off", "no commits; no PR")
        finish(ctx, {"ok": True, "job": job["id"], "pr_url": None, "pr_hint": None, "draft": False,
                     "needs_human": True, "reason": job["handoff_reason"], "jira": jira, "clone": clone,
                     "notes": notes + ["no commits beyond base, so no pull request was opened"],
                     "next": "done"}, job, push=True)
        return
    for n in names:
        if n not in work:
            notes.append("%s: no commits beyond its base, so nothing to push and no pull request" % n)

    # 3. Complete work: sync each repository with its target and make sure its checks pass on what will be pushed.
    complete = not job.get("incomplete")
    remotes = {n: remote in git(["remote"], job["repos"][n]["worktree"]).stdout.split() for n in work}
    for n in work:
        e = job["repos"][n]
        wt, target = e["worktree"], e["target_branch"]
        target_ref = "%s/%s" % (remote, target)
        if remotes[n] and target != e["base_branch"]:
            git(["fetch", "-q", git_url(ctx, n), "+refs/heads/%s:refs/remotes/%s/%s" % (target, remote, target)], wt,
                check=False)
            extra = git(["rev-list", "--count", "%s..%s" % (target_ref, e["base_ref"])], wt, check=False).stdout.strip()
            if extra and extra != "0":
                notes.append(tag(n) + "the work started from %s, which has %s commit(s) that %s does not: the pull "
                             "request into %s carries them too" % (e["base_branch"], extra, target, target))
        if not complete:
            continue
        if remotes[n]:
            git(["fetch", "-q", git_url(ctx, n), "+refs/heads/%s:refs/remotes/%s/%s" % (target, remote, target)], wt,
                check=False)
        mr = git_job(["merge", "--no-edit", target_ref], wt, check=False)
        if mr.returncode != 0:
            git_job(["merge", "--abort"], wt, check=False)
            mark_incomplete(job, "merge conflict with %s%s" % (target_ref, " in %s" % n if several else ""))
            notes.append(tag(n) + "merge conflict with the target branch %s; PR opened as draft" % target)
        else:
            head = git(["rev-parse", "HEAD"], wt).stdout.strip()
            if head != e.get("checks_passed_at"):
                # Merging the target made another commit than the gate passed on: what will be pushed is checked as it
                # is. Only when the checks script already passed on this very commit with the same inputs (this
                # command was stopped after its checks and is run again) is that pass used, like at the gate.
                log = os.path.join(jd, "final-checks-%s.log" % n if several else "final-checks.log")
                rctx, v = (repo_ctx(ctx, n), repo_view(ctx, job, n)) if several else (ctx, job)
                said = []
                problems = checks_prepare(rctx, v, notes=said)
                notes += [tag(n) + "baselines: " + x for x in said]
                done = None
                if problems:
                    write_atomic(log, "\n".join(problems) + "\n")
                else:
                    look = checks_look(rctx, v)
                    if look["hit"]:
                        done = checks_reused(rctx, v, look, log)
                    else:
                        with step_place(ctx, "checks", v) as place:  # as heavy as a gate's: it waits its turn like one
                            done = checks_execute(rctx, v, look, log, "pr", place=place)
                if done and done["ok"]:
                    e["checks_passed_at"] = head
                    notes.append(tag(n) + "synced with base; " + (done["note"] if done["reused"] else
                                                                  "checks still pass"))
                elif done and done["outside"] and outside_stop_first(job, head):
                    # Not the code's doing: nothing is pushed as a draft for it. Once for a commit, as at the gate.
                    seen = {"commit": head, "round": job["round"], "at": now(), "why": done["outside"]["why"][:300],
                            "step": "pr"}
                    kept = os.path.join(jd, "final-checks-outside-stop.json")
                    write_atomic(kept, json.dumps(dict(done["outside"], commit=head, run=done["id"]), indent=1,
                                                  ensure_ascii=False) + "\n")
                    job.setdefault("outside_stops", []).append(seen)
                    ctx.save(job, "final checks stopped from outside; nothing pushed")
                    raise FxError("the checks on what would be pushed%s failed, but not by anything the code did: %s. "
                                  "Nothing was pushed and nothing was marked as failing. Run `%s pr %s` again; if it "
                                  "happens again on this commit it counts" % (
                                      " to %s" % n if several else "", done["outside"]["why"], FX_CMD, job["id"]),
                                  code=3, extra={"void": True, "next": "pr", "kept": kept})
                else:
                    mark_incomplete(job, "checks fail after merging the latest %s%s (%s)" % (
                        target_ref, " in %s" % n if several else "", os.path.basename(log)))
                    notes.append(tag(n) + "checks fail after syncing with base; PR opened as draft")
        ctx.save(job, "synced with base" + (" (%s)" % n if several else ""))
    draft = bool(job.get("incomplete") and ctx.c("pr.draft_when_incomplete", True))

    # 4. Never push a secret: scan the commits that would leave this machine, in every repository, before any push.
    secrets = {}
    for n in work:
        if not remotes[n]:
            continue
        found = pr_secret_scan(repo_ctx(ctx, n), repo_view(ctx, job, n), getattr(a, "no_secret_scan", False),
                               n if several else None)
        if found and isinstance(found[0], dict):
            secrets[n] = found
        else:
            notes += [tag(n) + f for f in found]
    if secrets:
        points = {n: unpushed_base(repo_view(ctx, job, n)) for n in secrets}
        report = {n: os.path.join(jd, "pr-scan", n, "security.md") if several else
                  os.path.join(jd, "pr-scan", "security.md") for n in secrets}
        for n in secrets:
            e = job["repos"][n]
            if e.get("secret_reset_to") == points[n] and e.get("secret_bounces", 0) >= 1:
                ctx.save(job, "secret still present after the builder's fix; nothing pushed")
                raise FxError("the branch%s still has secrets in its unpushed commits after the builder's attempt to "
                              "remove them (see %s). Nothing was pushed%s. Remove them by hand in %s (`git reset --soft "
                              "%s`, take them out, commit), then run `%s pr %s` again." % (
                                  " of %s" % n if several else "", report[n], " anywhere" if several else "",
                                  e["worktree"], points[n][:12], FX_CMD, job["id"]), code=3)
        # Nothing is pushed anywhere; the builder takes the secrets out of the unpushed history.
        for n in secrets:
            e = job["repos"][n]
            e["secret_bounces"] = e.get("secret_bounces", 0) + 1 if e.get("secret_reset_to") == points[n] else 1
            e["secret_reset_to"] = points[n]
        job.update(build_reason="secret", incomplete=False, needs_human=False, handoff_reason=None,
                   decision=None, reviews={}, gate=None)
        if rounds_left(job) <= 0:
            job["max_rounds"] = rounds_used(job) + 1
        ctx.move(job, "build", "secret found before push%s; nothing pushed" % (
            " in %s" % ", ".join(secrets) if several else ""), force=True)
        res = {"ok": True, "job": job["id"], "pushed": False, "next": "build",
               "secrets": ["%s%s: %s" % (tag(n), f.get("location"), f.get("message"))
                           for n in secrets for f in secrets[n][:10]][:10],
               "report": report[next(iter(secrets))],
               "note": "nothing was pushed%s; the builder removes the secrets from the unpushed commits. Any real "
                       "credential must be rotated." % (" in any repository" if several else "")}
        if several:
            res.update(repos=list(secrets), reports=report)
        out(res)
        return

    # Phase 2. Push each repository (one pushed before and unchanged since is not pushed again), then its pull request.
    pushed = {}
    for n in work:
        e = job["repos"][n]
        wt = e["worktree"]
        if not remotes[n]:
            pushed[n] = False
            notes.append(tag(n) + "no remote %r; branch not pushed" % remote)
            continue
        head = git(["rev-parse", "HEAD"], wt).stdout.strip()
        url = git_url(ctx, n)  # factory.json's URL, whatever the clone's origin says now
        there = git(["ls-remote", url, "refs/heads/%s" % e["branch"]], wt, check=False).stdout.split()
        if several and e.get("pushed_head") == head and there[:1] == [head]:
            pushed[n] = True
            notes.append(tag(n) + "already pushed and unchanged: not pushed again")
            continue
        git_job(["push", url, "HEAD:refs/heads/%s" % e["branch"]], wt)
        # what -u did: the clone's own record of the remote branch, so later reads (unpushed work, rework) see the push
        git(["update-ref", "refs/remotes/%s/%s" % (remote, e["branch"]), head], wt, check=False)
        git(["branch", "-q", "--set-upstream-to=%s/%s" % (remote, e["branch"])], wt, check=False)
        pushed[n] = True
        e["pushed_head"] = head
        e.pop("secret_bounces", None)
        ctx.save(job, "pushed %s%s" % (head[:10], " (%s)" % n if several else ""))

    # The PR text leaves this machine: secrets the agents' reports may quote are redacted first.
    title, hit_t = scrub_text(ctx, "%s: %s" % (job["issue_key"], job.get("summary", "")))
    hits = list(hit_t)
    labels = list(ctx.c("pr.labels", []) or [])
    nh_label = ctx.c("pr.needs_human_label")
    if job.get("needs_human") and nh_label:
        labels.append(nh_label)
    create = ctx.c("pr.create", True) is not False
    body_file = (lambda n: os.path.join(jd, "pr-body-%s.md" % n)) if several else (
        lambda n: os.path.join(jd, "pr-body.md"))
    sent = {}
    for n in work:
        e = job["repos"][n]
        if not pushed[n]:
            continue
        body = pr_text(ctx, job, n, work, hits)
        write_atomic(body_file(n), body)
        sent[n] = body
        e["pr_url"], e["pr_hint"] = pr_open(repo_ctx(ctx, n), job, n, title, body, body_file(n), labels, draft,
                                            retarget[n], notes, tag(n))
        ctx.save(job, "PR %s%s" % (e["pr_url"] or e["pr_hint"] or "-", " (%s)" % n if several else ""))
    for n in work:
        if not pushed[n]:
            e = job["repos"][n]
            e["pr_hint"] = None
    # Phase 3. Every description lists the other repositories' pull requests (or branches), now all are known.
    bodies = {}
    for n in work:
        bodies[n] = pr_text(ctx, job, n, work, hits) if n not in sent or several else sent[n]
        if n in sent and bodies[n] != sent[n]:
            write_atomic(body_file(n), bodies[n])
            if job["repos"][n].get("pr_url"):
                bad = pr_write_links(repo_ctx(ctx, n), job, n, bodies[n], body_file(n))
                if bad:
                    notes.append(bad)
    body_path = os.path.join(jd, "pr-body.md")
    if several:
        md = []
        for n in work:
            md += ["## Repo: %s" % n, ""] + md_demote(bodies[n].splitlines()) + [""]
        write_atomic(body_path, "\n".join(md).rstrip("\n") + "\n")
    elif work[0] not in sent:
        write_atomic(body_path, bodies[work[0]])
    if hits:
        notes.append("possible secrets redacted from the pull request text (%s); check the job's reports"
                     % ", ".join(sorted(set(hits))))
    ctx.save(job)

    # Jira: one comment and one transition for the job, then hand over.
    def line(n):
        e = job["repos"][n]
        if create or e.get("pr_url") or not pushed[n]:
            return e.get("pr_url") or e.get("pr_hint") or "branch %s (not pushed)" % e["branch"]
        return None
    if several:
        lines = ["**Software factory: work ready for review**", "", "- Pull requests (merge them in this order):"]
        for n in work:
            e = job["repos"][n]
            lines.append("  - %s: %s (branch `%s` from `%s` into `%s`)" % (
                n, line(n) or "pushed; no pull request opened yet", e["branch"], e["base_branch"], e["target_branch"]))
    else:
        e = job["repos"][work[0]]
        lines = ["**Software factory: work ready for review**", "",
                 ("- Pull request: %s" % line(work[0])) if line(work[0]) else
                 "- Pushed to branch `%s`; no pull request opened yet" % e["branch"],
                 "- Branch: `%s` (from `%s`, into `%s`)" % (e["branch"], e["base_branch"], e["target_branch"])]
    lines += ["- Approver: %s" % (job.get("decision") or "-"),
              "- Gate: %s, rounds used %d of %d" % (job.get("gate"), rounds_used(job), job["max_rounds"])]
    if job.get("needs_human"):
        lines.append("- Needs a human: %s" % job.get("handoff_reason"))
    jira = {"transition": jira_move(ctx, job, "review"), "comment": jira_comment(ctx, job, "\n".join(lines))}
    for what, r in jira.items():
        if "error" in r:
            notes.append("Jira %s failed: %s" % (what, r["error"]))
    app_stop(ctx, job)
    # The code is on the remotes now: the clones go, only when every repository was pushed (else they all stay).
    all_pushed = all(pushed.values())
    clone = drop_clone(ctx, job) if all_pushed else "kept: not pushed%s" % (
        " (%s)" % ", ".join(n for n in work if not pushed[n]) if several else "")
    ctx.move(job, "handed-off", "handed off%s" % (" (draft)" if draft else ""))
    first = job["repos"][work[0]]
    res = {"ok": True, "job": job["id"], "pr_url": first.get("pr_url"), "pr_hint": first.get("pr_hint"),
           "pr_body": body_path, "draft": draft,
           "needs_human": job.get("needs_human"), "reason": job.get("handoff_reason"),
           "provider": remote_provider(ctx, job, work[0])[0], "jira": jira, "notes": notes, "clone": clone,
           "next": "done"}
    if several:
        res["repos"] = [{"name": n, "branch": job["repos"][n]["branch"], "target": job["repos"][n]["target_branch"],
                         "pushed": pushed.get(n, False), "pr_url": job["repos"][n].get("pr_url"),
                         "pr_hint": job["repos"][n].get("pr_hint"), "provider": remote_provider(ctx, job, n)[0],
                         "pr_body": body_file(n) if n in work else None} for n in names]
    finish(ctx, res, job, push=True)


def unpushed_base(job):
    """Where the commits that never left this machine start: the remote branch, or the merge-base."""
    wt = job["worktree"]
    r = git(["rev-parse", "--verify", "-q", "%s/%s" % (REMOTE, job["branch"])], wt, check=False)
    if r.returncode == 0 and is_ancestor(r.stdout.strip(), "HEAD", wt):
        return r.stdout.strip()
    return git(["merge-base", job["base_ref"], "HEAD"], wt, check=False).stdout.strip()


def pr_secret_scan(ctx, job, skip, sub=None):
    """The secret scan of a repository's unpushed commits before fx pr pushes them; its report in pr-scan/ of the job
    folder, or pr-scan/<sub>/ for one repository of several."""
    if not scanners_on(ctx)["gitleaks"]:
        # Only an explicit false turns it off (a factory.json without security.scanners scans as the template).
        return ["secret scan before push: turned off in factory.json (security.scanners.gitleaks is false)"]
    if skip:
        return ["secret scan skipped on request (--no-secret-scan)"]
    wt = job["worktree"]
    mb = git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
    rdir = os.path.join(ctx.job_dir(job["id"]), "pr-scan", *([sub] if sub else []))
    os.makedirs(rdir, exist_ok=True)
    leaks, err, note = scan_secrets(ctx, job, mb, rdir)
    if err:
        raise FxError("the secret scan before push failed (%s). Nothing was pushed. Check the branch by hand, "
                      "then run `%s pr %s --no-secret-scan`." % (err, FX_CMD, job["id"]), code=3)
    if leaks:
        write_atomic(os.path.join(rdir, "security.md"),
                     security_markdown({"findings": leaks, "blocking": leaks, "skipped": []}))
        return leaks
    return [note or "secret scan before push: clean"]


def take_remote_branch(ctx, job, wt, notes, repo=None):
    """Before a rework: include commits a human pushed to the PR branch, and remember them for learning."""
    e = job["repos"][repo] if repo else job
    if git(["fetch", "-q", git_url(ctx, repo or job_primary(job)), e["branch"]], wt, check=False).returncode != 0:
        return
    rh = git(["rev-parse", "FETCH_HEAD"], wt).stdout.strip()
    st = repo_learn_state(job, repo or job_primary(job))
    pushed = e.get("pushed_head")
    seen = st.get("edits_seen") if is_ancestor(pushed, st.get("edits_seen"), wt) else None
    start = seen or pushed
    where = " of %s" % repo if repo and len(job["repos"]) > 1 else ""
    if start and rh != start and is_ancestor(start, rh, wt):
        n = git(["rev-list", "--count", "--first-parent", "--no-merges", "%s..%s" % (start, rh)], wt).stdout.strip()
        st["pending_edits"].append([start, rh])
        st["edits_seen"] = rh
        notes.append("%s commit(s) pushed to the pull request branch%s by a human are included" % (n, where))
    lh = git(["rev-parse", "HEAD"], wt).stdout.strip()
    if rh == lh or is_ancestor(rh, lh, wt):
        return
    if git_job(["merge", "--no-edit", rh], wt, check=False).returncode != 0:
        git_job(["merge", "--abort"], wt, check=False)
        raise FxError("the pull request branch%s has commits that conflict with the job's unpushed commits in %s; "
                      "merge them by hand there, then run the rework again" % (where, wt), code=3)


def cmd_rework(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "handed-off":
        raise FxError("rework needs a handed-off job; %s is in stage %s" % (job["id"], job["stage"]))
    jd = ctx.job_dir(job["id"])
    notes = []
    # A pull request merged already (its branch maybe deleted after the merge): that repository is done.
    change = job_names(job, "change")
    merged = [n for n in change if (job["repos"][n].get("pushed_head") or job["repos"][n].get("pr_url"))
              and repo_merged(ctx, job, n) == "merged"]
    if merged and len(merged) == len(change):
        raise FxError("the pull request%s of %s %s merged: its work is in the base branch%s already. Start a new job "
                      "for what the human wants changed (/auto-factory:code new %s --again)" % (
                          "s" if len(merged) > 1 else "", job["id"], "are all" if len(merged) > 1 else "is",
                          "es" if len(merged) > 1 else "", job.get("issue_key") or job["id"]), code=3)
    for n in merged:
        rework_merged(ctx, job, n, [c for c in change if c not in merged], notes)
    k = 1
    while os.path.exists(os.path.join(jd, "rework-%d.md" % k)):
        k += 1
    # The previous attempt's results must not be mistaken for the new ones.
    arch = os.path.join(jd, "archive", "before-rework-%d" % k)
    for name in ("build.md", "decision.md", "pr-body.md"):
        if os.path.exists(os.path.join(jd, name)):
            os.makedirs(arch, exist_ok=True)
            os.replace(os.path.join(jd, name), os.path.join(arch, name))
    for n in job_clones(job):
        if not os.path.isdir(job["repos"][n].get("worktree") or ""):
            rework_clone(ctx, job, n, notes, remote_heads(ctx.url(n))[0] if job["repos"][n].get("role") == "change"
                         else {})
    for n in job_names(job, "change"):
        take_remote_branch(ctx, job, job["repos"][n]["worktree"], notes, repo=n)
    slot, port = free_slot(ctx, job["id"], prefer=job.get("port"))  # its old ports, unless a job took them since
    if port != job.get("port"):
        notes.append("ports moved to %d-%d" % (port, port + ports_step(ctx) - 1))
    job["slot"], job["port"], job["port_span"] = slot, port, ports_step(ctx)
    path = os.path.join(jd, "rework-%d.md" % k)
    prs = [e.get("pr_url") or e.get("pr_hint") for e in (job["repos"][n] for n in job_names(job, "change"))]
    pr = ", ".join(p_ for p_ in prs if p_) or "-"
    write_atomic(path, "# Rework %d (%s)\n\nPull request: %s\n\n## What the human wants changed\n\n%s\n\n"
                       "## Review comments\n\nIf `gh` is available, also read the review comments on the pull "
                       "request: `gh pr view %s --comments`.\n" % (k, now()[:16], pr, a.note.strip(), pr))
    if (job.get("split") or {}).get("mode") == "split":
        for pid, p_ in job["split"]["packages"].items():
            if os.path.isdir(p_.get("clone") or ""):
                wp_place_end(ctx, job, pid)
                wp_stack_stop(ctx, job, pid)
            shutil.rmtree(p_.get("clone") or "", ignore_errors=True)
        job["split"] = {"mode": "single", "was": "split"}  # a rework is done by one builder on the whole
    job.update(round_start=job["round"], rounds_returned=0, needs_human=False, incomplete=False, handoff_reason=None,
               decision=None, reviews={}, gate=None, builder_agent_id=None, builder_agent_model=None,
               build_reason="rework", skipped_checks=[], security_skipped=[], security_missed=[])
    ctx.move(job, "build", "rework %d" % k)
    out({"ok": True, "job": job["id"], "rework_file": path, "port": port, "notes": notes,
         "setup_needed": any(not job["repos"][n].get("setup_done") for n in job_clones(job)), "next": "build"})


# --------------------------------------------------------------------------
# split build: one ticket, several builders in parallel, each owning its own files

WP_ID_RE = re.compile(r"^wp\d+$")
WP_STATUS_RE = re.compile(r"^STATUS:\s*(READY|BLOCKED|NEEDS-INFO|CHANGE-REQUEST)\s*$")
TERMINAL_WP = ("integrated", "blocked")


def parse_plan(text):
    first = (text or "").strip().splitlines()[0].strip() if (text or "").strip() else ""
    m = re.match(r"^PLAN:\s*(SPLIT|SINGLE)\s*$", first)
    if not m:
        return None, None, "the first line of plan.md must be PLAN: SPLIT or PLAN: SINGLE"
    if m.group(1) == "SINGLE":
        return "single", [], None
    blocks = re.findall(r"```json\s*\n(.*?)```", text, re.S)
    if not blocks:
        return "split", None, "a SPLIT plan needs a ```json block with the packages"
    try:
        data = json.loads(blocks[-1])
    except ValueError as e:
        return "split", None, "the json block of plan.md is not valid JSON: %s" % e
    return "split", data.get("packages") if isinstance(data, dict) else None, None


def validate_packages(pkgs, files, repos=None):
    """files: the files of the job's clone, or {repo: its files} with repos, the job's changed repositories: then each
    package belongs to one of them ("repo"; it may be left out when there is one) and owns files there only."""
    problems = []
    if not isinstance(pkgs, list) or len(pkgs) < 2:
        return ["a SPLIT plan needs at least two packages (otherwise write PLAN: SINGLE)"]
    for p_ in pkgs:
        if isinstance(p_, dict) and repos and package_repo(p_, repos) not in repos:
            problems.append("%s: repo must be one of the repositories the job changes (%s)" % (
                p_.get("id"), ", ".join(repos)))
        elif isinstance(p_, dict) and repos and len(repos) > 1 and not p_.get("repo"):
            problems.append("%s: name its repository (repo: %s)" % (p_.get("id"), " or ".join(repos)))
    ids = [p_.get("id") for p_ in pkgs if isinstance(p_, dict)]
    if len(ids) != len(pkgs) or len(set(ids)) != len(ids) or not all(isinstance(i, str) and WP_ID_RE.match(i)
                                                                      for i in ids):
        problems.append("package ids must be unique and look like wp0, wp1, …")
    for p_ in pkgs:
        if not isinstance(p_, dict):
            continue
        if not p_.get("owns") or not isinstance(p_["owns"], list):
            problems.append("%s: owns must list the files or globs it may change" % p_.get("id"))
        for dep in p_.get("after") or []:
            if dep not in ids:
                problems.append("%s: after %s, which is not a package" % (p_.get("id"), dep))
    # Cycles.
    deps = {p_["id"]: set(p_.get("after") or []) for p_ in pkgs if isinstance(p_, dict) and p_.get("id")}
    seen, stack = set(), set()

    def visit(n):
        if n in stack:
            return True
        if n in seen:
            return False
        seen.add(n)
        stack.add(n)
        cyc = any(visit(d) for d in deps.get(n, ()) if d in deps)
        stack.discard(n)
        return cyc
    if any(visit(n) for n in deps):
        problems.append("the packages wait for each other in a circle (after)")
    # No file may belong to two packages (of the same repository).
    globs = {}
    for p_ in pkgs:
        for g in (p_.get("owns") or []) if isinstance(p_, dict) else []:
            key = (package_repo(p_, repos), g)
            if key in globs and globs[key] != p_.get("id"):
                problems.append("%s is owned by both %s and %s" % (g, globs[key], p_.get("id")))
            globs.setdefault(key, p_.get("id"))
    groups = files.items() if isinstance(files, dict) else [(None, files)]
    for repo, group in groups:
        mine = [p_ for p_ in pkgs if isinstance(p_, dict) and (repo is None or package_repo(p_, repos) == repo)]
        for f in group:
            owners = [p_["id"] for p_ in mine if match_any(f, p_.get("owns") or [])]
            if len(owners) > 1:
                problems.append("%s%s matches the files of %s: every file must belong to one package" % (
                    "%s:" % repo if repo and len(groups) > 1 else "", f, " and ".join(owners)))
                if len(problems) > 30:
                    return problems
    return problems


def wp_pseudo_job(ctx, job, pid):
    p_ = job["split"]["packages"][pid]
    return dict(job, id="%s-%s" % (job["id"], pid), of=job["id"], worktree=p_["clone"], port=p_["port"],
                app_dir=os.path.join(ctx.job_dir(job["id"]), "wp", pid))


def wp_open_clone(ctx, job, pid):
    """The package's own clone of its repository, on its own branch, with everything already merged into the job's
    branch there."""
    p_ = job["split"]["packages"][pid]
    e = job["repos"][p_.get("repo") or job_primary(job)]
    if os.path.isdir(p_["clone"]):
        git(["fetch", "-q", "origin", e["branch"]], p_["clone"])
        if git_job(["merge", "--no-edit", "-q", "FETCH_HEAD"], p_["clone"], check=False).returncode != 0:
            git_job(["merge", "--abort"], p_["clone"], check=False)
            raise FxError("package %s's clone cannot take the latest merged code; its unmerged work conflicts" % pid,
                          code=3)
    else:
        if os.path.exists(p_["clone"]):
            shutil.rmtree(p_["clone"], ignore_errors=True)
        run(["git", "clone", "-q", e["worktree"], p_["clone"]], check=True)
        git(["checkout", "-q", "-b", p_["branch"], "origin/%s" % e["branch"]], p_["clone"])
        copy_local_files(ctx, p_["clone"], p_.get("repo"))
        baselines_fill_clone(ctx, p_["clone"], p_.get("repo"))
    p_["base"] = git(["rev-parse", "HEAD"], p_["clone"]).stdout.strip()


def wp_own_ports(ctx, job, pid):
    """A package about to start runs the project's stack on its ports, so no other clone of the job may have them too.
    An older fx gave the packages of a job ports one apart: such a package gets a block of its own here, before its
    builder is told its port. The new port, or None when it keeps the one it has."""
    p_ = job["split"]["packages"][pid]
    step = max(1, int(ctx.c("ports.step", 10) or 10))
    port, me = p_.get("port"), "package %s of %s" % (pid, job["id"])
    if isinstance(port, int) and not isinstance(port, bool) and port > 0 and not any(
            who != me and o < port + step and port < o + w for o, w, who in ports_of_job(job, step)):
        return None
    wp_stack_stop(ctx, job, pid)  # whatever still runs on the ports it leaves
    p_["port"] = ports_take(ctx, "%s|%s|package %s" % (ctx.factory, job["id"], pid))[0]
    return p_["port"]


def cmd_split(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "build":
        raise FxError("split runs in the build stage; %s is in %s" % (job["id"], job["stage"]))
    if job.get("best_of") and not job.get("best_of_done"):
        raise FxError("this job builds best-of-N candidates; it is not split")
    jd = ctx.job_dir(job["id"])
    mode, pkgs, err = parse_plan(read(os.path.join(jd, "plan.md"), "") or "")
    if err:
        raise FxError(err, code=6, extra={"retry_agent": "planner"})
    old = (job.get("split") or {}).get("packages") or {}
    overlaps = (section(read(os.path.join(jd, "plan.md"), "") or "", "Overlaps with other jobs") or "").strip()
    more = {"overlaps": overlaps[:2000]} if overlaps else {}  # the planner saw another job changing the same files
    if mode == "single":
        if old and not a.update:
            raise FxError("the job is already split")
        job["split"] = {"mode": "single"}
        ctx.save(job, "plan: one builder")
        out(dict({"ok": True, "job": job["id"], "mode": "single", "next": "build"}, **more))
        return
    repos = job_names(job, "change")
    files = {n: list_files(job["repos"][n]["worktree"]) for n in repos}
    problems = validate_packages(pkgs, files, repos)
    if problems:
        raise FxError("plan.md: " + "; ".join(problems[:15]), code=6, extra={"retry_agent": "planner",
                                                                           "problems": problems})
    if old and not a.update:
        raise FxError("the job is already split; use --update after the planner changed plan.md")
    # Each package runs the project's own stack in its own clone: a block of ports of its own, like a job's, never the
    # next port up from its neighbour's.
    fresh = [p_["id"] for p_ in pkgs if not (old.get(p_["id"]) or {}).get("port")]
    blocks = dict(zip(fresh, ports_take(ctx, "%s|%s|packages" % (ctx.factory, job["id"]), count=len(fresh)) if fresh else []))
    packages = {}
    for i, p_ in enumerate(pkgs):
        pid = p_["id"]
        prev = old.get(pid) or {}
        repo = package_repo(p_, repos)
        e = job["repos"][repo]
        entry = {"title": str(p_.get("title") or pid)[:120], "repo": repo, "owns": list(p_["owns"]),
                 "after": list(p_.get("after") or []), "contract": bool(p_.get("contract")),
                 "criteria": p_.get("criteria") or [],
                 "clone": "%s--%s" % (e["worktree"], pid), "branch": "%s--%s" % (e["branch"], pid),
                 "port": prev.get("port") or blocks[pid], "db": app_db(ctx, {"id": "%s-%s" % (job["id"], pid)}),
                 "status": prev.get("status", "pending"), "tries": prev.get("tries", 0), "reason": prev.get("reason"),
                 "feedback": prev.get("feedback"), "base": prev.get("base")}
        if prev.get("status") == "request" or p_.get("reopen"):
            entry.update(status="pending", reason="resumed", request=None)
        if prev.get("merged"):
            entry["merged"] = prev["merged"]
        if entry["status"] == "building":  # its builder is still at work: without its place its room is handed out again
            entry.update({k: prev[k] for k in ("place", "session") if prev.get(k)})
        packages[pid] = entry
    job["split"] = {"mode": "split", "packages": packages, "order": [p_["id"] for p_ in pkgs],
                    "integrator_feedback": (job.get("split") or {}).get("integrator_feedback")}
    ctx.save(job, "plan: %d packages" % len(pkgs))
    out(dict({"ok": True, "job": job["id"], "mode": "split",
              "packages": [{"id": k, "title": v["title"], "repo": v["repo"], "after": v["after"], "owns": v["owns"]}
                           for k, v in packages.items()], "next": "wp next"}, **more))


def wp_report(ctx, job, pid):
    path = os.path.join(ctx.job_dir(job["id"]), "build-%s.md" % pid)
    line = first_line(path)
    m = WP_STATUS_RE.match(line or "")
    return (m.group(1) if m else None), read(path, "") or "", path


def wp_integrate(ctx, job, pid):
    """Merge a finished package into the job's branch of its repository, if it kept to its own files."""
    p_ = job["split"]["packages"][pid]
    pc = p_["clone"]
    repo = p_.get("repo") or job_primary(job)
    e = job["repos"][repo]
    tracked, untracked = worktree_dirt(ctx, pc, repo)
    problems = []
    if tracked or untracked:
        problems.append("uncommitted work in your clone: commit it (%s)" % ", ".join(
            (tracked.splitlines() + untracked)[:5]))
    # What merging this package would change in the job's branch (other packages' merged work excluded).
    git(["fetch", "-q", "origin", e["branch"]], pc)
    changed = git(["diff", "--name-only", "FETCH_HEAD...HEAD"], pc).stdout.split()
    pkgs = {k: v for k, v in job["split"]["packages"].items() if (v.get("repo") or repo) == repo}
    for f in changed:
        owners = [k for k, v in pkgs.items() if match_any(f, v["owns"])]
        if pid not in owners:
            problems.append("%s is not one of your files%s" % (f, " (it belongs to %s)" % ", ".join(owners)
                                                                if owners else ""))
        elif len(owners) > 1:
            problems.append("%s belongs to %s as well" % (f, ", ".join(o for o in owners if o != pid)))
    if not changed and not problems:
        p_["status"] = "integrated"
        p_["reason"] = None
        return []
    if problems:
        return problems
    wt = e["worktree"]
    git(["fetch", "-q", pc, p_["branch"]], wt)
    mr = git_job(["merge", "--no-ff", "--no-edit", "-m", "%s: merge %s (%s)" % (job["issue_key"], pid, p_["title"]),
                  "FETCH_HEAD"], wt, check=False)
    if mr.returncode != 0:
        git(["merge", "--abort"], wt, check=False)
        return ["merging into the job's branch conflicts: %s" % (mr.stdout or "")[-300:]]
    baselines_take_images(ctx, pc, wt, repo)
    p_["status"] = "integrated"
    p_["reason"] = None
    p_["merged"] = git(["rev-parse", "HEAD"], wt).stdout.strip()
    return []


def cmd_wp(ctx, a):
    job = ctx.load(a.job)
    sp = job.get("split") or {}
    if sp.get("mode") != "split":
        raise FxError("%s is not a split build" % job["id"])
    pkgs = sp["packages"]
    jd = ctx.job_dir(job["id"])
    if a.action == "done":
        if a.id not in pkgs:
            raise FxError("no package %s" % a.id)
        status, text, path = wp_report(ctx, job, a.id)
        if not status:
            raise FxError("%s is missing or does not start with STATUS: READY|BLOCKED|NEEDS-INFO|CHANGE-REQUEST"
                          % os.path.basename(path), code=6, extra={"retry_agent": "builder", "wp": a.id})
        p_ = pkgs[a.id]
        res = {"ok": True, "job": job["id"], "package": a.id, "status": status}
        if status == "READY":
            problems = wp_integrate(ctx, job, a.id)
            if problems:
                p_["tries"] = p_.get("tries", 0) + 1
                fb = os.path.join(jd, "wp-%s-feedback-%d.md" % (a.id, p_["tries"]))
                write_atomic(fb, "# Package %s was not merged\n\n" % a.id + "\n".join("- " + x for x in problems) + "\n")
                if p_["tries"] > int(ctx.c("split.max_tries", 2)):
                    p_.update(status="blocked", reason="kept failing: %s" % problems[0])
                else:
                    p_.update(status="pending", reason="violation", feedback=fb)
                res.update(status=p_["status"], problems=problems)
            else:
                res["merged"] = True
        elif status == "CHANGE-REQUEST":
            p_.update(status="request", request=section(text, "Change request") or text[:1500])
        elif status == "NEEDS-INFO":
            p_.update(status="question")
        else:
            p_.update(status="blocked", reason=(section(text, "Why") or text.split("\n", 2)[-1]).strip()[:500])
        res["status"] = p_["status"]
        wp_place_end(ctx, job, a.id)
        if p_["status"] in TERMINAL_WP:
            wp_stack_stop(ctx, job, a.id)  # nobody else stops it, and it keeps memory, ports and a Docker network
        ctx.save(job, "package %s: %s" % (a.id, p_["status"]))
        res["next"] = "wp next"
        out(res)
        return
    if a.action == "feedback":
        n = job["round"]
        rdir = os.path.join(jd, "round-%d" % n)
        lines_ = []
        cm = read(os.path.join(rdir, "checks.md"), "") or ""
        if cm.startswith("GATE: FAIL"):
            lines_ += ["[gate] " + l for l in (section(cm, "Problems") or "").split("\n- ") if l.strip()]
        for f in sorted(os.listdir(rdir)) if os.path.isdir(rdir) else []:
            if re.match(r"^review-\w+\.md$", f) and (first_line(os.path.join(rdir, f)) or "").endswith("CHANGES"):
                if f == "review-security.md" and (first_line(os.path.join(rdir, "verify-security.md")) or "") \
                        .endswith("PASS"):
                    continue
                for l in (read(os.path.join(rdir, f), "") or "").splitlines():
                    if FINDING_RE.match(l):
                        lines_.append("[%s] %s" % (f[7:-3], l.strip()))
        assigned, rest = {}, []
        roots = {n: job["repos"][n].get("worktree") for n in job_names(job, "change")}
        for l in lines_:
            owners = {k for repo, path in finding_places(l, job_names(job, "change"), roots) for k, v in pkgs.items()
                      if (repo is None or (v.get("repo") or job_primary(job)) == repo) and match_any(path, v["owns"])}
            if len(owners) == 1:
                assigned.setdefault(owners.pop(), []).append(l)
            else:
                rest.append(l)
        for k, ls in assigned.items():
            fb = os.path.join(rdir, "feedback-%s.md" % k)
            write_atomic(fb, "# Round %d findings for package %s\n\nFull reports: %s\n\n%s\n" % (
                n, k, rdir, "\n".join("- " + l for l in ls)))
            pkgs[k].update(status="pending", reason="feedback", feedback=fb, tries=0)
        sp["integrator_feedback"] = None
        if rest:
            fb = os.path.join(rdir, "feedback-integrator.md")
            write_atomic(fb, "# Round %d findings no single package owns\n\nFull reports: %s\n\n%s\n" % (
                n, rdir, "\n".join("- " + l for l in rest)))
            sp["integrator_feedback"] = fb
        ctx.save(job, "round %d findings: %s to packages, %d to the integrator" % (n, sorted(assigned), len(rest)))
        out({"ok": True, "job": job["id"], "packages": sorted(assigned), "integrator": bool(rest), "next": "wp next"})
        return
    # next: start whatever can start now; say what the orchestrator should do.
    me = (session_me() or {}).get("session")
    back = [k for k, v in pkgs.items() if v["status"] == "building" and me and v.get("session") and v["session"] != me]
    for k in back:
        # Its builder ran in another chat session: one that is over, or one this session took the job from. Nobody here
        # will ever report it done, and it holds no room any more. It starts again, in its own clone, with whatever its
        # builder committed there.
        wp_place_end(ctx, job, k)
        pkgs[k].update(status="pending", reason="session")
        pkgs[k].pop("session", None)
    building = [k for k, v in pkgs.items() if v["status"] == "building"]
    cap = int(ctx.c("split.max_builders", 0) or 0)
    ready = [k for k in sp["order"] if pkgs[k]["status"] == "pending"
             and all(pkgs[d]["status"] == "integrated" for d in pkgs[k]["after"])]
    if cap:
        ready = ready[:max(0, cap - len(building))]
    # Each package runs the project's stack and its tests: only as many as this machine has room for now, counted over
    # every job and every session. The rest start as the others finish (fx wp done gives the room back).
    started, places, why, moved = [], {}, None, {}
    for k in ready:
        lease, why = wp_place_take(ctx, job, k, wait=bool(getattr(a, "wait", False)) and not building and not started)
        if not lease:
            break
        wait_note(ctx, job, "package", k, lease)
        try:
            port = wp_own_ports(ctx, job, k)
            if port:
                moved[k] = port
            wp_open_clone(ctx, job, k)
        except BaseException:
            place_release(lease["id"])
            for other in places.values():
                place_release(other["id"])
            raise
        pkgs[k].update(status="building", place=lease["id"], **({"session": me} if me else {}))
        started.append(k)
        places[k] = lease
    queued = [k for k in ready if k not in started]
    room = {"waiting_for_room": queued, "why": why} if queued else {}
    if moved:
        room["ports_moved"] = moved  # an older fx had given them ports one apart
    if back:
        room["reopened"] = back
        if not started:
            ctx.save(job, "packages an earlier session was building, to be started again: %s" % ", ".join(back))
    if started:
        ctx.save(job, "packages started: %s" % ", ".join(started))
        for k, lease in places.items():
            wp_place_keep(ctx, job, k, lease)
        out(dict({"ok": True, "job": job["id"], "start": [{"id": k, "title": pkgs[k]["title"]} for k in started],
                  "building": building, "next": "spawn a builder for each started package (fx ctx <job> --agent builder "
                                                "--wp <id>), in the background; on each one's completion: fx wp done"},
                 **room))
        return
    if building:
        out(dict({"ok": True, "job": job["id"], "building": building, "next": "wait"}, **room))
        return
    if queued:  # nothing of this job is being built, so no fx wp done will come to start them
        out({"ok": True, "job": job["id"], "waiting_for_room": queued, "why": why, "next": "wait-room",
             "then": "%s wp next %s --wait" % (FX_CMD, shlex.quote(job["id"])),
             "note": "this machine has no room for another package now. Nothing failed: run `then` in the background; it "
                     "returns when the first package can start"})
        return
    requests = [k for k, v in pkgs.items() if v["status"] == "request"]
    if requests:
        out({"ok": True, "job": job["id"], "requests": {k: pkgs[k].get("request") for k in requests},
             "next": "planner"})
        return
    questions = [k for k, v in pkgs.items() if v["status"] == "question"]
    if questions:
        qs, n = [], 0
        for k in questions:
            rep_text = wp_report(ctx, job, k)[1]
            i = rep_text.find("## Questions")
            text = rep_text[i + len("## Questions"):] if i >= 0 else ""
            text = re.split(r"(?m)^##\s+(?!Q\d+:)", text)[0]
            for blk in re.split(r"(?m)^## Q\d+:", text)[1:]:
                n += 1
                qs.append("## Q%d: [%s] %s" % (n, k, blk.strip()))
            pkgs[k].update(status="pending", reason="answers") if text.strip() else \
                pkgs[k].update(status="blocked", reason="asked for information without a ## Questions section")
        if not qs:
            ctx.save(job, "package questions missing")
            out({"ok": True, "job": job["id"], "next": "wp next"})
            return
        write_atomic(os.path.join(jd, "questions.md"), "\n\n".join(qs) + "\n")
        set_needs_info(ctx, job, "build")
        out({"ok": True, "job": job["id"], "questions_from": questions, "next": "ask"})
        return
    waiting = [k for k, v in pkgs.items() if v["status"] not in TERMINAL_WP]
    blocked = [k for k, v in pkgs.items() if v["status"] == "blocked"]
    if blocked or waiting:
        lines_ = ["STATUS: BLOCKED", "", "## Why", ""]
        lines_ += ["- %s (%s): %s" % (k, pkgs[k]["title"], pkgs[k].get("reason") or "blocked") for k in blocked]
        lines_ += ["- %s (%s): could not start, it waits for a blocked package" % (k, pkgs[k]["title"])
                   for k in waiting]
        write_atomic(os.path.join(jd, "build.md"), "\n".join(lines_) + "\n")
        ctx.save(job, "split build blocked")
        out({"ok": True, "job": job["id"], "blocked": blocked, "next": "result build"})
        return
    out({"ok": True, "job": job["id"], "next": "integrate",
         "note": "every package is merged: spawn one builder without --wp (the integrator)"})


