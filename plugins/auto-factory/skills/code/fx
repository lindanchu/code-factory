def removed_command(argv):
    """The error for a command that is gone (REMOVED_COMMANDS); None for anything else. The factory folder before the
    command (--repo <folder>) is skipped: a command's own --repo <name> names one of the project's repositories."""
    rest, skip = [], False
    for x in argv or []:
        if skip:
            skip = False
            continue
        if x == "--repo":
            skip = True
            continue
        rest.append(x)
    first = next((x for x in rest if not x.startswith("-")), None)
    return REMOVED_COMMANDS.get(first)


def merge_settings(cur, new):
    """new over cur, block by block: what only cur has in a block stays, such as a setting the older layout did not
    know."""
    if isinstance(cur, dict) and isinstance(new, dict):
        return dict(cur, **{k: merge_settings(cur.get(k), v) for k, v in new.items()})
    return new


def pr_description(ctx, job, repo=None, links=None):
