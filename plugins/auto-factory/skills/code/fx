def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8", errors="backslashreplace") as f:
        f.write(text)
    os.replace(tmp, path)


def read(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read()
    except FileNotFoundError:
        return default


def first_line(path):
    text = read(path)
    if text is None:
        return None
    for line in text.splitlines():
        if line.strip():
            return line.strip()
    return ""


def slugify(text, maxlen=40):
    t = unicodedata.normalize("NFKD", text or "")
    t = t.replace("đ", "d").replace("Đ", "D")
    t = "".join(c for c in t if not unicodedata.combining(c))
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    t = t[:maxlen].rstrip("-")
    return t or "task"


def match_any(path, patterns):
    return any(fnmatch.fnmatch(path, p) for p in patterns)


def try_out(cmd, timeout=20, env=None):
    """A command's output, or None when it is not there, fails or takes too long: for what fx only reads if it can."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace",
                           timeout=timeout, env=env)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


_GONE = object()  # merge3: the key is not there


def merge3(base, mine, theirs):
    """What a file should hold when two commands changed it from the same start: each keeps what it changed, and where
    both changed the same thing the one saving now (mine) wins. A list both only added to keeps both additions: also
    one neither had at the start (the first runs of a job, noted by four prompts asked in one message), and also when
    the other command dropped the oldest entries since (JOB_LIST_CAPS), which moves every entry up."""
    if base is _GONE or base is None:  # both made it since: as if it had been there, empty
        if isinstance(mine, dict) and isinstance(theirs, dict):
            base = {}
        elif isinstance(mine, list) and isinstance(theirs, list):
            base = []
    if mine == base:
        return theirs
    if theirs == base or mine == theirs:
        return mine
    if isinstance(base, dict) and isinstance(mine, dict) and isinstance(theirs, dict):
        merged = {}
        for k in list(mine) + [k for k in theirs if k not in mine]:
            v = merge3(base.get(k, _GONE), mine.get(k, _GONE), theirs.get(k, _GONE))
            if v is not _GONE:
                merged[k] = v
        return merged
    if isinstance(base, list) and isinstance(mine, list) and isinstance(theirs, list):
        n, cut = len(base), 0
        if n and theirs and theirs[0] != base[0]:
            cut = next((i for i in range(1, n) if base[i] == theirs[0]), 0)  # theirs starts that many entries later
        if len(mine) >= n and len(theirs) >= n - cut:
            head = [merge3(b, m, t) for b, m, t in zip(base[cut:], mine[cut:n], theirs[:n - cut])]
            return head + theirs[n - cut:] + [x for x in mine[n:] if x not in theirs[n - cut:]]
    return mine


