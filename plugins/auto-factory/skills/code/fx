# a mobile app: the same UI check on virtual phones (mobile.py)

_MOBILE = []


def MOB():
    """The factory's phones (mobile.py, next to this file)."""
    if not _MOBILE:
        if SKILL_DIR not in sys.path:
            sys.path.insert(0, SKILL_DIR)
        import mobile as m  # noqa: E402
        _MOBILE.append(m)
    return _MOBILE[0]


def mobile_conf(ctx):
    """The project's mobile block (factory.json → mobile), when the project is a mobile app: its platforms, how each
    build is made (build.<platform>, artifact.<platform>), the app's id per platform and where the app finds its API
    (api_path, on the job's own app address)."""
    m = ctx.c("mobile") if ctx and getattr(ctx, "cfg", None) else None
    return m if isinstance(m, dict) and m.get("platforms") else None


def mobile_missing(ctx, root):
    """A repository that is a mobile app (it became one after init, or init was told "later") while the factory has no
    mobile set-up: its screens are not a web's, so the check stops and asks for the set-up instead of opening a browser
    on nothing. Init's answer "no" (this repository is not the app) is kept."""
    if not root or not os.path.isdir(root):
        return
    m = ctx.c("mobile") if ctx and getattr(ctx, "cfg", None) else None
    if isinstance(m, dict) and str(m.get("app") or "").lower() == "no":
        return
    kind = MOB().app_kind(root)
    if kind:
        if isinstance(ctx, ReviewBoxCtx) and (ctx._repo.get("legacy") or not ctx._repo.get("primary")
                                               and "repo" not in ctx._repo):
            raise FxError("this repository looks like a mobile app (%s) and the factory has no mobile set-up for it: ask "
                          "the user whether it is one (init's **Is there a mobile app?**); a yes goes through **A mobile "
                          "app** into the mobile block of this repository's entry in review.repos. Commit and push the "
                          "factory repository, then run this check again" % kind, code=3,
                          extra={"next": "setup-mobile", "app": kind, "where": "review.repos[].mobile"})
        name = ctx._repo.get("repo") if isinstance(ctx, ReviewBoxCtx) else getattr(ctx, "scope", None)
        own = len(getattr(ctx, "repos", None) or ()) > 1 and name
        raise FxError("this repository looks like a mobile app (%s) and the factory has no mobile set-up for it: ask the "
                      "user whether it is one (init's **Is there a mobile app?**); a no is saved as mobile.app=no and "
                      "nothing is asked again; a yes goes through **A mobile app** into %s. Commit and push the factory "
                      "repository, then run this check again" % (
                          kind, "the mobile block of %s's entry in repos" % name if own else "factory.json's mobile block"),
                      code=3, extra={"next": "setup-mobile", "app": kind, "repo": name,
                                     "where": "repos[%s].mobile" % name if own else "mobile"})


def mobile_devices(conf, host, preset):
    """The phones of a step. The project's own list (mobile.devices, written by init from the preset its owner chose)
    or the preset planned on this machine; code and review take the smallest and largest of each platform."""
    M = MOB()
    plats = [p for p in conf.get("platforms") or [] if p in M.PLATFORMS]
    devs = [d for d in conf.get("devices") or [] if isinstance(d, dict) and d.get("platform") in plats]
    if devs:
        devs = [d for d in devs if d["platform"] != "ios" or host.mac]
        return M.ends_of(devs) if preset == "ends" else devs
    # every size on every version for the auto test; the smallest phone on the oldest version and the largest on the
    # newest for code and review
    return M.plan_devices(host, conf.get("preset") or "standard", plats, conf, matrix="ends" if preset == "ends" else "cross")


def mobile_line(ctx):
    """The prompt line of an agent that writes or reads a UI check of a mobile app."""
    conf = mobile_conf(ctx)
    try:
        host = MOB().Host(tools_dir())
        phones = ", ".join("%s (%s, %s)" % (d["key"], d["name"], d["screen"]) for d in mobile_devices(conf, host, "ends"))
    except Exception as e:  # noqa: BLE001 -- the line still says how the check runs
        phones = "the smallest and largest phone of each platform (%s)" % str(e)[:120]
    return ("This project is a mobile app: a UI check script drives the app on virtual phones, not a page in a browser. "
            "Same `ui.run(async (t) => { ... })`, `t.step`, `t.snap`, `t.design`; instead of `t.page` and `t.goto`: "
            "`t.see(text)`, `t.notSee(text)`, `t.tap(text)`, `t.type(label, value)`, `t.find(text)`, "
            "`t.swipe('left'|'right'|'up'|'down')`, `t.back()`, `t.restart()` (data kept), `t.reset()` (data cleared), "
            "`t.background(seconds)`, `t.openLink(url)`, `t.answerPermission(true|false)`; `t.app` is the WebdriverIO "
            "session, `t.device` the phone. Elements are found by what a user sees: their text or accessibility label "
            "(a control without one is an accessibility finding). The script runs once per phone, each starting with the "
            "app's data cleared: %s. The app is built from the commit (%s) and pointed at the job's own API; a build that "
            "fails fails the check. Crashes and uncaught errors of the app count as console errors. A shipped build shows "
            "no styles: t.design measures position, size, text and colour (from the screenshot), never the font, corners, "
            "borders or shadows: look at those on the images" % (
                phones or "none can run on this machine",
                ", ".join("%s: %s" % (p, (conf.get("build") or {}).get(p) or "no command") for p in conf.get("platforms") or [])))


def ui_run_mobile(ctx, job, script, out_dir, conf):
    """The UI check of a mobile app: the job's API started (app.up), the app built from the job's commit and pointed at
    it, then the check script once per phone, one phone at a time (each started, the build installed, Appium up; a
    phone that was already running is left running). The reports of the phones become one, in the web's shape."""
    M = MOB()
    host = M.Host(tools_dir())
    os.makedirs(out_dir, exist_ok=True)
    report_path = os.path.join(out_dir, "ui-report.json")
    if os.path.exists(report_path):
        os.remove(report_path)
    if not host.appium and not host.wsl:
        return {"skipped": "Appium is not installed for the factory: run /auto-factory:code install"}
    info = app_start(ctx, job)
    api = info["url"].rstrip("/") + (conf.get("api_path") or "")
    commit = git(["rev-parse", "HEAD"], job["worktree"], check=False).stdout.strip()
    # a builder checks its screens before it commits: what is not committed yet is part of the build too
    dirty = git(["status", "--porcelain"], job["worktree"], check=False).stdout + \
        git(["diff", "HEAD"], job["worktree"], check=False).stdout
    if dirty.strip():
        commit += "+" + hashlib.sha1(dirty.encode("utf-8", "replace")).hexdigest()[:12]
    env0, _db = app_env(ctx, job)
    plats = [p for p in conf.get("platforms") or [] if p in M.PLATFORMS and (p != "ios" or host.mac)]
    notes = [] if host.mac or "ios" not in (conf.get("platforms") or []) else ["iOS not run: iOS simulators need macOS"]
    try:
        apps, more = M.builds_for(conf, plats, job["worktree"], env0, api, commit,
                                  os.path.join(app_home(ctx, job), "mobile-builds"))
    except M.MobileError as e:
        rep_ = {"steps": [], "shots": [], "console": [], "requests": [], "a11y": [], "design": [],
                "error": "the app did not build from this commit: %s" % e}
        write_atomic(report_path, json.dumps(rep_, indent=1, ensure_ascii=False) + "\n")
        return ui_judge(ctx, rep_)
    notes += more
    try:
        devices = mobile_devices(conf, host, "ends")
    except M.MobileError as e:
        return {"skipped": "the phones could not be planned: %s" % e}
    if not devices:
        return {"skipped": "no phone can run here (%s): run /auto-factory:code install" % (", ".join(plats) or "no platform")}
    tdir = test_skill_dir()
    merged = {"steps": [], "shots": [], "console": [], "requests": [], "a11y": [], "design": [], "error": None,
              "devices": [], "notes": notes}
    for dev in devices:
        app = apps.get(dev["platform"])
        if not app:
            merged["notes"].append("%s not run: no %s build of the app" % (dev["key"], dev["platform"]))
            continue
        ddir = os.path.join(out_dir, dev["key"])
        os.makedirs(ddir, exist_ok=True)
        try:
            denv, dtmp, dinfo = design_setup(ctx, job)
        except (OSError, ValueError, FxError) as e:
            dtmp = tempfile.mkdtemp(prefix="fx-design-")
            dinfo = {"why": "the design setup failed: %s" % str(e).splitlines()[0][:200], "packages": [], "viewport": None}
            denv = {"FACTORY_UI_DESIGN": os.path.join(dtmp, "setup.json")}
            write_atomic(denv["FACTORY_UI_DESIGN"], json.dumps({"packages": [], "why": dinfo["why"]}) + "\n")
        sess = M.Session(tools_dir(), [dev], {dev["platform"]: app}, os.path.join(ddir, "device"),
                         window=job.get("phones") == "window")
        try:
            sess.open()
        except M.MobileError as e:
            shutil.rmtree(dtmp, ignore_errors=True)
            if e.code == 75:
                merged["notes"].append("%s not run: %s" % (dev["key"], e))
                continue
            # a phone that does not start is the machine's, never the job's
            merged["notes"].append("%s could not start: %s" % (dev["key"], e))
            continue
        dreport = os.path.join(ddir, "ui-report.json")
        try:
            setup_file = os.path.join(ddir, "mobile.json")
            write_atomic(setup_file, json.dumps(sess.describe(), indent=1, ensure_ascii=False) + "\n")
            env = project_env(ctx, NODE_PATH=node_path(), BASE_URL=api,
                              **dict(baselines_env(ctx, job["worktree"]), **lane_env(ctx, job)),
                              FACTORY_UI=os.path.join(SKILL_DIR, "factory-ui.js"), FACTORY_UI_REPORT=dreport,
                              FACTORY_UI_SHOTS=os.path.join(ddir, "shots"), FACTORY_UI_MOBILE=setup_file,
                              FACTORY_UI_APP_LIB=os.path.join(tdir, "runtime", "app.js") if tdir else "",
                              FACTORY_UI_BLOCK_STATUS=str(ctx.c("ui_checks.block_on_status", 500)),
                              FACTORY_UI_DESIGN=denv["FACTORY_UI_DESIGN"])
            try:
                p = run(["node", os.path.abspath(script)], cwd=job["worktree"], check=False, env=env,
                        timeout=int(ctx.c("e2e_timeout_sec", 1800)), group=True)
                log = p.stdout or ""
            except subprocess.TimeoutExpired:
                log = "ui check timed out on %s" % dev["key"]
            write_atomic(os.path.join(ddir, "ui.log"), log)
        finally:
            sess.close()
            shutil.rmtree(dtmp, ignore_errors=True)
        merged["notes"] += sess.notes
        try:
            r = json.loads(read(dreport, "") or "")
        except ValueError:
            r = {"error": "the check script wrote no report on %s; see %s:\n%s" % (
                dev["key"], os.path.join(ddir, "ui.log"), "\n".join(log.splitlines()[-20:]))}
        mobile_merge(merged, r, dev, dinfo)
    if not merged["devices"] and not merged["error"]:
        return {"skipped": "no phone ran the check: %s" % "; ".join(merged["notes"][:6])}
    write_atomic(report_path, json.dumps(merged, indent=1, ensure_ascii=False) + "\n")
    rep_ = ui_judge(ctx, merged)
    rep_["notes"] = (merged.get("notes") or []) + rep_.get("notes", [])
    return rep_


def mobile_merge(merged, r, dev, dinfo):
    """One phone's report into the step's: each step, screen and finding named with its phone."""
    tag = dev["key"]
    merged["devices"].append({"key": tag, "name": dev.get("name"), "os": dev.get("os"), "screen": dev.get("screen")})
    if r.get("browser_missing"):
        merged["notes"].append("%s: the design pages need Chromium: %s" % (tag, r["browser_missing"][:200]))
    if r.get("error"):
        merged["error"] = ((merged["error"] + "\n") if merged["error"] else "") + "[%s] %s" % (tag, r["error"])
    for st in r.get("steps") or []:
        merged["steps"].append(dict(st, name="[%s] %s" % (tag, st.get("name"))))
    for sh in r.get("shots") or []:
        merged["shots"].append(dict(sh, viewport="%s %s" % (tag, dev.get("screen") or sh.get("viewport") or "")))
    for c in r.get("console") or []:
        merged["console"].append(dict(c, url="%s %s" % (tag, c.get("url") or "")))
    for v in r.get("a11y") or []:
        merged["a11y"].append(dict(v, page="[%s] %s" % (tag, v.get("page"))))
    for d in r.get("design") or []:
        merged["design"].append(dict(d, device=tag, name="%s · %s" % (d.get("name") or d.get("code"), tag)))
    merged["design_info"] = {"why": dinfo.get("why"), "viewport": None, "thresholds": dinfo.get("thresholds"),
                             "packages": ["%s (%d states)" % (p_["version"], len(p_["codes"])) for p_ in dinfo.get("packages") or []]}


def cmd_mobile(ctx, a):
    """The phones of a mobile project, for the auto test (tx) and for a person: plan and make the devices, check the
    tools, build the app, run a command with the phones started (session), check that an APK installs and opens."""
    M = MOB()
    host = M.Host(tools_dir())
    conf = mobile_conf(ctx) or {}
    plats = [p for p in (a.platforms.split(",") if a.platforms else conf.get("platforms") or list(M.PLATFORMS))
             if p in M.PLATFORMS]
    try:
        if a.action == "doctor":
            out({"ok": True, "platform": "wsl" if host.wsl else sys.platform, "tools": host.status(plats),
                 "appium": {"ok": bool(host.appium) or host.wsl, "path": host.appium, "home": host.appium_home},
                 "presets": M.PRESET_INFO})
        elif a.action == "devices":
            dconf = json.loads(read(a.conf, "") or "{}") if a.conf else conf
            preset = a.preset or dconf.get("preset") or "standard"
            devs = M.plan_devices(host, preset, plats, dconf, matrix="ends" if a.ends else "cross")
            notes = list(M.plan_devices.notes)
            if a.keys:
                devs = [d for d in devs if d["key"] in a.keys.split(",")]
            made, missing = {}, sorted({d["image"] for d in devs if d["platform"] == "android"
                                        and d["image"] not in host.system_images()})
            if a.make:
                if missing and not a.install_images:
                    raise FxError("the Android system image(s) of %d version(s) are not installed (about 1-2 GB each): "
                                  "ask the user, then run this again with --install-images" % len(missing), code=2,
                                  extra={"next": "ask-install", "missing_images": missing})
                for d in devs:
                    made[d["key"]] = M.ensure_device(host, d, a.install_images)
            out({"ok": True, "preset": preset, "devices": devs, "made": made, "notes": notes,
                 "missing_images": [] if a.make else missing,
                 "versions": {p: sorted({d["os"] for d in devs if d["platform"] == p}) for p in plats},
                 "skipped": ["ios: iOS simulators need macOS"] if "ios" in plats and not host.mac else []})
        elif a.action == "build":
            bconf = json.loads(read(a.conf, "") or "{}") if a.conf else conf
            apps, notes = M.builds_for(bconf, plats, os.path.abspath(a.code), project_env(ctx), a.api_url or "",
                                       a.commit or "", os.path.abspath(a.out), apk_too=a.apk)
            out({"ok": bool(apps), "apps": apps, "notes": notes})
        elif a.action == "session":
            setup = json.loads(read(a.setup, "") or "{}")
            cmd = json.loads(a.cmd_json or "[]")
            if not isinstance(cmd, list) or not cmd:
                raise FxError("session needs --cmd-json, the command as a JSON list", code=3)
            outd = os.path.abspath(a.out)
            sess = M.Session(tools_dir(), setup.get("devices") or [], setup.get("apps") or {}, outd,
                             window=bool(a.window or setup.get("window")))
            sess.open()
            try:
                desc = os.path.join(outd, "mobile.json")
                write_atomic(desc, json.dumps(sess.describe(), indent=1, ensure_ascii=False) + "\n")
                env = dict(os.environ, AUTOTEST_MOBILE=desc, NODE_PATH=node_path())
                proc = subprocess.Popen(cmd, env=env, start_new_session=hasattr(os, "killpg"))
                try:
                    code = proc.wait()
                except BaseException:
                    kill_group(proc) if hasattr(os, "killpg") else proc.kill()
                    raise
            finally:
                sess.close()
            sys.exit(code)
        elif a.action == "apk-check":
            out(mobile_apk_check(M, host, a))
    except M.MobileError as e:
        raise FxError(str(e), code=e.code if e.code in (2, 3, 75) else 3, extra=e.extra)


def mobile_apk_check(M, host, a):
    """The APK of a build, checked quickly on one Android phone: it installs, it opens, and it is still in front after
    a while (the AAB is what the tests run on; this says the APK of the same commit is not broken)."""
    if not a.apk_file or not a.app_id:
        raise FxError("apk-check needs --apk-file and --app-id", code=3)
    dev = json.loads(a.device) if (a.device or "").strip().startswith("{") else None
    if not dev:
        devs = M.plan_devices(host, "ends", ["android"], matrix="ends")
        dev = next((d for d in devs if d["key"] == a.device), devs[0] if devs else None)
    if not dev:
        return {"ok": False, "why": "no Android phone can run here"}
    outd = os.path.abspath(a.out)
    with M.device_lock(dev):
        M.ensure_device(host, dev)
        h = M.boot(host, dev, outd, bool(a.window))
        try:
            M.install(host, h, os.path.abspath(a.apk_file), a.app_id, outd)
            M._run([host.adb, "-s", h["serial"], "shell", "monkey", "-p", a.app_id, "-c",
                    "android.intent.category.LAUNCHER", "1"], timeout=60)
            time.sleep(12)
            top = M._run([host.adb, "-s", h["serial"], "shell", "dumpsys", "activity", "activities"], timeout=60).stdout
            crash = M._run([host.adb, "-s", h["serial"], "logcat", "-d", "-b", "crash"], timeout=60).stdout
            shot = os.path.join(outd, "apk-check.png")
            with open(shot, "wb") as f:
                f.write(subprocess.run([host.adb, "-s", h["serial"], "exec-out", "screencap", "-p"],
                                       stdout=subprocess.PIPE, timeout=60).stdout or b"")
            front = bool(re.search(r"(mResumedActivity|topResumedActivity).*%s" % re.escape(a.app_id), top or ""))
            crashed = a.app_id in (crash or "")
            ok = front and not crashed
            return {"ok": ok, "device": dev["key"], "installed": True, "in_front": front, "crashed": crashed,
                    "screenshot": shot,
                    "why": None if ok else ("the app crashed after it opened" if crashed else "the app is not in front 12 s after it was opened")}
        except M.MobileError as e:
            return {"ok": False, "device": dev["key"], "why": str(e)}
        finally:
            M.shutdown(host, h)


def ui_judge(ctx, rep_):
    block_a11y = set(ctx.c("ui_checks.a11y_block", ["critical", "serious"]) or [])
    if rep_.get("browser_missing"):
        return {"skipped": "Playwright could not launch Chromium: %s (/auto-factory:code install)"
                           % rep_["browser_missing"][:200]}
    # The browser also logs failed responses as console errors; those are judged by status below.
    rep_["console"] = [c for c in rep_.get("console", []) if not c.get("text", "").startswith(
        "Failed to load resource")]
    blocking = []
    if rep_.get("error"):
        blocking.append("the UI check script crashed: %s" % rep_["error"].splitlines()[0][:300])
    for st in rep_.get("steps", []):
        if not st.get("ok"):
            blocking.append("UI step failed: %s: %s" % (st.get("name"), (st.get("error") or "")[:300]))
    if ctx.c("ui_checks.block_on_console_errors", True):
        for c in rep_.get("console", [])[:10]:
            blocking.append("browser console error on %s: %s" % (c.get("url"), c.get("text", "")[:200]))
    for r in rep_.get("requests", []):
        if r.get("blocking") or r.get("failure"):
            blocking.append("request %s %s -> %s" % (r.get("method"), r.get("url"), r.get("status") or r.get("failure")))
    for v in rep_.get("a11y", []):
        if v.get("impact") in block_a11y:
            blocking.append("accessibility (%s) %s on %s: %s" % (v.get("impact"), v.get("id"), v.get("page"),
                                                                 v.get("help")))
    notes = ["accessibility (%s) %s on %s" % (v.get("impact"), v.get("id"), v.get("page"))
             for v in rep_.get("a11y", []) if v.get("impact") not in block_a11y]
    notes += ["request %s %s -> %s" % (r.get("method"), r.get("url"), r.get("status"))
              for r in rep_.get("requests", []) if not r.get("blocking") and not r.get("failure")]
    # Measured against the design: a heavy difference can be the package's own way of drawing, which no builder can
    # change, so it never fails the check; the UI reviewer decides each one (design_table_problems).
    for d in rep_.get("design") or []:
        if d.get("level") == "MINOR":
            notes.append("design %s: light differences (%d)" % (d.get("code"), len(d.get("diffs") or [])))
        elif not d.get("level"):
            notes.append("design %s not compared: %s" % (d.get("code"), str(d.get("notComparable") or "")[:200]))
    rep_["design_bad"] = [d.get("code") for d in rep_.get("design") or [] if d.get("level") == "BAD"]
    rep_["blocking"], rep_["notes"] = blocking, notes
    return rep_


def ui_markdown(rep_, repo=None):
    """ui.md; repo: in a job of several repositories, the report goes under ## Repo: <the repository it opened>."""
    if rep_.get("skipped"):
        return "UI CHECK: SKIPPED\n\n%s%s\n" % ("## Repo: %s\n\n" % repo if repo else "", rep_["skipped"])
    md = ["UI CHECK: %s" % ("FAIL" if rep_["blocking"] else "PASS"), ""]
    body = []
    if rep_["blocking"]:
        body += ["## Blocking", ""] + ["- " + b for b in rep_["blocking"]] + [""]
    if rep_.get("notes"):
        body += ["## Notes", ""] + ["- " + n for n in rep_["notes"][:40]] + [""]
    body += ["## Steps", ""] + ["- %s %s" % ("PASS" if st["ok"] else "FAIL", st["name"]) for st in rep_.get("steps", [])]
    body += ["", "## Screenshots (open them to look)", ""] + ["- %s (%s): %s" % (sh["name"], sh["viewport"], sh["file"])
                                                             for sh in rep_.get("shots", [])]
    body += design_markdown(rep_)
    md += (["## Repo: %s" % repo, ""] + md_demote(body)) if repo else body
    return "\n".join(md) + "\n"


def design_markdown(rep_):
    design, di = rep_.get("design") or [], rep_.get("design_info") or {}
    if not design and not di.get("why"):
        return []
    cell = lambda v: str(v if v is not None else "").replace("|", "\\|").replace("\n", " ")[:200]
    md = ["", "## Design", "",
          "Each screen below was measured against the design package with the auto test's comparer: element by "
          "element, the design drawn with the data the web shows%s. A heavy difference (BAD) does not fail the gate: "
          "the UI reviewer decides each measured screen in the `## Design` table of its review (the code is wrong, the "
          "package draws it so, or the two images show different data)." % (
              (", at %sx%s" % tuple(di["viewport"])) if di.get("viewport") else "")]
    if not design:
        md += ["", "Nothing was measured: %s." % di["why"]]
    for d in design:
        name = d.get("name") or d.get("code")
        if not d.get("level"):
            md += ["", "### %s: not compared (%s)" % (name, d.get("notComparable") or "no reason given")]
            continue
        md += ["", "### %s: %s" % (name, d["level"])]
        rows = d.get("diffs") or []
        if rows:
            md += ["", "| Element | Kind | Design | Web | Level |", "|---|---|---|---|---|"]
            md += ["| %s | %s | %s | %s | %s |" % (cell(x.get("element")), cell(x.get("type")), cell(x.get("design")),
                                                    cell(x.get("actual")), cell(x.get("level"))) for x in rows[:40]]
        imgs = [(k, d.get(k)) for k in ("web", "design", "marked") if d.get(k)]
        if imgs:
            md += ["", "Images: " + " · ".join("%s %s" % kv for kv in imgs)]
        if d.get("left_out"):
            md += ["", "Not counted: " + "; ".join(cell(x) for x in d["left_out"][:10])]
    return md


def candidate_job(ctx, job, k):
    """Best-of-N candidate k as a job of its own: its clone of every repository the job changes, its own block of ports
    (candidate_block), its app state and logs in ui-cK/."""
    per = job_candidates(job).get(k)
    if not per:
        raise FxError("no candidate %s for %s" % (k, job["id"]))
    first = next(iter(per.values()))
    # candidate k's own block of ports, taken on this machine when it was made (one port per repository's app in it),
    # else its place in the job's block
    cj = dict(job, id="%s-c%d" % (job["id"], k), of=job["id"], port=first.get("port") or candidate_block(ctx, job, k),
              app_dir=os.path.join(ctx.job_dir(job["id"]), "ui-c%d" % k))
    cj["repos"] = {n: dict(e, **({"worktree": per[n]["worktree"], "branch": per[n]["branch"]} if n in per else {}))
                   for n, e in job["repos"].items()}
    for f in JOB_REPO_FIELDS:
        cj.pop(f, None)
    return job_show_flat(cj)


def cmd_ui(ctx, a):
    job = ctx.load(a.job)
    jd = ctx.job_dir(job["id"])
    uidir = os.path.join(jd, "ui-c%d" % a.candidate if a.candidate else "ui")
    if a.candidate:
        job = candidate_job(ctx, job, a.candidate)
    script = os.path.abspath(a.script or os.path.join(uidir, "check.js"))
    if not os.path.exists(script):
        raise FxError("no UI check script at %s" % script)
    out_dir = os.path.abspath(a.out or os.path.join(uidir, "last-run"))
    seed = os.path.join(uidir, "seed.sh")
    if a.seed and os.path.exists(seed):
        if not run_seed(ctx, job, seed, out_dir):
            out({"ok": True, "job": a.job, "pass": False, "skipped": None,
                 "blocking": ["ui seed.sh failed, see %s" % os.path.join(out_dir, "seed.log")], "notes": [],
                 "shots": [], "report": None})
            return
    rep_ = ui_run(ctx, job, script, out_dir)
    several = len(job_order(job)) > 1
    name = ui_repo(ctx, job)
    write_atomic(os.path.join(out_dir, "ui.md"), ui_markdown(rep_, name if several else None))
    res = {"ok": True, "job": job["id"], "pass": not rep_.get("blocking") and not rep_.get("skipped"),
           "skipped": rep_.get("skipped"), "blocking": rep_.get("blocking", []), "notes": rep_.get("notes", [])[:20],
           "shots": [sh["file"] for sh in rep_.get("shots", [])], "report": os.path.join(out_dir, "ui.md"),
           "design": design_summary(rep_)}
    if several:
        res["repo"] = name
    out(res)


def design_summary(rep_):
    """What a UI run measured against the design, for fx's answer: each screen's level and its heavy differences."""
    return [{"code": d.get("code"), "level": d.get("level"), "not_compared": d.get("notComparable"),
             "bad": ["%s: design %s, web %s" % (x.get("element"), x.get("design"), x.get("actual"))
                     for x in d.get("diffs") or [] if x.get("level") == "BAD"][:10],
             "images": {k: d[k] for k in ("web", "design", "marked") if d.get(k)}}
            for d in rep_.get("design") or []]


def run_seed(ctx, job, seed, out_dir):
    """ui/seed.sh: in the clone of the repository the UI checks open (ui_repo), with its app's environment."""
    ctx, job = one_app(ctx, job, ui_repo(ctx, job) if is_whole_job(job) else None)
    env, db = app_env(ctx, job)
    os.makedirs(out_dir, exist_ok=True)
    try:
        p = run(["bash", seed], cwd=job["worktree"], check=False, env=env, timeout=600, group=True)
        write_atomic(os.path.join(out_dir, "seed.log"), p.stdout or "")
        return p.returncode == 0
    except subprocess.TimeoutExpired:
        return False


