# tools the factory installs for itself (never in the project)

def tools_dir():
    return os.path.expanduser(os.environ.get("FACTORY_TOOLS_DIR") or "~/.cache/code-factory/tools")


def node_path():
    return os.pathsep.join(p for p in [os.path.join(tools_dir(), "node_modules"), os.environ.get("NODE_PATH", "")] if p)


def playwright_ok():
    if not shutil.which("node"):
        return False, "node not found"
    probe = ("const p=require('path');let pw=null;"
             "for(const d of (process.env.NODE_PATH||'').split(p.delimiter).filter(Boolean))"
             "{try{pw=require(p.join(d,'playwright'));break}catch(e){}}"
             "if(!pw){try{pw=require('playwright')}catch(e){process.exit(2)}}"
             "pw.chromium.launch().then(b=>b.close()).then(()=>process.exit(0),()=>process.exit(3))")
    try:
        r = run(["node", "-e", probe], check=False, env=dict(os.environ, NODE_PATH=node_path()), timeout=120)
    except subprocess.TimeoutExpired:
        return False, "Chromium for Playwright did not start within 120s"
    if r.returncode == 3:
        return False, "Chromium for Playwright is missing or cannot start (/code-factory:factory install)"
    if r.returncode != 0:
        return False, "playwright not installed for the factory"
    axe = os.path.exists(os.path.join(tools_dir(), "node_modules", "axe-core", "axe.min.js"))
    if not axe:
        r = run(["node", "-e", "require.resolve('axe-core/axe.min.js')"], check=False,
                env=dict(os.environ, NODE_PATH=node_path()))
        axe = r.returncode == 0
    return True, "ok" + ("" if axe else " (axe-core missing: accessibility scans skipped)")


# Versions fx installs when the machine has no global Playwright to match: pinned, so every factory gets the
# same tools (bump them here, with the VERSION). Homebrew installs its own current release.
PLAYWRIGHT_VERSION = "1.64.1"
AXE_CORE_VERSION = "4.10.3"
SEMGREP_VERSION = "1.100.0"
TOOL_INFO = {
    "playwright": "Playwright + Chromium + axe-core in %s (UI checks)",
    "gitleaks": "secret scanning", "osv-scanner": "known-vulnerable dependencies",
    "semgrep": "static analysis of changed code", "docker": "runs OWASP ZAP baseline scans",
}


def tool_status():
    st = {}
    ok, why = playwright_ok()
    st["playwright"] = {"ok": ok, "detail": why}
    for name in ("gitleaks", "osv-scanner", "semgrep", "docker"):
        st[name] = {"ok": bool(shutil.which(name)), "detail": shutil.which(name) or "not found"}
    return st


def global_playwright_version():
    """The version of a globally installed Playwright, whose browsers are usually already downloaded."""
    if not shutil.which("npm"):
        return None
    r = run(["npm", "root", "-g"], check=False, timeout=60)
    root = (r.stdout or "").strip().splitlines()[-1:] if r.returncode == 0 else []
    if not root:
        return None
    try:
        return json.loads(read(os.path.join(root[0], "playwright", "package.json"), "") or "{}").get("version")
    except ValueError:
        return None


def cmd_tools(ctx, a):
    if a.action == "status":
        out({"ok": True, "tools_dir": tools_dir(), "tools": tool_status()})
        return
    want = a.names or ["playwright", "gitleaks", "osv-scanner", "semgrep"]
    done, manual = {}, {}
    for name in want:
        if name == "docker":
            manual[name] = "; ".join(admin_commands("docker"))
            continue
        if name != "playwright" and shutil.which(name):
            done[name] = "already installed"
            continue
        ok, what = install_one(name)
        if ok:
            done[name] = what
        else:
            manual[name] = what + ("; " + "; ".join(admin_commands(name)) if admin_commands(name) else "")
    out({"ok": not manual, "installed": done, "manual": manual, "tools": tool_status()})


