def cmd_cleanup(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] not in TERMINAL and not a.force:
        raise FxError("job %s is still active (%s); pass --force to delete its clone" % (job["id"], job["stage"]))
    for per in job_candidates(job).values():
        for c in per.values():
            shutil.rmtree(c["worktree"], ignore_errors=True)
    r = drop_clone(ctx, job, force=a.force)
    if r.startswith("kept"):
        raise FxError("the clone of %s has work that is not on the remote (%s); push it, or pass --force to "
                      "delete it anyway" % (job["id"], r[6:]), code=3)
    ctx.save(job, "clone %s" % r)
    out({"ok": True, "job": job["id"], "clone": r})


def jira_doctor(ctx, add, issue=None):
    """fx doctor's Jira rows. Mode mcp: one row, as fx cannot see Claude's Atlassian connector. Mode token: jira.env there,
    complete and private, and reading the issue when one is given. Returns the mode."""
    setting, mode = jira_mode_setting(ctx), jira_mode(ctx)
    if setting not in ("mcp", "token"):
        if setting in JIRA_MODES:
            why = "jira.mode is %s, an older version's name for %s" % (setting, mode)
        elif setting in ("", "auto"):
            why = "jira.mode is not chosen, so fx uses %s for now (token only while jira.env holds both values)" % mode
        else:
            why = "jira.mode %r is neither mcp nor token, so fx uses %s for now" % (setting, mode)
        add("Jira mode chosen (advice)", True, why + ": choose mcp or token with /code-factory:factory init (local tasks need neither)")
    if mode == "mcp":
        left = JIRA_MODES.get(setting) == "mcp" and os.path.exists(jira_env_path(ctx))  # seen, never opened
        add("Jira access", True, "mode mcp: Claude's Atlassian connector does the Jira work, and fx cannot check it (the "
            "orchestrator does); attachments are not downloaded%s" % (
                ". fx does not use %s in this mode: delete it unless you go back to mode token" % jira_env_path(ctx)
                if left else ""))
    else:
        path = jira_env_path(ctx)
        try:
            jira_site(ctx)
            jira_keys(ctx)
            ok, detail = True, "mode token: fx calls %s with %s" % (str(ctx.c("jira.base_url")).strip(), path)
        except FxError as e:
            ok, detail = False, str(e)
        add("Jira access", ok, detail)
        if os.path.isfile(path):
            loose = os.stat(path).st_mode & 0o077
            add("jira.env file private", not loose, "chmod 600 %s" % shlex.quote(path) if loose else "")
        if issue and ok:
            try:
                b, k = parse_issue_ref(issue, ctx)
                d = Jira(ctx, b).issue(k)
                add("Jira read %s" % k, True, (d.get("fields") or {}).get("summary", ""))
            except FxError as e:
                add("Jira read", False, str(e))
    found = [n for n in JIRA_ENV_NAMES if n in os.environ]  # whether they are set, never their values
    if found:
        two = len(found) > 1
        add("Jira keys out of the environment (advice)", True, "%s %s set in this environment: code-factory does not read "
            "%s there (mode token reads jira.env), and any agent's shell can. Remove %s wherever %s set (a shell profile, "
            "Claude Code's settings)" % (" and ".join(found), "are" if two else "is", "them" if two else "it",
                                         "them" if two else "it", "they are" if two else "it is"))
    return mode


def guess_provider(url):
    return "github" if "github.com" in url else "gitlab" if "gitlab" in url else "bitbucket" if "bitbucket.org" in url \
        else "unknown"


def doctor_repos(ctx, add):
    """fx doctor's rows for each repository: the list itself, reachable, its base branch, its checks script, its pull
    request provider and that provider's login. Returns the first repository's (heads, base branch, provider) and the
    names of those whose base branch was found."""
    several = len(ctx.repos) > 1
    for why in ctx.repo_problems:
        add("repositories listed right in factory.json", False, why)
    if not ctx.repos:
        add("project reachable", False, "no repository: run /code-factory:factory init --repo <name>=<git URL>")
        return {}, ctx.c("base_branch", "main"), "unknown", []
    first, logins, found = None, {}, []
    for r in ctx.repos:
        n, url = r["name"], r.get("url") or ""
        what = "repository %s" % n if several else "project"
        base = ctx.rc(n, "base_branch", "main")
        try:
            heads, _ = remote_heads(url) if url else ({}, None)
            add("%s reachable" % what, bool(url), url or "no url: give it one in factory.json (repos)")
            add("%s base branch %s" % (what, base), base in heads, "" if base in heads else
                "missing: empty repository? /code-factory:factory init can make the first commit")
            if base in heads:
                found.append(n)
        except FxError as e:
            add("%s reachable" % what, False, str(e))
            heads = {}
        script = checks_script(ctx, repo=n)
        rel = os.path.relpath(script, ctx.factory)
        body = read(script)
        add("%s filled in" % rel, body and "FACTORY_TODO" not in body,
            "replace the FACTORY_TODO placeholder with your real checks" if "FACTORY_TODO" in (body or "") else
            "missing: write %s, the checks run in %s's clone" % (rel, n) if body is None and not ctx.old_form else "")
        prov = ctx.rc(n, "pr.provider") or guess_provider(url)
        cli = {"github": "gh", "gitlab": "glab"}.get(prov)
        login = None
        if cli:
