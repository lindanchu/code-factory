class FxError(Exception):
    """code 1 generic, 2 job exists, 3 setup/checks environment, 4 Jira, 6 agent result missing/invalid."""
    def __init__(self, msg, code=1, extra=None):
        super().__init__(msg)
        self.code = code
        self.extra = extra or {}


