def list_files(root):
    if os.path.isdir(os.path.join(root, ".git")) or git(["rev-parse", "--git-dir"], root, check=False).returncode == 0:
        r = git(["ls-files"], root, check=False)
        if r.returncode == 0 and r.stdout.strip():
            return [f for f in r.stdout.splitlines() if f]
    found = []
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
        for n in names:
            found.append(os.path.relpath(os.path.join(d, n), root))
        if len(found) > 50000:
            break
    return found


def is_source(f):
    base = os.path.basename(f)
    low = f.lower()
    if low.startswith((".claude/", ".github/", "docs/")) or base.upper().startswith(
            ("README", "LICENSE", "CHANGELOG", "CONTRIBUTING", "COPYING")) or base.startswith("."):
        return False
    return os.path.splitext(base)[1].lower() not in NON_SOURCE_EXT


def source_root(ctx, a):
    """What fx scan and style-sample read: a reference folder (--source), else a repository's read-only clone
    (work/_read-<repo>; --repo, which may be left out when the project has one)."""
    if getattr(a, "source", None):
        root = os.path.abspath(os.path.expanduser(a.source))
        if not os.path.isdir(root):
            raise FxError("reference %s not found; use fx reference <path-or-git-url> first" % a.source)
        return root
    name = code_repo(ctx, getattr(a, "repo_name", None))
    d = code_dir(ctx, name)
    if os.path.isdir(d):
        heads, _ = remote_heads(ctx.url(name))
        at = git(["rev-parse", "HEAD"], d, check=False).stdout.strip()
        if at and at == heads.get(ctx.rc(name, "base_branch", "main")):
            return d  # still the current base: reuse the clone this init is reading
    return code_open(ctx, name)


def scanned_repo(ctx, a):
    """The repository fx scan or style-sample read (None for a reference folder)."""
    return None if getattr(a, "source", None) else code_repo(ctx, getattr(a, "repo_name", None))


def cmd_scan(ctx, a):
    """A fast, language-neutral inventory of the repository (or of a reference) for /code-factory:factory init."""
    root = source_root(ctx, a)
    files = list_files(root)
    ext, top, manifests, tests, i18n, migrations, docker = {}, {}, [], set(), set(), set(), []
    for f in files:
        base = os.path.basename(f)
        e = os.path.splitext(base)[1].lower() or base
        ext[e] = ext.get(e, 0) + 1
        top_dir = f.split("/", 1)[0] if "/" in f else "(root)"
        top[top_dir] = top.get(top_dir, 0) + 1
        depth = f.count("/")
        if base in MANIFESTS and depth <= 2:
            manifests.append({"file": f, "ecosystem": MANIFESTS[base]})
        low = f.lower()
        parts = low.split("/")
        if any(p in ("test", "tests", "__tests__", "spec", "specs", "e2e", "integration_test", "androidTest")
               for p in parts[:-1]) or re.search(r"(^|[._-])(test|spec)s?[._-]|_test\.|\.test\.|\.spec\.|test\.php$",
                                                  base.lower()):
            tests.add("/".join(f.split("/")[:-1]) or "(root)")
        if any(p in ("lang", "locales", "locale", "i18n", "l10n", "translations") for p in parts[:-1]) \
                or e in (".po", ".arb", ".xliff", ".resx"):
            i18n.add("/".join(f.split("/")[:-1]) or "(root)")
        if any(p in ("migrations", "migrate", "db", "alembic", "flyway", "liquibase") for p in parts[:-1]):
            migrations.add("/".join(f.split("/")[:-1]))
        if base.startswith("Dockerfile") or base.startswith("docker-compose") or base.startswith("compose."):
            docker.append(f)
    present = lambda names: [n for n in names if os.path.exists(os.path.join(root, n))]
    log = git(["log", "-300", "--format=%s"], root, check=False).stdout.splitlines()
    prefixes = {}
    for msg in log:
        m = re.match(r"^([A-Z][A-Z0-9_]+-\d+|\w+(\([^)]*\))?!?:|\[[^\]]+\])", msg)
        key = re.sub(r"\d+", "N", m.group(1)) if m else "(free text)"
        prefixes[key] = prefixes.get(key, 0) + 1
    rc = git(["rev-list", "--count", "HEAD"], root, check=False)
    count = rc.stdout.strip() if rc.returncode == 0 else "0"
    first = git(["log", "--reverse", "--format=%as", "-1"], root, check=False).stdout.strip()
    authors = len(set(git(["log", "-500", "--format=%ae"], root, check=False).stdout.split()))
    url = git(["remote", "get-url", REMOTE], root, check=False).stdout.strip()
    top_ext = sorted(ext.items(), key=lambda x: -x[1])[:15]
    src = [f for f in files if is_source(f)]
    out({"ok": True, "repo": root, "repo_name": scanned_repo(ctx, a), "files": len(files), "source_files": len(src),
         "greenfield": len(src) < 3, "has_commits": count not in ("", "0"),
         "lint_configs": [f for f in files if os.path.basename(f) in LINT_CONFIGS][:30],
         "extensions": dict(top_ext), "top_dirs": dict(sorted(top.items(), key=lambda x: -x[1])[:20]),
         "manifests": manifests, "lockfiles": present(LOCKFILES), "docs": present(DOCS), "ci": present(CI),
         "docker": docker[:10], "test_dirs": sorted(tests)[:30], "i18n_dirs": sorted(i18n)[:20],
         "migration_dirs": sorted(migrations)[:10],
         "git": {"commits": count, "since": first, "authors_recent": authors, "remote": url,
                 "commit_styles": dict(sorted(prefixes.items(), key=lambda x: -x[1])[:6])},
         "next": "read the docs and manifests listed here, then the code they point to"})


def cmd_reference(ctx, a):
    """Make a reference (another repo, a starter template, a style guide folder) available locally."""
    ref = a.ref.strip()
    if os.path.exists(os.path.expanduser(ref)):
        path = os.path.abspath(os.path.expanduser(ref))
        out({"ok": True, "path": path, "kind": "dir" if os.path.isdir(path) else "file"})
        return
    if not re.match(r"^(https?://|git@|ssh://)", ref) and not re.match(r"^[\w.-]+/[\w.-]+$", ref):
        raise FxError("%s is neither a local path nor a git URL / owner/repo" % ref)
    url = ref if re.match(r"^(https?://|git@|ssh://)", ref) else "https://github.com/%s.git" % ref
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", re.sub(r"\.git$", "", url.rstrip("/")).split("/")[-1]) or "ref"
    dest = os.path.join(os.path.expanduser("~/.cache/code-factory/references"), name)
    if os.path.isdir(os.path.join(dest, ".git")):
        git(["pull", "--ff-only", "-q"], dest, check=False)
    else:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        r = run(["git", "clone", "--depth", "1", "-q", url, dest], check=False, timeout=900)
        if r.returncode != 0:
            raise FxError("could not clone %s: %s" % (url, (r.stdout or "")[-300:]))
    out({"ok": True, "path": dest, "kind": "dir", "url": url,
         "next": "fx scan --source %s ; fx style-sample --source %s" % (dest, dest)})


