def machine_dir():
    """~/.config/code-factory, or FACTORY_CONFIG_DIR. FACTORY_WORKSPACE, an older way to move it, names a file in it."""
    if os.environ.get("FACTORY_CONFIG_DIR"):
        return os.path.expanduser(os.environ["FACTORY_CONFIG_DIR"])
    if os.environ.get("FACTORY_WORKSPACE"):
        return os.path.dirname(os.path.expanduser(os.environ["FACTORY_WORKSPACE"]))
    return os.path.expanduser("~/.config/code-factory")


def csv_list(v):
    return [x.strip() for x in (v or "").split(",") if x.strip()]


