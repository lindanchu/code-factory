# UI checks with Playwright

def ui_run(ctx, job, script, out_dir):
    """Run a Playwright check script against the job's running apps: BASE_URL is the app of ui_repo, and the script runs
    in that repository's clone with every app's URL (FACTORY_URL_<NAME>). Returns the parsed report."""
    ok, why = playwright_ok()
    if not ok:
        return {"skipped": "Playwright is not available (%s): run /code-factory:factory install" % why}
    info = app_start(ctx, job)
    name = ui_repo(ctx, job) if is_whole_job(job) else job.get("repo")
    rctx, v = one_app(ctx, job, name)
    apps = info.get("apps") or {}
    base = (apps.get(v.get("repo")) or info)["url"]
    urls = {url_env_name(n): a_["url"].rstrip("/") for n, a_ in apps.items()}
    os.makedirs(out_dir, exist_ok=True)
    report_path = os.path.join(out_dir, "ui-report.json")
    if os.path.exists(report_path):
        os.remove(report_path)
    env = project_env(rctx, NODE_PATH=node_path(), BASE_URL=base.rstrip("/"), **dict(urls, **baselines_env(rctx, v["worktree"])),
                      FACTORY_UI=os.path.join(SKILL_DIR, "factory-ui.js"), FACTORY_UI_REPORT=report_path,
                      FACTORY_UI_SHOTS=os.path.join(out_dir, "shots"),
                      FACTORY_UI_VIEWPORTS=json.dumps(rctx.c("ui_checks.viewports", [[1280, 800], [390, 844]])),
                      FACTORY_UI_BLOCK_STATUS=str(rctx.c("ui_checks.block_on_status", 500)))
    try:
        p = run(["node", script], cwd=v["worktree"], check=False, env=env,
                timeout=int(rctx.c("e2e_timeout_sec", 1800)))
        log = p.stdout or ""
    except subprocess.TimeoutExpired:
        log, p = "ui check timed out", None
    write_atomic(os.path.join(out_dir, "ui.log"), log)
    try:
        rep_ = json.loads(read(report_path, "") or "")
    except ValueError:
        rep_ = {"error": "the check script wrote no report; see ui.log:\n" + "\n".join(log.splitlines()[-20:])}
    return ui_judge(rctx, rep_)


def ui_judge(ctx, rep_):
    block_a11y = set(ctx.c("ui_checks.a11y_block", ["critical", "serious"]) or [])
    if rep_.get("browser_missing"):
        return {"skipped": "Playwright could not launch Chromium: %s (/code-factory:factory install)"
                           % rep_["browser_missing"][:200]}
    # The browser also logs failed responses as console errors; those are judged by status below.
    rep_["console"] = [c for c in rep_.get("console", []) if not c.get("text", "").startswith(
        "Failed to load resource")]
    blocking = []
    if rep_.get("error"):
        blocking.append("the UI check script crashed: %s" % rep_["error"].splitlines()[0][:300])
    for st in rep_.get("steps", []):
        if not st.get("ok"):
            blocking.append("UI step failed: %s: %s" % (st.get("name"), (st.get("error") or "")[:300]))
    if ctx.c("ui_checks.block_on_console_errors", True):
        for c in rep_.get("console", [])[:10]:
            blocking.append("browser console error on %s: %s" % (c.get("url"), c.get("text", "")[:200]))
    for r in rep_.get("requests", []):
        if r.get("blocking") or r.get("failure"):
            blocking.append("request %s %s -> %s" % (r.get("method"), r.get("url"), r.get("status") or r.get("failure")))
    for v in rep_.get("a11y", []):
        if v.get("impact") in block_a11y:
            blocking.append("accessibility (%s) %s on %s: %s" % (v.get("impact"), v.get("id"), v.get("page"),
                                                                 v.get("help")))
    notes = ["accessibility (%s) %s on %s" % (v.get("impact"), v.get("id"), v.get("page"))
             for v in rep_.get("a11y", []) if v.get("impact") not in block_a11y]
    notes += ["request %s %s -> %s" % (r.get("method"), r.get("url"), r.get("status"))
              for r in rep_.get("requests", []) if not r.get("blocking") and not r.get("failure")]
    rep_["blocking"], rep_["notes"] = blocking, notes
    return rep_


def ui_markdown(rep_, repo=None):
    """ui.md; repo: in a job of several repositories, the report goes under ## Repo: <the repository it opened>."""
    if rep_.get("skipped"):
        return "UI CHECK: SKIPPED\n\n%s%s\n" % ("## Repo: %s\n\n" % repo if repo else "", rep_["skipped"])
    md = ["UI CHECK: %s" % ("FAIL" if rep_["blocking"] else "PASS"), ""]
    body = []
    if rep_["blocking"]:
        body += ["## Blocking", ""] + ["- " + b for b in rep_["blocking"]] + [""]
    if rep_.get("notes"):
        body += ["## Notes", ""] + ["- " + n for n in rep_["notes"][:40]] + [""]
    body += ["## Steps", ""] + ["- %s %s" % ("PASS" if st["ok"] else "FAIL", st["name"]) for st in rep_.get("steps", [])]
    body += ["", "## Screenshots (open them to look)", ""] + ["- %s (%s): %s" % (sh["name"], sh["viewport"], sh["file"])
                                                             for sh in rep_.get("shots", [])]
    md += (["## Repo: %s" % repo, ""] + md_demote(body)) if repo else body
    return "\n".join(md) + "\n"


def candidate_job(ctx, job, k):
    """Best-of-N candidate k as a job of its own: its clone of every repository the job changes, its own block of ports
    (candidate_block), its app state and logs in ui-cK/."""
    per = job_candidates(job).get(k)
    if not per:
        raise FxError("no candidate %s for %s" % (k, job["id"]))
    cj = dict(job, id="%s-c%d" % (job["id"], k), port=candidate_block(ctx, job, k),
              app_dir=os.path.join(ctx.job_dir(job["id"]), "ui-c%d" % k))
    cj["repos"] = {n: dict(e, **({"worktree": per[n]["worktree"], "branch": per[n]["branch"]} if n in per else {}))
                   for n, e in job["repos"].items()}
    for f in JOB_REPO_FIELDS:
        cj.pop(f, None)
    return job_show_flat(cj)


def cmd_ui(ctx, a):
    job = ctx.load(a.job)
    jd = ctx.job_dir(job["id"])
    uidir = os.path.join(jd, "ui-c%d" % a.candidate if a.candidate else "ui")
    if a.candidate:
        job = candidate_job(ctx, job, a.candidate)
    script = os.path.abspath(a.script or os.path.join(uidir, "check.js"))
    if not os.path.exists(script):
        raise FxError("no UI check script at %s" % script)
    out_dir = os.path.abspath(a.out or os.path.join(uidir, "last-run"))
    seed = os.path.join(uidir, "seed.sh")
    if a.seed and os.path.exists(seed):
        if not run_seed(ctx, job, seed, out_dir):
            out({"ok": True, "job": a.job, "pass": False, "skipped": None,
                 "blocking": ["ui seed.sh failed, see %s" % os.path.join(out_dir, "seed.log")], "notes": [],
                 "shots": [], "report": None})
            return
    rep_ = ui_run(ctx, job, script, out_dir)
    several = len(job_order(job)) > 1
    name = ui_repo(ctx, job)
    write_atomic(os.path.join(out_dir, "ui.md"), ui_markdown(rep_, name if several else None))
    res = {"ok": True, "job": job["id"], "pass": not rep_.get("blocking") and not rep_.get("skipped"),
           "skipped": rep_.get("skipped"), "blocking": rep_.get("blocking", []), "notes": rep_.get("notes", [])[:20],
           "shots": [sh["file"] for sh in rep_.get("shots", [])], "report": os.path.join(out_dir, "ui.md")}
    if several:
        res["repo"] = name
    out(res)


def run_seed(ctx, job, seed, out_dir):
    """ui/seed.sh: in the clone of the repository the UI checks open (ui_repo), with its app's environment."""
    ctx, job = one_app(ctx, job, ui_repo(ctx, job) if is_whole_job(job) else None)
    env, db = app_env(ctx, job)
    os.makedirs(out_dir, exist_ok=True)
    try:
        p = run(["bash", seed], cwd=job["worktree"], check=False, env=env, timeout=600)
        write_atomic(os.path.join(out_dir, "seed.log"), p.stdout or "")
        return p.returncode == 0
    except subprocess.TimeoutExpired:
        return False


