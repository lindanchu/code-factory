    if logic_ready(ctx) and agent in ("intake", "spec", "builder", "code", "ux", "ui", "approver", "judge"):
        lines.append("Project logic (the source of truth for business rules; read the index, then the files of the "
                     "features this job touches): %s" % os.path.join(logic_dir(ctx), "README.md"))
    if logic_ready(ctx) and agent == "spec":
        lines.append("Logic conflicts (the issue says something else than logic/): list them in %s; they are posted "
                     "on the issue and asked before coding" % os.path.join(jd, "logic-conflicts.md"))
    lp = lessons_for(ctx, agent, job) if agent != "intake" else None
    if lp:
