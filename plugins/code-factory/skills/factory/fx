# best-of-N: several builders, one judge

def job_candidates(job):
    """The best-of-N candidates by number: {k: {repo: its candidate entry}}. Candidate k has a clone of every repository
    the job changes."""
    found = {}
    for n in job_names(job, "change"):
        for c in job["repos"][n].get("candidates") or []:
            found.setdefault(c["k"], {})[n] = c
    return dict(sorted(found.items()))


def cmd_candidates(ctx, a):
    job = ctx.load(a.job)
    n = int(job.get("best_of") or 0)
    if n < 2:
        raise FxError("job %s was not created with --best-of N" % job["id"])
    if job["stage"] != "build" or job.get("best_of_done") or job["round"] != job.get("round_start", 0):
        raise FxError("best-of-N only runs for the first build of a job")
    names = job_names(job, "change")
    for name in names:
        e = job["repos"][name]
        cands = e.get("candidates") or []
        for k in range(1, n + 1):
            if any(c["k"] == k for c in cands):
                continue
            wt = "%s-c%d" % (e["worktree"], k)
            br = "%s-c%d" % (e["branch"], k)
            job_clone(ctx, wt, br, start=e["base_ref"], repo=name)
            cands.append({"k": k, "worktree": wt, "branch": br, "setup": False,
                          "port": candidate_block(ctx, job, k) + job_order(job).index(name)})
        e["candidates"] = cands
    for name in names:
        cmd = ctx.rc(name, "setup", "")
        for c in job["repos"][name]["candidates"]:
            if cmd and not c.get("setup"):
                log = os.path.join(ctx.job_dir(job["id"]), "setup-c%d%s.log" % (
                    c["k"], "-%s" % name if len(names) > 1 else ""))
                where = "candidate %d%s" % (c["k"], " (%s)" % name if len(names) > 1 else "")
                try:
                    p = run(["bash", "-lc", cmd], cwd=c["worktree"], check=False, env=project_env(ctx),
                            timeout=int(ctx.rc(name, "setup_timeout_sec", 1800) or 1800))
                except subprocess.TimeoutExpired:
                    ctx.save(job, "setup timed out in %s" % where)
                    raise FxError("setup timed out in %s; see %s" % (where, log), code=3)
                write_atomic(log, p.stdout or "")
                if p.returncode != 0:
                    ctx.save(job, "setup failed in %s" % where)
                    raise FxError("setup failed in %s; see %s" % (where, log), code=3)
            c["setup"] = True
    ks = list(job_candidates(job))
    ctx.save(job, "%d candidate worktrees ready" % len(ks))
    out({"ok": True, "job": job["id"], "candidates": ks, "model": builder_model(ctx, job),
         "next": "spawn one builder per candidate (fx ctx --agent builder --candidate K), in parallel"})


def cmd_judge_prep(ctx, a):
    job = ctx.load(a.job)
    cands = job_candidates(job)
    if not cands:
        raise FxError("no candidates for %s" % job["id"])
    jd = ctx.job_dir(job["id"])
    several = len(job_names(job, "change")) > 1
    rows, passing = [], []
    for k, per in cands.items():
        status = first_line(os.path.join(jd, "build-c%d.md" % k)) or "(no report)"
        gate, reason, stats, sees, logs = "FAIL", "", [], [], []
        if not status.startswith("STATUS: READY"):
            reason = "builder did not report READY"
        ahead_any = False
        for name, c in per.items():
            base_ref = job["repos"][name]["base_ref"]
            ahead = git(["rev-list", "--count", "%s..HEAD" % base_ref], c["worktree"]).stdout.strip()
            ahead_any = ahead_any or ahead != "0"
            stat = git(["diff", "--shortstat", "%s...HEAD" % base_ref], c["worktree"]).stdout.strip()
            stats.append(("%s: %s" % (name, stat or "-")) if several else stat)
            sees.append("`cd %s && git diff %s...HEAD`" % (c["worktree"], base_ref))
            tracked, untracked = worktree_dirt(ctx, c["worktree"], name)
            if not reason and (tracked or untracked):
                reason = "uncommitted files" + (" in %s" % name if several else "")
        if not reason and not ahead_any:
            reason = "no commits"
        if not reason:
            if baselines_candidate_problem(ctx, job, per):
                reason = "the baselines could not be fetched (checks-c%d.log)" % k
        if not reason:
            gate = "PASS"
            for name, c in per.items():
                log = "checks-c%d%s.log" % (k, "-%s" % name if several else "")
                script = checks_script(ctx, job, repo=name)
                try:
                    p = run(["bash", script], cwd=c["worktree"], check=False,
                            timeout=int(ctx.rc(name, "gate_timeout_sec", 1800) or 1800),
                            env=project_env(ctx, FACTORY_JOB=job["id"], FACTORY_PORT=str(c["port"]),
                                            **baselines_env(ctx, c["worktree"], name)))
                    write_atomic(os.path.join(jd, log), p.stdout or "")
                    if p.returncode != 0:
                        gate, reason = "FAIL", "%s exited %d (%s)" % (os.path.basename(script), p.returncode, log)
                        break
                except subprocess.TimeoutExpired:
                    gate, reason = "FAIL", "%s timed out" % os.path.basename(script)
                    break
        if gate == "PASS":
            passing.append(k)
        rows.append("| c%d | %s | %s | %s | %s | %s |" % (
            k, gate, status.replace("STATUS: ", ""), "; ".join(x for x in stats if x) or "-", reason or "-",
            " ".join(sees)))
    md = ["# Candidates for %s" % job["id"], "",
          "| Candidate | Checks | Builder | Diff | Problem | See the change |", "|---|---|---|---|---|---|"] + rows
    write_atomic(os.path.join(jd, "candidates.md"), "\n".join(md) + "\n")
    res = {"ok": True, "job": job["id"], "passing": passing, "report": os.path.join(jd, "candidates.md")}
    if len(passing) == 1:
        res.update(next="pick", pick=passing[0], note="only one candidate passed the checks")
    elif len(passing) >= 2:
        res["next"] = "judge"
    else:
        res.update(next="judge", note="no candidate passed the checks; the judge picks the best starting point")
    ctx.save(job, "candidates checked: %s pass" % (passing or "none"))
    out(res)


def cmd_pick(ctx, a):
    job = ctx.load(a.job)
    cands = job_candidates(job)
    if not cands:
        raise FxError("no candidates for %s" % job["id"])
    jd = ctx.job_dir(job["id"])
    k = a.k
    if not k:
        line = first_line(os.path.join(jd, "pick.md"))
        m = re.match(r"^PICK:\s*c?(\d+)\s*$", line or "", re.I)
        if not m:
            raise FxError("pick.md is missing or its first line is not 'PICK: cN'", code=6,
                          extra={"retry_agent": "judge"})
        k = int(m.group(1))
    if k not in cands:
        raise FxError("no candidate c%s" % k)
    notes = []
    for name, chosen in cands[k].items():
        wt = job["repos"][name]["worktree"]
        tracked, untracked = worktree_dirt(ctx, chosen["worktree"], name)
        if tracked or untracked:  # the judge may pick a candidate that left work uncommitted: keep it
            left = stage_work(ctx, chosen["worktree"], untracked, name)
            if left:
                notes.append("local files not committed (copy_into_worktree, .env*), gone with the candidate's clone: %s"
                             % ", ".join(sorted(set(left))[:10]))
            if git(["diff", "--cached", "--quiet"], chosen["worktree"], check=False).returncode != 0:
                git_job(["commit", "-q", "--no-verify", "-m", "%s: candidate %d work (uncommitted by its builder)"
                     % (job["issue_key"], k)], chosen["worktree"])
        git(["fetch", "-q", chosen["worktree"], "HEAD"], wt)
        git(["reset", "-q", "--hard", "FETCH_HEAD"], wt)
        baselines_take_images(ctx, chosen["worktree"], wt, name)
    rep_src = os.path.join(jd, "build-c%d.md" % k)
    if os.path.exists(rep_src):
        shutil.copy2(rep_src, os.path.join(jd, "build.md"))
    for c in cands:
        try:
            app_stop(ctx, candidate_job(ctx, job, c))
        except FxError:
            pass
    for per in cands.values():
        for c in per.values():
            shutil.rmtree(c["worktree"], ignore_errors=True)  # candidate clones: the winner now lives in the job's
    # The winner's UI check becomes the job's; the others go.
    win_ui = os.path.join(jd, "ui-c%d" % k)
    if os.path.exists(os.path.join(win_ui, "check.js")):
        shutil.rmtree(os.path.join(jd, "ui"), ignore_errors=True)
        for name in os.listdir(win_ui):
            if re.match(r"^app(-[a-z][a-z0-9-]*)?\.(json|log)$", name):  # app-<repo>.json in a job of several
                os.remove(os.path.join(win_ui, name))
        os.replace(win_ui, os.path.join(jd, "ui"))
    for c in cands:
        shutil.rmtree(os.path.join(jd, "ui-c%d" % c), ignore_errors=True)
    job["best_of_done"] = True
    job["picked"] = k
    for name in job_names(job, "change"):
        job["repos"][name]["candidates"] = []
    ctx.save(job, "picked candidate c%d" % k)
    out({"ok": True, "job": job["id"], "picked": k, "notes": notes, "next": "result build"})


