def now():
    return _dt.datetime.now(_dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def out(obj):
    # A file name that is not UTF-8 reached fx as surrogates (see run), and stdout would not take them.
    print(json.dumps(obj, ensure_ascii=False, indent=2).encode("utf-8", "backslashreplace").decode("utf-8"))


def hint(msg):
    print(msg, file=sys.stderr)


def run(cmd, cwd=None, check=True, capture=True, env=None, timeout=None, input_text=None):
    p = subprocess.run(
        cmd, cwd=cwd, env=env, timeout=timeout, input=input_text,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
        text=True, errors="surrogateescape",  # git prints names and diffs in whatever bytes they have
    )
    if check and p.returncode != 0:
        raise FxError("command failed (%d): %s\n%s" % (
            p.returncode, " ".join(cmd), (p.stdout or "").strip()[-2000:]))
    return p


def run_sep(cmd, cwd=None, env=None, timeout=None):
    """Like run(check=False) but keeps stdout and stderr apart (for tools that print JSON on stdout)."""
    return subprocess.run(cmd, cwd=cwd, env=env, timeout=timeout, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, text=True, errors="surrogateescape")


def first_json(text):
    i = (text or "").find("{")
    while i >= 0:
        try:
            return json.JSONDecoder().raw_decode(text[i:])[0]
        except ValueError:
            i = text.find("{", i + 1)
    return None


NO_HOOKS = ["-c", "core.hooksPath=/dev/null"]


def git_job(args, cwd, check=True):
    """git in a job's clone without its hooks: an agent writes that clone, .git/hooks and its config included, and fx's
    own merges, commits and pushes run nothing of theirs."""
    return git(NO_HOOKS + list(args), cwd, check)


def git_url(ctx, repo):
    """A repository's URL from factory.json as git takes it (a local folder expanded): what fx fetches from and pushes
    to, never a clone's own origin, which the agents could point anywhere."""
    u = ctx.url(repo)
    return os.path.expanduser(u) if os.path.isdir(os.path.expanduser(u)) else u


def git(args, cwd, check=True):
    return run(["git"] + args, cwd=cwd, check=check)


def write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8", errors="backslashreplace") as f:
        f.write(text)
    os.replace(tmp, path)


def read(path, default=None):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read()
    except FileNotFoundError:
        return default


def first_line(path):
    text = read(path)
    if text is None:
        return None
    for line in text.splitlines():
        if line.strip():
            return line.strip()
    return ""


def slugify(text, maxlen=40):
    t = unicodedata.normalize("NFKD", text or "")
    t = t.replace("đ", "d").replace("Đ", "D")
    t = "".join(c for c in t if not unicodedata.combining(c))
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    t = t[:maxlen].rstrip("-")
    return t or "task"


def match_any(path, patterns):
    return any(fnmatch.fnmatch(path, p) for p in patterns)


