    job["resume_stage"] = from_stage
    ctx.move(job, "needs-info", "questions from %s" % from_stage)


def cmd_result(ctx, a):
    job = ctx.load(a.job)
    step = a.step
    given = summary_arg(ctx, a)  # for the comment of intake's REJECT or of the spec's logic conflicts
    notes = []
    fname, rx = FIRST_LINE[step]
    path = os.path.join(ctx.job_dir(job["id"]), fname)
    role = {"intake": "intake", "spec": "spec", "build": "builder", "decision": "approver"}[step]
    line = first_line(path)
    if line is None:
        raise FxError("%s does not exist; the %s agent did not write it (or has not finished)" % (fname, role),
                      code=6, extra={"retry_agent": role})
    m = rx.match(line)
    if not m:
        raise FxError("first line of %s is %r, which is not a valid %s result" % (fname, line, step),
                      code=6, extra={"retry_agent": role})
    verdict = m.group(1)
    res = {"job": job["id"], "step": step, "result": verdict}

    if step == "intake":
        if job["stage"] != "intake":
            raise FxError("job is in stage %s, not intake" % job["stage"])
        text = read(path)
        wanted = intake_repos(ctx, job, text, verdict)
        risk, surfaces = parse_intake_meta(text)
        job["risk"] = risk or "high"
        job["surfaces"] = surfaces
        route(ctx, job)
        res.update(risk=job["risk"], surfaces=surfaces, models=job["models"], reviewers=job["reviewers"])
        if verdict == "ACCEPT":
            todo = [n for n in wanted if n not in job_names(job, "change")]
            if todo:
                proposed = job.get("repos_bases") or {}
                job["repos_pending"] = todo
                ctx.move(job, "spec", "intake ACCEPT, risk %s; repositories to clone: %s" % (job["risk"], ", ".join(todo)))
                res["repos"] = [{"name": n, "proposed_base": proposed.get(n) or proposed.get("*") or
                                 ctx.rc(n, "base_branch", "main")} for n in todo]
                res["next"] = "branches"
                res["then"] = ("%s branches --job %s gives each repository's branches; ask the user each one's base "
                               "branch (one AskUserQuestion, a question per repository), then %s repos %s %s" % (
                                   FX_CMD, job["id"], FX_CMD, job["id"],
                                   " ".join("--base %s=<branch>" % n for n in todo)))
            else:
                ctx.move(job, "spec", "intake ACCEPT, risk %s" % job["risk"])
                res["next"] = "spec"
        elif verdict == "NEEDS-INFO":
            set_needs_info(ctx, job, "intake")
            res["next"] = "ask"
        else:
            reason = section(text, "Reason") or "See the factory job files."
            body = ("**Software factory did not take %s.**\n\n%s\n\nThe run stopped; nothing was "
                    "changed in the code." % (job["issue_key"], reason))
            # The comment goes before the move, which saves it with the job: a run stopped in between runs again.
            res["jira"] = comment_for_people(ctx, job, summary_to_use(ctx, job, "intake", given, notes), body, notes)
            summary_done(job, "intake")
            ctx.move(job, "rejected", "intake %s" % verdict)
            res["clone"] = drop_clone(ctx, job)
            res["next"] = "reject"
    elif step == "spec":
        if job["stage"] != "spec":
            raise FxError("job is in stage %s, not spec" % job["stage"])
        conflicts = (read(os.path.join(ctx.job_dir(job["id"]), "logic-conflicts.md"), "") or "").strip()
        if conflicts and job.get("logic_conflicts_posted") != conflicts[:200]:
            res["logic_conflicts"] = comment_for_people(ctx, job, summary_to_use(ctx, job, "spec", given, notes), (
                "**Software factory: this issue differs from the documented logic** (factory repository, "
                "`logic/`). The team is asked before any code is written.\n\n%s" % conflicts), notes)
            summary_done(job, "spec")
            job["logic_conflicts_posted"] = conflicts[:200]
        if verdict == "READY":
            job["build_reason"] = "first"
            ctx.move(job, "build", "spec READY")
            spec = read(path)
            r1 = jira_move(ctx, job, "start")
            body = "**Software factory started %s** (branch `%s`).\n\n## Goal\n\n%s\n\n" \
                   "## Acceptance criteria\n\n%s" % (job["issue_key"], job["branch"],
                                                     section(spec, "Goal") or "-",
                                                     section(spec, "Acceptance criteria") or "-")
            res["jira"] = {"transition": r1, "comment": jira_comment(ctx, job, body)}
            job["jira_started"] = "error" not in r1
            res["next"] = "build"
        else:
            set_needs_info(ctx, job, "spec")
            res["next"] = "ask"
    elif step == "build":
        if job["stage"] != "build":
            raise FxError("job is in stage %s, not build" % job["stage"])
        if verdict == "READY":
            listed = section(read(path), "Read before changing")
            if not re.search(r"[\w-]+/[\w./-]+|[\w-]+\.[A-Za-z]{1,6}\b", listed or ""):
                raise FxError("build.md has no '## Read before changing' list (the files read before editing: each "
                              "changed file, files of the same role, its tests and its callers)", code=6,
                              extra={"retry_agent": "builder"})
            res["next"] = "gate"
        elif verdict == "NEEDS-INFO":
            set_needs_info(ctx, job, "build")
            res["next"] = "ask"
        else:
            job["needs_human"] = True
            job["incomplete"] = True
            job["handoff_reason"] = "builder BLOCKED (see build.md)"
            ctx.move(job, "pr", "builder BLOCKED")
            res["next"] = "pr"
    elif step == "decision":
        if job["stage"] != "approve":
            raise FxError("job is in stage %s, not approve" % job["stage"])
        job["decision"] = verdict
        if verdict == "ESCALATE":
            job["needs_human"] = True
            job["handoff_reason"] = "approver ESCALATE (see decision.md)"
        elif job.get("flags"):
            # Deterministic backstop: sensitive paths always need a human, whatever the approver said.
            job["needs_human"] = True
            job["handoff_reason"] = "sensitive paths changed: %s" % ", ".join(job["flags"][:8])
            res["note"] = "APPROVE overridden to needs-human because sensitive paths changed"
        elif job.get("security_missed"):
            # A scanner that should have run did not: nobody may read that as a clean result.
            job["needs_human"] = True
            job["handoff_reason"] = "security scanners skipped: %s" % ", ".join(job["security_missed"])
            res["note"] = ("APPROVE overridden to needs-human because security scanners did not run: %s"
                           % ", ".join(job["security_missed"]))
        ctx.move(job, "pr", "approver %s" % verdict)
        res["next"] = "pr"
    if notes:
        res["notes"] = notes
    finish(ctx, res, job)


