                         "changes there, and a `## Shared contract` with everything they must agree on (routes, "
                         "payloads, events, types, versions, the order they deploy in); name the repository of each "
                         "acceptance criterion" % ", ".join(changed))
        elif agent == "builder":
            lines.append("Shared contract between the repositories: `## Shared contract` in %s. Keep every repository "
                         "to it; when the build must add to it or change it, update that section and say so in your "
                         "report" % spec_md)
        elif agent in ("planner", "judge", "approver") or agent in REVIEW_ROLES:
            lines.append("Spec: %s, with a `## Repo: <name>` part for each repository and the `## Shared contract` "
                         "between them" % spec_md)
    kf = knowledge_files(ctx, agent, None if agent in ("intake", "spec") or job.get("repos_pending")
                         else job_order(job))
    if kf:
