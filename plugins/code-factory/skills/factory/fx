def baselines_root(ctx, cfg, a=None, job=None):
    """The checkout that holds the list and the folder: the factory repository, or a clone of the project."""
    if cfg["repo"] == "factory":
        return ctx.factory
    clone = getattr(a, "clone", None) if a else None
    if clone:
        clone = os.path.abspath(os.path.expanduser(clone))
        if os.path.dirname(clone) != ctx.work or not os.path.isdir(os.path.join(clone, ".git")):
            raise FxError("--clone must name a project clone in %s" % ctx.work, code=3)
        return clone
    ref = job or (ctx.load(a.job) if a and getattr(a, "job", None) else None)
    if not ref:
        raise FxError("baselines.repo is project and the project has no permanent checkout here: name a job (--job) "
                      "or a clone (--clone)", code=3)
    whole = ref
    ref = baselines_job(ctx, cfg, ref)
    if ref is None:
        raise FxError("the baselines list is in %s, which job %s does not change" % (cfg["repo_name"], whole["id"]),
                      code=3)
    if not os.path.isdir(ref["worktree"] or ""):
        raise FxError("the job's clone %s is missing" % ref["worktree"], code=3)
    return ref["worktree"]


def baselines_folder(cfg, root):
    """The folder, refusing one that a symlink takes out of the checkout."""
    path = os.path.join(root, cfg["dir"])
    real, top = os.path.realpath(path), os.path.realpath(root)
    if not real.startswith(top + os.sep):
        raise FxError("baselines.dir %s leads out of %s through a symlink" % (cfg["dir"], root), code=3)
    return path


def baselines_target(folder, rel):
    """The local path of a list entry; refuses a path through a symlink, and a symlink that leads out of the folder."""
    why = baselines_safe_rel(rel)
    if why:
        raise FxError("the baselines list has an unsafe path %r (%s); nothing was written" % (rel, why), code=3)
    top = os.path.realpath(folder)
    cur, parts = folder, rel.split("/")
    for i, part in enumerate(parts):
        cur = os.path.join(cur, part)
        inside = (os.path.realpath(cur) + os.sep).startswith(top + os.sep)
        if os.path.islink(cur) and (i < len(parts) - 1 or not inside):
            raise FxError("the baselines list has a path %r that goes through a symlink; nothing was written" % rel,
                          code=3)
    return cur


def baselines_parse(text, source):
    """Entries of a list ({path: {sha256, size}}), refusing anything that could write outside the folder."""
    try:
        data = json.loads(text)
    except ValueError as e:
        raise FxError("%s is not valid JSON: %s" % (source, e), code=3)
    files = data.get("files") if isinstance(data, dict) else None
    if not isinstance(files, list) or data.get("version") != 1:
        raise FxError("%s is not a baselines list (version 1, files)" % source, code=3)
    out_ = {}
    for f in files:
        if not isinstance(f, dict):
            raise FxError("%s has an entry that is not an object" % source, code=3)
        path, sha, size = f.get("path"), f.get("sha256"), f.get("size")
        why = baselines_safe_rel(path)
        if why:
            raise FxError("%s has an unsafe path %r (%s); nothing was written" % (source, path, why), code=3)
        if not isinstance(sha, str) or not BASELINE_HASH_RE.match(sha):
            raise FxError("%s: %s has no valid sha256" % (source, path), code=3)
        if not isinstance(size, int) or isinstance(size, bool) or size < 0:
            raise FxError("%s: %s has no valid size" % (source, path), code=3)
        if path in out_:
            raise FxError("%s lists %s twice" % (source, path), code=3)
        out_[path] = {"sha256": sha, "size": size}
    return out_


def baselines_text(entries):
    """The list as written to git: sorted by path, one entry per line, so a diff names exactly the images changed."""
    rows = [json.dumps({"path": p, "sha256": entries[p]["sha256"], "size": entries[p]["size"]}, ensure_ascii=False)
            for p in sorted(entries)]
    return '{\n "version": 1,\n "files": [' + ("\n  " + ",\n  ".join(rows) + "\n " if rows else "") + "]\n}\n"


def baselines_read(cfg, root):
    """The working tree's list; None when there is none yet."""
    path = os.path.join(root, cfg["manifest"])
    text = read(path)
    return None if text is None else baselines_parse(text, cfg["manifest"])


def baselines_at(cfg, root, ref):
    """The list at a commit; None when the commit has none or it is not readable (only a report depends on it)."""
    if str(ref).startswith("-"):
        raise FxError("%r is not a commit: git would read it as an option" % ref, code=3)
    p = git(["show", "%s:%s" % (ref, cfg["manifest"])], root, check=False)
    if p.returncode != 0:
        return None
    try:
        return baselines_parse(p.stdout, "%s at %s" % (cfg["manifest"], ref))
    except FxError:
        return None


def file_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def baselines_nfc_names(dirpath, names):
    """The list holds names in NFC, and macOS tools may write another form. With the lock held the name on disk follows,
    so everything else can open a file by its name on the list."""
    for i, n in enumerate(names):
        nfc = unicodedata.normalize("NFC", n)
        if nfc == n:
            continue
        old, new = os.path.join(dirpath, n), os.path.join(dirpath, nfc)
        if not os.path.lexists(new):
            os.rename(old, new)
            names[i] = nfc
            continue
        try:
            same = os.path.samefile(old, new)  # a filesystem that does not tell the forms apart
        except OSError:
            same = False
        if not same:
            raise FxError("%s holds two names that differ only in their Unicode form: %r. Keep one" % (dirpath, nfc), code=3)


def baselines_scan(folder, tidy=False, real=None, prune=None):
    """(files, symlinks) in the folder, as paths relative to it, in NFC. With the folder lock held (tidy), leftovers of a
    killed fx are removed and names on disk become NFC; without it they may be another fx's work in progress. real: filled
    with each name's form on disk. prune: says of a folder's relative path that nothing in it counts."""
    files, links = [], []
    for dirpath, dirnames, names in os.walk(folder):
        if tidy:
            baselines_nfc_names(dirpath, dirnames)
            baselines_nfc_names(dirpath, names)
        for d in list(dirnames):
            if os.path.islink(os.path.join(dirpath, d)):
                dirnames.remove(d)
                links.append(os.path.relpath(os.path.join(dirpath, d), folder).replace(os.sep, "/"))
            elif prune and prune(os.path.relpath(os.path.join(dirpath, d), folder).replace(os.sep, "/")):
                dirnames.remove(d)
        for n in names:
            full = os.path.join(dirpath, n)
            rel = os.path.relpath(full, folder).replace(os.sep, "/")
            if n.startswith(BASELINE_TMP):
                if tidy:
                    os.remove(full)
            elif os.path.islink(full):
                links.append(rel)
            elif n not in BASELINE_JUNK:
                files.append(unicodedata.normalize("NFC", rel))
                if real is not None:
                    real[files[-1]] = rel
    return sorted(files), sorted(links)


@contextlib.contextmanager
def baselines_folder_lock(folder):
    """One fx at a time writes into a folder; parallel sessions wait for each other."""
    name = hashlib.sha256(os.path.realpath(folder).encode()).hexdigest()[:24]
    lock_dir = os.path.join(state_dir(), "baselines", "locks")
    os.makedirs(lock_dir, exist_ok=True)
    with open(os.path.join(lock_dir, name + ".lock"), "w") as f:
        if not flock_wait(f, "exclusive", BASELINE_LOCK_WAIT_SEC):
            raise FxError("another fx kept the baselines folder busy for %ds; try again" % BASELINE_LOCK_WAIT_SEC, code=3)
        yield


def flock_wait(f, kind, timeout):
    if fcntl is None:
        return True  # no flock on this system; fx and checks.sh need a Unix shell anyway
    mode = fcntl.LOCK_EX if kind == "exclusive" else fcntl.LOCK_SH
    end = time.time() + timeout
    while True:
        try:
            fcntl.flock(f, mode | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.time() >= end:
                return False
            time.sleep(0.05)


# --- the store

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kw):
        return None  # a signed request never follows a redirect to another host


def s3_signature(secret, region, amz_date, method, uri, query, headers, payload_hash):
    """AWS Signature Version 4: (signed header names, credential scope, signature)."""
    low = {k.lower(): str(v).strip() for k, v in headers.items()}
    names = sorted(low)
    signed = ";".join(names)
    canonical = "\n".join([method, uri, query, "".join("%s:%s\n" % (n, low[n]) for n in names), signed, payload_hash])
    scope = "%s/%s/s3/aws4_request" % (amz_date[:8], region)
    to_sign = "\n".join(["AWS4-HMAC-SHA256", amz_date, scope, hashlib.sha256(canonical.encode()).hexdigest()])
    key = ("AWS4" + secret).encode()
    for part in (amz_date[:8], region, "s3", "aws4_request"):
        key = hmac.new(key, part.encode(), hashlib.sha256).digest()
    return signed, scope, hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()


class S3Store:
    """HEAD, GET and PUT of one object by hash or by name, and a listing, signed with the key given here. The key stays
    in this process: it is never put in the environment, so no command fx runs can see it."""

    def __init__(self, cfg, creds):
        self.store = cfg["store"]
        self.folder = cfg["folder"]
        self.creds = creds
        self.opener = urllib.request.build_opener(_NoRedirect)

    def named_key(self, name):
        """The full key of a name in this part's folder."""
        tail = "%s/%s" % (self.folder, name)
        return "%s/%s" % (self.store["prefix"], tail) if self.store["prefix"] else tail

    def object_key(self, sha):
        return self.named_key("sha256/%s/%s" % (sha[:2], sha))

    def where(self, key):
        """(URL, host, canonical URI): path style on an endpoint and for buckets with dots, else virtual-hosted."""
        path = urllib.parse.quote(key, safe="/-_.~")
        bucket = self.store["bucket"]
        if self.store["endpoint"]:
            u = urllib.parse.urlsplit(self.store["endpoint"])
            uri = "%s/%s/%s" % (u.path.rstrip("/"), urllib.parse.quote(bucket, safe=""), path)
            return "%s://%s%s" % (u.scheme, u.netloc, uri), u.netloc, uri
        region = self.store["region"]
        if "." in bucket:
            host = "s3.%s.amazonaws.com" % region
            uri = "/%s/%s" % (bucket, path)
        else:
            host = "%s.s3.%s.amazonaws.com" % (bucket, region)
            uri = "/" + path
        return "https://%s%s" % (host, uri), host, uri

    def request(self, method, sha, data=None, payload_hash=EMPTY_SHA256, unsigned=None):
        return self.send(method, self.object_key(sha), data, payload_hash, unsigned)

    def send(self, method, key, data=None, payload_hash=EMPTY_SHA256, unsigned=None, query=""):
        """The response, or None for a 404. Retries once on a server or connection error. query: already canonical."""
        url, host, uri = self.where(key)
        if query:
            url += "?" + query
        last = None
        for attempt in range(2):
            amz = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            headers = {"host": host, "x-amz-content-sha256": payload_hash, "x-amz-date": amz}
            if self.creds.get("token"):
                headers["x-amz-security-token"] = self.creds["token"]
            signed, scope, sig = s3_signature(self.creds["secret"], self.store["region"], amz, method, uri, query, headers,
                                              payload_hash)
            req = urllib.request.Request(url, data=data, method=method)
            for k, v in headers.items():
                if k != "host":
                    req.add_header(k, v)
            for k, v in (unsigned or {}).items():
                req.add_header(k, v)
            req.add_header("Authorization", "AWS4-HMAC-SHA256 Credential=%s/%s,SignedHeaders=%s,Signature=%s" % (
                self.creds["id"], scope, signed, sig))
            try:
                return self.opener.open(req, timeout=self.store["timeout_sec"])
            except urllib.error.HTTPError as e:
                if e.code == 404:
                    return None
                if e.code == 412:
                    return e
                # Only the error's code: S3's message can quote the key id and the string it signed.
                m = re.search(r"<Code>([A-Za-z0-9]+)</Code>", e.read(4096).decode("utf-8", "replace"))
                detail = "HTTP %d%s" % (e.code, " (%s)" % m.group(1) if m else "")
                if e.code in (401, 403):
                    raise StoreError("denied", "%s: the key may not do this (it needs s3:GetObject and s3:ListBucket "
                                               "to read, s3:PutObject to write)" % detail)
                last = StoreError("server", detail)
                if e.code < 500:
                    raise last
            except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
                reason = getattr(e, "reason", e)
                last = StoreError("network", "cannot reach the store: %s" % reason)
            if attempt == 0:
                time.sleep(0.2)
        raise last

    def head(self, sha):
        """The object's size, or None when it is not there."""
        r = self.request("HEAD", sha)
        if r is None:
            return None
        r.close()
        return int(r.headers.get("Content-Length") or 0)

    def open(self, sha):
        r = self.request("GET", sha)
        if r is None:
            raise StoreError("server", "not on S3")
        return r

    def put(self, sha, data):
        self.put_key(self.object_key(sha), data, sha)

    def put_key(self, key, data, digest):
        """Upload without ever overwriting: S3 checks the content against the hash in the signature. False when the key
        is taken."""
        kind = {"Content-Type": "application/octet-stream"}
        try:
            r = self.send("PUT", key, data, digest, dict(kind, **{"If-None-Match": "*"}))
        except StoreError as e:
            if "HTTP 501" not in str(e):
                raise
            r = self.send("PUT", key, data, digest, kind)  # no conditional writes here
        taken = getattr(r, "code", None) == 412
        r.close()
        return not taken

    def put_named(self, name, data):
        return self.put_key(self.named_key(name), data, hashlib.sha256(data).hexdigest())

    def open_named(self, name):
        """The response for a name in this part's folder, or None when it is not there."""
        return self.send("GET", self.named_key(name))

    def list(self, prefix, limit=None):
        """[{name, size}] of the objects in this part's folder whose names start with prefix: every page of them, or
        one page of at most limit."""
        base = self.named_key("")
        found, token = [], None
        while True:
            q = {"list-type": "2", "prefix": base + prefix}
            if limit:
                q["max-keys"] = str(limit)
            if token:
                q["continuation-token"] = token
            query = "&".join("%s=%s" % (k, urllib.parse.quote(q[k], safe="-_.~")) for k in sorted(q))
            r = self.send("GET", "", query=query)
            if r is None:
                raise StoreError("server", "the bucket %s is not there" % self.store["bucket"])
            try:
                root = ET.fromstring(r.read())
            except (ET.ParseError, OSError, http.client.HTTPException) as e:
                raise StoreError("server", "S3's listing cannot be read: %s" % e)
            finally:
                r.close()
            text = {}
            for el in root:
                tag = el.tag.rsplit("}", 1)[-1]
                if tag == "Contents":
                    item = {c.tag.rsplit("}", 1)[-1]: c.text or "" for c in el}
                    if item.get("Key", "").startswith(base):
                        found.append({"name": item["Key"][len(base):], "size": int(item.get("Size") or 0)})
                else:
                    text[tag] = el.text or ""
            if limit or text.get("IsTruncated") != "true":
                return found
            if not text.get("NextContinuationToken") or text["NextContinuationToken"] == token:
                raise StoreError("server", "S3's listing breaks off before its end")
            token = text["NextContinuationToken"]


def baselines_heads(store, shas):
    """{sha: size or None}. The first alone: when the network is gone, that is one timeout instead of hundreds."""
    shas = list(shas)
    if not shas:
        return {}
    sizes = {shas[0]: store.head(shas[0])}
    with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
        sizes.update(zip(shas[1:], pool.map(store.head, shas[1:])))
    return sizes


def keys_id_for(name, url):
    """<project name>-<the first 8 of sha256(url)>: the name of a project's keys folder."""
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name or "").strip("-") or "project"
    return "%s-%s" % (name, hashlib.sha256((url or "").encode()).hexdigest()[:8])


def keys_id(ctx):
    """The name of this project's keys folder: keys_id in factory.json, written once by init and never changed. Without
    it, as before: the project's name and its URL (an old factory.json's project.url, else the first repository's), so a
    factory moved to the new form keeps its folder."""
    kid = ctx.cfg.get("keys_id") if isinstance(ctx.cfg, dict) else None
    if isinstance(kid, str) and kid.strip():
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", kid.strip()).strip("-.")
        if safe:
            return safe
    proj = ctx.cfg.get("project") if isinstance(ctx.cfg.get("project"), dict) else {}
    url = proj.get("url") or (ctx.repos[0].get("url") if ctx.repos else None) or ctx.factory
    return keys_id_for(proj.get("name") or os.path.basename(ctx.factory), url)


def baselines_key_dir(ctx):
    """This project's keys on this machine: outside the factory repository and its clones, so nothing that finds its way
    from FACTORY_BASELINES or a clone comes across them. Named after the project (keys_id), so a moved folder keeps them."""
    return os.path.join(keys_root(), keys_id(ctx))


def keys_root():
    return os.path.join(machine_dir(), "keys")


def baselines_old_key_file(ctx, mode):
    """Where an older version kept keys: read while they are still there, and fx doctor says how to move them."""
    return os.path.join(ctx.factory, "local", "s3-%s.env" % mode)


def baselines_key_file(ctx, mode):
    path = os.path.join(baselines_key_dir(ctx), "s3-%s.env" % mode)
    old = baselines_old_key_file(ctx, mode)
    return old if os.path.exists(old) and not os.path.exists(path) else path


def key_deny_rules(ctx):
    """For the session's settings: agents do not open key files with their Read tool."""
    return ["Read(//%s/**)" % keys_root().lstrip("/"), "Read(//%s/local/s3-*.env)" % ctx.factory.lstrip("/")]


def key_file_values(text, prefix):
    """NAME=value lines of a key file of the keys folder (the S3 keys, jira.env) whose names start with prefix. export
    and quotes are allowed; anything else on a line is not part of the value."""
    vals = {}
    for line in (text or "").lstrip("﻿").splitlines():  # an editor's byte order mark is not part of a name
        m = re.match(r"^\s*(?:export\s+)?(%s[A-Z_]+)\s*=\s*['\"]?([^'\"\s]+)" % re.escape(prefix), line)
        if m:
            vals[m.group(1)] = m.group(2)
    return vals


def baselines_key_values(ctx):
    """The keys, so they are redacted from everything fx posts and blocked in commits like any secret."""
    vals = set()
    for mode in ("read", "write", "jobs-write"):
        for path in (baselines_key_file(ctx, mode), baselines_old_key_file(ctx, mode)):
            vals |= {v for v in key_file_values(read(path, ""), "AWS_").values() if len(v) >= 6}
    # The static keys of its AWS profiles. Temporary ones (SSO, a role) would take the AWS CLI on every call here, and
    # expire by themselves.
    for setting in ("read_profile", "write_profile", "jobs_write_profile"):
        profile = ctx.c("storage." + setting)
        vals |= {v for v in ((baselines_static_profile(profile) if profile else None) or {}).values() if len(v) >= 6}
    return vals


def baselines_profile_keys(profile):
    """A profile's keys: static ones from the credentials file, else what the AWS CLI exports (SSO, roles)."""
    static = baselines_static_profile(profile)
    if static:
        return static
    if not shutil.which("aws"):
        raise StoreError("credentials", "AWS profile %s has no static keys, and without the AWS CLI fx cannot get "
                                        "temporary ones (/code-factory:factory install)" % profile)
    p = run_sep(["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"], timeout=60)
    try:
        data = json.loads(p.stdout) if p.returncode == 0 else {}
    except ValueError:
        data = {}
    if not data.get("AccessKeyId") or not data.get("SecretAccessKey"):
        raise StoreError("credentials", "the AWS CLI gave no keys for profile %s (exit %d)" % (profile, p.returncode))
    return {"id": data["AccessKeyId"], "secret": data["SecretAccessKey"], "token": data.get("SessionToken") or ""}


def baselines_keys(ctx, cfg, mode):
    """A key of this project's storage (read, write, jobs-write): s3-<mode>.env in baselines_key_dir, else
    storage.<mode>_profile. Never from the environment: the AWS_* variables there may be the project's own."""
    path = baselines_key_file(ctx, mode)
    text = read(path)
    if text is not None:
        v = key_file_values(text, "AWS_")
        if not v.get("AWS_ACCESS_KEY_ID") or not v.get("AWS_SECRET_ACCESS_KEY"):
            raise StoreError("credentials", "%s needs AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY" % path)
        return {"id": v["AWS_ACCESS_KEY_ID"], "secret": v["AWS_SECRET_ACCESS_KEY"],
                "token": v.get("AWS_SESSION_TOKEN") or ""}
    setting = "%s_profile" % mode.replace("-", "_")
    profile = cfg["store"][setting]
    if profile:
        return baselines_profile_keys(profile)
    raise StoreError("credentials", "no %s key for this project's S3 storage: put it in %s (mkdir -p -m 700 the folder, "
                                    "chmod 600 the file), or name an AWS profile in storage.%s" % (mode, path, setting))


def baselines_store(ctx, cfg, mode="read"):
    return S3Store(cfg, baselines_keys(ctx, cfg, mode))


class _LazyStore:
    """Asks for the key only when a file really has to be fetched: a machine with every image needs none."""
    def __init__(self, ctx, cfg):
        self.ctx, self.cfg, self.store, self.down = ctx, cfg, None, None

    def get(self):
        if self.down:
            raise self.down  # a dead network costs one timeout, not one per image
        if self.store is None:
            self.store = baselines_store(self.ctx, self.cfg, "read")
        return self.store


# --- the local cache, by hash. A hash in it came from this store or went up to it, so it also says "is on S3".

def baselines_cache_path(cfg, sha):
    st = cfg["store"]
    place = "%s|%s|%s|%s" % (st["endpoint"], st["bucket"], st["prefix"], cfg["folder"])
    name = hashlib.sha256(place.encode()).hexdigest()[:16]
    return os.path.join(state_dir(), "baselines", name, "sha256", sha[:2], sha)


def baselines_known(cfg, sha):
    return os.path.isfile(baselines_cache_path(cfg, sha))


def baselines_remember(cfg, sha, path):
    """Keep a verified copy of a file S3 is known to have."""
    dst = baselines_cache_path(cfg, sha)
    if not os.path.isfile(dst):
        baselines_install(path, dst)


def baselines_install(src, dst):
    """Copy a file into place with a temporary file and an atomic rename: a reader sees the old one or the new one."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=BASELINE_TMP, dir=os.path.dirname(dst))
    try:
        with os.fdopen(fd, "wb") as out_f, open(src, "rb") as in_f:
            shutil.copyfileobj(in_f, out_f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, dst)
    except BaseException:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def s3_copy_checked(r, sha, size, f):
    """Copy a download to an open file; the wrong hash or size, or a download that breaks off, raises."""
    h, n = hashlib.sha256(), 0
    try:
        for chunk in iter(lambda: r.read(1 << 20), b""):
            n += len(chunk)
            if n > size:
                break
            h.update(chunk)
            f.write(chunk)
    except (OSError, http.client.HTTPException) as e:
        raise StoreError("network", "the download broke off: %s" % e)
    finally:
        r.close()
    if n != size or h.hexdigest() != sha:
        raise StoreError("integrity", "the download does not match the list (%d bytes for %d, hash %s…): rejected"
                         % (n, size, h.hexdigest()[:12]))


def baselines_fetch(cfg, lazy, sha, size):
    """A verified copy of an object in the cache, downloaded when needed. A download with the wrong hash or size is
    thrown away: nothing else has been touched yet."""
    path = baselines_cache_path(cfg, sha)
    if os.path.isfile(path):
        if os.path.getsize(path) == size and file_sha256(path) == sha:
            return path
        os.remove(path)
    store = lazy.get()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=BASELINE_TMP, dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "wb") as f:
            try:
                r = store.open(sha)
            except StoreError as e:
                if e.kind == "network":
                    lazy.down = e
                raise
            s3_copy_checked(r, sha, size, f)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)
    return path


# --- comparing and syncing a folder

def baselines_compare(entries, folder, tidy=False):
    """What differs between the list and the folder: missing, wrong (path -> local hash), extra files, symlinks."""
    real = {}
    files, links = baselines_scan(folder, tidy, real) if os.path.isdir(folder) else ([], [])
    have = set(files)
    missing, wrong = [], {}
    for rel, want in entries.items():
        target = baselines_target(folder, rel)
        if real.get(rel, rel) != rel:  # nothing has renamed it yet
            target = os.path.join(folder, *real[rel].split("/"))
        if rel not in have and not os.path.isfile(target):
            missing.append(rel)
        elif os.path.islink(target) or os.path.getsize(target) != want["size"] or file_sha256(target) != want["sha256"]:
            wrong[rel] = file_sha256(target)  # a symlink inside the folder becomes the real file
    return {"missing": sorted(missing), "wrong": wrong, "extra": sorted(have - set(entries)),
            "links": [l for l in links if l not in entries]}


def baselines_recoverable(cfg, root, sha):
    """A version this store has, or one a list named in the past: nothing is lost by replacing it."""
    if baselines_known(cfg, sha):
        return True
    try:  # a partial clone may have to fetch old versions of the list; not worth waiting for or asking a password
        p = run(["git", "log", "-1", "--format=%H", "-S", sha, "--", cfg["manifest"]], cwd=root, check=False,
                env=baselines_git_env(), timeout=60)
    except subprocess.TimeoutExpired:
        return False
    return p.returncode == 0 and bool(p.stdout.strip())


def baselines_keep(folder, rel, keep_dir):
    if keep_dir:
        dst = os.path.join(keep_dir, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(os.path.join(folder, rel), dst)


def baselines_sync_folder(ctx, cfg, root, keep_dir, restore=True):
    """Bring the folder in line with the list. Only what is missing or wrong is fetched, and a file is replaced only
    once its download is verified. A version nobody recorded is first copied to keep_dir, and a version S3 has is just
    replaced. restore=False only fills in what is missing, for when other work may be under way in the folder."""
    rep = {"fetched": [], "unrecorded": [], "removed": [], "failed": [], "untouched": []}
    entries = baselines_read(cfg, root)
    if entries is None:
        raise FxError("no baselines list at %s: run fx baselines record or migrate" % cfg["manifest"], code=3)
    folder = baselines_folder(cfg, root)
    lazy = _LazyStore(ctx, cfg)
    with baselines_folder_lock(folder):
        os.makedirs(folder, exist_ok=True)
        diff = baselines_compare(entries, folder, tidy=True)
        if not restore:
            rep["untouched"] = sorted(diff["wrong"]) + diff["extra"] + diff["links"]
        todo = diff["missing"] + (sorted(diff["wrong"]) if restore else [])

        def one(rel):
            want = entries[rel]
            src = baselines_fetch(cfg, lazy, want["sha256"], want["size"])
            local = diff["wrong"].get(rel)
            if local and not baselines_recoverable(cfg, root, local):
                baselines_keep(folder, rel, keep_dir)
                rep["unrecorded"].append(rel)
            baselines_install(src, baselines_target(folder, rel))
            rep["fetched"].append(rel)

        with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
            futures = {pool.submit(one, rel): rel for rel in todo}
            for fut in concurrent.futures.as_completed(futures):
                try:
                    fut.result()
                except (StoreError, OSError) as e:
                    rep["failed"].append({"path": futures[fut], "reason": str(e)})
        if restore:
            for rel in diff["extra"]:
                if not baselines_recoverable(cfg, root, file_sha256(os.path.join(folder, rel))):
                    baselines_keep(folder, rel, keep_dir)
                    rep["unrecorded"].append(rel)
                os.remove(os.path.join(folder, rel))
                rep["removed"].append(rel)
            for rel in diff["links"]:
                os.remove(os.path.join(folder, rel))
                rep["removed"].append(rel)
            for dirpath, _, _ in os.walk(folder, topdown=False):
                if dirpath != folder and not os.listdir(dirpath):
                    os.rmdir(dirpath)
    rep["failed"].sort(key=lambda x: x["path"])
    rep["unrecorded"].sort()
    return rep


def baselines_failure_text(rep):
    lines = ["%s: %s" % (f["path"], f["reason"]) for f in rep["failed"][:20]]
    more = len(rep["failed"]) - len(lines)
    return ("%d baseline image(s) missing and not fetched, so the images cannot be compared (never skipped; fix the "
            "store or its key):\n" % len(rep["failed"])) + "\n".join(lines) + ("\n… and %d more" % more if more else "")


# --- is there anything new in the repository that holds the list

def baselines_git_env():
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=15")
    return env


def baselines_remote_state(root, timeout=45):
    """behind, ahead and state: ok, no-upstream, or unreachable (with error) after trying to fetch."""
    up = git(["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], root, check=False)
    upstream = up.stdout.strip() if up.returncode == 0 else ""
    branch = git(["symbolic-ref", "--short", "-q", "HEAD"], root, check=False).stdout.strip()
    if not upstream or not branch:
        return {"state": "no-upstream", "behind": 0, "ahead": 0}
    remote = git(["config", "--get", "branch.%s.remote" % branch], root, check=False).stdout.strip() or REMOTE
    st = {"state": "ok", "upstream": upstream}
    try:
        p = run(["git", "fetch", "-q", remote], cwd=root, check=False, env=baselines_git_env(), timeout=timeout)
        if p.returncode != 0:
            st.update(state="unreachable", error=(p.stdout or "").strip().splitlines()[-1:] or ["git fetch failed"])
    except subprocess.TimeoutExpired:
        st.update(state="unreachable", error=["git fetch timed out"])
    if isinstance(st.get("error"), list):
        st["error"] = st["error"][0][:300]
    st["behind"] = int(git(["rev-list", "--count", "HEAD..@{u}"], root, check=False).stdout.strip() or 0)
    st["ahead"] = int(git(["rev-list", "--count", "@{u}..HEAD"], root, check=False).stdout.strip() or 0)
    return st


def baselines_lock_file(ctx):
    os.makedirs(ctx.jobs, exist_ok=True)
    return open(os.path.join(ctx.jobs, ".baselines-gate.lock"), "w")


def baselines_release():
    while _BASELINE_GATE_LOCK:
        _BASELINE_GATE_LOCK.pop().close()


def baselines_hold(ctx):
    """Held shared by every gate and selftest until fx exits, so that no pull changes checks.sh or factory.json under
    them. A pull only happens under the exclusive lock, which it does not wait for."""
    if not _BASELINE_GATE_LOCK:
        f = baselines_lock_file(ctx)
        if not flock_wait(f, "shared", BASELINE_LOCK_WAIT_SEC):
            f.close()
            raise FxError("the factory repository stayed busy with a pull for %ds; try again" % BASELINE_LOCK_WAIT_SEC, code=3)
        _BASELINE_GATE_LOCK.append(f)


def baselines_refresh(ctx, cfg, hold=False):
    """The one moment fx updates the factory repository: at the start of a gate, a selftest, a new job or a sync, before
    it reads checks.sh, with no other gate or selftest running. Stops (exit 3) on uncommitted changes. Warns only when
    the remote cannot be reached. A project clone is never pulled: a job's branch keeps its own list until fx pr merges
    the target branch into it. Returns warnings and what was pulled."""
    rep = {"warnings": [], "pulled": None}
    if cfg["repo"] != "factory":
        if hold:
            baselines_hold(ctx)
        return rep
    st = baselines_remote_state(ctx.factory)
    if st["state"] == "unreachable":
        rep["warnings"].append("could not check the factory repository for new commits (%s); using the baselines list "
                               "as it is here" % st["error"])
    if st["behind"] and st["state"] == "ok":
        dirty = git(["status", "--porcelain", "--untracked-files=no"], ctx.factory).stdout.strip()
        if dirty:
            raise FxError("the factory repository is %d commit(s) behind %s but has uncommitted changes, so fx did not "
                          "pull (it never stashes or merges). Commit or discard them, or finish the baselines change "
                          "with fx baselines push --commit, then run this again:\n%s"
                          % (st["behind"], st["upstream"], dirty), code=3)
        if st["ahead"]:
            raise FxError("the factory repository has %d commit(s) of its own and is %d behind %s, so it cannot "
                          "fast-forward: merge it by hand, then run this again" % (st["ahead"], st["behind"], st["upstream"]),
                          code=3)
        f = baselines_lock_file(ctx)
        try:
            if flock_wait(f, "exclusive", 0):
                old = git(["rev-parse", "HEAD"], ctx.factory).stdout.strip()
                try:
                    p = run(["git", "pull", "-q", "--ff-only"], cwd=ctx.factory, check=False, env=baselines_git_env(),
                            timeout=300)
                except subprocess.TimeoutExpired:
                    raise FxError("git pull timed out in the factory repository", code=3)
                if p.returncode != 0:
                    raise FxError("git pull --ff-only failed in the factory repository: %s" % (p.stdout or "")[-500:], code=3)
                rep["pulled"] = {"from": old, "to": git(["rev-parse", "HEAD"], ctx.factory).stdout.strip(),
                                 "commits": st["behind"]}
                ctx.load_config(True)
            else:
                rep["warnings"].append("the factory repository is %d commit(s) behind %s, and another gate or selftest "
                                       "is running: not pulled now, so nothing changes under it" % (st["behind"], st["upstream"]))
        finally:
            f.close()
    if hold:
        baselines_hold(ctx)
    return rep


# --- before checks.sh

def baselines_list_state(cfg, root, job=None):
    """present; hidden (git is told not to look at it); lost (a commit this branch stands on, or the branch it goes into,
    has the list, and it is gone here); not-migrated (no such commit has a list and the images are in git); or none. Only
    commits count: the index and the folder are the builder's to change, so for a job a copy in the folder does not bring
    back a list the branch dropped."""
    def has(rev):
        return rev and git(["cat-file", "-e", "%s:%s" % (rev, cfg["manifest"])], root, check=False).returncode == 0
    on_disk = os.path.exists(os.path.join(root, cfg["manifest"]))
    if job:
        flag = git(["ls-files", "-v", "--", cfg["manifest"]], root, check=False).stdout[:1]
        if flag == "S" or flag.islower():
            return "hidden"
        tip = job["base_ref"] if cfg["repo"] == "project" else "@{u}"  # a branch can start from before the list existed
        if not has("HEAD") and any(has(r) for r in (baselines_reference(cfg, root, job), job.get("baselines_start"), tip)):
            return "lost"
    if on_disk:
        return "present"
    if has("HEAD"):
        return "lost"
    if git(["ls-tree", "-r", "--name-only", "HEAD", "--", cfg["dir"]], root, check=False).stdout.strip():
        return "not-migrated"
    return "none"


def baselines_not_migrated(cfg, root, job=None):
    """The list is missing and this branch never had one, with the images still in git: it has not moved to S3 yet."""
    return baselines_list_state(cfg, root, job) == "not-migrated"


def baselines_lost_text(cfg):
    return ("the baselines list %s is gone, but this branch or the one it goes into has it. Restore it with git, or merge "
            "that branch; a job does not take the images back from S3, and only a human can decide to stop using the list"
            % cfg["manifest"])


def baselines_hidden_text(cfg):
    return ("git is told not to look at the baselines list %s, so what checks use may not be what is committed. Undo it: "
            "git update-index --no-skip-worktree --no-assume-unchanged %s" % (cfg["manifest"], cfg["manifest"]))


def baselines_unpushed_commit(ctx, cfg, root, rep):
    """Hashes in the committed list that S3 does not have: nobody else could ever get those images."""
    head = baselines_at(cfg, root, "HEAD") or {}
    unknown = {}
    for rel, e in head.items():
        if not baselines_known(cfg, e["sha256"]):
            unknown.setdefault(e["sha256"], []).append(rel)
    if not unknown:
        return []
    try:
        sizes = baselines_heads(baselines_store(ctx, cfg, "read"), unknown)
    except StoreError as e:
        rep["problems"].append("could not check that S3 has every image of the committed list, so nobody can say "
                               "others will get them: %s" % e)
        return []
    missing = sorted(r for sha, size in sizes.items() if size is None for r in unknown[sha])
    folder = baselines_folder(cfg, root)
    for sha, size in sizes.items():
        rel = unknown[sha][0]
        path = os.path.join(folder, rel)
        if size is not None and os.path.isfile(path) and file_sha256(path) == sha:
            baselines_remember(cfg, sha, path)
    return missing


def baselines_before_checks(ctx, cfg, root, keep_dir, restore=True, job=None):
    """Everything checks.sh relies on: the folder matches the list, and the committed list only names what S3 has."""
    rep = {"problems": [], "warnings": [], "unrecorded": [], "keep_dir": keep_dir, "fetched": 0, "removed": 0}
    state = baselines_list_state(cfg, root, job)
    if state == "not-migrated":
        rep["warnings"].append("%s does not exist yet and the images are still in git here: using them as they are"
                               % cfg["manifest"])
        return rep
    if state in ("lost", "hidden"):
        rep["problems"].append(baselines_lost_text(cfg) if state == "lost" else baselines_hidden_text(cfg))
        return rep
    try:
        sync = baselines_sync_folder(ctx, cfg, root, keep_dir, restore)
    except FxError as e:
        rep["problems"].append(str(e))
        return rep
    rep.update(fetched=len(sync["fetched"]), removed=len(sync["removed"]), unrecorded=sync["unrecorded"])
    if sync["failed"]:
        rep["problems"].append(baselines_failure_text(sync))
    if sync["untouched"]:
        rep["warnings"].append("%d baseline file(s) differ from the list and were left alone for now: %s"
                               % (len(sync["untouched"]), ", ".join(sync["untouched"][:10])))
    if sync["unrecorded"]:
        rep["warnings"].append("%d baseline file(s) differed from the list without fx baselines record. They were "
                               "restored from the list; your versions are kept in %s: %s" % (
                                   len(sync["unrecorded"]), keep_dir, ", ".join(sync["unrecorded"][:10])))
    missing = baselines_unpushed_commit(ctx, cfg, root, rep)
    if missing:
        rep["problems"].append("the committed baselines list names %d image(s) that are not on S3, so nobody else can "
                               "get them. Run fx baselines push: %s" % (len(missing), ", ".join(missing[:20])))
    return rep


# --- what changed, for the reports

def baselines_diff(before, after):
    out_ = {}
    for rel in set(before) | set(after):
        b, a = before.get(rel), after.get(rel)
        if b == a:
            continue
        out_[rel] = {"change": "added" if not b else "removed" if not a else "changed", "before": b, "after": a}
    return out_


def baselines_merge(old, new):
    """The earliest before and the latest after of each image; an image back to where it started is no change."""
    merged = {r: dict(c) for r, c in old.items()}
    for rel, c in new.items():
        if rel in merged:
            merged[rel]["after"] = c["after"]
        else:
            merged[rel] = dict(c)
    for rel in list(merged):
        b, a = merged[rel]["before"], merged[rel]["after"]
        if b == a:
            del merged[rel]
        else:
            merged[rel]["change"] = "added" if not b else "removed" if not a else "changed"
    return merged


def baselines_ledger_path(ctx, job):
    return os.path.join(ctx.job_dir(job["id"]), "baselines-changes.json")


def baselines_reference(cfg, root, job):
    """The commit this job's changes are measured from: what the team already has."""
    if cfg["repo"] == "project":
        base = job["base_ref"] if job else "%s/HEAD" % REMOTE
        return git(["merge-base", base, "HEAD"], root, check=False).stdout.strip() or base
    up = git(["merge-base", "HEAD", "@{u}"], root, check=False)
    if up.returncode == 0 and up.stdout.strip():
        return up.stdout.strip()
    return (job or {}).get("baselines_start") or "HEAD"


def baselines_job_changes(ctx, cfg, root, job):
    """Every change to the list since that commit, plus what this job recorded earlier: a builder cannot hide one by
    leaving out --job, or by committing the list itself."""
    ledger = json.loads(read(baselines_ledger_path(ctx, job), "{}") or "{}")
    current = baselines_read(cfg, root) or {}
    base = baselines_at(cfg, root, baselines_reference(cfg, root, job)) or {}
    merged = baselines_merge(ledger, baselines_diff(base, current))
    write_atomic(baselines_ledger_path(ctx, job), json.dumps(merged, indent=1, sort_keys=True) + "\n")
    return merged


def baselines_counts(changes):
    return {k: sum(1 for c in changes.values() if c["change"] == k) for k in ("changed", "added", "removed")}


def baselines_materialize(ctx, cfg, root, changes, out_dir):
    """Copies of every changed image in <out_dir>/before and /after, to look at side by side. What is on neither this
    machine nor S3 is reported, not fatal: only a human looks at these."""
    lazy, problems = _LazyStore(ctx, cfg), []
    folder = baselines_folder(cfg, root)

    def one(item):
        rel, c = item
        for side in ("before", "after"):
            e = c[side]
            if not e:
                continue
            dst = baselines_target(os.path.join(out_dir, side), rel)
            local = os.path.join(folder, rel)
            if side == "after" and os.path.isfile(local) and file_sha256(local) == e["sha256"]:
                baselines_install(local, dst)
            else:
                baselines_install(baselines_fetch(cfg, lazy, e["sha256"], e["size"]), dst)

    with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
        futures = {pool.submit(one, item): item[0] for item in changes.items()}
        for fut in concurrent.futures.as_completed(futures):
            try:
                fut.result()
            except (StoreError, OSError) as e:
                problems.append("%s: %s" % (futures[fut], e))
    return sorted(problems)


def baselines_how_to_view(summary):
    return ("Before and after, side by side: `%s/before/` and `%s/after/` in the job folder on the machine that ran it. "
            "Anywhere else with the read key: `fx baselines diff --from <commit> --to <commit>`%s." % (
                summary["images"], summary["images"], " in a clone of the project" if summary["repo"] == "project" else ""))


def baselines_changes_markdown(summary, changes, limit=40):
    n = summary["counts"]
    lines = ["%d changed, %d added, %d removed in `%s`. A changed baseline can hide a UI bug: check each one against "
             "what the spec asks for." % (n["changed"], n["added"], n["removed"], summary["manifest"]), "",
             baselines_how_to_view(summary), "", "| Image | Change | Before | After |", "|---|---|---|---|"]
    short = lambda e: "`%s…` %d B" % (e["sha256"][:12], e["size"]) if e else "-"
    for rel in sorted(changes)[:limit]:
        c = changes[rel]
        lines.append("| `%s` | %s | %s | %s |" % (rel, c["change"], short(c["before"]), short(c["after"])))
    if len(changes) > limit:
        lines.append("| … and %d more | | | |" % (len(changes) - limit))
    return lines


def baselines_gate(ctx, cfg, job, rdir, pre):
    """The gate's baselines step: fetch and restore, and report every change to the list."""
    root = baselines_root(ctx, cfg, job=job)
    out_dir = os.path.join(rdir, "baselines")
    rep = baselines_before_checks(ctx, cfg, root, os.path.join(out_dir, "unrecorded"), job=job)
    rep["warnings"] = (pre or {}).get("warnings", []) + rep["warnings"]
    summary = {"repo": cfg["repo"], "manifest": cfg["manifest"], "folder": os.path.join(root, cfg["dir"]),
               "fetched": rep["fetched"], "unrecorded": rep["unrecorded"], "warnings": rep["warnings"],
               "pulled": (pre or {}).get("pulled")}
    changes = {}
    if baselines_list_state(cfg, root, job) == "present":
        try:
            changes = baselines_job_changes(ctx, cfg, root, job)
        except FxError as e:
            if not rep["problems"]:  # the same bad list the sync already reported
                rep["problems"].append(str(e))
    summary["counts"] = baselines_counts(changes)
    summary["images"] = "round-%d/baselines" % job["round"]
    if changes:
        problems = baselines_materialize(ctx, cfg, root, changes, out_dir)
        if problems:
            rep["warnings"].append("before or after images not available for comparison: " + "; ".join(problems[:10]))
    entries = {}
    if not rep["problems"]:
        entries = baselines_read(cfg, root) or {}
    summary["pending_push"] = sorted({e["sha256"] for e in entries.values()
                                      if not baselines_known(cfg, e["sha256"])})[:1000]
    md = ["## Baselines", ""]
    md += ["- " + w.replace("\n", "\n  ") for w in rep["warnings"]]
    if summary["fetched"]:
        md.append("- %d image(s) fetched for this gate." % summary["fetched"])
    if summary["pending_push"]:
        md.append("- %d new image(s) are not on S3 yet: fx baselines push before the list is committed."
                  % len(summary["pending_push"]))
    if rep["unrecorded"]:
        md.append("- Kept versions that were not recorded: `%s/unrecorded/` (to keep one, copy it back and run fx "
                  "baselines record)." % summary["images"])
    if changes:
        md += ["", "### Baselines changed", ""] + baselines_changes_markdown(summary, changes)
        write_atomic(os.path.join(rdir, "baselines.md"), "\n".join(
            ["# Baselines changed by %s" % job["id"], ""] + baselines_changes_markdown(summary, changes, 5000)) + "\n")
    elif len(md) == 2:
        md.append("The folder matches the list; the list did not change.")
    job["baselines"] = summary
    return {"problems": rep["problems"], "markdown": md + [""], "changes": changes, "summary": summary}


def baselines_for_checks(ctx, cfg, job, root=None, keep=None):
    """Before a checks.sh outside the gate (fx pr after syncing with the target, a candidate): (ok, why)."""
    baselines_hold(ctx)
    view = baselines_job(ctx, cfg, job)
    if view is None:  # the list is in a repository this job does not change: nothing of it to check
        return True, ""
    root = root or baselines_root(ctx, cfg, job=view)
    keep = keep or os.path.join(ctx.job_dir(job["id"]), "baselines", "unrecorded")
    rep = baselines_before_checks(ctx, cfg, root, keep, job=view)
    return not rep["problems"], "\n".join(rep["problems"])


def baselines_fill_clone(ctx, dest, repo=None):
    """A new clone of the repository that keeps the list (baselines.repo): fetch its images (they are not in git). Trouble
    here is not fatal: the gate fetches again, and fails if it cannot. Returns a warning or None."""
    cfg = baselines_config(ctx)
    if not cfg or cfg["repo"] != "project" or (repo and cfg["repo_name"] and repo != cfg["repo_name"]) or \
            baselines_not_migrated(cfg, dest) or \
            not os.path.exists(os.path.join(dest, cfg["manifest"])):
        return None
    try:
        sync = baselines_sync_folder(ctx, cfg, dest, None, restore=False)
    except FxError as e:
        return str(e)
    return baselines_failure_text(sync) if sync["failed"] else None


def baselines_take_images(ctx, src, dst, repo=None):
    """A package or candidate's new images move with its list, or they would be lost with its clone."""
    cfg = baselines_config(ctx)
    if not cfg or cfg["repo"] != "project" or (repo and cfg["repo_name"] and repo != cfg["repo_name"]):
        return
    entries = baselines_read(cfg, dst) or {}
    src_folder, dst_folder = os.path.join(src, cfg["dir"]), baselines_folder(cfg, dst)
    with baselines_folder_lock(dst_folder):
        for rel, e in entries.items():
            have, want = os.path.join(src_folder, rel), baselines_target(dst_folder, rel)
            if os.path.isfile(have) and not (os.path.isfile(want) and file_sha256(want) == e["sha256"]) \
                    and file_sha256(have) == e["sha256"]:
                baselines_install(have, want)


def baselines_before_push(ctx, cfg, job):
    """fx pr pushes nothing that depends on a list others cannot use. Returns notes; stops (exit 3) otherwise."""
    whole, job = job, baselines_job(ctx, cfg, job)
    if job is None:  # the list is in a repository this job does not change
        return []
    root = baselines_root(ctx, cfg, job=job)
    notes = []
    state = baselines_list_state(cfg, root, job)
    if state in ("lost", "hidden"):
        raise FxError(baselines_lost_text(cfg) if state == "lost" else baselines_hidden_text(cfg), code=3)
    if state != "present":
        return notes
    arg = "--job %s " % job["id"]
    if git(["status", "--porcelain", "--", cfg["manifest"]], root).stdout.strip():
        raise FxError("the baselines list %s has uncommitted changes. Upload the images and commit it first: `%s "
                      "baselines push %s--commit`" % (cfg["manifest"], FX_CMD, arg), code=3)
    rep = {"warnings": [], "problems": []}
    missing = baselines_unpushed_commit(ctx, cfg, root, rep)
    if rep["problems"]:
        raise FxError("; ".join(rep["problems"]), code=3)
    if missing:
        raise FxError("the committed baselines list names %d image(s) that are not on S3: %s. Upload them first: `%s "
                      "baselines push %s`" % (len(missing), ", ".join(missing[:20]), FX_CMD, arg), code=3)
    notes += rep["warnings"]
    changes = baselines_job_changes(ctx, cfg, root, job)
    summary = dict(job.get("baselines") or {}, repo=cfg["repo"], manifest=cfg["manifest"], images="baselines-pr",
                   counts=baselines_counts(changes))
    summary["changes_md"] = baselines_changes_markdown(summary, changes) if changes else []
    job["baselines"] = whole["baselines"] = summary
    if changes:
        problems = baselines_materialize(ctx, cfg, root, changes, os.path.join(ctx.job_dir(job["id"]), "baselines-pr"))
        if problems:
            notes.append("before or after images not available for comparison: " + "; ".join(problems[:5]))
    if cfg["repo"] == "factory" and changes:
        st = baselines_remote_state(root)
        if st["ahead"]:
            notes.append("the factory repository has %d commit(s) not on its remote, with the baselines list: push it, "
                         "so the team can get these images" % st["ahead"])
    return notes


# --- the command

def baselines_ensure_ignored(cfg, root):
    """Add the folder to the .gitignore of the checkout that holds it. Returns True when the file changed."""
    gi = os.path.join(root, ".gitignore")
    line = cfg["dir"] + "/"
    have = (read(gi, "") or "").splitlines()
    if line in have or "/" + line in have:
        return False
    text = read(gi, "") or ""
    if text and not text.endswith("\n"):
        text += "\n"
    write_atomic(gi, text + "\n# baselines live on S3 (software factory)\n" + line + "\n")
    return True


def baselines_record(cfg, root, allow_removed=False):
    """Hash the folder and write the list. Nothing is uploaded. Images that are gone need --allow-removed: on a new
    machine with an empty folder this would otherwise wipe the list."""
    folder = baselines_folder(cfg, root)
    with baselines_folder_lock(folder):
        files, links = baselines_scan(folder, tidy=True) if os.path.isdir(folder) else ([], [])
        if links:
            raise FxError("the baselines folder holds symlinks, which the list cannot record: %s" % ", ".join(links[:10]),
                          code=3)
        for rel in files:
            why = baselines_safe_rel(rel)
            if why:
                raise FxError("cannot record %r (%s)" % (rel, why), code=3)
        entries = {rel: {"sha256": file_sha256(os.path.join(folder, rel)),
                         "size": os.path.getsize(os.path.join(folder, rel))} for rel in files}
        before = baselines_read(cfg, root) or {}
        gone = sorted(set(before) - set(entries))
        if gone and not allow_removed:
            raise FxError("%d image(s) on the list are not in the folder: %s. If the folder is just not synced, run fx "
                          "baselines sync. If they really should go, run this with --allow-removed."
                          % (len(gone), ", ".join(gone[:10])), code=3)
        write_atomic(os.path.join(root, cfg["manifest"]), baselines_text(entries))
    baselines_ensure_ignored(cfg, root)
    return before, entries


def baselines_push(ctx, cfg, root, entries):
    """Upload what S3 lacks, never overwriting, then confirm every hash of the list is there."""
    folder = baselines_folder(cfg, root)
    uniq = {}
    for rel, e in entries.items():
        uniq.setdefault(e["sha256"], dict(e, path=rel))
    reader = baselines_store(ctx, cfg, "read") if read(baselines_key_file(ctx, "read")) is not None \
        or cfg["store"]["read_profile"] else baselines_store(ctx, cfg, "write")
    writer = baselines_store(ctx, cfg, "write")

    def one(item):
        sha, e = item
        size = reader.head(sha)
        if size is not None:
            if size != e["size"]:
                raise StoreError("integrity", "S3 has %d bytes for this hash, the list says %d; not overwritten"
                                 % (size, e["size"]))
            path = os.path.join(folder, e["path"])
            if os.path.isfile(path) and file_sha256(path) == sha:
                baselines_remember(cfg, sha, path)
            return False
        path = baselines_target(folder, e["path"])
        if not os.path.isfile(path) or file_sha256(path) != sha:
            cached = baselines_cache_path(cfg, sha)
            if not (os.path.isfile(cached) and file_sha256(cached) == sha):
                raise StoreError("integrity", "the local file does not match the list, so it cannot be uploaded: run "
                                              "fx baselines record, or sync")
            path = cached
        with open(path, "rb") as f:
            writer.put(sha, f.read())
        if reader.head(sha) != e["size"]:
            raise StoreError("server", "uploaded, but S3 does not show it with the right size")
        baselines_remember(cfg, sha, path)
        return True

    failed, uploaded = [], 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
        futures = {pool.submit(one, item): item[1]["path"] for item in uniq.items()}
        for fut in concurrent.futures.as_completed(futures):
            try:
                uploaded += 1 if fut.result() else 0
            except (StoreError, OSError) as e:
                failed.append("%s: %s" % (futures[fut], e))
    if failed:
        raise FxError("%d image(s) could not be confirmed on S3, so the list must not be committed:\n%s"
                      % (len(failed), "\n".join(sorted(failed)[:20])), code=3)
    return {"uploaded": uploaded, "confirmed": len(uniq), "images": len(entries)}


def baselines_commit(cfg, root, message):
    if not git(["status", "--porcelain", "--", cfg["manifest"]], root).stdout.strip():
        return None
    git(["add", "--", cfg["manifest"]], root)
    git(["commit", "-q", "-m", message, "--", cfg["manifest"]], root)
    return git(["rev-parse", "HEAD"], root).stdout.strip()


def baselines_status(ctx, cfg, root):
    folder = baselines_folder(cfg, root)
    entries = baselines_read(cfg, root)
    res = {"ok": True, "repo": cfg["repo"], "root": root, "folder": folder, "manifest": cfg["manifest"],
           "keys_folder": baselines_key_dir(ctx)}
    if entries is None:
        tracked = baselines_not_migrated(cfg, root)
        files = baselines_scan(folder)[0] if os.path.isdir(folder) else []
        res.update(ok=False, migrated=False, images_in_git=tracked, unrecorded=files, missing=[], wrong=[],
                   next="fx baselines migrate" if tracked else "fx baselines record")
    else:
        diff = baselines_compare(entries, folder)
        res.update(migrated=True, images=len(entries), missing=diff["missing"], wrong=sorted(diff["wrong"]),
                   unrecorded=diff["extra"], symlinks=diff["links"],
                   tracked_by_git=len(git(["ls-files", "--", cfg["dir"]], root, check=False).stdout.splitlines()),
                   list_uncommitted=bool(git(["status", "--porcelain", "--", cfg["manifest"]], root).stdout.strip()),
                   not_known_on_s3=len({e["sha256"] for e in entries.values()
                                        if not baselines_known(cfg, e["sha256"])}))
        res["ok"] = not (diff["missing"] or diff["wrong"] or diff["extra"] or diff["links"])
        res["next"] = ("fx baselines sync, or fx baselines record for files you meant to change" if not res["ok"]
                       else "nothing to do")
    res["remote"] = baselines_remote_state(root)
    if res["remote"].get("behind"):
        res["ok"] = False
        res["next"] = "fx baselines sync pulls the %d new commit(s)" % res["remote"]["behind"]
    return res


def cmd_baselines(ctx, a):
    cfg = baselines_config(ctx)
    if not cfg:
        lost = baselines_lost_list(ctx)
        raise FxError(baselines_settings_lost_text(lost) if lost else
                      "this factory has no baselines block in factory.json: its images, if any, are plain files in git",
                      code=3)
    root = baselines_root(ctx, cfg, a)
    job = ctx.load(a.job) if getattr(a, "job", None) else None
    job = (baselines_job(ctx, cfg, job) or job) if job else None
    try:
        if a.action == "status":
            out(baselines_status(ctx, cfg, root))
        elif a.action == "sync":
            pre = baselines_refresh(ctx, cfg)
            cfg = baselines_config(ctx)
            stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
            keep = os.path.join(ctx.job_dir(job["id"]) if job else os.path.join(ctx.jobs, "_baselines"),
                                "unrecorded-" + stamp)
            sync = baselines_sync_folder(ctx, cfg, root, keep)
            if sync["failed"]:
                raise FxError(baselines_failure_text(sync), code=3,
                              extra={"failed": sync["failed"], "warnings": pre["warnings"]})
            out({"ok": True, "fetched": len(sync["fetched"]), "removed": sync["removed"], "pulled": pre["pulled"],
                 "unrecorded": sync["unrecorded"], "kept_in": keep if sync["unrecorded"] else None,
                 "warnings": pre["warnings"], "next": "the folder matches the list"})
        elif a.action == "record":
            before, after = baselines_record(cfg, root, a.allow_removed)
            changes = baselines_diff(before, after)
            if job:
                ledger = json.loads(read(baselines_ledger_path(ctx, job), "{}") or "{}")
                write_atomic(baselines_ledger_path(ctx, job), json.dumps(baselines_merge(ledger, changes), indent=1,
                                                                         sort_keys=True) + "\n")
            out({"ok": True, "images": len(after), "counts": baselines_counts(changes), "changed": sorted(changes)[:50],
                 "next": "the gate compares with these local images; run fx baselines push before committing the list"})
        elif a.action == "push":
            entries = baselines_read(cfg, root)
            if entries is None:
                raise FxError("no baselines list at %s: run fx baselines record first" % cfg["manifest"], code=3)
            res = baselines_push(ctx, cfg, root, entries)
            commit = None
            if a.commit:
                commit = baselines_commit(cfg, root, "baselines: update the list%s" % (
                    " for %s" % job["id"] if job else ""))
            out(dict(res, ok=True, commit=commit, next="every image is on S3" + (
                "" if a.commit else "; the list may be committed now")))
        elif a.action == "migrate":
            out(baselines_migrate(ctx, cfg, root, a.commit))
        elif a.action == "diff":
            frm = a.from_ref or baselines_reference(cfg, root, job)
            before = baselines_at(cfg, root, frm)
            if before is None and git(["rev-parse", "--verify", "-q", frm], root, check=False).returncode != 0:
                raise FxError("no such commit: %s" % frm, code=3)
            after = baselines_at(cfg, root, a.to_ref) if a.to_ref else baselines_read(cfg, root)
            changes = baselines_diff(before or {}, after or {})
            stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
            dest = os.path.abspath(a.out or os.path.join(ctx.jobs, "_baselines", "diff-" + stamp))
            problems = baselines_materialize(ctx, cfg, root, changes, dest)
            out({"ok": not problems, "counts": baselines_counts(changes), "changed": sorted(changes),
                 "before": os.path.join(dest, "before"), "after": os.path.join(dest, "after"), "problems": problems})
    except StoreError as e:
        raise FxError("baselines store: %s" % e, code=3)


def baselines_migrate(ctx, cfg, root, commit):
    """From images in git to S3: upload, write the list and .gitignore, and with --commit (the user's yes) take the
    images out of the index in a normal commit. History is not rewritten, so the repository does not shrink."""
    if git(["status", "--porcelain", "--untracked-files=no", "--", cfg["dir"]], root).stdout.strip():
        raise FxError("%s has uncommitted changes to tracked images: commit or discard them first, so the list starts "
                      "from known images" % cfg["dir"], code=3)
    tracked = [t for t in git(["ls-files", "-z", "--", cfg["dir"]], root).stdout.split("\0") if t]
    folder = baselines_folder(cfg, root)
    if tracked and os.path.isdir(folder):
        known = {unicodedata.normalize("NFC", os.path.relpath(os.path.join(root, t), folder).replace(os.sep, "/"))
                 for t in tracked}
        stray = sorted(set(baselines_scan(folder)[0]) - known)
        if stray:
            raise FxError("%s holds files git does not track, which would become reference images: %s. Commit them if "
                          "they are, move them away if not" % (cfg["dir"], ", ".join(stray[:10])), code=3)
    _, entries = baselines_record(cfg, root, allow_removed=False)
    res = baselines_push(ctx, cfg, root, entries)
    res.update(ok=True, ignored=cfg["dir"] + "/", images_tracked=len(tracked), commit=None)
    if not commit:
        res["next"] = ("everything is on S3 and the images are still in git. Ask the user whether to take them out of the "
                       "index with a normal commit (history stays as it is): fx baselines migrate --commit")
        return res
    # A commit from the index: `git commit -- <folder>` would take the images back from the working tree.
    other = [p for p in git(["diff", "--cached", "--name-only", "-z"], root).stdout.split("\0")
             if p and p not in (cfg["manifest"], ".gitignore") and not p.startswith(cfg["dir"] + "/")]
    if other:
        raise FxError("other changes are staged here, and this commit must hold only the move to S3; commit or unstage "
                      "them first: %s" % ", ".join(other[:10]), code=3)
    if tracked:
        git(["rm", "-r", "-q", "--cached", "--", cfg["dir"]], root)
    git(["add", "--", cfg["manifest"], ".gitignore"], root)
    git(["commit", "-q", "-m", "baselines: move %d images to S3, keep the list of hashes in git" % len(entries)], root)
    res.update(commit=git(["rev-parse", "HEAD"], root).stdout.strip(), images_tracked=0,
               next="done; commit factory.json if it changed, and push this repository so the team gets the list")
    return res


def storage_shared_with(ctx, cfg):
    """Other factory repositories on this machine at the same place on S3: each project has its own."""
    st = cfg["store"]
    here = (st["endpoint"], st["bucket"], st["prefix"])
    try:
        known = json.loads(read(os.path.join(state_dir(), "factories.json"), "[]") or "[]")
    except ValueError:
        return []
    shared = []
    for other in known:
        if os.path.realpath(other) == os.path.realpath(ctx.factory):
            continue
        try:
            o = (json.loads(read(os.path.join(other, CONFIG_NAME), "{}") or "{}").get("storage")) or {}
        except ValueError:
            continue
        there = ((o.get("endpoint") or "").rstrip("/"), o.get("bucket"), (o.get("prefix") or "").strip("/"))
        if there == here:
            shared.append(other)
    return shared


def baselines_doctor(ctx, add):
    """fx doctor's checks for baselines: settings, keys, read access, and that S3 has everything the list names."""
    try:
        cfg = baselines_config(ctx)
    except FxError as e:
        add("baselines settings", False, str(e))
        return
    if not cfg:
        lost = baselines_lost_list(ctx)
        if lost:
            add("baselines settings", False, baselines_settings_lost_text(lost))
        return
    place = "/".join(x for x in (cfg["store"]["bucket"], cfg["store"]["prefix"], cfg["folder"]) if x)
    add("baselines settings", True, "%s: %s, list %s, s3://%s" % (
        cfg["repo_name"] if cfg["repo_name"] and len(ctx.repos) > 1 else cfg["repo"], cfg["dir"], cfg["manifest"], place))
    shared = storage_shared_with(ctx, cfg)
    add("storage is this project's own", not shared, "the same bucket and prefix as %s: give each project its own"
        % ", ".join(shared[:3]) if shared else "")
    for mode, need in (("read", True), ("write", False)):
        path = baselines_key_file(ctx, mode)
        try:
            baselines_keys(ctx, cfg, mode)
            add("storage %s key" % mode, True, path if os.path.exists(path) else "AWS profile")
        except StoreError as e:
            add("storage %s key%s" % (mode, "" if need else " (advice: only uploads need it)"), not need, str(e))
        if os.path.exists(path):
            loose = os.stat(path).st_mode & 0o077
            old = path == baselines_old_key_file(ctx, mode)
            ignored = not old or git(["check-ignore", "-q", path], ctx.factory, check=False).returncode == 0
            add("storage %s key file private" % mode, not loose and ignored,
                "" if not loose and ignored else "chmod 600 %s, and keep local/ in .gitignore" % path)
    old = [f for f in (baselines_old_key_file(ctx, m) for m in ("read", "write")) if os.path.exists(f)]
    if old:
        where = baselines_key_dir(ctx)
        add("storage keys outside the factory repository (advice)", True,
            "project code can find %s from FACTORY_BASELINES. Move them: mkdir -p -m 700 %s && mv %s %s/ && chmod 600 %s/s3-*.env"
            % (", ".join(old), shlex.quote(where), " ".join(shlex.quote(f) for f in old), shlex.quote(where), shlex.quote(where)))
    root = ctx.factory if cfg["repo"] == "factory" else ctx.code(cfg["repo_name"])
    if not root:
        add("baselines list", False, "the project could not be read")
        return
    if cfg["repo"] == "factory":
        ignored = git(["check-ignore", "-q", cfg["dir"] + "/x"], root, check=False).returncode == 0
        add("baselines folder git-ignored", ignored,
            "" if ignored else "add %s/ to .gitignore (fx baselines migrate does)" % cfg["dir"])
        tracked = len(git(["ls-files", "--", cfg["dir"]], root, check=False).stdout.splitlines())
        add("baselines images out of git", tracked == 0,
            "%d still tracked: fx baselines migrate --commit" % tracked if tracked else "")
    try:
        current = baselines_read(cfg, root)
    except FxError as e:
        add("baselines list", False, str(e))
        return
    add("baselines list", current is not None, "%d images" % len(current) if current is not None
        else "no %s: fx baselines record or migrate" % cfg["manifest"])
    if current is None:
        return
    try:
        store = baselines_store(ctx, cfg, "read")
        store.head("0" * 64)
        add("baselines store readable", True, "")
    except StoreError as e:
        add("baselines store readable", False, str(e))
        return
    committed = baselines_at(cfg, root, "HEAD") or {}
    every = {}
    for src in (committed, current):
        for rel, e in src.items():
            every.setdefault(e["sha256"], rel)
    try:
        sizes = baselines_heads(store, every)
    except StoreError as e:
        add("baselines images on S3", False, str(e))
        return
    gone = {sha for sha, size in sizes.items() if size is None}
    bad = sorted(r for r, e in committed.items() if e["sha256"] in gone)
    add("baselines images on S3", not bad, "the committed list names %d image(s) S3 does not have: fx baselines push: %s"
        % (len(bad), ", ".join(bad[:10])) if bad else "%d images checked" % len(every))
    pending = sorted(r for r, e in current.items() if e["sha256"] in gone and r not in bad)
    if pending:
        add("baselines recorded, not uploaded yet (advice)", True,
            "fx baselines push before committing: %s" % ", ".join(pending[:10]))
    if cfg["repo"] == "factory":
        st = baselines_remote_state(root)
        add("baselines repository up to date (advice)", True, {
            "unreachable": "could not check: %s" % st.get("error"),
            "no-upstream": "no remote branch to compare with"}.get(
                st["state"], "%d behind, %d ahead" % (st["behind"], st["ahead"])))


def baselines_at_job_start(ctx, cfg, pre):
    """Fill in what is missing. Trouble is not fatal yet (the gate fails if it lasts), and files that differ stay: in
    the factory repository's shared folder they may be another job's work."""
    warnings = list((pre or {}).get("warnings") or []) + list(getattr(ctx, "baselines_warnings", []))
    fetched = 0
    if cfg["repo"] == "factory" and not baselines_not_migrated(cfg, ctx.factory):
        try:
            sync = baselines_sync_folder(ctx, cfg, ctx.factory, None, restore=False)
            fetched = len(sync["fetched"])
            if sync["failed"]:
                warnings.append(baselines_failure_text(sync))
            if sync["untouched"]:
                warnings.append("%d baseline file(s) differ from the list; the gate will restore them"
                                % len(sync["untouched"]))
        except FxError as e:
            warnings.append(str(e))
    return {"fetched": fetched, "pulled": (pre or {}).get("pulled"), "warnings": warnings}


def baselines_env(ctx, worktree, repo=None):
    """Tells project commands where the folder is, wherever it lives. Paths only: keys never go in an environment. A
    clone of a repository that does not hold the list (baselines.repo) gets nothing."""
    cfg = baselines_config(ctx)
    if not cfg:
        return {}
    repo = repo or getattr(ctx, "scope", None)
    if cfg["repo"] == "project" and repo and cfg["repo_name"] and repo != cfg["repo_name"]:
        return {}
    return {"FACTORY_BASELINES": os.path.join(ctx.factory if cfg["repo"] == "factory" else worktree, cfg["dir"])}


def baselines_candidate_problem(ctx, job, per):
    """Before a candidate's checks (per: its entry of each repository); the reason goes in its log, as a failing checks
    script would."""
    cfg = baselines_config(ctx)
    if not cfg:
        return ""
    view = baselines_job(ctx, cfg, job)
    if view is None:
        return ""
    c = per.get(view.get("repo")) or next(iter(per.values()))
    ok, why = baselines_for_checks(ctx, cfg, job, c["worktree"] if cfg["repo"] == "project" else None)
    if not ok:
        write_atomic(os.path.join(ctx.job_dir(job["id"]), "checks-c%d.log" % c["k"]), why + "\n")
    return "" if ok else why


def baselines_static_profile(profile):
    path = os.path.expanduser(os.environ.get("AWS_SHARED_CREDENTIALS_FILE") or "~/.aws/credentials")
    parser = configparser.RawConfigParser()
    try:
        parser.read(path)
    except (configparser.Error, UnicodeError, OSError):
        return None
    if parser.has_section(profile) and parser.has_option(profile, "aws_access_key_id") \
            and parser.has_option(profile, "aws_secret_access_key"):
        return {"id": parser.get(profile, "aws_access_key_id"), "secret": parser.get(profile, "aws_secret_access_key"),
                "token": parser.get(profile, "aws_session_token", fallback="")}
    return None


def baselines_needs_aws_cli(ctx, cfg):
    """fx talks to S3 itself; only a profile without static keys (SSO, roles) needs the AWS CLI for its keys."""
    return any(cfg["store"]["%s_profile" % m.replace("-", "_")] and not os.path.exists(baselines_key_file(ctx, m))
               and not baselines_static_profile(cfg["store"]["%s_profile" % m.replace("-", "_")])
               for m in ("read", "write", "jobs-write"))


# --------------------------------------------------------------------------
# jobs on S3, the storage's second part: each job's folder, to get it back on another machine. Files are there by hash,
# and each push adds a snapshot that lists them. Written last, so a snapshot that exists has all its files. fx never
# deletes anything on S3.

JOBS_DEFAULT_EXCLUDE = ["_audits/*/sandbox/", "**/node_modules/", "**/vendor/", "**/composer-cache/"]
JOBS_ALWAYS_EXCLUDE = ["_audits/*/sandbox/"]  # a copy of the project's code and its libraries' caches
JOBS_SNAPSHOT_VERSION = 1
JOBS_NAME_RE = re.compile(r"^(?:_learn|_audits/[A-Za-z0-9][A-Za-z0-9._-]*|[A-Za-z0-9][A-Za-z0-9._-]*)$")
JOBS_SNAPSHOT_RE = re.compile(r"^(\d{8}T\d{6}Z)-([0-9a-f]{8})\.json$")
JOBS_SNAPSHOT_MAX = 64 * 1024 * 1024
# What gitleaks' default rules let through, looked for here and not in a gitleaks config, which
# security.gitleaks_config may replace.
JOBS_EXTRA_SECRETS = [
    ("laravel-app-key", re.compile(rb"APP_KEY\s*[=:]\s*[\"']?base64:[A-Za-z0-9+/]{40,}={0,2}")),
    ("sanctum-token", re.compile(rb"\b\d{1,10}\|[A-Za-z0-9]{40,}\b")),
]
JOBS_ARCHIVE_DEPTH = 3  # how many levels of archives inside archives are looked into
JOBS_ARCHIVE_MAX_BYTES = 512 * 1024 * 1024  # unpacked: beyond this, a zip bomb among others, fx cannot read it
JOBS_ARCHIVE_UNREADABLE = "an archive fx cannot read"
JOBS_ZIP_EXTS = (".zip", ".jar", ".war")
JOBS_TAR_EXTS = (".tar", ".tgz", ".tbz", ".tbz2", ".txz", ".tar.gz", ".tar.bz2", ".tar.xz")
JOBS_ARCHIVE_EXTS = JOBS_ZIP_EXTS + JOBS_TAR_EXTS + (".gz", ".bz2", ".xz", ".7z", ".rar", ".zst", ".lz4", ".br")


def jobs_store_config(ctx):
    """The `jobs_store` and `storage` blocks of factory.json, checked; None when this factory keeps no jobs on S3."""
    b = ctx.c("jobs_store") if ctx and getattr(ctx, "cfg", None) else None
    if b is None:  # an empty block is every default
        return None
    if not isinstance(b, dict):
        raise FxError("jobs_store in factory.json must be an object", code=3)
    problems = []
    store = storage_config(ctx, problems)
    folder = str(b.get("folder") or "jobs").strip("/")
    if baselines_safe_rel(folder):
        problems.append("jobs_store.folder: %r (%s)" % (folder, baselines_safe_rel(folder)))
    if ctx.c("baselines") and folder == str(ctx.c("baselines.folder") or "baselines").strip("/"):
        problems.append("jobs_store.folder %r is the baselines' folder in the storage" % folder)
    for key in ("auto", "include_audits"):  # a string "false" must not read as yes: audits describe open holes
        if key in b and not isinstance(b[key], bool):
            problems.append("jobs_store.%s must be true or false, not %r" % (key, b[key]))
    exclude = b.get("exclude", JOBS_DEFAULT_EXCLUDE)
    if not isinstance(exclude, list) or not all(isinstance(p, str) and p for p in exclude):
        problems.append("jobs_store.exclude must be a list of paths")
        exclude = []
    mb = b.get("max_file_mb", 50)
    if isinstance(mb, bool) or not isinstance(mb, (int, float)) or mb <= 0:
        problems.append("jobs_store.max_file_mb must be a number above 0, not %r" % (mb,))
        mb = 0
    if problems:
        raise FxError("factory.json: " + "; ".join(problems), code=3)
    return {"store": store, "folder": folder, "auto": b.get("auto", True), "include_audits": b.get("include_audits", False),
            "exclude": JOBS_ALWAYS_EXCLUDE + [p for p in exclude if p not in JOBS_ALWAYS_EXCLUDE],
            "max_mb": mb, "max_bytes": int(mb * 1024 * 1024)}


def jobs_write_mode(ctx, cfg):
    """The key that uploads jobs: its own when this machine has one, else the shared write key. Every machine that runs
    jobs needs it, and code running in a job could overwrite the reference images with the shared one: If-None-Match is
    only the client's word."""
    own = os.path.exists(baselines_key_file(ctx, "jobs-write")) or cfg["store"]["jobs_write_profile"]
    return "jobs-write" if own else "write"


def jobs_stores(ctx, cfg, write=True):
    """(reader, writer). What is on S3 is read with the read key: the jobs' own write key may only write. A machine with
    a write key alone tries with that, and S3 says what it allows."""
    writer = baselines_store(ctx, cfg, jobs_write_mode(ctx, cfg)) if write else None
    if read(baselines_key_file(ctx, "read")) is not None or cfg["store"]["read_profile"] or not write:
        return baselines_store(ctx, cfg, "read"), writer
    return writer, writer


def jobs_names_here(ctx, cfg):
    """The folders of jobs/ that go to S3: every job, _learn, and the audits when they are turned on."""
    names = [i for i in ctx.list_ids() if JOBS_NAME_RE.match(i) and not i.startswith(("_", "."))]
    if os.path.isdir(learn_dir(ctx)):
        names.append("_learn")
    audits = os.path.join(ctx.jobs, "_audits")
    if cfg["include_audits"] and os.path.isdir(audits):
        names += ["_audits/" + d for d in sorted(os.listdir(audits))
                  if os.path.isdir(os.path.join(audits, d)) and JOBS_NAME_RE.match("_audits/" + d)]
    return names


def jobs_pick_here(ctx, cfg, a):
    if a.all and a.names:
        raise FxError("name jobs or use --all, not both", code=3)
    if a.all or not a.names:
        return jobs_names_here(ctx, cfg)
    picked = []
    for ref in a.names:
        refuse_review(ref, "it never pushes or pulls them", jobs=ctx.jobs)
        if ref == "_learn" or ref.startswith("_audits/"):
            if ref != "_learn" and not cfg["include_audits"]:
                raise FxError("jobs_store.include_audits is off, so audit reports stay on this machine: they describe "
                              "holes that are not fixed yet", code=3)
            if not JOBS_NAME_RE.match(ref) or not os.path.isdir(os.path.join(ctx.jobs, ref)):
                raise FxError("no folder jobs/%s" % ref, code=3)
            picked.append(ref)
        else:
            picked.append(ctx.resolve(ref))
    return list(dict.fromkeys(picked))


def jobs_left_out(rel, patterns):
    """Whether jobs_store.exclude names this path under jobs/, a folder's with a slash at its end."""
    return any(p.endswith("/") == rel.endswith("/") and path_glob(rel, p) for p in patterns)


def jobs_folder_files(ctx, cfg, name):
    """{path: its name on disk} of what a push takes from this folder, and [{path, reason}] of what it leaves there."""
    folder = os.path.join(ctx.jobs, name)
    skipped, real, files = [], {}, {}

    def prune(rel):
        if jobs_left_out("%s/%s/" % (name, rel), cfg["exclude"]):
            skipped.append({"path": rel + "/", "reason": "excluded"})
            return True
        return False

    names, links = baselines_scan(folder, real=real, prune=prune)
    skipped += [{"path": rel, "reason": "symlink"} for rel in links]
    for rel in names:
        if os.path.basename(rel).startswith(".tmp-"):
            continue  # fx writing a file right now
        if jobs_left_out("%s/%s" % (name, rel), cfg["exclude"]):
            skipped.append({"path": rel, "reason": "excluded"})
        elif baselines_safe_rel(rel):
            skipped.append({"path": rel.encode("ascii", "backslashreplace").decode(), "reason": "a name fx would not restore"})
        else:
            try:
                size = os.path.getsize(os.path.join(folder, real[rel]))
            except OSError:
                continue  # gone since the folder was listed
            if size > cfg["max_bytes"]:
                skipped.append({"path": rel, "reason": "larger than %g MB" % cfg["max_mb"]})
            else:
                files[rel] = real[rel]
    return files, sorted(skipped, key=lambda x: x["path"])


def jobs_scan_copy(data):
    """job.json as gitleaks should read it. logic_base pairs file names such as api-key-rotation.md with git hashes,
    which it always takes for a key, so it goes when that is all it holds. Without job.json there is nothing to restore."""
    job = json.loads(data.decode("utf-8", "surrogateescape"))

    def only_names(holder):
        base = holder.get("logic_base") if isinstance(holder, dict) else None
        if isinstance(base, dict) and all(re.fullmatch(r"[\w./-]+\.md", k) and (v is None or re.fullmatch(
                r"[0-9a-f]{40}", str(v))) for k, v in base.items()):
            holder = dict(holder)
            del holder["logic_base"]
        return holder
    job = only_names(job)
    if isinstance(job, dict) and isinstance(job.get("repos"), dict):  # each repository keeps its own
        job = dict(job, repos={n: only_names(e) for n, e in job["repos"].items()})
    return json.dumps(job, ensure_ascii=False, indent=2).encode("utf-8", "backslashreplace")


def jobs_unpack(name, data, budget):
    """[(name, bytes)] of one level of an archive, from memory. Raises when fx cannot read all of it: damaged, with a
    password, of a format it has no module for, or larger unpacked than the budget left."""
    found = []

    def take(member, size, read_):
        budget[0] -= size
        if budget[0] < 0:
            raise ValueError("too large unpacked")
        found.append((member, read_()))

    low = name.lower()
    if low.endswith(JOBS_ZIP_EXTS):
        with zipfile.ZipFile(io.BytesIO(data)) as z:
            for info in z.infolist():
                if info.flag_bits & 1:
                    raise ValueError("a password")
                if not info.is_dir():
                    take(info.filename, info.file_size, lambda: z.read(info))
    elif low.endswith(JOBS_TAR_EXTS):
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as t:
            for m in t:
                if m.isfile():
                    take(m.name, m.size, lambda: t.extractfile(m).read())
    elif low.endswith(".gz"):
        import gzip
        with gzip.GzipFile(fileobj=io.BytesIO(data)) as g:
            whole = g.read(budget[0] + 1)
        take(name[:-3], len(whole), lambda: whole)
    else:
        raise ValueError("no module for this format")
    return found


def jobs_archive_files(name, data, depth=JOBS_ARCHIVE_DEPTH, budget=None):
    """The bytes of every file in an archive, as many levels down as gitleaks is told to open."""
    budget = [JOBS_ARCHIVE_MAX_BYTES] if budget is None else budget
    for member, part in jobs_unpack(name, data, budget):
        yield part
        if depth > 1 and member.lower().endswith(JOBS_ARCHIVE_EXTS):
            yield from jobs_archive_files(member, part, depth - 1, budget)


def jobs_own_finding(data, values):
    """The rule of what fx looks for itself: the values of this machine's secrets, and what gitleaks has no rule for."""
    if any(v in data for v in values):
        return "local-secret"
    return next((rule for rule, rx in JOBS_EXTRA_SECRETS if rx.search(data)), None)


def jobs_scan_archives(blobs, values):
    """{path: reason} from the archives among these files, before gitleaks sees them. It says nothing of a damaged archive,
    so nobody would know that it was not scanned. Those stay here, and what gitleaks has no rule for is looked for inside
    the others."""
    found = {}
    for rel, data in blobs.items():
        if rel.lower().endswith(JOBS_ARCHIVE_EXTS):
            try:
                for part in jobs_archive_files(rel, data):
                    rule = jobs_own_finding(part, values)
                    if rule:
                        found.setdefault(rel, "secret: %s" % rule)
            except Exception:  # noqa: BLE001 - whatever a decompressor raises: fx could not read it
                found[rel] = JOBS_ARCHIVE_UNREADABLE
    return found


def jobs_report_files(file_, tmp, root, blobs):
    """The files a line of gitleaks' report is about. Inside an archive it names the archive and what is in it, with !
    between them: trace.zip!resources/network.log. A file's own name can hold a ! too, so the whole path comes first, and
    what comes after a ! is an archive's own word, never a path to work out."""
    head, bang, tail = str(file_ or "").partition("!")
    full = os.path.normpath(os.path.join(tmp, head)) + bang + tail
    for base in (root, os.path.realpath(root)):
        if full.startswith(base + os.sep):
            inside = unicodedata.normalize("NFC", full[len(base) + 1:].replace(os.sep, "/"))
            if inside in blobs:
                return [inside]
            parts = inside.split("!")
            return [p for p in ("!".join(parts[:i]) for i in range(1, len(parts))) if p in blobs]
    return []


def jobs_secret_scan(ctx, blobs):
    """{path: reason} of the files that must stay on this machine: what gitleaks finds with fx's own rules, inside archives
    too, this machine's secrets (the local env files, the S3 keys, the Jira token), JOBS_EXTRA_SECRETS, and archives fx
    cannot read. It reads a copy of the very bytes that would go, in a folder of fx's own, one level below what it scans:
    a .gitleaks.toml or .gitleaksignore among a job's files is one more file there, and tunes nothing. Of a finding only
    the file and the rule's name leave this function."""
    if not shutil.which("gitleaks"):
        raise FxError("gitleaks is not on this machine, and nothing goes to S3 unscanned: /code-factory:factory install", code=3)
    flags, err = gitleaks_flags(ctx)
    if err:
        raise FxError(err, code=3)
    values = [v.encode("utf-8", "surrogateescape") for v in local_secret_values(ctx)]
    leaks = jobs_scan_archives(blobs, values)
    tmp = tempfile.mkdtemp(prefix="fx-jobs-scan-")
    try:
        root = os.path.join(tmp, "scan", "job")
        for rel, data in blobs.items():
            if leaks.get(rel) == JOBS_ARCHIVE_UNREADABLE:
                continue
            path = os.path.join(root, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "wb") as f:
                f.write(data)
        empty, rpt = os.path.join(tmp, "empty"), os.path.join(tmp, "report.json")
        os.mkdir(empty)
        flags += ["--gitleaks-ignore-path", empty, "--max-archive-depth", str(JOBS_ARCHIVE_DEPTH)]
        common = ["--report-format", "json", "--report-path", rpt, "--no-banner", "--exit-code", "0"] + flags
        try:
            r = run(["gitleaks", "dir", "scan"] + common, cwd=tmp, env=project_env(ctx), check=False,
                    timeout=GITLEAKS_TIMEOUT_SEC)
            if r.returncode != 0 and "unknown command" in (r.stdout or "").lower():
                r = run(["gitleaks", "detect", "--no-git", "--source", "scan"] + common, cwd=tmp, env=project_env(ctx),
                        check=False, timeout=GITLEAKS_TIMEOUT_SEC)
        except subprocess.TimeoutExpired:
            raise FxError("gitleaks did not finish, and nothing goes to S3 unscanned", code=3)
        if r.returncode != 0 and "max-archive-depth" in (r.stdout or ""):
            raise FxError("this gitleaks cannot look inside archives (--max-archive-depth), and nothing goes to S3 unscanned: "
                          "upgrade it with /code-factory:factory install", code=3)
        if r.returncode != 0 or not os.path.exists(rpt):
            raise FxError("gitleaks failed (exit %s), and nothing goes to S3 unscanned" % r.returncode, code=3)
        try:
            report = json.loads(read(rpt, "[]") or "[]")
        except ValueError:
            raise FxError("gitleaks' report cannot be read, and nothing goes to S3 unscanned", code=3)
        for f in report or []:
            named = jobs_report_files(f.get("File"), tmp, root, blobs)
            if not named:
                raise FxError("gitleaks named a file fx did not give it, and nothing goes to S3 unscanned", code=3)
            for rel in named:
                leaks.setdefault(rel, "secret: %s" % (f.get("RuleID") or "secret"))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    for rel, data in blobs.items():
        rule = jobs_own_finding(data, values) if rel not in leaks else None
        if rule:
            leaks[rel] = "secret: %s" % rule
    return leaks


def jobs_record_path(cfg, name):
    """This machine's note of the last push of a folder, one file each so two fx pr at once lose nothing."""
    st = cfg["store"]
    place = "%s|%s|%s|%s" % (st["endpoint"], st["bucket"], st["prefix"], cfg["folder"])
    return os.path.join(state_dir(), "jobs-store", hashlib.sha256(place.encode()).hexdigest()[:16],
                        urllib.parse.quote(name, safe="") + ".json")


def jobs_read_record(cfg, name):
    try:
        data = json.loads(read(jobs_record_path(cfg, name), "null") or "null")
    except ValueError:
        return None
    return data if isinstance(data, dict) and isinstance(data.get("files"), dict) else None


def jobs_write_record(cfg, name, snapshot, files, skipped):
    write_atomic(jobs_record_path(cfg, name), json.dumps({"job": name, "snapshot": snapshot, "at": now(), "files": files,
                                                          "skipped": skipped}, indent=1, sort_keys=True) + "\n")


def jobs_held_back(skipped):
    """What a push left on this machine without anyone choosing to: what jobs_store.exclude names is the user's own choice."""
    return [x for x in skipped if isinstance(x, dict) and x.get("reason") != "excluded"]


def jobs_held_rows(rows):
    """The held_back of many jobs as one list, each with its job."""
    return [dict(x, job=r["job"]) for r in rows for x in r.get("held_back") or []]


def jobs_held_text(held):
    """Paths and reasons, for a line of text. A reason is a rule's name, never a value."""
    shown = ", ".join("%s/%s (%s)" % (x["job"], x.get("path"), x.get("reason")) for x in held[:10])
    return "%d file(s) stay on this machine and are not on S3: %s%s" % (len(held), shown, ", ..." if len(held) > 10 else "")


def jobs_local_state(ctx, cfg, name):
    """Whether the folder still is what the last push left: saved, changed or not-saved. Asks S3 nothing. A file with its
    size and time unchanged is not read again."""
    folder = os.path.join(ctx.jobs, name)
    files, skipped = jobs_folder_files(ctx, cfg, name)
    row = {"job": name, "state": "not-saved", "files": len(files), "skipped": len(skipped), "held_back": None}
    record = jobs_read_record(cfg, name)
    if not record:
        return row
    changed = []
    for rel, disk in files.items():
        known, path = record["files"].get(rel), os.path.join(folder, disk)
        try:
            st = os.stat(path)
            if not known or ((known.get("size"), known.get("mtime_ns")) != (st.st_size, st.st_mtime_ns)
                             and file_sha256(path) != known.get("sha256")):
                changed.append(rel)
        except OSError:
            changed.append(rel)
    changed += [rel for rel in record["files"] if rel not in files]
    row.update(state="changed" if changed else "saved", snapshot=record.get("snapshot"), saved_at=record.get("at"))
    # From the note: only the push's scan knows them. None: a note of an older version, which did not keep them.
    if isinstance(record.get("skipped"), list):
        row.update(skipped=len(record["skipped"]), held_back=jobs_held_back(record["skipped"]))
    if changed:
        row["changed"] = sorted(changed)[:20]
    return row


def jobs_board_state(factory, raw):
    """For the board, which reads every factory on this machine from its files: a function giving a job's state, or None
    when that factory keeps no jobs on S3."""
    view = Ctx.__new__(Ctx)
    view.factory, view.jobs, view.cfg = factory, os.path.join(factory, "jobs"), raw
    view.repos, view.repo_problems = config_repos(raw)
    try:
        cfg = jobs_store_config(view)
    except FxError:
        return None
    return (lambda job_id: jobs_local_state(view, cfg, job_id)) if cfg else None


def jobs_after_step(ctx, res, names=None):
    """fx pr and fx audit-import end with a push when jobs_store.auto is on. Nothing here can fail the step: the job is
    done whatever S3 says, so a problem is a note and a warning, like Jira's, and fx jobs status keeps showing it."""
    problems, held = [], []
    try:
        cfg = jobs_store_config(ctx)
        if not cfg or not cfg["auto"]:
            return
        here = jobs_names_here(ctx, cfg)
        names = [n for n in here if n.startswith("_audits/")] if names is None else \
            list(names) + ([n for n in here if n == "_learn"])
        if not names:
            return
        rows, failed = jobs_push_many(ctx, cfg, names)
        problems = ["%s: %s" % (f["job"], f["error"]) for f in failed]
        res["jobs_store"] = {"pushed": [r["job"] for r in rows if r["state"] == "pushed"],
                             "failed": [f["job"] for f in failed]}
        held = jobs_held_rows(rows)
        if held:
            res["jobs_store"]["held_back"] = held
    except Exception as e:  # noqa: BLE001 - never a reason to fail a step that is done
        problems = [str(e)]
    lines = ["jobs store: %s. fx jobs push tries again" % p for p in problems]
    if held:
        lines.append("jobs store: %s. Tell the user, who decides what to do with them" % jobs_held_text(held))
    for text in lines:
        res.setdefault("notes", []).append(text)
        res.setdefault("warnings", []).append(text)


JOBS_NOT_KEPT = ("S3 is set up but jobs are not kept there: add jobs_store with /code-factory:factory init, or remove storage from "
                 "factory.json")


def jobs_store_doctor(ctx, add):
    """fx doctor's checks for the jobs store: settings, keys, read access and its own place. A job not saved is advice.
    With S3 (a storage block), jobs always go there: storage without jobs_store fails."""
    try:
        cfg = jobs_store_config(ctx)
    except FxError as e:
        add("jobs store settings", False, str(e))
        return
    if not cfg:
        if ctx.c("storage"):
            add("jobs store settings", False, JOBS_NOT_KEPT)
        return
    st = cfg["store"]
    place = "/".join(x for x in (st["bucket"], st["prefix"], cfg["folder"]) if x)
    add("jobs store settings", True, "s3://%s, auto %s, audits %s" % (place, "on" if cfg["auto"] else "off",
                                                                     "on" if cfg["include_audits"] else "off"))
    shared = storage_shared_with(ctx, cfg)
    add("jobs store is this project's own", not shared, "the same bucket and prefix as %s: give each project its own"
        % ", ".join(shared[:3]) if shared else "")
    write_mode = jobs_write_mode(ctx, cfg)
    for mode, need in (("read", True), (write_mode, cfg["auto"])):
        path = baselines_key_file(ctx, mode)
        label = "jobs store %s key" % mode
        try:
            baselines_keys(ctx, cfg, mode)
            add(label, True, path if os.path.exists(path) else "AWS profile")
        except StoreError as e:
            add(label + ("" if need else " (advice: only pushes need it)"), not need, str(e))
        if os.path.exists(path):
            loose = os.stat(path).st_mode & 0o077
            add(label + " file private", not loose, "chmod 600 %s" % path if loose else "")
    if write_mode == "write":
        add("jobs store has its own write key (advice)", True, "with the shared key, code running in a job could overwrite "
            "the reference images: put s3-jobs-write.env in %s, or name storage.jobs_write_profile, with s3:PutObject only "
            "on %s/*" % (baselines_key_dir(ctx), place))
    gitleaks = bool(shutil.which("gitleaks"))
    add("jobs store scans with gitleaks", gitleaks, "" if gitleaks else "nothing goes to S3 unscanned: /code-factory:factory install")
    try:
        baselines_store(ctx, cfg, "read").list("snapshots/", limit=1)
        add("jobs store readable", True, "")
    except StoreError as e:
        add("jobs store readable", False, str(e))
    rows = [jobs_local_state(ctx, cfg, n) for n in jobs_names_here(ctx, cfg)]
    unsaved = [r["job"] for r in rows if r["state"] != "saved"]
    if unsaved:
        add("jobs saved on S3 (advice)", True, "not yet, or changed since: %s. fx jobs push" % ", ".join(unsaved[:10]))
    held = jobs_held_rows(rows)
    if held:
        add("jobs store files held back (advice)", True, jobs_held_text(held))
    unknown = [r["job"] for r in rows if r["state"] == "saved" and r["held_back"] is None]
    if unknown:
        add("jobs store notes of an older fx (advice)", True, "not known which files of %s stayed on this machine: fx jobs "
            "push finds out and uploads nothing" % ", ".join(unknown[:10]))


def jobs_ids_on_s3(ctx, warnings):
    """The jobs on S3, for numbering a new local task. When S3 cannot say, a warning, and fx jobs push still refuses a
    number another job has taken."""
    try:
        cfg = jobs_store_config(ctx)
        return sorted(jobs_snapshots(baselines_store(ctx, cfg, "read"))) if cfg else []
    except (StoreError, FxError) as e:
        warnings.append("could not ask the jobs store which LOCAL numbers are taken, so this one comes from this machine "
                        "alone: %s" % e)
        return []


def jobs_snapshots(store, name=None):
    """{job: [snapshot file, oldest first]} from a listing, which names every snapshot and reads none."""
    start = "snapshots/%s" % (name + "/" if name else "")
    found = {}
    for item in store.list(start):
        job, _, file_ = item["name"][len("snapshots/"):].rpartition("/")
        if JOBS_NAME_RE.match(job) and JOBS_SNAPSHOT_RE.match(file_):
            found.setdefault(job, []).append(file_)
    return {j: sorted(rows) for j, rows in found.items()}


def jobs_read_snapshot(store, name, file_):
    """One snapshot as it is on S3. Anything fx could not have written is an integrity error: it is only data."""
    r = store.open_named("snapshots/%s/%s" % (name, file_))
    if r is None:
        raise StoreError("server", "the snapshot %s of %s is not on S3" % (file_, name))
    try:
        data = r.read(JOBS_SNAPSHOT_MAX + 1)
    except (OSError, http.client.HTTPException) as e:
        raise StoreError("network", "the download broke off: %s" % e)
    finally:
        r.close()
    try:
        snap = json.loads(data.decode("utf-8", "surrogateescape"))
    except ValueError:
        snap = None
    if len(data) > JOBS_SNAPSHOT_MAX or not isinstance(snap, dict):
        raise StoreError("integrity", "the snapshot %s of %s is not one fx wrote" % (file_, name))
    return snap


def jobs_fingerprint(files, skipped):
    return hashlib.sha256(json.dumps({"files": files, "skipped": skipped}, sort_keys=True).encode()).hexdigest()


def jobs_stamp_after(latest):
    """Now, in the form of a snapshot's name, and later than the newest one, whatever another machine's clock said."""
    t = _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0)
    m = JOBS_SNAPSHOT_RE.match(latest or "")
    if m:
        last = _dt.datetime.strptime(m.group(1), "%Y%m%dT%H%M%SZ").replace(tzinfo=_dt.timezone.utc)
        t = max(t, last + _dt.timedelta(seconds=1))
    return t.strftime("%Y%m%dT%H%M%SZ")


def jobs_push_one(ctx, cfg, name, stores, dry_run=False):
    """Scan, upload what S3 lacks, then write the snapshot. Each file is read once, and those bytes are what is scanned,
    hashed and uploaded."""
    folder = os.path.join(ctx.jobs, name)
    paths, skipped = jobs_folder_files(ctx, cfg, name)
    blobs, seen = {}, {}
    for rel, disk in paths.items():
        path = os.path.join(folder, disk)
        try:
            st = os.stat(path)
            with open(path, "rb") as f:
                blobs[rel] = f.read()
        except FileNotFoundError:
            continue
        except OSError as e:
            skipped.append({"path": rel, "reason": "cannot be read: %s" % e.strerror})
            continue
        seen[rel] = {"sha256": hashlib.sha256(blobs[rel]).hexdigest(), "size": st.st_size, "mtime_ns": st.st_mtime_ns}
    job = {}
    scanned = blobs
    if not name.startswith("_"):
        try:
            job = json.loads(blobs["job.json"].decode("utf-8", "surrogateescape"))
            job = job_flat_copy(job, ctx.repo_names()[0] if ctx.repos else None) if isinstance(job, dict) else job
            scanned = dict(blobs, **{"job.json": jobs_scan_copy(blobs["job.json"])})
        except (KeyError, ValueError):
            raise FxError("%s: job.json cannot be read, and without it the job cannot be restored" % name, code=3)
    leaks = jobs_secret_scan(ctx, scanned)
    if "job.json" in leaks:
        raise FxError("%s: job.json has what looks like a secret (%s), and without it the job cannot be restored: nothing "
                      "of this job was pushed" % (name, leaks["job.json"]), code=3)
    skipped += [{"path": rel, "reason": why} for rel, why in leaks.items()]
    skipped.sort(key=lambda x: x["path"])
    files = [{"path": rel, "sha256": seen[rel]["sha256"], "size": len(blobs[rel])} for rel in sorted(blobs) if rel not in leaks]
    reader, writer = stores()
    existing = jobs_snapshots(reader, name).get(name) or []
    latest = existing[-1] if existing else None
    same, note = False, None
    if latest:
        try:
            prev = jobs_read_snapshot(reader, name, latest)
        except StoreError as e:
            if e.kind != "integrity":
                raise
            note = "the newest snapshot cannot be read, so a new one goes on top: %s" % e
        else:
            if prev.get("created_at") and job.get("created_at") and prev["created_at"] != job["created_at"]:
                raise FxError("%s on S3 is another job, created %s (this one %s). Two machines gave it the same number. "
                              "Nothing was pushed: S3 keeps that job, and this one stays here unsaved."
                              % (name, prev["created_at"], job["created_at"]), code=3)
            same = jobs_fingerprint(prev.get("files"), prev.get("skipped")) == jobs_fingerprint(files, skipped)
    row = {"job": name, "files": len(files), "bytes": sum(f["size"] for f in files), "skipped": skipped,
           "held_back": jobs_held_back(skipped)}
    if note:
        row["note"] = note
    if same:
        if not dry_run:
            jobs_write_record(cfg, name, latest, seen, skipped)
        return dict(row, state="unchanged", snapshot=latest, uploaded=0)
    by_sha = {f["sha256"]: blobs[f["path"]] for f in files}
    sizes = baselines_heads(reader, by_sha)
    for sha, size in sizes.items():
        if size is not None and size != len(by_sha[sha]):
            raise StoreError("integrity", "S3 has %d bytes for %s…, this file has %d; not overwritten"
                             % (size, sha[:12], len(by_sha[sha])))
    missing = [sha for sha, size in sizes.items() if size is None]
    if dry_run:
        return dict(row, state="would-push", to_upload=len(missing),
                    bytes_to_upload=sum(len(by_sha[sha]) for sha in missing))
    with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
        list(pool.map(lambda sha: writer.put(sha, by_sha[sha]), missing))
    snap = {"version": JOBS_SNAPSHOT_VERSION, "job": name, "created_at": job.get("created_at"), "saved_at": now(),
            "fx_version": VERSION, "stage": job.get("stage"), "summary": job.get("summary"), "pr_url": job.get("pr_url"),
            "factory_root": ctx.factory, "work_root": ctx.work, "files": files, "skipped": skipped}
    file_ = "%s-%s.json" % (jobs_stamp_after(latest), jobs_fingerprint(files, skipped)[:8])
    writer.put_named("snapshots/%s/%s" % (name, file_), (json.dumps(snap, indent=1, sort_keys=True) + "\n").encode())
    jobs_write_record(cfg, name, file_, seen, skipped)
    return dict(row, state="pushed", snapshot=file_, uploaded=len(missing))


def jobs_push_many(ctx, cfg, names, dry_run=False):
    """(rows, failed). A folder the last push left as it is costs nothing, no key, scan or call, unless an older version
    wrote the note and it does not say what stayed here: then the push finds out, and uploads nothing when nothing
    changed. One job's problem stops only that job; a store that cannot be reached or does not let fx in is not asked
    again for every job."""
    rows, failed, got = [], [], {}

    def stores():
        if "pair" not in got:
            got["pair"] = jobs_stores(ctx, cfg, write=not dry_run)
        return got["pair"]

    down = None
    for name in names:
        st = jobs_local_state(ctx, cfg, name) if not dry_run else {}
        if st.get("state") == "saved" and st["held_back"] is not None:
            rows.append({"job": name, "state": "unchanged", "uploaded": 0, "held_back": st["held_back"]})
            continue
        if down:
            failed.append({"job": name, "error": "not tried: %s" % down})
            continue
        try:
            rows.append(jobs_push_one(ctx, cfg, name, stores, dry_run))
        except FxError as e:
            failed.append({"job": name, "error": str(e)})
        except StoreError as e:
            failed.append({"job": name, "error": str(e)})
            down = None if e.kind == "integrity" else str(e)
        except OSError as e:
            failed.append({"job": name, "error": str(e)})
    return rows, failed


def jobs_list_rows(store):
    """What fx jobs list prints: the snapshots' names from a listing, and the newest of each job. No file's content."""
    table = jobs_snapshots(store)

    def row(item):
        name, files = item
        res = {"job": name, "snapshots": [JOBS_SNAPSHOT_RE.match(f).group(1) for f in files], "latest": files[-1]}
        try:
            snap = jobs_read_snapshot(store, name, files[-1])
            listed = snap.get("files") if isinstance(snap.get("files"), list) else []
            res.update(stage=snap.get("stage"), summary=snap.get("summary"), pr=snap.get("pr_url"),
                       saved_at=snap.get("saved_at"), files=len(listed),
                       bytes=sum(f.get("size") or 0 for f in listed if isinstance(f, dict) and isinstance(f.get("size"), int)))
        except StoreError as e:
            if e.kind != "integrity":
                raise
            res["error"] = str(e)
        return res

    with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
        return list(pool.map(row, sorted(table.items())))


def jobs_check_snapshot(snap, name):
    """{path: {sha256, size}} of a snapshot fx can restore: a version it knows, its own job, and paths that stay inside
    the folder. What is on S3 is data: anyone holding a write key could have written it."""
    if snap.get("version") != JOBS_SNAPSHOT_VERSION:
        raise StoreError("integrity", "%s: snapshot version %r, this fx knows %d" % (name, snap.get("version"), JOBS_SNAPSHOT_VERSION))
    if snap.get("job") != name:
        raise StoreError("integrity", "%s: the snapshot says it is of %r" % (name, snap.get("job")))
    try:
        files = baselines_parse(json.dumps({"version": 1, "files": snap.get("files")}), "the snapshot of %s" % name)
    except FxError as e:
        raise StoreError("integrity", str(e))
    if not name.startswith("_") and "job.json" not in files:
        raise StoreError("integrity", "%s: the snapshot has no job.json" % name)
    return files


def jobs_pick_snapshot(files, at, name):
    """The newest snapshot, or the newest at or before at, which may be cut short: 20260103 is that whole day."""
    if at:
        at = at.replace("-", "").replace(":", "")
        if not re.fullmatch(r"\d{4,8}(?:T\d{0,6}Z?)?", at):
            raise FxError("--at takes a UTC time as fx jobs list prints it, such as 20260103T120000Z", code=3)
        files = [f for f in files if f[:len(at)] <= at]
    if not files:
        raise FxError("%s has no snapshot on S3%s" % (name, " at or before %s" % at if at else ""), code=3)
    return files[-1]


def jobs_pull_one(ctx, cfg, store, name, file_, force):
    """Download into jobs/.restoring-<job>, checked, and only with everything there rename it into place: any problem
    leaves nothing and touches nothing. A job already here goes to jobs/_replaced/, never away."""
    snap = jobs_read_snapshot(store, name, file_)
    entries = jobs_check_snapshot(snap, name)
    dest = os.path.join(ctx.jobs, name)
    if os.path.lexists(dest) and not force:
        raise FxError("jobs/%s is already here: pass --force to move it to jobs/_replaced/ and restore over it" % name, code=3)
    tmp = os.path.join(ctx.jobs, ".restoring-" + name.replace("/", "-"))
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp, mode=0o700)

    def fetch(item):
        rel, e = item
        path = os.path.join(tmp, rel)
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        r = store.open(e["sha256"])
        with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
            s3_copy_checked(r, e["sha256"], e["size"], f)

    skipped = jobs_held_back(snap.get("skipped") or [])  # what exclude names was never meant to come back
    res = {"job": name, "snapshot": file_, "files": len(entries),
           "not_restored": [{"path": str(x.get("path")), "reason": str(x.get("reason"))} for x in skipped]}
    job = None
    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=BASELINE_WORKERS) as pool:
            list(pool.map(fetch, sorted(entries.items())))
        if not name.startswith("_"):
            job = jobs_restored_job(ctx, tmp, snap, name)
        for dirpath, dirnames, names in os.walk(tmp):
            os.chmod(dirpath, 0o700)
            for n in names:
                os.chmod(os.path.join(dirpath, n), 0o600)
        replaced = None
        if os.path.lexists(dest):
            replaced = os.path.join(ctx.jobs, "_replaced", "%s-%s" % (name.replace("/", "-"), jobs_stamp_after(None)))
            os.makedirs(os.path.dirname(replaced), exist_ok=True)
            os.rename(dest, replaced)
            res["replaced"] = replaced
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.rename(tmp, dest)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    # This machine's note, so what was just restored reads as saved. job.json differs from S3 by its paths only. The job
    # is in place by now: without the note it only reads as not saved.
    with contextlib.suppress(OSError):
        seen = {}
        for rel in baselines_scan(dest)[0]:
            path = os.path.join(dest, rel)
            st = os.stat(path)
            seen[rel] = {"sha256": file_sha256(path), "size": st.st_size, "mtime_ns": st.st_mtime_ns}
        jobs_write_record(cfg, name, file_, seen, [])  # what its push left behind is not here: see not_restored
    if job:
        res.update(stage=job.get("stage"), port=job.get("port"), next=jobs_after_restore(ctx, job))
        if job.get("stage") not in TERMINAL:
            res["needs_human"] = True
    return res


def jobs_new_home(ctx, job, snap, name):
    """Make a restored job.json belong to this machine. Paths under the old factory and work folders move here, and what
    only the old machine knew goes: the clone's setup, the ports. The clones are always where this machine's fx puts them,
    and never where the file says: fx deletes them, and the file came from S3."""
    moves = []
    for old, new in ((snap.get("factory_root"), ctx.factory), (snap.get("work_root"), ctx.work)):
        if isinstance(old, str) and old.startswith("/") and old.rstrip("/"):
            moves.append((old.rstrip("/"), new))

    def move(value):
        if isinstance(value, str):
            for old, new in moves:
                if value == old or value.startswith(old + "/"):
                    return new + value[len(old):]
            return value
        if isinstance(value, list):
            return [move(v) for v in value]
        if isinstance(value, dict):
            return {k: move(v) for k, v in value.items()}
        return value

    flat = not isinstance(job.get("repos"), dict)
    job = job_repos(ctx, move(job))
    for rname, e in job["repos"].items():
        if not REPO_RE.match(str(rname)):
            raise StoreError("integrity", "%s: job.json names a repository %r" % (name, rname))
        old_wt = e.get("worktree")
        # An old job's one clone was work/<job>, and stays there; a job of the new form has work/<job>/<repo>.
        old_layout = flat or isinstance(old_wt, str) and os.path.basename(old_wt.rstrip("/")) == name.split("/")[-1]
        e["worktree"] = wt = os.path.join(ctx.work, name) if old_layout and len(job["repos"]) == 1 else \
            job_clone_dir(ctx, name, rname)
        e["setup_done"] = False
        for c in e.get("candidates") or []:
            if not isinstance(c, dict) or not isinstance(c.get("k"), int):
                raise StoreError("integrity", "%s: job.json has a candidate fx could not have written" % name)
            c["worktree"] = "%s-c%d" % (wt, c["k"])
    packages = (job.get("split") or {}).get("packages") if isinstance(job.get("split"), dict) else None
    for pid, p_ in (packages or {}).items():
        if not WP_ID_RE.match(str(pid)) or not isinstance(p_, dict):
            raise StoreError("integrity", "%s: job.json names a package %r" % (name, pid))
        owner = job["repos"].get(p_.get("repo") or job_primary(job) or "")
        if not owner:
            raise StoreError("integrity", "%s: job.json has package %s in no repository of the job" % (name, pid))
        p_["clone"] = "%s--%s" % (owner["worktree"], pid)
    job.pop("upstream", None)  # an older job's copies of another repository's notes: nothing reads them any more
    job.pop("app_dir", None)
    job["slot"], job["port"] = free_slot(ctx, name)
    job["port_span"] = ports_step(ctx)
    job.setdefault("history", []).append({"at": now(), "stage": job.get("stage"),
                                          "note": "restored from S3, snapshot of %s" % (snap.get("saved_at") or "?")})
    return job


def jobs_restored_job(ctx, tmp, snap, name):
    """job.json in the temporary folder, made this machine's. Rejected outright when it is not this job's."""
    path = os.path.join(tmp, "job.json")
    try:
        job = json.loads(read(path) or "")
    except ValueError:
        job = None
    if not isinstance(job, dict) or job.get("id") != name:
        raise StoreError("integrity", "%s: its job.json is not this job's" % name)
    job = jobs_new_home(ctx, job, snap, name)
    os.remove(os.path.join(tmp, "app.json")) if os.path.exists(os.path.join(tmp, "app.json")) else None  # a pid of the old machine
    if job.get("stage") not in TERMINAL:
        job["needs_human"] = True
        job["handoff_reason"] = "restored from S3 while unfinished: code that was not pushed is not in the snapshot"
    write_atomic(path, json.dumps(job_stored(job), ensure_ascii=False, indent=2) + "\n")
    return job


def jobs_after_restore(ctx, job):
    """What to do next with a restored job. Unfinished, it gets its clones back: each changed repository's from its
    branch when that is on the remote, each run-only one at its base. A clone already at its place is left alone: it may
    hold work."""
    if job.get("stage") in TERMINAL:
        return "ready: fx show, fx status and fx rework work as before"
    head = "code that was not pushed is not in the snapshot. "
    again = "fx new %s --again" % (job.get("issue_key") or job["id"])
    several = len(job["repos"]) > 1
    said = []
    for n in job_clones(job):
        e = job["repos"][n]
        wt = e["worktree"]
        of = " of %s" % n if several else ""
        if os.path.isdir(wt):
            said.append("The clone%s at %s was already here and is left as it is." % (of, wt))
            continue
        try:
            if e.get("role") == "run":
                run_clone(ctx, wt, e.get("base_branch") or ctx.rc(n, "base_branch", "main"), n)
                said.append("Cloned %s at its base %s to %s, to run it." % (n, e.get("base_branch"), wt))
                continue
            branch = e.get("branch")
            heads, _ = remote_heads(ctx.url(n))
            if not branch or branch not in heads:
                said.append("Its branch%s is not on the remote, so nothing of its code is left: start again with %s."
                            % (of, again))
                continue
            job_clone(ctx, wt, branch, repo=n)
        except (FxError, OSError) as ex:
            said.append("Could not get its branch%s from the remote (%s): try again later, or start over with %s."
                        % (of, ex, again))
            continue
        said.append("Cloned its branch %s%s from the remote to %s." % (branch, of, wt))
    if not said:
        return head + "Its repositories wait for intake: run it again."
    cloned = any(x.startswith("Cloned") for x in said)
    return head + " ".join(said) + (" Run fx setup, then check what is missing." if cloned else
                                    " Run fx setup, then check it." if all("already here" in x for x in said) else "")


def jobs_pull_many(ctx, cfg, a):
    """(rows, kept, failed). --all takes what is on S3, the audits only when they are turned on, and goes round what is
    already here. Reviews of merge requests, under _reviews/, are not jobs: JOBS_NAME_RE never lists their snapshots."""
    if a.all and a.names:
        raise FxError("name jobs or use --all, not both", code=3)
    if not a.all and not a.names:
        raise FxError("name the jobs to get back, or use --all", code=3)
    for name in a.names:
        refuse_review(name, "it never pushes or pulls them", jobs=ctx.jobs)
    store = baselines_store(ctx, cfg, "read")
    table = jobs_snapshots(store)
    names = sorted(n for n in table if cfg["include_audits"] or not n.startswith("_audits/")) if a.all else a.names
    rows, kept, failed = [], [], []
    for name in names:
        if name not in table:
            failed.append({"job": name, "error": "no snapshot on S3: fx jobs list"})
            continue
        if a.all and not a.force and os.path.lexists(os.path.join(ctx.jobs, name)):
            kept.append(name)
            continue
        try:
            file_ = jobs_pick_snapshot(table[name], a.at, name)
        except FxError as e:
            if a.all:  # it did not exist yet at that time
                kept.append(name)
            else:
                failed.append({"job": name, "error": str(e)})
            continue
        try:
            rows.append(jobs_pull_one(ctx, cfg, store, name, file_, a.force))
        except (FxError, OSError) as e:
            failed.append({"job": name, "error": str(e)})
        except StoreError as e:
            failed.append({"job": name, "error": str(e)})
    return rows, kept, failed


def cmd_jobs(ctx, a):
    cfg = jobs_store_config(ctx)
    if not cfg:
        raise FxError("this factory has no jobs_store block in factory.json, so its jobs stay on this machine%s"
                      % (". " + JOBS_NOT_KEPT if ctx.c("storage") else ""), code=3)
    if a.action == "push":
        names = jobs_pick_here(ctx, cfg, a)
        rows, failed = jobs_push_many(ctx, cfg, names, a.dry_run)
        if failed:
            raise FxError("%d of %d could not be pushed:\n%s" % (
                len(failed), len(names), "\n".join("%s: %s" % (f["job"], f["error"]) for f in failed[:20])),
                code=3, extra={"pushed": rows, "failed": failed})
        held = jobs_held_rows(rows)
        said = "nothing was uploaded" if a.dry_run else "every job's snapshot is on S3"
        out({"ok": True, "dry_run": a.dry_run, "jobs": rows, "next": "%s. %s: tell the user, who decides what to do with "
             "them" % (said, jobs_held_text(held)) if held else
             "nothing was uploaded" if a.dry_run else "every job's files and snapshot are on S3"})
        return
    if a.action == "status":
        rows = [jobs_local_state(ctx, cfg, n) for n in jobs_names_here(ctx, cfg)]
        unsaved = [r["job"] for r in rows if r["state"] != "saved"]
        held = jobs_held_rows(rows)
        unknown = [r["job"] for r in rows if r["state"] == "saved" and r["held_back"] is None]
        steps = ["fx jobs push"] if unsaved else ["fx jobs push finds out which files of %s stayed on this machine, and "
                                                  "uploads nothing" % ", ".join(unknown)] if unknown else []
        if held:
            steps.append("%s: tell the user, who decides what to do with them" % jobs_held_text(held))
        out({"ok": True, "jobs": rows, "unsaved": unsaved,
             "next": "; ".join(steps) or "every job here is as its last push left it, and every file is on S3"})
        return
    try:
        if a.action == "list":
            rows = jobs_list_rows(baselines_store(ctx, cfg, "read"))
            out({"ok": True, "jobs": rows, "next": "fx jobs pull <job>, or --all"})
            return
        rows, kept, failed = jobs_pull_many(ctx, cfg, a)
    except StoreError as e:
        raise FxError("jobs store: %s" % e, code=3)
    if failed:
        raise FxError("%d could not be restored, and nothing of those was left behind:\n%s" % (
            len(failed), "\n".join("%s: %s" % (f["job"], f["error"]) for f in failed[:20])),
            code=3, extra={"pulled": rows, "kept": kept, "failed": failed})
    missing = sum(len(r["not_restored"]) for r in rows)
    out({"ok": True, "jobs": rows, "kept": kept,
         "next": "%d file(s) were left out when these jobs were pushed and are not here: see not_restored" % missing
         if missing else "every file of every snapshot is here"})


def baselines_prompt_lines(ctx, job, agent, cand, wp):
    """What agents are told about baselines: never a key, only the folder, the rules and what this job changed."""
    cfg = baselines_config(ctx)
    if not cfg:
        return []
    lines = []
    view = baselines_job(ctx, cfg, job)
    if agent == "builder":
        if cfg["repo"] == "project" and view is None:
            return []  # the list is in a repository this job does not change
        vrepo = (view or {}).get("repo")
        clone = None
        if wp and (wp.get("repo") or vrepo) == vrepo:
            clone = wp.get("clone")
        elif cand:
            clone = ((job_candidates(job).get(cand["k"]) or {}).get(vrepo) or cand).get("worktree")
        root = ctx.factory if cfg["repo"] == "factory" else clone or view["worktree"]
        arg = "--clone %s" % clone if clone and cfg["repo"] == "project" else "--job %s" % job["id"]
        if cfg["repo"] == "factory":
            last = ("Do not commit the list: it is in the factory repository, and it is committed after its images are "
                    "uploaded.")
        elif clone:
            last = ("Then `%s baselines push %s` and commit the list: your package or candidate must be fully committed, "
                    "and a list may only be committed once S3 has its images." % (FX_CMD, arg))
        else:
            last = ("Leave the list uncommitted: the gate compares with your local images, and the list is committed "
                    "after they are uploaded.")
        lines.append("Baselines (reference images of pixel comparisons): folder %s, list %s (they are real checks). Never "
                     "edit or delete an image to make a check pass: the gate restores the folder from the list, and every "
                     "change to the list goes to the reviewers and the pull request. Only when the spec asks for the screen "
                     "to change: regenerate the affected images, run `%s baselines record %s`, and name each image and why "
                     "in your report. %s" % (os.path.join(root, cfg["dir"]), os.path.join(root, cfg["manifest"]),
                                             FX_CMD, arg, last))
    elif agent in REVIEW_ROLES or agent == "approver":
        bl = job.get("baselines") or {}
        n = bl.get("counts") or {}
        if sum(n.values()):
            lines.append("Baselines changed by this job (%d changed, %d added, %d removed): the list and the before and "
                         "after images are in round-%d/baselines.md and round-%d/baselines/ of the job folder. A changed "
                         "baseline can hide a UI bug: check each one against the spec, and treat one the spec does not "
                         "call for as a blocking finding." % (n.get("changed", 0), n.get("added", 0), n.get("removed", 0),
                                                              job["round"], job["round"]))
        if bl.get("unrecorded"):
            lines.append("Baseline files that differed from the list without being recorded were restored by the gate: %s "
                         "(kept in round-%d/baselines/unrecorded/)" % (", ".join(bl["unrecorded"][:10]), job["round"]))
    return lines


