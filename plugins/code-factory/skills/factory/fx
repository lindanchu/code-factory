def file_role(f):
    for role, rx in ROLES:
        if re.search(rx, f) if role in ("composable-hook", "test-unit") else re.search(rx, f, re.I):
            return role
    return None


def last_changes(root, limit=5000):
    """When each file last changed, from one pass over recent history (newest first)."""
    when = {}
    p = git(["log", "-%d" % limit, "--format=@%ct", "--name-only"], root, check=False)
    t = 0
    for line in (p.stdout or "").splitlines() if p.returncode == 0 else []:
        if line.startswith("@"):
            t = int(line[1:] or 0)
        elif line and line not in when:
            when[line] = t
    return when


def cmd_style_sample(ctx, a):
    """Pick files to learn the code style from, per architectural role: for each role the two most recently
    changed files and the oldest one (from different folders), plus the linter configs."""
    root = source_root(ctx, a)
    files = list_files(root)
    when = last_changes(root)

    def lines_of(f):
        try:
            with open(os.path.join(root, f), "rb") as fh:
                return fh.read(400000).count(b"\n")
        except OSError:
            return 0
    by_role = {}
    for f in files:
        role = file_role(f)
        if role == "i18n" or (role and is_source(f)) or (not role and is_source(f)):
            by_role.setdefault(role or "other:" + (os.path.splitext(f)[1].lower() or "none"), []).append(f)
    # Unclassified files: keep only the two most common extensions.
    others = sorted((k for k in by_role if k.startswith("other:")), key=lambda k: -len(by_role[k]))
    for k in others[2:]:
        del by_role[k]
    roles = {}
    for role, fs in sorted(by_role.items()):
        cands = [f for f in fs if 15 <= lines_of(f) <= 800] or fs
        cands.sort(key=lambda f: -when.get(f, 0))
        picks, dirs = [], set()
        for f in cands:  # different folders first, then fill up from the same ones
            if os.path.dirname(f) not in dirs:
                picks.append({"file": f, "lines": lines_of(f), "age": "recent"})
                dirs.add(os.path.dirname(f))
            if len(picks) >= a.per_role:
                break
        for f in cands:
            if len(picks) >= a.per_role:
                break
            if f not in [p["file"] for p in picks]:
                picks.append({"file": f, "lines": lines_of(f), "age": "recent"})
        olds = [f for f in reversed(cands) if f not in [p["file"] for p in picks]]
        if olds:
            o = next((f for f in olds if os.path.dirname(f) not in dirs), olds[0])
            picks.append({"file": o, "lines": lines_of(o), "age": "old"})
        for p in picks:
            ts = when.get(p["file"])
            p["last_change"] = _dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d") if ts else None
        roles[role] = {"files": len(fs), "samples": picks}
    known = [r for r, _ in ROLES]
    tests = [p["file"] for r, v in roles.items() if r.startswith("test-") for p in v["samples"]]
    flat = [p for r, v in roles.items() if not r.startswith("test-") and r != "i18n" for p in v["samples"]]
    name = scanned_repo(ctx, a)
    where = "knowledge/%s/style.md" % name if name and not knowledge_flat(ctx) else "knowledge/style.md"
    cite = "%s:path:lines" % name if name and len(ctx.repos) > 1 else "path:lines"
    out({"ok": True, "root": root, "repo": name, "lint_configs": [f for f in files if os.path.basename(f) in
                                                                  LINT_CONFIGS][:30],
         "roles": roles, "roles_not_found": [r for r in known if r not in roles],
         "samples": flat, "test_samples": tests,
         "next": "read the lint configs and every sample, role by role; the 'recent' files are the standard and "
                 "the 'old' one shows what changed. Write %s per role with short real excerpts (%s), and a "
                 "'Legacy (do not copy)' section for older patterns still in the code" % (where, cite)})


def source_modules(files, min_files=5, split_at=60, max_depth=3):
    """The project's main modules: folders holding source code, split into sub-folders while they are big."""
    src = [f for f in files if is_source(f) and "/" in f]
    count = {}
    for f in src:
        parts = f.split("/")[:-1]
        for i in range(1, min(len(parts), max_depth) + 1):
            d = "/".join(parts[:i])
            count[d] = count.get(d, 0) + 1

    def kids(d):
        depth = d.count("/") + 1
        return [k for k in count if k.startswith(d + "/") and k.count("/") + 1 == depth + 1 and count[k] >= min_files]
    modules = []

    def walk(d):
        ks = kids(d)
        if count[d] > split_at and len(ks) >= 2 and d.count("/") + 1 < max_depth:
            for k in sorted(ks):
                walk(k)
        else:
            modules.append({"path": d, "files": count[d]})
    for top in sorted(k for k in count if "/" not in k and count[k] >= min_files):
        walk(top)
    return modules


def cmd_audit_import(ctx, a):
    """Turn a security audit's findings.json into a summary and one task file per confirmed finding."""
    try:
        data = json.loads(read(os.path.expanduser(a.findings), "") or "")
    except ValueError:
        raise FxError("%s is not valid JSON" % a.findings)
    items = data.get("findings", data.get("results", [])) if isinstance(data, dict) else data
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M")
    adir = os.path.join(ctx.jobs, "_audits", stamp)
    os.makedirs(adir, exist_ok=True)
    rows, confirmed = [], []
    for i, f in enumerate(items or [], 1):
        if not isinstance(f, dict):
            continue
        status = str(f.get("verdict") or f.get("status") or f.get("state") or "").lower()
        title = f.get("title") or f.get("name") or f.get("summary") or f.get("id") or "finding %d" % i
        sev = sev_word(str(f.get("severity") or f.get("impact") or "medium"))
        loc = f.get("location") or f.get("file") or f.get("path") or ""
        if isinstance(loc, (dict, list)):
            loc = json.dumps(loc)[:200]
        fid = str(f.get("id") or "F%d" % i)
        rows.append({"id": fid, "status": status or "unknown", "severity": sev, "title": str(title)[:200],
                     "location": str(loc)[:200]})
        if status.startswith("confirm"):
            body = ["Security audit finding %s (%s), imported %s." % (fid, sev, stamp), "",
                    "Fix this vulnerability with the smallest safe change, add a test that fails before the fix "
                    "and passes after, and do not change unrelated code.", "", "## Finding", ""]
            for k, v in f.items():
                body += ["### %s" % k, "", v if isinstance(v, str) else "```json\n%s\n```" % json.dumps(v, indent=2), ""]
            path = os.path.join(adir, "%s.md" % re.sub(r"[^A-Za-z0-9._-]+", "_", fid))
            write_atomic(path, "\n".join(body) + "\n")
            confirmed.append(dict(rows[-1], task_file=path))
    md = ["# Security audit %s" % stamp, "", "| Id | Status | Severity | Title | Where |", "|---|---|---|---|---|"]
    md += ["| %s | %s | %s | %s | %s |" % (r["id"], r["status"], r["severity"], r["title"].replace("|", "/"),
                                            r["location"].replace("|", "/")) for r in
           sorted(rows, key=lambda r: (not r["status"].startswith("confirm"), -SEV_RANK.get(r["severity"], 2)))]
    write_atomic(os.path.join(adir, "summary.md"), "\n".join(md) + "\n")
    res = {"ok": True, "summary": os.path.join(adir, "summary.md"), "total": len(rows),
           "confirmed": sorted(confirmed, key=lambda r: -SEV_RANK.get(r["severity"], 2)),
           "next": "report to the user, offer lessons, then ask about each finding, one at a time, whether to fix it "
                   "(fx new --local ... --issue-file <task_file>)"}
    jobs_after_step(ctx, res)
    out(res)


def scan_repos(ctx, a):
    """The repositories fx selftest and fx audit-scan look at: --repo, else every one."""
    if getattr(a, "repo_name", None):
        return [ctx.repo_name(a.repo_name)]
    if not ctx.repos:
        ctx.repo_entry()  # says how to set the factory up
    return ctx.repo_names()


def base_checkout(ctx, dest, name, branch, full=False):
    """A clone of a repository checked out (detached) at its branch: what selftest and audit-scan look at."""
    clone_project(ctx, dest, full=full, repo=name)
    base_ref = "%s/%s" % (REMOTE, branch)
    if git(["rev-parse", "--verify", "-q", base_ref], dest, check=False).returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        raise FxError("the project%s has no %s%s" % (" " + name if len(ctx.repos) > 1 else "", base_ref,
                                                      "" if full else " yet"), code=3)
    git(["checkout", "-q", "--detach", base_ref], dest)
    return base_ref


def tool_job(ctx, job_id, name, wt, base_ref, port, app_dir=None):
    """A job of fx's own (selftest, audit-scan) that changes one repository at its base: what the apps and scanners need.
    The repositories its app needs come in as run-only with needed_clones."""
    job = {"id": job_id, "port": port, "repo_order": [name], "repos": {name: {"role": "change", "worktree": wt,
                                                                              "base_ref": base_ref, "branch": None}}}
    if app_dir:
        job["app_dir"] = app_dir
    return job


def needed_clones(ctx, job, prefix, made, notes=None):
    """Clone, at its base, every repository the job's apps need and set it up; they join the job as run-only."""
    for m in job_apps(ctx, job):
        if m in job["repos"]:
            continue
        base = ctx.rc(m, "base_branch", "main")
        wt = os.path.join(ctx.work, "%s-%s" % (prefix, m))
        made.append(wt)
        run_clone(ctx, wt, base, m)
        job["repos"][m] = {"role": "run", "worktree": wt, "base_ref": "%s/%s" % (REMOTE, base)}
        job["repo_order"] = [n for n in ctx.repo_names() if n in job["repos"]]
        cmd = ctx.rc(m, "setup", "")
        if cmd:
            env, _db = app_env(repo_ctx(ctx, m), repo_view(ctx, job, m))
            p = run(["bash", "-lc", cmd], cwd=wt, check=False, env=env,
                    timeout=int(ctx.rc(m, "setup_timeout_sec", 1800) or 1800))
            if p.returncode != 0:
                raise FxError("setup of %s (its app is needed) exited %s" % (m, p.returncode))
    return job


def cmd_audit_scan(ctx, a):
    """Every scanner over a whole branch and its history, not only what a job changed: what is already wrong in the
    project, in every repository (or --repo). Writes a report and one task file per rule (and repository) at or above
    security.block_severity, ready for fx new."""
    names = scan_repos(ctx, a)
    several = len(names) > 1
    bases = parse_bases(ctx, a.base)
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    adir = os.path.join(ctx.jobs, "_audits", "scan-%s" % stamp)
    os.makedirs(adir, exist_ok=True)
    _, port = free_slot(ctx, "_audit")
    results, branches = {}, {}
    for n in names:
        rctx = repo_ctx(ctx, n)
        branches[n] = branch = base_for(ctx, bases, n)
        rdir = os.path.join(adir, n) if several else adir
        os.makedirs(rdir, exist_ok=True)
        wt = os.path.join(ctx.work, "_audit" if len(ctx.repos) <= 1 else "_audit-%s" % n)
        made = [wt]
        base_ref = base_checkout(ctx, wt, n, branch, full=True)
        job = tool_job(ctx, "_audit", n, wt, base_ref, port, rdir)
        url, app_note, started = None, None, False
        try:
            if rctx.c("app.up") and not a.no_app:
                copy_local_files(ctx, wt, n)
                try:
                    if rctx.c("setup"):
                        env, _db = app_env(rctx, repo_view(ctx, job, n))
                        p = run(["bash", "-lc", rctx.c("setup")], cwd=wt, check=False, env=env,
                                timeout=int(rctx.c("setup_timeout_sec", 1800)))
                        if p.returncode != 0:
                            raise FxError("setup exited %s" % p.returncode)
                    needed_clones(ctx, job, "_audit", made)
                    started = True
                    info = app_start(ctx, job)
                    url = (info.get("apps") or {n: info})[n]["url"]
                except (FxError, subprocess.TimeoutExpired) as e:
                    app_note = "headers/zap: the app could not start, so nothing looked at it: %s" % str(e)[:300]
            res = run_security(rctx, repo_view(ctx, job, n), rdir, url, whole=True)
        finally:
            if started:
                app_stop(ctx, job)
            for d in made:
                shutil.rmtree(d, ignore_errors=True)
        if app_note:
            res["skipped"].append(app_note)
        for f in res["findings"]:
            f["repo"] = n
        results[n] = res
    report = os.path.join(adir, "scan.md")
    write_atomic(report, security_markdown_repos(results, several))
    merged = security_merge(results, several)
    groups = {}
    for f in merged["blocking"]:
        groups.setdefault((f["repo"], f["tool"], f.get("rule") or "unnamed"), []).append(f)
    rows = []
    for (repo, tool, rule), items in sorted(groups.items(),
                                            key=lambda kv: -max(SEV_RANK.get(f["severity"], 2) for f in kv[1])):
        sev = max((f["severity"] for f in items), key=lambda w: SEV_RANK.get(w, 2))
        body = ["Security scan finding %s (%s), found by %s on %s%s, %s." % (
            rule, sev, tool, branches[repo], " of %s" % repo if several else "", stamp), ""]
        if several:
            body += ["Repository: %s (the job changes it: fx new ... --repos %s)" % (repo, repo), ""]
        if items[0].get("secret"):
            body += ["A secret reached the history. Tell a human to replace it first: removing it from the code does "
                     "not make it safe again. Then take it out of the code. Never write its value anywhere.", ""]
        else:
            body += ["Fix this vulnerability with the smallest safe change, add a test that fails before the fix and "
                     "passes after, and do not change unrelated code.", ""]
        body += ["## Where", ""] + ["- %s: %s" % (f.get("location"), f.get("message")) for f in items[:100]]
        if len(items) > 100:
            body.append("- and %d more places: %s" % (len(items) - 100, report))
        slug = re.sub(r"[^A-Za-z0-9._-]+", "_", rule)[-80:]
        path = os.path.join(adir, "%02d-%s.md" % (len(rows) + 1, "%s-%s" % (repo, slug) if several else slug))
        write_atomic(path, "\n".join(body) + "\n")
        rows.append({"repo": repo, "tool": tool, "rule": rule, "severity": sev, "places": len(items), "task_file": path})
    counts = {}
    for f in merged["findings"]:
        counts[f["severity"]] = counts.get(f["severity"], 0) + 1
    res = {"ok": True, "report": report, "counts": counts, "complete": not merged["missed"],
           "missed": merged["missed"], "skipped": merged["skipped"], "notes": merged["notes"], "to_fix": rows[:40],
           "to_fix_total": len(rows),
           "next": "report to the user, then ask about each finding to fix, one at a time (fx new --local ... "
                   "--issue-file <task_file>%s)" % (" --repos <its repo>" if several else "")}
    if several:
        res.update(branches=branches, repos=names)
    else:
        res.update(branch=branches[names[0]], repo=names[0])
    out(res)


def timed(fn):
    t0 = time.time()
    r = fn()
    return r, round(time.time() - t0, 1)


def selftest_repo(ctx, a, n, port, logdir, clone_of, bl_cfg, bl_pre, first):
    """One repository's selftest: setup, its checks script, its app (after the apps it needs), app.schema, e2e and the
    base branch's header and ZAP findings. Returns what baseline.json keeps for it."""
    rctx = repo_ctx(ctx, n)
    os.makedirs(logdir, exist_ok=True)
    wt, base_ref = clone_of(n)
    job = tool_job(ctx, "_selftest", n, wt, base_ref, port)
    res = {"at": now(), "base": base_ref, "steps": {}}
    extra_env = {}

    def step(name, cmd, timeout):
        log = os.path.join(logdir, "%s.log" % name)
        env = project_env(rctx, FACTORY_JOB="_selftest", FACTORY_PORT=str(job_port(ctx, job, n)),
                          **dict(baselines_env(rctx, wt), **extra_env))
        try:
            p, secs = timed(lambda: run(["bash", "-lc", cmd], cwd=wt, check=False, env=env, timeout=timeout))
            write_atomic(log, p.stdout or "")
            tail = "\n".join((p.stdout or "").splitlines()[-25:])
            res["steps"][name] = {"ok": p.returncode == 0, "exit": p.returncode, "seconds": secs, "log": log,
                                  "tail": tail}
        except subprocess.TimeoutExpired:
            res["steps"][name] = {"ok": False, "exit": None, "seconds": timeout, "log": log,
                                  "tail": "timed out after %ss" % timeout}
        return res["steps"][name]["ok"]

    ok = True
    if bl_cfg and ((bl_cfg["repo"] == "factory" and first) or (bl_cfg["repo"] == "project" and bl_cfg["repo_name"] == n)):
        rep = baselines_before_checks(ctx, bl_cfg, ctx.factory if bl_cfg["repo"] == "factory" else wt,
                                      os.path.join(logdir, "baselines-unrecorded"))
        ok = not rep["problems"]
        res["steps"]["baselines"] = {"ok": ok, "fetched": rep["fetched"], "error": "\n".join(rep["problems"]),
                                     "warnings": bl_pre["warnings"] + rep["warnings"], "pulled": bl_pre["pulled"]}
    tries = scanner_probes(rctx, wt)
    res["steps"]["scanners"] = {"ok": all(t[1] for t in tries), "checks": [{"check": t[0], "ok": t[1], "detail": t[2]}
                                                                             for t in tries],
                                "error": "; ".join(t[2] for t in tries if not t[1])}
    if ok and rctx.c("setup"):
        ok = step("setup", rctx.c("setup"), int(rctx.c("setup_timeout_sec", 1800)))
    if ok:
        script = checks_script(ctx, None, n)
        step("checks", "bash %s" % shlex.quote(script), int(rctx.c("gate_timeout_sec", 1800)))
        dirty = worktree_dirt(ctx, wt, n)
        res["leftover_files"] = (dirty[0].splitlines() + dirty[1])[:30]
    if ok and rctx.c("app.up") and not a.no_app:
        made = []
        try:
            for m in job_apps(ctx, job):
                if m != n:  # the apps it needs, each from its own clone of its base, set up
                    w, b = clone_of(m, setup=True)
                    job["repos"][m] = {"role": "run", "worktree": w, "base_ref": b}
            job["repo_order"] = [x for x in ctx.repo_names() if x in job["repos"]]
            info, secs = timed(lambda: app_start(ctx, job))
            started = info.get("apps") or {n: info}
            info = started[n]
            res["steps"]["app"] = {"ok": True, "seconds": secs, "url": info["url"]}
            if len(started) > 1:
                res["steps"]["app"]["needs"] = {m: i["url"] for m, i in started.items() if m != n}
            view = repo_view(ctx, job, n)
            if rctx.c("app.schema"):
                env, db = app_env(rctx, view)
                try:
                    p = run(["bash", "-lc", app_fill(rctx.c("app.schema"), view, db)], cwd=wt, check=False,
                            env=env, timeout=300)
                    if p.returncode == 0 and (p.stdout or "").strip():
                        write_atomic(schema_path(ctx, n), p.stdout)
                        res["schema"] = schema_path(ctx, n)
                    else:
                        res["schema_error"] = "app.schema exited %s: %s" % (
                            p.returncode, "\n".join((p.stdout or "").splitlines()[-10:]))
                except subprocess.TimeoutExpired:
                    res["schema_error"] = "app.schema timed out"
            if rctx.c("e2e"):
                env, db = app_env(rctx, view)
                extra_env.update({k: v for k, v in env.items() if k.startswith("FACTORY_URL_")},
                                 BASE_URL=info["url"].rstrip("/"))
                step("e2e", app_fill(rctx.c("e2e"), view, db), int(rctx.c("e2e_timeout_sec", 1800)))
            sc = scanners_on(rctx)
            res["security"] = {}
            if sc["headers"]:
                f, err = scan_headers(rctx, view, info["url"])
                if not err:
                    res["security"]["headers"] = f
            if sc["zap"] and shutil.which("docker") and not a.no_zap:
                f, err = scan_zap(rctx, view, info["url"], os.path.join(logdir, "zap"))
                if not err:
                    res["security"]["zap"] = f
                else:
                    res["security_skipped"] = [err]
            # After the scans: the first ZAP run on a machine is what pulls the image and gives it its id.
            res["security_scan"] = {t: scan_signature(rctx, t) for t in ("headers", "zap")}
        except FxError as e:
            res["steps"]["app"] = {"ok": False, "error": str(e)}
        finally:
            app_stop(ctx, job)
    res["ok"] = all(v.get("ok") for v in res["steps"].values())
    return res


def cmd_selftest(ctx, a):
    """Prove the factory can work here, for every repository (or --repo): a fresh clone of its base branch, setup, its
    checks script, its app, e2e, and the base branch's header/ZAP findings as a baseline. Writes baseline.json
    ({"repos": {"<name>": ...}}; an old factory of one repository keeps it flat) and each repository's schema; the clones
    are deleted afterwards."""
    names = scan_repos(ctx, a)
    one = len(ctx.repos) <= 1
    bl_cfg = baselines_config(ctx)
    bl_pre = baselines_refresh(ctx, bl_cfg, hold=True) if bl_cfg else None
    bl_cfg = baselines_config(ctx)
    logroot = os.path.join(ctx.jobs, "_selftest")
    slot, port = free_slot(ctx, "_selftest")
    clones, done_setup = {}, set()

    def clone_of(n, setup=False):
        if n not in clones:
            wt = os.path.join(ctx.work, "_selftest" if one else "_selftest-%s" % n)
            base_ref = base_checkout(ctx, wt, n, ctx.rc(n, "base_branch", "main"))
            clones[n] = (wt, base_ref)
            copy_local_files(ctx, wt, n)
        if setup and n not in done_setup:
            done_setup.add(n)
            cmd = ctx.rc(n, "setup", "")
            if cmd:
                p = run(["bash", "-lc", cmd], cwd=clones[n][0], check=False, env=project_env(ctx),
                        timeout=int(ctx.rc(n, "setup_timeout_sec", 1800) or 1800))
                if p.returncode != 0:
                    raise FxError("setup of %s (its app is needed) exited %s" % (n, p.returncode))
        return clones[n]

    results = {}
    try:
        for i, n in enumerate(names):
            results[n] = selftest_repo(ctx, a, n, port, logroot if one else os.path.join(logroot, n), clone_of,
                                       bl_cfg, bl_pre, i == 0)
            done_setup.add(n)
    finally:
        if not a.keep:
            for wt, _ in clones.values():
                shutil.rmtree(wt, ignore_errors=True)
    tools = tool_status()
    path = os.path.join(ctx.factory, "baseline.json")
    nxt = lambda ok: ("fix what failed, then run selftest again" if not ok else
                      "record the timings and any flaky tests in %s" % ", ".join(
                          os.path.relpath(os.path.join(repo_knowledge_dir(ctx, n), "environment.md"), ctx.factory)
                          for n in names))
    if ctx.old_form:
        res = dict(results[names[0]], tools=tools)
        write_atomic(path, json.dumps(res, indent=2, ensure_ascii=False) + "\n")
        out(dict(res, baseline=path, next=nxt(res["ok"])))
        return
    old = baseline_json(ctx)
    repos = dict(old["repos"]) if isinstance(old.get("repos"), dict) else (
        {ctx.repo_names()[0]: {k: v for k, v in old.items() if k != "tools"}} if old.get("steps") else {})
    repos.update(results)
    repos = {n: repos[n] for n in ctx.repo_names() if n in repos}
    write_atomic(path, json.dumps({"at": now(), "ok": all(r.get("ok") for r in repos.values()), "tools": tools,
                                   "repos": repos}, indent=2, ensure_ascii=False) + "\n")
    if len(names) == 1:
        out(dict(results[names[0]], repo=names[0], tools=tools, baseline=path, next=nxt(results[names[0]]["ok"])))
        return
    ok = all(r["ok"] for r in results.values())
    out({"ok": ok, "repos": results, "tools": tools, "baseline": path, "next": nxt(ok)})


