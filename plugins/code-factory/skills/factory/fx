               "Bash(git merge-tree *)", "Bash(git add *)", "Bash(git commit *)"]
LOCAL_DENY = ["Bash(git push --force *)", "Bash(git push -f *)", "Bash(git reset --hard *)"]


def ensure_gitignore(ctx, lines):
    gi = os.path.join(ctx.factory, ".gitignore")
    have = (read(gi, "") or "").splitlines()
    missing = [l for l in lines if l not in have and "/" + l not in have]
    if missing:
        text = read(gi, "") or ""
        if text and not text.endswith("\n"):
            text += "\n"
        text += "\n# software factory\n" + "\n".join(missing) + "\n"
        write_atomic(gi, text)
    return missing


def remote_heads(url):
    """Branches of the project's repository and its default branch, without cloning."""
    try:
        p = run(["git", "ls-remote", "--symref", os.path.expanduser(url) if os.path.isdir(os.path.expanduser(url))
                 else url], check=False, timeout=120)
    except subprocess.TimeoutExpired:
        raise FxError("cannot reach the project's repository %s: no answer within 120 seconds (network, VPN or "
                      "credentials?)" % url, code=3)
    if p.returncode != 0:
        raise FxError("cannot reach the project's repository %s: %s" % (url, (p.stdout or "")[-400:].strip()), code=3)
    heads, default = {}, None
    for line in (p.stdout or "").splitlines():
        m = re.match(r"^ref: refs/heads/(\S+)\s+HEAD$", line)
        if m:
            default = m.group(1)
        m = re.match(r"^([0-9a-f]{40})\s+refs/heads/(\S+)$", line)
        if m:
            heads[m.group(2)] = m.group(1)
    return heads, default


def same_repo(a, b):
    norm = lambda u: re.sub(r"(\.git)?/*$", "", re.sub(r"^(https?://|ssh://|git@)", "", (u or "").strip())
                            .replace(":", "/")).lower()
    return bool(a and b) and norm(a) == norm(b)


def older_fx_rule(rule, fx_path=None):
    """An allow rule for fx in another version folder of this plugin (<plugin>/<version>/skills/factory/fx): a plugin
    update moves fx to a new folder and leaves the old rule behind. Every other rule stays, such as one for another
    plugin whose skill is also named factory. Installed with install.sh, fx has one folder and no older copies."""
    fx_path = fx_path or SELF
    version_dir = os.path.dirname(os.path.dirname(os.path.dirname(fx_path)))
    m = re.fullmatch(r"Bash\(python3 (.+)/[^/]+/skills/factory/fx \*\)", rule)
    return bool(m) and rule != "Bash(python3 %s *)" % fx_path and m.group(1) == os.path.dirname(version_dir) \
        and os.path.isfile(os.path.join(version_dir, ".claude-plugin", "plugin.json"))


def merge_settings(cur, new):
    """new over cur, block by block: what only cur has in a block stays, such as a setting the older layout did not
    know, or one of merge-request review's, which code-factory leaves as it is."""
    if isinstance(cur, dict) and isinstance(new, dict):
        return dict(cur, **{k: merge_settings(cur.get(k), v) for k, v in new.items()})
    return new


def import_old_layout(ctx, src, cfg, notes):
    """Copy what an older version kept inside a project (factory/ folder) into this factory repository. What belongs to
    merge-request review stays as it is: its settings, the lessons tagged [review] and knowledge/repos/."""
    old = os.path.join(os.path.abspath(os.path.expanduser(src)), "factory")
    if not os.path.isfile(os.path.join(old, "config.json")):
        raise FxError("no factory/config.json under %s to import" % src)
    done = []
    try:
        oc = json.loads(read(os.path.join(old, "config.json")))
    except ValueError:
        raise FxError("%s/config.json is not valid JSON" % old)
    for k, v in oc.items():
        if k in ("remote", "worktree_root", "project", "work_dir"):
            continue
        cfg[k] = merge_settings(cfg.get(k), v)
    if isinstance(cfg.get("app"), dict) and str(cfg["app"].get("accounts_file", "")).startswith("factory/"):
        cfg["app"]["accounts_file"] = cfg["app"]["accounts_file"][len("factory/"):]
    if isinstance(cfg.get("frozen_paths"), list):
        cfg["frozen_paths"] = [x for x in cfg["frozen_paths"] if not x.startswith("factory/")]
    done.append("factory.json (from config.json)")
    for name in ("checks.sh", "lessons.md", "knowledge.md"):
        if not os.path.isfile(os.path.join(old, name)):
            continue
        here = os.path.join(ctx.factory, name)
        if name == "lessons.md" and any(REVIEW_TAG in e["tags"] for e in lesson_entries(read(here, "") or "")):
            notes.append("lessons.md was not imported: it holds lessons tagged [%s], for reviews of merge requests, "
                         "which code-factory leaves as written. Add the rules of %s to it by hand"
                         % (REVIEW_TAG, os.path.join(old, name)))
            continue
        shutil.copy2(os.path.join(old, name), here)
        done.append(name)
    if os.path.isdir(os.path.join(old, "knowledge")):
        kd, theirs = knowledge_dir(ctx), os.path.join(old, "knowledge")
        repos = os.path.isdir(os.path.join(kd, "repos"))  # merge-request review's: it stays as it is
        for name in os.listdir(kd) if os.path.isdir(kd) else []:
            path = os.path.join(kd, name)
            if repos and name == "repos":
                continue
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            else:
                os.remove(path)
        shutil.copytree(theirs, kd, dirs_exist_ok=True,
                        ignore=lambda d, names: ["repos"] if repos and os.path.samefile(d, theirs) else [])
        done.append("knowledge/")
    return done


# What an old factory.json (one project.url) keeps at its top level for its one repository: init moves these into the
# repository's entry. What stays at the top is the project's default for every repository (ctx.rc).
CONVERT_KEYS = ("setup", "dev_server", "app", "e2e", "copy_into_worktree", "copy_from", "protected_paths", "ui_paths",
                "pr.provider", "security.accepted_rules", "learning.knowledge_map")
# A repository's own knowledge files, in knowledge/<repo>/; the others of knowledge/ are the project's, shared.
REPO_KNOWLEDGE = ("README.md", "architecture.md", "style.md", "stack.md", "api.md", "ui.md", "testing.md",
                  "environment.md")
# What init moves from an old flat knowledge/ into knowledge/<repo>/ (its index, README.md, stays shared).
FLAT_REPO_KNOWLEDGE = REPO_KNOWLEDGE[1:] + (".ref",)


def dotted_pop(d, dotted):
    """Remove a dotted key from nested dicts; returns (found, value). An emptied parent block goes too."""
    parts = dotted.split(".")
    cur, chain = d, []
    for part in parts[:-1]:
        if not isinstance(cur, dict) or not isinstance(cur.get(part), dict):
            return False, None
        chain.append((cur, part))
        cur = cur[part]
    if not isinstance(cur, dict) or parts[-1] not in cur:
        return False, None
    v = cur.pop(parts[-1])
    for parent, part in reversed(chain):
        if parent[part] == {}:
            del parent[part]
    return True, v


def dotted_set(d, dotted, value):
    parts = dotted.split(".")
    for part in parts[:-1]:
        if not isinstance(d.get(part), dict):
            d[part] = {}
        d = d[part]
    d[parts[-1]] = value


def keys_id_valid(kid):
    return isinstance(kid, str) and bool(re.sub(r"[^A-Za-z0-9._-]+", "-", kid.strip()).strip("-."))


def factory_tracked(ctx, rel):
    return git(["ls-files", "--error-unmatch", "--", rel], ctx.factory, check=False).returncode == 0


def factory_move(ctx, src_rel, dst_rel):
    """Move a file of the factory repository: git mv when git tracks it (the rename is staged), else a plain move."""
    src, dst = os.path.join(ctx.factory, src_rel), os.path.join(ctx.factory, dst_rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if factory_tracked(ctx, src_rel) and git(["mv", "--", src_rel, dst_rel], ctx.factory, check=False).returncode == 0:
        return "git mv %s %s" % (src_rel, dst_rel)
    os.rename(src, dst)
    return "moved %s to %s" % (src_rel, dst_rel)


def project_remote_url(ctx, url, notes):
    """The URL init records for a repository: a local folder means its remote (a bare repository is one)."""
    url = (url or "").strip()
    local = os.path.expanduser(url)
    if not url or not os.path.isdir(local):
        return url
    local = os.path.abspath(local)
    if run_sep(["git", "rev-parse", "--is-bare-repository"], cwd=local).stdout.strip() == "true":
        return local  # a bare repository is a remote: nobody works in it
    if not git_toplevel(local):
        raise FxError("%s is not a git repository" % local, code=3)
    names = run_sep(["git", "remote"], cwd=local).stdout.split()
    name = REMOTE if REMOTE in names else (names[0] if names else None)
    if not name:
        raise FxError("%s has no remote. The factory never pushes into your own checkout: give the URL of the "
                      "repository it pushes to (or of a bare repository)" % local, code=3)
    origin = run_sep(["git", "remote", "get-url", name], cwd=local).stdout.strip()
    if origin and not os.path.isabs(origin) and os.path.exists(os.path.join(local, origin)):
        origin = os.path.normpath(os.path.join(local, origin))  # a relative path is relative to that folder
    notes.append("using the project's remote %s instead of your folder %s, so the folder is never touched"
                 % (origin, local))
    return origin


def url_repo_name(url):
    """A repository name from its URL: the last part, without .git, made to fit the name rule."""
    return repo_slug(re.sub(r"\.git$", "", os.path.basename((url or "").rstrip("/").replace(":", "/"))))


def init_wanted(ctx, a):
    """[(name, url as given, from --project)] from --repo name=url (repeatable) and --project url (the project's one
    repository, named after --project-name or the URL)."""
    wanted = []
    for spec in getattr(a, "repo_specs", None) or []:
        name, sep, url = (spec or "").partition("=")
        name, url = name.strip(), url.strip()
        if not sep or not url:
            raise FxError("--repo %s: write it as --repo <name>=<git URL or local folder>" % spec, code=3)
        why = repo_name_problem(name)
        if why:
            raise FxError("--repo %s: %s" % (spec, why), code=3)
        wanted.append((name, url, False))
    if getattr(a, "project", None) and a.project.strip():
        url = a.project.strip()
        name = repo_slug(a.project_name) if getattr(a, "project_name", None) else url_repo_name(url)
        wanted.append((name, url, True))
    seen = set()
    for name, url, _ in wanted:
        if url.startswith("-"):
            raise FxError("%s: %r is not a git URL or a folder" % (name, url), code=3)
        if name in seen:
            raise FxError("two repositories are named %s: each needs its own name" % name, code=3)
        seen.add(name)
    return wanted


def init_convert(ctx, cfg, entry, notes, moved):
    """An old factory.json (or an import) into the repository's entry: its per-repository settings (CONVERT_KEYS), its
    checks.sh and its flat knowledge files (FLAT_REPO_KNOWLEDGE) become that repository's."""
    name = entry["name"]
    found, base = dotted_pop(cfg, "base_branch")  # an import's
    if found and base:
        entry["base_branch"] = base
    for key in CONVERT_KEYS:  # over the blanks init gives a new entry
        found, v = dotted_pop(cfg, key)
        have = dotted_get(entry, key, _MISSING)
        if found and (have is _MISSING or have in ("", [], None)):
            dotted_set(entry, key, v)
        elif found and isinstance(have, dict) and isinstance(v, dict):
            dotted_set(entry, key, merge_settings(have, v))
    acc = dotted_get(entry, "app.accounts_file")
    if isinstance(acc, str) and re.sub(r"^factory/", "", acc) == "knowledge/environment.md":
        entry["app"]["accounts_file"] = "knowledge/%s/environment.md" % name
    dst = os.path.join("checks", "%s.sh" % name)
    if os.path.isfile(os.path.join(ctx.factory, "checks.sh")):
        if os.path.exists(os.path.join(ctx.factory, dst)):
            notes.append("checks.sh was left where it is: %s exists already; merge them by hand and delete checks.sh"
                         % dst)
        else:
            moved.append(factory_move(ctx, "checks.sh", dst))
    kd = knowledge_dir(ctx)
    for fname in FLAT_REPO_KNOWLEDGE:
        src_rel = os.path.join("knowledge", fname)
        if not os.path.isfile(os.path.join(ctx.factory, src_rel)):
            continue
        dst_rel = os.path.join("knowledge", name, fname)
        if os.path.exists(os.path.join(ctx.factory, dst_rel)):
            notes.append("%s was left where it is: %s exists already" % (src_rel, dst_rel))
            continue
        moved.append(factory_move(ctx, src_rel, dst_rel))
    if any(m.split()[-1].startswith("knowledge/") for m in moved) and os.path.isfile(os.path.join(kd, "README.md")):
        notes.append("the knowledge files of %s moved into knowledge/%s/: update the index knowledge/README.md where "
                     "it names them" % (name, name))


def init_initial_commit(ctx, name, base):
    """An empty first commit on base in a repository with no commits yet (asked of the user first)."""
    tmp = os.path.join(ctx.work, "_init-%s" % name)
    clone_project(ctx, tmp, repo=name)
    try:
        git(["checkout", "-q", "-b", base], tmp, check=False)
        git(["commit", "-q", "--allow-empty", "-m", "Initial commit"], tmp)
        git(["push", "-q", REMOTE, "HEAD:refs/heads/%s" % base], tmp)
        return {"branch": base, "commit": git(["rev-parse", "--short", "HEAD"], tmp).stdout.strip(),
                "note": "an empty commit: no files were added to the project"}
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_init(ctx, a):
    """Set up this factory repository for one project of one or more repositories: factory.json (repos[]), a checks
    script per repository (checks/<repo>.sh), knowledge/ (shared files, and knowledge/<repo>/ per repository), logic/,
    .gitignore and this user's .claude/settings.local.json. Run again to add repositories, or to bring an older
    factory.json (one project.url) to this form: same keys folder, checks.sh and the repository's knowledge files moved.
    The project's repositories are never changed (except, with --initial-commit and the user's permission, an empty
    first commit in an empty one)."""
    cfg_path = os.path.join(ctx.factory, CONFIG_NAME)
    if not os.path.exists(cfg_path):
        # The principle: the factory never lives inside a project.
        src = [f for f in list_files(ctx.factory) if is_source(f)]
        if src:
            raise FxError("%s holds code (%s). The factory must live in its own repository, separate from the "
                          "project: create an empty private repository (for example <project>-factory), open it "
                          "in Claude Code and run /code-factory:factory init there with the project's git URLs."
                          % (ctx.factory, ", ".join(src[:3])), code=3)
    notes, moved = [], []
    outer = git_toplevel(os.path.dirname(ctx.work))
    if outer and os.path.realpath(outer) != os.path.realpath(ctx.factory):
        raise FxError("the work folder %s would be inside the git repository %s, so job clones would land in it. "
                      "Keep the factory repository outside any other repository (or set work_dir in factory.json "
                      "to a folder outside it)" % (ctx.work, outer), code=3)

    tdir = os.path.join(SKILL_DIR, "templates")
    created = []
    fresh = not os.path.exists(cfg_path)
    cfg = json.loads(json.dumps(json.loads(read(os.path.join(tdir, "config.json"))) if fresh else ctx.cfg))
    before = None if fresh else json.dumps(cfg, sort_keys=True)
    if not isinstance(cfg.get("project"), dict):
        cfg["project"] = {}
    proj = cfg["project"]
    old_form = "repos" not in cfg
    old_url = proj.get("url") if old_form else None
    wanted = init_wanted(ctx, a)
    if not wanted and not old_url and not cfg.get("repos"):
        raise FxError("give the project's repositories: fx init --project-name <name> --repo <name>=<git URL> "
                      "(repeatable; a local folder means its remote)", code=3)
    mine = run_sep(["git", "remote", "get-url", REMOTE], cwd=ctx.factory).stdout.strip()

    # The repositories already there: an old factory.json's one (its keys folder kept), else its repos list.
    repos = []
    if old_form and old_url:
        if not keys_id_valid(cfg.get("keys_id")):
            cfg["keys_id"] = keys_id_for(proj.get("name") or os.path.basename(ctx.factory), old_url)
        repos.append({"name": repo_slug(proj.get("name")), "url": old_url})
        found, base = dotted_pop(cfg, "base_branch")
        if found and base:
            repos[0]["base_branch"] = base
    elif not old_form:
        repos = [dict(r) for r in cfg.get("repos") or [] if isinstance(r, dict)]
    added, heads_of = [], {}
    for name, given, shorthand in wanted:
        url = project_remote_url(ctx, given, notes)
        if same_repo(url, mine) or (os.path.isdir(url) and os.path.realpath(url) == os.path.realpath(ctx.factory)):
            raise FxError("the repository %s is this factory repository itself (%s); the factory needs its own "
                          "repository, apart from the project's" % (name, url), code=3)
        same_url = [r for r in repos if same_repo(r.get("url"), url) or r.get("url") == url]
        if shorthand and repos:
            if same_url:
                continue  # --project names the project's repository it has already
            raise FxError("--project names the only repository of a project, and this factory has %s already: add "
                          "another repository with --repo <name>=<git URL>" % ", ".join(r["name"] for r in repos),
                          code=3)
        have = next((r for r in repos if r.get("name") == name), None)
        twin = next((r for r in same_url if r is not have), None)
        if twin:
            raise FxError("%s has the URL of the repository %s (%s): each repository of the project is listed once, "
                          "under one name (its jobs know it by that name)" % (name, twin["name"], url), code=3)
        if have:
            if not same_url:
                raise FxError("the factory has a repository named %s already, at %s: choose another name for %s"
                              % (name, have.get("url"), given), code=3)
            continue
        heads_of[name] = remote_heads(url)
        repos.append({"name": name, "url": url, "base_branch": heads_of[name][1] or "main", "setup": "",
                      "app": {"up": "", "needs": [], "env": {}}, "e2e": "", "copy_into_worktree": [],
                      "protected_paths": []})
        added.append(name)
    if not repos:
        raise FxError("give the project's repositories: fx init --project-name <name> --repo <name>=<git URL>",
                      code=3)
    imported = import_old_layout(ctx, a.import_from, cfg, notes) if a.import_from else []  # once nothing is refused
    converting = bool(old_form and repos[:1] and repos[0].get("url") == old_url or imported)
    if isinstance(cfg.pop("workspace", None), dict):
        notes.append("the workspace block left factory.json: the project's repositories are all in repos now")
    if getattr(a, "project_name", None) and a.project_name.strip():
        proj["name"] = a.project_name.strip()
    if not proj.get("name"):
        proj["name"] = re.sub(r"\.git$", "", os.path.basename(repos[0]["url"].rstrip("/").replace(":", "/")))
    if not keys_id_valid(cfg.get("keys_id")):
        cfg["keys_id"] = keys_id_for(proj["name"], repos[0]["url"])  # written once, never changed (keys_id)
    for r in repos:  # every remote answers before anything moves
        heads_of[r["name"]] = heads_of.get(r["name"]) or remote_heads(r["url"])
    if converting:
        init_convert(ctx, cfg, repos[0], notes, moved)
    for r in repos:  # each base branch is one the remote has (an empty repository: main until its first commit)
        heads, default = heads_of[r["name"]]
        if not r.get("base_branch") or heads and r["base_branch"] not in heads and default:
            if r.get("base_branch"):
                notes.append("%s: base_branch %s is not on the remote; set to its default branch %s"
                             % (r["name"], r["base_branch"], default))
            r["base_branch"] = default or "main"
    if old_form:
        if isinstance(cfg.get("review"), dict):  # merge-request review's settings: it still reads the old keys
            notes.append("project.url and base_branch stay at the top of factory.json as well, for the reviews of "
                         "merge requests that share this factory repository; code-factory reads repos[]")
            cfg["base_branch"] = repos[0]["base_branch"]
        else:
            proj.pop("url", None)
    cfg["repos"] = repos
    if added:  # room in each job's block of ports for every repository's app, the agents' 3 and the candidates' apps
        ports = cfg.get("ports") if isinstance(cfg.get("ports"), dict) else {}
        best = int(cfg.get("best_of_max", 4) or 4) if str(cfg.get("best_of_max", 4) or 4).isdigit() else 4
        need = max(10, len(repos) + 3 + len(repos) * max(1, best))
        try:
            step = int(ports.get("step") or 0)
        except (TypeError, ValueError):
            step = 0
        if step and step < need:
            ports["step"] = need
            notes.append("ports.step raised from %d to %d: each job's block of ports holds the apps of %d "
                         "repositories, the agents' 3 and the best-of-N candidates' apps" % (step, need, len(repos)))
    ordered = {k: cfg[k] for k in ("_doc", "project", "_doc_project", "keys_id", "_doc_keys_id", "repos", "_doc_repos")
               if k in cfg}
    ordered.update((k, v) for k, v in cfg.items() if k not in ordered)
    if fresh or json.dumps(ordered, sort_keys=True) != before:
        write_atomic(cfg_path, json.dumps(ordered, indent=2, ensure_ascii=False) + "\n")  # only when it changed
        if fresh:
            created.append(CONFIG_NAME)
    ctx.load_config(True)
    if ctx.repo_problems:
        notes += ctx.repo_problems

    # Each repository's checks script and knowledge folder; the shared knowledge and logic/.
    for r in ctx.repos:
        rel = os.path.join("checks", "%s.sh" % r["name"])
        if not os.path.exists(os.path.join(ctx.factory, rel)):
            os.makedirs(os.path.join(ctx.factory, "checks"), exist_ok=True)
            shutil.copy2(os.path.join(tdir, "checks.sh"), os.path.join(ctx.factory, rel))
            created.append(rel)
        os.chmod(os.path.join(ctx.factory, rel), 0o755)
    kd = knowledge_dir(ctx)
    legacy = os.path.exists(os.path.join(ctx.factory, "knowledge.md")) and not os.path.isdir(kd)
    if not legacy:
        if not os.path.exists(os.path.join(kd, "README.md")) and not os.path.isdir(kd):
            os.makedirs(kd)
            shutil.copy2(os.path.join(tdir, "knowledge", "README.md"), os.path.join(kd, "README.md"))
            created.append("knowledge/")
        for r in ctx.repos:
            rd = os.path.join(kd, r["name"])
            if not os.path.exists(os.path.join(rd, "README.md")):
                os.makedirs(rd, exist_ok=True)
                text = (read(os.path.join(tdir, "knowledge", "_repo-README.md"), "") or "").replace("{repo}", r["name"])
                if any(n.endswith(".md") for n in os.listdir(rd)):  # its files moved here: written already
                    text = "".join(l for l in text.splitlines(True) if "FACTORY_TODO" not in l)
                write_atomic(os.path.join(rd, "README.md"), text)
                created.append("knowledge/%s/" % r["name"])
    if not os.path.isdir(logic_dir(ctx)):
        os.makedirs(logic_dir(ctx))
        for name in ("README.md", "shared.md"):
            shutil.copy2(os.path.join(tdir, "logic", name), os.path.join(logic_dir(ctx), name))
        created.append("logic/")
    bl_cfg = baselines_config(ctx)
    ignored = ensure_gitignore(ctx, ["jobs/", "baseline.json", "local/", ".claude/settings.local.json"] + (
        [bl_cfg["dir"] + "/"] if bl_cfg and bl_cfg["repo"] == "factory" else []))

    path = local_settings_path(ctx)
    raw = read(path)
    try:
        data = json.loads(raw) if raw and raw.strip() else {}
    except ValueError:
        raise FxError("%s is not valid JSON; fix it by hand first" % path)
    env = data.setdefault("env", {})
    for k, v in LOCAL_ENV.items():
        env.setdefault(k, v)
    perms = data.setdefault("permissions", {})
    allow = perms.setdefault("allow", [])
    allow[:] = [r for r in allow if not older_fx_rule(r)]
    for rule in ["Bash(%s *)" % FX_CMD] + LOCAL_ALLOW:
        if rule not in allow:
            allow.append(rule)
    deny = perms.setdefault("deny", [])
    for rule in LOCAL_DENY + key_deny_rules(ctx):
        if rule not in deny:
            deny.append(rule)
    dirs = perms.setdefault("additionalDirectories", [])
    if ctx.work not in [os.path.normpath(os.path.expanduser(d)) for d in dirs]:
        dirs.append(ctx.work)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_atomic(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.makedirs(ctx.work, exist_ok=True)

    rows = []
    for r in ctx.repos:
        n = r["name"]
        heads = heads_of.get(n, ({}, None))[0]
        base = ctx.rc(n, "base_branch", "main")
        first = None
        if a.initial_commit and not heads:
            first = init_initial_commit(ctx, n, base)
            heads = {base: "?"}
        missing = [f for f in ctx.rc(n, "copy_into_worktree", []) or [] if not local_file_source(ctx, f, n)]
        if missing:
            notes.append("files every clone of %s needs are missing from %s (or %s): %s (put them there; never commit "
                         "secrets)" % (n, os.path.join(ctx.factory, "local", n), copy_source(ctx, n), ", ".join(missing)))
        rows.append({"name": n, "url": r["url"], "base_branch": base, "added": n in added, "has_commits": bool(heads),
                     "greenfield": not heads, "initial_commit": first,
                     "checks": os.path.join("checks", "%s.sh" % n), "knowledge": os.path.join(kd, n)})
    res = {"ok": True, "factory": ctx.factory, "project": ctx.c("project.name"), "keys_id": keys_id(ctx),
           "repos": rows, "added": added, "converted": bool(converting), "moved": moved, "work_dir": ctx.work,
           "created": created, "imported": imported, "gitignore_added": ignored, "knowledge_dir": kd,
           "local_settings": path, "version": VERSION, "notes": notes,
           "next": "fill each repository's checks/<repo>.sh and entry in factory.json, then doctor; commit the "
                   "factory repository",
           "note": "start a new Claude Code conversation afterwards so the new settings take effect"}
    if len(rows) == 1:  # a project of one repository: the single keys of before too
        res.update(project_url=rows[0]["url"], has_commits=rows[0]["has_commits"], greenfield=rows[0]["greenfield"],
                   base_branch=rows[0]["base_branch"], initial_commit=rows[0]["initial_commit"])
    out(res)


def free_slot(ctx, job_id):
    """Lowest slot not used by another active job, whose block of ports overlaps no other active job's stored block. A
    slot is a block of ports.step ports from ports.base + step*slot: one per repository of the job (job_port), the
    agents' own after them. A job keeps the port its block starts at and the step it got (port_span): after ports.step or
    ports.base changed, its block is where it was, not where its slot would be now."""
    used, blocks = set(), []
    step = ports_step(ctx)
    for other in ctx.list_ids():
        if other == job_id:
            continue
        try:
            oj = ctx.load_exact(other)
        except (FxError, ValueError):
            continue
        if oj.get("stage") not in TERMINAL:
            used.add(oj.get("slot"))
            if oj.get("port") is not None:
                with contextlib.suppress(TypeError, ValueError):
                    lo = int(oj["port"])
                    blocks.append((lo, lo + max(int(oj.get("port_span") or 0), step)))
    base, slot = ports_base(ctx), 1
    while slot in used or any(lo < base + step * (slot + 1) and base + step * slot < hi for lo, hi in blocks):
        slot += 1
    return slot, base + step * slot


KNOWLEDGE_ROLES = {
    "overview.md": "*", "domain.md": "*", "rules.md": "*", "definition-of-done.md": "*",
    "architecture.md": "spec planner builder code approver judge fit",
    "conventions.md": "planner builder security code ux ui approver judge",
    "stack.md": "planner builder security verifier code ux ui approver judge fit",
    "api.md": "spec planner builder code security verifier approver judge fit",
    "security.md": "intake spec builder security verifier approver",
    "ui.md": "spec builder ux ui",
    "environment.md": "builder security code ux ui approver judge",
    "style.md": "spec builder code ui judge",
    "testing.md": "spec planner builder code judge",
}


def knowledge_dir(ctx):
    return os.path.join(ctx.factory, "knowledge")


def knowledge_flat(ctx):
    """An older factory's one flat knowledge/: a project of one repository with no knowledge/<repo>/ yet, whose
    repository files (architecture.md, style.md…) sit with the shared ones and count as that repository's."""
    return len(ctx.repos) <= 1 and not any(os.path.isdir(os.path.join(knowledge_dir(ctx), n))
                                           for n in ctx.repo_names())


def repo_knowledge_dir(ctx, name=None):
    """A repository's knowledge: knowledge/<repo>/, or knowledge/ itself when it is flat (knowledge_flat)."""
    if knowledge_flat(ctx):
        return knowledge_dir(ctx)
    return os.path.join(knowledge_dir(ctx), ctx.repo_name(name))


def knowledge_rel(ctx, fname, repo=None):
    """Where a knowledge file of this name is, relative to knowledge/: a repository's own (REPO_KNOWLEDGE) in its
    folder, any other shared at the top."""
    if fname in REPO_KNOWLEDGE and fname != "README.md" and not knowledge_flat(ctx) and ctx.repos:
        return "%s/%s" % (ctx.repo_name(repo), fname)
    return fname


def knowledge_link_roots(ctx):
    """Folders a knowledge or logic file may link to by a relative name: knowledge/ and each knowledge/<repo>/."""
    kd = knowledge_dir(ctx)
    return (kd,) + tuple(os.path.join(kd, n) for n in ctx.repo_names() if os.path.isdir(os.path.join(kd, n)))


def knowledge_role_files(d, agent):
    """A knowledge folder's files for a role: its index first, then the files meant for this role, then any extra file
    the team added."""
    files = []
    if not os.path.isdir(d):
        return files
    idx = os.path.join(d, "README.md")
    if os.path.exists(idx):
        files.append(idx)
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        if name == "README.md" or not name.endswith(".md") or not os.path.isfile(path):
            continue
        roles = KNOWLEDGE_ROLES.get(name, "*")
        if roles == "*" or agent in roles.split():
            files.append(path)
    return files


def knowledge_files(ctx, agent, repos=None):
    """The shared files of knowledge/ for this role, then knowledge/<repo>/'s for each of repos (None: every repository
    of the project). In an old flat folder, the files of the one repository sit with the shared ones, and count."""
    d = knowledge_dir(ctx)
    files = knowledge_role_files(d, agent)
    for n in ctx.repo_names() if repos is None else repos:
        if n in ctx.repo_names():
            files += knowledge_role_files(os.path.join(d, n), agent)
    legacy = os.path.join(ctx.factory, "knowledge.md")
    if os.path.exists(legacy):
        files.append(legacy)
    return files


def knowledge_status(ctx):
    d = knowledge_dir(ctx)
    texts = []
    for sub in [d] + [os.path.join(d, n) for n in ctx.repo_names()]:
        if os.path.isdir(sub):
            texts += [read(os.path.join(sub, n), "") or "" for n in os.listdir(sub) if n.endswith(".md")]
    legacy = read(os.path.join(ctx.factory, "knowledge.md"))
    if legacy:
        texts.append(legacy)
    written = [t for t in texts if t.strip() and "FACTORY_TODO" not in t]
    return bool(texts) and not any("FACTORY_TODO" in t for t in texts) and len(written) >= 2


def lessons_file(ctx):
    p = os.path.join(ctx.factory, "lessons.md")
    return p if os.path.exists(p) else None


def lessons_kept(text, agent=None):
    """lessons.md as this agent reads it, and how many lessons that leaves out: untagged ones and those whose topics it
    works on (every topic without an agent), never a [review] one (REVIEW_TAG). A lesson left out takes the indented
    lines under it along."""
    ents = {e["line"]: e for e in lesson_entries(text)}
    keep, dropped, left_out = [], 0, False
    lines = text.splitlines()
    for i, line in enumerate(lines):
        e = ents.get(i)
        if left_out and not e:
            if line.strip() and line[:1].isspace():
                continue  # indented under a lesson left out: part of it
            if not line.strip() and next((l for l in lines[i + 1:] if l.strip()), "")[:1].isspace():
                continue  # a blank line inside it, before more of its indented lines
        left_out = False
        if e and (REVIEW_TAG in e["tags"] or agent and e["tags"] and "all" not in e["tags"] and
                  not any(agent in LESSON_TOPICS.get(t, ()) for t in e["tags"])):
            dropped += 1
            left_out = True
            continue
        keep.append(line)
    if not dropped:
        return text, 0
    tidy = []
    for i, line in enumerate(keep):  # drop a dated heading whose lessons all went
        if line.startswith("## "):
            rest = next((l for l in keep[i + 1:] if l.strip()), "")
            if not rest.startswith("- "):
                continue
        tidy.append(line)
    return "\n".join(tidy).strip("\n") + "\n", dropped


def lessons_for(ctx, agent, job=None, folder=None):
    """The lessons this agent needs (lessons_kept; every topic for the librarian, which reads them for context). The
    whole file when nothing is left out, else a filtered copy in the job folder or in folder (ids kept, so reviewers can
    still cite them)."""
    path = lessons_file(ctx)
    if not path:
        return None
    text, dropped = lessons_kept(read(path, "") or "", None if agent == "librarian" else agent)
    if not dropped:
        return path
    dst = os.path.join(folder or ctx.job_dir(job["id"]), "lessons-%s.md" % agent)
    write_atomic(dst, "<!-- Lessons for the %s: filtered by topic from %s (%d of the others left out). -->\n%s"
                 % (agent, path, dropped, text))
    return dst


def several_repos(job):
    """A repository's view of a job of several repositories: its app, database and logs carry its name."""
    return bool(job.get("repo")) and len(job_order(job)) > 1


def app_db(ctx, job):
    """The database of a job's app ({db}): app.db_template, and in a job of several repositories each one's own."""
    ctx, job = one_app(ctx, job)
    t = ctx.c("app.db_template", "factory_{job}") or "factory_{job}"
    if several_repos(job) and "{repo}" not in t:
        t += "_{repo}"
    return re.sub(r"[^a-z0-9_]", "_", t.replace("{job}", job["id"]).replace("{repo}", job.get("repo") or "").lower())


# Credentials of the session (Jira, gh, glab, the session's model keys): project code and agent scripts never see them.
# fx's own Jira token is never in an environment: mode token reads it from jira.env.
SECRET_ENV_NAMES = {"GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN", "GITLAB_TOKEN",
                    "GITLAB_PRIVATE_TOKEN", "GITLAB_ACCESS_TOKEN", "CI_JOB_TOKEN", "CI_JOB_JWT", "CI_REGISTRY_PASSWORD",
                    "BITBUCKET_TOKEN", "BITBUCKET_APP_PASSWORD", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN",
                    "CLAUDE_CODE_OAUTH_TOKEN"}
SECRET_ENV_GLOBS = ["JIRA_*", "GLAB_*", "ATLASSIAN_*", "CONFLUENCE_*", "GH_*TOKEN*", "GITHUB_*TOKEN*",
                    "GITLAB_*TOKEN*", "BITBUCKET_*TOKEN*"]


def secret_env_name(ctx, name):
    extra = (ctx.c("security.strip_env", []) if ctx else []) or []
    return name in SECRET_ENV_NAMES or any(fnmatch.fnmatchcase(name, g) for g in SECRET_ENV_GLOBS + list(extra))


def project_env(ctx, **extra):
    """os.environ without the session's credentials, for everything that runs project or agent code: setup, checks.sh,
    app.up/down, e2e, seed.sh, ui/check.js, app.schema and the scanners (their git runs on the agent's clone).
    fx keeps them for its own gh and glab calls. security.pass_env lets through a name the project needs;
    security.strip_env adds names or globs to strip."""
    keep = set((ctx.c("security.pass_env", []) if ctx else []) or [])
    env = {k: v for k, v in os.environ.items() if k in keep or not secret_env_name(ctx, k)}
    env.update({k: str(v) for k, v in extra.items()})
    return env


def url_env_name(name):
    """FACTORY_URL_<NAME>: a repository's app URL for the apps started after it."""
    return "FACTORY_URL_" + re.sub(r"[^A-Z0-9]", "_", name.upper())


def apps_before(job):
    """The apps of the job started before this repository's: {name: URL}."""
    apps, name = job.get("apps") or [], job.get("repo")
    before = apps[:apps.index(name)] if name in apps else [n for n in apps if n != name]
    return {n: job["urls"][n] for n in before if n in (job.get("urls") or {})}


def app_env(ctx, job):
    """The environment of a repository's app and of what runs against it (seed.sh, e2e, security.zap_auth): its port and
    database, the URLs of the apps started before it and its own (FACTORY_URL_<NAME>, and all of them as JSON
    {name: URL} in FACTORY_APP_URLS), and its app.env with {url:<repo>}, {port}, {db} and {job}."""
    ctx, job = one_app(ctx, job)
    db = app_db(ctx, job)
    compose = "factory_" + re.sub(r"[^a-z0-9]", "_", job["id"].lower())
    if several_repos(job):
        compose += "_" + re.sub(r"[^a-z0-9]", "_", job["repo"])
    extra = dict(FACTORY_JOB=job["id"], FACTORY_PORT=str(job["port"]), PORT=str(job["port"]),
                 **baselines_env(ctx, job.get("worktree") or ""))
    extra.update(FACTORY_DB=db, COMPOSE_PROJECT_NAME=compose)
    urls = dict(apps_before(job))
    if job.get("repo"):  # its own too: FACTORY_URL_<SELF>, and every URL at once for a command that logs in somewhere
        urls[job["repo"]] = (job.get("urls") or {}).get(job["repo"]) or "http://127.0.0.1:%d" % int(job["port"])
    extra.update({url_env_name(n): u for n, u in urls.items()})
    extra["FACTORY_APP_URLS"] = json.dumps(urls, sort_keys=True)
    own = ctx.rc(job["repo"], "app.env", {}) if job.get("repo") in ctx.repo_names() else {}
    if own and not isinstance(own, dict):
        raise FxError("app.env of %s must be an object of NAME: value" % job["repo"], code=3)
    for k, v in (own or {}).items():
        extra[str(k)] = app_fill(str(v), job, db, strict="app.env of %s" % job["repo"])
    return project_env(ctx, **extra), db


def app_fill(cmd, job, db, strict=None):
    """{port}, {db}, {job} and {url:<repo>} (the URL of that repository's app in this job). strict: what to name when a
    {url:<repo>} is not one of the job's apps (else it stays as it is)."""
    text = cmd.replace("{port}", str(job["port"])).replace("{db}", db).replace("{job}", job["id"])

    def url(m):
        u = (job.get("urls") or {}).get(m.group(1))
        if u is None and strict:
            raise FxError("%s names {url:%s}, which is not an app this job runs (%s)" % (
                strict, m.group(1), ", ".join(job.get("apps") or []) or "none"), code=3)
        return u if u is not None else m.group(0)
    return re.sub(r"\{url:([a-z][a-z0-9-]*)\}", url, text)


def app_url(ctx, job, path=None):
    ctx, job = one_app(ctx, job)
    path = path if path is not None else (ctx.c("app.health", "/") or "/")
    return "http://127.0.0.1:%d%s" % (job["port"], path if path.startswith("/") else "/" + path)


def http_up(url):
    try:
        with urllib.request.urlopen(url, timeout=3):
            return True
    except urllib.error.HTTPError as e:
        return e.code < 500
    except Exception:  # noqa: BLE001
        return False


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def app_home(ctx, job):
    """Where the app's state and log live: the job folder, or a best-of-N candidate's ui-cK/ folder."""
    return job.get("app_dir") or ctx.job_dir(job["id"])


def app_file(job, name):
    """app.json, app.log: in a job of several repositories, app-<repo>.json and app-<repo>.log."""
    if several_repos(job):
        base, ext = os.path.splitext(name)
        return "%s-%s%s" % (base, job["repo"], ext)
    return name


def app_state_path(ctx, job):
    ctx, job = one_app(ctx, job)
    return os.path.join(app_home(ctx, job), app_file(job, "app.json"))


def app_of(job):
    """How messages name an app: "the app", or "the app of <repo>" in a job of several repositories."""
    return "the app of %s" % job["repo"] if several_repos(job) else "the app"


def app_stop_one(ctx, job):
    """Stop one repository's app: the configured down command, then the process group we started."""
    st = {}
    try:
        st = json.loads(read(app_state_path(ctx, job), "{}") or "{}")
    except ValueError:
        pass
    env, db = app_env(ctx, job)
    down = ctx.c("app.down")
    if down and os.path.isdir(job.get("worktree") or ""):
        try:
            run(["bash", "-lc", app_fill(down, job, db)], cwd=job["worktree"], check=False, env=env, timeout=180)
        except subprocess.TimeoutExpired:
            pass
    pid = st.get("pid")
    if pid and pid_alive(pid):
        for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
            try:
                os.killpg(int(pid), sig)
            except OSError:
                break
            t0 = time.time()
            while time.time() - t0 < wait and pid_alive(pid):
                time.sleep(0.2)
            if not pid_alive(pid):
                break
    if os.path.exists(app_state_path(ctx, job)):
        os.remove(app_state_path(ctx, job))
    return {"stopped": True}


def app_start_one(ctx, job):
    """Start one repository's app on its port, in its clone, or reuse it when fx started it and it answers."""
    up = ctx.c("app.up")
    if not up:
        raise FxError("no app.up command in factory.json%s; set it with /code-factory:factory init" % (
            " for %s" % job["repo"] if several_repos(job) else ""), code=3)
    if not os.path.isdir(job.get("worktree") or ""):
        raise FxError("the worktree %s is missing" % (job.get("worktree") or "of the job (none yet)"), code=3)
    url = app_url(ctx, job)
    try:
        st = json.loads(read(app_state_path(ctx, job), "{}") or "{}")
    except ValueError:
        st = {}
    if (st.get("detached") or (st.get("pid") and pid_alive(st["pid"]))) and http_up(url):
        return {"url": app_url(ctx, job, "/"), "health": url, "reused": True, "log": st.get("log")}
    with socket.socket() as probe:  # else that is what answers below, and every check of the running app reads it
        probe.settimeout(2)
        if probe.connect_ex(("127.0.0.1", int(job["port"]))) == 0:
            raise FxError("port %s already answers, and fx did not start that, so the checks would look at it instead of "
                          "this job's app. Stop it (lsof -nP -iTCP:%s -sTCP:LISTEN) and run this again"
                          % (job["port"], job["port"]), code=3)
    env, db = app_env(ctx, job)
    os.makedirs(app_home(ctx, job), exist_ok=True)
    log = os.path.join(app_home(ctx, job), app_file(job, "app.log"))
    fh = open(log, "ab")
    fh.write(("\n==== %s starting: %s\n" % (now(), app_fill(up, job, db))).encode())
    fh.flush()
    p = subprocess.Popen(["bash", "-lc", app_fill(up, job, db)], cwd=job["worktree"], env=env,
                         stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    write_atomic(app_state_path(ctx, job), json.dumps({"pid": p.pid, "started": now(), "log": log, "db": db}))
    limit = int(ctx.c("app.start_timeout_sec", 180))
    t0 = time.time()
    while time.time() - t0 < limit:
        if http_up(url):
            if p.poll() == 0:  # app.up may exit after starting containers: the app is still the one fx started
                write_atomic(app_state_path(ctx, job), json.dumps({"pid": p.pid, "detached": True, "started": now(), "log": log, "db": db}))
            return {"url": app_url(ctx, job, "/"), "health": url, "reused": False, "log": log, "db": db}
        rc = p.poll()
        if rc not in (None, 0):
            break
        time.sleep(1)
    tail = "\n".join((read(log, "") or "").splitlines()[-30:])
    app_stop_one(ctx, job)
    raise FxError("%s did not come up at %s within %ss; last lines of %s:\n%s" % (app_of(job), url, limit, log, tail),
                  code=3, extra={"log": log})


def apps_up(ctx, job):
    """Start the job's apps (job_apps) in order, each in its clone or run-only checkout, on its port with its database and
    the URLs of those started before it; {name: what app_start_one says}. When one cannot start, the ones started are
    stopped and the error names it."""
    if not is_whole_job(job):
        rctx, v = one_app(ctx, job)
        return {v.get("repo"): app_start_one(rctx, v)}
    apps = job_apps(ctx, job)
    if not apps:
        rctx, v = one_app(ctx, job)
        return {v.get("repo"): app_start_one(rctx, v)}  # says what is missing
    started = {}
    for n in apps:
        try:
            if n not in job["repos"]:
                raise FxError("the job has no clone of %s, whose app the others need: `%s repos %s --add %s`" % (
                    n, FX_CMD, job["id"], n), code=3)
            started[n] = app_start_one(repo_ctx(ctx, n), repo_view(ctx, job, n))
        except FxError:
            for m in reversed(list(started)):
                app_stop_one(repo_ctx(ctx, m), repo_view(ctx, job, m))
            raise
    return started


def app_start(ctx, job):
    """Start what the job runs. One app: what app_start_one says, as always. Several: the same for the last app the job
    changes (url), and every app under apps."""
    started = apps_up(ctx, job)
    if len(started) == 1:
        return next(iter(started.values()))
    change = [n for n in started if n in job_names(job, "change")] or list(started)
    return dict(started[change[-1]], apps=started)


def app_stop(ctx, job):
    """Stop what the job runs, in the reverse of the start order: its apps and any other app of it fx left running."""
    if not is_whole_job(job):
        rctx, v = one_app(ctx, job)
        return app_stop_one(rctx, v)
    known = ctx.repo_names()
    apps = [n for n in job_apps(ctx, job) if n in job["repos"]]
    for n in job_order(job):
        if n not in apps and n in known and os.path.exists(app_state_path(repo_ctx(ctx, n), repo_view(ctx, job, n))):
            apps.append(n)
    if not apps:  # none configured (or a job read without the factory's names): what one_app says, as always
        rctx, v = one_app(ctx, job)
        return app_stop_one(rctx, v)
    for n in reversed(apps):
        app_stop_one(repo_ctx(ctx, n), repo_view(ctx, job, n))
    return {"stopped": True}


def app_status(ctx, job):
    """Each app of the job: running (fx started it), its URL and whether it answers."""
    names = [n for n in job_apps(ctx, job) if n in job["repos"]] if is_whole_job(job) else [None]
    rows = {}
    for n in names or [None]:
        rctx, v = one_app(ctx, job, n)
        try:
            st = json.loads(read(app_state_path(rctx, v), "{}") or "{}")
        except ValueError:
            st = {}
        rows[v.get("repo")] = {"running": bool(st.get("pid") and pid_alive(st["pid"])), "url": app_url(rctx, v, "/"),
                               "healthy": http_up(app_url(rctx, v))}
    return rows


def cmd_app(ctx, a):
    job = ctx.load(a.job)
    if a.action == "up":
        r = app_start(ctx, job)
    elif a.action == "down":
        r = app_stop(ctx, job)
    elif a.action == "restart":
        app_stop(ctx, job)
        r = app_start(ctx, job)
    else:
        rows = app_status(ctx, job)
        r = next(iter(rows.values())) if len(rows) == 1 else {"apps": rows}
    out(dict(ok=True, job=job["id"], **r))


def checks_script(ctx, job=None, repo=None):
    """A repository's checks script in the factory repository (agents never change it; the gate requires it committed):
    checks/<repo>.sh, or checks.sh for an old factory of one repository. Without a repository: a view's (repo_view), else
    the job's first changed one."""
    if ctx.old_form:
        return os.path.join(ctx.factory, "checks.sh")
    name = repo or (job.get("repo") or job_primary(job) if job else None) or ctx.repo_name()
    return os.path.join(ctx.factory, "checks", "%s.sh" % name)


CHECKS_DIR = "checks"  # every file in it, at any depth: the scripts and whatever they source or read


def factory_settings_paths(ctx):
    """What in the factory repository decides a gate, as paths inside it: factory.json, checks.sh and the whole checks/
    folder (each repository's script and every helper file a script sources), and the scanner rules."""
    named = [ctx.c(k) for k in ("security.gitleaks_config", "security.osv_config") if ctx.c(k)] + semgrep_rules(ctx)
    inside = [posixpath.normpath(p) for p in named if not os.path.isabs(os.path.expanduser(p))]
    return [CONFIG_NAME, "checks.sh", CHECKS_DIR] + [p for p in inside if not p.startswith("..") and
                                                     os.path.exists(os.path.join(ctx.factory, p))]


def same_as_blob(path, mode, oid, crlf=True):
    """A file in the folder against a committed blob, by its bytes: filters and the index are not asked. crlf: a checkout
    with core.autocrlf is no change. Not for a script, where it is: a carriage return breaks `set -e` and `false`."""
    link = os.path.islink(path)
    if link != (mode == "120000"):
        return False
    if link:
        data = os.fsencode(os.readlink(path))
    else:
        with open(path, "rb") as f:
            data = f.read()
    algo = "sha256" if len(oid) == 64 else "sha1"
    forms = (data, data.replace(b"\r\n", b"\n")) if crlf else (data,)
    return oid in {hashlib.new(algo, b"blob %d\0" % len(d) + d).hexdigest() for d in forms}


RULE_FILE_EXTS = (".yml", ".yaml", ".json", ".jsonnet")  # what semgrep loads from a folder


def is_checks_script(name):
    """checks.sh or a file of checks/: compared byte for byte (a carriage return changes what a script does)."""
    return name == "checks.sh" or name.startswith(CHECKS_DIR + "/")


def factory_dirty(ctx):
    """How the factory's own settings differ from what is committed, a line for each: the gate refuses to run on that.
    By content too: an agent can tell git not to look (assume-unchanged, skip-worktree, a clean filter)."""
    root = ctx.factory
    if git(["rev-parse", "--verify", "-q", "HEAD"], root, check=False).returncode != 0:
        return ""
    paths = factory_settings_paths(ctx)
    lines = git(["status", "--porcelain", "--untracked-files=no", "--"] + paths + [".claude"], root,
                check=False).stdout.strip().splitlines()
    for line in git(["ls-files", "-v", "--"] + paths + [".claude"], root, check=False).stdout.splitlines():
        if line[:1] == "S" or line[:1].islower():
            lines.append("git is told not to look at %s" % line[2:])
    committed, submodules = {}, []
    for item in git(["ls-tree", "-r", "-z", "HEAD", "--"] + paths + [".claude"], root, check=False).stdout.split("\0"):
        meta, _, name = item.partition("\t")
        if name:
            mode, kind, oid = meta.split()
            if kind == "commit":  # git status above answers for a submodule
                submodules.append(name)
            else:
                committed[name] = (mode, oid)
    for name, (mode, oid) in committed.items():
        path = os.path.join(root, name)
        if not os.path.lexists(path) or os.path.isdir(path) or not same_as_blob(path, mode, oid, not is_checks_script(name)):
            lines.append("differs from what is committed: %s" % name)
    names = {unicodedata.normalize("NFC", n) for n in committed}
    for rel in paths:
        if any(rel == m or rel.startswith(m + "/") for m in submodules):
            continue
        found = [rel] if not os.path.isdir(os.path.join(root, rel)) else [
            os.path.relpath(os.path.join(d, n), root).replace(os.sep, "/")
            for d, _, files in os.walk(os.path.join(root, rel)) for n in files
            if (rel == CHECKS_DIR and n not in BASELINE_JUNK) or n.endswith(RULE_FILE_EXTS)]
        lines += ["not committed: %s" % n for n in found if unicodedata.normalize("NFC", n) not in names and
                  os.path.lexists(os.path.join(root, n))]
    return "\n".join(sorted(set(lines)))


def factory_unpushed(ctx):
    """The gate's settings as changed by commits no remote has. An agent can commit in this repository too; pushed, the team
    sees it. Fetched first, since refs/remotes can be written here too. Without a remote nobody can tell, and fx doctor
    says so; out of reach, what the repository last heard counts."""
    root = ctx.factory
    if git(["rev-parse", "--verify", "-q", "HEAD"], root, check=False).returncode != 0:
        return ""
    remotes = git(["remote"], root, check=False).stdout.split()
    if not remotes:
        return ""
    for remote in remotes:
        try:
            run(["git", "fetch", "-q", "--prune", remote], cwd=root, check=False, env=baselines_git_env(), timeout=45)
        except subprocess.TimeoutExpired:
            pass
    r = git(["log", "--name-only", "--format=", "HEAD", "--not", "--remotes", "--"] + factory_settings_paths(ctx) + [".claude"],
            root, check=False)
    return "\n".join(sorted({l for l in r.stdout.splitlines() if l.strip()})) if r.returncode == 0 else ""


def factory_changed_since(ctx, start):
    """Settings that commits made since start changed, for a gate that began there."""
    if not start or git(["rev-parse", "--verify", "-q", "HEAD"], ctx.factory, check=False).stdout.strip() == start:
        return ""
    return git(["diff", "--name-only", start, "HEAD", "--"] + factory_settings_paths(ctx) + [".claude"], ctx.factory,
               check=False).stdout.strip()


def factory_settings_refusal(ctx):
    """Why a gate cannot run on these settings, or None."""
    local = factory_dirty(ctx)
    if local:
        return ("the factory repository has uncommitted changes to the gate's settings (factory.json, checks.sh, scanner "
                "rules); commit or discard them first, so no agent can change the gate:\n" + local)
    ahead = factory_unpushed(ctx)
    if ahead:
        return ("commits only on this machine change the gate's settings; push them first, so the team sees what the gate "
                "checks, or drop them:\n" + ahead)
    return None


def history_rewrites(root, shallow=False):
    """What makes git show other objects or other parents than the commits have. fx's own git ignores the first two, but
    whatever else reads the clone may not, and a shallow boundary hides history from a scanner. A job's clone never brings
    any of them, so someone made them. (The factory repository may well be a shallow clone: shallow is for a job's.)"""
    r = git(["for-each-ref", "--format=%(refname)", "refs/replace/"], root, check=False)
    if r.returncode != 0:
        return []
    found = r.stdout.split()
    gitdir = git(["rev-parse", "--git-dir"], root).stdout.strip()
    for name in [os.path.join("info", "grafts")] + (["shallow"] if shallow else []):
        if os.path.exists(os.path.join(root, gitdir, name)):
            found.append(os.path.join(gitdir, name))
    return found


def history_rewrites_text(ctx, job):
    """The problem to report for the job's clones and the factory repository, or None."""
    parts = []
    if is_whole_job(job) and len(job_names(job, "change")) > 1:
        clones = [("the clone of %s" % n, job["repos"][n].get("worktree") or "", True) for n in job_names(job, "change")]
    else:
        clones = [("the job's clone", one_app(ctx, job)[1].get("worktree") or "", True)]
    for name, root, shallow in clones + [("the factory repository", ctx.factory, False)]:
        found = history_rewrites(root, shallow) if os.path.isdir(root) else []
        if found:
            parts.append("%s has %s" % (name, ", ".join(found[:5])))
    if not parts:
        return None
    return ("%s: they make git show history other than what the commits hold, so what fx checks is not what would be "
            "pushed. Remove them (git replace -d, delete the grafts file, git fetch --unshallow)" % "; ".join(parts))


def job_off_its_branch(job):
    """The gate reads HEAD and fx pr pushes the job's branch: why they might not be the same thing, or None."""
    on = git(["symbolic-ref", "--short", "-q", "HEAD"], job["worktree"], check=False).stdout.strip()
    if on == job["branch"]:
        return None
    return ("the job's clone is %s, not on the job's branch %s, so what the gate checks would not be what gets pushed: git "
            "checkout %s" % ("on %s" % on if on else "on a detached HEAD", job["branch"], job["branch"]))


def job_base_from_remote(ctx, job, repo=None):
    """Set the job's base ref to where the repository's remote has it. Everything that measures a job starts from that ref,
    and in a clone it is the builder's to write: moved back, the job's own commits look like the base's. Asks the URL in
    factory.json, not the clone's own remote. Stops (exit 3) when nobody can say. Without a repository: the job's first
    changed one."""
    name = repo or job_primary(job)
    e = job["repos"][name]
    branch = e["base_ref"].split("/", 1)[1]
    u = ctx.url(name)
    url = os.path.expanduser(u) if os.path.isdir(os.path.expanduser(u)) else u
    try:
        r = run(["git", "fetch", "-q", "--no-tags"] + clone_filter_args(ctx, name) + [
            url, "+refs/heads/%s:refs/remotes/%s" % (branch, e["base_ref"])], cwd=e["worktree"], check=False,
                env=baselines_git_env(), timeout=int(ctx.c("clone_timeout_sec", 1800)))
    except subprocess.TimeoutExpired:
        raise FxError("could not read the base branch %s from %s: timed out" % (branch, u), code=3)
    if r.returncode != 0:
        raise FxError("could not read the base branch %s from %s, and everything the gate checks is measured from it: %s" % (
            branch, u, (r.stdout or "")[-400:].strip()), code=3)


def latest_rework(ctx, job):
    jd = ctx.job_dir(job["id"])
    k = 0
    while os.path.exists(os.path.join(jd, "rework-%d.md" % (k + 1))):
        k += 1
    return os.path.join(jd, "rework-%d.md" % k) if k else None


def task_line(ctx, job, agent):
    jd = ctx.job_dir(job["id"])
    has_qa = os.path.exists(os.path.join(jd, "qa-log.md"))
    if agent == "intake":
        return "Run intake again. The human's answers are in qa-log.md." if has_qa else "Run intake."
    if agent == "spec":
        return "Write the spec." + (" The human's answers are in qa-log.md." if has_qa else "")
    if agent == "approver":
        return "Decide."
    if agent == "judge":
        return "Compare the candidates and pick one."
    if agent == "verifier":
        return ("Verify the blocking findings in round-%d/review-security.md and write round-%d/verify-security.md."
                % (job["round"], job["round"]))
    if agent in REVIEW_ROLES:
        return "Review."
    if agent == "planner":
        reqs = [(k, p_.get("request")) for k, p_ in ((job.get("split") or {}).get("packages") or {}).items()
                if p_.get("status") == "request"]
        if reqs:
            return ("Change requests from the builders (they stopped and wait for you): %s. Update plan.md "
                    "(owners, contract, a new or reopened package) so each can go on, keeping every file owned by "
                    "one package only." % "; ".join("%s: %s" % (k, (r or "")[:600]) for k, r in reqs))
        return "Plan the build."
    reason = job.get("build_reason") or "first"
    sp = job.get("split") or {}
    if sp.get("mode") == "split" and reason in ("first", "feedback", "answers"):
        extra = ""
        if reason == "feedback" and sp.get("integrator_feedback"):
            extra = " The round's findings no package owns are yours: %s." % sp["integrator_feedback"]
        return ("Integrate. The packages of plan.md were built in parallel and are merged into this branch (their "
                "reports: build-wp*.md).%s Run the checks on the whole, fix only what joins the packages or what "
                "is assigned to you (say whose code you touched and why), stage the logic updates, and write "
                "build.md for the whole job (its Read before changing list joins the packages' lists)." % extra)
    if reason == "feedback":
        n = job["round"]
        return ("Round %d feedback is in round-%d/: read checks.md and every review that starts with "
                "VERDICT: CHANGES. Fix every blocking finding, commit, and rewrite build.md." % (n, n))
    if reason == "answers":
        return ("The answers to your questions are in qa-log.md (latest round). Continue the build, "
                "commit, and rewrite build.md.")
    if reason == "secret" and len(job_names(job, "change")) > 1:
        hit = [n for n in job_names(job, "change") if job["repos"][n].get("secret_bounces")]
        return ("The secret scan before push found secrets in the commits of %s (see %s in the job folder); nothing "
                "was pushed in any repository. In each of them, remove them from the commits that are not on the remote "
                "yet: %s; take the secrets out (use configuration or environment variables), commit again, and rewrite "
                "build.md. Say in build.md which credentials a human must rotate." % (
                    ", ".join(hit) or "a repository", ", ".join("pr-scan/%s/security.md" % n for n in hit),
                    "; ".join("in %s's worktree `git reset --soft %s`" % (
                        n, (job["repos"][n].get("secret_reset_to") or "<merge-base>")[:12]) for n in hit)))
    if reason == "secret":
        return ("The secret scan before push found secrets in this branch's commits (see pr-scan/security.md in "
                "the job folder); nothing was pushed. Remove them from the commits that are not on the remote yet: "
                "`git reset --soft %s`, take the secrets out (use configuration or environment variables), commit "
                "again, and rewrite build.md. Say in build.md which credentials a human must rotate."
                % (job.get("secret_reset_to") or "<merge-base>")[:12])
    if reason == "rework":
        return ("Rework: read %s (the human's instruction; it takes priority over earlier reviews), "
                "address all of it, commit, and rewrite build.md." % (latest_rework(ctx, job) or "the rework file"))
    return "Build."


CTX_APP_AGENTS = ("builder", "ux", "ui", "code", "security", "verifier", "approver")


def ctx_repo_lines(ctx, job, agent, cand, wp):
    """The repos block of a prompt for a job of several repositories: each one's role, clone, branch, base, checks script
    and app URL. A best-of-N candidate sees its own clones, a package builder its package's."""
    apps = job_apps(ctx, job) if ctx.repos else []
    per = job_candidates(job).get(cand["k"]) if cand else None
    names = job_names(job, "change")
    look = agent not in ("builder",)
    lines = ["Repositories of this job, in merge order (%s; every changed one is on the same branch and gets its own "
             "pull request):" % ("read them, never change them" if look else
                                 "change only the ones whose role is change")]
    for n in job_order(job):
        e = job["repos"][n]
        wt, br = e.get("worktree"), e.get("branch")
        if per and n in per:
            wt, br = per[n]["worktree"], per[n]["branch"]
        mine = bool(wp and wp.get("repo") == n)
        if mine:
            wt, br = wp["clone"], wp["branch"]
        if e.get("role", "change") == "change":
            parts = ["%s: change%s" % (n, " (your package's repository and its own clone)" if mine else
                                       " (another package's: do not change it)" if wp else ""),
                     "worktree %s" % (wt or "-"), "branch %s" % (br or "-"), "base %s" % (e.get("base_ref") or "-"),
                     "checks script %s" % checks_script(ctx, job, n)]
        elif e.get("merged") and not wt:
            lines.append("- %s: merged (its pull request %s is merged into %s; this job no longer changes it, and has "
                         "no clone of it)" % (n, e.get("pr_url") or e.get("branch") or "-",
                                             e.get("target_branch") or e.get("base_branch") or "-"))
            continue
        else:
            parts = ["%s: run (a checkout of its base only to run its app; never change it)%s" % (
                         n, "; its pull request %s is merged" % (e.get("pr_url") or e.get("branch") or "")
                         if e.get("merged") else ""),
                     "worktree %s" % (wt or "-"), "base %s" % (e.get("base_branch") or "-")]
        if n in apps:
            port = (per[n].get("port") if per and n in per else None) or (
                candidate_block(ctx, job, cand["k"]) + job_order(job).index(n) if cand else job_port(ctx, job, n))
            parts.append("app http://127.0.0.1:%d" % port)
        elif n in names and ctx.rc(n, "dev_server") and agent in ("builder", "ux", "ui"):
            parts.append("dev server `%s` (run it in its worktree on your port)" % ctx.rc(n, "dev_server"))
        lines.append("- " + "; ".join(parts))
    return lines


def cmd_ctx(ctx, a):
    job = ctx.load(a.job)
    jd = ctx.job_dir(job["id"])
    agent = a.agent
    if job.get("repos_pending") and agent != "intake":
        raise FxError("%s waits for its repositories: %s first" % (job["id"], "fx result %s intake" % job["id"]
                      if job["repos_pending"] is True else "fx repos %s --base <repo>=<branch> ..." % job["id"]), code=3)
    several = len(job_order(job)) > 1
    changed = job_names(job, "change")
    rctx = one_app(ctx, job)[0] if not several else ctx  # a job of one repository reads that repository's settings
    cand = None
    wp = None
    if getattr(a, "wp", None):
        wp = ((job.get("split") or {}).get("packages") or {}).get(a.wp)
        if not wp or agent != "builder":
            raise FxError("no package %s in %s (run fx split first)" % (a.wp, job["id"]))
    if getattr(a, "candidate", None):
        cand = next(({"k": k, "worktree": per[changed[0]]["worktree"], "branch": per[changed[0]]["branch"]}
                     for k, per in job_candidates(job).items() if k == a.candidate and changed and changed[0] in per),
                    None)
        if not cand or agent != "builder":
            raise FxError("no candidate %s for %s (run fx candidates first)" % (a.candidate, job["id"]))
    lines = ["Job folder: %s" % jd]
    if several:
        lines += ctx_repo_lines(ctx, job, agent, cand, wp)
        lines.append("Factory repository (never edit it): %s" % ctx.factory)
