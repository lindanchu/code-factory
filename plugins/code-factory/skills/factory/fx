        lines += [
            "Worktree: %s" % (job.get("worktree") or "none yet: intake names the repositories"),
            "Branch: %s" % (job.get("branch") or "-"),
            "Base: %s" % (job.get("base_ref") or "-"),
            "Factory repository (never edit it): %s" % ctx.factory,
            "Checks script: %s" % (checks_script(ctx, job) if job_primary(job) or ctx.old_form else "-")]
        if wp:
            lines[1] = "Worktree: %s (your package's own clone)" % wp["clone"]
            lines[2] = "Branch: %s" % wp["branch"]
        if cand:
            lines[1] = "Worktree: %s" % cand["worktree"]
            lines[2] = "Branch: %s" % cand["branch"]
    lines += [
        ("Jira issue: %s (issue.md in the job folder)" % job["issue_key"]) if job.get("jira_base") else
        ("Task: %s (issue.md in the job folder; a local task with no Jira issue)" % job["issue_key"]),
        "Human language: %s" % (ctx.c("language") or "the language the issue or task is written in"),
    ]
    if len(ctx.repos) > 1 and agent == "intake":
        lines.append("Repositories of the project (write a line REPOS: <names> with the ones this issue needs; read one "
                     "with `%s code open --repo <name>`): %s" % (FX_CMD, "; ".join(
