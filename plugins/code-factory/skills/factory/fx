        ui_dir = os.path.join(jd, "ui-c%d" % cand["k"] if cand else "ui")
        cand_arg = (" --candidate %d" % cand["k"]) if cand else ""
        seed_note = ("`--seed` first runs seed.sh to load the Test data scenario" if agent == "builder" else
                     "the gate already ran seed.sh, so do not pass --seed")
        lines.append("UI checks: Playwright helper %s; UI folder %s (check.js, seed.sh); run a check with "
