def _exit_on_signal(signum, frame):
    sys.exit(128 + signum)  # runs the atexit cleanup (a timeout or interrupt sends SIGTERM)


def remove_stale_temp(work):
    """Temporary clones left by an fx process that was killed hard."""
    if not os.path.isdir(work):
        return
    for name in os.listdir(work):
        m = re.match(r"^_tmp-(\d+)-", name)
        if m and int(m.group(1)) != os.getpid() and not pid_alive(int(m.group(1))):
            shutil.rmtree(os.path.join(work, name), ignore_errors=True)


def refuse_review(ref, then="they are not jobs", jobs=None):
    """A factory repository may also hold reviews of merge requests, in jobs/_reviews/. code-factory does not handle
    them and they are not jobs: naming one, by its path or (with the jobs folder) by its folder's name alone, is
    refused, never taken for the job of the issue key it holds."""
    parts = [p for p in str(ref or "").strip().replace("\\", "/").lower().split("/") if p]
    held = os.path.join(jobs, REVIEW_DIR) if jobs else None
    if REVIEW_DIR in parts or parts and held and os.path.isdir(held) and \
            parts[-1] in {n.lower() for n in os.listdir(held)}:
        raise FxError("jobs/%s/ holds reviews of merge requests, which code-factory does not handle: %s"
                      % (REVIEW_DIR, then), code=3)


def dotted_get(d, dotted, default=None):
    cur = d
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


def repo_slug(text):
    """A repository name made from free text (an old factory's project.name): the name rule, else main."""
    t = unicodedata.normalize("NFKD", str(text or "")).replace("đ", "d").replace("Đ", "D")
    t = "".join(c for c in t if not unicodedata.combining(c))
    t = re.sub(r"[^a-z0-9]+", "-", t.lower()).strip("-")
    t = re.sub(r"^[^a-z]+", "", t)[:31].rstrip("-")
    return t if repo_name_problem(t) is None else "main"


def repo_name_problem(name):
    """Why this cannot be a repository's name, or None."""
    if not isinstance(name, str) or not REPO_RE.match(name):
        return "%r is not a repository name: lower case letters, digits and -, starting with a letter, at most 31" % (name,)
    if name in REPO_FORBIDDEN:
        return "a repository cannot be named %r (knowledge/%s/ would not be one repository's folder)" % (name, name)
    if re.search(r"-c\d+$", name) or "--" in name:
        return ("a repository cannot be named %r: a name that ends in -c<digits> or holds -- could be a best-of-N "
                "candidate's or a split package's clone of another repository" % name)
    return None


def needs_cycle(needs):
    """A cycle in {name: [names it needs]}, as a list of names, or None."""
    state = {}

    def visit(n, path):
        if state.get(n) == 1:
            return path[path.index(n):] + [n]
        if state.get(n) == 2:
            return None
        state[n] = 1
        for d in needs.get(n) or []:
            if d in needs:
                found = visit(d, path + [n])
                if found:
                    return found
        state[n] = 2
        return None
    for n in needs:
        found = visit(n, [])
        if found:
            return found
    return None


def config_repos(cfg):
    """(the repository entries, what is wrong with them). An old factory.json, with project.url and no repos, is one
    repository: named after the project, at project.url, with every other setting at the top level."""
    cfg = cfg if isinstance(cfg, dict) else {}
    raw = cfg.get("repos")
    if raw is None:
        proj = cfg.get("project") if isinstance(cfg.get("project"), dict) else {}
        if not proj.get("url"):
            return [], []
        entry = {"name": repo_slug(proj.get("name")), "url": proj["url"]}
        if cfg.get("base_branch"):
            entry["base_branch"] = cfg["base_branch"]
        return [entry], []
    if not isinstance(raw, list):
        return [], ["factory.json: repos must be a list of repositories"]
    repos, problems, names, urls = [], [], set(), []
    for i, r in enumerate(raw):
        if not isinstance(r, dict):
            problems.append("factory.json: repos[%d] is not an object" % i)
            continue
        name = r.get("name")
        why = repo_name_problem(name)
        if why:
            problems.append("factory.json: repos[%d]: %s" % (i, why))
            continue
        if name in names:
            problems.append("factory.json: two repositories are named %s" % name)
            continue
        names.add(name)
        url = r.get("url")
        if not isinstance(url, str) or not url.strip():
            problems.append("factory.json: repository %s has no url" % name)
        elif any(same_repo(url, u) or url == u for u in urls):
            problems.append("factory.json: repository %s has the url of another repository (%s)" % (name, url))
        else:
            urls.append(url)
        repos.append(r)
    needs = {}
    for r in repos:
        got = dotted_get(r, "app.needs", []) or []
        if not isinstance(got, list):
            problems.append("factory.json: %s: app.needs must be a list of repository names" % r["name"])
            got = []
        for d in got:
            if d not in names:
                problems.append("factory.json: %s needs %r, which is not one of the repositories (%s)"
                                % (r["name"], d, ", ".join(sorted(names))))
            elif d == r["name"]:
                problems.append("factory.json: %s needs itself (app.needs)" % d)
        needs[r["name"]] = [d for d in got if d in names and d != r["name"]]
    cyc = needs_cycle(needs)
    if cyc:
        problems.append("factory.json: the apps need each other in a circle: %s (app.needs)" % " -> ".join(cyc))
    return repos, problems


def repo_key(dotted):
    """Is this a setting a repository entry may hold (and the top level only defaults)?"""
    return any(fnmatch.fnmatchcase(dotted, g) for g in REPO_KEY_GLOBS)


class Ctx:
    repos, repo_problems, cfg = (), (), {}  # set by load_config
    scope = None  # a RepoCtx: the repository whose settings ctx.c reads

    def __init__(self, require_config=True):
        self.factory = factory_home()
        self.jobs = os.path.join(self.factory, "jobs")
        self._git = {}
        self._code = {}
        self.load_config(require_config)
        if self.cfg:
            remove_stale_temp(self.work)

    def load_config(self, require=True):
        raw = read(os.path.join(self.factory, CONFIG_NAME))
        self.cfg, self.repos, self.repo_problems = {}, [], []
        if raw is None:
            if require:
                raise FxError("this factory repository is not set up yet (no factory.json); "
                              "run /code-factory:factory init", code=3)
            return
        try:
            self.cfg = json.loads(raw)
        except json.JSONDecodeError as e:
            raise FxError("factory.json is not valid JSON: %s" % e)
        if not isinstance(self.cfg, dict):
            raise FxError("factory.json is not a JSON object")
        self.repos, self.repo_problems = config_repos(self.cfg)

    @property
    def old_form(self):
        """factory.json without repos: one repository at project.url, its checks script checks.sh."""
        return "repos" not in self.cfg

    @property
    def work(self):
        """Local folder for the project clones, next to the factory repository and outside both repositories."""
        root = (self.c("work_dir") or "../{factory}-work").replace("{factory}", os.path.basename(self.factory))
        return os.path.normpath(os.path.join(self.factory, os.path.expanduser(root)))

    def repo_names(self):
        return [r["name"] for r in self.repos]

    def repo_entry(self, name=None):
        """One repository's entry. Without a name: the only one, else the first one (the factory's default: its project
        name, its URL in an old factory.json)."""
        if name is None:
            if not self.repos:
                raise FxError("factory.json names no repository: run /code-factory:factory init (fx init --repo "
                              "<name>=<git URL>)", code=3)
            return self.repos[0]
        for r in self.repos:
            if r.get("name") == name:
                return r
        raise FxError("no repository %r in factory.json; its repositories: %s" % (
            name, ", ".join(self.repo_names()) or "none"), code=3)

    def repo_name(self, name=None):
        return self.repo_entry(name)["name"]

    def rc(self, repo, key, default=None):
        """A setting for one repository: its entry's dotted key, else the same key at the top level of factory.json (the
        project's default; never for url, name, base_branch, app.needs and app.env), else default."""
        entry = self.repo_entry(repo) if (repo is not None or self.repos) else {}
        v = dotted_get(entry, key, _MISSING)
        if v is not _MISSING:
            return v
        if key in REPO_ONLY_KEYS:
            return default
        return dotted_get(self.cfg, key, default)

    def url(self, repo=None):
        u = self.repo_entry(repo).get("url") if (repo is not None or self.repos) else None
        if not u:
            raise FxError("factory.json names no repository: run /code-factory:factory init (fx init --repo "
                          "<name>=<git URL>)", code=3)
        return u

    def git(self, repo=None):
        """A temporary bare copy of a repository's history (file contents fetched only when needed), deleted when fx
        exits. For reading only: jobs work in their own clones."""
        name = self.repo_name(repo)
        if not self._git.get(name):
            self._git[name] = temp_clone(self, bare=True, repo=name)
        return self._git[name]

    def code(self, repo=None):
        """A temporary shallow checkout of a repository's base branch for searching file contents; None when empty."""
        name = self.repo_name(repo)
        if self._code.get(name) is None:
            try:
                self._code[name] = temp_clone(self, bare=False, depth=1, branch=self.rc(name, "base_branch", "main"),
                                              repo=name)
            except FxError:
                self._code[name] = ""
        return self._code[name] or None

    def c(self, dotted, default=None):
        """A project setting at the top level of factory.json. In a project of one repository, a per-repository setting
        is that repository's (ctx.rc), so a factory.json in the new form reads as an old one did."""
        if len(self.repos) == 1 and repo_key(dotted):
            return self.rc(self.repos[0]["name"], dotted, default)
        if dotted == "project.url" and len(self.repos) == 1:
            return self.repos[0].get("url") or default
        return dotted_get(self.cfg, dotted, default)

    def job_dir(self, job_id):
        return os.path.join(self.jobs, job_id)

    def load(self, ref):
        return self.load_exact(self.resolve(ref))

    def load_exact(self, job_id):
        raw = read(os.path.join(self.job_dir(job_id), "job.json"))
        if raw is None:
            raise FxError("no job %s" % job_id)
        job = Job(json.loads(raw))
        job_repos(self, job)
        job_show_flat(job)
        return job

    def resolve(self, ref):
        """Accept a job id, an issue key (any case) or a Jira link; return the latest job id."""
        ref = (ref or "").strip()
        refuse_review(ref, jobs=self.jobs)
        am = re.fullmatch(r"([A-Za-z][A-Za-z0-9_]+-\d+)-[rR](\d+)", ref)
        if am:
            attempt = "%s-r%s" % (am.group(1).upper(), am.group(2))
            if os.path.isdir(self.job_dir(attempt)):
                return attempt  # an explicit attempt id
        m = KEY_RE.search(ref.upper() if not ref.startswith("http") else ref)
        key = m.group(1) if m else ref
        candidates = [d for d in self.list_ids() if d == key or d.startswith(key + "-r")]
        if not candidates:
            raise FxError("no job for %s" % ref)
        return sorted(candidates, key=lambda d: (len(d), d))[-1]

    def list_ids(self):
        if not os.path.isdir(self.jobs):
            return []
        return sorted(d for d in os.listdir(self.jobs)
                      if not d.startswith(".") and os.path.isfile(os.path.join(self.jobs, d, "job.json")))

    def save(self, job, note=None):
        close_runs(job)
        job["updated_at"] = now()
        if note:
            job.setdefault("history", []).append({"at": job["updated_at"], "stage": job["stage"], "note": note})
        job_fold_flat(self, job)
        text = json.dumps(job, ensure_ascii=False, indent=2) + "\n"
        job_show_flat(job)
        write_atomic(os.path.join(self.job_dir(job["id"]), "job.json"), text)

    def move(self, job, to, note=None, force=False):
        frm = job["stage"]
        if to not in STAGES:
            raise FxError("unknown stage %s" % to)
        if not force and to not in MOVES.get(frm, set()):
            raise FxError("illegal move %s -> %s for %s" % (frm, to, job["id"]))
        job["stage"] = to
        self.save(job, note or ("%s -> %s" % (frm, to)))


class RepoCtx:
    """The factory seen from one repository: ctx.c reads that repository's setting for a per-repository key (ctx.rc),
    and url, git, code, rc without a name mean it. Everything else is the factory's ctx. What runs a repository's checks,
    app and scanners gets one, so a project of several repositories reads as one of one."""

    def __init__(self, ctx, name):
        base = ctx._ctx if isinstance(ctx, RepoCtx) else ctx
        self.__dict__.update(_ctx=base, scope=name)

    def __getattr__(self, k):
        return getattr(self._ctx, k)

    def __setattr__(self, k, v):
        setattr(self._ctx, k, v)

    def c(self, dotted, default=None):
        if repo_key(dotted):
            return self._ctx.rc(self.scope, dotted, default)
        return self._ctx.c(dotted, default)

    def rc(self, repo, key, default=None):
        return self._ctx.rc(repo or self.scope, key, default)

    def repo_entry(self, name=None):
        return self._ctx.repo_entry(name or self.scope)

    def repo_name(self, name=None):
        return self._ctx.repo_name(name or self.scope)

    def url(self, repo=None):
        return self._ctx.url(repo or self.scope)

    def git(self, repo=None):
        return self._ctx.git(repo or self.scope)

    def code(self, repo=None):
        return self._ctx.code(repo or self.scope)


def repo_ctx(ctx, name):
    """ctx for one repository (RepoCtx); without a name, ctx as it is."""
    if not name or name not in ctx.repo_names():
        return ctx
    return RepoCtx(ctx, name)


# --------------------------------------------------------------------------
# a job's repositories: job.json keeps each one's branch, clone, base, pull request… under repos{}, in repo_order

class Job(dict):
    """job.json as loaded. repos{} is the truth. The fields of the first repository the job changes also show at the top
    (job_show_flat), for code that only needs that repository, and the jobs of a project of one repository read just as
    they did before jobs had repos{}. ctx.save puts what was changed there back into that repository and
    writes repos{} only."""
    shown = None


def job_order(job):
    repos = job.get("repos") if isinstance(job.get("repos"), dict) else {}
    order = [n for n in job.get("repo_order") or [] if n in repos]
    return order + [n for n in repos if n not in order]


def job_names(job, role=None):
    """The job's repositories in merge order; role change or run for only those."""
    repos = job.get("repos") if isinstance(job.get("repos"), dict) else {}
    return [n for n in job_order(job) if role is None or (repos.get(n) or {}).get("role", "change") == role]


def job_primary(job):
    """The first repository the job changes, or None (its repositories wait for intake)."""
    names = job_names(job, "change")
    return names[0] if names else None


def job_clones(job):
    """The job's repositories that have (or should have) a clone: all but one a rework found merged that no app needs."""
    return [n for n in job_names(job) if job["repos"][n].get("worktree") or not job["repos"][n].get("merged")]


def job_pr_names(job):
    """The repositories the job opened pull requests in: the ones it changes, and the ones whose pull request a rework
    found merged (marked merged; run-only since). What learning reads."""
    return [n for n in job_order(job) if job["repos"][n].get("role", "change") == "change"
            or job["repos"][n].get("merged")]


def job_repo(job, name):
    return job["repos"][name]


def job_repos(ctx, job, default_name=None):
    """Bring a job to the form with repos{}, in place. An old job keeps everything of its one repository at the top: that
    goes into the entry of its repository (the factory's first, as an old factory.json reads). A field also found at the
    top of a new job was written there by hand or by an older fx: it counts for the job's first changed repository."""
    repos = job.get("repos") if isinstance(job.get("repos"), dict) else {}
    flat = {k: job.pop(k) for k in JOB_REPO_FIELDS if k in job}
    if flat:
        name = job_primary(dict(job, repos=repos)) or default_name or (
            ctx.repos[0]["name"] if ctx is not None and ctx.repos else "main")
        repos.setdefault(name, {"role": "change"}).update(flat)
    for e in repos.values():
        if isinstance(e, dict):
            e.setdefault("role", "change")
    job["repos"] = {n: e for n, e in repos.items() if isinstance(e, dict)}
    job["repo_order"] = job_order(job)
    return job_learn_split(job)


def job_show_flat(job):
    """Show the first changed repository's fields at the top of the job too (see Job)."""
    name = job_primary(job)
    entry = job["repos"].get(name) or {} if name else {}
    shown = {}
    for k in JOB_REPO_FIELDS:
        if k in entry:
            job[k] = shown[k] = entry[k]
        else:
            job.pop(k, None)
    if isinstance(job, Job):
        job.shown = (name, shown)
    return job


def job_fold_flat(ctx, job):
    """Before a job is written: what code changed in the fields shown at the top goes back into their repository, and
    only repos{} is written. A plain dict has no record of what was shown: its top-level fields count."""
    view = getattr(job, "shown", None)
    if view is None:
        job_repos(ctx, job)
        return job
    name, shown = view
    entry = job["repos"].get(name) if name else None
    for k in JOB_REPO_FIELDS:
        has = k in job
        v = job.pop(k, None)
        if entry is None:
            continue
        if has and (k not in shown or v is not shown[k]):
            entry[k] = v
        elif not has and k in shown and entry.get(k, _MISSING) is shown[k]:
            entry.pop(k, None)
    job["repo_order"] = job_order(job)
    return job


def job_flat_copy(data, default_name=None):
    """A job read straight from a job.json (another factory's, the board's), with the first changed repository's fields
    at the top as well. Never written back."""
    job = job_repos(None, dict(data), default_name)
    return job_show_flat(job)


def job_stored(job):
    """The job as job.json holds it: repos{}, nothing per repository at the top."""
    return {k: v for k, v in job.items() if k not in JOB_REPO_FIELDS}


def job_block(ctx, job):
    """Where the job's block of ports starts: job.port (ports.base + slot * ports.step, given by free_slot)."""
    if job.get("port") is not None:
        return int(job["port"])
    return ports_base(ctx) + ports_step(ctx) * int(job.get("slot") or 0)


def job_port(ctx, job, name):
    """A repository's port in the job's block of ports: the block's start + its place in repo_order. The first
    app_ports(ctx) ports of a block are the apps'; the agents' own come after them (agent_port, candidate_block)."""
    order = job_order(job)
    i = order.index(name) if name in order else 0
    return job_block(ctx, job) + i


def app_ports(ctx):
    """How many ports of a job's block are kept for its apps: one per repository of the project."""
    return max(1, len(ctx.repos))


def agent_port(ctx, job, off):
    """An agent's own dev server port (builder 0, ux 1, ui 2), after the apps' ports: never one an app runs on."""
    return job_block(ctx, job) + app_ports(ctx) + off


def candidate_block(ctx, job, k):
    """Best-of-N candidate k's own block for its apps (one port per repository), after the agents' three ports."""
    return job_block(ctx, job) + app_ports(ctx) + 3 + (int(k) - 1) * app_ports(ctx)


def ports_base(ctx):
    return int(ctx.cfg.get("ports", {}).get("base", 5100) if isinstance(ctx.cfg.get("ports"), dict) else 5100)


def ports_needed(ctx):
    """The ports one job's block must hold: its apps, the agents' three, and every best-of-N candidate's apps."""
    n = app_ports(ctx)
    return n + 3 + n * max(1, int(ctx.cfg.get("best_of_max", 4) or 4))


def candidates_room(ctx):
    """How many best-of-N candidates a job's block of ports has room for, after its apps and the agents' three."""
    return max(0, (ports_step(ctx) - app_ports(ctx) - 3) // app_ports(ctx))


def ports_step(ctx):
    """A job's block of ports: at least 10, and room for every repository's app, the agents' three and the
    candidates' apps (ports_needed)."""
    got = ctx.cfg.get("ports", {}).get("step") if isinstance(ctx.cfg.get("ports"), dict) else None
    return int(got) if got else max(10, ports_needed(ctx))


def is_whole_job(job):
    """A job as job.json holds it (repos{}), not one repository's view of it (repo_view) or a job of fx's own."""
    return isinstance(job.get("repos"), dict) and not job.get("repo")


def repo_view(ctx, job, name):
    """One repository of a job seen as a job of one repository: its fields at the top, its port and its name (repo), with
    the job's apps in start order (apps) and their URLs (urls). What the gate, the apps and the scanners read; never
    saved. For the first changed repository, fields that code changed at the top of the job count."""
    e = job["repos"][name]
    v = {k: val for k, val in job.items() if k not in JOB_REPO_FIELDS}
    v.update({k: e[k] for k in JOB_REPO_FIELDS if k in e})
    if name == job_primary(job):
        v.update({k: job[k] for k in JOB_REPO_FIELDS if k in job})
    apps = job_apps(ctx, job) if ctx.repos else []
    v.update(repo=name, role=e.get("role", "change"), port=job_port(ctx, job, name), apps=apps,
             urls={n: "http://127.0.0.1:%d" % job_port(ctx, job, n) for n in apps if n in job["repos"]})
    v.setdefault("worktree", None)
    return v


def one_app(ctx, job, name=None):
    """(ctx, job) for one repository: a whole job's repository (name, else the first it changes) as repo_view with that
    repository's settings (RepoCtx); a view, or a job of fx's own, as it is."""
    if is_whole_job(job):
        name = name or job_primary(job) or next(iter(job_order(job)), None)
        if name and name in job["repos"] and name in ctx.repo_names():
            return repo_ctx(ctx, name), repo_view(ctx, job, name)
        return ctx, job
    return repo_ctx(ctx, job.get("repo")), job


def app_needs(ctx, name):
    return [d for d in (ctx.rc(name, "app.needs", []) or []) if d in ctx.repo_names() and d != name]


def job_apps(ctx, job):
    """The apps a job runs, in start order: every repository it changes that has an app.up, and every repository they need
    (app.needs, followed through), each after what it needs; ties in repo order."""
    known = ctx.repo_names()
    want, todo = set(), [n for n in job_names(job, "change") if n in known and ctx.rc(n, "app.up")]
    while todo:
        n = todo.pop()
        if n not in want:
            want.add(n)
            todo += app_needs(ctx, n)
    order = []

    def visit(n, path):
        if n in order or n in path:
            return
        for d in app_needs(ctx, n):
            if d in want:
                visit(d, path + (n,))
        order.append(n)
    for n in [x for x in known if x in want]:
        visit(n, ())
    return [n for n in order if ctx.rc(n, "app.up")]


def job_branch_name(job):
    """The job's branch, the same in every repository it changes."""
    for n in job_names(job, "change"):
        if job["repos"][n].get("branch"):
            return job["repos"][n]["branch"]
    return "factory/%s-%s" % (job["id"], slugify(job.get("summary") or "", 30))


def needed_repos(ctx, change):
    """What the job's apps need: every changed repository with app.up and, followed through app.needs, what they need."""
    todo = [n for n in change if ctx.rc(n, "app.up")]
    seen = set()
    while todo:
        n = todo.pop()
        if n in seen:
            continue
        seen.add(n)
        todo += [d for d in ctx.rc(n, "app.needs", []) or [] if d in ctx.repo_names()]
    return [n for n in ctx.repo_names() if n in seen and n not in change]


def clone_filter_args(ctx, repo=None):
    f = ctx.rc(repo, "clone.filter", "blob:none") if ctx.repos else ctx.c("clone.filter", "blob:none")
    u = ctx.url(repo)
    local = os.path.isdir(os.path.expanduser(u)) or u.startswith("file:")
    return ["--filter=%s" % f] if f and not local else []


def clone_project(ctx, dest, bare=False, depth=None, branch=None, full=False, repo=None):
    """A fresh clone of a repository at dest (replacing whatever was there); full: every file of every commit."""
    if os.path.exists(dest):
        shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    mark_work_dir(ctx)
    cmd = ["git", "clone", "-q"] + ([] if depth or full else clone_filter_args(ctx, repo))
    if bare:
        cmd.append("--bare")
    if depth:
        cmd += ["--depth", str(depth)]
    if branch:
        cmd += ["--branch", branch]
    url = ctx.url(repo)
    cmd += [os.path.expanduser(url) if os.path.isdir(os.path.expanduser(url)) else url, dest]
    try:
        p = run(cmd, check=False, timeout=int(ctx.rc(repo, "clone_timeout_sec", 1800) or 1800))
    except subprocess.TimeoutExpired:
        p = None
    if p is None or p.returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        raise FxError("could not clone the project from %s: %s" % (
            url, ((p.stdout or "") if p else "timed out")[-600:].strip()), code=3)
    return dest


def temp_clone(ctx, bare, depth=None, branch=None, repo=None):
    name = ctx.repo_name(repo)
    d = os.path.join(ctx.work, "_tmp-%d-%s-%s" % (os.getpid(), "git" if bare else "code", name))
    TEMP_DIRS.append(d)
    return clone_project(ctx, d, bare=bare, depth=depth, branch=branch, repo=name)


def copy_source(ctx, repo=None):
    src_root = os.path.expanduser((ctx.rc(repo, "copy_from") if ctx.repos else ctx.c("copy_from")) or "local")
    return src_root if os.path.isabs(src_root) else os.path.join(ctx.factory, src_root)


def local_file_source(ctx, rel, repo=None):
    """Where a copy_into_worktree file of a repository comes from, or None: local/<repo>/<file> in the factory
    repository first (each repository's own .env), then copy_from, else local/<file>."""
    name = ctx.repo_name(repo) if ctx.repos else None
    for root in ([os.path.join(ctx.factory, "local", name)] if name else []) + [copy_source(ctx, repo)]:
        if os.path.isfile(os.path.join(root, rel)):
            return os.path.join(root, rel)
    return None


def copy_local_files(ctx, dest, repo=None):
    """Untracked files a fresh clone needs (for example .env): local/<repo>/<file> in the factory repository, else from
    copy_from or local/<file>."""
    copied = []
    for rel in (ctx.rc(repo, "copy_into_worktree", []) if ctx.repos else ctx.c("copy_into_worktree", [])) or []:
        src = local_file_source(ctx, rel, repo)
        if src:
            dst = os.path.join(dest, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
            copied.append(rel)
    return copied


def job_clone(ctx, dest, branch, start=None, repo=None):
    """The job's own clone of a repository: a new branch from start, or (start=None) the branch as it is on the remote."""
    clone_project(ctx, dest, repo=repo)
    if start:
        if git(["rev-parse", "--verify", "-q", start], dest, check=False).returncode != 0:
            shutil.rmtree(dest, ignore_errors=True)
            raise FxError("the project%s has no %s yet (an empty repository?); run /code-factory:factory init and let it "
                          "make the first commit" % (" " + repo if repo and len(ctx.repos) > 1 else "", start), code=3)
        git(["checkout", "-q", "-b", branch, start], dest)
    else:
        if git(["rev-parse", "--verify", "-q", "%s/%s" % (REMOTE, branch)], dest, check=False).returncode != 0:
            shutil.rmtree(dest, ignore_errors=True)
            raise FxError("the branch %s is not on the remote any more (merged and deleted?); start a new job "
                          "instead" % branch, code=3)
        git(["checkout", "-q", "-b", branch, "%s/%s" % (REMOTE, branch)], dest)
    copy_local_files(ctx, dest, repo)
    warning = baselines_fill_clone(ctx, dest, repo)
    if warning:
        ctx.baselines_warnings = getattr(ctx, "baselines_warnings", []) + [warning]
    return dest


def run_clone(ctx, dest, base, repo):
    """A repository the job only runs: its base branch, checked out detached. Never pushed."""
    clone_project(ctx, dest, repo=repo)
    ref = "%s/%s" % (REMOTE, base)
    if git(["rev-parse", "--verify", "-q", ref], dest, check=False).returncode != 0:
        shutil.rmtree(dest, ignore_errors=True)
        raise FxError("the repository %s has no branch %s to run the app from" % (repo, base), code=3)
    git(["checkout", "-q", "--detach", ref], dest)
    copy_local_files(ctx, dest, repo)
    return dest


def job_clone_dir(ctx, job_id, name):
    """Where a new job's clone of a repository goes: work/<job>/<repo>."""
    return os.path.join(ctx.work, job_id, name)


def parse_bases(ctx, values, names=None, flag="--base"):
    """--base name=branch (repeatable), or a plain --base branch for every repository: {name or "*": branch}. flag:
    the option named in errors (fx pr's --target reads the same way)."""
    bases = {}
    for v in values or []:
        v = (v or "").strip()
        if not v:
            continue
        name, sep, branch = v.partition("=")
        if sep and REPO_RE.match(name.strip()):
            name, branch = name.strip(), branch.strip()
            ctx.repo_entry(name)
            if names is not None and name not in names:
                raise FxError("%s %s: %s is not one of this job's repositories (%s)" % (
                    flag, v, name, ", ".join(names) or "none yet"), code=3)
        else:
            name, branch = "*", v
        if not branch:
            raise FxError("%s %s names no branch" % (flag, v), code=3)
        bases[name] = branch
    return bases


def base_for(ctx, bases, name):
    return bases.get(name) or bases.get("*") or ctx.rc(name, "base_branch", "main")


def job_add_repos(ctx, job, change, bases):
    """Clone every repository in change on the job's branch, from its base, then every repository their apps need that
    the job does not change, at its base (role run). Returns what it cloned; on failure removes it and raises."""
    made, kept = [], {}
    branch = job_branch_name(job)
    repos = job.setdefault("repos", {})
    try:
        for name in [n for n in ctx.repo_names() if n in change]:
            base = base_for(ctx, bases, name)
            if name in bases or "*" in bases:
                check_branch(ctx, base, "source", repo=name)
            old = repos.get(name) or {}
            if old.get("role") == "change":
                continue
            wt = job_clone_dir(ctx, job["id"], name)
            if old.get("role") == "run" and os.path.isdir(old.get("worktree") or ""):
                # Now changed too: on the job's branch instead. Work done in the run-only clone is kept: the job's
                # branch starts there, with its commits and its uncommitted changes.
                owt = old["worktree"]
                k, dirty = unsaved_work(ctx, job, owt, name)
                if k or dirty:
                    obase = old.get("base_branch") or ctx.rc(name, "base_branch", "main")
                    if name in bases and bases[name] != obase:
                        raise FxError("%s has work in its run-only clone %s, made on %s: it can only become a changed "
                                      "repository from there, not from %s" % (name, owt, obase, bases[name]), code=3)
                    git(["checkout", "-q", "-b", branch], owt)
                    kept[name] = old
                    repos[name] = {"role": "change", "branch": branch, "worktree": owt, "base_branch": obase,
                                   "base_ref": old.get("base_ref") or "%s/%s" % (REMOTE, obase),
                                   "setup_done": old.get("setup_done", False), "pr_url": None, "pr_hint": None}
                    continue
                shutil.rmtree(owt, ignore_errors=True)
            job_clone(ctx, wt, branch, start="%s/%s" % (REMOTE, base), repo=name)
            made.append(wt)
            repos[name] = {"role": "change", "branch": branch, "worktree": wt, "base_branch": base,
                           "base_ref": "%s/%s" % (REMOTE, base), "setup_done": False, "pr_url": None, "pr_hint": None}
        for name in needed_repos(ctx, job_names(job, "change") + [n for n in change if n not in repos]):
            if name in repos:
                continue
            base = bases.get(name) or ctx.rc(name, "base_branch", "main")  # a plain --base is for what the job changes
            if name in bases:
                check_branch(ctx, base, "source", repo=name)
            wt = job_clone_dir(ctx, job["id"], name)
            run_clone(ctx, wt, base, name)
            made.append(wt)
            repos[name] = {"role": "run", "worktree": wt, "base_branch": base, "base_ref": "%s/%s" % (REMOTE, base),
                           "setup_done": False}
    except (FxError, OSError):
        for d in made:
            shutil.rmtree(d, ignore_errors=True)
        for name in list(repos):
            if repos[name].get("worktree") in made:
                del repos[name]
        for name, old in kept.items():  # back to the run-only clone it was, its work untouched
            git(["checkout", "-q", "--detach"], old["worktree"], check=False)
            git(["branch", "-q", "-D", branch], old["worktree"], check=False)
            repos[name] = old
        raise
    job["repo_order"] = [n for n in ctx.repo_names() if n in repos] + [n for n in job_order(job)
                                                                        if n not in ctx.repo_names()]
    return made


def unsaved_work(ctx, job, wt=None, repo=None):
    """Commits not on the remote, uncommitted changes, or untracked files (not build artifacts) in a clone."""
    wt = wt or job.get("worktree")
    if not wt or not os.path.isdir(wt):
        return 0, ""
    r = git(["rev-list", "--count", "HEAD", "--not", "--remotes=%s" % REMOTE], wt, check=False)
    n = int((r.stdout or "0").strip() or 0) if r.returncode == 0 else 0
    tracked, untracked = worktree_dirt(ctx, wt, repo)
    dirty = tracked or ("untracked files: " + ", ".join(untracked[:5]) if untracked else "")
    return n, dirty


def drop_clone(ctx, job, force=False):
    """Delete the job's clones once nothing in them is unsaved: all of them or none. Returns what happened, for the
    output."""
    names = [n for n in job_names(job) if os.path.isdir(job["repos"][n].get("worktree") or "")]
    if not names:
        return "no clone"
    if not force:
        for n in names:  # a run-only clone too: work done there by mistake is work all the same
            e = job["repos"][n]
            k, dirty = unsaved_work(ctx, job, e.get("worktree"), n)
            if k or dirty:
                return "kept: %s%s" % ("%s: " % n if len(job["repos"]) > 1 else "",
                                       "%d commit(s) not on the remote" % k if k else dirty
                                       if dirty.startswith("untracked") else "uncommitted changes")
    app_stop(ctx, job)
    for n in names:
        e = job["repos"][n]
        shutil.rmtree(e["worktree"], ignore_errors=True)
        e["clone_removed_at"] = now()
    for p_ in ((job.get("split") or {}).get("packages") or {}).values():
        shutil.rmtree(p_.get("clone") or "", ignore_errors=True)  # merged into the job's branch already
    home = os.path.join(ctx.work, job["id"])
    if os.path.isdir(home) and not os.listdir(home):
        os.rmdir(home)
    return "removed"


def code_dir(ctx, repo=None):
    """A repository's read-only clone: work/_read-<name>."""
    return os.path.join(ctx.work, "_read-%s" % ctx.repo_name(repo))


def code_repo(ctx, repo):
    """The repository a command without --repo means: the only one; with several, it must be named."""
    if repo is None and len(ctx.repos) > 1:
        raise FxError("this project has several repositories: name one with --repo (%s)" % ", ".join(ctx.repo_names()),
                      code=3)
    return ctx.repo_name(repo)


def code_open(ctx, repo=None):
    """A clone of a repository's base branch to read during init, intake or an audit; `fx code close` deletes it."""
    name = ctx.repo_name(repo)
    d = code_dir(ctx, name)
    clone_project(ctx, d, repo=name)
    base = "%s/%s" % (REMOTE, ctx.rc(name, "base_branch", "main"))
    if git(["rev-parse", "--verify", "-q", base], d, check=False).returncode == 0:
        git(["checkout", "-q", "--detach", base], d)
    return d


def cmd_code(ctx, a):
    repo = getattr(a, "repo_name", None)
    if a.action == "open":
        d = code_open(ctx, code_repo(ctx, repo))
        out({"ok": True, "repo": ctx.repo_name(repo), "path": d,
             "note": "read only; run `fx code close%s` when done" % (" --repo %s" % repo if repo else "")})
    else:
        names = [ctx.repo_name(repo)] if repo else ctx.repo_names()
        removed = []
        for n in names:
            d = code_dir(ctx, n)
            if os.path.isdir(d):
                removed.append(d)
            shutil.rmtree(d, ignore_errors=True)
        if not repo and os.path.isdir(os.path.join(ctx.work, "_read")):  # an older fx's read-only clone
            removed.append(os.path.join(ctx.work, "_read"))
            shutil.rmtree(os.path.join(ctx.work, "_read"), ignore_errors=True)
        out({"ok": True, "removed": removed[0] if len(removed) == 1 else removed or None})


def cmd_where(ctx, a):
    """keys_folder: where this project's key files go on this machine (the S3 keys, jira.env), with or without storage.
    repos: each repository's name, URL, base branch and read-only clone; with one, also the single keys of before."""
    repos = [{"name": r["name"], "url": r.get("url"), "base_branch": ctx.rc(r["name"], "base_branch", "main"),
              "code": code_dir(ctx, r["name"]) if os.path.isdir(code_dir(ctx, r["name"])) else None,
              "knowledge": repo_knowledge_dir(ctx, r["name"]), "checks": checks_script(ctx, repo=r["name"])}
             for r in ctx.repos]
    res = {"ok": True, "factory": ctx.factory, "work": ctx.work, "jobs": ctx.jobs, "knowledge": knowledge_dir(ctx),
           "lessons": os.path.join(ctx.factory, "lessons.md"), "repos": repos, "keys_folder": baselines_key_dir(ctx)}
    if len(repos) == 1:
        res.update(project_url=repos[0]["url"], code=repos[0]["code"])
    elif not repos:
        res.update(project_url=None, code=None)
    out(res)


def rounds_used(job):
    return job["round"] - job.get("round_start", 0)


def rounds_left(job):
    return job["max_rounds"] - rounds_used(job)


# --------------------------------------------------------------------------
# model routing

def clamp_model(name, floor):
    name = (name or "").strip().lower()
    if name not in MODEL_RANK:
        hint("fx: unknown model %r, using %s" % (name, floor))
        return floor
    if MODEL_RANK[name] < MODEL_RANK[floor]:
        hint("fx: model %s is below the floor, using %s" % (name, floor))
        return floor
    return name


def floor_model(ctx):
    f = (ctx.c("models.floor", MIN_MODEL) or MIN_MODEL).lower()
    if f not in MODEL_RANK or MODEL_RANK[f] < MODEL_RANK[MIN_MODEL]:
        f = MIN_MODEL
    return f


def route(ctx, job):
    floor = floor_model(ctx)
    risk = job.get("risk") or "high"
    table = ctx.c("models.%s" % risk) or {}
    roles = ["intake", "spec", "builder", "security", "code", "ux", "ui", "approver"]
    fit = len(job_names(job, "change")) > 1
    models = {r: clamp_model(table.get(r, floor), floor) for r in roles + (["fit"] if fit else [])}
    reviewers = [r for r in ctx.c("reviewers.always", ["security", "code"]) if r in ALL_REVIEWERS]
    if "ui" in (job.get("surfaces") or []):
        reviewers += [r for r in ctx.c("reviewers.ui", ["ux", "ui"]) if r in ALL_REVIEWERS and r not in reviewers]
    if fit:  # two or more repositories change: whether they work with each other
        reviewers.append("fit")
    job["models"] = models
    job["reviewers"] = reviewers
    return models, reviewers


def builder_model(ctx, job):
    """Model for the *next* build: last allowed round gets the stronger model."""
    floor = floor_model(ctx)
    m = (job.get("models") or {}).get("builder", floor)
    building_round = rounds_used(job) + 1
    if building_round >= job["max_rounds"] and ctx.c("models.builder_last_round"):
        last = clamp_model(ctx.c("models.builder_last_round"), floor)
        if MODEL_RANK[last] > MODEL_RANK[m]:
            m = last
    return m


