def build_parser():
    p = argparse.ArgumentParser(prog="fx", description="software factory helper")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("new", help="create a job from a Jira link or key, or a local task")
    s.add_argument("ref", nargs="?")
    s.add_argument("--local", metavar="TITLE", help="a task without Jira (needs --issue-file)")
    s.add_argument("--again", action="store_true", help="fresh attempt when a job already exists")
    s.add_argument("--issue-file", help="issue markdown written by the orchestrator (mode mcp)")
    s.add_argument("--best-of", type=int, default=0, help="first build: N builders in parallel, a judge picks one")
    s.add_argument("--repos", metavar="A,B", help="the repositories the job changes, cloned at once (default: the only "
                   "one; with several, intake names them and fx repos clones them)")
    s.add_argument("--base", action="append", metavar="[REPO=]BRANCH", help="the branch the work starts from (asked "
                   "before coding), repeatable as repo=branch; a plain branch is for every repository the job changes; "
                   "default each repository's base_branch")
    s.set_defaults(fn=cmd_new)
    s = sub.add_parser("repos", help="clone the repositories intake named (or more) on the bases the user picked")
    s.add_argument("job")
    s.add_argument("--base", action="append", metavar="REPO=BRANCH", help="a repository and its base branch "
                   "(repeatable); a plain branch is for every repository to clone")
    s.add_argument("--add", action="append", metavar="REPO", help="also clone this repository (its configured base)")
    s.add_argument("--drop", metavar="REPO", help="a changed repository that needs nothing: run-only when another "
                   "repository's app needs it, else out of the job (refused while its clone has unpushed work)")
    s.set_defaults(fn=cmd_repos)
    s = sub.add_parser("usage", help="record the tokens and time an agent reported when it finished")
    s.add_argument("job")
    s.add_argument("--agent", required=True)
    s.add_argument("--wp")
    s.add_argument("--candidate", type=int)
    s.add_argument("--tokens", type=int, required=True)
    s.add_argument("--ms", type=int)
    s.set_defaults(fn=cmd_usage)
    s = sub.add_parser("board", help="write the factory board (an HTML page of all jobs on this machine)")
    s.add_argument("--open", action="store_true", help="open it in the browser")
    s.set_defaults(fn=cmd_board)
    s = sub.add_parser("branches", help="each repository's branches, for asking the source or the target branch")
    s.add_argument("--job", help="this job's repositories, its branches first")
    s.add_argument("--repo", dest="repo_name", metavar="NAME", help="only this repository")
    s.set_defaults(fn=cmd_branches)

    s = sub.add_parser("ctx", help="prompt prefix + model for an agent")
