    ("stripe-live-key", re.compile(r"\b[sr]k_live_[0-9A-Za-z]{20,}\b")),
    ("google-api-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    ("anthropic-key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("openai-key", re.compile(r"\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|\bsk-[A-Za-z0-9]{32,}\b")),
    ("azure-storage-key", re.compile(r"(?i)\bAccountKey\s*=\s*[A-Za-z0-9+/]{86}==")),
    # A literal assigned to a secret-named variable; the value (group v) is what gets redacted.
    ("secret-assignment", re.compile(r"(?i)(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|"
                                     r"private[_-]?key|client[_-]?secret)(?:[_-]?(?:key|value|hash))?['\"]?"
                                     r"\s{0,5}(?:=>|:=|[:=])\s{0,5}['\"`](?P<v>[^'\"`\s]{8,200})['\"`]")),
]
# The same false-positive guards as the docs check (SECRET_LINE_RE): placeholders and references, not values.
PLACEHOLDER_RE = re.compile(r"(?i)(example|xxx|changeme|change-me|\*\*\*|<|\{|\$|%|env\(|getenv|process\.env|config\(|"
                            r"dummy|fake|sample|placeholder|your[_-]|redacted|test)")
# Test code and fixtures carry test passwords on purpose; the generic assignment rule skips them.
TEST_PATH_RE = re.compile(r"(?i)(^|/)(tests?|spec|specs|__tests__|e2e|fixtures?|factories|seeds?|seeders|mocks?|"
                          r"stubs?|testdata)(/|$)|[._-](test|spec)\.[a-z0-9]+$|\.(example|sample|dist|template)$")
# Only tests. Not TEST_PATH_RE: factories, seeds and mocks can be real code, and what is here stops findings from blocking.
TEST_ONLY_RE = re.compile(r"(?i)(^|/)(tests?|specs?|__tests__|e2e|testdata)(/|$)|[._-](test|spec)\.[a-z0-9]+$")
# A file whose own name says so. Anything can be put in a folder called tests: app/api/tests/handlers.py.
TEST_NAME_RE = re.compile(r"(?i:(^|/)test_[^/]*$|(^|/)conftest\.py$|[._-](tests?|specs?)\.[a-z0-9]+$|(^|/)(__tests__|e2e)/|"
                          r"\.cy\.[a-z0-9]+$)|[a-z0-9](Tests?|Spec|IT)\.[a-z0-9]+$")
VALIDATION_RULE_RE = re.compile(r"^[a-z_]+(?::[^|]*)?(?:\|[a-z_]+(?::[^|]*)?)*$")
VALIDATION_RULES = {"alpha", "alpha_dash", "alpha_num", "array", "bail", "between", "boolean", "confirmed",
                    "current_password", "date", "different", "digits", "email", "exists", "file", "filled", "image",
                    "in", "integer", "max", "min", "nullable", "numeric", "present", "regex", "same", "size",
                    "sometimes", "string", "unique", "url", "uuid"}


def plain_text_value(v):
    """A value next to a secret-named key that is ordinary text: a validation rule ('required|string|min:8', but not
    a token such as '12|abc…') or a short label without digits ('Password')."""
    if VALIDATION_RULE_RE.match(v) and any(r.split(":")[0].startswith("required") or r.split(":")[0] in VALIDATION_RULES
                                           for r in v.split("|")):
        return True
    return len(v) < 16 and not re.search(r"[0-9]", v)


def secret_hits(line, path=""):
    """(pattern name, matched value) for each built-in key pattern that matches a line."""
    hits = []
    for name, rx in KEY_PATTERNS:
        for m in rx.finditer(line):
            if name == "secret-assignment":
                if PLACEHOLDER_RE.search(m.group("v")) or TEST_PATH_RE.search(path or "") or \
                        plain_text_value(m.group("v")):
                    continue
                hits.append((name, m.group("v")))
            else:
                hits.append((name, m.group(0)))
    return hits


def scan_secrets_builtin(ctx, job, mb, rdir=None):
    """Without gitleaks: well-known key formats, literals assigned to secret-named variables (not in test code)
    and this machine's secrets (local_secret_values), in the lines the unpushed commits add (without mb, every commit).
    Narrower than gitleaks, but no false alarms on test passwords."""
    wt = job["worktree"]
    revs = ["%s..HEAD" % (unpushed_base(job) or mb), "^" + job["base_ref"]] if mb else ["HEAD"]
    r = git(["log", "-p", "--no-color", "--no-ext-diff", "--no-textconv", "--format=commit %H"] + revs, wt, check=False)
    if r.returncode != 0:
        return None, "git log failed: " + (r.stdout or "")[-200:]
    env_values = local_secret_values(ctx)
    found, seen, commit, path, line_no = [], set(), "", "", 0
    for line in (r.stdout or "").splitlines():
        if line.startswith("commit "):
            commit = line[7:17]
        elif line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            line_no = int(m.group(1)) - 1 if m else 0
        elif line.startswith("+"):
            line_no += 1
            hits = [name for name, _ in secret_hits(line[1:], path)]
            hits += ["local-env-value" for v in env_values if v in line][:1]
            for name in hits:
                key = (path, line_no, name)
                if key in seen:
                    continue
                seen.add(key)
                found.append({"tool": "fx secrets", "severity": "critical", "new": True, "secret": True,
                              "rule": name, "location": "%s:%d" % (path, line_no),
                              "message": "possible secret (%s) in commit %s" % (name, commit),
                              "cwe": "CWE-798", "owasp": "A04:2025 Cryptographic Failures"})
        elif not line.startswith("-"):
            line_no += 1
    return found, None


def scan_secrets(ctx, job, mb, rdir):
    """gitleaks when installed, else the built-in check. Returns (findings, error, note)."""
    if shutil.which("gitleaks"):
        try:
            f, err = scan_gitleaks(ctx, job, mb, rdir)
        except subprocess.TimeoutExpired as e:
            return None, "gitleaks: no result within %d seconds" % e.timeout, None
        return f, err, None
    f, err = scan_secrets_builtin(ctx, job, mb, rdir)
    return f, err, ("gitleaks not installed: only the built-in check ran (well-known key formats and local env "
                    "values; /code-factory:factory install adds gitleaks)")


REDACTED = "[redacted by fx]"


def scrub_text(ctx, text, local=None):
    """Text fx posts outside this machine (the PR body and title, Jira comments): the built-in key patterns and
    this machine's secrets (local_secret_values, or local when the caller already has them) are replaced by a marker.
    Returns (text, names of what was redacted)."""
    found = []
    values = set()
    for line in (text or "").splitlines():
        for name, v in secret_hits(line):
            found.append(name)
            values.add(v)
    for v in (local_secret_values(ctx) if local is None else local):
        if v in (text or ""):
            found.append("local-env-value")
            values.add(v)
    for v in sorted(values, key=len, reverse=True):
        text = text.replace(v, REDACTED)
    return text, sorted(set(found))


def semgrep_rules(ctx):
    """security.semgrep_config: one set of rules or a list of them; empty means fx's own list."""
    cfg = ctx.c("security.semgrep_config") or SEMGREP_RULES
    return [cfg] if isinstance(cfg, str) else list(cfg)


def semgrep_rule_args(ctx, wt, notes):
    """--config arguments for the rules, and which of them come from the registry."""
    rules, registry = [], []
    for cfg in semgrep_rules(ctx):
        if not os.path.isabs(os.path.expanduser(cfg)) and os.path.exists(os.path.join(ctx.factory, cfg)):
            cfg = os.path.join(ctx.factory, cfg)  # rules kept in the factory repository, out of the builder's reach
        elif os.path.exists(os.path.join(wt, cfg)):
            notes.append("semgrep: the rules %s are read from the job's clone, which the builder can change; keep "
                         "them in the factory repository" % cfg)
        else:
            registry.append(cfg)
        rules += ["--config", cfg]
    return rules, registry


def semgrep_excludes(ctx):
    """What semgrep skips. fx's own list, kept in the factory repository: --x-ignore-semgrepignore-files keeps the builder's
    .semgrepignore out, and semgrep's built-in list goes with it."""
    skip = ctx.c("security.semgrep_exclude")
    return SEMGREP_EXCLUDE if skip is None else [skip] if isinstance(skip, str) else list(skip)


def semgrep_skips(path, patterns):
    """Whether semgrep's --exclude leaves a file out, as semgrep itself reads it: a pattern without a slash matches any
    folder or file name on the way, one with a slash the start of the path."""
    path = path or ""
    for pat in patterns:
        pat = pat.strip("/")
        if "/" not in pat:
            if any(fnmatch.fnmatch(part, pat) for part in path.split("/")):
                return True
        elif path_glob(path, pat) or path_glob(path, pat + "/**"):
            return True
    return False


def semgrep_rule_id(ctx, check_id):
    """Semgrep puts the folder of a local rules file in front of the id. Relative to the factory repository, an accepted
    rule means the same on every machine."""
    for base in (ctx.factory, os.path.realpath(ctx.factory)):
        prefix = base.strip(os.sep).replace(os.sep, ".") + "."
        if check_id.startswith(prefix):
            return check_id[len(prefix):]
    return check_id


def semgrep_failure(r, data, registry):
    """Why a semgrep run gave no results, or None when it did. No output at all with rules from the registry is the
    network, whatever stderr says: fx's own --x- option always puts a warning there."""
    errors = [e for e in (data or {}).get("errors", []) if str(e.get("level", "error")).lower() == "error"]
    if data is not None and r.returncode in (0, 1) and not errors:
        return None
    if errors:
        return errors[0].get("message") or errors[0].get("long_msg") or errors[0].get("short_msg") or \
            "semgrep reported an error: %s" % str(errors[0].get("type"))[:100]
    if registry and not (r.stdout or "").strip():
        return ("could not load the rules %s from semgrep.dev (no network?); set security.semgrep_config to a local "
                "rules file or folder to scan offline" % ", ".join(registry))
    said = "\n".join(l for l in ((r.stderr or "") + "\n" + (r.stdout or "")).splitlines() if "--x-" not in l and l.strip())
    return said[-300:] or "no output"


def scanner_probes(ctx, tree):
    """Real tries of what the scanners need on this machine, so nobody first learns it from a failed gate: semgrep loads
    its rules, osv-scanner reads the project's dependencies (tree: a checkout of the base branch). Slow, so only for fx
    doctor and fx selftest. [(check, ok, detail)]; a scanner that is not required only gets advice."""
    rows, on, required = [], scanners_on(ctx), required_scanners(ctx)

    def row(name, scanner, why, how):
        need = scanner in required
        rows.append((name if need else name + " (advice)", not (why and need),
                     "%s. %s or take %s out of security.required" % (why, how, scanner) if why else "yes"))
    if on["semgrep"] and shutil.which("semgrep"):
        empty = tempfile.mkdtemp(prefix="fx-semgrep-try-")
        try:
            write_atomic(os.path.join(empty, "try.py"), "x = 1\n")
            args, registry = semgrep_rule_args(ctx, empty, [])
            r = run_sep(["semgrep", "scan"] + args + ["--json", "--metrics", "off", "--quiet", "."], cwd=empty,
                        env=project_env(ctx), timeout=300)
            why = semgrep_failure(r, first_json(r.stdout), registry)
        except subprocess.TimeoutExpired:
            why = "no answer within 5 minutes (no network?)"
        finally:
            shutil.rmtree(empty, ignore_errors=True)
        row("semgrep can load its rules", "semgrep", why, "Set security.semgrep_config to local rules,")
    if on["osv"] and shutil.which("osv-scanner") and tree:
        own = tempfile.mkdtemp(prefix="fx-osv-cfg-")
        here = tempfile.mkdtemp(prefix="fx-osv-head-")
        try:
            cfg, why = osv_config(ctx, own)
            why = why or export_commit(ctx, tree, "HEAD", here)
            head, why = osv_scan_dir(here, cfg, project_env(ctx)) if not why else ({}, why)
            unlocked = unlocked_manifests(tree, "HEAD", set(osv_packages(head, here))) if not why else []
        except subprocess.TimeoutExpired:
            why, head, unlocked = "no answer within 15 minutes (no network?)", {}, []
        finally:
            shutil.rmtree(here, ignore_errors=True)
            shutil.rmtree(own, ignore_errors=True)
        if not why and unlocked and head.get("no_sources"):
            why = "it reads nothing here: %s ha%s no lockfile, so every gate would fail" % (
                ", ".join(unlocked[:5]), "s" if len(unlocked) == 1 else "ve")
        if not why and unlocked:
            rows.append(("osv-scanner can read every dependency (advice)", True,
                         "no lockfile for %s, so those go unchecked" % ", ".join(unlocked[:10])))
        else:
            row("osv-scanner can read the dependencies", "osv", why, "Commit a lockfile,")
    return rows


def scan_semgrep(ctx, job, mb, rdir, notes=None):
    """semgrep on what the job changed (without mb, on the whole tree). nosemgrep/nosem comments never hide a finding
    (--disable-nosem), and the clone's .semgrepignore files are ignored where this semgrep allows it (else a note
    says they applied)."""
    notes = notes if notes is not None else []
    wt = job["worktree"]
    rules, registry = semgrep_rule_args(ctx, wt, notes)
    skip = semgrep_excludes(ctx)
    common = ["semgrep", "scan"] + rules + ["--json", "--metrics", "off", "--quiet", "--disable-nosem"]
    base = list(common)
    for pattern in skip:
        base += ["--exclude", pattern]
    unseen = []
    if mb:
        # Everything a job changes, at any size: by default semgrep passes over a file above 1 MB without a word.
        base += ["--baseline-commit", mb, "--max-target-bytes", "0"]
        common += ["--baseline-commit", mb, "--max-target-bytes", "0"]
        unseen = [p for p in git(["diff", "--name-only", "--diff-filter=d", "-z", mb, "HEAD"], wt, check=False).stdout.split("\0")
                  if p and semgrep_skips(p, skip) and os.path.isfile(os.path.join(wt, p))
                  and not os.path.islink(os.path.join(wt, p))]  # semgrep refuses a link as a target, and does not follow one
    env = project_env(ctx)

    def scan(cmd, targets, report):
        """One run; (its JSON, why it failed)."""
        r = run_sep(cmd + ["--x-ignore-semgrepignore-files"] + targets, cwd=wt, env=env, timeout=SEMGREP_TIMEOUT_SEC)
        if r.returncode not in (0, 1) and re.search(r"(?i)(no such option|unknown option|unrecognized)",
                                                     (r.stderr or "") + (r.stdout or "")[:2000]):
            r = run_sep(cmd + targets, cwd=wt, env=env, timeout=SEMGREP_TIMEOUT_SEC)  # an older semgrep: it reads .semgrepignore
            ign = sorted(f for f in git(["ls-files", "--", ".semgrepignore", "*/.semgrepignore"], wt).stdout.split())
            if ign and not any(".semgrepignore" in n for n in notes):
                notes.append("semgrep: this semgrep cannot ignore the repository's %s (they applied; changes to them "
                             "are flagged)" % ", ".join(ign))
        write_atomic(os.path.join(rdir, report), r.stdout or "")
        data = first_json(r.stdout)
        why = semgrep_failure(r, data, registry)
        if why:
            return None, "semgrep failed (exit %s): %s" % (r.returncode, str(why)[:300])
        partial = sorted({e.get("path") for e in data.get("errors", []) if e.get("path")})
        if partial:
            notes.append("semgrep: could not read all of %s; those parts went unchecked" % ", ".join(partial[:10]))
        return data, None

    data, err = scan(base, [], "semgrep.json")
    if err:
        return None, err
    results = [f for f in data.get("results", []) if not semgrep_skips(f.get("path"), skip)]  # whatever it made of --exclude
    if unseen:
        # The builder chooses where a file goes, so what a job changes is looked at wherever it is. Named, a file is scanned
        # whatever --exclude says; a name that starts with a dash needs the ./ too.
        for i in range(0, len(unseen), SEMGREP_NAMED_BATCH):
            batch = unseen[i:i + SEMGREP_NAMED_BATCH]
            data, err = scan(common, ["./" + p for p in batch], "semgrep-excluded-%d.json" % (i // SEMGREP_NAMED_BATCH))
            if err:
                return None, err
            results += [f for f in data.get("results", []) if posixpath.normpath(f.get("path") or "") in batch]
        notes.append("semgrep: this job changes %d file(s) where semgrep does not normally look (security.semgrep_exclude), "
                     "and they were scanned: %s" % (len(unseen), ", ".join(unseen[:10])))
    found = []
    for f in results:
        ex = f.get("extra") or {}
        md = ex.get("metadata") or {}
        cwe = md.get("cwe")
        owasp = md.get("owasp")
        sev = sev_word(md.get("impact") if md.get("impact") in ("HIGH", "CRITICAL") else ex.get("severity"))
        path = posixpath.normpath(f.get("path") or "")
        low = SEV_RANK.get(sev, 2) < SEV_RANK["high"]
        # INFO is the lowest of semgrep's three levels, still a rule about security: low, not a mere remark.
        found.append({"tool": "semgrep", "severity": "low" if sev == "info" else sev, "new": True,
                      # A warning about test code is seldom a hole in the product; something serious there still is.
                      "test_code": bool(TEST_ONLY_RE.search(path)) and low,
                      "look": bool(TEST_ONLY_RE.search(path)) and low and not TEST_NAME_RE.search(path),
                      "rule": semgrep_rule_id(ctx, f.get("check_id") or ""), "path": path,
                      "location": "%s:%s" % (path, (f.get("start") or {}).get("line")),
                      "message": (ex.get("message") or "")[:300],
                      "cwe": ", ".join(cwe) if isinstance(cwe, list) else cwe,
                      "owasp": ", ".join(owasp) if isinstance(owasp, list) else owasp})
    tests = sorted({f["path"] for f in found if f["test_code"] and not f["look"]})
    if tests:  # the builder chooses where a file goes here too
        notes.append("semgrep: findings below high in test code do not block: %s" % ", ".join(tests[:10]))
    tests = sorted({f["path"] for f in found if f["look"]})
    if tests:
        notes.append("semgrep: findings below high do not block in test folders, but these files have no test's name, so a "
                     "human must look: %s" % ", ".join(tests[:10]))
    return found, None


OSV_TOO_OLD = ("osv-scanner v1 has no --all-packages, which fx needs: update to v2 or newer (brew upgrade osv-scanner, or a "
               "release from github.com/google/osv-scanner)")


def osv_scan_dir(path, config, env=None):
    """config: fx's own osv-scanner.toml, which replaces every osv-scanner.toml of the scanned tree (their
    IgnoredVulns would let the builder hide a vulnerability)."""
    txt = ""
    # --no-ignore: a .gitignore is the builder's too, and osv-scanner honours one even with no git around it.
    # --all-packages: fx must also see what was read that has no vulnerability, to tell it from what could not be read.
    for cmd in (["osv-scanner", "scan", "source", "-r", "--no-ignore", "--all-packages", "--format", "json", "--config",
                 config, path],
                ["osv-scanner", "--no-ignore", "--all-packages", "--format", "json", "--config", config, "-r", path]):
        r = run_sep(cmd, env=env, timeout=OSV_TIMEOUT_SEC)
        txt = (r.stdout or "") + (r.stderr or "")
        data = first_json(r.stdout)
        # One file it cannot parse makes it exit 127 with the rest of the results, and fx sees to that file itself.
        if data is not None and (r.returncode in (0, 1) or "Error during extraction" in txt):
            m = re.search(r"Filtered (\d+) local/unscannable", txt)
            if m and isinstance(data, dict):
                data["unscannable"] = int(m.group(1))
            return data, None
        if "no package sources found" in txt.lower() or r.returncode == 128:
            return {"results": [], "no_sources": True}, None
    if "flag provided but not defined" in txt and "all-packages" in txt:
        return None, OSV_TOO_OLD
    return None, "osv-scanner failed: %s" % (txt[-300:] if txt else "no output")


