def cmd_setup(ctx, a):
    """Install dependencies in each clone of the job, in repo_order: its repository's setup command, once."""
    job = ctx.load(a.job)
    names = job_clones(job)
    if getattr(a, "repo_name", None):
        if a.repo_name not in names:
            raise FxError("%s has no clone of %s (its repositories: %s)" % (job["id"], a.repo_name, ", ".join(names)),
                          code=3)
        names = [a.repo_name]
    if not names:
        raise FxError("%s has no clones yet: intake names its repositories, then fx repos clones them" % job["id"], code=3)
    todo = [n for n in names if a.force or not job["repos"][n].get("setup_done")]
    if not todo:
        out({"ok": True, "job": job["id"], "skipped": "already done"})
        return
    several = len(job["repos"]) > 1
    logs = {}
    for n in todo:
        e = job["repos"][n]
        cmd = ctx.rc(n, "setup", "")
        log = os.path.join(ctx.job_dir(job["id"]), "setup-%s.log" % n if several else "setup.log")
        if cmd:
            if not os.path.isdir(e.get("worktree") or ""):
                raise FxError("the clone of %s is missing (%s): fx rework or a new attempt" % (n, e.get("worktree")),
                              code=3)
            timeout = int(ctx.rc(n, "setup_timeout_sec", 1800) or 1800)
            try:
                p = run(["bash", "-lc", cmd], cwd=e["worktree"], check=False, env=project_env(ctx), timeout=timeout)
            except subprocess.TimeoutExpired as ex:
                write_atomic(log, (ex.output or "") if isinstance(ex.output, str) else "")
                ctx.save(job, "setup timed out in %s" % n)
                raise FxError("setup%s timed out after %ss; see %s" % (" of %s" % n if several else "", timeout, log),
                              code=3)
            write_atomic(log, p.stdout or "")
            if p.returncode != 0:
                ctx.save(job, "setup failed in %s" % n)
                raise FxError("setup%s failed (exit %d); see %s" % (" of %s" % n if several else "", p.returncode, log),
                              code=3)
            logs[n] = log
        e["setup_done"] = True
    ctx.save(job, "worktree setup done" if not several else "setup done: %s" % ", ".join(todo))
    res = {"ok": True, "job": job["id"], "log": logs.get(todo[0]) if not several else None}
    if several:
        res["logs"] = logs
    out(res)


