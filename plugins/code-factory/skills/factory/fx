# split build: one ticket, several builders in parallel, each owning its own files

WP_ID_RE = re.compile(r"^wp\d+$")
WP_STATUS_RE = re.compile(r"^STATUS:\s*(READY|BLOCKED|NEEDS-INFO|CHANGE-REQUEST)\s*$")
TERMINAL_WP = ("integrated", "blocked")


def parse_plan(text):
    first = (text or "").strip().splitlines()[0].strip() if (text or "").strip() else ""
    m = re.match(r"^PLAN:\s*(SPLIT|SINGLE)\s*$", first)
    if not m:
        return None, None, "the first line of plan.md must be PLAN: SPLIT or PLAN: SINGLE"
    if m.group(1) == "SINGLE":
        return "single", [], None
    blocks = re.findall(r"```json\s*\n(.*?)```", text, re.S)
    if not blocks:
        return "split", None, "a SPLIT plan needs a ```json block with the packages"
    try:
        data = json.loads(blocks[-1])
    except ValueError as e:
        return "split", None, "the json block of plan.md is not valid JSON: %s" % e
    return "split", data.get("packages") if isinstance(data, dict) else None, None


def package_repo(p_, repos):
    """The repository a package belongs to: its "repo", or the job's only changed one."""
    return p_.get("repo") if isinstance(p_, dict) and p_.get("repo") else (repos[0] if repos else None)


def validate_packages(pkgs, files, repos=None):
    """files: the files of the job's clone, or {repo: its files} with repos, the job's changed repositories: then each
    package belongs to one of them ("repo"; it may be left out when there is one) and owns files there only."""
    problems = []
    if not isinstance(pkgs, list) or len(pkgs) < 2:
        return ["a SPLIT plan needs at least two packages (otherwise write PLAN: SINGLE)"]
    for p_ in pkgs:
        if isinstance(p_, dict) and repos and package_repo(p_, repos) not in repos:
            problems.append("%s: repo must be one of the repositories the job changes (%s)" % (
                p_.get("id"), ", ".join(repos)))
        elif isinstance(p_, dict) and repos and len(repos) > 1 and not p_.get("repo"):
            problems.append("%s: name its repository (repo: %s)" % (p_.get("id"), " or ".join(repos)))
    ids = [p_.get("id") for p_ in pkgs if isinstance(p_, dict)]
    if len(ids) != len(pkgs) or len(set(ids)) != len(ids) or not all(isinstance(i, str) and WP_ID_RE.match(i)
                                                                      for i in ids):
        problems.append("package ids must be unique and look like wp0, wp1, …")
    for p_ in pkgs:
        if not isinstance(p_, dict):
            continue
        if not p_.get("owns") or not isinstance(p_["owns"], list):
            problems.append("%s: owns must list the files or globs it may change" % p_.get("id"))
        for dep in p_.get("after") or []:
            if dep not in ids:
                problems.append("%s: after %s, which is not a package" % (p_.get("id"), dep))
    # Cycles.
    deps = {p_["id"]: set(p_.get("after") or []) for p_ in pkgs if isinstance(p_, dict) and p_.get("id")}
    seen, stack = set(), set()

    def visit(n):
        if n in stack:
            return True
        if n in seen:
            return False
        seen.add(n)
        stack.add(n)
        cyc = any(visit(d) for d in deps.get(n, ()) if d in deps)
        stack.discard(n)
        return cyc
    if any(visit(n) for n in deps):
        problems.append("the packages wait for each other in a circle (after)")
    # No file may belong to two packages (of the same repository).
    globs = {}
    for p_ in pkgs:
        for g in (p_.get("owns") or []) if isinstance(p_, dict) else []:
            key = (package_repo(p_, repos), g)
            if key in globs and globs[key] != p_.get("id"):
                problems.append("%s is owned by both %s and %s" % (g, globs[key], p_.get("id")))
            globs.setdefault(key, p_.get("id"))
    groups = files.items() if isinstance(files, dict) else [(None, files)]
    for repo, group in groups:
        mine = [p_ for p_ in pkgs if isinstance(p_, dict) and (repo is None or package_repo(p_, repos) == repo)]
        for f in group:
            owners = [p_["id"] for p_ in mine if match_any(f, p_.get("owns") or [])]
            if len(owners) > 1:
                problems.append("%s%s matches the files of %s: every file must belong to one package" % (
                    "%s:" % repo if repo and len(groups) > 1 else "", f, " and ".join(owners)))
                if len(problems) > 30:
                    return problems
    return problems


def wp_pseudo_job(ctx, job, pid):
    p_ = job["split"]["packages"][pid]
    return dict(job, id="%s-%s" % (job["id"], pid), worktree=p_["clone"], port=p_["port"],
                app_dir=os.path.join(ctx.job_dir(job["id"]), "wp", pid))


def wp_open_clone(ctx, job, pid):
    """The package's own clone of its repository, on its own branch, with everything already merged into the job's
    branch there."""
    p_ = job["split"]["packages"][pid]
    e = job["repos"][p_.get("repo") or job_primary(job)]
    if os.path.isdir(p_["clone"]):
        git(["fetch", "-q", "origin", e["branch"]], p_["clone"])
        if git_job(["merge", "--no-edit", "-q", "FETCH_HEAD"], p_["clone"], check=False).returncode != 0:
            git_job(["merge", "--abort"], p_["clone"], check=False)
            raise FxError("package %s's clone cannot take the latest merged code; its unmerged work conflicts" % pid,
                          code=3)
    else:
        if os.path.exists(p_["clone"]):
            shutil.rmtree(p_["clone"], ignore_errors=True)
        run(["git", "clone", "-q", e["worktree"], p_["clone"]], check=True)
        git(["checkout", "-q", "-b", p_["branch"], "origin/%s" % e["branch"]], p_["clone"])
        copy_local_files(ctx, p_["clone"], p_.get("repo"))
        baselines_fill_clone(ctx, p_["clone"], p_.get("repo"))
    p_["base"] = git(["rev-parse", "HEAD"], p_["clone"]).stdout.strip()


def cmd_split(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "build":
        raise FxError("split runs in the build stage; %s is in %s" % (job["id"], job["stage"]))
    if job.get("best_of") and not job.get("best_of_done"):
        raise FxError("this job builds best-of-N candidates; it is not split")
    jd = ctx.job_dir(job["id"])
    mode, pkgs, err = parse_plan(read(os.path.join(jd, "plan.md"), "") or "")
    if err:
        raise FxError(err, code=6, extra={"retry_agent": "planner"})
    old = (job.get("split") or {}).get("packages") or {}
    if mode == "single":
        if old and not a.update:
            raise FxError("the job is already split")
        job["split"] = {"mode": "single"}
        ctx.save(job, "plan: one builder")
        out({"ok": True, "job": job["id"], "mode": "single", "next": "build"})
        return
    repos = job_names(job, "change")
    files = {n: list_files(job["repos"][n]["worktree"]) for n in repos}
    problems = validate_packages(pkgs, files, repos)
    if problems:
        raise FxError("plan.md: " + "; ".join(problems[:15]), code=6, extra={"retry_agent": "planner",
                                                                           "problems": problems})
    if old and not a.update:
        raise FxError("the job is already split; use --update after the planner changed plan.md")
    slot_base = int(ctx.c("ports.base", 5100)) + 5000 + 100 * int(job.get("slot") or 0)
    packages = {}
    for i, p_ in enumerate(pkgs):
        pid = p_["id"]
        prev = old.get(pid) or {}
        repo = package_repo(p_, repos)
        e = job["repos"][repo]
        entry = {"title": str(p_.get("title") or pid)[:120], "repo": repo, "owns": list(p_["owns"]),
                 "after": list(p_.get("after") or []), "contract": bool(p_.get("contract")),
                 "criteria": p_.get("criteria") or [],
                 "clone": "%s--%s" % (e["worktree"], pid), "branch": "%s--%s" % (e["branch"], pid),
                 "port": prev.get("port") or slot_base + i, "db": app_db(ctx, {"id": "%s-%s" % (job["id"], pid)}),
                 "status": prev.get("status", "pending"), "tries": prev.get("tries", 0), "reason": prev.get("reason"),
                 "feedback": prev.get("feedback"), "base": prev.get("base")}
        if prev.get("status") == "request" or p_.get("reopen"):
            entry.update(status="pending", reason="resumed", request=None)
        packages[pid] = entry
    job["split"] = {"mode": "split", "packages": packages, "order": [p_["id"] for p_ in pkgs],
                    "integrator_feedback": (job.get("split") or {}).get("integrator_feedback")}
    ctx.save(job, "plan: %d packages" % len(pkgs))
    out({"ok": True, "job": job["id"], "mode": "split",
         "packages": [{"id": k, "title": v["title"], "repo": v["repo"], "after": v["after"], "owns": v["owns"]}
                      for k, v in packages.items()], "next": "wp next"})


def wp_report(ctx, job, pid):
    path = os.path.join(ctx.job_dir(job["id"]), "build-%s.md" % pid)
    line = first_line(path)
    m = WP_STATUS_RE.match(line or "")
    return (m.group(1) if m else None), read(path, "") or "", path


def wp_integrate(ctx, job, pid):
    """Merge a finished package into the job's branch of its repository, if it kept to its own files."""
    p_ = job["split"]["packages"][pid]
    pc = p_["clone"]
    repo = p_.get("repo") or job_primary(job)
    e = job["repos"][repo]
    tracked, untracked = worktree_dirt(ctx, pc, repo)
    problems = []
    if tracked or untracked:
        problems.append("uncommitted work in your clone: commit it (%s)" % ", ".join(
            (tracked.splitlines() + untracked)[:5]))
    # What merging this package would change in the job's branch (other packages' merged work excluded).
    git(["fetch", "-q", "origin", e["branch"]], pc)
    changed = git(["diff", "--name-only", "FETCH_HEAD...HEAD"], pc).stdout.split()
    pkgs = {k: v for k, v in job["split"]["packages"].items() if (v.get("repo") or repo) == repo}
    for f in changed:
        owners = [k for k, v in pkgs.items() if match_any(f, v["owns"])]
        if pid not in owners:
            problems.append("%s is not one of your files%s" % (f, " (it belongs to %s)" % ", ".join(owners)
                                                                if owners else ""))
        elif len(owners) > 1:
            problems.append("%s belongs to %s as well" % (f, ", ".join(o for o in owners if o != pid)))
    if not changed and not problems:
        p_["status"] = "integrated"
        p_["reason"] = None
        return []
    if problems:
        return problems
    wt = e["worktree"]
    git(["fetch", "-q", pc, p_["branch"]], wt)
    mr = git_job(["merge", "--no-ff", "--no-edit", "-m", "%s: merge %s (%s)" % (job["issue_key"], pid, p_["title"]),
                  "FETCH_HEAD"], wt, check=False)
    if mr.returncode != 0:
        git(["merge", "--abort"], wt, check=False)
        return ["merging into the job's branch conflicts: %s" % (mr.stdout or "")[-300:]]
    baselines_take_images(ctx, pc, wt, repo)
    p_["status"] = "integrated"
    p_["reason"] = None
    p_["merged"] = git(["rev-parse", "HEAD"], wt).stdout.strip()
    return []


FINDING_PLACE_RE = re.compile(r"(?:(?<![\w./-])([a-z][a-z0-9-]{0,30}):)?"
                              r"([\w./-]+/[\w.-]+\.[A-Za-z0-9]+|[\w-]+\.[A-Za-z]{1,5})(?::\d+)?")


def finding_places(line, repos, roots=None):
    """The files a finding names, as (repository, path): repo:path names its repository, and so does a line that starts
    with one ("[gate] be: ..."). A plain path in a job of one repository is that one's (None: any package). In a job of
    several, it is the repository whose clone (roots: {repo: folder}) has that file, when exactly one has it; else ""
    (no package's: the integrator's)."""
    lead = re.match(r"^\s*(?:\[[\w-]+\]\s*)?(?:-\s*)?(?:\d+\.\s*)?(?:\[blocking\]\s*)?\**([a-z][a-z0-9-]{0,30}):\s", line)
    default = lead.group(1) if lead and lead.group(1) in repos else None
    found = []
    for m in FINDING_PLACE_RE.finditer(line):
        repo, path = m.group(1), m.group(2)
        if path.startswith("round-"):
            continue
        if repo in repos:
            found.append((repo, path))
        elif default or len(repos) <= 1:
            found.append((default, path))
        else:
            have = [n for n in repos if os.path.isfile(os.path.join((roots or {}).get(n) or "", path.lstrip("./")))
                    and (roots or {}).get(n)]
            found.append((have[0] if len(have) == 1 else "", path))
    return found


def cmd_wp(ctx, a):
    job = ctx.load(a.job)
    sp = job.get("split") or {}
    if sp.get("mode") != "split":
        raise FxError("%s is not a split build" % job["id"])
    pkgs = sp["packages"]
    jd = ctx.job_dir(job["id"])
    if a.action == "done":
        if a.id not in pkgs:
            raise FxError("no package %s" % a.id)
        status, text, path = wp_report(ctx, job, a.id)
        if not status:
            raise FxError("%s is missing or does not start with STATUS: READY|BLOCKED|NEEDS-INFO|CHANGE-REQUEST"
                          % os.path.basename(path), code=6, extra={"retry_agent": "builder", "wp": a.id})
        p_ = pkgs[a.id]
        res = {"ok": True, "job": job["id"], "package": a.id, "status": status}
        if status == "READY":
            problems = wp_integrate(ctx, job, a.id)
            if problems:
                p_["tries"] = p_.get("tries", 0) + 1
                fb = os.path.join(jd, "wp-%s-feedback-%d.md" % (a.id, p_["tries"]))
                write_atomic(fb, "# Package %s was not merged\n\n" % a.id + "\n".join("- " + x for x in problems) + "\n")
                if p_["tries"] > int(ctx.c("split.max_tries", 2)):
                    p_.update(status="blocked", reason="kept failing: %s" % problems[0])
                else:
                    p_.update(status="pending", reason="violation", feedback=fb)
                res.update(status=p_["status"], problems=problems)
            else:
                res["merged"] = True
        elif status == "CHANGE-REQUEST":
            p_.update(status="request", request=section(text, "Change request") or text[:1500])
        elif status == "NEEDS-INFO":
            p_.update(status="question")
        else:
            p_.update(status="blocked", reason=(section(text, "Why") or text.split("\n", 2)[-1]).strip()[:500])
        res["status"] = p_["status"]
        ctx.save(job, "package %s: %s" % (a.id, p_["status"]))
        res["next"] = "wp next"
        out(res)
        return
    if a.action == "feedback":
        n = job["round"]
        rdir = os.path.join(jd, "round-%d" % n)
        lines_ = []
        cm = read(os.path.join(rdir, "checks.md"), "") or ""
        if cm.startswith("GATE: FAIL"):
            lines_ += ["[gate] " + l for l in (section(cm, "Problems") or "").split("\n- ") if l.strip()]
        for f in sorted(os.listdir(rdir)) if os.path.isdir(rdir) else []:
            if re.match(r"^review-\w+\.md$", f) and (first_line(os.path.join(rdir, f)) or "").endswith("CHANGES"):
                if f == "review-security.md" and (first_line(os.path.join(rdir, "verify-security.md")) or "") \
                        .endswith("PASS"):
                    continue
                for l in (read(os.path.join(rdir, f), "") or "").splitlines():
                    if FINDING_RE.match(l):
                        lines_.append("[%s] %s" % (f[7:-3], l.strip()))
        assigned, rest = {}, []
        roots = {n: job["repos"][n].get("worktree") for n in job_names(job, "change")}
        for l in lines_:
            owners = {k for repo, path in finding_places(l, job_names(job, "change"), roots) for k, v in pkgs.items()
                      if (repo is None or (v.get("repo") or job_primary(job)) == repo) and match_any(path, v["owns"])}
            if len(owners) == 1:
                assigned.setdefault(owners.pop(), []).append(l)
            else:
                rest.append(l)
        for k, ls in assigned.items():
            fb = os.path.join(rdir, "feedback-%s.md" % k)
            write_atomic(fb, "# Round %d findings for package %s\n\nFull reports: %s\n\n%s\n" % (
                n, k, rdir, "\n".join("- " + l for l in ls)))
            pkgs[k].update(status="pending", reason="feedback", feedback=fb, tries=0)
        sp["integrator_feedback"] = None
        if rest:
            fb = os.path.join(rdir, "feedback-integrator.md")
            write_atomic(fb, "# Round %d findings no single package owns\n\nFull reports: %s\n\n%s\n" % (
                n, rdir, "\n".join("- " + l for l in rest)))
            sp["integrator_feedback"] = fb
        ctx.save(job, "round %d findings: %s to packages, %d to the integrator" % (n, sorted(assigned), len(rest)))
        out({"ok": True, "job": job["id"], "packages": sorted(assigned), "integrator": bool(rest), "next": "wp next"})
        return
    # next: start whatever can start now; say what the orchestrator should do.
    building = [k for k, v in pkgs.items() if v["status"] == "building"]
    cap = int(ctx.c("split.max_builders", 0) or 0)
    ready = [k for k in sp["order"] if pkgs[k]["status"] == "pending"
             and all(pkgs[d]["status"] == "integrated" for d in pkgs[k]["after"])]
    if cap:
        ready = ready[:max(0, cap - len(building))]
    for k in ready:
        wp_open_clone(ctx, job, k)
        pkgs[k]["status"] = "building"
    if ready:
        ctx.save(job, "packages started: %s" % ", ".join(ready))
        out({"ok": True, "job": job["id"], "start": [{"id": k, "title": pkgs[k]["title"]} for k in ready],
             "building": building, "next": "spawn a builder for each started package (fx ctx <job> --agent builder "
                                           "--wp <id>), in the background; on each one's completion: fx wp done"})
        return
    if building:
        out({"ok": True, "job": job["id"], "building": building, "next": "wait"})
        return
    requests = [k for k, v in pkgs.items() if v["status"] == "request"]
    if requests:
        out({"ok": True, "job": job["id"], "requests": {k: pkgs[k].get("request") for k in requests},
             "next": "planner"})
        return
    questions = [k for k, v in pkgs.items() if v["status"] == "question"]
    if questions:
        qs, n = [], 0
        for k in questions:
            rep_text = wp_report(ctx, job, k)[1]
            i = rep_text.find("## Questions")
            text = rep_text[i + len("## Questions"):] if i >= 0 else ""
            text = re.split(r"(?m)^##\s+(?!Q\d+:)", text)[0]
            for blk in re.split(r"(?m)^## Q\d+:", text)[1:]:
                n += 1
                qs.append("## Q%d: [%s] %s" % (n, k, blk.strip()))
            pkgs[k].update(status="pending", reason="answers") if text.strip() else \
                pkgs[k].update(status="blocked", reason="asked for information without a ## Questions section")
        if not qs:
            ctx.save(job, "package questions missing")
            out({"ok": True, "job": job["id"], "next": "wp next"})
            return
        write_atomic(os.path.join(jd, "questions.md"), "\n\n".join(qs) + "\n")
        set_needs_info(ctx, job, "build")
        out({"ok": True, "job": job["id"], "questions_from": questions, "next": "ask"})
        return
    waiting = [k for k, v in pkgs.items() if v["status"] not in TERMINAL_WP]
    blocked = [k for k, v in pkgs.items() if v["status"] == "blocked"]
    if blocked or waiting:
        lines_ = ["STATUS: BLOCKED", "", "## Why", ""]
        lines_ += ["- %s (%s): %s" % (k, pkgs[k]["title"], pkgs[k].get("reason") or "blocked") for k in blocked]
        lines_ += ["- %s (%s): could not start, it waits for a blocked package" % (k, pkgs[k]["title"])
                   for k in waiting]
        write_atomic(os.path.join(jd, "build.md"), "\n".join(lines_) + "\n")
        ctx.save(job, "split build blocked")
        out({"ok": True, "job": job["id"], "blocked": blocked, "next": "result build"})
        return
    out({"ok": True, "job": job["id"], "next": "integrate",
         "note": "every package is merged: spawn one builder without --wp (the integrator)"})


