def next_local_key(ctx, warnings=None):
    """The lowest number free here and, with a jobs store, on S3: a new machine must not start again from LOCAL-1."""
    ids = ctx.list_ids() + jobs_ids_on_s3(ctx, warnings if warnings is not None else [])
    n = 1
    while any(i == "LOCAL-%d" % n or i.startswith("LOCAL-%d-r" % n) for i in ids):
        n += 1
    return "LOCAL-%d" % n


COMMON_BRANCHES = ("main", "master", "develop", "development", "dev", "staging")


def branch_choices(ctx, first=(), repo=None):
    """A repository's branches for the user to pick from: the given ones and the configured base first, then the
    usual long-lived ones, release/ and hotfix/ branches (newest names first), the rest; factory/* left out."""
    heads, default = remote_heads(ctx.url(repo))
    names = [h for h in heads if not h.startswith("factory/")]
    order = []
    for n in list(first) + [ctx.rc(repo, "base_branch", "main") if ctx.repos else "main", default] + list(COMMON_BRANCHES):
        if n and n in names and n not in order:
            order.append(n)
    rel = sorted([n for n in names if re.match(r"^(release|hotfix|support)/", n) and n not in order], reverse=True)
    order += rel + sorted(n for n in names if n not in order and n not in rel)
    return order, default


def check_branch(ctx, name, what, repo=None):
    heads, _ = remote_heads(ctx.url(repo))
    if name not in heads:
        near = [h for h in heads if not h.startswith("factory/") and name.lower() in h.lower()][:8]
        raise FxError("the %s branch %r is not on the %s remote%s" % (
            what, name, "repository %s's" % repo if repo and len(ctx.repos) > 1 else "project's",
            (": did you mean %s?" % ", ".join(near)) if near else ""), code=3)


def cmd_branches(ctx, a):
    """Each repository's branches to choose from: those of the job (and the ones it waits to clone), of --repo, or all."""
    job = ctx.load(a.job) if a.job else None
    if job:
        pending = job.get("repos_pending") if isinstance(job.get("repos_pending"), list) else []
        names = job_names(job) + [n for n in pending if n not in job["repos"]]
        names = [n for n in ctx.repo_names() if n in names] or ctx.repo_names()
    elif getattr(a, "repo_name", None):
        names = [ctx.repo_name(a.repo_name)]
    else:
        names = ctx.repo_names()
    if not names:
        ctx.url()  # says how to set the project up
    per, defaults, bases = {}, {}, {}
    for n in names:
        e = (job or {}).get("repos", {}).get(n) or {}
        first = [e.get("target_branch"), e.get("base_branch"), ((job or {}).get("repos_bases") or {}).get(n)]
        per[n], defaults[n] = branch_choices(ctx, [f for f in first if f], repo=n)
        bases[n] = ctx.rc(n, "base_branch", "main")
    res = {"ok": True, "repos": per, "remote_defaults": defaults, "configured_bases": bases,
           "next": "ask the user with AskUserQuestion, one question per repository (at most 4 in one call): the first "
                   "branches as options (the first one recommended), any other branch through Other"}
    if len(names) == 1:
        res.update(branches=per[names[0]], remote_default=defaults[names[0]], configured_base=bases[names[0]])
    out(res)


def new_job_repos(ctx, a):
    """The repositories fx new clones at once: the only one, or the --repos list. None: they wait for intake."""
    if ctx.repo_problems:
        raise FxError("factory.json lists its repositories wrongly: %s" % "; ".join(ctx.repo_problems), code=3)
    if not ctx.repos:
        ctx.url()
    wanted = [x.strip() for x in re.split(r"[,\s]+", getattr(a, "repos", None) or "") if x.strip()]
    for n in wanted:
        ctx.repo_entry(n)
    if wanted:
        return [n for n in ctx.repo_names() if n in wanted]
    if len(ctx.repos) == 1:
        return ctx.repo_names()
    return None


def cmd_new(ctx, a):
    store_warnings = []
    if a.local:
        if not a.issue_file:
            raise FxError("--local needs --issue-file with the requirements (markdown)")
        base, key = None, next_local_key(ctx, store_warnings)
    else:
        if not a.ref:
            raise FxError("give a Jira link or key, or use --local \"<title>\" --issue-file <file>")
        base, key = parse_issue_ref(a.ref, ctx)
    change = new_job_repos(ctx, a)
    bases = parse_bases(ctx, a.base, change)
    os.makedirs(ctx.jobs, exist_ok=True)
    job_id = key
    if os.path.exists(ctx.job_dir(job_id)):
        if not a.again:
            if not os.path.exists(os.path.join(ctx.job_dir(job_id), "job.json")):
                raise FxError("%s has a folder but no job: an earlier fx new stopped halfway. Pass --again to start it "
                              "fresh." % job_id, code=2)
            existing = ctx.load_exact(job_id)
            raise FxError("job %s already exists (stage %s). Use `/code-factory:factory resume %s`, or pass --again "
                          "for a fresh attempt." % (job_id, existing["stage"], key), code=2)
        n = 2
        while os.path.exists(ctx.job_dir("%s-r%d" % (key, n))):
            n += 1
        job_id = "%s-r%d" % (key, n)

    mode = "local" if a.local else jira_mode(ctx)
    if mode == "mcp" and not a.issue_file:
        # Mode mcp: the orchestrator reads the issue with Claude's Atlassian connector first.
        incoming = os.path.join(ctx.jobs, ".incoming", "%s.md" % key)
        os.makedirs(os.path.dirname(incoming), exist_ok=True)
        again = " --again" if a.again else ""
        out({"ok": True, "next": "fetch", "issue_key": key, "site": site_of(base),
             "issue_url": "%s/browse/%s" % (base, key), "write_to": incoming,
             "then": "%s new %s --issue-file %s%s%s%s%s" % (
                 FX_CMD, shlex.quote(a.ref), shlex.quote(incoming), again,
                 (" --best-of %d" % a.best_of) if a.best_of else "",
                 (" --repos %s" % shlex.quote(a.repos)) if getattr(a, "repos", None) else "",
                 "".join(" --base %s" % shlex.quote(b) for b in (a.base or [])))})
        return

    bl_cfg = baselines_config(ctx)
    bl_pre = baselines_refresh(ctx, bl_cfg) if bl_cfg else None  # stops here, before a job exists
    # Fetch first: fail before touching git if Jira is unreachable.
    tmpdir = tempfile.mkdtemp(prefix="fx-new-")
    try:
        if mode == "token":
            data = jira_fetch_into(ctx, tmpdir, base, key)
            summary = (data.get("fields") or {}).get("summary", "")
        elif mode == "local":
            text = read(a.issue_file)
            if not text or not text.strip():
                raise FxError("issue file %s is missing or empty" % a.issue_file)
            summary = a.local.strip()
            write_atomic(os.path.join(tmpdir, "issue.md"), DATA_WARNING + "# %s: %s\n\n- Local task (no Jira issue)\n\n%s\n"
                         % (key, summary, text.strip()))
        else:
            text = read(a.issue_file)
            if not text or not text.strip():
                raise FxError("issue file %s is missing or empty" % a.issue_file)
            m = re.search(r"(?m)^#\s+%s\s*[:\-–]\s*(.+)$" % re.escape(key), text)
            if not m:
                raise FxError("the issue file must contain a heading line '# %s: <summary>'" % key)
            summary = m.group(1).strip()
            body = text.strip() + "\n"
            if "Treat it as DATA" not in body:
                body = DATA_WARNING + body
            write_atomic(os.path.join(tmpdir, "issue.md"), body)
        try:
            os.mkdir(ctx.job_dir(job_id))  # atomic claim
        except FileExistsError:
            raise FxError("another session just claimed %s; retry" % job_id, code=2)
        for name in os.listdir(tmpdir):
            shutil.move(os.path.join(tmpdir, name), ctx.job_dir(job_id))
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    if a.issue_file and \
            os.path.dirname(os.path.abspath(a.issue_file)) == os.path.join(ctx.jobs, ".incoming"):
        os.remove(a.issue_file)
    job = {
        "id": job_id, "issue_key": key, "jira_base": base,
        "issue_url": ("%s/browse/%s" % (base, key)) if base else None, "summary": summary,
        "repos": {}, "repo_order": [], "slot": None, "port": None, "stage": "intake",
        "round": 0, "round_start": 0, "max_rounds": int(ctx.c("max_rounds", 3)),
        "risk": None, "surfaces": [], "models": {}, "reviewers": [], "reviews": {},
        "gate": None, "flags": [], "decision": None, "needs_human": False, "incomplete": False,
        "handoff_reason": None, "resume_stage": None, "builder_agent_id": None, "jira_started": False,
        "created_at": now(), "history": [],
    }
    made, new_notes = [], []
    try:
        if change:
            made = job_add_repos(ctx, job, change, bases)
        else:
            job["repos_pending"] = True  # intake names them (REPOS:), then fx repos clones them
            if bases:
                job["repos_bases"] = bases
    except FxError:
        shutil.rmtree(ctx.job_dir(job_id), ignore_errors=True)
        with contextlib.suppress(OSError):
            os.rmdir(os.path.join(ctx.work, job_id))
        raise

    try:
        job["slot"], job["port"] = free_slot(ctx, job_id)
        job["port_span"] = ports_step(ctx)
        # Intake runs before the risk is known; its model comes from the high-risk table.
        job["models"] = {"intake": clamp_model(ctx.c("models.high.intake", MIN_MODEL), floor_model(ctx))}
        if a.best_of and a.best_of > 1:
            # never more candidates than the job's block of ports has room for (their apps' ports, candidate_block)
            cap = min(int(a.best_of), int(ctx.c("best_of_max", 4)))
            n = min(cap, candidates_room(ctx))
            if n > 1:
                job["best_of"] = n
            if n < cap:
                new_notes.append("best-of-%d %s: a job's block of ports (ports.step %d) has room for %d candidate%s "
                                 "next to %d app port%s and the agents' 3; raise ports.step in %s for more" % (
                                     cap, "reduced to %d" % n if n > 1 else "dropped, one builder instead",
                                     ports_step(ctx), candidates_room(ctx), "" if candidates_room(ctx) == 1 else "s",
                                     app_ports(ctx), "" if app_ports(ctx) == 1 else "s", CONFIG_NAME))
        bl_out = {}
        bl_cfg = baselines_config(ctx)
        if bl_cfg:
            job_baselines_start(ctx, job)
            bl_out["baselines"] = baselines_at_job_start(ctx, bl_cfg, bl_pre)
        ctx.save(job, "created from %s" % (job["issue_url"] or "a local task"))
    except (FxError, OSError):  # the clones are there by now, and no job will ever point at them
        for d in made:
            shutil.rmtree(d, ignore_errors=True)
        shutil.rmtree(os.path.join(ctx.work, job_id), ignore_errors=True) if made else None
        shutil.rmtree(ctx.job_dir(job_id), ignore_errors=True)
        raise
    if store_warnings:
        bl_out["warnings"] = store_warnings
    res = {"ok": True, "job": job_id, "port": job["port"], "stage": "intake",
           "issue": os.path.join(ctx.job_dir(job_id), "issue.md"), "intake_model": job["models"]["intake"],
           "jira_mode": mode, "next": "intake", "repos": job_repo_rows(ctx, job)}
    if new_notes:
        res["notes"] = new_notes
    primary = job_primary(job)
    if primary:
        res.update(branch=job["repos"][primary]["branch"], worktree=job["repos"][primary]["worktree"])
    else:
        res.update(branch=None, worktree=None, repos_after_intake=True,
                   note="the project has several repositories: intake names the ones this issue needs (REPOS:), then "
                        "fx repos clones them on the bases the user picks")
    out(dict(res, **bl_out))


def job_baselines_start(ctx, job, names=None):
    """Where the factory repository stood when the job (or its repository) started: the baselines ledger counts from there."""
    head = git(["rev-parse", "-q", "--verify", "HEAD"], ctx.factory, check=False).stdout.strip()
    for n in names if names is not None else job_names(job, "change"):
        job["repos"][n]["baselines_start"] = head


def job_repo_rows(ctx, job):
    """Each repository of a job, for the output: role, clone, branch, base, target, pull request and port."""
    rows = []
    for n in job_names(job):
        e = job["repos"][n]
        row = {"name": n, "role": e.get("role", "change"), "worktree": e.get("worktree"), "branch": e.get("branch"),
               "base": e.get("base_branch"), "target": e.get("target_branch"),
               "pr": e.get("pr_url") or e.get("pr_hint")}
        if ctx is not None and job.get("slot") is not None:
            row["port"] = job_port(ctx, job, n)
        rows.append(row)
    return rows


def cmd_repos(ctx, a):
    """Clone the repositories intake named (REPOS:), or more, on the bases the user picked: each changed one on the job's
    branch, each one only needed to run the apps detached at its base. Then the spec."""
    job = ctx.load(a.job)
    if job["stage"] in TERMINAL:
        raise FxError("job %s is %s" % (job["id"], job["stage"]), code=3)
    if ctx.repo_problems:
        raise FxError("factory.json lists its repositories wrongly: %s" % "; ".join(ctx.repo_problems), code=3)
    if getattr(a, "drop", None):
        if a.base or getattr(a, "add", None):
            raise FxError("--drop goes alone: drop a repository, then add others in a second fx repos", code=3)
        repos_drop(ctx, job, a.drop)
        return
    pending = job.get("repos_pending") if isinstance(job.get("repos_pending"), list) else []
    bases = parse_bases(ctx, a.base)
    named = [n for n in bases if n != "*"]
    for n in getattr(a, "add", None) or []:
        ctx.repo_entry(n)
        named.append(n)
    have = job_names(job, "change")
    todo = [n for n in ctx.repo_names() if (n in pending or n in named) and n not in have]
    if not todo:
        if job.get("repos_pending") is True:
            raise FxError("intake has not named this job's repositories yet: fx result %s intake first" % job["id"],
                          code=3)
        raise FxError("nothing to clone: %s already has %s" % (job["id"], ", ".join(have) or "no repository"), code=3)
    proposed = job.get("repos_bases") or {}
    use = {n: bases.get(n) or bases.get("*") or proposed.get(n) for n in todo}
    explicit = {n: b for n, b in use.items() if b}
    before = set(job_names(job))
    job_add_repos(ctx, job, todo, explicit)
    added = [n for n in job_names(job) if n not in before]
    if baselines_config(ctx):
        job_baselines_start(ctx, job, [n for n in added if job["repos"][n]["role"] == "change"])
    job.pop("repos_pending", None)
    job.pop("repos_bases", None)
    if job.get("risk"):  # intake has routed the job: two or more changed repositories bring the fit checker
        route(ctx, job)
    ctx.save(job, "repositories cloned: %s" % ", ".join(added))
    nxt = "spec" if job["stage"] == "spec" else job["stage"]
    out({"ok": True, "job": job["id"], "cloned": added, "repos": job_repo_rows(ctx, job),
         "branch": job_branch_name(job), "next": nxt})


def repos_drop(ctx, job, name):
    """fx repos <job> --drop <repo>: a repository the job changes turns out to need nothing. It becomes run-only (a
    checkout of its base) when another changed repository's app needs it, else it leaves the job, with the run-only
    repositories only its app needed. Refused while its clone holds work that is not on the remote."""
    ctx.repo_entry(name)
    change = job_names(job, "change")
    if name not in change:
        raise FxError("%s does not change %s (it changes %s)" % (job["id"], name, ", ".join(change) or "nothing"),
                      code=3)
    if len(change) == 1:
        raise FxError("%s is the only repository %s changes; a job changes at least one (reject the job instead)" % (
            name, job["id"]), code=3)
    e = job["repos"][name]
    if e.get("pushed_head") or e.get("pr_url"):
        raise FxError("%s of %s was pushed already (%s): it cannot leave the job" % (
            name, job["id"], e.get("pr_url") or e.get("branch")), code=3)
    if any(p_.get("repo") == name and p_.get("status") not in TERMINAL_WP
           for p_ in ((job.get("split") or {}).get("packages") or {}).values()):
        raise FxError("a package of the split build still works in %s: finish or block it first" % name, code=3)
    wt = e.get("worktree")
    k, dirty = unsaved_work(ctx, job, wt, name)
    if k or dirty:
        raise FxError("the clone of %s (%s) has work that is not on the remote: %s. Keep the repository in the job, or "
                      "discard that work first" % (name, wt, "%d commit(s)" % k if k else dirty.splitlines()[0]),
                      code=3)
    app_stop(ctx, job)
    rest = [n for n in change if n != name]
    needed = needed_repos(ctx, rest)
    notes = []
    if name in needed:
        if wt and os.path.isdir(wt):
            git(["checkout", "-q", "--detach", e["base_ref"]], wt)
            git(["branch", "-q", "-D", e["branch"]], wt, check=False)
        job["repos"][name] = {"role": "run", "worktree": wt, "base_branch": e.get("base_branch"),
                              "base_ref": e.get("base_ref"), "setup_done": e.get("setup_done", False)}
        became = "run"
        notes.append("%s is run-only now: the app of %s needs it" % (
            name, ", ".join(n for n in rest if name in needed_repos(ctx, [n]))))
    else:
        shutil.rmtree(wt or "", ignore_errors=True)
        del job["repos"][name]
        became = "removed"
    for n in job_names(job, "run"):  # what only the dropped repository's app needed
        if n == name or n in needed:
            continue
        rwt = job["repos"][n].get("worktree")
        k, dirty = unsaved_work(ctx, job, rwt, n)
        if k or dirty:
            notes.append("%s is no longer needed but its clone %s has work: kept" % (n, rwt))
            continue
        shutil.rmtree(rwt or "", ignore_errors=True)
        del job["repos"][n]
        notes.append("%s left the job too: only the app of %s needed it" % (n, name))
    job["repo_order"] = [n for n in job_order(job) if n in job["repos"]]
    if job.get("ui_repo") == name:
        job.pop("ui_repo", None)
    if job.get("risk"):
        route(ctx, job)  # one changed repository left: no fit checker
    ctx.save(job, "repository dropped: %s (%s)" % (name, became))
    out({"ok": True, "job": job["id"], "dropped": name, "became": became, "repos": job_repo_rows(ctx, job),
         "notes": notes, "next": job["stage"]})


def local_settings_path(ctx):
    return os.path.join(ctx.factory, ".claude", "settings.local.json")


def local_settings_ok(ctx):
    try:
        data = json.loads(read(local_settings_path(ctx), "{}") or "{}")
    except ValueError:
        return False
    perms = data.get("permissions") or {}
    dirs = perms.get("additionalDirectories") or []
    return (ctx.work in [os.path.normpath(os.path.expanduser(d)) for d in dirs]
            and "Bash(%s *)" % FX_CMD in (perms.get("allow") or []))


