# --------------------------------------------------------------------------
# storage: each project's factory has its own place on S3 (the `storage` block of factory.json, always asked of the
# user), with one folder per part of the factory, so a later part only adds a folder: <prefix>/<part>/…
#
# baselines, the first part: the UI's reference images are there by hash, and a list of hashes in git says which belong
# to a commit. There is no "latest" pointer: an old branch keeps its own images and a revert brings the old ones back.
# What is missing is never generated from the code under test: compared with itself it would always pass.

BASELINE_HASH_RE = re.compile(r"^[0-9a-f]{64}$")
BASELINE_JUNK = {".DS_Store", "Thumbs.db"}
BASELINE_TMP = ".fx-tmp-"
BASELINE_WORKERS = 8
BASELINE_LOCK_WAIT_SEC = 600
EMPTY_SHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
_BASELINE_GATE_LOCK = []  # the open lock file of this process: see baselines_refresh


class StoreError(Exception):
    """kind: credentials, denied, network, server, integrity. The message never holds a key."""
    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind


def baselines_safe_rel(path):
    """A path that stays inside the folder that holds it, whatever the folder is. Returns why not, or None."""
    if not isinstance(path, str) or not path:
        return "not a path"
    if re.search(r"[\x00-\x1f\\]", path):
        return "control characters or backslashes"
    if path.startswith(("/", "~")) or re.match(r"^[A-Za-z]:", path):
        return "absolute"
    parts = path.split("/")
    if any(p in ("", ".", "..", ".git") for p in parts):
        return "'..', '.', '.git' or an empty part"
    return None


def baselines_config(ctx):
    """The `baselines` and `storage` blocks of factory.json, checked; None when this factory keeps no baselines on S3."""
    b = ctx.c("baselines") if ctx and getattr(ctx, "cfg", None) else None
    if not b:
        return None
    if not isinstance(b, dict):
        raise FxError("baselines in factory.json must be an object", code=3)
    problems = []
    if "store" in b:
        problems.append("baselines.store is now the top-level storage block, shared by every part of the factory")
    folder = str(b.get("folder") or "baselines").strip("/")
    if baselines_safe_rel(folder):
        problems.append("baselines.folder: %r (%s)" % (folder, baselines_safe_rel(folder)))
    for key in ("dir", "manifest"):
        why = baselines_safe_rel(str(b.get(key) or "").rstrip("/"))
        if why:
            problems.append("baselines.%s: %r (%s)" % (key, b.get(key), why))
    d, m = str(b.get("dir") or "").rstrip("/"), str(b.get("manifest") or "")
    if d and (m == d or m.startswith(d + "/")):
        problems.append("baselines.manifest must not be inside baselines.dir: the folder is git-ignored, the list is not")
    repo, repo_name = b.get("repo") or "factory", None
    names = ctx.repo_names() if getattr(ctx, "repos", None) else []
    if repo == "project":
        if len(names) > 1:
            problems.append("baselines.repo is project, but this project has several repositories: name the one that "
                            "holds the list (%s)" % ", ".join(names))
        repo_name = names[0] if names else None
    elif repo in names:
        repo, repo_name = "project", repo
    elif repo != "factory":
        problems.append("baselines.repo must be factory, project%s, not %r" % (
            " or one of the repositories (%s)" % ", ".join(names) if names else "", repo))
    store = storage_config(ctx, problems)
    if problems:
        raise FxError("factory.json: " + "; ".join(problems), code=3)
    # repo: where the list is, factory or project; repo_name: which repository of the project holds it
    return {"dir": d, "manifest": m, "repo": repo, "repo_name": repo_name, "folder": folder, "store": store}


def baselines_job(ctx, cfg, job):
    """The job as the repository that holds the list sees it (repo_view): its first changed one when the list is in the
    factory repository. None when the job does not change that repository."""
    if job is None or not is_whole_job(job):
        return job
    name = cfg.get("repo_name") if cfg["repo"] == "project" else job_primary(job)
    if name not in job_names(job, "change") and len(ctx.repos) <= 1:
        name = job_primary(job)  # the only repository, whatever a job read without the factory's names calls it
    if not name or name not in job_names(job, "change"):
        return None
    return repo_view(ctx, job, name)


def storage_config(ctx, problems):
    """The `storage` block of factory.json, which every part of the factory shares; what is wrong goes in problems."""
    store = ctx.c("storage") or {}
    if not isinstance(store, dict):
        raise FxError("storage in factory.json must be an object", code=3)
    if (store.get("type") or "s3") != "s3":
        problems.append("storage.type must be s3, not %r" % store.get("type"))
    if not store.get("bucket"):
        problems.append("storage.bucket is empty: ask the user which S3 this project's factory uses (never guess one)")
    endpoint = (store.get("endpoint") or "").rstrip("/")
    if endpoint and not re.match(r"^https?://[^/\s]+(/\S*)?$", endpoint):
        problems.append("storage.endpoint must be an http(s) URL")
    if not endpoint and not store.get("region"):
        problems.append("storage.region is empty (needed unless endpoint is set)")
    prefix = (store.get("prefix") or "").strip("/")
    if prefix and baselines_safe_rel(prefix):
        problems.append("storage.prefix: %r (%s)" % (prefix, baselines_safe_rel(prefix)))
    return {"bucket": store.get("bucket"), "region": store.get("region") or "us-east-1", "endpoint": endpoint,
            "prefix": prefix, "read_profile": store.get("read_profile") or "",
            "write_profile": store.get("write_profile") or "", "jobs_write_profile": store.get("jobs_write_profile") or "",
            "timeout_sec": int(store.get("timeout_sec") or 30)}


def baselines_lost_list(ctx):
    """A list in fx's own format in the factory repository, while factory.json has no baselines block: only fx writes
    those, so the settings were there and have gone, say a script copied an old factory.json over the file. Returns its
    path, or None."""
    for dirpath, dirnames, names in os.walk(ctx.factory):
        dirnames[:] = [d for d in dirnames if d not in (".git", "jobs", "local", "node_modules", "knowledge", "logic", ".claude")]
        for n in names:
            path = os.path.join(dirpath, n)
            try:
                if not n.endswith(".json") or n == CONFIG_NAME or os.path.getsize(path) > 8 * 1024 * 1024:
                    continue
                if baselines_parse(read(path) or "", n):
                    return os.path.relpath(path, ctx.factory)
            except (FxError, OSError, UnicodeError):
                continue
    return None


