# Commands that are gone, and what took their place: they answer like an unknown command, with the way on.
REMOVED_COMMANDS = {
    "feature": "fx feature was removed: one job now covers every repository an issue needs. Start it with "
               "/code-factory:factory <KEY> (fx new <KEY>): intake names the repositories, each gets its own branch and "
               "pull request, and they link to each other. For a parent issue, each child is a job of its own (fx jira "
               "children <KEY> lists them).",
    "plan": "fx plan was removed: a project's repositories are all in its factory.json, and intake picks the ones an "
            "issue needs. For a parent issue, fx jira children <KEY> lists its children; each is a job of its own.",
    "workspace": "fx workspace was removed: a project's repositories are all listed in its factory.json (repos). Add "
                 "one with fx init --repo <name>=<git URL>.",
}


def removed_command(argv):
    """The error for a command that is gone (REMOVED_COMMANDS), or for the factory folder fx once took as --repo
    before the command; None for anything else."""
    if argv and argv[0] in ("--repo",) or argv and argv[0].startswith("--repo="):
        return "fx runs in the factory repository it works for: run it from there (the --repo <folder> before the " \
               "command was removed; a command's own --repo <name> names one of the project's repositories)"
    first = next((x for x in argv or [] if not x.startswith("-")), None)
    return REMOVED_COMMANDS.get(first)


def main(argv=None):
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _exit_on_signal)
    argv = list(sys.argv[1:] if argv is None else argv)
    gone = removed_command(argv)
    if gone:
        out({"ok": False, "error": gone, "exit_code": 3, "unknown_command": True})
        sys.exit(3)
    a = build_parser().parse_args(argv)
    os.environ.setdefault("SEMGREP_ENABLE_VERSION_CHECK", "0")  # its update check hangs behind proxies
    # git and the scanners read what the commits hold, whatever refs/replace or a grafts file says
    os.environ.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE=os.path.join(os.devnull, "none"))
    if tools_bin() not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = tools_bin() + os.pathsep + os.environ.get("PATH", "")  # tools fx installed itself
    if getattr(a, "summary_file", None):
        a.summary_file = os.path.abspath(os.path.expanduser(a.summary_file))  # from where fx was started
    try:
        if a.fn in (cmd_install, cmd_tools, cmd_board):
            try:
                ctx = Ctx(require_config=False)  # a factory repository is optional here
            except FxError:
                ctx = None
        else:
            ctx = Ctx(require_config=a.fn not in (cmd_init, cmd_doctor, cmd_reference,
                                                  cmd_tools))
        step = {cmd_setup: "setup", cmd_gate: "gate", cmd_pr: "push", cmd_candidates: "candidates"}.get(a.fn)
        ref = getattr(a, "job", None) if step and ctx and ctx.cfg else None
        if ref:
            mark_step(ctx, ref, step, True)
        try:
            a.fn(ctx, a)
        finally:
            baselines_release()
            if ref:
                mark_step(ctx, ref, step, False)
            if a.fn is not cmd_board:
                board_refresh(ctx)
    except FxError as e:
        res = {"ok": False, "error": str(e), "exit_code": e.code}
        res.update(e.extra)
        out(res)
        sys.exit(e.code)


if __name__ == "__main__":
    main()
