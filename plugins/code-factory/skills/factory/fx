def parse_intake_meta(text):
    risk, surfaces = None, []
    for line in (text or "").splitlines()[:15]:
        m = re.match(r"^RISK:\s*(low|high)\s*$", line.strip(), re.I)
        if m:
            risk = m.group(1).lower()
        m = re.match(r"^SURFACES:\s*(.*)$", line.strip(), re.I)
        if m:
            surfaces = [s.strip().lower() for s in re.split(r"[,\s]+", m.group(1)) if s.strip() and s.strip() != "-"]
    return risk, surfaces


def parse_intake_repos(text):
    """The names on intake.md's REPOS: line (among its first lines), or None when it has none."""
    for line in (text or "").splitlines()[:15]:
        m = re.match(r"^REPOS:\s*(.*)$", line.strip(), re.I)
        if m:
            return [x.strip().strip("`").lower() for x in re.split(r"[,\s]+", m.group(1))
                    if x.strip().strip("`") and x.strip() != "-"]
    return None


def intake_repos(ctx, job, text, verdict):
    """The repositories intake says the issue needs, checked against factory.json. A job whose repositories wait for
    intake cannot go on without them; one cloned at fx new may name more (they are cloned next)."""
    names = parse_intake_repos(text)
    known = ctx.repo_names()
    if names is None:
        if job.get("repos_pending") is True and verdict == "ACCEPT":
            raise FxError("intake.md has no REPOS: line, and this project has several repositories (%s): intake must "
                          "name the ones the issue needs" % ", ".join(known), code=6, extra={"retry_agent": "intake"})
        return []
    unknown = [n for n in names if n not in known]
    if unknown:
        raise FxError("intake.md names %s on its REPOS: line, which %s not one of this project's repositories (%s)" % (
            ", ".join(unknown), "is" if len(unknown) == 1 else "are", ", ".join(known)), code=6,
            extra={"retry_agent": "intake"})
    if not names and job.get("repos_pending") is True and verdict == "ACCEPT":
        raise FxError("intake.md's REPOS: line names no repository (%s)" % ", ".join(known), code=6,
                      extra={"retry_agent": "intake"})
    return [n for n in known if n in names]


