def sev_from_cvss(v):
    try:
        x = float(v)
    except (TypeError, ValueError):
        return None
    return "critical" if x >= 9 else "high" if x >= 7 else "medium" if x >= 4 else "low"


def sev_word(w):
    w = (w or "").lower()
    return {"error": "high", "warning": "medium", "warn": "medium", "moderate": "medium", "note": "low",
            "information": "info", "informational": "info", "inventory": "info", "experiment": "info"}.get(
        w, w if w in SEV_RANK else "medium")


def gitleaks_flags(ctx):
    """fx's own gitleaks rules: security.gitleaks_config from the factory repository, else gitleaks' built-in
    defaults; gitleaks:allow comments never count; its report never holds the secret itself. Returns (flags, error)."""
    flags = ["--ignore-gitleaks-allow", "--redact"]
    cfg = ctx.c("security.gitleaks_config")
    if cfg:
        path = os.path.join(ctx.factory, os.path.expanduser(cfg))
        if not os.path.isfile(path):
            return None, "security.gitleaks_config %s is not a file in the factory repository" % cfg
        flags += ["--config", path]
    return flags, None


def scan_gitleaks(ctx, job, mb, rdir):
    """Secrets in the commits that have not left this machine yet (pushed ones were scanned before their push);
    without mb, in the whole history."""
    rpt = os.path.join(rdir, "gitleaks.json")
    wt = job["worktree"]
    if os.path.exists(rpt):
        os.remove(rpt)
    opts = "%s..HEAD ^%s" % (unpushed_base(job) or mb, job["base_ref"]) if mb else "HEAD"
    flags, err = gitleaks_flags(ctx)
    if err:
        return None, err
    # The clone is the builder's: a .gitleaks.toml or .gitleaksignore there, or gitleaks:allow comments, must not
    # tune the scan. gitleaks reads both files from the folder it scans and always honours <source>/.gitleaksignore,
    # so it scans an empty folder of fx's own and reaches the clone's history through GIT_DIR.
    gitdir = git(["rev-parse", "--absolute-git-dir"], wt).stdout.strip()
    empty = tempfile.mkdtemp(prefix="fx-gitleaks-")
    env = project_env(ctx, GIT_DIR=gitdir)
    try:
        flags += ["--gitleaks-ignore-path", empty]
        r = run(["gitleaks", "git", "--log-opts", opts, "--report-format", "json", "--report-path", rpt,
                 "--no-banner", "--exit-code", "0"] + flags + [empty], cwd=empty, env=env, check=False,
                timeout=GITLEAKS_TIMEOUT_SEC)
        if r.returncode != 0 and "unknown command" in (r.stdout or "").lower():
            r = run(["gitleaks", "detect", "--source", empty, "--log-opts", opts, "--report-format", "json",
                     "--report-path", rpt, "--no-banner", "--exit-code", "0"] + flags, cwd=empty, env=env,
                    check=False, timeout=GITLEAKS_TIMEOUT_SEC)
    finally:
        shutil.rmtree(empty, ignore_errors=True)
    if r.returncode != 0 or not os.path.exists(rpt):
        return None, "gitleaks failed (exit %s): %s" % (r.returncode, (r.stdout or "")[-200:].strip())
    try:
        data = json.loads(read(rpt, "[]") or "[]")
    except ValueError:
        return None, "gitleaks output unreadable: %s" % (r.stdout or "")[-200:]
    found = []
    for f in data or []:
        found.append({"tool": "gitleaks", "severity": "critical", "new": True, "secret": True,
                      "rule": f.get("RuleID"), "location": "%s:%s" % (f.get("File"), f.get("StartLine")),
                      "message": "possible secret (%s) in commit %s" % (f.get("Description") or f.get("RuleID"),
                                                                       (f.get("Commit") or "")[:10]),
                      "cwe": "CWE-798", "owasp": "A04:2025 Cryptographic Failures"})
    return found, None


