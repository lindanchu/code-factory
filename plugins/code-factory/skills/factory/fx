def tools_bin():
    return os.path.join(tools_dir(), "bin")


def docker_running():
    try:
        return run(["docker", "info"], check=False, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def platform_id():
    osn = "macos" if sys.platform == "darwin" else "linux" if sys.platform.startswith("linux") else "windows"
    arch = "arm64" if platform.machine().lower() in ("arm64", "aarch64") else "amd64"
    return osn, arch


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or "")[:3])


def tool_version(name):
    if name == "python3":
        return "%d.%d.%d" % sys.version_info[:3]
    cmd = INSTALL_VERSION_CMD.get(name)
    if not cmd or not shutil.which(cmd[0]):
        return None
    try:
        r = run(cmd, check=False, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"(\d+\.\d+(?:\.\d+)?)", r.stdout or "")
    return m.group(1) if r.returncode == 0 and m else ("unknown" if r.returncode == 0 else None)


def admin_commands(name):
    """What the user runs themselves when installing needs an administrator (fx never types a password)."""
    osn, _ = platform_id()
    if name == "docker":
        if osn == "macos":
            return ["Install Docker Desktop from https://www.docker.com/products/docker-desktop/ and start it once"]
        return ["sudo apt-get install -y docker.io && sudo usermod -aG docker $USER  (log out and in afterwards)"]
    if osn == "macos" and name in INSTALL_BREW:
        if shutil.which("brew"):
            return ["brew install %s" % INSTALL_BREW[name]]
        return [HOMEBREW_INSTALL, "brew install %s" % INSTALL_BREW[name]]
    if osn == "windows":
        return ["Run Claude Code inside WSL (Ubuntu) and install %s there" % name]
    if name in INSTALL_RELEASES:
        host, repo = INSTALL_RELEASES[name]
        page = ("https://github.com/%s/releases/latest" % repo if host == "github" else
                "https://gitlab.com/%s/-/releases" % repo)
        return ["download the %s %s build from %s, unpack it and put the `%s` binary into %s" % (
            osn, platform_id()[1], page, name, tools_bin())]
    if name == "semgrep":
        return ["pipx install semgrep   (or: python3 -m pip install --user semgrep)"]
    if name == "playwright":
        return ["install Node.js first (see node), then run /code-factory:factory install again"]
    if name == "node":
        return ["curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash",
                "nvm install --lts   (in a new terminal; no administrator rights needed)"]
    pkg = INSTALL_LINUX_PKG.get(name)
    if not pkg:
        return []
    for pm, cmd in (("apt-get", "sudo apt-get install -y %s"), ("dnf", "sudo dnf install -y %s"),
                    ("yum", "sudo yum install -y %s"), ("pacman", "sudo pacman -S --noconfirm %s"),
                    ("zypper", "sudo zypper install -y %s"), ("apk", "sudo apk add %s")):
        if shutil.which(pm):
            return [cmd % pkg]
    return ["install %s with your system's package manager" % pkg]


def install_method(name):
    """How fx itself can install the tool on this machine without administrator rights, or None."""
    osn, _ = platform_id()
    if osn == "windows":
        return None
    if name == "playwright":
        return "npm" if shutil.which("npm") else None
    if osn == "macos" and shutil.which("brew") and name in INSTALL_BREW:
        return "brew"
    if name in INSTALL_RELEASES:
        return "download"
    if name == "semgrep":
        return "pipx" if shutil.which("pipx") else "pip"
    return None


def project_host(ctx):
    """Every repository's (provider, host): github / gitlab / None and the host of its URL, from the factory repository
    this runs in (when there is one), in repository order, each pair once."""
    if not ctx or not ctx.cfg:
        return []
    pairs = []
    for n in ctx.repo_names():
        url = ctx.rc(n, "url") or ""
        prov = ctx.rc(n, "pr.provider") or ("github" if "github.com" in url else "gitlab" if "gitlab" in url else None)
        m = re.match(r"^(?:https?://|ssh://)?(?:[^@/]+@)?([^/:]+)", url)
        pair = (prov, m.group(1) if m and not os.path.isdir(os.path.expanduser(url)) else None)
        if pair not in pairs:
            pairs.append(pair)
    return pairs


def login_status(name, host=None):
    """gh or glab logged in to a host (glab: any host it was given; gh: one other than github.com, an Enterprise
    server)."""
    if not shutil.which(name):
        return None
    flag = ["--hostname", host] if host and (name == "glab" or host != "github.com") else []
    try:
        ok = run([name, "auth", "status"] + flag, check=False, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        ok = False
    login = [shutil.which(name), "auth", "login"] + flag
    return {"ok": ok, "command": None if ok else " ".join(login)}


def jira_machine_status(ctx):
    """For fx install: the Jira mode, and whether jira.env holds both values. Mode mcp never opens the file, so it says
    nothing of it (null), and without a factory repository there is neither."""
    if not ctx or not ctx.cfg:
        return {"mode": None, "jira_env": None}
    chosen = JIRA_MODES.get(jira_mode_setting(ctx))
    if chosen == "mcp":
        return {"mode": "mcp", "jira_env": None}
    complete = jira_keys_complete(ctx)
    return {"mode": chosen or ("token" if complete else "mcp"), "jira_env": complete}


def machine_status(ctx):
    osn, arch = platform_id()
    hosts = project_host(ctx)
    provs = [p_ for p_, _ in hosts]
    prov = next((p_ for p_ in provs if p_), None)
    ui = bool(ctx and ctx.cfg and ctx.c("ui_checks.enabled", True))
    # Before a factory repository exists, the template's default applies: gitleaks must run in every gate.
    required_tools = {SCANNER_TOOLS.get(n) for n in (required_scanners(ctx) if ctx and ctx.cfg else REQUIRED_SCANNERS)}
    tools = []
    try:
        bl_cfg = baselines_config(ctx) or jobs_store_config(ctx)
    except FxError:
        bl_cfg = None  # fx doctor reports bad settings; this check of the machine still works
    for name, need, purpose in INSTALL_TOOLS:
        if need == "baselines":
            if not bl_cfg:
                continue
            need = "required" if baselines_needs_aws_cli(ctx, bl_cfg) else "optional"
        if name == "playwright":
            ok, detail = playwright_ok()
            version, path = (None, os.path.join(tools_dir(), "node_modules")) if ok else (None, None)
        else:
            version = tool_version(name)
            path = sys.executable if name == "python3" else shutil.which(INSTALL_VERSION_CMD.get(name, [name])[0])
            ok = bool(version)
            detail = "" if ok else "not found"
            low = INSTALL_MIN.get(name)
            if ok and low and version != "unknown" and vtuple(version) < low:
                ok, detail = False, "version %s is too old (needs %s+)" % (version, ".".join(map(str, low)))
            if name == "docker" and ok:
                if not docker_running():
                    ok, detail = False, "installed but not running: start Docker"
        if name in required_tools:
            need = "required"
        elif need == "github":
            need = "recommended" if "github" in provs else "optional" if prov else "if your projects are on GitHub"
        elif need == "gitlab":
            need = "recommended" if "gitlab" in provs else "optional" if prov else "if your projects are on GitLab"
        elif need == "ui":
            need = "recommended" if ui or not (ctx and ctx.cfg) else "optional"
        method = None if ok else install_method(name)
        if name == "playwright" and not ok and not shutil.which("npm"):
            method = None
        manual = [] if ok or method else admin_commands(name)
        if name == "playwright" and not ok and not method:
            manual = ["install Node.js first (see node), then run /code-factory:factory install again"]
        if name == "docker" and not ok:
            method, manual = None, admin_commands(name) if detail == "not found" else ["start Docker"]
        t = {"name": name, "need": need, "purpose": purpose, "ok": ok, "version": version, "path": path,
             "detail": detail, "auto": method, "manual": manual}
        if name in ("gh", "glab") and ok:
            mine = [h for p_, h in hosts if p_ == {"gh": "github", "glab": "gitlab"}[name]] or [None]
            logins = {h: login_status(name, h) for h in dict.fromkeys(mine)}
            # One row per tool: logged in to every host of the project's repositories on that provider.
            t["login"] = next((st for st in logins.values() if st and not st["ok"]), None) or logins[mine[0]]
            if len(logins) > 1 or mine != [None]:
                t["logins"] = {(h or "default"): st for h, st in logins.items()}
        tools.append(t)
    required_ok = all(t["ok"] for t in tools if t["need"] == "required")
    res = {"ok": required_ok, "platform": "%s %s" % (osn, arch), "tools_bin": tools_bin(), "tools": tools,
           "factory": ctx.factory if ctx and ctx.cfg else None, "project_host": prov,
           "project_hosts": [{"provider": p_, "host": h} for p_, h in hosts],
           "jira": jira_machine_status(ctx)}
    if os.path.isdir(tools_bin()) and os.listdir(tools_bin()):
        res["path_hint"] = ("fx finds the tools in %s by itself; to use them in your own terminal too, add "
                            "`export PATH=\"%s:$PATH\"` to your shell profile" % (tools_bin(), tools_bin()))
    if osn == "windows":
        res["ok"] = False
        res["windows"] = "fx and checks.sh need bash: run Claude Code inside WSL (Ubuntu) and install there"
    return res


def release_assets(host, repo):
    """(name, url) of the latest release's files; FX_RELEASES_OVERRIDE (a folder of <owner>_<repo>.json) for tests."""
    override = os.environ.get("FX_RELEASES_OVERRIDE")
    if override:
        data = json.loads(read(os.path.join(override, repo.replace("/", "_") + ".json"), "{}") or "{}")
    else:
        url = ("https://api.github.com/repos/%s/releases/latest" % repo if host == "github" else
               "https://gitlab.com/api/v4/projects/%s/releases/permalink/latest" % urllib.parse.quote(repo, safe=""))
        req = urllib.request.Request(url, headers={"User-Agent": "code-factory", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=60) as r:
            data = json.loads(r.read().decode("utf-8"))
    if "assets" in data and isinstance(data["assets"], list):
        return [(x.get("name", ""), x.get("browser_download_url") or x.get("url") or "") for x in data["assets"]]
    links = ((data.get("assets") or {}).get("links") or []) if isinstance(data.get("assets"), dict) else []
    return [(x.get("name", ""), x.get("direct_asset_url") or x.get("url") or "") for x in links]


def pick_asset(assets, osn, arch):
    os_words = {"macos": ("darwin", "macos", "mac", "osx"), "linux": ("linux",)}.get(osn, ())
    arch_words = {"arm64": ("arm64", "aarch64"), "amd64": ("amd64", "x86_64", "x64")}[arch]
    skip = re.compile(r"(\.(sig|sbom|pem|sha256|sha512|txt|json|deb|rpm|apk|msi|pkg|asc|intoto\.jsonl|sigstore)$|"
                      r"checksums|sbom|\.sigstore)", re.I)
    word = lambda w, n: re.search(r"(^|[_\-.])%s([_\-.]|$)" % re.escape(w), n)
    best = []
    for name, url in assets:
        n = name.lower()
        if not url or skip.search(n) or not any(word(w, n) for w in os_words):
            continue
        rank = 0 if any(word(w, n) for w in arch_words) else 10 if word("universal", n) or word("all", n) else None
        if rank is None:
            continue
        rank += 0 if n.endswith((".tar.gz", ".tgz")) else 1 if n.endswith(".zip") else 2
        best.append((rank, name, url))
    return sorted(best)[0][1:] if best else None


def fetch_to(url, dst):
    if os.path.exists(url):
        shutil.copy2(url, dst)
        return
    req = urllib.request.Request(url, headers={"User-Agent": "code-factory"})
    with urllib.request.urlopen(req, timeout=300) as r, open(dst, "wb") as f:
        shutil.copyfileobj(r, f)


def install_release(name):
    host, repo = INSTALL_RELEASES[name]
    osn, arch = platform_id()
    try:
        assets = release_assets(host, repo)
    except (urllib.error.URLError, OSError, ValueError) as e:
        return False, "could not read the latest release of %s (%s)" % (repo, e)
    pick = pick_asset(assets, osn, arch)
    if not pick:
        return False, "no %s %s build in the latest release of %s" % (osn, arch, repo)
    fname, url = pick
    tmp = tempfile.mkdtemp(prefix="fx-dl-")
    TEMP_DIRS.append(tmp)
    src = os.path.join(tmp, os.path.basename(fname))
    try:
        fetch_to(url, src)
    except (urllib.error.URLError, OSError) as e:
        return False, "download of %s failed (%s)" % (fname, e)
    data = None
    low = fname.lower()
    try:
        if low.endswith((".tar.gz", ".tgz")):
            with tarfile.open(src, "r:gz") as tf:
                for m in tf.getmembers():
                    if m.isfile() and os.path.basename(m.name) == name:
                        data = tf.extractfile(m).read()
                        break
        elif low.endswith(".zip"):
            with zipfile.ZipFile(src) as zf:
                for m in zf.namelist():
                    if os.path.basename(m) == name and not m.endswith("/"):
                        data = zf.read(m)
                        break
        else:
            data = open(src, "rb").read()
    except (tarfile.TarError, zipfile.BadZipFile, OSError) as e:
        return False, "could not unpack %s (%s)" % (fname, e)
    if not data:
        return False, "%s has no %s binary inside" % (fname, name)
    os.makedirs(tools_bin(), exist_ok=True)
    dst = os.path.join(tools_bin(), name)
    with open(dst + ".tmp", "wb") as f:
        f.write(data)
    os.chmod(dst + ".tmp", 0o755)
    os.replace(dst + ".tmp", dst)
    v = tool_version(name)
    if not v:
        return False, "downloaded %s but it does not run on this machine" % fname
    return True, "downloaded %s into %s" % (fname, tools_bin())


def install_one(name):
    """Install one tool without administrator rights. Returns (installed?, what happened)."""
    method = install_method(name)
    if name == "playwright":
        if not method:
            return False, "needs Node.js and npm first"
        os.makedirs(tools_dir(), exist_ok=True)
        if not os.path.exists(os.path.join(tools_dir(), "package.json")):
            write_atomic(os.path.join(tools_dir(), "package.json"), '{"name": "factory-tools", "private": true}\n')
        pin = global_playwright_version()  # match the browsers this machine already has
        r = run(["npm", "install", "--no-audit", "--no-fund", "--prefix", tools_dir(),
                 "playwright@" + (pin or PLAYWRIGHT_VERSION), "axe-core@" + AXE_CORE_VERSION], check=False,
                timeout=900)
        if r.returncode != 0:
            return False, "npm install failed: " + (r.stdout or "")[-400:]
        r = run([os.path.join(tools_dir(), "node_modules", ".bin", "playwright"), "install", "chromium"],
                check=False, timeout=1200)
        ok_, why_ = playwright_ok()
        return (ok_, ("installed" + (" (version %s, like the machine's global Playwright)" % pin if pin else
                                     " (version %s)" % PLAYWRIGHT_VERSION))
                if ok_ else "browsers: " + why_ + " " + (r.stdout or "")[-300:])
    if method == "brew":
        r = run(["brew", "install", INSTALL_BREW[name]], check=False, timeout=1800)
        return (r.returncode == 0, "installed with brew" if r.returncode == 0 else
                "brew failed: " + (r.stdout or "")[-300:])
    if method == "download":
        return install_release(name)
    if method in ("pipx", "pip"):
        pkg = "%s==%s" % (name, SEMGREP_VERSION)  # only semgrep installs this way
        cmd = ["pipx", "install", pkg] if method == "pipx" else [sys.executable, "-m", "pip", "install", "--user", pkg]
        r = run(cmd, check=False, timeout=1200)
        if r.returncode != 0:
            return False, "%s failed: %s" % (method, (r.stdout or "")[-300:])
        if not shutil.which(name):
            base = run([sys.executable, "-m", "site", "--user-base"], check=False).stdout.strip()
            found = os.path.join(base, "bin", name) if base else ""
            if os.path.isfile(found):
                os.makedirs(tools_bin(), exist_ok=True)
                link = os.path.join(tools_bin(), name)
                if os.path.lexists(link):
                    os.remove(link)
                os.symlink(found, link)
        return bool(shutil.which(name)), "installed with %s (version %s)" % (method, SEMGREP_VERSION)
    return False, "needs administrator rights: run the commands shown"


def cmd_install(ctx, a):
    if a.action == "run":
        names = [n for n in (a.names or "").replace(",", " ").split() if n]
        known = {t[0] for t in INSTALL_TOOLS}
        bad = [n for n in names if n not in known]
        if bad:
            raise FxError("unknown tool(s): %s (known: %s)" % (", ".join(bad), ", ".join(sorted(known))))
        results = []
        for n in names:
            try:
                ok, what = install_one(n)
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, what = False, "failed: %s" % e
            results.append({"name": n, "installed": ok, "result": what,
                            "manual": [] if ok else admin_commands(n)})
        st = machine_status(ctx)
        st["results"] = results
        st["next"] = ("show the results and the final table; give the user the manual commands and logins that are "
                      "left, and offer to check again when they are done")
        out(st)
        return
    st = machine_status(ctx)
    missing = [t["name"] for t in st["tools"] if not t["ok"]]
    st["next"] = ("show the table; ask which missing tools to install (only those with `auto`), then fx install run "
                  "--names <them>; give the manual commands for the rest" if missing else
                  "everything is installed" + ("; check the logins" if any(
                      t.get("login") and not t["login"]["ok"] for t in st["tools"]) else ""))
    out(st)


# --------------------------------------------------------------------------
# board: what the agents are doing, for how long, and when each job should be done

RUN_DEFAULT_SEC = {"intake": 40, "spec": 240, "planner": 60, "builder": 900, "integrator": 320, "security": 300,
                   "code": 60, "ux": 60, "ui": 60, "verifier": 180, "approver": 60, "judge": 120,
                   "setup": 90, "gate": 120, "push": 60, "candidates": 180, "fit-checker": 300}
PHASES = ["intake", "spec", "planner", "build", "gate", "review", "approver", "push"]


def state_dir():
    return os.path.expanduser(os.environ.get("FACTORY_STATE_DIR") or "~/.cache/code-factory")


def board_file():
    return os.path.join(state_dir(), "board.html")


def iso_ts(s):
    try:
        return _dt.datetime.fromisoformat(s).timestamp() if s else None
    except (TypeError, ValueError):
        return None


def iso_of(ts):
    return _dt.datetime.fromtimestamp(ts, _dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def register_factory(path):
    reg = os.path.join(state_dir(), "factories.json")
    try:
        known = json.loads(read(reg, "[]") or "[]")
    except ValueError:
        known = []
    known = [k for k in known if os.path.isfile(os.path.join(k, CONFIG_NAME))]
    if path not in known:
        known.append(path)
    os.makedirs(state_dir(), exist_ok=True)
    write_atomic(reg, json.dumps(known, indent=1) + "\n")
    return known


def run_result_files(ctx, job, agent, wp=None, cand=None):
    """The file an agent writes when it is done (its mtime ends the run on the board)."""
    jd = ctx.job_dir(job["id"])
    rd = os.path.join(jd, "round-%d" % job["round"])
    if agent == "builder":
        name = ("build-%s.md" % wp) if wp else ("build-c%d.md" % cand) if cand else "build.md"
        return [os.path.join(jd, name)]
    files = {"intake": ["intake.md", "questions.md"], "spec": ["spec.md", "questions.md"], "planner": ["plan.md"],
             "approver": ["decision.md"], "judge": ["pick.md"]}
    if agent in files:
        return [os.path.join(jd, f) for f in files[agent]]
    if agent == "verifier":
        return [os.path.join(rd, "verify-security.md")]
    if agent in REVIEW_ROLES:
        return [os.path.join(rd, "review-%s.md" % agent)]
    return []


def record_run(ctx, job, agent, model, wp=None, cand=None, name=None):
    """fx ctx is called right before an agent is spawned: that is when its run starts."""
    runs = job.setdefault("runs", [])
    key = [agent, wp, cand, job["round"]]
    t = time.time()
    for r in runs:
        if r.get("ended") or [r.get("agent"), r.get("wp"), r.get("cand"), r.get("round")] != key:
            continue
        if t - (iso_ts(r.get("started")) or t) < 600:
            r.update(started=now(), model=model)  # the same spawn, prepared again
            ctx.save(job)
            return
        r.update(ended=now(), status="no result")  # an earlier try that wrote nothing
    runs.append({"agent": agent, "name": name or agent, "wp": wp, "cand": cand, "round": job["round"],
                 "model": model, "started": now(), "ended": None, "status": "running",
                 "result": run_result_files(ctx, job, agent, wp, cand)})
    del runs[:-300]
    ctx.save(job)


def close_runs(job):
    """A run ends when its result file is written after it started."""
    for r in job.get("runs") or []:
        if r.get("ended"):
            continue
        st = iso_ts(r.get("started")) or 0
        done = [os.path.getmtime(f) for f in r.get("result") or [] if os.path.exists(f)
                and os.path.getmtime(f) >= st - 1]
        if done:
            r.update(ended=iso_of(max(done)), status="done")


def mark_step(ctx, ref, name, start):
    """fx's own long steps (setup, gate, push) on the board."""
    try:
        job = ctx.load(ref)
    except (FxError, ValueError, OSError):
        return
    steps = job.setdefault("steps", [])
    if start:
        steps.append({"step": name, "round": job.get("round"), "started": now(), "ended": None})
        del steps[:-150]
    else:
        open_ = [s for s in steps if s.get("step") == name and not s.get("ended")]
        if not open_:
            return
        open_[-1]["ended"] = now()
        if name == "gate":
            open_[-1]["result"] = job.get("gate")
    ctx.save(job)


def cmd_usage(ctx, a):
    job = ctx.load(a.job)
    runs = [r for r in job.get("runs") or [] if r.get("agent") == a.agent and r.get("wp") == a.wp
            and r.get("cand") == a.candidate]
    if not runs:
        raise FxError("no %s run recorded for %s (fx ctx records it)" % (a.agent, job["id"]))
    r = runs[-1]
    r["tokens"] = a.tokens
    if a.ms is not None:
        r["ms"] = a.ms
    if not r.get("ended"):
        r.update(ended=now(), status="done")
    ctx.save(job)
    out({"ok": True, "job": job["id"], "agent": a.agent, "tokens": a.tokens})


def median(xs):
    xs = sorted(xs)
    return xs[len(xs) // 2] if xs else None


def typical_durations(jobs):
    acc = {}
    for j in jobs:
        for r in j.get("runs") or []:
            a, b = iso_ts(r.get("started")), iso_ts(r.get("ended"))
            if a and b and r.get("status") == "done" and b >= a:
                acc.setdefault(r.get("name") or r.get("agent"), []).append(b - a)
        for s in j.get("steps") or []:
            a, b = iso_ts(s.get("started")), iso_ts(s.get("ended"))
            if a and b and b >= a:
                acc.setdefault(s.get("step"), []).append(b - a)
    return {k: median(v) for k, v in acc.items()}


def job_phase(job, running):
    names = {r["name"] for r in running}
    st = job.get("stage")
    if "push" in names or st == "pr":
        return "push"
    if "gate" in names:
        return "gate"
    if st == "intake":
        return "intake"
    if st == "needs-info":
        return "intake" if job.get("resume_stage") == "intake" else "spec" if job.get("resume_stage") == "spec" \
            else "build"
    if st == "spec":
        return "spec"
    if st == "build":
        return "planner" if "planner" in names else "build"
    return {"review": "review", "approve": "approver"}.get(st, "done")


def job_remaining(job, phase, running, typ):
    """Seconds left, from the typical time of each step still to come (no more rounds assumed)."""
    reviewers = job.get("reviewers") or ["security", "code"]
    split = (job.get("split") or {}).get("mode") == "split"
    planned = not job.get("split") and not job.get("best_of") and phase in ("intake", "spec", "planner")
    cost = {"intake": typ("intake"), "spec": typ("spec"), "planner": typ("planner") if planned else 0,
            "build": typ("builder") + (typ("integrator") if split else 0), "gate": typ("gate"),
            "review": max(typ(r) for r in reviewers), "approver": typ("approver"), "push": typ("push")}
    if phase not in PHASES:
        return 0
    i = PHASES.index(phase)
    now_ = time.time()
    here = [max(0.0, typ(r["name"]) - (now_ - r["t0"])) for r in running]
    current = max(here) if here else cost[phase]
    return current + sum(cost[p] for p in PHASES[i + 1:])


def board_running(runs, steps, typ):
    running = []
    for r in runs:
        if not r.get("ended") and iso_ts(r.get("started")):
            running.append({"kind": "agent", "name": r.get("name") or r["agent"], "agent": r["agent"],
                            "wp": r.get("wp"), "cand": r.get("cand"), "model": r.get("model"),
                            "start": r["started"], "t0": iso_ts(r["started"]), "typical": typ(r.get("name") or r["agent"])})
    for s in steps:
        if not s.get("ended") and iso_ts(s.get("started")):
            running.append({"kind": "step", "name": s["step"], "start": s["started"], "t0": iso_ts(s["started"]),
                            "typical": typ(s["step"])})
    return running


def board_segments(runs, steps):
    segs = []
    for r in runs:
        if iso_ts(r.get("started")):
            segs.append({"kind": "agent", "label": "%s%s" % (r.get("name") or r["agent"],
                                                             " " + r["wp"] if r.get("wp") else ""),
                         "model": r.get("model"), "start": r["started"], "end": r.get("ended"),
                         "status": r.get("status"), "tokens": r.get("tokens")})
    for s in steps:
        if iso_ts(s.get("started")):
            segs.append({"kind": "step", "label": s["step"], "start": s["started"], "end": s.get("ended"),
                         "status": s.get("result") or ("running" if not s.get("ended") else "done")})
    return segs


def board_cost(runs, rates):
    tokens = sum(r.get("tokens") or 0 for r in runs)
    cost = None
    if tokens and rates:
        priced = [(r.get("tokens") or 0, rates.get(r.get("model"))) for r in runs if r.get("tokens")]
        if all(rate is not None for _, rate in priced):
            cost = round(sum(t * float(rate) / 1e6 for t, rate in priced), 2)
    return tokens, cost


def job_view(factory, project, job, med, rates):
    jd = os.path.join(factory, "jobs", job["id"])
    typ = lambda n: med.get(n) or RUN_DEFAULT_SEC.get(n, 120)
    st = job.get("stage")
    active = st not in ("handed-off", "rejected")
    runs, steps = job.get("runs") or [], job.get("steps") or []
    running = board_running(runs, steps, typ)
    waiting = "questions" if st == "needs-info" else "target" if st == "pr" and not running else None
    phase = job_phase(job, running) if active else "done"
    eta = None
    if active and not waiting:
        eta = iso_of(time.time() + job_remaining(job, phase, running, typ))
    segs = board_segments(runs, steps)
    hist, wait_start = job.get("history") or [], None
    for h in hist:
        if h.get("stage") == "needs-info" and wait_start is None:
            wait_start = h.get("at")
        elif h.get("stage") != "needs-info" and wait_start:
            segs.append({"kind": "wait", "label": "questions", "start": wait_start, "end": h.get("at")})
            wait_start = None
    if wait_start:
        segs.append({"kind": "wait", "label": "questions", "start": wait_start, "end": None})
    tokens, cost = board_cost(runs, rates)
    files = []
    rounds = sorted(int(m.group(1)) for m in (re.match(r"^round-(\d+)$", n) for n in
                                                (os.listdir(jd) if os.path.isdir(jd) else [])) if m)
    last = os.path.join(jd, "round-%d" % rounds[-1]) if rounds else None
    for label, path in [("issue", os.path.join(jd, "issue.md")), ("spec", os.path.join(jd, "spec.md")),
                        ("plan", os.path.join(jd, "plan.md")), ("questions", os.path.join(jd, "qa-log.md"))] + \
            ([("checks", os.path.join(last, "checks.md")), ("ui", os.path.join(last, "ui.md")),
              ("security", os.path.join(last, "security.md"))] +
             [("review " + f[7:-3], os.path.join(last, f)) for f in sorted(os.listdir(last))
              if f.startswith("review-") and f.endswith(".md")] if last else []) + \
            [("decision", os.path.join(jd, "decision.md")), ("pr-body", os.path.join(jd, "pr-body.md")),
             ("screenshots", os.path.join(jd, "ui"))]:
        if path and os.path.exists(path):
            files.append({"label": label, "path": path})
    return {"factory": factory, "project": project, "id": job["id"], "key": job.get("issue_key"),
            "summary": job.get("summary"), "url": job.get("issue_url"), "stage": st, "phase": phase,
            "active": active, "waiting": waiting, "round": job.get("round", 0) - job.get("round_start", 0),
            "max_rounds": job.get("max_rounds"), "base": job.get("base_branch"),
            "target": job.get("target_branch"), "branch": job.get("branch"),
            "created": job.get("created_at"), "updated": job.get("updated_at"), "running": running, "eta": eta,
            "segments": segs, "tokens": tokens, "cost": cost, "files": files,
            "decision": job.get("decision"), "needs_human": job.get("needs_human"),
            "reason": job.get("handoff_reason"), "pr": job.get("pr_url") or job.get("pr_hint"),
            "split": len(((job.get("split") or {}).get("packages") or {})) or None,
            "packages": board_packages(job), "best_of": job.get("best_of") if not job.get("best_of_done") else None,
            "repos": [{k: r[k] for k in ("name", "role", "branch", "base", "target", "pr")}
                      for r in job_repo_rows(None, job)] if isinstance(job.get("repos"), dict) else []}


def board_packages(job):
    """The packages of a split build, in plan order, for the board: what each builds, its status, what it waits for."""
    sp = job.get("split") or {}
    pkgs = sp.get("packages") or {}
    if sp.get("mode") != "split" or not pkgs:
        return None
    return [{"id": k, "title": pkgs[k].get("title") or k, "status": pkgs[k].get("status"), "after": pkgs[k].get("after") or []}
            for k in (sp.get("order") or list(pkgs)) if k in pkgs]


def board_data(factories):
    data = {"generated": now(), "factories": [], "active": [], "done": [], "lang": "en"}
    for f in factories:
        try:
            cfg = json.loads(read(os.path.join(f, CONFIG_NAME), "{}") or "{}")
        except ValueError:
            continue
        proj = cfg.get("project") or {}
        name = proj.get("name") or re.sub(r"\.git$", "", os.path.basename(str(proj.get("url") or f).rstrip("/"))) \
            or os.path.basename(f)
        if speaks_vietnamese(cfg.get("language")):
            data["lang"] = "vi"
        jobs = []
        jdir = os.path.join(f, "jobs")
        for jid in sorted(os.listdir(jdir)) if os.path.isdir(jdir) else []:
            p = os.path.join(jdir, jid, "job.json")
            if jid.startswith((".", "_")) or not os.path.isfile(p):
                continue
            try:
                raw = json.loads(read(p, "{}") or "{}")
            except ValueError:
                continue
            if isinstance(raw, dict):
                own = config_repos(cfg)[0]
                jobs.append(job_flat_copy(raw, own[0]["name"] if own else None))
        med = typical_durations(jobs)
        rates = ((cfg.get("dashboard") or {}).get("usd_per_mtok") or {})
        saved_state = jobs_board_state(f, cfg)
        data["factories"].append({"path": f, "name": name, "jobs": len(jobs)})
        for j in jobs:
            if j.get("id"):
                v = job_view(f, name, j, med, rates)
                if saved_state:
                    st = saved_state(j["id"])
                    v["unsaved"] = st["state"] != "saved"
                    if st["held_back"]:
                        v["held_back"] = len(st["held_back"])
                (data["active"] if v["active"] else data["done"]).append(v)
    data["active"].sort(key=lambda v: v.get("updated") or "", reverse=True)
    data["done"].sort(key=lambda v: v.get("updated") or "", reverse=True)
    del data["done"][25:]
    return data


def write_board(factories):
    data = board_data(factories)
    blob = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    os.makedirs(state_dir(), exist_ok=True)
    write_atomic(board_file(), BOARD_HTML.replace("__DATA__", blob))
    return data


def board_refresh(ctx):
    """Every fx command in a factory repository rewrites the board. It never breaks the command."""
    if not ctx or not getattr(ctx, "cfg", None):
        return
    try:
        write_board(register_factory(ctx.factory))
    except Exception:  # noqa: BLE001 - the board is a view, never a reason to fail
        pass


def cmd_board(ctx, a):
    factories = register_factory(ctx.factory) if ctx and ctx.cfg else [
        f for f in json.loads(read(os.path.join(state_dir(), "factories.json"), "[]") or "[]")
        if os.path.isfile(os.path.join(f, CONFIG_NAME))]
    data = write_board(factories)
    url = "file://" + urllib.parse.quote(board_file())
    opened = None
    if a.open:
        for opener in ("open", "xdg-open", "wslview"):
            if shutil.which(opener):
                opened = run([opener, board_file()], check=False, timeout=30).returncode == 0
                break
    out({"ok": True, "path": board_file(), "url": url, "opened": opened, "factories": len(data["factories"]),
         "active": len(data["active"]), "next": "tell the user to open the board in a browser (it reloads itself "
                                                 "every few seconds; every fx command updates it)"})


