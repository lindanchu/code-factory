def local_only_paths(ctx, repo=None):
    """The files fx copies into every clone (copy_into_worktree, for example .env): never part of a commit."""
    got = ctx.rc(repo, "copy_into_worktree", []) if repo else ctx.c("copy_into_worktree", [])
    return [p.strip().strip("/") for p in (got or []) if p and p.strip().strip("/")]


def is_local_file(ctx, path, repo=None):
    return path in local_only_paths(ctx, repo) or (match_any(path, LOCAL_FILE_GLOBS) and not path.endswith(SHARED_ENV_SUFFIXES))


def stage_work(ctx, wt, untracked, repo=None):
    """Stage the tracked changes and these untracked files, never the local files (copy_into_worktree, .env*): they
    hold this machine's secrets. A pathspec cannot exclude .env* and keep .env.example, so the local files are taken
    back out of the index, also one a builder staged itself. Returns the files left out."""
    changed = [p for p in git(["diff", "--no-renames", "--name-only", "-z", "HEAD"], wt).stdout.split("\0") if p]
    left = [p for p in changed + untracked if is_local_file(ctx, p, repo)]
    git(["add", "-u", "--", "."], wt)
    work = [p for p in untracked if not is_local_file(ctx, p, repo)]
    if work:
        git(["--literal-pathspecs", "add", "--"] + work, wt)
    if left:
        git(["--literal-pathspecs", "reset", "-q", "--"] + left, wt)  # a failure here stops before any commit
    return left


def worktree_dirt(ctx, wt, repo=None):
    """Return (tracked changes, untracked non-artifact files) in a worktree. The copy_into_worktree files are
    fx's, not the job's: they are never listed as untracked work."""
    local = set(local_only_paths(ctx, repo))
    tracked = git(["status", "--porcelain", "--untracked-files=no", "--", "."] +
                  [":(exclude,literal)%s" % p for p in sorted(local)], wt).stdout.strip()
    patterns = (ctx.rc(repo, "artifact_paths", DEFAULT_ARTIFACTS) if repo else
                ctx.c("artifact_paths", DEFAULT_ARTIFACTS)) or []
    untracked = []
    for entry in git(["status", "--porcelain", "-z", "--untracked-files=all"], wt).stdout.split("\0"):
        if entry.startswith("?? "):
            path = entry[3:]
            if not match_any(path, patterns) and path not in local:
                untracked.append(path)
    return tracked, untracked


def changed_files(job):
    wt = job["worktree"]
    mb = git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
    diff = git(["diff", "--name-status", "-M", "%s..HEAD" % mb], wt).stdout
    files = []
    for line in diff.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            files.append((parts[0][0], parts[1:]))
    return files


def job_code_roots(job):
    """What the job's staged logic is checked against: {repo: clone} for every repository of the job (citations name
    the repository, repo:path, in a project of several; a repository the job has no clone of is read from its base)."""
    if is_whole_job(job):
        return {n: job["repos"][n].get("worktree") or "" for n in job_order(job)}
    return job.get("worktree") or ""


def ui_repo(ctx, job):
    """The repository whose app the UI checks open (BASE_URL), and where ui/seed.sh and ui/check.js run: the one whose
    ui_paths the job changed (the gate keeps it as ui_repo), else the first it changes that has ui_paths, else the
    first it changes that has an app, else its first."""
    change = job_names(job, "change")
    if job.get("ui_repo") in change:
        return job["ui_repo"]
    known = [n for n in change if n in ctx.repo_names()]
    for test in (lambda n: ctx.rc(n, "ui_paths"), lambda n: ctx.rc(n, "app.up")):
        hit = next((n for n in known if test(n)), None)
        if hit:
            return hit
    return change[0] if change else None


def md_demote(lines):
    """Headings one level down, for a report put under a ## Repo: section."""
    return [("#" + l) if re.match(r"^#{2,5} ", l) else l for l in lines]


def security_merge(secs, several):
    """The scans of several repositories as one result: what each says, named after its repository."""
    lab = (lambda n: "%s: " % n) if several else (lambda n: "")
    m = {"findings": [], "blocking": [], "skipped": [], "notes": [], "missed": [], "required_failed": [], "flags": []}
    for n, sec in secs.items():
        m["findings"] += sec["findings"]
        m["blocking"] += sec["blocking"]
        for k in ("skipped", "notes", "required_failed", "missed"):
            m[k] += [lab(n) + x for x in sec.get(k) or []]
        m["flags"] += ["%s:%s" % (n, x) if several else x for x in sec.get("flags") or []]
    return m


def security_markdown_repos(secs, several):
    """security.md: one repository's scan as always; several, a ## Repo: section each."""
    if not several:
        return security_markdown(next(iter(secs.values())))
    failed = any(sec["blocking"] or sec.get("required_failed") for sec in secs.values())
    md = ["SECURITY SCAN: %s" % ("FAIL" if failed else "PASS"), ""]
    for n, sec in secs.items():
        body = security_markdown(sec).splitlines()
        md += ["## Repo: %s" % n, "", body[0], ""] + md_demote(body[2:]) + [""]
    return "\n".join(md).rstrip("\n") + "\n"


def cmd_gate(ctx, a):
    """A round: per changed repository in repo_order, the dirt check, protected and frozen paths, its checks script and
    (after the last) the staged logic; the first that fails stops the gate. Then the apps (in dependency order), seed.sh,
    each repository's e2e, the UI check and each repository's security scan."""
    job = ctx.load(a.job)
    if job["stage"] != "build":
        raise FxError("gate runs after a build; job is in stage %s" % job["stage"])
    if rounds_left(job) <= 0:
        raise FxError("no rounds left for %s" % job["id"])
    change = job_names(job, "change")
    if not change:
        raise FxError("%s has no clones yet: intake names its repositories, then fx repos clones them" % job["id"], code=3)
    several = len(job_order(job)) > 1
    label = (lambda n: "%s: " % n) if several else (lambda n: "")
    views = {n: repo_view(ctx, job, n) for n in change}
    rctxs = {n: repo_ctx(ctx, n) for n in change}
    for n in change:
        wt = views[n]["worktree"]
        if not wt or not os.path.isdir(wt):
            raise FxError("the job's clone %s%s is missing. If its branch was pushed: `%s stage %s handed-off --force`, "
                          "then `/code-factory:factory rework %s`; otherwise start a new attempt of %s" % (
                              wt, " (%s)" % n if several else "", FX_CMD, job["id"], job["id"], job["issue_key"]),
                          code=3)
    if not ctx.old_form:
        missing = [os.path.relpath(checks_script(ctx, job, n), ctx.factory) for n in change
                   if not os.path.isfile(checks_script(ctx, job, n))]
        if missing:
            raise FxError("no checks script %s in the factory repository: write it (it runs in that repository's clone) "
                          "and commit it" % ", ".join(missing), code=3)
    bl_cfg = baselines_config(ctx)
    bl_pre = baselines_refresh(ctx, bl_cfg, hold=True) if bl_cfg else None  # before anything reads a checks script
    bl_cfg = baselines_config(ctx)
    # Exit 3, not a failed gate for the builder to work on: nobody makes these by accident, so a human hears of it.
    refusal = factory_settings_refusal(ctx) or history_rewrites_text(ctx, job)
    if refusal:
        raise FxError(refusal, code=3)
    for n in change:
        job_base_from_remote(ctx, job, n)
    settings_at = git(["rev-parse", "--verify", "-q", "HEAD"], ctx.factory, check=False).stdout.strip()
    job["round"] += 1
    rn = job["round"]
    for v in views.values():
        v["round"] = rn
    rdir = os.path.join(ctx.job_dir(job["id"]), "round-%d" % rn)
    os.makedirs(rdir, exist_ok=True)
    job["skipped_checks"], job["security_skipped"], job["security_missed"] = [], [], []  # describe this round only
    build_md = os.path.join(ctx.job_dir(job["id"]), "build.md")
    if os.path.exists(build_md):
        # Move, not copy: the next round must not see this round's STATUS line.
        os.replace(build_md, os.path.join(rdir, "build.md"))

    per = {}
    for n in change:
        files = changed_files(views[n])
        all_paths = [p for _, ps in files for p in ps]
        scanner = sorted({p for p in all_paths if match_any(p, SCANNER_SETTINGS)})
        per[n] = {"files": files, "scanner": scanner, "state": "not checked", "checks_out": "", "e2e_out": "",
                  "flags": sorted({p for p in all_paths if match_any(p, rctxs[n].c("sensitive_paths", []) or [])}
                                  | set(scanner)),
                  "ui_hit": [p for p in all_paths if match_any(p, rctxs[n].c("ui_paths", []) or [])]}
    named = (lambda n, paths: ["%s:%s" % (n, p) for p in paths]) if several else (lambda n, paths: list(paths))
    flags = sorted({x for n in change for x in named(n, per[n]["flags"])})
    scanner_files = sorted({x for n in change for x in named(n, per[n]["scanner"])})
    # A repository intake named that turned out to need nothing: while another has commits, it is not changed (no
    # checks, no scans, no pull request). With no commits anywhere, the gate fails as always.
    idle = [n for n in change if not per[n]["files"]] if any(per[n]["files"] for n in change) else []

    problems, bl, stopped_at = [], None, None
    # A run-only clone is the base, never pushed: work in it would be lost, and it is not what gets reviewed.
    for n in job_names(job, "run"):
        wt = job["repos"][n].get("worktree")
        if not wt or not os.path.isdir(wt):
            continue
        k, dirty = unsaved_work(ctx, job, wt, n)
        if k or dirty:
            problems.append("%s is run-only: run `fx repos %s --add %s` to change it (%s)" % (
                n, job["id"], n, "%d commit(s)" % k if k else dirty.splitlines()[0] if dirty else ""))
            stopped_at = stopped_at or n
    bl_name = None
    if bl_cfg:
        bl_name = bl_cfg["repo_name"] if bl_cfg["repo"] == "project" else change[0]
    for n in change if not problems else ():
        v, rc_, info = views[n], rctxs[n], per[n]
        mine = [job_off_its_branch(v)] if job_off_its_branch(v) else []
        tracked, untracked = worktree_dirt(ctx, v["worktree"], n)
        if bl_cfg and bl_cfg["repo"] == "project" and n == bl_name:
            # recorded, not committed yet: the list waits for its images on S3
            tracked = "\n".join(l for l in tracked.splitlines() if l.split(None, 1)[-1].strip('"') != bl_cfg["manifest"])
        if tracked:
            mine.append("Uncommitted changes to tracked files (commit them):\n" + tracked)
        if untracked:
            mine.append("Untracked files that are not in any commit (commit them, delete them, or add "
                        "build artifacts to .gitignore):\n" + "\n".join(untracked[:50]))
        if not info["files"] and n not in idle:
            mine.append("The branch has no commits beyond %s." % v["base_ref"])
        prot = rc_.c("protected_paths", []) or []
        frozen = rc_.c("frozen_paths", [".claude/*"]) or []
        for status, paths in info["files"]:
            old = paths[0]
            if any(match_any(p, frozen) for p in paths):
                mine.append("Frozen path changed: %s (frozen_paths in factory.json may not be touched by a job)"
                            % " -> ".join(paths))
            elif status in ("M", "D", "R") and match_any(old, prot):
                mine.append("Protected file %s: %s (existing tests may not be modified or deleted; "
                            "add new test files instead)" % ({"M": "modified", "D": "deleted",
                                                              "R": "renamed"}[status], old))
        if bl_cfg and n == bl_name:
            bl = baselines_gate(ctx, bl_cfg, v, rdir, bl_pre)
            job["baselines"] = bl["summary"]
            mine += bl["problems"]
        if not mine and n not in idle:
            script = checks_script(ctx, job, n)
            info["script"] = os.path.relpath(script, ctx.factory)
            info["log"] = "checks-%s.log" % n if several else "checks.log"
            timeout = int(rc_.c("gate_timeout_sec", 1800) or 1800)
            try:
                p = run(["bash", script], cwd=v["worktree"], check=False, env=checks_env(rc_, v), timeout=timeout)
                info["checks_out"] = p.stdout or ""
                if p.returncode != 0:
                    mine.append("%s exited with %d" % (info["script"], p.returncode))
            except subprocess.TimeoutExpired:
                mine.append("%s timed out after %ss" % (info["script"], timeout))
            write_atomic(os.path.join(rdir, info["log"]), info["checks_out"])
        info["state"] = "fail" if mine else "not changed" if n in idle else "pass"
        problems += [label(n) + m for m in mine]
        if mine:
            stopped_at = n
            break

    if not problems and logic_ready(ctx):
        sdir, snames = staged_logic(ctx, job)
        if logic_changes_planned(ctx, job) and not snames:
            problems.append("the spec lists logic changes but no updated logic file was staged in the job folder's "
                            "logic/ (see the 'Logic updates' line of the builder prompt)")
        if snames:
            lres = logic_check(ctx, sdir, job_code_roots(job), only=snames, check_index=False)
            if lres["problems"]:
                problems.append("staged logic files do not pass the check:\n" + "\n".join(lres["problems"][:20]))
            base = job.setdefault("logic_base", {})
            for x in snames:
                if x not in base:  # what logic/ held when this job started changing the file
                    base[x] = file_hash(os.path.join(logic_dir(ctx), x))
    hit = next((n for n in change if per[n]["ui_hit"]), None)
    if hit:
        job["ui_repo"] = hit
    if hit and "ui" not in job.get("surfaces", []):
        job["surfaces"] = list(job.get("surfaces", [])) + ["ui"]
        ui_added = True
    else:
        ui_added = False
    jd = ctx.job_dir(job["id"])
    ui_script = os.path.join(jd, "ui", "check.js")
    ui_name = ui_repo(ctx, job)
    ui_wanted = ("ui" in job.get("surfaces", [])) and repo_ctx(ctx, ui_name).c("ui_checks.enabled", True)
    ui_rep = None
    started, secs = {}, {}
    apps = job_apps(ctx, job)
    if not problems and apps:
        try:
            app_stop(ctx, job)
            info = app_start(ctx, job)
            started = info.get("apps") or {apps[0]: info}
        except FxError as e:
            problems.append("the app%s could not start: %s" % ("s" if len(apps) > 1 else "", e))
    urls = {n: info_["url"] for n, info_ in started.items()}

    def sec_dir(n):
        """Where a repository's scanners write their reports: the round's folder, or round-N/security-<repo>/."""
        d = os.path.join(rdir, "security-%s" % n) if several else rdir
        os.makedirs(d, exist_ok=True)
        return d
    if not problems and started and os.path.exists(os.path.join(jd, "ui", "seed.sh")):
        if not run_seed(ctx, job, os.path.join(jd, "ui", "seed.sh"), rdir):
            problems.append("ui/seed.sh failed (round-%d/seed.log)" % rn)
    for n in change:
        rc_ = rctxs[n]
        if problems or n not in urls or not rc_.c("e2e") or n in idle:
            continue
        env, db = app_env(rc_, views[n])
        env["BASE_URL"] = urls[n].rstrip("/")
        log = "e2e-%s.log" % n if several else "e2e.log"
        timeout = int(rc_.c("e2e_timeout_sec", 1800) or 1800)
        try:
            p = run(["bash", "-lc", app_fill(rc_.c("e2e"), views[n], db)], cwd=views[n]["worktree"], check=False,
                    env=env, timeout=timeout)
            per[n]["e2e_out"] = p.stdout or ""
            if p.returncode != 0:
                problems.append("%se2e tests exited with %d (see round-%d/%s)" % (label(n), p.returncode, rn, log))
        except subprocess.TimeoutExpired:
            problems.append("%se2e tests timed out after %ss" % (label(n), timeout))
        per[n]["e2e_log"] = log
        write_atomic(os.path.join(rdir, log), per[n]["e2e_out"])
    if not problems and ui_wanted:
        if ui_name not in urls:
            job["skipped_checks"].append("UI checks skipped: no app.up command to run the app%s "
                                         "(set it with /code-factory:factory init)" % (
                                             " of %s" % ui_name if several else ""))
        elif not os.path.exists(ui_script):
            problems.append("this change is user-visible but the builder wrote no ui/check.js "
                            "(a Playwright check of the UI acceptance criteria) in the job folder")
        else:
            ui_rep = ui_run(ctx, job, ui_script, os.path.join(rdir, "ui"))
            write_atomic(os.path.join(rdir, "ui.md"), ui_markdown(ui_rep, ui_name if several else None))
            if ui_rep.get("skipped"):
                job["skipped_checks"].append(ui_rep["skipped"])
            elif ui_rep["blocking"]:
                problems.append("UI check failed: %d blocking issue(s), see round-%d/ui.md"
                                % (len(ui_rep["blocking"]), rn))
    sec = None
    if not problems:
        # Always: a factory.json without security.scanners means the template's defaults (all on).
        for n in change:
            if n in idle:
                continue
            secs[n] = run_security(rctxs[n], views[n], sec_dir(n), urls.get(n))
            for f in secs[n]["findings"]:
                f["repo"] = n
        sec = security_merge(secs, several)
        write_atomic(os.path.join(rdir, "security.md"), security_markdown_repos(secs, several))
        job["security_skipped"] = sec["skipped"]
        job["security_missed"] = sec["missed"]
        flags = sorted(set(flags) | set(sec["flags"]))
        if sec["required_failed"]:
            problems.append("required security scanner(s) did not run (security.required in factory.json): %s"
                            % "; ".join(sec["required_failed"]))
        if sec["blocking"]:
            problems.append("security scan: %d blocking finding(s) introduced by this job, see round-%d/security.md"
                            % (len(sec["blocking"]), rn))
    else:
        # Secrets are checked every round, even when the rest of the gate stopped early.
        for n in change:
            v = views[n]
            if not per[n]["files"] or not scanners_on(rctxs[n])["gitleaks"]:
                continue
            mb = git(["merge-base", v["base_ref"], "HEAD"], v["worktree"]).stdout.strip()
            leaks, err, _ = scan_secrets(rctxs[n], v, mb, sec_dir(n))
            if leaks:
                secs[n] = {"findings": leaks, "blocking": leaks,
                           "skipped": ["other scanners: not run, the gate stopped earlier"]}
        if secs:
            sec = security_merge(secs, several)
            write_atomic(os.path.join(rdir, "security.md"), security_markdown_repos(secs, several))
            for n, s_ in secs.items():
                problems.append("%ssecrets committed on the branch: %d (see round-%d/security.md); remove them from the "
                                "unpushed history, not just the latest commit: `git reset --soft %s`, take them out, "
                                "commit again" % (label(n), len(s_["blocking"]), rn, unpushed_base(views[n])[:12]))

    # The checks scripts run the project's code, which could reach them too, and the scanners came after it.
    changed = factory_dirty(ctx) or factory_changed_since(ctx, settings_at)
    if changed:
        problems.append("the gate's settings changed while it ran:\n" + changed)
    passed = not problems
    md = ["GATE: %s" % ("PASS" if passed else "FAIL"), "",
          "Round %d. Branch %s%s." % (rn, job_branch_name(job), " in %s" % ", ".join(change) if several else ""), ""]
    if problems:
        md += ["## Problems", ""] + ["- " + p.replace("\n", "\n  ") for p in problems] + [""]
    skipped_all = job["skipped_checks"] + job["security_skipped"]
    if skipped_all:
        md += ["## Skipped checks", ""] + ["- " + x for x in skipped_all] + [""]
    if bl:
        md += bl["markdown"]
    if flags:
        md += ["## Sensitive paths touched (approver must look)", ""] + ["- " + f for f in flags] + [""]
    if scanner_files:
        md += ["## Scanner settings changed (they can hide findings; fx's scans ignore them, a human must look)",
               ""] + ["- " + f for f in scanner_files] + [""]
    if sec is not None and sec.get("notes"):
        md += ["## Security notes", ""] + ["- " + x for x in sec["notes"]] + [""]
    for n in change:
        info = per[n]
        part = []
        if several and info["state"] == "not checked":
            part += ["Not checked: the gate stopped at %s." % stopped_at, ""] if stopped_at else []
        if info["state"] == "not changed":
            part += ["Not changed: no commits beyond %s, so its checks and scans are skipped and it gets no pull "
                     "request (`fx repos %s --drop %s` takes it out of the job)." % (views[n]["base_ref"], job["id"], n),
                     ""]
        if info["checks_out"]:
            part += ["## %s output (last 150 lines, full log in %s)" % (info["script"], info["log"]), "", "```",
                     "\n".join(info["checks_out"].splitlines()[-150:]), "```", ""]
        if info["e2e_out"]:
            part += ["## e2e output (last 100 lines, full log in %s)" % info["e2e_log"], "", "```",
                     "\n".join(info["e2e_out"].splitlines()[-100:]), "```", ""]
        if ui_rep is not None and n == ui_name:
            part += ["## UI check", "", "See ui.md and the screenshots under ui/shots/ in this round's folder.", ""]
            part += ["- " + b for b in ui_rep.get("blocking", [])[:30]] + [""]
        if n in secs:
            part += ["## Security scan", "", "See security.md in this round's folder.", ""]
            part += ["- %s %s %s: %s" % (f["severity"], f["tool"], f.get("location"), f.get("message"))
                     for f in secs[n]["blocking"][:30]] + [""]
        md += (["## Repo: %s" % n, ""] + md_demote(part)) if several else part
    write_atomic(os.path.join(rdir, "checks.md"), "\n".join(md) + "\n")

    notes = []
    job["gate"] = "PASS" if passed else "FAIL"
    job["flags"] = flags
    if flags and job.get("risk") == "low":
        job["risk"] = "high"
        notes.append("risk raised to high: sensitive paths changed")
    if ui_added:
        notes.append("UI reviewers added: UI files changed")
    if notes or (len(change) > 1) != ("fit" in (job.get("reviewers") or [])):
        route(ctx, job)
    if scanner_files:
        notes.append("scanner settings changed by the job (a human must look): %s" % ", ".join(scanner_files))
    if sec is not None:
        notes += sec.get("notes") or []

    res = {"job": job["id"], "round": rn, "gate": job["gate"], "report": os.path.join(rdir, "checks.md"),
           "flags": flags, "notes": notes, "skipped": skipped_all, "rounds_left": rounds_left(job)}
    if several:
        res["repos"] = {n: per[n]["state"] for n in change}
    if bl:
        notes += ["baselines: " + w for w in bl["summary"]["warnings"]]
        res["baselines"] = {k: bl["summary"][k] for k in ("counts", "fetched", "unrecorded", "pulled")}
        res["baselines"]["pending_push"] = len(bl["summary"]["pending_push"])
        if sum(bl["summary"]["counts"].values()):
            notes.append("baselines changed (%(changed)d changed, %(added)d added, %(removed)d removed): see "
                         "baselines.md in this round's folder" % bl["summary"]["counts"])
    if passed:
        job["reviews"] = {r: "pending" for r in job["reviewers"]}
        for n in change:
            job["repos"][n]["checks_passed_at"] = git(["rev-parse", "HEAD"], views[n]["worktree"]).stdout.strip()
        job.pop("checks_passed_at", None)
        if isinstance(job, Job) and job.shown:
            job.shown[1].pop("checks_passed_at", None)
        ctx.move(job, "review", "gate PASS round %d" % rn)
        res.update(next="review", reviewers=job["reviewers"],
                   models={r: job["models"][r] for r in job["reviewers"]})
        if "fit" in job["reviewers"]:  # its agent is not named factory-reviewer-<role> like the others
            res["agents"] = {r: REVIEWER_AGENTS.get(r, "factory-reviewer-%s" % r) for r in job["reviewers"]}
    elif rounds_left(job) > 0:
        job["build_reason"] = "feedback"
        ctx.save(job, "gate FAIL round %d" % rn)
        res["next"] = "build"
    else:
        job["needs_human"] = True
        job["incomplete"] = True
        job["handoff_reason"] = "gate still failing after %d rounds" % job["max_rounds"]
        ctx.move(job, "pr", "rounds exhausted at gate")
        res["next"] = "pr"
    out(res)


VERIFY_LINE_RE = re.compile(r"^\s*\d+\.\s*\**\s*(confirmed|rejected|unsure)\b", re.I)


def verify_verdict(job, rdir, verdict):
    """The verifier's verdict only counts when verify-security.md answers every [blocking] finding of
    review-security.md (one confirmed|rejected|unsure line each) and agrees with its own lines: a bare
    `VERDICT: PASS` cannot clear the findings."""
    review = read(os.path.join(rdir, "review-security.md"), "") or ""
    verify = read(os.path.join(rdir, "verify-security.md"), "") or ""
    n_block = sum(1 for l in review.splitlines() if FINDING_RE.match(l))
    answers = [m.group(1).lower() for m in (VERIFY_LINE_RE.match(l) for l in verify.splitlines()) if m]
    if len(answers) != n_block:
        raise FxError("round-%d/verify-security.md answers %d finding(s) but review-security.md has %d [blocking] "
                      "finding(s); it needs one numbered `confirmed | rejected | unsure: …` line per finding"
                      % (job["round"], len(answers), n_block), code=6, extra={"retry_agent": "verifier"})
    if verdict == "PASS" and any(x != "rejected" for x in answers):
        raise FxError("round-%d/verify-security.md says VERDICT: PASS but keeps %d finding(s) confirmed or unsure; "
                      "the verdict must be CHANGES then" % (job["round"], sum(x != "rejected" for x in answers)),
                      code=6, extra={"retry_agent": "verifier"})
    return verdict


def cmd_verdicts(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "review":
        raise FxError("job is in stage %s, not review" % job["stage"])
    rdir = os.path.join(ctx.job_dir(job["id"]), "round-%d" % job["round"])
    missing, changes, need_verify = [], [], []
    for r in job["reviewers"]:
        line = first_line(os.path.join(rdir, "review-%s.md" % r))
        if line is None:
            missing.append(r)
            job["reviews"][r] = "pending"
            continue
        m = VERDICT_RE.match(line)
        if not m:
            raise FxError("round-%d/review-%s.md starts with %r, not VERDICT: PASS|CHANGES"
                          % (job["round"], r, line), code=6, extra={"retry_agent": r})
        verdict = m.group(1)
        if r == "security" and verdict == "CHANGES" and not any(
                FINDING_RE.match(l) for l in (read(os.path.join(rdir, "review-security.md"), "") or "").splitlines()):
            # Findings the script cannot count: the verifier could never answer them, and a bare PASS would clear them.
            raise FxError("round-%d/review-security.md says CHANGES but lists no numbered `N. [blocking]` finding"
                          % job["round"], code=6, extra={"retry_agent": "security"})
        if r == "security" and verdict == "CHANGES" and ctx.c("security.verify_findings", True):
            vline = first_line(os.path.join(rdir, "verify-security.md"))
            if vline is None:
                need_verify.append(r)
                job["reviews"][r] = "verifying"
                continue
            vm = VERDICT_RE.match(vline)
            if not vm:
                raise FxError("round-%d/verify-security.md starts with %r, not VERDICT: PASS|CHANGES"
                              % (job["round"], vline), code=6, extra={"retry_agent": "verifier"})
            verdict = verify_verdict(job, rdir, vm.group(1))
        job["reviews"][r] = verdict
        if verdict == "CHANGES":
            changes.append(r)
    res = {"job": job["id"], "round": job["round"], "reviews": job["reviews"]}
    if missing:
        ctx.save(job)
        res.update(next="wait", missing=missing)
    elif need_verify:
        ctx.save(job, "security findings sent for independent verification")
        res.update(next="verify", verify=need_verify)
    elif not changes:
        ctx.move(job, "approve", "all reviews PASS round %d" % job["round"])
        res["next"] = "approve"
    elif rounds_left(job) > 0:
        job["build_reason"] = "feedback"
        ctx.move(job, "build", "CHANGES from %s" % ", ".join(changes))
        res.update(next="build", changes=changes, rounds_left=rounds_left(job))
    else:
        job["needs_human"] = True
        job["incomplete"] = True
        job["handoff_reason"] = "review rounds exhausted; outstanding CHANGES from %s" % ", ".join(changes)
        ctx.move(job, "pr", "rounds exhausted at review")
        res.update(next="pr", changes=changes)
    out(res)


def parse_questions(text):
    qs = []
    for block in re.split(r"(?m)^##\s+", text or ""):
        block = block.strip()
        if not block:
            continue
        head = block.splitlines()[0].strip()
        if re.match(r"^Q\d+", head, re.I):
            qs.append(head)
    return qs


QUESTION_HEAD_RE = re.compile(r"^##\s+Q\d+", re.I)
QUESTION_FIELD_RE = re.compile(r"^\s*(why|easy|technical|options|recommended|answer)\s*:", re.I)


def easy_first(text):
    """questions.md as people read it on Jira: under each question its Easy: line first, the plain-words version, then
    Why, Technical, the options and the recommendation as written. A question without an Easy: line, in the older
    format, stays as it is."""
    lines = (text or "").splitlines()
    done, i = [], 0
    while i < len(lines):
        if not QUESTION_HEAD_RE.match(lines[i]):
            done.append(lines[i])
            i += 1
            continue
        j = i + 1
        while j < len(lines) and not re.match(r"^##\s", lines[j]):
            j += 1
        block = lines[i + 1:j]
        at = next((n for n, l in enumerate(block) if re.match(r"^\s*easy\s*:", l, re.I)), None)
        if at is not None:
            end = at + 1  # one line, or more when it runs on before the next field, list or blank line
            while end < len(block) and block[end].strip() and not QUESTION_FIELD_RE.match(block[end]) \
                    and not re.match(r"^\s*([-*]|\d+\.)\s", block[end]):
                end += 1
            rest = block[:at] + block[end:]
            lead = []
            while rest and not rest[0].strip():
                lead.append(rest.pop(0))
            block = lead + block[at:end] + rest
        done += [lines[i]] + block
        i = j
    return "\n".join(done)


def parse_answers(text):
    pairs = []
    for block in re.split(r"(?m)^##\s+", text or ""):
        block = block.strip()
        if not block or not re.match(r"^Q\d+", block, re.I):
            continue
        lines = block.splitlines()
        ans = ""
        for l in lines[1:]:
            m = re.match(r"^Answer:\s*(.*)$", l.strip(), re.I)
            if m:
                ans = m.group(1).strip()
        pairs.append((lines[0].strip(), ans or "-"))
    return pairs


def cmd_answers(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "needs-info":
        raise FxError("job is in stage %s, not needs-info" % job["stage"])
    jd = ctx.job_dir(job["id"])
    qpath = os.path.join(jd, "questions.md")
    qtext = read(qpath, "")
    if not qtext.strip():
        raise FxError("questions.md is missing or empty; nothing to answer")
    questions = parse_questions(qtext)
    if a.from_jira:
        answers = "Answered on Jira; the replies are in the comments of issue.md (refreshed).\n"
        if not job.get("jira_base"):
            raise FxError("%s is a local task with no Jira issue" % job["id"])
        if jira_mode(ctx) == "token":
            jira_fetch_into(ctx, jd, job["jira_base"], job["issue_key"])
    else:
        answers = read(os.path.join(jd, "answers.md"), "")
        if not answers.strip():
            raise FxError("answers.md is missing or empty")
        answered = parse_questions(answers)
        if questions and len(answered) < len(questions):
            raise FxError("answers.md covers %d of %d questions" % (len(answered), len(questions)))
    back = job["resume_stage"]
    k = 1
    while os.path.exists(os.path.join(jd, "questions-%d.md" % k)):
        k += 1
    os.replace(qpath, os.path.join(jd, "questions-%d.md" % k))
    if os.path.exists(os.path.join(jd, "answers.md")):
        os.replace(os.path.join(jd, "answers.md"), os.path.join(jd, "answers-%d.md" % k))
    # The asking agent's result file is stale now; the re-run must write a fresh one.
    stale = {"intake": "intake.md", "spec": "spec.md", "build": "build.md"}.get(back)
    if stale and os.path.exists(os.path.join(jd, stale)):
        os.replace(os.path.join(jd, stale), os.path.join(jd, "%s-asked-%d.md" % (stale[:-3], k)))
    log = read(os.path.join(jd, "qa-log.md"), "# Questions and answers\n")
    log += "\n## Round %d (asked by %s, %s)\n\n### Questions\n\n%s\n\n### Answers\n\n%s\n" % (
        k, back, now()[:16], qtext.strip(), answers.strip())
    write_atomic(os.path.join(jd, "qa-log.md"), log)
    job["resume_stage"] = None
    if back == "build":
        job["build_reason"] = "answers"
    summary_done(job, "ask")  # what fx ask-jira kept of these questions is done with them
    ctx.move(job, back, "answers recorded (set %d)" % k)
    posted = None
    if not a.from_jira and not a.no_jira:
        pairs = parse_answers(answers)
        if pairs:
            listing = "\n".join("- %s → **%s**" % (q, ans) for q, ans in pairs)
        else:
            listing = answers.strip()
        body = "**Software factory: clarifications for %s**\n\n%s" % (job["issue_key"], listing)
        posted = jira_comment(ctx, job, body)
    finish(ctx, {"ok": True, "job": job["id"], "next": back, "qa_log": os.path.join(jd, "qa-log.md"),
                 "posted_to_jira": posted}, job)


def cmd_ask_jira(ctx, a):
    job = ctx.load(a.job)
    if not job.get("jira_base"):
        raise FxError("%s is a local task with no Jira issue; ask the user in the session" % job["id"])
    if job["stage"] != "needs-info":
        raise FxError("job is in stage %s, not needs-info" % job["stage"])
    given = summary_arg(ctx, a)
    notes = []
    qtext = read(os.path.join(ctx.job_dir(job["id"]), "questions.md"), "")
    body = ("**Software factory needs information before continuing %s.**\n\n%s\n\n"
            "Reply in a comment, then run `/code-factory:factory resume %s`." % (job["issue_key"], easy_first(qtext).strip(),
                                                                   job["issue_key"]))
    r = comment_for_people(ctx, job, summary_to_use(ctx, job, "ask", given, notes), body, notes, force=True)
    if "error" in r:
        raise FxError("could not post the questions to Jira: %s" % r["error"], code=4)
    summary_done(job, "ask")
    ctx.save(job, "questions posted to Jira")
    res = {"ok": True, "job": job["id"], "jira": r, "next": "stop"}
    if notes:
        res["notes"] = notes
    finish(ctx, res, job)


def jira_safe(ctx, fn):
    """Jira updates must never stop the pipeline: report the error and carry on."""
    try:
        r = fn()
        return r if isinstance(r, dict) and ("moved" in r or "skipped" in r) else {"ok": True}
    except Exception as e:  # noqa: BLE001 - a Jira problem must never break a job
        hint("fx: Jira update failed: %s" % e)
        return {"error": str(e)}


def jira_transition(ctx, job, which):
    target = ctx.c("jira.transitions.%s" % which, which)
    if not target:
        return {"skipped": "no %s transition configured" % which}
    j = Jira(ctx, job["jira_base"])
    data = j.issue(job["issue_key"])
    current = value_to_md((data.get("fields") or {}).get("status"))
    if current.lower() == target.lower():
        return {"skipped": "already %s" % current}
    for t in j.transitions(job["issue_key"]):
        to = ((t.get("to") or {}).get("name") or "")
        if to.lower() == target.lower() or (t.get("name") or "").lower() == target.lower():
            j.transition(job["issue_key"], t["id"])
            return {"moved": "%s -> %s" % (current, to)}
    hint("fx: no Jira transition to %r from %r; leaving status unchanged" % (target, current))
    return {"skipped": "no transition to %s from %s" % (target, current)}


def jira_mode(ctx):
    """mcp: fx queues the Jira work (jira_todo) and the orchestrator does it with Claude's Atlassian connector, even when
    a token exists; fx never opens jira.env. token: fx calls Jira itself with jira.env. agent and api, an older version's
    names, are mcp and token; auto, no mode or one fx does not know is token when jira.env holds both values, else mcp."""
    return JIRA_MODES.get(jira_mode_setting(ctx)) or ("token" if jira_keys_complete(ctx) else "mcp")


def site_of(base):
    return urllib.parse.urlparse(base).netloc or base


def pending(job):
    return [i for i in job.get("jira_todo", []) if not i.get("done")]


def queue(job, action, **kw):
    n = int(job.get("jira_seq", 0)) + 1
    job["jira_seq"] = n
    item = {"id": "j%d" % n, "action": action, "issue": job["issue_key"], "site": site_of(job["jira_base"])}
    item.update(kw)
    job.setdefault("jira_todo", []).append(item)
    return {"queued": item["id"]}


def jira_comment(ctx, job, markdown, force=False):
    if not job.get("jira_base"):
        return {"skipped": "local task, no Jira issue"}
    if not force and not ctx.c("jira.comment", True):
        return {"skipped": "jira.comment is off"}
    # Comments quote the agents' files (spec, questions, reasons): never post a secret they contain.
    markdown, hits = scrub_text(ctx, markdown)
    if jira_mode(ctx) == "mcp":
        r = queue(job, "comment", markdown=markdown)
    else:
        r = jira_safe(ctx, lambda: Jira(ctx, job["jira_base"]).comment(job["issue_key"], md_to_adf(markdown)))
    if hits:
        r["redacted"] = hits
    return r


def jira_move(ctx, job, which):
    if not job.get("jira_base"):
        return {"skipped": "local task, no Jira issue"}
    target = ctx.c("jira.transitions.%s" % which, which)
    if not target:
        return {"skipped": "no %s transition configured" % which}
    if jira_mode(ctx) == "mcp":
        return queue(job, "transition", to=target)
    return jira_safe(ctx, lambda: jira_transition(ctx, job, which))


# --------------------------------------------------------------------------
# text for people: what fx posts for a person to read or act on (the comment when intake turns an issue down, the
# comment on an issue that differs from logic/, the questions of fx ask-jira, and the pull request description and
# Jira comment of fx pr) opens with the orchestrator's summary for people; what fx writes follows as the technical part

PEOPLE_HEADINGS = {"en": ("## Summary", "## Technical part"), "vi": ("## Tóm tắt", "## Phần kỹ thuật")}
SUMMARY_HEADING_RE = re.compile(r"^#{1,6}\s*(summary|tóm tắt)\s*:?\s*$", re.I)
SUMMARY_MISSING = ("a summary for people is missing: %s only the technical part (fx takes the summary with "
                   "--summary-file)")
SUMMARY_AGAIN = ("the summary for people given to an earlier run of this step, which did not finish, went first again "
                 "(--summary-file replaces it)")


def speaks_vietnamese(language):
    """factory.json's language is Vietnamese: vi, vi-VN, Vietnamese, Tiếng Việt and the like."""
    plain = unicodedata.normalize("NFKD", str(language or "")).encode("ascii", "ignore").decode().strip().lower()
    return plain in ("vi", "vie") or plain.startswith(("vi-", "vi_", "viet", "tieng viet"))


def two_parts(ctx, summary, technical):
    """Text for people: the summary under its heading, then what fx writes under the technical part's heading, in
    Vietnamese when factory.json's language is. Without a summary it is what fx writes, as it was."""
    if not summary:
        return technical
    head, tech = PEOPLE_HEADINGS["vi" if speaks_vietnamese(ctx.c("language")) else "en"]
    return "%s\n\n%s\n\n%s\n\n%s" % (head, summary.strip(), tech, technical.lstrip())


def summary_arg(ctx, a):
    """--summary-file: the summary for people the orchestrator wrote, scrubbed for secrets like the rest of the text.
    Returns (text, names of what was redacted), or None without the flag. A missing or empty file stops the command
    (exit 3) before anything is posted or changed."""
    path = getattr(a, "summary_file", None)
    if path is None:
        return None
    try:
        text = read(path) if os.path.isfile(path) else None
    except OSError:
        text = None
    if text is None:
        raise FxError("--summary-file %s does not exist or cannot be read: write the summary for people there, then "
                      "run the same command again" % path, code=3)
    lines = text.strip().splitlines()
    if lines and SUMMARY_HEADING_RE.match(unicodedata.normalize("NFC", lines[0].strip())):
        lines = lines[1:]  # fx writes the heading itself
    text = "\n".join(lines).strip()
    if not text:
        raise FxError("--summary-file %s is empty: write the summary for people there, then run the same command again"
                      % path, code=3)
    return scrub_text(ctx, text)


def summary_to_use(ctx, job, step, given, notes):
    """The summary for people that goes first in what this step posts: the one given now, kept with the job before
    anything is posted; else the one an earlier run of the same step was given when that run did not finish, so it
    comes back when the step runs again after an interruption. Returns (text or None, names of what was redacted)."""
    kept = job.get("people_summary") or {}
    if given:
        kept[step] = {"text": given[0], "redacted": given[1], "posted": False}
        job["people_summary"] = kept
        ctx.save(job)
        return given
    rec = kept.get(step) or {}
    if rec.get("text") and not rec.get("posted"):
        notes.append(SUMMARY_AGAIN)
        return rec["text"], rec.get("redacted") or []
    return None, []


def summary_done(job, step, drop=False):
    """The step's text went out. fx pr's summary stays with the job, marked posted: a re-run of fx pr writes the
    descriptions again, and a later push needs a new one. The others are dropped, and so is fx pr's with drop."""
    kept = job.get("people_summary") or {}
    if step == "pr" and kept.get("pr") and not drop:
        kept["pr"]["posted"] = True
    else:
        kept.pop(step, None)
    if not kept:
        job.pop("people_summary", None)


def comment_for_people(ctx, job, summary, technical, notes, force=False, say_missing=True):
    """Post (or queue) a Jira comment that a person reads or acts on: summary (from summary_to_use) first, then the
    technical part. Without a summary it still goes, and notes say that a summary for people is missing."""
    text, hits = summary
    r = jira_comment(ctx, job, two_parts(ctx, text, technical), force=force)
    if "skipped" in r:
        return r
    if hits:
        r["redacted"] = sorted(set(r.get("redacted", []) + hits))
    if not text and say_missing and "error" not in r:
        notes.append(SUMMARY_MISSING % ("the comment on %s has" % job["issue_key"]))
    return r


def pr_description(ctx, job, repo=None, links=None):
    """The pull request description: the summary for people fx pr was given, then what fx writes (pr_body)."""
    return two_parts(ctx, ((job.get("people_summary") or {}).get("pr") or {}).get("text"),
                     pr_body(ctx, job, repo, links))


def finish(ctx, res, job, push=False):
    """Save the job and print the result, listing any Jira work still to do. push: the job has reached its end, so it
    goes to the jobs store, as what it is after this last save."""
    p = pending(job)
    if p:
        res["jira_todo"] = p
    ctx.save(job)
    if push:
        mark_step(ctx, job["id"], "push", False)  # the last write to the job, which main would make after this push
        jobs_after_step(ctx, res, [job["id"]])
    out(res)


# fx jira children, finished and statuses: the Jira reads of a parent issue and of /code-factory:factory init, about no job. Mode token:
# fx reads with jira.env, so a machine without Claude's Atlassian connector runs those commands too. Mode mcp: fx calls no
# Jira and opens no jira.env; it says what to read, and the orchestrator reads it with its Atlassian tools.
JIRA_READS = ("children", "finished", "statuses")
ISSUE_FIELDS = ("summary", "issuetype", "status", "project", "components", "labels")
FINISHED_FIELDS = ("summary", "issuetype", "description")
FINISHED_LIMIT, FINISHED_MAX = 15, 30  # fx jira finished: how many issues by default, and at most
CHILDREN_MAX = 100  # fx jira children: child issues at most
DESCRIPTION_MAX = 2000  # fx jira finished cuts each description to this many characters


def jira_issue_arg(ctx, ref):
    """(site or None, KEY) of the issue key or link fx jira children and statuses take. Only an issue key goes on to
    JQL or a request: anything else is refused (exit 3). A bare key's site is jira.base_url, else the last job's."""
    ref = (ref or "").strip()
    base, key = None, None
    if re.match(r"^https?://", ref):
        try:
            base, key = parse_issue_ref(ref, ctx)
        except FxError:
            key = None
    else:
        key = ref.upper()
        base = str(ctx.c("jira.base_url") or "").strip().rstrip("/") or last_jira_base(ctx)
    if not key or not KEY_RE.fullmatch(key):
        raise FxError("%r is not an issue key or a link to an issue: give a key such as PROJ-123, or its link"
                      % ref[:100], code=3)
    return base, key


def jira_project_arg(ref):
    """The project key fx jira finished takes (PROJ for PROJ-123). Anything else is refused (exit 3)."""
    project = (ref or "").strip().upper()
    if not PROJECT_KEY_RE.fullmatch(project):
        raise FxError("%r is not a Jira project key: give the part before the dash in the project's issue keys (PROJ "
                      "for PROJ-123)" % (ref or "")[:100], code=3)
    return project


def jira_scrubber(ctx):
    """A scrub for the Jira text fx prints, with this machine's secrets read once, and the set of what it redacted."""
    local, redacted = local_secret_values(ctx), set()

    def scrub(text):
        text, hits = scrub_text(ctx, text, local)
        redacted.update(hits)
        return text
    return scrub, redacted


def jira_brief(it, scrub):
    """Key, summary, issue type, status, project, components and labels of an issue in Jira's answer."""
    it = it if isinstance(it, dict) else {}
    f = it.get("fields") if isinstance(it.get("fields"), dict) else {}
    key = str(it.get("key") or "")
    project = f.get("project") if isinstance(f.get("project"), dict) else {}
    return {"key": key, "summary": scrub(str(f.get("summary") or "")), "type": value_to_md(f.get("issuetype")),
            "status": value_to_md(f.get("status")), "project": str(project.get("key") or key.split("-")[0]),
            "components": [c["name"] for c in f.get("components") or [] if isinstance(c, dict) and c.get("name")],
            "labels": [x for x in f.get("labels") or [] if isinstance(x, str)]}


def jira_finished_brief(it, scrub):
    """Key, summary, issue type and description (markdown, cut to DESCRIPTION_MAX characters) of a finished issue."""
    f = it.get("fields") if isinstance(it.get("fields"), dict) else {}
    text = scrub(value_to_md(f.get("description")))  # scrubbed whole: a cut could split a secret in two
    return {"key": str(it.get("key") or ""), "summary": scrub(str(f.get("summary") or "")),
            "type": value_to_md(f.get("issuetype")), "description": text[:DESCRIPTION_MAX],
            "cut": len(text) > DESCRIPTION_MAX}


def key_order(key):
    """PROJ-9 before PROJ-10."""
    head, _, num = (key or "").rpartition("-")
    return (head, int(num)) if num.isdigit() else (key or "", 0)


def jira_read(ctx, a):
    """fx jira children <KEY or link>, finished <PROJECT> [--limit N] and statuses <KEY or link>."""
    if a.arg is not None:
        raise FxError("fx jira %s takes %s and nothing after it" % (
            a.action, "one project key" if a.action == "finished" else "one issue key or link"), code=3)
    if a.limit is not None and a.action != "finished":
        raise FxError("--limit is for fx jira finished", code=3)
    if a.action == "finished":
        project = jira_project_arg(a.job)
        limit = FINISHED_LIMIT if a.limit is None else a.limit
        if not 1 <= limit <= FINISHED_MAX:
            raise FxError("--limit takes 1 to %d (default %d)" % (FINISHED_MAX, FINISHED_LIMIT), code=3)
        base = str(ctx.c("jira.base_url") or "").strip().rstrip("/") or None
        res = {"ok": True, "project": project, "limit": limit,
               "jql": 'project = "%s" AND statusCategory = Done ORDER BY resolved DESC, updated DESC' % project}
        what = ("the %d most recently finished issues of project %s (the search in jql), each with its key, summary, "
                "issue type and description" % (limit, project))
    else:
        base, key = jira_issue_arg(ctx, a.job)
        res = {"ok": True, "issue_key": key}
        if a.action == "children":
            res["jql"] = 'parent = "%s"' % key
            what = ("the issue %s and its child issues (the search in jql), each with its key, summary, issue type, "
                    "status, project, components and labels" % key)
        else:
            what = "the transitions of %s now: each one's name and the status it leads to" % key
    if jira_mode(ctx) == "mcp":
        res.update(next="use your Atlassian tools", read=what)
        if base:
            res["site"] = site_of(base)
        out(res)
        return
    j = Jira(ctx, base or "")
    scrub, redacted = jira_scrubber(ctx)
    if a.action == "children":
        res["issue"] = jira_brief(j.issue(key, ISSUE_FIELDS), scrub)
        children, more = j.search(res["jql"], ISSUE_FIELDS, CHILDREN_MAX)
        res["children"] = sorted((jira_brief(c, scrub) for c in children), key=lambda c: key_order(c["key"]))
        res["more"] = more
        if more:
            res["notes"] = ["Jira has more than %d child issues of %s: only the first %d are here"
                            % (CHILDREN_MAX, key, CHILDREN_MAX)]
    elif a.action == "finished":
        issues, more = j.search(res["jql"], FINISHED_FIELDS, limit)
        res["issues"] = [jira_finished_brief(i, scrub) for i in issues]
        res["more"] = more
    else:
        res["transitions"] = [{"name": str(t.get("name") or ""), "to": value_to_md(t.get("to"))}
                              for t in j.transitions(key) if isinstance(t, dict)]
    if redacted:
        res["redacted"] = sorted(redacted)
    out(res)


def cmd_jira(ctx, a):
    if a.action in JIRA_READS:
        jira_read(ctx, a)
        return
    if a.limit is not None:
        raise FxError("--limit is for fx jira finished", code=3)
    job = ctx.load(a.job)
    if not job.get("jira_base"):
        raise FxError("%s is a local task with no Jira issue" % job["id"])
    if a.action == "fetch":
        path = os.path.join(ctx.job_dir(job["id"]), "issue.md")
        if jira_mode(ctx) == "mcp":
            out({"ok": True, "job": job["id"], "next": "fetch", "issue_key": job["issue_key"],
                 "site": site_of(job["jira_base"]), "write_to": path})
            return
        jira_fetch_into(ctx, ctx.job_dir(job["id"]), job["jira_base"], job["issue_key"])
        out({"ok": True, "job": job["id"], "issue": path})
    elif a.action == "comment":
        text = sys.stdin.read() if a.arg in (None, "-") else read(a.arg)
        if not text or not text.strip():
            raise FxError("nothing to post")
        finish(ctx, {"ok": True, "job": job["id"], "jira": jira_comment(ctx, job, text, force=True)}, job)
    elif a.action == "transition":
        r = jira_move(ctx, job, a.arg or "start")
        if a.arg in (None, "start") and "error" not in r:
            job["jira_started"] = True
        finish(ctx, {"ok": True, "job": job["id"], "jira": r}, job)


def cmd_jira_done(ctx, a):
    job = ctx.load(a.job)
    todo = job.get("jira_todo", [])
    known = {i["id"] for i in todo}
    unknown = [i for i in (a.ids or []) if i not in known]
    if unknown:
        raise FxError("unknown jira_todo ids: %s" % ", ".join(unknown))
    marked = []
    for it in todo:
        if not it.get("done") and (a.all or it["id"] in (a.ids or [])):
            it["done"] = ("failed: %s" % a.failed) if a.failed else "done"
            marked.append(it["id"])
    ctx.save(job, "jira todo %s %s" % (",".join(marked) or "-", "failed" if a.failed else "done"))
    res = {"ok": True, "job": job["id"], "marked": marked, "jira_todo": pending(job)}
    if job["stage"] in TERMINAL and not pending(job):
        jobs_after_step(ctx, res, [job["id"]])  # fx pr pushed it with this work still to do
    out(res)


def remote_provider(ctx, job, repo=None):
    """(provider, URL) of a repository of the job (its pr.provider, else read from its URL): repo, else a view's, else
    the job's first changed one."""
    name = repo or job.get("repo") or (job_primary(job) if isinstance(job.get("repos"), dict) else None)
    if name and name in ctx.repo_names():
        forced, url = ctx.rc(name, "pr.provider"), ctx.url(name)
    else:
        forced, url = ctx.c("pr.provider"), ctx.c("project.url") or ""
    if forced:
        return forced, url
    if "github.com" in url:
        return "github", url
    if "gitlab" in url:
        return "gitlab", url
    if "bitbucket.org" in url:
        return "bitbucket", url
    return "unknown", url


def section(md, title):
    m = re.search(r"(?ms)^##\s+%s[^\n]*\n(.*?)(?=^##\s|\Z)" % re.escape(title), md or "")
    return m.group(1).strip() if m else ""


def repo_section(md, name):
    """The text of a spec's `## Repo: <name>` part (that name exactly), or ''."""
    m = re.search(r"(?ms)^##\s+Repo:\s*%s\s*\n(.*?)(?=^##\s|\Z)" % re.escape(name), md or "")
    return m.group(1).strip() if m else ""


def pr_where(e):
    """Where a repository's change of the job is, for the other pull requests and the Jira comment."""
    if e.get("pr_url"):
        return e["pr_url"]
    return "branch `%s` into `%s`%s" % (e.get("branch"), e.get("target_branch") or e.get("base_branch"),
                                        "" if e.get("pushed_head") else " (not pushed yet)")


def pr_body(ctx, job, repo=None, links=None):
    """A pull request's description. In a job of several repositories, repo's: it lists the other repositories' pull
    requests (links: {name: where}, else what the job knows), and carries that repository's part of the spec."""
    jd = ctx.job_dir(job["id"])
    spec = read(os.path.join(jd, "spec.md"), "")
    decision = read(os.path.join(jd, "decision.md"), "")
    names = (list(links) if links else job_names(job, "change")) if is_whole_job(job) else []
    several = repo is not None and len(names) > 1
    e = job["repos"][repo] if repo is not None and is_whole_job(job) else job
    if job.get("issue_url"):
        parts = ["Jira: [%s](%s) %s" % (job["issue_key"], job["issue_url"], job.get("summary", "")), ""]
    else:
        parts = ["Local task %s: %s" % (job["issue_key"], job.get("summary", "")), ""]
    tb = e.get("target_branch") or e.get("base_branch")
    parts += ["Into `%s`, built from `%s`." % (tb, e.get("base_branch")), ""]
    if job.get("needs_human"):
        parts += ["> **Needs a human:** %s" % job.get("handoff_reason"), ""]
    if several:
        links = links or {}
        parts += ["## Pull requests of this issue", "",
                  "This issue changes %d repositories. Merge them in this order:" % len(names), ""]
        for i, n in enumerate(names, 1):
            where = "this pull request" if n == repo else links.get(n) or pr_where(job["repos"][n])
            parts.append("%d. %s: %s" % (i, n, where))
        parts.append("")
        mine = repo_section(spec, repo)
        if mine:
            parts += ["## This repository's part", "", mine, ""]
        contract = section(spec, "Shared contract")
        if contract:
            parts += ["## Shared contract", "", contract, ""]
    goal = section(spec, "Goal")
    if goal:
        parts += ["## Goal", "", goal, ""]
    ac = section(spec, "Acceptance criteria")
    if ac:
        parts += ["## Acceptance criteria", "", ac, ""]
    if decision and job.get("decision"):
        parts += ["## Approver: %s" % job["decision"], "", "\n".join(decision.splitlines()[1:]).strip(), ""]
    if job.get("reviews"):
        parts += ["## Reviews (round %d)" % job["round"], "", "| Reviewer | Verdict | Model |", "|---|---|---|"]
        for r, v in job["reviews"].items():
            parts.append("| %s | %s | %s |" % (r, v, job["models"].get(r, "-")))
        parts.append("")
    rdir = os.path.join(jd, "round-%d" % job["round"])
    ui_line = first_line(os.path.join(rdir, "ui.md"))
    sec_line = first_line(os.path.join(rdir, "security.md"))
    checks = []
    if ui_line:
        shots = len(os.listdir(os.path.join(rdir, "ui", "shots"))) if os.path.isdir(os.path.join(rdir, "ui", "shots")) else 0
        checks.append("- %s (%d screenshots in `jobs/%s/round-%d/ui/shots/` of the factory repository)" % (ui_line, shots, job["id"],
                                                                                        job["round"]))
    if sec_line:
        checks.append("- %s (`round-%d/security.md`)" % (sec_line, job["round"]))
    for sk in (job.get("security_skipped") or []) + (job.get("skipped_checks") or []):
        checks.append("- skipped: %s" % sk)
    if checks:
        parts += ["## Automated checks", ""] + checks + [""]
    bl = (job.get("baselines") or {}) if not several or repo == pr_baselines_repo(ctx, job) else {}
    if bl.get("changes_md"):
        parts += ["## Baselines changed", ""] + bl["changes_md"] + [""]
    if bl.get("unrecorded"):
        parts += ["Baseline files that differed from the list without being recorded were restored by the gate: %s."
                  % ", ".join("`%s`" % p for p in bl["unrecorded"][:10]), ""]
    lc = read(os.path.join(jd, "logic-changes.md"), "") or ""
    if lc.strip():
        parts += ["## Logic changes", "", lc.strip()[:4000], "",
                  "_The factory updates its logic/ folder once %s merged._" % (
                      "every pull request of this issue is" if several else "this pull request is"), ""]
    parts += ["Gate: %s. Rounds used: %d of %d. Risk: %s." % (
        job.get("gate"), rounds_used(job), job["max_rounds"], job.get("risk")), ""]
    if job.get("flags"):
        parts += ["Sensitive paths touched: " + ", ".join("`%s`" % f for f in job["flags"]), ""]
    parts += ["Job files: `jobs/%s/` in the factory repository on the machine that ran it." % job["id"], "",
              "_Generated by the software factory (Claude Code). A human reviews and merges._"]
    return "\n".join(parts) + "\n"


def pr_baselines_repo(ctx, job):
    """The repository of the job whose pull request tells of the baselines it changed: the one holding the list."""
    cfg = baselines_config(ctx)
    v = baselines_job(ctx, cfg, job) if cfg else None
    return (v or {}).get("repo")


def checks_env(ctx, job):
    """A checks script gets the job's id, its repository's port and its own database name, so parallel runs never share
    test data."""
    ctx, job = one_app(ctx, job)
    return project_env(ctx, FACTORY_JOB=job["id"], FACTORY_PORT=str(job["port"]), FACTORY_DB=app_db(ctx, job),
                       **baselines_env(ctx, job["worktree"]))


def run_checks(ctx, job, log_path, repo=None):
    """Run a repository's checks script in its clone (a whole job: repo, else its first changed one); return True when it
    passes. The baselines are made ready first when that repository holds their list."""
    bl_cfg = baselines_config(ctx)
    if bl_cfg and (repo is None or not is_whole_job(job) or pr_baselines_repo(ctx, job) == repo):
        ready, why = baselines_for_checks(ctx, bl_cfg, job)
        if not ready:
            write_atomic(log_path, why + "\n")
            return False
    ctx, job = one_app(ctx, job, repo)
    try:
        p = run(["bash", checks_script(ctx, job)], cwd=job["worktree"], check=False,
                timeout=int(ctx.c("gate_timeout_sec", 1800)), env=checks_env(ctx, job))
        output, ok = p.stdout or "", p.returncode == 0
    except subprocess.TimeoutExpired:
        output, ok = "%s timed out after %ss\n" % (os.path.relpath(checks_script(ctx, job), ctx.factory),
                                                   ctx.c("gate_timeout_sec", 1800)), False
    write_atomic(log_path, output)
    return ok


def mark_incomplete(job, reason):
    job["needs_human"] = True
    job["incomplete"] = True
    job["handoff_reason"] = job.get("handoff_reason") or reason


def host_repo_flag(provider, url):
    """gh --repo [HOST/]OWNER/NAME or glab -R GROUP/NAME (a full URL on another host than gitlab.com), from a
    repository's URL in factory.json: gh and glab never guess the repository from the clone's own remote, which the
    agents could point elsewhere. [] when the URL names no host (a local folder)."""
    u = (url or "").strip()
    if not u or os.path.isdir(os.path.expanduser(u)) or u.startswith("file:"):
        return []
    host, path = gitlab_project(u)
    if not host or not path or "/" not in path:
        return []
    if provider == "github":
        return ["--repo", path if host == "github.com" else "%s/%s" % (host, path)]
    if provider == "gitlab":
        return ["-R", path if host == "gitlab.com" else "https://%s/%s" % (host, path)]
    return []


def gh_existing_pr(branch, cwd, repo_flag=()):
    p = run(["gh", "pr", "view", branch, "--json", "url", "-q", ".url"] + list(repo_flag), cwd=cwd, check=False)
    url = (p.stdout or "").strip()
    return url if p.returncode == 0 and url.startswith("http") else None


def pr_targets(ctx, job, values):
    """--target per repository (name=branch, repeatable) or a plain --target branch for every changed one: {name:
    branch}. A repository not named keeps its earlier target, else the branch it started from."""
    names = job_names(job, "change")
    given = parse_bases(ctx, values, names, flag="--target")
    targets = {}
    for n in names:
        e = job["repos"][n]
        t = given.get(n) or given.get("*")
        if t:
            check_branch(ctx, t, "target", n)
        targets[n] = t or e.get("target_branch") or e["base_branch"]
    return targets


def pr_open(ctx, job, n, title, body, body_path, labels, draft, retarget, notes, where):
    """Open the pull request of one repository of the job, or update the one it has, with that repository's provider.
    Returns (pr_url, pr_hint)."""
    e = job["repos"][n]
    wt, branch, target = e["worktree"], e["branch"], e["target_branch"]
    nh_label = ctx.c("pr.needs_human_label")
    provider, url = remote_provider(ctx, job, n)
    rf = host_repo_flag(provider, url)
    pr_url, pr_hint = e.get("pr_url"), None
    if not ctx.c("pr.create", False):
        pr_hint = ("Branch %s%s pushed. Pull requests are opened by hand (pr.create is off): open one into %s when "
                   "you want." % (branch, " of %s" % n if where else "", target))
        notes.append(where + "pull request not opened: pr.create is off in %s" % CONFIG_NAME)
    elif provider == "github" and shutil.which("gh"):
        for l in labels:
            run(["gh", "label", "create", l, "--force"] + rf, cwd=wt, check=False)
        pr_url = pr_url or gh_existing_pr(branch, wt, rf)
        if pr_url:
            run(["gh", "pr", "edit", pr_url, "--title", title, "--body-file", body_path] +
                (["--base", target] if retarget else []) + rf, cwd=wt, check=False)
            run(["gh", "pr", "ready", pr_url] + (["--undo"] if draft else []) + rf, cwd=wt, check=False)
            if nh_label:
                flag = "--add-label" if job.get("needs_human") else "--remove-label"
                run(["gh", "pr", "edit", pr_url, flag, nh_label] + rf, cwd=wt, check=False)
            notes.append(where + "existing PR updated")
        else:
            base_cmd = ["gh", "pr", "create", "--base", target, "--head", branch,
                        "--title", title, "--body-file", body_path] + (["--draft"] if draft else []) + rf
            lab = sum([["--label", l] for l in labels], [])
            p = run(base_cmd + lab, cwd=wt, check=False)
            if p.returncode != 0 and lab:
                notes.append(where + "could not add labels; PR created without them")
                p = run(base_cmd, cwd=wt, check=False)
            if p.returncode != 0:
                pr_url = gh_existing_pr(branch, wt, rf)
                if not pr_url:
                    raise FxError("gh pr create failed%s:\n" % (" for %s" % n if where else "") + (p.stdout or ""))
            else:
                urls = re.findall(r"https://\S+", p.stdout or "")
                pr_url = urls[-1] if urls else gh_existing_pr(branch, wt, rf)
    elif provider == "gitlab" and shutil.which("glab"):
        iid = re.search(r"/merge_requests/(\d+)", pr_url or "")
        if iid:
            cmd = ["glab", "mr", "update", iid.group(1), "--title", title, "--description", body,
                   "--draft" if draft else "--ready"] + (["--target-branch", target] if retarget else []) + rf
            if nh_label:
                cmd += ["--label" if job.get("needs_human") else "--unlabel", nh_label]
            u = run(cmd, cwd=wt, check=False, timeout=120)
            notes.append(where + ("existing MR updated" if u.returncode == 0 else
                                  "MR got the new commits, but glab could not update its description: "
                                  + (u.stdout or "")[-200:].strip()))
        elif pr_url:
            notes.append(where + "MR updated by the push")
        else:
            cmd = ["glab", "mr", "create", "--source-branch", branch, "--target-branch",
                   target, "--title", ("Draft: " if draft else "") + title,
                   "--description", body, "--yes"] + rf
            if labels:
                cmd += ["--label", ",".join(labels)]
            p = run(cmd, cwd=wt, check=False)
            urls = re.findall(r"https://\S+", p.stdout or "")
            if p.returncode != 0 and not urls:
                v = run(["glab", "mr", "view", branch] + rf, cwd=wt, check=False)
                urls = re.findall(r"https://\S+/merge_requests/\d+", v.stdout or "")
                if not urls:
                    raise FxError("glab mr create failed%s:\n" % (" for %s" % n if where else "") + (p.stdout or ""))
            pr_url = urls[-1] if urls else None
    else:
        m = re.search(r"bitbucket\.org[:/]([^/]+)/([^/.]+)", url or "")
        if m:
            pr_hint = "https://bitbucket.org/%s/%s/pull-requests/new?source=%s&dest=%s" % (
                m.group(1), m.group(2), urllib.parse.quote(branch, safe=""), target)
        else:
            pr_hint = "Open a pull request from %s into %s%s (no gh/glab for %s)." % (
                branch, target, " in %s" % n if where else "", provider)
        notes.append(where + "PR not created automatically (%s); open it from the hint" % provider)
    return pr_url, pr_hint


def pr_write_links(ctx, job, n, body, body_path):
    """Give a repository's pull request its final description (fx pr's last phase, once every pull request of the job
    is known). Returns a note when the host refused."""
    e = job["repos"][n]
    provider, url = remote_provider(ctx, job, n)
    rf = host_repo_flag(provider, url)
    if provider == "github" and shutil.which("gh"):
        p = run(["gh", "pr", "edit", e["pr_url"], "--body-file", body_path] + rf, cwd=e["worktree"], check=False)
    elif provider == "gitlab" and shutil.which("glab") and re.search(r"/merge_requests/(\d+)", e["pr_url"]):
        iid = re.search(r"/merge_requests/(\d+)", e["pr_url"]).group(1)
        p = run(["glab", "mr", "update", iid, "--description", body] + rf, cwd=e["worktree"], check=False, timeout=120)
    else:
        return None
    if p.returncode != 0:
        return "%s: could not write the links to the other pull requests into %s: %s" % (
            n, e["pr_url"], (p.stdout or "")[-200:].strip())
    return None


def pr_text(ctx, job, n, work, hits):
    """A repository's pull request description, listing the repositories of work, scrubbed of secrets (their names go
    to hits)."""
    body, hit_b = scrub_text(ctx, pr_description(ctx, job, n, {m: None for m in work}))
    hits += hit_b
    return body


def cmd_pr(ctx, a):
    """Push the job and open its pull requests: in a job of several repositories, every changed one gets its own,
    linked to the others. Phase 1 makes every repository ready (left-over work, sync with its target, its checks, the
    secret scan) before anything is pushed anywhere; phase 2 pushes each one and opens or updates its pull request;
    phase 3 writes every description with the links to the others. Then one Jira comment and one transition. Safe to
    run again after a partial failure: a repository pushed and unchanged is not pushed again."""
    job = ctx.load(a.job)
    if job["stage"] != "pr":
        raise FxError("job is in stage %s, not pr" % job["stage"])
    names = job_names(job, "change")
    if not names:
        raise FxError("job %s changes no repository yet" % job["id"], code=3)
    several = len(names) > 1
    tag = (lambda n: "%s: " % n) if several else (lambda n: "")
    for n in names:
        wt = job["repos"][n].get("worktree")
        if not wt or not os.path.isdir(wt):
            raise FxError("the worktree %s%s is missing" % (wt, " of %s" % n if several else ""), code=3)
    given = summary_arg(ctx, a)
    remote = REMOTE
    jd = ctx.job_dir(job["id"])
    notes = []
    # The summary for people goes first in the pull request descriptions and in the Jira comment.
    summary = summary_to_use(ctx, job, "pr", given, notes)
    targets = pr_targets(ctx, job, getattr(a, "target", None))
    retarget, moved = {}, []
    for n in names:
        e = job["repos"][n]
        retarget[n] = bool(e.get("pr_url") and e.get("target_branch") and e["target_branch"] != targets[n])
        if e.get("target_branch") != targets[n]:
            e["target_branch"] = targets[n]
            moved.append("%s%s" % ("%s=" % n if several else "", targets[n]))
    if moved:
        ctx.save(job, "target branch %s" % ", ".join(moved))

    refusal = history_rewrites_text(ctx, job)
    for n in names:
        off = refusal or job_off_its_branch(repo_view(ctx, job, n))
        refusal = refusal or (off and tag(n) + off)
    if refusal:
        raise FxError(refusal, code=3)
    for n in names:
        job_base_from_remote(ctx, job, n)
    bl_cfg = baselines_config(ctx)
    if bl_cfg:
        notes += baselines_before_push(ctx, bl_cfg, job)
    # Phase 1, before anything is pushed. 1. Left-over work: never lose it, never block on it.
    dirt = {n: worktree_dirt(ctx, job["repos"][n]["worktree"], n) for n in names}
    for n in names:
        tracked, untracked = dirt[n]
        if tracked and not job.get("incomplete"):
            mark_incomplete(job, "uncommitted changes appeared after the gate")
    for n in names:
        wt = job["repos"][n]["worktree"]
        tracked, untracked = dirt[n]
        if tracked or (untracked and job.get("incomplete")):
            left = stage_work(ctx, wt, untracked, n)
            if left:
                notes.append(tag(n) + "local files not committed (copy_into_worktree, .env*): %s"
                             % ", ".join(sorted(set(left))[:10]))
            if git(["diff", "--cached", "--quiet"], wt, check=False).returncode != 0:
                git_job(["commit", "--no-verify", "-m", "%s: WIP (factory, incomplete)" % job["issue_key"]], wt)
                notes.append(tag(n) + "left-over changes committed as a WIP commit")
                ctx.save(job, "WIP committed" + (" in %s" % n if several else ""))
        elif untracked:
            notes.append(tag(n) + "untracked files in the job's clone (not part of the PR; the clone is kept so they "
                         "are not lost): %s" % ", ".join(untracked[:10]))

    # 2. Nothing on any branch: no PR, tell Jira, hand back. A repository with nothing of its own gets no PR.
    ahead = {n: git(["rev-list", "--count", "%s..HEAD" % job["repos"][n]["base_ref"]],
                    job["repos"][n]["worktree"]).stdout.strip() for n in names}
    work = [n for n in names if ahead[n] != "0"]
    if not work:
        mark_incomplete(job, "no commits on the branch")
        body = ("**Software factory stopped on %s without code changes.**\n\n- Reason: %s\n"
                "- Details: factory job files on the machine that ran it" % (job["issue_key"], job["handoff_reason"]))
        jira = {"comment": comment_for_people(ctx, job, summary, body, notes)}
        app_stop(ctx, job)
        clone = drop_clone(ctx, job)
        summary_done(job, "pr")
        ctx.move(job, "handed-off", "no commits; no PR")
        finish(ctx, {"ok": True, "job": job["id"], "pr_url": None, "pr_hint": None, "draft": False,
                     "needs_human": True, "reason": job["handoff_reason"], "jira": jira, "clone": clone,
                     "notes": notes + ["no commits beyond base, so no pull request was opened"],
                     "next": "done"}, job, push=True)
        return
    for n in names:
        if n not in work:
            notes.append("%s: no commits beyond its base, so nothing to push and no pull request" % n)

    # 3. Complete work: sync each repository with its target and make sure its checks pass on what will be pushed.
    complete = not job.get("incomplete")
    remotes = {n: remote in git(["remote"], job["repos"][n]["worktree"]).stdout.split() for n in work}
    for n in work:
        e = job["repos"][n]
        wt, target = e["worktree"], e["target_branch"]
        target_ref = "%s/%s" % (remote, target)
        if remotes[n] and target != e["base_branch"]:
            git(["fetch", "-q", git_url(ctx, n), "+refs/heads/%s:refs/remotes/%s/%s" % (target, remote, target)], wt,
                check=False)
            extra = git(["rev-list", "--count", "%s..%s" % (target_ref, e["base_ref"])], wt, check=False).stdout.strip()
            if extra and extra != "0":
                notes.append(tag(n) + "the work started from %s, which has %s commit(s) that %s does not: the pull "
                             "request into %s carries them too" % (e["base_branch"], extra, target, target))
        if not complete:
            continue
        if remotes[n]:
            git(["fetch", "-q", git_url(ctx, n), "+refs/heads/%s:refs/remotes/%s/%s" % (target, remote, target)], wt,
                check=False)
        mr = git_job(["merge", "--no-edit", target_ref], wt, check=False)
        if mr.returncode != 0:
            git_job(["merge", "--abort"], wt, check=False)
            mark_incomplete(job, "merge conflict with %s%s" % (target_ref, " in %s" % n if several else ""))
            notes.append(tag(n) + "merge conflict with the target branch %s; PR opened as draft" % target)
        else:
            head = git(["rev-parse", "HEAD"], wt).stdout.strip()
            if head != e.get("checks_passed_at"):
                log = os.path.join(jd, "final-checks-%s.log" % n if several else "final-checks.log")
                if run_checks(ctx, job, log, n):
                    e["checks_passed_at"] = head
                    notes.append(tag(n) + "synced with base; checks still pass")
                else:
                    mark_incomplete(job, "checks fail after merging the latest %s%s (%s)" % (
                        target_ref, " in %s" % n if several else "", os.path.basename(log)))
                    notes.append(tag(n) + "checks fail after syncing with base; PR opened as draft")
        ctx.save(job, "synced with base" + (" (%s)" % n if several else ""))
    draft = bool(job.get("incomplete") and ctx.c("pr.draft_when_incomplete", True))

    # 4. Never push a secret: scan the commits that would leave this machine, in every repository, before any push.
    secrets = {}
    for n in work:
        if not remotes[n]:
            continue
        found = pr_secret_scan(repo_ctx(ctx, n), repo_view(ctx, job, n), getattr(a, "no_secret_scan", False),
                               n if several else None)
        if found and isinstance(found[0], dict):
            secrets[n] = found
        else:
            notes += [tag(n) + f for f in found]
    if secrets:
        points = {n: unpushed_base(repo_view(ctx, job, n)) for n in secrets}
        report = {n: os.path.join(jd, "pr-scan", n, "security.md") if several else
                  os.path.join(jd, "pr-scan", "security.md") for n in secrets}
        for n in secrets:
            e = job["repos"][n]
            if e.get("secret_reset_to") == points[n] and e.get("secret_bounces", 0) >= 1:
                ctx.save(job, "secret still present after the builder's fix; nothing pushed")
                raise FxError("the branch%s still has secrets in its unpushed commits after the builder's attempt to "
                              "remove them (see %s). Nothing was pushed%s. Remove them by hand in %s (`git reset --soft "
                              "%s`, take them out, commit), then run `%s pr %s` again." % (
                                  " of %s" % n if several else "", report[n], " anywhere" if several else "",
                                  e["worktree"], points[n][:12], FX_CMD, job["id"]), code=3)
        # Nothing is pushed anywhere; the builder takes the secrets out of the unpushed history.
        for n in secrets:
            e = job["repos"][n]
            e["secret_bounces"] = e.get("secret_bounces", 0) + 1 if e.get("secret_reset_to") == points[n] else 1
            e["secret_reset_to"] = points[n]
        job.update(build_reason="secret", incomplete=False, needs_human=False, handoff_reason=None,
                   decision=None, reviews={}, gate=None)
        if rounds_left(job) <= 0:
            job["max_rounds"] = rounds_used(job) + 1
        if not (((job.get("people_summary") or {}).get("pr") or {}).get("posted")):
            summary_done(job, "pr", drop=True)  # it told of what was not pushed: the next push gets its own
        ctx.move(job, "build", "secret found before push%s; nothing pushed" % (
            " in %s" % ", ".join(secrets) if several else ""), force=True)
        res = {"ok": True, "job": job["id"], "pushed": False, "next": "build",
               "secrets": ["%s%s: %s" % (tag(n), f.get("location"), f.get("message"))
                           for n in secrets for f in secrets[n][:10]][:10],
               "report": report[next(iter(secrets))],
               "note": "nothing was pushed%s; the builder removes the secrets from the unpushed commits. Any real "
                       "credential must be rotated." % (" in any repository" if several else "")}
        if several:
            res.update(repos=list(secrets), reports=report)
        out(res)
        return

    # Phase 2. Push each repository (one pushed before and unchanged since is not pushed again), then its pull request.
    pushed = {}
    for n in work:
        e = job["repos"][n]
        wt = e["worktree"]
        if not remotes[n]:
            pushed[n] = False
            notes.append(tag(n) + "no remote %r; branch not pushed" % remote)
            continue
        head = git(["rev-parse", "HEAD"], wt).stdout.strip()
        url = git_url(ctx, n)  # factory.json's URL, whatever the clone's origin says now
        there = git(["ls-remote", url, "refs/heads/%s" % e["branch"]], wt, check=False).stdout.split()
        if several and e.get("pushed_head") == head and there[:1] == [head]:
            pushed[n] = True
            notes.append(tag(n) + "already pushed and unchanged: not pushed again")
            continue
        git_job(["push", url, "HEAD:refs/heads/%s" % e["branch"]], wt)
        # what -u did: the clone's own record of the remote branch, so later reads (unpushed work, rework) see the push
        git(["update-ref", "refs/remotes/%s/%s" % (remote, e["branch"]), head], wt, check=False)
        git(["branch", "-q", "--set-upstream-to=%s/%s" % (remote, e["branch"])], wt, check=False)
        pushed[n] = True
        e["pushed_head"] = head
        e.pop("secret_bounces", None)
        ctx.save(job, "pushed %s%s" % (head[:10], " (%s)" % n if several else ""))

    if not summary[0]:
        summary_done(job, "pr", drop=True)  # the summary of an earlier push does not tell of this one
    # The PR text leaves this machine: secrets the agents' reports may quote are redacted first.
    title, hit_t = scrub_text(ctx, "%s: %s" % (job["issue_key"], job.get("summary", "")))
    hits = list(hit_t) + list(summary[1])
    labels = list(ctx.c("pr.labels", []) or [])
    nh_label = ctx.c("pr.needs_human_label")
    if job.get("needs_human") and nh_label:
        labels.append(nh_label)
    create = bool(ctx.c("pr.create", False))
    body_file = (lambda n: os.path.join(jd, "pr-body-%s.md" % n)) if several else (
        lambda n: os.path.join(jd, "pr-body.md"))
    sent = {}
    for n in work:
        e = job["repos"][n]
        if not pushed[n]:
            continue
        body = pr_text(ctx, job, n, work, hits)
        write_atomic(body_file(n), body)
        sent[n] = body
        e["pr_url"], e["pr_hint"] = pr_open(repo_ctx(ctx, n), job, n, title, body, body_file(n), labels, draft,
                                            retarget[n], notes, tag(n))
        ctx.save(job, "PR %s%s" % (e["pr_url"] or e["pr_hint"] or "-", " (%s)" % n if several else ""))
    for n in work:
        if not pushed[n]:
            e = job["repos"][n]
            e["pr_hint"] = None
    # Phase 3. Every description lists the other repositories' pull requests (or branches), now all are known.
    bodies = {}
    for n in work:
        bodies[n] = pr_text(ctx, job, n, work, hits) if n not in sent or several else sent[n]
        if n in sent and bodies[n] != sent[n]:
            write_atomic(body_file(n), bodies[n])
            if job["repos"][n].get("pr_url"):
                bad = pr_write_links(repo_ctx(ctx, n), job, n, bodies[n], body_file(n))
                if bad:
                    notes.append(bad)
    body_path = os.path.join(jd, "pr-body.md")
    if several:
        md = []
        for n in work:
            md += ["## Repo: %s" % n, ""] + md_demote(bodies[n].splitlines()) + [""]
        write_atomic(body_path, "\n".join(md).rstrip("\n") + "\n")
    elif work[0] not in sent:
        write_atomic(body_path, bodies[work[0]])
    if hits:
        notes.append("possible secrets redacted from the pull request text (%s); check the job's reports"
                     % ", ".join(sorted(set(hits))))
    ctx.save(job)

    # Jira: one comment and one transition for the job, then hand over.
    def line(n):
        e = job["repos"][n]
        if create or e.get("pr_url") or not pushed[n]:
            return e.get("pr_url") or e.get("pr_hint") or "branch %s (not pushed)" % e["branch"]
        return None
    if several:
        lines = ["**Software factory: work ready for review**", "", "- Pull requests (merge them in this order):"]
        for n in work:
            e = job["repos"][n]
            lines.append("  - %s: %s (branch `%s` from `%s` into `%s`)" % (
                n, line(n) or "pushed; no pull request opened yet", e["branch"], e["base_branch"], e["target_branch"]))
    else:
        e = job["repos"][work[0]]
        lines = ["**Software factory: work ready for review**", "",
                 ("- Pull request: %s" % line(work[0])) if line(work[0]) else
                 "- Pushed to branch `%s`; no pull request opened yet" % e["branch"],
                 "- Branch: `%s` (from `%s`, into `%s`)" % (e["branch"], e["base_branch"], e["target_branch"])]
    lines += ["- Approver: %s" % (job.get("decision") or "-"),
              "- Gate: %s, rounds used %d of %d" % (job.get("gate"), rounds_used(job), job["max_rounds"])]
    if job.get("needs_human"):
        lines.append("- Needs a human: %s" % job.get("handoff_reason"))
    jira = {"transition": jira_move(ctx, job, "review")}
    jira["comment"] = comment_for_people(ctx, job, summary, "\n".join(lines), notes, say_missing=False)
    for what, r in jira.items():
        if "error" in r:
            notes.append("Jira %s failed: %s" % (what, r["error"]))
    if not summary[0]:
        went = "skipped" not in jira["comment"] and "error" not in jira["comment"]
        notes.append(SUMMARY_MISSING % ("the pull request description%s %s" % (
            "s" if several else "", "and the comment on %s have" % job["issue_key"] if went else
            "have" if several else "has")))
    app_stop(ctx, job)
    # The code is on the remotes now: the clones go, only when every repository was pushed (else they all stay).
    all_pushed = all(pushed.values())
    clone = drop_clone(ctx, job) if all_pushed else "kept: not pushed%s" % (
        " (%s)" % ", ".join(n for n in work if not pushed[n]) if several else "")
    summary_done(job, "pr")
    ctx.move(job, "handed-off", "handed off%s" % (" (draft)" if draft else ""))
    first = job["repos"][work[0]]
    res = {"ok": True, "job": job["id"], "pr_url": first.get("pr_url"), "pr_hint": first.get("pr_hint"),
           "pr_body": body_path, "draft": draft,
           "needs_human": job.get("needs_human"), "reason": job.get("handoff_reason"),
           "provider": remote_provider(ctx, job, work[0])[0], "jira": jira, "notes": notes, "clone": clone,
           "next": "done"}
    if several:
        res["repos"] = [{"name": n, "branch": job["repos"][n]["branch"], "target": job["repos"][n]["target_branch"],
                         "pushed": pushed.get(n, False), "pr_url": job["repos"][n].get("pr_url"),
                         "pr_hint": job["repos"][n].get("pr_hint"), "provider": remote_provider(ctx, job, n)[0],
                         "pr_body": body_file(n) if n in work else None} for n in names]
    finish(ctx, res, job, push=True)


def unpushed_base(job):
    """Where the commits that never left this machine start: the remote branch, or the merge-base."""
    wt = job["worktree"]
    r = git(["rev-parse", "--verify", "-q", "%s/%s" % (REMOTE, job["branch"])], wt, check=False)
    if r.returncode == 0 and is_ancestor(r.stdout.strip(), "HEAD", wt):
        return r.stdout.strip()
    return git(["merge-base", job["base_ref"], "HEAD"], wt, check=False).stdout.strip()


def pr_secret_scan(ctx, job, skip, sub=None):
    """The secret scan of a repository's unpushed commits before fx pr pushes them; its report in pr-scan/ of the job
    folder, or pr-scan/<sub>/ for one repository of several."""
    if not scanners_on(ctx)["gitleaks"]:
        # Only an explicit false turns it off (a factory.json without security.scanners scans as the template).
        return ["secret scan before push: turned off in factory.json (security.scanners.gitleaks is false)"]
    if skip:
        return ["secret scan skipped on request (--no-secret-scan)"]
    wt = job["worktree"]
    mb = git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
    rdir = os.path.join(ctx.job_dir(job["id"]), "pr-scan", *([sub] if sub else []))
    os.makedirs(rdir, exist_ok=True)
    leaks, err, note = scan_secrets(ctx, job, mb, rdir)
    if err:
        raise FxError("the secret scan before push failed (%s). Nothing was pushed. Check the branch by hand, "
                      "then run `%s pr %s --no-secret-scan`." % (err, FX_CMD, job["id"]), code=3)
    if leaks:
        write_atomic(os.path.join(rdir, "security.md"),
                     security_markdown({"findings": leaks, "blocking": leaks, "skipped": []}))
        return leaks
    return [note or "secret scan before push: clean"]


def repo_learn_state(job, name):
    """The learning cursors of a repository's pull request, in its entry of repos{}: the comments already read
    (comments), how far its branch's human edits were read (edits_seen), the ranges still to read (pending_edits), and
    final once its pull request is merged or closed and read. The job's own (factory findings, rework notes, logic) are
    its learn block (learn_state)."""
    st = job["repos"][name].setdefault("learn", {})
    for k in ("comments", "pending_edits"):
        st.setdefault(k, [])
    return st


REPO_LEARN_KEYS = ("comments", "pending_edits", "edits_seen")


def job_learn_split(job):
    """An older job kept the cursors of its one pull request in its learn block: they become its first changed
    repository's (in place)."""
    learn = job.get("learn")
    if not isinstance(learn, dict) or not any(k in learn for k in REPO_LEARN_KEYS):
        return job
    name = job_primary(job)
    if not name:
        return job
    st = job["repos"][name].setdefault("learn", {})
    for k in REPO_LEARN_KEYS:
        if k not in learn:
            continue
        v = learn.pop(k)
        if k == "edits_seen":
            st.setdefault(k, v)
        else:
            have = list(st.get(k) or [])
            st[k] = have + [x for x in v or [] if x not in have]
    return job


def take_remote_branch(ctx, job, wt, notes, repo=None):
    """Before a rework: include commits a human pushed to the PR branch, and remember them for learning."""
    e = job["repos"][repo] if repo else job
    if git(["fetch", "-q", git_url(ctx, repo or job_primary(job)), e["branch"]], wt, check=False).returncode != 0:
        return
    rh = git(["rev-parse", "FETCH_HEAD"], wt).stdout.strip()
    st = repo_learn_state(job, repo or job_primary(job))
    pushed = e.get("pushed_head")
    seen = st.get("edits_seen") if is_ancestor(pushed, st.get("edits_seen"), wt) else None
    start = seen or pushed
    where = " of %s" % repo if repo and len(job["repos"]) > 1 else ""
    if start and rh != start and is_ancestor(start, rh, wt):
        n = git(["rev-list", "--count", "--first-parent", "--no-merges", "%s..%s" % (start, rh)], wt).stdout.strip()
        st["pending_edits"].append([start, rh])
        st["edits_seen"] = rh
        notes.append("%s commit(s) pushed to the pull request branch%s by a human are included" % (n, where))
    lh = git(["rev-parse", "HEAD"], wt).stdout.strip()
    if rh == lh or is_ancestor(rh, lh, wt):
        return
    if git_job(["merge", "--no-edit", rh], wt, check=False).returncode != 0:
        git_job(["merge", "--abort"], wt, check=False)
        raise FxError("the pull request branch%s has commits that conflict with the job's unpushed commits in %s; "
                      "merge them by hand there, then run the rework again" % (where, wt), code=3)


def rework_clone(ctx, job, name, notes, heads):
    """A rework needs every clone of the job back: a changed repository's from its branch on the remote (or, never pushed,
    from its base again), a run-only one at its base."""
    e = job["repos"][name]
    wt = e.get("worktree") or job_clone_dir(ctx, job["id"], name)
    e["worktree"] = wt
    if os.path.isdir(wt):
        return
    if e.get("role") == "run":
        run_clone(ctx, wt, e.get("base_branch") or ctx.rc(name, "base_branch", "main"), name)
    elif e["branch"] in heads:
        job_clone(ctx, wt, e["branch"], repo=name)  # fresh clone of the branch as it is on the remote
    elif e.get("pushed_head"):
        raise FxError("the branch %s%s is not on the remote any more (merged and deleted?); start a new job instead" % (
            e["branch"], " of %s" % name if len(job["repos"]) > 1 else ""), code=3)
    else:
        job_clone(ctx, wt, e["branch"], start=e["base_ref"], repo=name)  # never pushed: start again from the base
    e["setup_done"] = False
    e.pop("clone_removed_at", None)
    if len(job["repos"]) == 1:
        notes.append("fresh clone of %s; run fx setup again" % e["branch"])
    else:
        notes.append("fresh clone of %s (%s); run fx setup again" % (
            name, e.get("branch") or "at %s" % e.get("base_branch")))


def rework_merged(ctx, job, name, rest, notes):
    """A repository whose pull request is merged takes no part in a rework: its work is in its base now. It runs from a
    checkout of its base when the app of another changed repository (rest) needs it, else it has no clone. Its pull
    request, branch and learning cursors stay in its entry, marked merged, so learning still reads them."""
    e = job["repos"][name]
    wt = e.get("worktree")
    if wt and os.path.isdir(wt):
        k, dirty = unsaved_work(ctx, job, wt, name)
        if k or dirty:
            raise FxError("the pull request of %s is merged, but its clone %s has work that is not on the remote (%s): "
                          "push it or discard it, then run the rework again" % (
                              name, wt, "%d commit(s)" % k if k else dirty.splitlines()[0]), code=3)
        shutil.rmtree(wt, ignore_errors=True)
    base = e.get("base_branch") or ctx.rc(name, "base_branch", "main")
    e.update(role="run", merged=now(), base_branch=base, base_ref="%s/%s" % (REMOTE, base), setup_done=False)
    e.pop("clone_removed_at", None)
    if name in needed_repos(ctx, rest):
        e["worktree"] = wt or job_clone_dir(ctx, job["id"], name)
        run_clone(ctx, e["worktree"], base, name)
        notes.append("%s: its pull request is merged, so this rework does not change it; it runs from its base %s for "
                     "the apps that need it" % (name, base))
    else:
        e["worktree"] = None
        notes.append("%s: its pull request is merged, so this rework does not change it" % name)


def cmd_rework(ctx, a):
    job = ctx.load(a.job)
    if job["stage"] != "handed-off":
        raise FxError("rework needs a handed-off job; %s is in stage %s" % (job["id"], job["stage"]))
    jd = ctx.job_dir(job["id"])
    notes = []
    # A pull request merged already (its branch maybe deleted after the merge): that repository is done.
    change = job_names(job, "change")
    merged = [n for n in change if (job["repos"][n].get("pushed_head") or job["repos"][n].get("pr_url"))
              and repo_merged(ctx, job, n) == "merged"]
    if merged and len(merged) == len(change):
        raise FxError("the pull request%s of %s %s merged: its work is in the base branch%s already. Start a new job "
                      "for what the human wants changed (/code-factory:factory new %s --again)" % (
                          "s" if len(merged) > 1 else "", job["id"], "are all" if len(merged) > 1 else "is",
                          "es" if len(merged) > 1 else "", job.get("issue_key") or job["id"]), code=3)
    for n in merged:
        rework_merged(ctx, job, n, [c for c in change if c not in merged], notes)
    k = 1
    while os.path.exists(os.path.join(jd, "rework-%d.md" % k)):
        k += 1
    # The previous attempt's results must not be mistaken for the new ones.
    arch = os.path.join(jd, "archive", "before-rework-%d" % k)
    for name in ("build.md", "decision.md", "pr-body.md"):
        if os.path.exists(os.path.join(jd, name)):
            os.makedirs(arch, exist_ok=True)
            os.replace(os.path.join(jd, name), os.path.join(arch, name))
    for n in job_clones(job):
        if not os.path.isdir(job["repos"][n].get("worktree") or ""):
            rework_clone(ctx, job, n, notes, remote_heads(ctx.url(n))[0] if job["repos"][n].get("role") == "change"
                         else {})
    for n in job_names(job, "change"):
        take_remote_branch(ctx, job, job["repos"][n]["worktree"], notes, repo=n)
    slot, port = free_slot(ctx, job["id"])
    if slot != job.get("slot"):
        notes.append("ports moved to %d-%d" % (port, port + ports_step(ctx) - 1))
    job["slot"], job["port"], job["port_span"] = slot, port, ports_step(ctx)
    path = os.path.join(jd, "rework-%d.md" % k)
    prs = [e.get("pr_url") or e.get("pr_hint") for e in (job["repos"][n] for n in job_names(job, "change"))]
    pr = ", ".join(p_ for p_ in prs if p_) or "-"
    write_atomic(path, "# Rework %d (%s)\n\nPull request: %s\n\n## What the human wants changed\n\n%s\n\n"
                       "## Review comments\n\nIf `gh` is available, also read the review comments on the pull "
                       "request: `gh pr view %s --comments`.\n" % (k, now()[:16], pr, a.note.strip(), pr))
    if (job.get("split") or {}).get("mode") == "split":
        for p_ in job["split"]["packages"].values():
            shutil.rmtree(p_.get("clone") or "", ignore_errors=True)
        job["split"] = {"mode": "single", "was": "split"}  # a rework is done by one builder on the whole
    job.update(round_start=job["round"], needs_human=False, incomplete=False, handoff_reason=None,
               decision=None, reviews={}, gate=None, builder_agent_id=None, builder_agent_model=None,
               build_reason="rework", skipped_checks=[], security_skipped=[], security_missed=[])
    ctx.move(job, "build", "rework %d" % k)
    out({"ok": True, "job": job["id"], "rework_file": path, "port": port, "notes": notes,
         "setup_needed": any(not job["repos"][n].get("setup_done") for n in job_clones(job)), "next": "build"})


