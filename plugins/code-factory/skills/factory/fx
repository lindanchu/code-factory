FINDING_RE = re.compile(r"^\s*\d+\.\s*\[blocking\]\s*(.+)$", re.I)
LESSONS_HEADER = ("# Lessons learned\n\nRules distilled from what reviewers caught in earlier factory jobs. "
                  "Every agent reads this before working: a rule's tags ([code], [test], [security], [ui], [data], "
                  "[spec]) say which agents get it; untagged rules go to all. Edit freely; keep each rule short and "
                  "general.\n")


def job_findings(ctx, job):
    jd = ctx.job_dir(job["id"])
    found = []
    for name in sorted(os.listdir(jd)):
        m = re.match(r"^round-(\d+)$", name)
        if not m:
            continue
        for f in sorted(os.listdir(os.path.join(jd, name))):
            r = re.match(r"^review-(\w+)\.md$", f)
            if not r:
                continue
            for line in (read(os.path.join(jd, name, f), "") or "").splitlines():
                fm = FINDING_RE.match(line)
                if fm:
                    found.append({"job": job["id"], "round": int(m.group(1)), "reviewer": r.group(1),
                                  "finding": fm.group(1).strip()})
        cm = os.path.join(jd, name, "checks.md")
        if first_line(cm) == "GATE: FAIL":
            prob = section(read(cm, ""), "Problems")
            if prob:
                found.append({"job": job["id"], "round": int(m.group(1)), "reviewer": "gate",
                              "finding": " ".join(prob.split())[:400]})
    return found


LESSON_ID_RE = re.compile(r"\[L(\d+)\]")
# Topic tags after a lesson's id, e.g. "- [L4] [code, test] ...": which agents read it. No tag = every agent.
LESSON_TOPICS = {
    "code": ("builder", "code", "judge", "approver"),
    "test": ("spec", "builder", "code", "judge"),
    "security": ("spec", "builder", "security", "verifier", "approver"),
    "ui": ("spec", "builder", "ux", "ui", "judge"),
    "data": ("spec", "builder", "code", "security", "verifier", "approver"),
    "spec": ("spec", "planner", "approver"),
    "all": (),
}
# The tag of lessons for reviews of merge requests, which a factory repository may also hold and code-factory does not
# handle. Whatever other tags such a lesson has, it reaches no agent here, and fx lessons leaves it as written.
REVIEW_TAG = "review"
LESSON_TAGS_RE = re.compile(r"^\[([a-z]+(?:\s*,\s*[a-z]+)*)\]\s+(.*)$")
LESSON_HOME = {"code": "style.md", "test": "testing.md", "security": "security.md", "ui": "ui.md",
               "data": "architecture.md", "spec": "rules.md"}


def lesson_tags(text):
    """(tags, rule without them) of a lesson's text."""
    m = LESSON_TAGS_RE.match(text or "")
    if not m:
        return [], text
    return [t.strip() for t in m.group(1).split(",") if t.strip()], m.group(2)


def lesson_text(text):
    """A lesson as written to the file: known tags normalised; unknown tags refused, and so is REVIEW_TAG."""
    text = " ".join(str(text).lstrip("-* ").split())
    tags, rule = lesson_tags(text)
    if REVIEW_TAG in tags:
        raise FxError("%r: [%s] lessons are for reviews of merge requests, which code-factory does not handle: it "
                      "never writes one" % (text[:80], REVIEW_TAG))
    bad = [t for t in tags if t not in LESSON_TOPICS]
    if bad:
        raise FxError("unknown lesson topic(s) %s in %r; use %s (or none for every agent)" % (
            ", ".join(bad), text[:80], ", ".join(LESSON_TOPICS)))
    return ("[%s] %s" % (", ".join(tags), rule)) if tags else rule
LESSON_LINE_RE = re.compile(r"^- (?:\[L(\d+)\]\s*)?(.*?)\s*(<!--.*?-->)?\s*$")
BOT_RE = re.compile(r"(\[bot\]$|-bot$|^bot$|^(github-actions|dependabot|renovate|codecov|sonarcloud|gitlab-bot)\b)", re.I)


def lesson_entries(text):
    """Top-level bullets of lessons.md: id (or None), text, added date, the line index."""
    out_ = []
    for i, line in enumerate((text or "").splitlines()):
        m = LESSON_LINE_RE.match(line)
        if not m or not m.group(2):
            continue
        meta = m.group(3) or ""
        d = re.search(r"(\d{4}-\d{2}-\d{2})", meta)
        jf = re.search(r"from ([A-Za-z0-9_\-]+(?:, *[A-Za-z0-9_\-]+)*)", meta)
        tags, rule = lesson_tags(m.group(2))
        out_.append({"id": ("L%s" % m.group(1)) if m.group(1) else None, "text": m.group(2), "tags": tags,
                     "rule": rule, "added": d.group(1) if d else None, "meta": meta, "line": i,
                     "jobs": [x.strip() for x in jf.group(1).split(",") if x.strip() not in ("", "-")] if jf else []})
    return out_


def lessons_write(path, add=None, replace=None, delete=None, jobs=None, raw=None):
    """Give every rule an id, apply replacements/deletions by id, append new rules with their origin. A [review] lesson
    (REVIEW_TAG) keeps its line exactly as written, with no id if it has none, and is never replaced or deleted."""
    text = read(path) or LESSONS_HEADER
    lines = text.splitlines()
    ents = lesson_entries(text)
    nxt = max([int(e["id"][1:]) for e in ents if e["id"]] or [0]) + 1
    replace = {k.upper(): v for k, v in (replace or {}).items()}
    delete = {d.upper() for d in (delete or [])}
    asked = sorted({e["id"] for e in ents if REVIEW_TAG in e["tags"]} & (set(replace) | delete))
    if asked:
        raise FxError("%s: [%s] lessons are for reviews of merge requests, which code-factory does not handle: it "
                      "leaves them as written" % (", ".join(asked), REVIEW_TAG))
    changed = {"added": [], "replaced": [], "deleted": []}
    drop = set()
    for e in ents:
        if REVIEW_TAG in e["tags"]:
            continue
        lid = e["id"]
        if not lid:
            lid = "L%d" % nxt
            nxt += 1
        if lid in delete:
            drop.add(e["line"])
            changed["deleted"].append(lid)
            continue
        body = e["text"]
        meta = e["meta"]
        if lid in replace:
            body = lesson_text(replace[lid])
            inner = meta[4:-3].strip() if meta else ""
            meta = "<!-- %sreworded %s -->" % (inner + "; " if inner else "", now()[:10])
            changed["replaced"].append(lid)
        lines[e["line"]] = ("- [%s] %s %s" % (lid, body, meta)).rstrip()
    lines = [l for i, l in enumerate(lines) if i not in drop]
    new = []
    for rule in add or []:
        rule = lesson_text(rule)
        if rule:
            lid = "L%d" % nxt
            nxt += 1
            new.append("- [%s] %s <!-- %s; from %s -->" % (lid, rule, now()[:10], ", ".join(jobs or []) or "-"))
            changed["added"].append(lid)
    out_text = "\n".join(lines).rstrip("\n") + "\n"
    if raw:
        # Free text from `lessons save`: rules get ids, everything else is kept as written.
        body = []
        for l in raw.splitlines():
            m = LESSON_LINE_RE.match(l)
            if m and m.group(2) and not m.group(1):
                body.append("- [L%d] %s <!-- %s; from %s -->" % (nxt, lesson_text(m.group(2)), now()[:10],
                                                                 ", ".join(jobs or []) or "-"))
                changed["added"].append("L%d" % nxt)
                nxt += 1
            elif m and REVIEW_TAG in lesson_tags(m.group(2))[0]:
                lesson_text(m.group(2))  # refuses it: kept as written, with its id, it would still be a new one
            else:
                body.append(l)
        new = body + new
    if new:
        out_text = out_text.rstrip("\n") + "\n\n## %s (from %s)\n\n%s\n" % (now()[:10], ", ".join(jobs or []) or "-",
                                                                         "\n".join(new))
    write_atomic(path, out_text)
    return changed


def learn_state(job):
    """The job's own learning cursors: factory findings read (factory), rework notes read (rework), the staged logic
    (logic), the lines humans changed (edit_lines), and final once every pull request is done with. Each pull
    request's are its repository's (repo_learn_state)."""
    st = job.setdefault("learn", {})
    if job.get("lessons_harvested"):
        st.setdefault("factory", True)
    st.setdefault("rework", [])
    return st


def is_ancestor(a, b, cwd):
    return bool(a and b) and git(["merge-base", "--is-ancestor", a, b], cwd, check=False).returncode == 0


def json_arrays(text):
    """gh api --paginate prints one JSON array per page back to back."""
    items, i, dec = [], 0, json.JSONDecoder()
    text = text or ""
    while True:
        j = text.find("[", i)
        if j < 0:
            return items
        try:
            v, end = dec.raw_decode(text[j:])
        except ValueError:
            return items
        if isinstance(v, list):
            items += v
        i = j + end


def human(author, body):
    return bool(body and str(body).strip()) and not BOT_RE.search(author or "") and \
        not str(body).lstrip().startswith("**Software factory")


def gitlab_project(url):
    """(host, group/project) of a GitLab URL: https://host/group/sub/app(.git), git@host:group/app.git, ssh://."""
    m = re.match(r"^(?:https?://|ssh://)?(?:[^@/]+@)?([^/:]+)(?::\d+)?[:/](.+?)(?:\.git)?/?$", (url or "").strip())
    return (m.group(1), m.group(2)) if m else (None, None)


def find_pr_url(ctx, job):
    """The PR/MR someone opened by hand from the job's branch, when gh/glab can find it."""
    if not job.get("pushed_head"):
        return None
    provider, url = remote_provider(ctx, job)
    if provider == "github" and shutil.which("gh"):
        m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url or "")
        if not m:
            return None
        p = run_sep(["gh", "pr", "list", "--repo", "%s/%s" % m.groups(), "--head", job["branch"], "--state", "all",
                     "--json", "url", "-q", ".[0].url"], cwd=ctx.factory, timeout=90)
        u = (p.stdout or "").strip()
        return u if p.returncode == 0 and u.startswith("http") else None
    if provider == "gitlab" and shutil.which("glab"):
        host, proj = gitlab_project(url)
        if not host:
            return None
        p = run_sep(["glab", "api", "--hostname", host, "projects/%s/merge_requests?source_branch=%s&state=all" % (
            urllib.parse.quote(proj, safe=""), urllib.parse.quote(job["branch"], safe=""))], cwd=ctx.factory,
            timeout=90)
        mrs = [x for x in json_arrays(p.stdout) if isinstance(x, dict) and x.get("web_url")]
        mrs.sort(key=lambda x: -int(x.get("iid") or 0))  # the newest MR of the branch
        return mrs[0]["web_url"] if p.returncode == 0 and mrs else None
    return None


def pr_feedback(ctx, job):
    """State, head commit and human comments of the job's PR/MR. Returns (info, why-not)."""
    url = job.get("pr_url")
    if not url:
        url = find_pr_url(ctx, job)
        if url:
            job["pr_url"] = url  # saved by the caller with the learning cursors
    if not url:
        return None, "no pull request found for the branch (not opened yet, or no gh/glab)"
    provider, _ = remote_provider(ctx, job)
    if provider == "github" and shutil.which("gh"):
        p = run_sep(["gh", "pr", "view", url, "--json", "state,headRefOid,number,reviews,comments"], cwd=ctx.factory,
                    timeout=90)
        d = first_json(p.stdout)
        if p.returncode != 0 or not d:
            return None, "gh pr view failed: %s" % (p.stderr or p.stdout or "")[-200:].strip()
        com = []
        for c in d.get("comments") or []:
            a = (c.get("author") or {}).get("login")
            if human(a, c.get("body")):
                com.append({"id": str(c.get("id") or c.get("url")), "author": a, "kind": "comment",
                            "body": c["body"][:1500]})
        for r in d.get("reviews") or []:
            a = (r.get("author") or {}).get("login")
            if human(a, r.get("body")):
                com.append({"id": str(r.get("id")), "author": a, "kind": "review (%s)" % r.get("state", "").lower(),
                            "body": r["body"][:1500]})
        m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
        if m:
            q = run_sep(["gh", "api", "--paginate", "repos/%s/%s/pulls/%s/comments" % m.groups()], cwd=ctx.factory,
                        timeout=90)
            for c in json_arrays(q.stdout):
                a = (c.get("user") or {}).get("login")
                if (c.get("user") or {}).get("type") != "Bot" and human(a, c.get("body")):
                    com.append({"id": str(c.get("id")), "author": a, "kind": "inline", "body": c["body"][:1500],
                                "path": c.get("path"), "line": c.get("line") or c.get("original_line")})
        return {"provider": "github", "state": str(d.get("state", "")).lower(), "head": d.get("headRefOid"),
                "fetch_ref": "pull/%s/head" % d.get("number") if d.get("number") else None, "comments": com}, None
    if provider == "gitlab" and shutil.which("glab"):
        m = re.search(r"https?://([^/]+)/(.+?)/-/merge_requests/(\d+)", url)
        if not m:
            return None, "cannot read the MR number from %s" % url
        host, proj, iid = m.group(1), urllib.parse.quote(m.group(2), safe=""), m.group(3)
        glab = ["glab", "api", "--hostname", host]
        p = run_sep(glab + ["projects/%s/merge_requests/%s" % (proj, iid)], cwd=ctx.factory, timeout=90)
        d = first_json(p.stdout)
        if p.returncode != 0 or not d:
            return None, "glab api failed: %s" % (p.stderr or p.stdout or "")[-200:].strip()
        q = run_sep(glab + ["--paginate", "projects/%s/merge_requests/%s/notes?per_page=100" % (proj, iid)],
                    cwd=ctx.factory, timeout=90)
        com = []
        for c in json_arrays(q.stdout):
            a = (c.get("author") or {}).get("username")
            if not c.get("system") and human(a, c.get("body")):
                pos = c.get("position") or {}
                com.append({"id": str(c.get("id")), "author": a, "kind": "inline" if pos else "comment",
                            "body": c["body"][:1500], "path": pos.get("new_path"), "line": pos.get("new_line")})
        st = {"opened": "open", "merged": "merged", "closed": "closed", "locked": "closed"}.get(d.get("state"), "open")
        return {"provider": "gitlab", "state": st, "head": d.get("sha"),
                "fetch_ref": "merge-requests/%s/head" % iid, "comments": com}, None
    return None, "no gh/glab to read %s pull requests" % provider


def have_commit(ctx, sha, refs):
    if git(["cat-file", "-e", "%s^{commit}" % sha], ctx.git(), check=False).returncode == 0:
        return True
    for ref in refs:
        if ref and git(["fetch", "-q", REMOTE, ref], ctx.git(), check=False).returncode == 0 and \
                git(["cat-file", "-e", "%s^{commit}" % sha], ctx.git(), check=False).returncode == 0:
            return True
    return False


def human_edits(ctx, job, info, st):
    """Commits a human pushed to the PR branch after the factory's last push (the corrections)."""
    pushed = job.get("pushed_head")
    if not pushed:
        return None, "no record of the factory's last push (job from an older version)"
    head = (info or {}).get("head")
    if not head:
        f = git(["fetch", "-q", REMOTE, job["branch"]], ctx.git(), check=False)
        if f.returncode != 0:
            return None, "the PR branch is gone from the remote and no gh/glab can name its head"
        head = git(["rev-parse", "FETCH_HEAD"], ctx.git()).stdout.strip()
    elif not have_commit(ctx, head, [(info or {}).get("fetch_ref"), head, job["branch"]]):
        return None, "cannot fetch the PR head %s" % head[:10]
    seen = st.get("edits_seen")
    start = seen if seen and is_ancestor(pushed, seen, ctx.git()) else pushed
    ranges = [r for r in st.get("pending_edits") or []]
    if head != start and is_ancestor(start, head, ctx.git()):
        ranges.append([start, head])
    commits, patch = [], []
    for a, b in ranges:
        log = git(["log", "--first-parent", "--no-merges", "--format=%H%x09%an%x09%s", "%s..%s" % (a, b)],
                  ctx.git(), check=False).stdout
        for line in log.splitlines():
            parts = line.split("\t", 2)
            if len(parts) < 3:
                continue
            commits.append({"sha": parts[0][:10], "author": parts[1], "subject": parts[2]})
            patch.append(git(["show", "--format=commit %h %an: %s", "-U2", parts[0]], ctx.git(), check=False).stdout)
    res = {"commits": commits, "head": head, "ranges": ranges, "seen_before": st.get("edits_seen")}
    if commits:
        full = "\n".join(patch)
        pf = os.path.join(ctx.job_dir(job["id"]), "learn", "human-edits-%s.patch" % head[:10])
        write_atomic(pf, full)
        lines_ = full.splitlines()
        lim = int(ctx.c("learning.edit_excerpt_lines", 300))
        res.update(patch_file=pf, lines_changed=sum(1 for l in lines_ if l[:1] in "+-" and l[:3] not in ("+++", "---")),
                   excerpt="\n".join(lines_[:lim]) + ("\n… (%d more lines in the patch file)" % (len(lines_) - lim)
                                                      if len(lines_) > lim else ""))
    return res, None


def rework_notes(ctx, job, st):
    jd = ctx.job_dir(job["id"])
    found, k = [], 1
    while os.path.exists(os.path.join(jd, "rework-%d.md" % k)):
        if k not in st["rework"]:
            txt = section(read(os.path.join(jd, "rework-%d.md" % k), ""), "What the human wants changed")
            if txt:
                found.append({"k": k, "text": txt[:3000]})
        k += 1
    return found


def collect_job(ctx, job, src):
    """What a handed-off job has to teach: the factory's findings and the rework notes (the job's), and for each
    repository it changed, its pull request's comments and the commits humans pushed to its branch. Returns (item,
    cursors, has anything). In a job of several repositories, each comment and each set of edits names its repository."""
    st = learn_state(job)
    names = job_pr_names(job)
    several = len(names) > 1
    item = {"job": job["id"], "issue": job["issue_key"], "summary": job.get("summary"),
            "pr": job.get("pr_url") or job.get("pr_hint"), "notes": []}
    if several:
        item["prs"] = {n: job["repos"][n].get("pr_url") or job["repos"][n].get("pr_hint") for n in names}
    cur = {"repos": {}}
    if src.get("factory_reviews", True) and not st.get("factory"):
        item["factory_findings"] = job_findings(ctx, job)
        cur["factory"] = True
    if src.get("rework_notes", True):
        rw = rework_notes(ctx, job, st)
        if rw:
            item["rework_notes"] = rw
            cur["rework"] = [r["k"] for r in rw]
    finals = []
    for n in names:
        e = job["repos"][n]
        rst = repo_learn_state(job, n)
        if not (e.get("pushed_head") or e.get("pr_url")) and several:
            continue  # nothing of this repository ever left the machine
        if rst.get("final"):
            finals.append(True)
            continue
        rcur = {}
        cur["repos"][n] = rcur
        tag = "%s: " % n if several else ""
        rctx, v = repo_ctx(ctx, n), repo_view(ctx, job, n)
        info = None
        if src.get("pr_comments", True) or src.get("human_edits", True):
            info, why = pr_feedback(rctx, v)
            if v.get("pr_url") and v["pr_url"] != e.get("pr_url"):
                e["pr_url"] = v["pr_url"]  # a pull request someone opened by hand: saved with the cursors
                if several:
                    item["prs"][n] = v["pr_url"]
                else:
                    item["pr"] = v["pr_url"]
            if why:
                item["notes"].append(tag + why)
            if info:
                if several:
                    item.setdefault("pr_states", {})[n] = info["state"]
                else:
                    item["pr_state"] = info["state"]
        if info and src.get("pr_comments", True):
            new = [c for c in info["comments"] if c["id"] not in rst["comments"]]
            if new:
                item.setdefault("pr_comments", []).extend([dict(c, repo=n) for c in new] if several else new)
                rcur["comments"] = [c["id"] for c in new]
        if src.get("human_edits", True) and (info or not v.get("pr_url")):
            ed, why = human_edits(rctx, v, info, rst)
            if why:
                item["notes"].append(tag + "human edits: " + why)
            elif ed:
                rcur["edits_seen"] = ed["head"]
                rcur["edit_ranges"] = ed["ranges"]
                rcur["seen_before"] = ed["seen_before"]
                if ed["commits"]:
                    got = {k: ed[k] for k in ("commits", "patch_file", "lines_changed", "excerpt")}
                    if several:
                        item.setdefault("human_edits", []).append(dict(got, repo=n))
                    else:
                        item["human_edits"] = got
                    rcur["edit_lines"] = ed["lines_changed"]
        # A merged or closed PR with nothing left to read is done for good.
        rcur["final"] = bool(info and info["state"] in ("merged", "closed"))
        finals.append(rcur["final"])
    cur["final"] = bool(finals) and all(finals)
    has = any(item.get(k) for k in ("factory_findings", "rework_notes", "pr_comments", "human_edits"))
    return item, cur, has


def learn_dir(ctx):
    return os.path.join(ctx.jobs, "_learn")


def lessons_collect(ctx):
    src = ctx.c("learning.sources", {}) or {}
    cutoff = time.time() - 86400 * int(ctx.c("learning.lookback_days", 60))
    items, cursors, scanned = [], {}, 0
    jobs = []
    for jid in ctx.list_ids():
        try:
            jobs.append(ctx.load_exact(jid))
        except (FxError, ValueError):
            continue
    jobs.sort(key=lambda j: j.get("created_at", ""), reverse=True)  # the newest first: the cap drops old ones
    for j in jobs:
        jid = j["id"]
        st = learn_state(j)
        if j.get("stage") != "handed-off" or st.get("final"):
            continue
        try:
            created = _dt.datetime.fromisoformat(j.get("created_at", "")[:19]).timestamp()
        except ValueError:
            created = time.time()
        if created < cutoff and st.get("factory"):
            continue
        scanned += 1
        if scanned > int(ctx.c("learning.max_jobs", 30)):
            break
        known = {n: j["repos"][n].get("pr_url") for n in job_pr_names(j)}
        item, cur, has = collect_job(ctx, j, src)
        found = ["%s%s" % ("%s: " % n if len(known) > 1 else "", j["repos"][n]["pr_url"]) for n in known
                 if j["repos"][n].get("pr_url") and not known[n]]
        if found:  # a pull request someone opened by hand from the branch
            ctx.save(j, "pull request found: %s" % ", ".join(found))
        cursors[jid] = cur
        if has:
            items.append(item)
        else:
            apply_cursor(ctx, jid, cur)  # nothing to learn, but remember how far we looked
    path = os.path.join(learn_dir(ctx), "pending.json")
    try:
        before = json.loads(read(path, "{}") or "{}")
    except ValueError:
        before = {}
    # Entries under _reviews/ are the learning of merge-request review, which code-factory does not handle: they stay.
    kept = {k: v for k, v in before.items() if str(k).startswith(REVIEW_DIR + "/")} if isinstance(before, dict) else {}
    write_atomic(path, json.dumps(dict(kept, **cursors), indent=1))
    return items


def apply_cursor(ctx, jid, cur):
    try:
        j = ctx.load_exact(jid)
    except (FxError, ValueError):
        return
    st = learn_state(j)
    if cur.get("factory"):
        st["factory"] = True
        j["lessons_harvested"] = True
    st["rework"] = sorted(set(st["rework"]) | set(cur.get("rework") or []))
    reps = cur.get("repos")
    if not isinstance(reps, dict):  # a cursor of an older fx: its one pull request's, at the top
        reps = {job_primary(j): cur} if job_primary(j) else {}
    for n, rc in reps.items():
        if n not in j["repos"] or not isinstance(rc, dict):
            continue
        rst = repo_learn_state(j, n)
        rst["comments"] = rst["comments"] + [c for c in rc.get("comments") or [] if c not in rst["comments"]]
        if rc.get("edits_seen"):
            read_ = [list(r) for r in rc.get("edit_ranges") or []]
            # Drop what was read, and any range a rework recorded meanwhile that ends where this read ended.
            rst["pending_edits"] = [r for r in rst["pending_edits"] if list(r) not in read_ and r[1] != rc["edits_seen"]]
            if rst.get("edits_seen") in (rc.get("seen_before"), rc["edits_seen"]) or not rst.get("edits_seen"):
                rst["edits_seen"] = rc["edits_seen"]  # unless a rework moved it on since the read
        if rc.get("edit_lines"):
            st["edit_lines"] = st.get("edit_lines", 0) + rc["edit_lines"]
        if rc.get("final"):
            rst["final"] = True
    if cur.get("final"):
        st["final"] = True
    ctx.save(j, "learning harvested")


def git_has(ctx, token):
    """Does a base branch still have this file or symbol? A repo:path[:lines] token asks that repository; any other, in a
    project of several repositories, any of them. (True when it cannot tell.)"""
    names = ctx.repo_names()
    m = re.match(r"^([a-z][a-z0-9-]{0,30}):(.+)$", token)
    if m and m.group(1) in names:
        return repo_git_has(repo_ctx(ctx, m.group(1)), re.sub(r":\d+(-\d+)?$", "", m.group(2)))
    if len(names) > 1:
        return any(repo_git_has(repo_ctx(ctx, n), token) for n in names)
    return repo_git_has(ctx, token)


def repo_git_has(ctx, token):
    """git_has for one repository: ctx is the factory's ctx of a project of one, or a RepoCtx."""
    ref = "refs/heads/%s" % ctx.c("base_branch", "main")
    if git(["rev-parse", "--verify", "--quiet", ref], ctx.git(), check=False).returncode != 0:
        return True
    if "/" in token or re.search(r"\.(md|py|js|mjs|ts|tsx|jsx|vue|svelte|php|rb|go|rs|java|kt|cs|json|ya?ml|toml|"
                                  r"sql|html|css|scss|sh|xml|env|ini|cfg|lock|txt)$", token):
        t = token.lstrip("./")
        if git(["cat-file", "-e", "%s:%s" % (ref, t)], ctx.git(), check=False).returncode == 0:
            return True
        names = git(["ls-tree", "-r", "--name-only", ref], ctx.git(), check=False).stdout.splitlines()
        if any(n.endswith(t) or fnmatch.fnmatch(n, "*" + t) for n in names):
            return True
    code = ctx.code()
    if not code:
        return True
    word = re.sub(r"\(.*$", "", token)
    return git(["grep", "-q", "-F", "-e", word], code, check=False).returncode == 0


def learning_stats(ctx):
    """How the factory is doing over time, and which lessons do not seem to work."""
    rows = []
    for jid in ctx.list_ids():
        try:
            j = ctx.load_exact(jid)
        except (FxError, ValueError):
            continue
        if j.get("stage") not in ("handed-off",):
            continue
        f = job_findings(ctx, j)
        k = 0
        while os.path.exists(os.path.join(ctx.job_dir(jid), "rework-%d.md" % (k + 1))):
            k += 1
        rows.append({"job": jid, "created": j.get("created_at", ""), "rounds": rounds_used(j),
                     "blocking": len([x for x in f if x["reviewer"] != "gate"]),
                     "gate_fails": len([x for x in f if x["reviewer"] == "gate"]), "reworks": k,
                     "human_edit_lines": (j.get("learn") or {}).get("edit_lines", 0),
                     "findings": f})
    rows.sort(key=lambda r: r["created"])

    def avg(rs, key):
        return round(sum(r[key] for r in rs) / len(rs), 2) if rs else None
    recent, before = rows[-10:], rows[-20:-10]
    trend = {"jobs": len(rows)}
    for key in ("rounds", "blocking", "gate_fails", "reworks", "human_edit_lines"):
        trend[key] = {"last_10": avg(recent, key), "previous_10": avg(before, key)}
    path = os.path.join(ctx.factory, "lessons.md")
    final = {}
    for jid in ctx.list_ids():
        try:
            final[jid] = bool((ctx.load_exact(jid).get("learn") or {}).get("final"))
        except (FxError, ValueError):
            pass
    lessons = []
    for e in lesson_entries(read(path, "") or ""):
        if REVIEW_TAG in e["tags"]:
            continue  # for reviews of merge requests: not counted, reworded, removed or moved from here
        hits = []
        for r in rows:
            if e["added"] and r["created"][:10] < e["added"]:
                continue
            for x in r["findings"]:
                if e["id"] and ("[%s]" % e["id"]) in x["finding"]:
                    hits.append("%s round %d (%s)" % (r["job"], x["round"], x["reviewer"]))
        refs = [t for t in re.findall(r"`([^`\s]{3,80})`", e["text"]) if re.match(r"^[\w./:\-()]+$", t)]
        # A lesson from a job whose pull request is still open may name code the base branch does not have yet.
        settled = all(final.get(j, True) for j in e["jobs"])
        missing = [t for t in refs if not git_has(ctx, t)] if settled else []
        seen = len([r for r in rows if e["added"] and r["created"][:10] >= e["added"]])
        lessons.append({"id": e["id"], "text": e["text"], "tags": e["tags"], "added": e["added"],
                        "violations": hits, "jobs_since": seen, "missing_refs": missing})
    cap = int(ctx.c("learning.max_lessons", 40) or 40)
    after = int(ctx.c("learning.graduate_after_jobs", 10) or 10)
    kdir = knowledge_dir(ctx)

    def home(lesson):
        """The knowledge file a lesson would move into (relative to knowledge/). A repository's own file only when the
        lesson names that repository (repo:path), or the project has one."""
        named = [n for n in ctx.repo_names() if re.search(r"`%s:" % re.escape(n), lesson["text"])]
        repo = named[0] if len(named) == 1 else ctx.repo_names()[0] if len(ctx.repos) == 1 else None
        for f in [LESSON_HOME[t] for t in lesson["tags"] if t in LESSON_HOME] + ["conventions.md", "rules.md",
                                                                                 "style.md"]:
            rel = knowledge_rel(ctx, f, repo) if repo or f not in REPO_KNOWLEDGE else None
            if rel and os.path.exists(os.path.join(kdir, rel)):
                return rel
        return None
    graduate = [{"id": l["id"], "jobs_since": l["jobs_since"], "to": home(l)} for l in lessons
                if l["id"] and not l["violations"] and not l["missing_refs"] and l["jobs_since"] >= after
                and home(l)]
    return {"trend": trend, "lessons": lessons, "count": len(lessons), "max_lessons": cap,
            "over_limit": len(lessons) > cap, "untagged": [l["id"] for l in lessons if l["id"] and not l["tags"]],
            "graduate": graduate,
            "repeat_offenders": [l["id"] for l in lessons if len(l["violations"]) >= 2],
            "maybe_obsolete": [l["id"] for l in lessons if l["missing_refs"]]}


def lessons_graduate(ctx, path, raw):
    """Move stable lessons into the knowledge file that fits ({"L12": "style.md"}, or "<repo>/style.md" for a
    repository's own), then delete them here."""
    try:
        req = json.loads(raw or "{}")
    except ValueError as e:
        raise FxError("lessons graduate reads JSON on stdin, for example {\"L12\": \"style.md\"}: %s" % e)
    ents = {e["id"]: e for e in lesson_entries(read(path, "") or "") if e["id"]}
    kdir = knowledge_dir(ctx)
    plan = []
    known = md_files(kdir) + ["%s/%s" % (n, f) for n in ctx.repo_names() for f in md_files(os.path.join(kdir, n))]
    for lid, fname in (req or {}).items():
        lid, fname = lid.upper(), posixpath.normpath(str(fname).replace("\\", "/"))
        if fname.startswith("knowledge/"):
            fname = fname[len("knowledge/"):]
        if lid not in ents:
            raise FxError("no lesson %s in %s" % (lid, path))
        if REVIEW_TAG in ents[lid]["tags"]:
            raise FxError("%s: [%s] lessons are for reviews of merge requests, which code-factory does not handle: "
                          "they never move into the knowledge" % (lid, REVIEW_TAG))
        if fname not in known:
            raise FxError("knowledge/%s does not exist; pick one of: %s" % (fname, ", ".join(known)))
        plan.append((lid, fname))
    moved = []
    for lid, fname in plan:
        target = os.path.join(kdir, fname)
        text = read(target, "") or ""
        line = "- %s (lesson %s, %s)" % (ents[lid]["rule"], lid, now()[:10])
        head = "## Learned from jobs"
        i = text.find("\n" + head)
        if i < 0:
            text = text.rstrip("\n") + "\n\n" + head + "\n\n" + line + "\n"
        else:
            j = text.find("\n## ", i + 1)
            j = len(text) if j < 0 else j
            text = text[:j].rstrip("\n") + "\n" + line + "\n" + text[j:]
        write_atomic(target, text)
        moved.append({"id": lid, "to": "knowledge/" + fname})
    changed = lessons_write(path, delete=[m["id"] for m in moved]) if moved else {}
    return {"ok": True, "graduated": moved, "changed": changed,
            "next": "run fx knowledge check (the moved rules must pass it), then remind the user to commit "
                    "lessons.md and knowledge/"}


def cmd_lessons(ctx, a):
    path = os.path.join(ctx.factory, "lessons.md")
    if a.action == "collect":
        items = lessons_collect(ctx)
        findings = [f for it in items for f in it.get("factory_findings") or []]
        stats = learning_stats(ctx)
        out({"ok": True, "jobs": [it["job"] for it in items], "items": items, "findings": findings,
             "stats": stats, "lessons_file": path, "existing": lessons_kept(read(path, "") or "")[0],
             "next": ("draft lesson changes (new rules from the human's corrections and repeated findings, rewordings "
                      "for repeat offenders, removals for obsolete ones, moves of stable lessons into the knowledge, "
                      "and merges when over the limit), ask the human about each change, one at a time, then fx "
                      "lessons update / graduate"
                      if items or stats["repeat_offenders"] or stats["maybe_obsolete"] or stats["graduate"]
                      or stats["over_limit"] else "nothing new to learn")})
        return
    if a.action == "stats":
        out(dict(ok=True, **learning_stats(ctx)))
        return
    if a.action == "graduate":
        out(lessons_graduate(ctx, path, sys.stdin.read()))
        return
    jobs = [x.strip() for x in (a.jobs or "").split(",") if x.strip()]
    for jid in jobs:
        refuse_review(jid, jobs=ctx.jobs)
    changed = {}
    if a.action == "save":
        text = sys.stdin.read().strip()
        if text:
            changed = lessons_write(path, jobs=jobs, raw=text)
    elif a.action == "update":
        try:
            req = json.loads(sys.stdin.read() or "{}")
        except ValueError as e:
            raise FxError("lessons update reads JSON on stdin: %s" % e)
        if req.get("add") or req.get("replace") or req.get("delete") or os.path.exists(path):
            changed = lessons_write(path, add=req.get("add"), replace=req.get("replace"), delete=req.get("delete"),
                                    jobs=jobs)
    try:
        pend = json.loads(read(os.path.join(learn_dir(ctx), "pending.json"), "{}") or "{}")
    except ValueError:
        pend = {}
    for jid in jobs:
        apply_cursor(ctx, jid, pend.get(jid) or {"factory": True})
    out({"ok": True, "lessons_file": path if os.path.exists(path) else None, "marked": jobs, "changed": changed})


