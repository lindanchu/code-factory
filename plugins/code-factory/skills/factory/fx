def manifest_declares_dependencies(name, text):
    """A pyproject.toml may hold only tool settings, and a package.json only scripts. In doubt, it does."""
    if name == "pyproject.toml":
        text = re.sub(r"(?m)#.*$", "", text)
        return bool(re.search(r"dependenc", re.sub(r"(?m)^\s*dependencies\s*=\s*\[\s*\]", "", text)))
    if name in ("package.json", "composer.json"):
        try:
            data = json.loads(text)
        except ValueError:
            return True
        if not isinstance(data, dict):
            return True
        if name == "composer.json":
            return any(not isinstance(data.get(k), dict) and data.get(k) or manifest_dependencies(name, text)
                       for k in ("require", "require-dev"))
        return any(data.get(k) for k in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"))
    return True


def path_glob(path, pattern):
    """A glob for paths: * and ? stay inside one folder, ** crosses them."""
    rx, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            rx, i = rx + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            rx, i = rx + ".*", i + 2
        elif pattern[i] in "*?":
            rx, i = rx + ("[^/]*" if pattern[i] == "*" else "[^/]"), i + 1
        else:
            rx, i = rx + re.escape(pattern[i]), i + 1
    return bool(re.fullmatch(rx, path))


def workspace_members(name, text):
    """The folders a workspace file names."""
    if name == "package.json":
        try:
            found = json.loads(text).get("workspaces") or []
        except (ValueError, AttributeError):
            return []
        return (found.get("packages") or []) if isinstance(found, dict) else found
    if name == "pnpm-workspace.yaml":
        return re.findall(r"(?m)^\s*-\s*['\"]?([^'\"#\s]+)", text)
    m = re.search(r"(?s)\bmembers\s*=\s*\[(.*?)\]", text)
    return re.findall(r"['\"]([^'\"]+)['\"]", m.group(1)) if m else []


def plain_git(wt, *args):
    """What a commit holds, whatever refs/replace in the clone says."""
    return git(["--no-replace-objects"] + list(args), wt, check=False).stdout or ""


def lock_above_covers(wt, rev, folder, manifest, have):
    """A lockfile in a folder above only speaks for a manifest that folder's workspace names."""
    name = posixpath.basename(manifest)
    if name.startswith("build.gradle"):
        return any(posixpath.join(folder, n) in have for n in ("settings.gradle", "settings.gradle.kts"))
    below = posixpath.relpath(posixpath.dirname(manifest), folder or ".")
    for owner in ([name, "pnpm-workspace.yaml"] if name == "package.json" else [name]):
        path = posixpath.join(folder, owner)
        if path in have and any(path_glob(below, posixpath.normpath(str(g))) for g in workspace_members(
                owner, plain_git(wt, "show", "%s:%s" % (rev, path)))):
            return True
    return False


def manifest_locks(wt, rev, manifest, usable, have):
    """Which of the lockfiles in usable speak for a manifest: those next to it, or in the nearest folder above whose
    workspace names it."""
    locks = OSV_LOCKS[posixpath.basename(manifest)]
    d = own = posixpath.dirname(manifest)
    while True:
        found = [posixpath.join(d, n) for n in locks if posixpath.join(d, n) in usable]
        if found and (d == own or lock_above_covers(wt, rev, d, manifest, have)):
            return found
        if not d:
            return []
        d = posixpath.dirname(d)


def unlocked_manifests(wt, rev="HEAD", read=None):
    """Manifests at a commit that declare dependencies osv-scanner cannot see, for want of a lockfile; outside test code,
    examples and vendored folders. read: the files osv-scanner got packages from, when a scan is at hand; a lockfile it
    got nothing from (emptied, broken, a symlink) is no lockfile."""
    files = [f for f in plain_git(wt, "ls-tree", "-r", "--name-only", "-z", rev).split("\0") if f]
    have, found = set(files), []
    usable = have if read is None else have & read
    for f in files:
        name = posixpath.basename(f)
        locks = OSV_LOCKS.get(name)
        folders = f.split("/")[:-1]
        if not locks or set(folders) & (SKIP_DIRS | MANIFEST_NOT_THE_PROJECT) or TEST_PATH_RE.search(f):
            continue
        if not manifest_locks(wt, rev, f, usable, have) and \
                manifest_declares_dependencies(name, plain_git(wt, "show", "%s:%s" % (rev, f))):
            found.append(f)
    return found


def manifest_dependencies(name, text):
    """What a manifest asks an installer to fetch. Not a package.json's peers, which not every lockfile lists, nor a
    composer.json's php, ext-* and lib-*, which belong to the machine: real Composer packages are vendor/name."""
    try:
        data = json.loads(text)
    except ValueError:
        return {}
    keys = ("require", "require-dev") if name == "composer.json" else (
        "dependencies", "devDependencies", "optionalDependencies")
    out = {}
    for k in keys:
        if isinstance(data, dict) and isinstance(data.get(k), dict):
            out.update({n: v for n, v in data[k].items() if name != "composer.json" or "/" in n})
    return out


LOCAL_SPEC_RE = re.compile(r"(?:file|link|workspace|portal):|\.{0,2}/")
GIT_HOSTS = {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org"}


def git_repo_name(text):
    """host/owner/name when text names a git repository, in the forms a package.json or osv-scanner has; else None."""
    text = text.strip().split("#")[0]
    m = re.match(r"(github|gitlab|bitbucket):(.+)$", text)
    if m:
        found = "%s/%s" % (GIT_HOSTS[m.group(1)], m.group(2))
    elif re.fullmatch(r"[\w.\-]+/[\w.\-]+", text):  # npm's short form for GitHub
        found = "github.com/" + text
    else:
        m = re.match(r"(git\+)?(?:ssh|https?|git)://(?:[^@/]+@)?([^/:]+)(?::\d+)?[/:](.+)$", text) or \
            re.match(r"()[^@/\s]+@([^:/\s]+):(.+)$", text)
        # A plain https URL is a tarball, unless it says otherwise.
        if not m or (text.startswith("http") and not text.endswith(".git") and "github.com/" not in text):
            return None
        found = "%s/%s" % (m.group(2), m.group(3))
    return re.sub(r"\.git$", "", found.rstrip("/")).lower()


def dependency_identity(dep, spec):
    """What a package.json dependency really is, as osv-scanner would list it: the package an alias points to, or the
    repository of a git dependency. None for what is on this machine, which no lockfile needs to vouch for."""
    spec = str(spec)
    if LOCAL_SPEC_RE.match(spec):
        return None
    alias = re.match(r"npm:(@?[^@]+)", spec)
    return alias.group(1).lower() if alias else git_repo_name(spec) or dep.lower()


def lock_provides(text):
    """What a composer.lock's packages stand in for (provide, replace): a package may ask for those by name."""
    try:
        data = json.loads(text)
    except ValueError:
        return set()
    found = set()
    for pkg in (data.get("packages") or []) + (data.get("packages-dev") or []) if isinstance(data, dict) else []:
        for key in ("provide", "replace"):
            found.update(n.lower() for n in (pkg.get(key) or {}))
    return found


def manifests_ahead_of_their_lock(wt, mb, packages):
    """{manifest: names}: what a job added to a package.json or composer.json, or pointed an existing name at, that no
    lockfile speaking for it lists, so osv-scanner never sees it. By what it is, not by version: a wider range adds nothing,
    and having touched some lockfile proves nothing. packages: what osv-scanner read from each file."""
    changed = [f for f in plain_git(wt, "diff", "--no-renames", "--name-only", "-z", mb, "HEAD").split("\0") if f]
    have = {f for f in plain_git(wt, "ls-tree", "-r", "--name-only", "-z", "HEAD").split("\0") if f}
    found = {}
    for f in changed:
        name = posixpath.basename(f)
        if name not in ("package.json", "composer.json") or f not in have or \
                set(f.split("/")[:-1]) & (SKIP_DIRS | MANIFEST_NOT_THE_PROJECT) or TEST_PATH_RE.search(f):
            continue
        composer = name == "composer.json"
        identity = (lambda dep, spec: dep.lower()) if composer else dependency_identity
        before = manifest_dependencies(name, plain_git(wt, "show", "%s:%s" % (mb, f)))
        after = manifest_dependencies(name, plain_git(wt, "show", "HEAD:%s" % f))
        had = {identity(d, v) for d, v in before.items()}
        locks = manifest_locks(wt, "HEAD", f, set(packages), have)
        listed = set()
        for lock in locks:
            listed |= {git_repo_name(n) if "://" in n else n for n in packages[lock]}
        missing = []
        for dep, spec in sorted(after.items()):
            what = identity(dep, spec)
            # A new name may be listed as itself. An old name now pointing elsewhere must be listed as what it points to.
            if what and what not in had and what not in listed and (dep in before or dep.lower() not in listed):
                missing.append(dep)
        if missing and composer:  # asked only when something is missing: most jobs never read these
            for lock in locks:
                listed |= lock_provides(plain_git(wt, "show", "HEAD:%s" % lock))
            own = json.loads(plain_git(wt, "show", "HEAD:%s" % f))
            listed |= {n.lower() for key in ("provide", "replace") for n in (own.get(key) or {})}
            missing = [d for d in missing if d.lower() not in listed]
        elif missing:  # a workspace's own package, which a lockfile may only link to
            local = set()
            for other in have:
                if posixpath.basename(other) == "package.json" and not set(other.split("/")[:-1]) & (SKIP_DIRS | MANIFEST_NOT_THE_PROJECT):
                    try:
                        local.add(json.loads(plain_git(wt, "show", "HEAD:%s" % other)).get("name"))
                    except (ValueError, AttributeError):
                        pass
            missing = [d for d in missing if d not in local]
        if missing:
            found[f] = missing
    return found


def export_commit(ctx, wt, rev, dest):
    """The files of a commit as they are stored: not what setup installed or the job left out of git, and whatever the clone
    says, because the builder writes it. A checkout obeys .gitattributes and .git (they re-encode files, and a filter runs
    code), git archive obeys export-ignore, and refs/replace swaps objects. A symlink has nothing to read. Returns an error
    or None."""
    env = project_env(ctx, GIT_NO_REPLACE_OBJECTS="1")
    ls = subprocess.run(["git", "ls-tree", "-r", "-l", "-z", rev], cwd=wt, env=env, stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL, timeout=600)
    if ls.returncode != 0:
        return "could not read %s" % rev
    todo = []
    for item in ls.stdout.split(b"\0"):
        meta, _, raw = item.partition(b"\t")
        fields = meta.split()
        name = os.fsdecode(raw)
        parts = name.split("/")
        if len(fields) != 4 or fields[1] != b"blob" or fields[0] == b"120000" or ".." in parts or ".git" in parts or \
                name.startswith("/") or int(fields[3]) > EXPORT_MAX_BYTES:
            continue
        todo.append((fields[2], name))
    cat = subprocess.Popen(["git", "cat-file", "--batch"], cwd=wt, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL)
    try:
        for sha, name in todo:
            cat.stdin.write(sha + b"\n")
            cat.stdin.flush()
            head = cat.stdout.readline().split()
            if len(head) != 3:
                return "could not read %s" % name
            data = cat.stdout.read(int(head[2]))
            cat.stdout.read(1)
            target = os.path.join(dest, *name.split("/"))
            try:
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with open(target, "wb") as f:
                    f.write(data)
            except OSError as e:  # a name this machine refuses, or a full disk: never a clean scan of less than was asked
                return "could not write %r here, so it cannot be scanned: %s" % (name, e.strerror)
    finally:
        cat.stdin.close()
        cat.stdout.close()
        cat.wait(timeout=60)
    return None


def osv_packages(data, root):
    """{file: package names}, for the files osv-scanner got packages from, relative to the folder it scanned."""
    found = {}
    for res in (data or {}).get("results", []) or []:
        if res.get("packages"):
            found.setdefault(osv_relative(((res.get("source") or {}).get("path")) or "", root), set()).update(
                str((p.get("package") or {}).get("name")).lower() for p in res["packages"])
    return found


def osv_relative(src, root):
    real, top = os.path.realpath(src), os.path.realpath(root) if root else None
    rel = os.path.relpath(real, top) if top and real.startswith(top + os.sep) else os.path.basename(src)
    return rel.replace(os.sep, "/")


def osv_vulns(data, root=None):
    """{(id, package, version, file): finding}, one for each file it is in: accepting it for one must not hide another, and
    a job that brings it to a new place brought it. root: the folder that was scanned; a path inside it is then named from
    there."""
    out_ = {}
    for res in (data or {}).get("results", []) or []:
        rel = osv_relative(((res.get("source") or {}).get("path")) or "", root)
        for pk in res.get("packages", []) or []:
            pkg = pk.get("package") or {}
            sev_by_id = {}
            for g in pk.get("groups", []) or []:
                sv = sev_from_cvss(g.get("max_severity"))
                for i in g.get("ids", []) or []:
                    sev_by_id[i] = sv
            for v in pk.get("vulnerabilities", []) or []:
                rated = (v.get("database_specific") or {}).get("severity")
                sv = sev_by_id.get(v.get("id")) or (
                    sev_word(rated) if rated and str(rated).lower() != "unknown" else None)
                key = (v.get("id"), pkg.get("name"), pkg.get("version"), rel)
                # A known vulnerability nobody has rated yet counts as serious until someone says otherwise.
                out_[key] = {"tool": "osv", "severity": sv or "high", "rule": v.get("id"), "path": rel,
                             "location": "%s %s@%s (%s)" % (rel, pkg.get("name"),
                                                            pkg.get("version"), pkg.get("ecosystem")),
                             "message": (v.get("summary") or v.get("details") or "")[:200] +
                             ("" if sv else " (no severity rating yet: treated as high)"),
                             "owasp": "A03:2025 Software Supply Chain Failures", "cwe": "CWE-1395"}
    return out_


def osv_config(ctx, tmp):
    """security.osv_config from the factory repository, else an empty config (no ignored vulnerabilities)."""
    cfg = ctx.c("security.osv_config")
    if cfg:
        path = os.path.join(ctx.factory, os.path.expanduser(cfg))
        return (path, None) if os.path.isfile(path) else \
            (None, "security.osv_config %s is not a file in the factory repository" % cfg)
    path = os.path.join(tmp, "osv-scanner.toml")
    write_atomic(path, "# fx: no ignored vulnerabilities\n")
    return path, None


def scan_osv(ctx, job, mb, rdir, notes=None):
    """Known-vulnerable dependencies in what is committed, compared with the base (without mb, all of them). A manifest
    whose dependencies osv-scanner cannot read is never a clean result: when the job caused that it is a finding of its
    own; otherwise it fails the scan when nothing could be read, and is a note when something could."""
    notes = notes if notes is not None else []
    wt = job["worktree"]
    own = tempfile.mkdtemp(prefix="fx-osv-cfg-")
    here = tempfile.mkdtemp(prefix="fx-osv-head-")
    tmp = tempfile.mkdtemp(prefix="fx-osv-base-")
    env = project_env(ctx)
    base, berr, caused, ahead = {}, None, [], {}
    try:
        cfg, err = osv_config(ctx, own)
        if err:
            return None, err
        err = export_commit(ctx, wt, "HEAD", here)
        if err:
            return None, "osv-scanner: %s" % err
        head, err = osv_scan_dir(here, cfg, env)
        if err:
            return None, err
        packages = osv_packages(head, here)
        unlocked = unlocked_manifests(wt, "HEAD", set(packages))
        if mb:
            berr = export_commit(ctx, wt, mb, tmp)
            if not berr:
                base, berr = osv_scan_dir(tmp, cfg, env)
            caused = sorted(set(unlocked) - set(unlocked_manifests(wt, mb, None if berr else set(osv_packages(base, tmp)))))
            ahead = manifests_ahead_of_their_lock(wt, mb, packages)
        older = [m for m in unlocked if m not in caused]
        if older and head.get("no_sources"):
            return None, ("osv-scanner read no dependencies: %s ha%s no lockfile it can read. Commit one so they can be "
                          "checked, or take osv out of security.required to accept that they are not" % (
                              ", ".join(older[:5]), "s" if len(older) == 1 else "ve"))
        if older:
            notes.append("osv-scanner: no lockfile it can read for %s, so those dependencies went unchecked"
                         % ", ".join(older[:10]))
        if head.get("unscannable"):
            notes.append("osv-scanner: %d package(s) went unchecked: no exact version to look up (unpinned or local)"
                         % head["unscannable"])
    finally:
        for folder in (tmp, here, own):
            shutil.rmtree(folder, ignore_errors=True)
    hv = osv_vulns(head, here)
    write_atomic(os.path.join(rdir, "osv.json"), json.dumps(head, indent=1))
    found = [{"tool": "osv", "severity": "high", "new": True, "rule": "osv-no-lockfile", "location": m, "path": m,
              "message": "this job leaves %s with no lockfile osv-scanner can read, so its dependencies cannot be checked: "
                         "commit one" % m,
              "owasp": "A03:2025 Software Supply Chain Failures", "cwe": "CWE-1395"} for m in caused]
    found += [{"tool": "osv", "severity": "high", "new": True, "rule": "osv-lock-stale", "location": m, "path": m,
               "message": "this job adds %s to %s, but no lockfile for it lists %s, so osv-scanner cannot see %s: update the "
                          "lockfile" % (", ".join(ahead[m][:5]), m, "that" if len(ahead[m]) == 1 else "them",
                                        "it" if len(ahead[m]) == 1 else "them"),
               "owasp": "A03:2025 Software Supply Chain Failures", "cwe": "CWE-1395"} for m in sorted(ahead) if m not in caused]
    base_keys = None if berr else {(b[0], b[1], b[3]) for b in osv_vulns(base or {}, tmp)}
    for k, v in hv.items():
        # Without a base scan we cannot tell new from old: report, do not block.
        v["new"] = (base_keys is not None) and (k[0], k[1], k[3]) not in base_keys
        if base_keys is None:
            v["note"] = "base scan failed (%s): not compared" % berr
        found.append(v)
    return found, None


SEC_HEADERS = [
    ("content-security-policy", "Content-Security-Policy missing", "CWE-693"),
    ("x-content-type-options", "X-Content-Type-Options: nosniff missing", "CWE-693"),
    ("referrer-policy", "Referrer-Policy missing", "CWE-200"),
]


CORS_PROBE = "https://fx-cors-check.invalid"  # an origin no real app trusts


def scan_headers(ctx, job, url):
    req = urllib.request.Request(url, method="GET", headers={"Origin": CORS_PROBE})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            headers = resp.headers
    except urllib.error.HTTPError as e:
        headers = e.headers
    except Exception as e:  # noqa: BLE001
        return None, "headers check could not reach %s: %s" % (url, e)
    found = []
    low = {k.lower(): v for k, v in headers.items()}
    for h, msg, cwe in SEC_HEADERS:
        if h not in low:
            found.append({"tool": "headers", "severity": "medium", "rule": h, "location": url, "message": msg,
                          "cwe": cwe, "owasp": "A02:2025 Security Misconfiguration"})
    if "x-frame-options" not in low and "frame-ancestors" not in low.get("content-security-policy", ""):
        found.append({"tool": "headers", "severity": "medium", "rule": "clickjacking", "location": url,
                      "message": "no X-Frame-Options or CSP frame-ancestors (clickjacking)", "cwe": "CWE-1021",
                      "owasp": "A02:2025 Security Misconfiguration"})
    https = url.startswith("https:")
    if https and "strict-transport-security" not in low:
        found.append({"tool": "headers", "severity": "medium", "rule": "hsts", "location": url,
                      "message": "Strict-Transport-Security missing", "cwe": "CWE-319",
                      "owasp": "A04:2025 Cryptographic Failures"})
    allow = low.get("access-control-allow-origin", "").strip()
    if allow == CORS_PROBE:
        creds = low.get("access-control-allow-credentials", "").strip().lower() == "true"
        found.append({"tool": "headers", "severity": "high" if creds else "medium", "rule": "cors-any-origin",
                      "location": url, "cwe": "CWE-942", "owasp": "A02:2025 Security Misconfiguration",
                      "message": "CORS allows any origin it is sent%s" % (", with credentials" if creds else "")})
    elif allow == "*":
        found.append({"tool": "headers", "severity": "low", "rule": "cors-wildcard", "location": url,
                      "message": "Access-Control-Allow-Origin: * (fine only for public data)", "cwe": "CWE-942",
                      "owasp": "A02:2025 Security Misconfiguration"})
    for h in ("server", "x-powered-by"):
        if h == "x-powered-by" and h in low or re.search(r"\d", low.get(h, "")):
            found.append({"tool": "headers", "severity": "low", "rule": "version-leak", "location": url,
                          "message": "the %s header says what runs here" % h, "cwe": "CWE-200",
                          "owasp": "A02:2025 Security Misconfiguration"})
    for c in headers.get_all("Set-Cookie") or []:
        name = c.split("=", 1)[0].strip()
        flags = c.lower()
        missing = [f for f, need in (("httponly", True), ("samesite", True), ("secure", https)) if need and f not in flags]
        if missing:
            found.append({"tool": "headers", "severity": "medium", "rule": "cookie-flags", "location": url,
                          "message": "cookie %s without %s" % (name, ", ".join(missing)), "cwe": "CWE-1004",
                          "owasp": "A02:2025 Security Misconfiguration"})
    for f in found:  # so a human can accept one for a path, as with ZAP
        f["paths"] = [urllib.parse.urlparse(url).path or "/"]
    return found, None


ZAP_IMAGE = "ghcr.io/zaproxy/zaproxy:stable"
ZAP_NOT_THE_PROJECT = {"10106"}  # "HTTP Only Site": fx itself runs the app over plain HTTP on this machine
SCAN_VERSION = 3  # raise it when the running-app scans start to look for more: older baselines then stop counting


def zap_image_note(image):
    """A note when the ZAP image is a moving tag rather than pinned by digest (name@sha256:…)."""
    if re.search(r"@sha256:[0-9a-f]{64}$", image or ""):
        return None
    return ("zap: the image %s is a moving tag; pin it in security.zap_image as name@sha256:<digest> (`docker pull "
            "%s`, then `docker inspect --format '{{index .RepoDigests 0}}' %s`)" % (image, image, image))


def zap_network(url):
    """Docker flags and target URL that let the ZAP container reach the job's app on this machine, without the
    host network: host.docker.internal everywhere (on Linux through --add-host …:host-gateway). On Linux an app
    that listens on 127.0.0.1 only is not reachable that way; then ZAP falls back to the host network, with a
    note. Returns (flags, target, note)."""
    target = re.sub(r"//(127\.0\.0\.1|localhost)([:/]|$)", r"//host.docker.internal\2", url)
    if not sys.platform.startswith("linux"):
        return [], target, None
    flags = ["--add-host", "host.docker.internal:host-gateway"]
    p = urllib.parse.urlparse(url)
    r = run(["docker", "network", "inspect", "bridge", "--format", "{{(index .IPAM.Config 0).Gateway}}"],
            check=False, timeout=60)
    gw = (r.stdout or "").strip() if r.returncode == 0 else ""
    try:
        socket.create_connection((gw, p.port or 80), timeout=3).close()
        return flags, target, None
    except (OSError, ValueError):
        return ["--network", "host"], url, ("zap: the app listens on 127.0.0.1 only, so ZAP used the host network; "
                                            "let app.up listen on 0.0.0.0 (or the Docker bridge) to avoid that")


def zap_mode(ctx):
    """security.zap_mode: baseline only watches the traffic; full also attacks the app (SQL injection, XSS and the
    like), so the app must not point at a database anyone cares about. Full is only ever chosen by a human."""
    return "full" if str(ctx.c("security.zap_mode", "baseline")).strip().lower() == "full" else "baseline"


def zap_runs(ctx, target):
    """The ZAP scripts to run: (report name, script, arguments). Both modes also crawl with a real browser, so pages
    a script draws are seen too, and use the rules ZAP still calls alpha."""
    full = zap_mode(ctx) == "full"
    limit = ["-z", "-config scanner.maxScanDurationInMins=%d" % zap_minutes(ctx)] if full else []
    runs = [("zap", "zap-full-scan.py" if full else "zap-baseline.py",
             ["-t", target, "-a", "-j"] + (["-m", "2"] if full else []) + limit)]
    spec = ctx.c("security.zap_openapi")
    if spec:
        p = urllib.parse.urlparse(target)
        runs.append(("zap-api", "zap-api-scan.py",
                     ["-t", "%s://%s/%s" % (p.scheme, p.netloc, spec.lstrip("/")), "-f", "openapi", "-a",
                      "-O", "%s://%s" % (p.scheme, p.netloc)] + (limit if full else ["-S"])))
    return runs


def zap_minutes(ctx):
    return int(ctx.c("security.zap_minutes", 20) or 20)


def zap_auth(ctx, job):
    """security.zap_auth: the header that lets ZAP past the login. Its command prints the value (a test account's
    token or cookie) once the app runs. Returns (header, value, error)."""
    auth = ctx.c("security.zap_auth") or {}
    if not auth.get("command"):
        return None, None, None
    env, db = app_env(ctx, job)
    why = "security.zap_auth.command printed no value, so ZAP would only see pages that need no login"
    try:
        r = run_sep(["bash", "-lc", app_fill(auth["command"], job, db)], cwd=job["worktree"], env=env, timeout=120)
    except subprocess.TimeoutExpired:
        return None, None, why
    lines = (r.stdout or "").strip().splitlines()
    if r.returncode != 0 or not lines:
        return None, None, why
    return auth.get("header") or "Authorization", lines[-1].strip(), None


ZAP_LIBRARY_RULE = "zap-10003"
ZAP_LIBRARY_RE = re.compile(r"(?i)the identified library (\S+), version (\S+) is vulnerable")


def zap_libraries(alert):
    """Which libraries a Vulnerable JS Library alert is about, as name@version: ZAP gives them all one name, and a bundle
    that holds one is renamed by every build. In ZAP's own words, or failing those what it matched."""
    found = set()
    for i in alert.get("instances") or []:
        m = ZAP_LIBRARY_RE.search(str(i.get("otherinfo") or ""))
        found.add("%s@%s" % (m.group(1).lower(), m.group(2)) if m else str(i.get("evidence") or "").strip())
    return found - {""}


def scan_zap(ctx, job, url, rdir, notes=None, image=None):
    """image: which image to run, when not the one security.zap_image names."""
    image = image or ctx.c("security.zap_image", ZAP_IMAGE) or ZAP_IMAGE
    notes = notes if notes is not None else []
    os.makedirs(rdir, exist_ok=True)
    header, token, err = zap_auth(ctx, job)
    if err:
        return None, err
    flags, target, note = zap_network(url)
    if note:
        notes.append(note)
    cmd, env = ["docker", "run", "--rm", "-v", "%s:/zap/wrk/:rw" % rdir], None
    if token:  # by name: the value stays out of the command line, and only the container gets it
        cmd += ["-e", "ZAP_AUTH_HEADER", "-e", "ZAP_AUTH_HEADER_VALUE", "-e", "ZAP_AUTH_HEADER_SITE"]
        # Without a site ZAP adds the header to every request, and its browser also fetches fonts and CDN scripts.
        env = dict(os.environ, ZAP_AUTH_HEADER=header, ZAP_AUTH_HEADER_VALUE=token,
                   ZAP_AUTH_HEADER_SITE=urllib.parse.urlparse(target).hostname or "")
    home = hasattr(os, "getuid")
    if home:
        # The container runs as this user, so its report lands in rdir without opening rdir to everyone. That uid has
        # no passwd entry in the image, so Java cannot find a home for ZAP: give it a copy of the image's own, and a
        # folder of its own to start from (the scripts write there).
        cmd += ["--user", "%d:%d" % (os.getuid(), os.getgid()), "-e", "HOME=/tmp",
                "-e", "JAVA_TOOL_OPTIONS=-Duser.home=/tmp/zap-user"]
    else:
        os.chmod(rdir, 0o777)  # no uid to run as: the ZAP container writes its report as its own user
    found = {}
    for name, script, args in zap_runs(ctx, target):
        start = [script]
        if home:
            start = ["sh", "-c", 'mkdir -p /tmp/zap-user && cp -R /home/zap/.ZAP /tmp/zap-user/.ZAP && '
                                 'cd /tmp/zap-user && exec %s "$@"' % script, "sh"]
        report = os.path.join(rdir, name + ".json")
        if os.path.exists(report):
            os.remove(report)
        try:
            r = run(cmd + flags + [image] + start + args + ["-J", name + ".json", "-I"], check=False, env=env,
                    timeout=max(1800, (zap_minutes(ctx) + 10) * 60))
        except subprocess.TimeoutExpired:
            return None, "ZAP timed out (%s)" % script
        text = read(report, "") or ""
        log = r.stdout or ""
        if token:
            text, log = text.replace(token, REDACTED), log.replace(token, REDACTED)
            if text:
                write_atomic(report, text)
        write_atomic(os.path.join(rdir, name + ".log"), log)
        try:
            data = json.loads(text)
        except ValueError:
            return None, "ZAP produced no report (see %s.log)" % name
        for site in data.get("site", []) or []:
            for al in site.get("alerts", []) or []:
                if str(al.get("pluginid")) in ZAP_NOT_THE_PROJECT:
                    continue
                sv = {"3": "high", "2": "medium", "1": "low", "0": "info"}.get(str(al.get("riskcode")), "medium")
                uris = sorted({i.get("uri") for i in al.get("instances") or [] if i.get("uri")})
                # ZAP rates each library by itself, under one name: a library does not take on another's severity.
                key = ("zap-%s" % al.get("pluginid"), al.get("alert") or al.get("name"))
                f = found.setdefault(key + (sv,) if key[0] == ZAP_LIBRARY_RULE else key, {
                    "tool": "zap", "severity": sv, "rule": "zap-%s" % al.get("pluginid"),
                    "location": ", ".join(uris[:3])[:300] or target, "message": al.get("alert") or al.get("name"),
                    "cwe": ("CWE-%s" % al["cweid"]) if al.get("cweid") not in (None, "", "-1") else None, "paths": []})
                f["paths"] = sorted(set(f["paths"]) | {urllib.parse.urlparse(u).path for u in uris})
                if f["rule"] == ZAP_LIBRARY_RULE:
                    f["libraries"] = sorted(set(f.get("libraries") or []) | zap_libraries(al))
    for f in found.values():
        if f.get("libraries"):
            f["location"] = ("%s: %s" % (", ".join(f["libraries"]), f["location"]))[:300]
    return list(found.values()), None


def zap_image_id(ctx):
    """Which ZAP this is. A tag like :stable moves when someone pulls it, and its rules with it, so the id of the local
    image counts, not the name."""
    image = ctx.c("security.zap_image", ZAP_IMAGE) or ZAP_IMAGE
    if re.search(r"@sha256:[0-9a-f]{64}$", image):
        return image
    try:
        r = run(["docker", "image", "inspect", "--format", "{{.Id}}", image], check=False, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return image
    return (r.stdout or "").strip() if r.returncode == 0 and (r.stdout or "").strip() else image


def zap_settings(ctx):
    """What ZAP is asked to do, as the factory's owner set it."""
    return "%d/%s/%s/%s/%s" % (SCAN_VERSION, zap_mode(ctx), "api" if ctx.c("security.zap_openapi") else "web",
                               "login" if (ctx.c("security.zap_auth") or {}).get("command") else "no-login",
                               ctx.c("security.zap_image", ZAP_IMAGE) or ZAP_IMAGE)


def scan_signature(ctx, tool):
    """What a running-app scan looks for. A baseline made by other scans cannot tell new findings from old: a login shows
    ZAP pages the baseline never saw, whose old findings would all look new."""
    if tool != "zap":
        return "%d/%s" % (SCAN_VERSION, tool)
    return "%s|%s" % (zap_settings(ctx), zap_image_id(ctx))


def zap_baseline_image(ctx):
    """The image the baseline's ZAP findings came from, when that baseline counts; else None."""
    if baseline_state(ctx, "zap")[0] != "ok":
        return None
    stamp = baseline_of(ctx)["security_scan"]["zap"]
    return stamp.split("|", 1)[1]


def baseline_json(ctx):
    """baseline.json as fx selftest wrote it, or {}."""
    try:
        b = json.loads(read(os.path.join(ctx.factory, "baseline.json"), "{}") or "{}")
    except ValueError:
        return {}
    return b if isinstance(b, dict) else {}


def baseline_of(ctx, b=None):
    """The part of baseline.json for ctx's repository (a RepoCtx's, else the first): {"repos": {"<name>": {...}}}. An
    older one, without repos, is the base branch's of the factory's one repository (its first)."""
    b = baseline_json(ctx) if b is None else b
    first = ctx.repo_names()[0] if ctx.repos else None
    name = ctx.scope or first
    if isinstance(b.get("repos"), dict):
        got = b["repos"].get(name)
        return got if isinstance(got, dict) else {}
    return b if name == first else {}


def zap_pinned(ctx, notes):
    """(image to run, why it cannot run). The one the baseline came from: an id says what ran, and a tag is whatever the
    last docker pull, docker tag or docker build on this machine made it, which project code can do from checks.sh. A
    baseline that does not count pins nothing, and with that image gone nothing can compare against it."""
    pinned = zap_baseline_image(ctx)
    if not pinned or re.search(r"@sha256:[0-9a-f]{64}$", pinned):
        return pinned, None
    try:
        r = run(["docker", "image", "inspect", "--format", "{{.Id}}", pinned], check=False, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None, "could not ask Docker about the ZAP image %s" % pinned
    if r.returncode != 0:
        return None, "the ZAP image %s that fx selftest used is no longer on this machine: run fx selftest" % pinned
    if zap_image_id(ctx) != pinned:
        notes.append("zap: %s now names another image; still using the one fx selftest used (%s). Run fx selftest to move "
                     "to the new one" % (ctx.c("security.zap_image", ZAP_IMAGE) or ZAP_IMAGE, pinned))
    return pinned, None


def baseline_state(ctx, tool):
    """(state, known findings). ok: made by these scans. none: this scan is not in it. old: from an older version, which
    kept no signature. other: made by other scans. Only with ok can new findings be told from old."""
    b = baseline_of(ctx)
    sec = b.get("security") or {}
    if tool not in sec:
        return "none", None
    stamp = b.get("security_scan")
    if not stamp:
        return "old", None
    made_by = stamp.get(tool) if isinstance(stamp, dict) else None
    # Not the image id: nothing else in here asks Docker, and zap_pinned sees to the image.
    if str(made_by).split("|")[0] != (zap_settings(ctx) if tool == "zap" else scan_signature(ctx, tool)):
        return "other", None
    known = {}
    for f in sec[tool]:
        seen = known.setdefault((f.get("rule"), f.get("message")), {"paths": set(), "libraries": set()})
        seen["paths"].update(f.get("paths") or [])
        seen["libraries"].update(f.get("libraries") or [])
    return "ok", known


BASELINE_WORDS = {"old": "baseline from an older version: run fx selftest; until then %s findings do not block",
                  "other": "the baseline came from other scans (fx or the settings changed since): run fx selftest; "
                           "until then %s findings do not block"}


# ZAP rules about what a whole site lacks (a header, say). A new page with the same old gap is nothing the job did, and the
# crawl does not reach the same pages every time.
ZAP_SITE_WIDE = {"10015", "10020", "10021", "10035", "10036", "10037", "10038", "10049", "10055", "10063", "90004", "90005"}


ASSET_EXT = r"\.(?:m?js|css|map|woff2?|ttf|png|jpe?g|gif|svg|webp)$"
ASSET_NAME_RE = re.compile(r"(?<=[.\-_])(?=[A-Za-z0-9_-]*\d)[A-Za-z0-9_-]{6,}(?=(?:\.(?:chunk|min|bundle|js|css))*" + ASSET_EXT + ")")
ASSET_HASH_ONLY_RE = re.compile(r"(?<=/)(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{8,}(?=[/.])")


def app_path_shape(path):
    """A path without what changes by itself between builds and runs: in a built file the hash (app.def456.js,
    main.1a2b3c4d.chunk.js), a name or folder that is only a hash (/_nuxt/DlAUqK2U.js), and everywhere ids."""
    if re.search(ASSET_EXT, path):
        path = ASSET_HASH_ONLY_RE.sub("#", ASSET_NAME_RE.sub("#", path))
    return re.sub(r"(?<=/)(?:\d+|[0-9a-fA-F-]{32,36})(?=/|$)", "#", path)


def app_finding_is_new(f, known, limit):
    """Against the base branch's baseline. A kind of finding the baseline never had is new. One it had is new on a path it
    did not have it on, when it is serious enough to block and belongs to a page rather than to the whole site: a form
    with no CSRF token on a new page is this job's, however many old forms lack one. A vulnerable library is new when
    the baseline did not have that library, whichever file holds it now."""
    seen = known.get((f["rule"], f["message"]))
    if seen is None:
        return True
    if str(f["rule"]).replace("zap-", "") in ZAP_SITE_WIDE or SEV_RANK.get(f["severity"], 2) < limit:
        return False
    if f.get("libraries"):
        return bool(set(f["libraries"]) - seen["libraries"])
    return bool({app_path_shape(p) for p in f.get("paths") or []} - {app_path_shape(p) for p in seen["paths"]})


SCANNERS = ["gitleaks", "osv", "semgrep", "headers", "zap"]
SCANNER_ALIASES = {"osv-scanner": "osv", "docker": "zap"}
SCANNER_TOOLS = {"gitleaks": "gitleaks", "osv": "osv-scanner", "semgrep": "semgrep", "zap": "docker"}  # headers: none
# Files that tune the scanners. The builder writes the clone, so a job that adds or changes one needs a human
# (always flagged as sensitive, whatever sensitive_paths says), and fx's own scans do not read them.
SCANNER_SETTINGS = [".gitleaks.toml", "*/.gitleaks.toml", ".gitleaksignore", "*/.gitleaksignore", ".semgrepignore",
                    "*/.semgrepignore", "osv-scanner.toml", "*/osv-scanner.toml"]
SUPPRESS_RE = re.compile(r"(?i)\bnosem(?:grep)?\b|\bgitleaks:allow\b")


def scanners_on(ctx):
    """security.scanners with the template's defaults: a missing block or key means on; only an explicit false
    turns a scanner off (the gate then lists it as skipped)."""
    sc = ctx.c("security.scanners")
    if sc is False:
        return {n: False for n in SCANNERS}
    sc = sc if isinstance(sc, dict) else {}
    return {n: sc.get(n, True) is not False for n in SCANNERS}


def security_gaps(ctx):
    """What the gate does not check or does not block as this factory is set up, in words for its owner. In a project of
    several repositories, each repository's own settings (scanners, accepted rules, app, ZAP) are read for it, and what
    is its own is named after it."""
    gaps = []
    if block_rank(ctx) > SEV_RANK[BLOCK_SEVERITY]:
        gaps.append("security.block_severity is %s: findings below it do not block" % ctx.c("security.block_severity"))
    if len(ctx.repos) <= 1:
        return gaps + repo_security_gaps(ctx) + semgrep_gaps(ctx)
    gaps += semgrep_gaps(ctx)
    for n in ctx.repo_names():
        gaps += ["%s: %s" % (n, g) for g in repo_security_gaps(repo_ctx(ctx, n))]
    return gaps


def semgrep_gaps(ctx):
    rules = semgrep_rules(ctx)
    left = [r for r in SEMGREP_RULES if r not in rules]
    if left and all(r.startswith("p/") for r in rules):
        return ["security.semgrep_config leaves out %s" % ", ".join(left)]
    return []


def repo_security_gaps(ctx):
    """security_gaps of one repository (a RepoCtx), or of the factory's only one."""
    on, gaps = scanners_on(ctx), []
    off = [n for n in SCANNERS if not on[n]]
    if off:
        gaps.append("turned off in security.scanners: %s" % ", ".join(off))
    loose = [n for n in REQUIRED_SCANNERS if on[n] and n not in required_scanners(ctx)]
    if loose:
        gaps.append("%s not in security.required: when they cannot run, the job only goes to a human" % ", ".join(loose))
    try:
        accepted = accepted_entries(ctx)
    except FxError:
        accepted = []  # fx doctor has its own row for that
    if accepted:
        gaps.append("%d rule(s) accepted in security.accepted_rules" % len(accepted))
    if not ctx.c("app.up"):
        gaps.append("no app.up: nothing looks at the running app (headers, ZAP)")
        return gaps
    if any(on[n] and baseline_state(ctx, n)[0] == "none" for n in ("headers", "zap")):
        gaps.append("no baseline yet: until fx selftest runs, header and ZAP findings do not block")
    if on["zap"]:
        if not (shutil.which("docker") and docker_running()):
            gaps.append("Docker is not running: no ZAP")
        if zap_mode(ctx) != "full":
            gaps.append("security.zap_mode is baseline: ZAP does not try attacks such as SQL injection or XSS")
        if not (ctx.c("security.zap_auth") or {}).get("command"):
            gaps.append("no security.zap_auth: ZAP only sees pages that need no login")
        if not ctx.c("security.zap_openapi"):
            gaps.append("no security.zap_openapi: ZAP only finds API routes that a page links to")
    return gaps


def required_scanners(ctx):
    """security.required (default REQUIRED_SCANNERS): scanners that must run; a missing or failing one blocks the gate."""
    req = ctx.c("security.required", REQUIRED_SCANNERS)
    if req is None:
        req = REQUIRED_SCANNERS
    if isinstance(req, str):
        req = csv_list(req)
    return [SCANNER_ALIASES.get(str(r).strip().lower(), str(r).strip().lower()) for r in req if str(r).strip()]


def scan_suppressions(ctx, job, mb):
    """Scanner suppressions the job's diff adds: nosemgrep/nosem and gitleaks:allow comments, entries in
    .gitleaksignore or .semgrepignore, ignore entries in osv-scanner.toml, a changed .gitleaks.toml. They let the
    builder hide its own findings, so they block unless security.allow_suppressions is true."""
    wt = job["worktree"]
    r = git(["diff", "-U0", "--no-color", "--no-ext-diff", "--no-textconv", mb, "HEAD"], wt, check=False)
    found, per_file, path, line_no = [], {}, "", 0
    for line in (r.stdout or "").splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else ""
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            line_no = int(m.group(1)) - 1 if m else 0
        elif line.startswith("+") and path:
            line_no += 1
            text = line[1:].strip()
            base = os.path.basename(path)
            if base in (".gitleaksignore", ".semgrepignore", ".gitleaks.toml"):
                if text and not text.startswith("#"):
                    per_file.setdefault(path, []).append(line_no)
            elif base == "osv-scanner.toml":
                if re.match(r"^\[\[\s*(IgnoredVulns|PackageOverrides)\s*\]\]", text) or \
                        re.match(r"(?i)^ignore\s*=\s*true", text):
                    per_file.setdefault(path, []).append(line_no)
            else:
                m = SUPPRESS_RE.search(text)
                if m:
                    found.append({"tool": "fx suppressions", "severity": "high", "new": True, "suppression": True,
                                  "rule": m.group(0).lower(), "location": "%s:%d" % (path, line_no),
                                  "message": "the job adds a scanner suppression comment (%s)" % m.group(0),
                                  "cwe": "CWE-693"})
    for p_, lines in sorted(per_file.items()):
        found.append({"tool": "fx suppressions", "severity": "high", "new": True, "suppression": True,
                      "rule": os.path.basename(p_), "location": "%s:%d" % (p_, lines[0]),
                      "message": "the job adds %d entr%s to %s, which can hide scanner findings" % (
                          len(lines), "y" if len(lines) == 1 else "ies", os.path.basename(p_)), "cwe": "CWE-693"})
    return found


def accepted_entries(ctx):
    """security.accepted_rules: [{"rule", "path", "reason"}], where path is a glob; the older {rule: reason} still reads,
    and covers every file."""
    raw = ctx.c("security.accepted_rules") or []
    if isinstance(raw, dict):
        return [{"rule": r, "reason": str(why or "accepted")} for r, why in raw.items()]
    if not isinstance(raw, list) or not all(isinstance(e, dict) and e.get("rule") and str(e.get("reason") or "").strip()
                                            and isinstance(e.get("path", ""), str) for e in raw):
        raise FxError('security.accepted_rules must be a list of {"rule": ..., "path": "<one glob>", "reason": ...}, not %s'
                      % json.dumps(raw)[:200], code=3)
    return raw


def accepted_reason(entries, finding):
    """Why a human accepted this finding, or None. A secret or a suppression is never accepted. An entry with a path covers
    a finding only when every place it was found matches: semgrep and osv give a file, ZAP and the header check the paths
    of the site."""
    if finding.get("secret") or finding.get("suppression"):
        return None
    places = [finding["path"]] if finding.get("path") else finding.get("paths") or []
    for e in entries:
        if e["rule"] == finding.get("rule") and (not e.get("path") or (
                places and all(path_glob(p, e["path"]) for p in places))):
            return str(e["reason"])
    return None


def block_rank(ctx):
    """security.block_severity as a rank; a word fx does not know falls back to the default, never to less."""
    word = str(ctx.c("security.block_severity", BLOCK_SEVERITY) or BLOCK_SEVERITY).lower()
    return SEV_RANK.get(word, SEV_RANK[BLOCK_SEVERITY])


def run_security(ctx, job, rdir, app_url_, whole=False):
    """All enabled scanners; returns findings, the blocking list, skipped notes, other notes, the enabled scanners
    that did not run (missed; ZAP without Docker is only noted as skipped) and the required ones that did not
    (required_failed). whole: everything in the branch and its history, not only what the job changed; every finding
    then counts as new."""
    wt = job["worktree"]
    accepted = accepted_entries(ctx)  # before anything runs: a mistake here is the factory's, and says so
    mb = None if whole else git(["merge-base", job["base_ref"], "HEAD"], wt).stdout.strip()
    sc = scanners_on(ctx)
    findings, skipped, notes, ran = [], [], [], set()
    missed = {}  # enabled scanners that could have run here but did not (missing, failed): name -> why
    no_docker = None

    def off(name):
        skipped.append("%s: turned off in factory.json (security.scanners.%s is false)" % (name, name))

    def miss(name, why):
        skipped.append(why if why.startswith(name) else "%s: %s" % (name, why))
        missed[name] = why

    def use(name, binary, fn):
        if not sc[name]:
            off(name)
            return
        if binary and not shutil.which(binary):
            miss(name, "%s not installed (/code-factory:factory install)" % binary)
            return
        try:
            f, err = fn()
        except subprocess.TimeoutExpired as e:  # like any scanner that gave no result, not the end of the gate
            f, err = None, "no result within %s seconds" % e.timeout
        if err:
            miss(name, err)
        else:
            findings.extend(f)
            ran.add(name)

    if sc["gitleaks"]:
        f, err, note = scan_secrets(ctx, job, mb, rdir)
        if not err:
            findings.extend(f)
        if err or note:
            miss("gitleaks", err or note)
        else:
            ran.add("gitleaks")
    else:
        off("gitleaks")
    use("osv", "osv-scanner", lambda: scan_osv(ctx, job, mb, rdir, notes))
    use("semgrep", "semgrep", lambda: scan_semgrep(ctx, job, mb, rdir, notes))
    def compared(f, tool):
        """Running-app findings count as new against the base branch's baseline; without one they only report."""
        state, base = ("whole", None) if whole else baseline_state(ctx, tool)
        if state in BASELINE_WORDS:
            notes.append(BASELINE_WORDS[state] % tool)
        if state not in ("whole", "ok") and f:
            skipped.append("%s: no baseline of the base branch from these scans (run fx selftest%s); findings "
                           "reported, not blocking" % (tool, " with Docker running" if tool == "zap" else ""))
        for x in f or []:
            x["new"] = whole or (base is not None and app_finding_is_new(x, base, block_rank(ctx)))
        return f

    if app_url_:
        def hdrs():
            f, err = scan_headers(ctx, job, app_url_)
            return compared(f, "headers"), err

        def zap():
            image, err = (None, None) if whole else zap_pinned(ctx, notes)
            if err:
                return None, err
            f, err = scan_zap(ctx, job, app_url_, os.path.join(rdir, "zap"), notes, image)
            return compared(f, "zap"), err
        use("headers", None, hdrs)
        if sc["zap"] and not shutil.which("docker"):
            no_docker = "docker not installed (/code-factory:factory install)"
        elif sc["zap"] and not docker_running():
            no_docker = "Docker is installed but not running (start Docker to enable ZAP scans)"
        if no_docker:  # a laptop with Docker off: noted, not a reason to hand every job to a human
            skipped.append("zap: " + no_docker)
        else:
            use("zap", "docker", zap)
        if sc["zap"]:
            n = zap_image_note(ctx.c("security.zap_image", ZAP_IMAGE) or ZAP_IMAGE)
            if n:
                notes.append(n)
    else:
        if sc["headers"] or sc["zap"]:
            skipped.append("headers/zap: no running app (set app.up with /code-factory:factory init)")
        for n in ("headers", "zap"):
            if not sc[n]:
                off(n)
    if not whole:
        findings += scan_suppressions(ctx, job, mb)
    allow = bool(ctx.c("security.allow_suppressions", False))
    required_failed = []
    for n in required_scanners(ctx):
        if n not in SCANNERS:
            required_failed.append("%s: not a scanner fx knows (security.required takes %s)" % (n, ", ".join(SCANNERS)))
        elif not sc[n]:
            required_failed.append("%s: required (security.required) but turned off in security.scanners" % n)
        elif n not in ran:
            required_failed.append("%s: required (security.required) but did not run: %s" % (
                n, missed.get(n) or (no_docker if n == "zap" else None) or
                ("no running app" if n in ("headers", "zap") and not app_url_ else "no result")))
    limit = block_rank(ctx)
    for f in findings:
        why = accepted_reason(accepted, f)
        if why:
            f["accepted"] = why
    blocking = [f for f in findings if f.get("secret") or (f.get("suppression") and not allow) or
                (f.get("new") and not f.get("suppression") and not f.get("accepted") and not f.get("test_code") and
                 SEV_RANK.get(f["severity"], 2) >= limit)]
    return {"findings": findings, "blocking": blocking, "skipped": skipped, "notes": notes,
            "missed": sorted(missed), "required_failed": required_failed,
            "flags": sorted({f["path"] for f in findings if f.get("look") and not f.get("accepted")})}


SECURITY_ROWS = 300


def security_markdown(res):
    failed = res["blocking"] or res.get("required_failed")
    md = ["SECURITY SCAN: %s" % ("FAIL" if failed else "PASS"), ""]
    if res.get("required_failed"):
        md += ["## Required scanners that did not run", ""] + ["- " + s for s in res["required_failed"]] + [""]
    if res["skipped"]:
        md += ["## Skipped", ""] + ["- " + s for s in res["skipped"]] + [""]
    if res.get("notes"):
        md += ["## Notes", ""] + ["- " + s for s in res["notes"]] + [""]
    rows = sorted(res["findings"], key=lambda f: (-SEV_RANK.get(f["severity"], 2), not f.get("new")))
    if rows:
        md += ["## Findings", "", "| Block | Severity | New | Tool | Rule | Where | What | OWASP / CWE |",
               "|---|---|---|---|---|---|---|---|"]
        # Blocking findings first, so the cut never hides one.
        for f in sorted(rows, key=lambda f: f not in res["blocking"])[:SECURITY_ROWS]:
            md.append("| %s | %s | %s | %s | %s | %s | %s | %s |" % (
                "yes" if f in res["blocking"] else "accepted: %s" % f["accepted"] if f.get("accepted") else
                "test code" if f.get("test_code") else "",
                f["severity"], "yes" if f.get("new") else "no", f["tool"],
                f.get("rule") or "", f.get("location") or "", (f.get("message") or "").replace("|", "/"),
                " / ".join(x for x in (f.get("owasp"), f.get("cwe")) if x)))
        if len(rows) > SECURITY_ROWS:
            md += ["", "%d more findings at lower severity are not shown here; the scanners' own reports next to this "
                       "file have them all." % (len(rows) - SECURITY_ROWS)]
    else:
        md.append("No findings.")
    return "\n".join(md) + "\n"


def cmd_security(ctx, a):
    """The scanners on every repository the job changes now, each against its own app when it has one."""
    job = ctx.load(a.job)
    change = job_names(job, "change")
    if not change:
        raise FxError("%s has no clones yet" % job["id"], code=3)
    several = len(job_order(job)) > 1
    rdir = os.path.join(ctx.job_dir(job["id"]), "security-manual")
    os.makedirs(rdir, exist_ok=True)
    urls = {}
    if job_apps(ctx, job):
        info = app_start(ctx, job)
        urls = {n: i["url"] for n, i in (info.get("apps") or {job_apps(ctx, job)[0]: info}).items()}
    secs = {}
    for n in change:
        os.makedirs(os.path.join(rdir, n), exist_ok=True)
        secs[n] = run_security(repo_ctx(ctx, n), repo_view(ctx, job, n), os.path.join(rdir, n) if several else rdir,
                               urls.get(n))
        for f in secs[n]["findings"]:
            f["repo"] = n
    res = security_merge(secs, several)
    write_atomic(os.path.join(rdir, "security.md"), security_markdown_repos(secs, several))
    r = {"ok": True, "job": job["id"], "pass": not res["blocking"] and not res["required_failed"],
         "blocking": len(res["blocking"]), "findings": len(res["findings"]), "skipped": res["skipped"],
         "required_failed": res["required_failed"], "notes": res["notes"],
         "report": os.path.join(rdir, "security.md")}
    if several:
        r["repos"] = {n: {"pass": not s_["blocking"] and not s_["required_failed"], "blocking": len(s_["blocking"]),
                          "findings": len(s_["findings"])} for n, s_ in secs.items()}
    out(r)


