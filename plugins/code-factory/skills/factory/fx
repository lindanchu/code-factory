def last_jira_base(ctx):
    """The Jira site of the most recent job in this repo, so a bare key works after one link."""
    best = None
    for jid in ctx.list_ids():
        try:
            j = ctx.load_exact(jid)
        except (FxError, ValueError):
            continue
        if j.get("jira_base") and (best is None or j.get("created_at", "") > best[0]):
            best = (j.get("created_at", ""), j["jira_base"])
    return best[1] if best else None


def parse_issue_ref(ref, ctx):
    ref = ref.strip()
    base = None
    key = None
    if re.match(r"^https?://", ref):
        u = urllib.parse.urlparse(ref)
        base = "%s://%s" % (u.scheme, u.netloc)
        q = urllib.parse.parse_qs(u.query)
        for name in ("selectedIssue", "issueKey"):
            if q.get(name):
                key = q[name][0]
        if not key:
            keys = KEY_RE.findall(u.path)
            key = keys[-1] if keys else None
    else:
        m = KEY_RE.fullmatch(ref.upper())
        key = m.group(1) if m else None
        base = ctx.c("jira.base_url") or last_jira_base(ctx)
    if not key:
        raise FxError("could not find an issue key (like ABC-123) in %r" % ref)
    if not base:
        raise FxError("only a key was given and no Jira site is known yet; pass the full Jira link once "
                      "(later keys reuse its site), or set jira.base_url in factory.json")
    return base.rstrip("/"), key.upper()


# Who talks to Jira is chosen in init and kept as jira.mode. mcp: Claude's own Atlassian connector does the Jira work,
# and fx only queues it (jira_todo). token: fx calls Jira's REST API itself, with the email and API token in jira.env.
JIRA_MODES = {"mcp": "mcp", "token": "token", "agent": "mcp", "api": "token"}  # agent and api: an older version's names
JIRA_ENV = "jira.env"
JIRA_ENV_NAMES = ("JIRA_EMAIL", "JIRA_API_TOKEN")
JIRA_TOKEN_PAGE = "https://id.atlassian.com/manage-profile/security/api-tokens"
JIRA_PAGE = 100  # issues asked for per page of a search
PROJECT_KEY_RE = re.compile(r"[A-Z][A-Z0-9_]+")  # a Jira project key: the part of an issue key (KEY_RE) before the dash


def jira_mode_setting(ctx):
    """jira.mode as factory.json writes it: mcp or token, or in an older factory agent, api, auto or nothing."""
    return str(ctx.c("jira.mode") or "").strip().lower()


def jira_env_path(ctx):
    """Mode token's file, in this project's keys folder beside the S3 keys: outside the factory repository and its
    clones, and kept from agents' Read tool by the rules init writes."""
    return os.path.join(baselines_key_dir(ctx), JIRA_ENV)


def jira_env_help(path):
    """What jira.env holds and how it gets there, never a value."""
    return ("It holds two lines, JIRA_EMAIL=<the Jira account's email> and JIRA_API_TOKEN=<an API token created at %s>, "
            "and the user writes it there, never through the conversation (the folder: mkdir -p -m 700 %s; the file: "
            "chmod 600)" % (JIRA_TOKEN_PAGE, shlex.quote(os.path.dirname(path))))


def jira_keys(ctx):
    """The email and API token of mode token, from jira.env, parsed like the S3 key files. Read in fx's own process
    only and never put in any environment. Never from the environment either: any agent's shell can read it there."""
    path = jira_env_path(ctx)
    try:
        text = read(path)
    except OSError as e:
        raise FxError("cannot read %s (%s): in mode token fx calls Jira with it" % (path, e.strerror or e), code=4)
    if text is None:
        raise FxError("%s is missing: in mode token fx calls Jira with it. %s" % (path, jira_env_help(path)), code=4)
    try:
        text.encode("utf-8")  # read() keeps bytes that are not UTF-8 as surrogates, which no request can carry
    except UnicodeEncodeError:
        raise FxError("%s is not UTF-8 text: write it again as plain text. %s" % (path, jira_env_help(path)), code=4)
    vals = key_file_values(text, "JIRA_")
    missing = [n for n in JIRA_ENV_NAMES if not vals.get(n)]
    if missing:
        raise FxError("%s has no %s. %s" % (path, " and no ".join(missing), jira_env_help(path)), code=4)
    return {"email": vals["JIRA_EMAIL"], "token": vals["JIRA_API_TOKEN"]}


def jira_keys_complete(ctx):
    try:
        jira_keys(ctx)
    except FxError:
        return False
    return True


def jira_key_values(ctx):
    """The secrets of jira.env (its token), redacted from what fx posts and kept out of commits and the jobs store like
    the other local secrets. The email is an address, which commits and issues hold, not a secret. Mode mcp never opens
    the file."""
    if JIRA_MODES.get(jira_mode_setting(ctx)) == "mcp":
        return set()
    try:
        vals = key_file_values(read(jira_env_path(ctx), ""), "JIRA_")
    except OSError:
        return set()  # fx cannot read it either, so it calls Jira with nothing from it
    return {v for k, v in vals.items() if SECRET_NAME_RE.search(k) and len(v) >= 6}


def url_origin(url):
    """(scheme, host, port) of a URL, with the scheme's own port when it names none; None without a host."""
    try:
        u = urllib.parse.urlsplit(str(url or "").strip())
        port = u.port
    except ValueError:
        return None
    if not u.hostname:
        return None
    scheme = u.scheme.lower()
    return scheme, u.hostname.lower(), port or {"https": 443, "http": 80}.get(scheme)


def jira_site(ctx):
    """Where mode token sends the token: this factory's Jira site (jira.base_url, which init sets) and nowhere else,
    whatever a link, the environment or a job's files say. Over https only (http on this machine itself, for tests)."""
    site = str(ctx.c("jira.base_url") or "").strip()
    o = url_origin(site)
    if not o:
        raise FxError("factory.json has no jira.base_url%s. In mode token fx sends the Jira token to this factory's "
                      "Jira site only: set jira.base_url to it (for example https://your-team.atlassian.net), as "
                      "/code-factory:factory init does" % (" fx can use (%r)" % site if site else ""), code=4)
    if o[0] != "https" and not (o[0] == "http" and o[1] in ("127.0.0.1", "localhost", "::1")):
        raise FxError("jira.base_url %s is not an https address: fx sends the Jira token over https only" % site,
                      code=4)
    return o


class _JiraRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect is followed, but the Jira token never goes along to another site (Jira Cloud sends attachments to
    its media host, whose signed link needs no token)."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and url_origin(new.full_url) != url_origin(req.full_url):
            new.remove_header("Authorization")
        return new


class Jira:
    def __init__(self, ctx, base):
        self.base = base.rstrip("/")
        self.site = jira_site(ctx)
        if url_origin(self.base) != self.site:
            raise FxError("%s is not this factory's Jira site %s (jira.base_url): fx sends the Jira token there only"
                          % (self.base, ctx.c("jira.base_url")), code=4)
        self.keys_file = jira_env_path(ctx)
        keys = jira_keys(ctx)
        self.auth = "Basic " + base64.b64encode(("%s:%s" % (keys["email"], keys["token"])).encode()).decode()
        self.opener = urllib.request.build_opener(_JiraRedirect)

    def req(self, method, path, body=None, raw=False, url=None):
        url = url or (self.base + path)
        if url_origin(url) != self.site:  # an attachment's link comes from Jira's answer, and could point anywhere
            o = url_origin(url)
            raise FxError("fx sends the Jira token to this factory's Jira site only, not to %s"
                          % ("%s://%s:%s" % o if o else repr(url[:80])), code=4)
        data = json.dumps(body).encode() if body is not None else None
        r = urllib.request.Request(url, data=data, method=method)
        r.add_header("Authorization", self.auth)
        r.add_header("Accept", "*/*" if raw else "application/json")
        if data is not None:
            r.add_header("Content-Type", "application/json")
        try:
            with self.opener.open(r, timeout=60) as resp:
                payload = resp.read()
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", "replace")[:500]
            if e.code in (401, 403):
                raise FxError("Jira refused the request (%d). Check JIRA_EMAIL and JIRA_API_TOKEN in %s, and your "
                              "access to this issue. %s" % (e.code, self.keys_file, detail), code=4)
            if e.code == 404:
                raise FxError("Jira: not found (%s). %s" % (path, detail), code=4)
            raise FxError("Jira HTTP %d on %s: %s" % (e.code, path, detail), code=4)
        except urllib.error.URLError as e:
            raise FxError("cannot reach Jira at %s: %s" % (self.base, e.reason), code=4)
        except (OSError, http.client.HTTPException) as e:  # timeouts, resets, bad responses
            raise FxError("Jira connection problem on %s: %s" % (path or url, e), code=4)
        if raw:
            return payload
        try:
            return json.loads(payload.decode()) if payload else {}
        except ValueError:
            raise FxError("Jira returned something that is not JSON on %s (a login or proxy page?)" % (path or url),
                          code=4)

    def issue(self, key, fields=None):
        """The issue with every field and the fields' names, or only the fields named."""
        query = "fields=%s" % urllib.parse.quote(",".join(fields)) if fields else "fields=*all&expand=names"
        return self.req("GET", "/rest/api/3/issue/%s?%s" % (urllib.parse.quote(key), query))

    def search(self, jql, fields, limit):
        """The issues a JQL search finds, in the search's order, at most limit of them, and whether Jira has more. GET
        /rest/api/3/search/jql (Jira Cloud removed /rest/api/3/search), page after page by nextPageToken."""
        found, token = [], None
        while True:
            query = {"jql": jql, "fields": ",".join(fields), "maxResults": min(limit - len(found), JIRA_PAGE)}
            if token:
                query["nextPageToken"] = token
            page = self.req("GET", "/rest/api/3/search/jql?" + urllib.parse.urlencode(query))
            issues = page.get("issues") if isinstance(page, dict) else None
            if not isinstance(issues, list):
                raise FxError("Jira's answer to a search has no list of issues (a proxy page, or another Jira API?)",
                              code=4)
            found += [i for i in issues if isinstance(i, dict)]
            token = page.get("nextPageToken")
            if not issues or not token or page.get("isLast") is True:
                return found[:limit], len(found) > limit
            if len(found) >= limit:
                return found[:limit], True

    def comment(self, key, adf):
        return self.req("POST", "/rest/api/3/issue/%s/comment" % urllib.parse.quote(key), {"body": adf})

    def transitions(self, key):
        return self.req("GET", "/rest/api/3/issue/%s/transitions" % urllib.parse.quote(key)).get("transitions", [])

    def transition(self, key, tid):
        return self.req("POST", "/rest/api/3/issue/%s/transitions" % urllib.parse.quote(key),
                        {"transition": {"id": tid}})


# ---- ADF -> markdown -------------------------------------------------------

def adf_to_md(node, depth=0):
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if isinstance(node, list):
        return "".join(adf_to_md(n, depth) for n in node)
    t = node.get("type")
    content = node.get("content") or []
    attrs = node.get("attrs") or {}

    def inner(sep=""):
        return sep.join(adf_to_md(c, depth) for c in content)

    if t == "doc":
        return "\n\n".join(s for s in (adf_to_md(c, depth).rstrip() for c in content) if s) + "\n"
    if t == "paragraph":
        return inner()
    if t == "text":
        txt = node.get("text", "")
        for m in node.get("marks") or []:
            mt = m.get("type")
            if mt == "code":
                txt = "`%s`" % txt
            elif mt == "strong":
                txt = "**%s**" % txt
            elif mt == "em":
                txt = "*%s*" % txt
            elif mt == "strike":
                txt = "~~%s~~" % txt
            elif mt == "link":
                href = (m.get("attrs") or {}).get("href", "")
                if href and href != txt:
                    txt = "[%s](%s)" % (txt, href)
        return txt
    if t == "hardBreak":
        return "\n"
    if t == "heading":
        return "#" * int(attrs.get("level", 2)) + " " + inner()
    if t in ("bulletList", "orderedList", "taskList"):
        lines = []
        for i, item in enumerate(content, 1):
            if t == "orderedList":
                bullet = "%d." % i
            elif t == "taskList":
                bullet = "- [x]" if (item.get("attrs") or {}).get("state") == "DONE" else "- [ ]"
            else:
                bullet = "-"
            body = adf_to_md(item, depth + 1).strip("\n")
            body_lines = body.splitlines() or [""]
            pad = "  " * depth
            lines.append("%s%s %s" % (pad, bullet, body_lines[0]))
            for bl in body_lines[1:]:
                lines.append("%s  %s" % (pad, bl))
        return "\n".join(lines)
    if t in ("listItem", "taskItem", "decisionItem"):
        parts = [adf_to_md(c, depth) for c in content]
        return "\n".join(p for p in parts if p != "")
    if t == "codeBlock":
        return "```%s\n%s\n```" % (attrs.get("language") or "", inner())
    if t in ("blockquote", "panel"):
        body = "\n\n".join(adf_to_md(c, depth) for c in content)
        label = ("[%s] " % attrs.get("panelType")) if t == "panel" and attrs.get("panelType") else ""
        return "\n".join("> " + (label if i == 0 else "") + l for i, l in enumerate(body.splitlines()))
    if t == "rule":
        return "---"
    if t == "mention":
        return attrs.get("text") or "@mention"
    if t == "emoji":
        return attrs.get("text") or attrs.get("shortName") or ""
    if t in ("inlineCard", "blockCard", "embedCard"):
        return attrs.get("url") or ""
    if t == "status":
        return "[%s]" % attrs.get("text", "")
    if t == "date":
        try:
            ts = int(attrs.get("timestamp", "0")) / 1000
            return _dt.datetime.utcfromtimestamp(ts).strftime("%Y-%m-%d")
        except (ValueError, TypeError):
            return ""
    if t in ("mediaSingle", "mediaGroup", "mediaInline"):
        return inner(" ")
    if t == "media":
        return "[image/attachment: %s]" % (attrs.get("alt") or attrs.get("id") or "media")
    if t == "table":
        rows = [adf_to_md(r, depth) for r in content]
        if not rows:
            return ""
        width = rows[0].count("|") - 1
        sep = "|" + "---|" * max(width, 1)
        return "\n".join([rows[0], sep] + rows[1:])
    if t == "tableRow":
        cells = [adf_to_md(c, depth).replace("\n", " ").strip() for c in content]
        return "| " + " | ".join(cells) + " |"
    if t in ("tableCell", "tableHeader"):
        return " ".join(adf_to_md(c, depth) for c in content)
    if t in ("expand", "nestedExpand"):
        title = attrs.get("title") or "Details"
        return "**%s**\n\n%s" % (title, "\n\n".join(adf_to_md(c, depth) for c in content))
    return inner()


def value_to_md(v):
    if v is None:
        return ""
    if isinstance(v, dict) and v.get("type") == "doc":
        return adf_to_md(v).strip()
    if isinstance(v, str):
        return v.strip()
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, dict):
        for k in ("value", "name", "displayName", "key"):
            if k in v and isinstance(v[k], (str, int, float)):
                return str(v[k])
        return ""
    if isinstance(v, list):
        parts = [value_to_md(x) for x in v]
        return ", ".join(p for p in parts if p)
    return ""


# ---- markdown -> ADF (for comments) ---------------------------------------

INLINE_RE = re.compile(r"(`[^`]+`|\*\*[^*]+\*\*|\[[^\]]+\]\([^)]+\))")


def md_inline(text):
    nodes = []
    for part in INLINE_RE.split(text):
        if not part:
            continue
        if part.startswith("`") and part.endswith("`") and len(part) > 1:
            nodes.append({"type": "text", "text": part[1:-1], "marks": [{"type": "code"}]})
        elif part.startswith("**") and part.endswith("**") and len(part) > 3:
            nodes.append({"type": "text", "text": part[2:-2], "marks": [{"type": "strong"}]})
        elif part.startswith("["):
            m = re.match(r"\[([^\]]+)\]\(([^)]+)\)", part)
            if m:
                nodes.append({"type": "text", "text": m.group(1),
                              "marks": [{"type": "link", "attrs": {"href": m.group(2)}}]})
            else:
                nodes.append({"type": "text", "text": part})
        else:
            nodes.append({"type": "text", "text": part})
    return nodes


def md_to_adf(md):
    blocks = []
    lines = md.replace("\r\n", "\n").split("\n")
    i = 0
    para = []

    def flush_para():
        if para:
            content = []
            for n, l in enumerate(para):
                if n:
                    content.append({"type": "hardBreak"})
                content += md_inline(l.strip())
            blocks.append({"type": "paragraph", "content": content or [{"type": "text", "text": " "}]})
            del para[:]

    while i < len(lines):
        line = lines[i]
        s = line.strip()
        if s.startswith("```"):
            flush_para()
            lang = s[3:].strip()
            code = []
            i += 1
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            node = {"type": "codeBlock", "content": [{"type": "text", "text": "\n".join(code) or " "}]}
            if lang:
                node["attrs"] = {"language": lang}
            blocks.append(node)
            i += 1
            continue
        hm = re.match(r"^(#{1,6})\s+(.*)$", s)
        if hm:
            flush_para()
            blocks.append({"type": "heading", "attrs": {"level": min(len(hm.group(1)), 6)},
                           "content": md_inline(hm.group(2)) or [{"type": "text", "text": " "}]})
            i += 1
            continue
        lm = re.match(r"^([-*]|\d+\.)\s+(.*)$", s)
        if lm:
            flush_para()
            ordered = lm.group(1)[0].isdigit()
            items = []
            while i < len(lines):
                m2 = re.match(r"^([-*]|\d+\.)\s+(.*)$", lines[i].strip())
                if not m2 or m2.group(1)[0].isdigit() != ordered:
                    break
                items.append({"type": "listItem", "content": [
                    {"type": "paragraph", "content": md_inline(m2.group(2)) or [{"type": "text", "text": " "}]}]})
                i += 1
            blocks.append({"type": "orderedList" if ordered else "bulletList", "content": items})
            continue
        if not s:
            flush_para()
        else:
            para.append(s)
        i += 1
    flush_para()
    if not blocks:
        blocks = [{"type": "paragraph", "content": [{"type": "text", "text": " "}]}]
    return {"type": "doc", "version": 1, "content": blocks}


