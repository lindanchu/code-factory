def render_issue(data, base, attach_info):
    f = data.get("fields") or {}
    names = data.get("names") or {}
    key = data.get("key")
    lines = [
        DATA_WARNING.rstrip("\n"),
        "",
        "# %s: %s" % (key, f.get("summary", "")),
        "",
        "- Link: %s/browse/%s" % (base, key),
        "- Type: %s" % value_to_md(f.get("issuetype")),
        "- Status: %s" % value_to_md(f.get("status")),
        "- Priority: %s" % value_to_md(f.get("priority")),
        "- Labels: %s" % (", ".join(f.get("labels") or []) or "-"),
        "- Components: %s" % (value_to_md(f.get("components")) or "-"),
    ]
    parent = f.get("parent")
    if parent:
        lines.append("- Parent: %s %s" % (parent.get("key"), ((parent.get("fields") or {}).get("summary") or "")))
    lines += ["", "## Description", "", value_to_md(f.get("description")) or "_(empty)_"]
    extra = []
    for fid, val in f.items():
        if fid in NOISE_FIELDS or val in (None, "", [], {}):
            continue
        label = names.get(fid, fid)
        text = value_to_md(val)
        if not text or label.lower() in ("rank", "sprint", "story point estimate", "development", "team",
                                         "flagged", "start date", "issue color", "vulnerability"):
            continue
        if len(text) < 3 and not isinstance(val, dict):
            continue
        extra.append((label, text))
    for label, text in extra:
        lines += ["", "## %s" % label, "", text]
    subs = f.get("subtasks") or []
    if subs:
        lines += ["", "## Sub-tasks", ""]
        for s in subs:
            sf = s.get("fields") or {}
            lines.append("- %s %s [%s]" % (s.get("key"), sf.get("summary", ""), value_to_md(sf.get("status"))))
    links = f.get("issuelinks") or []
    if links:
        lines += ["", "## Linked issues", ""]
        for l in links:
            other = l.get("outwardIssue") or l.get("inwardIssue") or {}
            rel = (l.get("type") or {}).get("outward" if l.get("outwardIssue") else "inward", "relates to")
            of = other.get("fields") or {}
            lines.append("- %s %s %s" % (rel, other.get("key"), of.get("summary", "")))
    if attach_info:
        lines += ["", "## Attachments", ""]
        for a in attach_info:
            loc = (" (saved: attachments/%s)" % a["local"]) if a.get("local") else ""
            lines.append("- %s [%s, %s bytes]%s" % (a["filename"], a.get("mimeType", "?"), a.get("size", "?"), loc))
    comments = ((f.get("comment") or {}).get("comments")) or []
    if comments:
        lines += ["", "## Comments (oldest first)", ""]
        for c in comments:
            who = value_to_md(c.get("author")) or "?"
            body = value_to_md(c.get("body"))
            lines += ["### %s, %s" % (who, (c.get("created") or "")[:16]), "", body, ""]
    return "\n".join(lines).rstrip() + "\n"


def jira_fetch_into(ctx, job_dir, base, key):
    j = Jira(ctx, base)
    data = j.issue(key)
    attach_info = []
    adir = os.path.join(job_dir, "attachments")
    limit = int(float(ctx.c("jira.max_attachment_mb", 5)) * 1024 * 1024)
    for a in (data.get("fields") or {}).get("attachment") or []:
        info = {"filename": a.get("filename", "file"), "mimeType": a.get("mimeType", ""), "size": a.get("size", 0)}
        want = ctx.c("jira.download_attachments", True) and str(info["mimeType"]).startswith("image/") \
            and int(info["size"] or 0) <= limit and a.get("content")
        if want:
            try:
                blob = j.req("GET", "", raw=True, url=a["content"])
                os.makedirs(adir, exist_ok=True)
                local = re.sub(r"[^A-Za-z0-9._-]+", "_", info["filename"])
                with open(os.path.join(adir, local), "wb") as fh:
                    fh.write(blob)
                info["local"] = local
            except FxError as e:
                hint("fx: could not download attachment %s: %s" % (info["filename"], e))
        attach_info.append(info)
    md = render_issue(data, base, attach_info)
    write_atomic(os.path.join(job_dir, "issue.md"), md)
    return data


