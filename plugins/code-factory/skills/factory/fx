def git_toplevel(cwd=None):
    try:
        r = run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, check=False)
    except (FxError, OSError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


WORK_MARKER = ".factory-home"


def mark_work_dir(ctx):
    """Leave the factory's path in its work folder, so fx run from inside a clone (an agent's cwd) finds it."""
    try:
        os.makedirs(ctx.work, exist_ok=True)
        marker = os.path.join(ctx.work, WORK_MARKER)
        if (read(marker, "") or "").strip() != ctx.factory:
            write_atomic(marker, ctx.factory + "\n")
    except OSError:
        pass


def factory_home():
    """The factory repository: the nearest folder up from here holding factory.json, or named by the marker of
    the work folder this clone lives in, else this git repository."""
    d = os.getcwd()
    while True:
        if os.path.isfile(os.path.join(d, CONFIG_NAME)):
            return d
        home = (read(os.path.join(d, WORK_MARKER), "") or "").strip()
        if home and os.path.isfile(os.path.join(home, CONFIG_NAME)):
            return home
        up = os.path.dirname(d)
        if up == d:
            break
        d = up
    top = git_toplevel()
    if not top:
        raise FxError("not inside a git repository. The factory lives in its own repository, never in the "
                      "project's: create an empty private repository for it (for example <project>-factory), "
                      "clone it, open it in Claude Code and run /code-factory:factory init there.", code=3)
    return top


